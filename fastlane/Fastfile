# PhotoMaid iOS – TestFlight ohne eigenen Mac (GitHub Actions, macOS-Runner).
# Anleitung: docs/CI_TESTFLIGHT.md. Keine Zertifikate/Schlüssel im Repository.
require "base64"
require "securerandom"
require "shellwords"
require "tmpdir"

default_platform(:ios)

platform :ios do
  desc "Archiv bauen, signieren und zu TestFlight hochladen"
  lane :beta do
    project_root = File.expand_path("..", __dir__)
    privacy_checker = File.join(project_root, "scripts/ci/check_privacy_manifests.py")
    privacy_source = File.join(project_root, "PhotoMaid/Resources/PrivacyInfo.xcprivacy")
    privacy_report = File.join(project_root, "build/privacy-manifests.json")
    # Fail before signing/building when the source manifest already violates tracking rules.
    sh("python3 #{privacy_checker.shellescape} #{privacy_source.shellescape}")
    bundle_id = ENV.fetch("PM_BUNDLE_ID")
    team_id = ENV.fetch("PM_TEAM_ID")
    runner_temp = ENV.fetch("RUNNER_TEMP", Dir.tmpdir)

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY_BASE64"),
      is_key_content_base64: true,
      in_house: false
    )
    # Buildnummer = letzte TestFlight-Nummer + 1 (keine Nummer im Repo pflegen).
    build_number = latest_testflight_build_number(api_key: api_key, app_identifier: bundle_id,
                                                  initial_build_number: 1) + 1

    common_xcargs = [
      "PRODUCT_BUNDLE_IDENTIFIER=#{bundle_id}",
      "DEVELOPMENT_TEAM=#{team_id}",
      "CURRENT_PROJECT_VERSION=#{build_number}",
      "PM_PRO_PRODUCT_ID=#{ENV.fetch('PM_PRO_PRODUCT_ID', '')}",
      "PM_PRIVACY_POLICY_URL=#{ENV.fetch('PM_PRIVACY_POLICY_URL', '')}"
    ]
    # Werbung (E19): echte AdMob-IDs nur aus Secrets/Variablen. Fehlen sie, bleiben Googles Test-IDs aus project.yml
    # (Test-Anzeigen, keine Einnahmen) – vor einer App-Store-Veröffentlichung Pflicht (docs/RELEASE_BLOCKERS.md).
    %w[PM_ADMOB_APP_ID PM_ADMOB_APP_OPEN_ID PM_ADMOB_NATIVE_ID PM_ADMOB_REWARDED_ID].each do |key|
      value = ENV.fetch(key, "").strip
      common_xcargs << "#{key}=#{value}" unless value.empty?
    end

    # Manuelle Signierung: ausschließlich die vorhandenen PhotoMaid-Secrets verwenden.
    keychain = File.join(runner_temp, "photomaid-ci.keychain-db")
    keychain_password = SecureRandom.hex(24)
    create_keychain(path: keychain, password: keychain_password, default_keychain: false,
                    unlock: true, timeout: 3600, lock_when_sleeps: false)
    p12 = File.join(runner_temp, "dist.p12")
    File.binwrite(p12, Base64.decode64(ENV.fetch("APPLE_CERTIFICATE_BASE64")))
    # macOS `security import` liest nur PKCS12 mit 3DES und SHA1-MAC. Mit OpenSSL 3 exportierte Dateien
    # (AES-256, SHA-256-MAC) scheitern mit „MAC verification failed“. Daher umpacken; die Schlüsseldatei
    # existiert nur kurz (0600) und wird sofort gelöscht.
    legacy_p12 = File.join(runner_temp, "dist-legacy.p12")
    key_pem = File.join(runner_temp, "dist-key.pem")
    begin
      sh("umask 077; openssl pkcs12 -in #{p12.shellescape} -nodes -passin env:APPLE_CERTIFICATE_PASSWORD " \
         "-out #{key_pem.shellescape}", log: false)
      sh("openssl pkcs12 -export -in #{key_pem.shellescape} -certpbe PBE-SHA1-3DES -keypbe PBE-SHA1-3DES " \
         "-macalg sha1 -passout env:APPLE_CERTIFICATE_PASSWORD -out #{legacy_p12.shellescape}", log: false)
    ensure
      File.delete(key_pem) if File.exist?(key_pem)
    end
    import_certificate(certificate_path: legacy_p12, certificate_password: ENV.fetch("APPLE_CERTIFICATE_PASSWORD"),
                       keychain_path: keychain, keychain_password: keychain_password)
    # Tatsächlichen Zertifikatsnamen verwenden (Apple Distribution oder älteres iPhone Distribution).
    identities = sh("security find-identity -v -p codesigning #{keychain.shellescape}", log: false)
    identity = identities[/"((?:Apple|iPhone|iOS) Distribution[^"]*)"/, 1]
    UI.user_error!("Kein Distributions-Zertifikat mit privatem Schlüssel im Schlüsselbund – " \
                   "Secret APPLE_CERTIFICATE_BASE64 (.p12 mit Schlüssel) prüfen") unless identity
    profile = File.join(runner_temp, "profile.mobileprovision")
    File.binwrite(profile, Base64.decode64(ENV.fetch("APPLE_PROVISIONING_PROFILE_BASE64")))
    install_provisioning_profile(path: profile)
    profile_uuid = sh("security cms -D -i '#{profile}' | plutil -extract UUID raw -o - -", log: false).strip
    signing_xcargs = common_xcargs + [
      "CODE_SIGN_STYLE=Manual",
      "CODE_SIGN_IDENTITY=#{identity}",
      # Nur das App-Target liest PM_PROVISIONING_PROFILE (project.yml); ein globaler
      # PROVISIONING_PROFILE_SPECIFIER träfe auch das Paket PhotoMaidCore.
      "PM_PROVISIONING_PROFILE=#{profile_uuid}",
      "OTHER_CODE_SIGN_FLAGS=--keychain=#{keychain}"
    ]
    export_options = {
      signingStyle: "manual",
      signingCertificate: identity,
      teamID: team_id,
      provisioningProfiles: { bundle_id => profile_uuid }
    }
    export_xcargs = nil

    build_app(
      project: "PhotoMaid.xcodeproj",
      scheme: "PhotoMaid",
      configuration: "Release",
      clean: true,
      output_directory: "build",
      output_name: "PhotoMaid.ipa",
      # gym reicht xcargs an die Shell weiter: Werte escapen ("Apple Distribution" enthält ein Leerzeichen).
      xcargs: ([signing_xcargs.map { |a| k, v = a.split("=", 2); "#{k}=#{Shellwords.escape(v)}" }.join(" "),
                export_xcargs].compact.join(" ")),
      export_method: "app-store",
      export_xcargs: export_xcargs,
      export_options: export_options,
      include_symbols: true
    )

    # Check the actual exported app and every embedded SDK/resource manifest before uploading.
    # Source files alone cannot establish which manifest Apple receives. Never patch signed SDKs here.
    ipa_path = lane_context.fetch(SharedValues::IPA_OUTPUT_PATH)
    sh("python3 #{privacy_checker.shellescape} #{ipa_path.shellescape} " \
       "--require-app-manifest --json-output #{privacy_report.shellescape}")

    # App Store Connect lehnt Symbole wie „✕“ oder Emojis in „Was ist zu testen“ ab (Build 7: Upload ok, Text fehlte).
    changelog = ENV.fetch("CHANGELOG", "").dup.force_encoding(Encoding::UTF_8).scrub("").gsub(/[^\p{L}\p{M}\p{N}\p{P}\p{Zs}\n+=<>%&]/, "").squeeze(" ").strip
    changelog = "Interner Testbuild" if changelog.empty?

    upload_to_testflight(
      api_key: api_key,
      app_identifier: bundle_id,
      changelog: changelog,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end
end
