    "snake_photos_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم حتى 12 معاينة عشوائية أو اختر حتى 18 صورة. تبقى المعاينات في الذاكرة، وتُستبعد صور الخزنة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Use up to 12 random previews or choose up to 18 photos yourself. Previews stay in memory; vault photos are excluded."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze bis zu 12 zufällige Vorschauen oder wähle bis zu 18 Fotos selbst. Vorschauen bleiben im Arbeitsspeicher; Tresorfotos sind ausgeschlossen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use up to 12 random previews or choose up to 18 photos yourself. Previews stay in memory; vault photos are excluded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa hasta 12 vistas previas aleatorias o elige hasta 18 fotos. Las vistas previas quedan en memoria; se excluyen las fotos de la caja fuerte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez jusqu’à 12 aperçus aléatoires ou choisissez jusqu’à 18 photos. Les aperçus restent en mémoire ; les photos du coffre sont exclues."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Use up to 12 random previews or choose up to 18 photos yourself. Previews stay in memory; vault photos are excluded."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa fino a 12 anteprime casuali o scegli fino a 18 foto. Le anteprime restano in memoria; le foto della cassaforte sono escluse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ランダムなプレビューを最大12枚、または自分で選んだ写真を最大18枚使います。プレビューはメモリのみに保持され、金庫の写真は除外されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무작위 미리보기 최대 12장 또는 직접 고른 사진 최대 18장을 사용하세요. 미리보기는 메모리에만 유지되며 금고 사진은 제외됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Use up to 12 random previews or choose up to 18 photos yourself. Previews stay in memory; vault photos are excluded."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik tot 12 willekeurige voorvertoningen of kies zelf tot 18 foto's. Voorvertoningen blijven in het geheugen; kluisfoto's zijn uitgesloten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj do 12 losowych podglądów lub wybierz do 18 zdjęć. Podglądy pozostają w pamięci; zdjęcia z sejfu są wykluczone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Use up to 12 random previews or choose up to 18 photos yourself. Previews stay in memory; vault photos are excluded."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Use até 12 pré-visualizações aleatórias ou escolha até 18 fotos. As pré-visualizações ficam na memória; fotos do cofre são excluídas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Folosește până la 12 previzualizări aleatorii sau alege până la 18 poze. Previzualizările rămân în memorie; pozele din seif sunt excluse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте до 12 случайных превью или выберите до 18 фото. Превью остаются в памяти; фото из сейфа исключены."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Use up to 12 random previews or choose up to 18 photos yourself. Previews stay in memory; vault photos are excluded."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Use up to 12 random previews or choose up to 18 photos yourself. Previews stay in memory; vault photos are excluded."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En fazla 12 rastgele önizleme kullan veya 18 fotoğrafa kadar kendin seç. Önizlemeler bellekte kalır; kasa fotoğrafları hariçtir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовуй до 12 випадкових прев’ю або вибери до 18 фото. Прев’ю залишаються в пам’яті; фото із сейфа виключено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Use up to 12 random previews or choose up to 18 photos yourself. Previews stay in memory; vault photos are excluded."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用最多 12 张随机预览，或自行选择最多 18 张照片。预览仅保留在内存中，不使用保险箱照片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Use up to 12 random previews or choose up to 18 photos yourself. Previews stay in memory; vault photos are excluded."
          }
        }
      }
    },
