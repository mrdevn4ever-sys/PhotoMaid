          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al momento non è disponibile alcuna pubblicità. Riprova più tardi: con Pro crei cartelle senza pubblicità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在利用できる広告がありません。後でもう一度お試しください。Proなら広告なしでフォルダを作成できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 사용할 수 있는 광고가 없어요. 나중에 다시 시도하세요. Pro에서는 광고 없이 폴더를 만들어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen annonse er tilgjengelig akkurat nå. Prøv igjen senere – med Pro opprettes mapper uten annonser."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is nu geen advertentie beschikbaar. Probeer het later opnieuw – met Pro maak je mappen zonder advertenties."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obecnie nie ma dostępnej reklamy. Spróbuj później – z Pro tworzysz foldery bez reklam."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum anúncio disponível agora. Tente mais tarde – com o Pro, as pastas são criadas sem anúncios."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "De momento não há nenhum anúncio disponível. Tenta mais tarde – com o Pro crias pastas sem anúncios."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Momentan nu este disponibilă nicio reclamă. Încearcă mai târziu – cu Pro creezi dosare fără reclame."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас нет доступной рекламы. Попробуй позже – с Pro папки создаются без рекламы."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen annons finns tillgänglig just nu. Försök igen senare – med Pro skapas mappar utan annonser."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขณะนี้ไม่มีโฆษณา ลองอีกครั้งภายหลัง – กับ Pro จะสร้างโฟลเดอร์ได้โดยไม่มีโฆษณา"
