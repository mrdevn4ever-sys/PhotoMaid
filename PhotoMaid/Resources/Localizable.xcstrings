            "value": "Si apre su ogni dispositivo e in ogni app"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どの機器・アプリでも開けます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 기기와 앱에서 열려요"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent op elk apparaat en in elke app"
          }
        },
        "pl": {
