    "fc_swipes_footer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر ما يفعله كل اتجاه. «وضع في ألبوم» يضيف الصورة إلى ألبوم في تطبيق الصور ويحتفظ بها. عدم فعل شيء ليس قرارًا أبدًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটি দিক কী করবে বেছে নিন। “অ্যালবামে রাখুন” ফটোটিকে ফটো অ্যাপের একটি অ্যালবামে যোগ করে এবং রেখে দেয়। কিছু না করা কখনো সিদ্ধান্ত নয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tria què fa cada direcció. «Posar en un àlbum» afegeix la foto a un àlbum de l’app Fotos i la conserva. No fer res mai no és una decisió."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte, co dělá každý směr. „Vložit do alba“ přidá fotku do alba v aplikaci Fotky a ponechá ji. Nečinnost nikdy není rozhodnutí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg, hvad hver retning gør. “Læg i album” føjer fotoet til et album i appen Fotos og beholder det. At gøre ingenting er aldrig en beslutning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege für jede Richtung fest, was passiert. „In Album legen“ fügt das Foto einem Album der Fotos-App hinzu und behält es. Nichts tun ist nie eine Entscheidung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επίλεξε τι κάνει κάθε κατεύθυνση. Η «Τοποθέτηση σε άλμπουμ» προσθέτει τη φωτογραφία σε άλμπουμ των Φωτογραφιών και τη διατηρεί. Η αδράνεια δεν είναι ποτέ απόφαση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose what each direction does. “Put in album” adds the photo to an album in the Photos app and keeps it. Doing nothing is never a decision."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige qué hace cada dirección. «Poner en álbum» añade la foto a un álbum de la app Fotos y la conserva. No hacer nada nunca es una decisión."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse, mitä kukin suunta tekee. ”Laita albumiin” lisää kuvan Kuvat-apin albumiin ja säilyttää sen. Tekemättä jättäminen ei ole koskaan päätös."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis ce que fait chaque direction. « Mettre dans un album » ajoute la photo à un album de l’app Photos et la garde. Ne rien faire n’est jamais une décision."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "દરેક દિશા શું કરે તે પસંદ કરો. “આલ્બમમાં મૂકો” ફોટાને ફોટો ઍપના આલ્બમમાં ઉમેરીને રાખે છે. કંઈ ન કરવું ક્યારેય નિર્ણય નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לבחור מה כל כיוון עושה. „העברה לאלבום” מוסיפה את התמונה לאלבום ביישום ״תמונות״ ושומרת אותה. לא לעשות כלום זו אף פעם לא החלטה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर दिशा क्या करे, चुनें। “एल्बम में रखें” फ़ोटो को तस्वीरें ऐप के एल्बम में जोड़कर रखता है। कुछ न करना कभी फ़ैसला नहीं होता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberi što radi svaki smjer. „Stavi u album” dodaje fotografiju u album u aplikaciji Fotografije i zadržava je. Neradnja nikad nije odluka."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válaszd ki, mit tegyen egy-egy irány. Az „Albumba helyezés” a Fotók app egyik albumába teszi a fotót, és megtartja. A semmittevés sosem döntés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih apa yang dilakukan setiap arah. “Masukkan ke album” menambahkan foto ke album di app Foto dan menyimpannya. Tidak melakukan apa-apa tidak pernah dianggap keputusan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli cosa fa ogni direzione. «Metti in album» aggiunge la foto a un album dell’app Foto e la conserva. Non fare nulla non è mai una decisione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "方向ごとの動作を選べます。「アルバムに入れる」は写真を「写真」アプリのアルバムに追加して残します。何もしなければ判断にはなりません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪ್ರತಿ ದಿಕ್ಕು ಏನು ಮಾಡಬೇಕು ಎಂದು ಆಯ್ಕೆಮಾಡಿ. “ಆಲ್ಬಮ್‌ನಲ್ಲಿ ಇರಿಸಿ” ಫೋಟೋವನ್ನು ಫೋಟೋಗಳು ಆ್ಯಪ್‌ನ ಆಲ್ಬಮ್‌ಗೆ ಸೇರಿಸಿ ಇರಿಸುತ್ತದೆ. ಏನೂ ಮಾಡದಿರುವುದು ಎಂದಿಗೂ ನಿರ್ಧಾರವಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방향마다 동작을 정하세요. ‘앨범에 넣기’는 사진을 사진 앱의 앨범에 추가하고 보관해요. 아무것도 하지 않으면 결정이 아니에요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഓരോ ദിശയും എന്ത് ചെയ്യണമെന്ന് തിരഞ്ഞെടുക്കുക. “ആൽബത്തിൽ ഇടുക” ഫോട്ടോ ഫോട്ടോസ് ആപ്പിലെ ഒരു ആൽബത്തിലേക്ക് ചേർത്ത് സൂക്ഷിക്കുന്നു. ഒന്നും ചെയ്യാതിരിക്കുന്നത് ഒരിക്കലും തീരുമാനമല്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्येक दिशा काय करेल ते निवडा. “अल्बममध्ये ठेवा” फोटो फोटो अ‍ॅपच्या अल्बममध्ये जोडतो आणि ठेवतो. काहीही न करणे कधीच निर्णय नसतो."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih apa yang dilakukan oleh setiap arah. “Letak dalam album” menambah foto ke album dalam app Foto dan menyimpannya. Tidak berbuat apa-apa bukanlah keputusan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg hva hver retning gjør. «Legg i album» legger bildet i et album i Bilder-appen og beholder det. Å ikke gjøre noe er aldri en beslutning."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies wat elke richting doet. ‘In album zetten’ voegt de foto toe aan een album in de Foto’s-app en bewaart hem. Niets doen is nooit een beslissing."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପ୍ରତ୍ୟେକ ଦିଗ କ’ଣ କରିବ ବାଛନ୍ତୁ। “ଆଲବମ୍‌ରେ ରଖନ୍ତୁ” ଫଟୋକୁ ଫଟୋ ଆପ୍‌ର ଏକ ଆଲବମ୍‌ରେ ଯୋଗ କରେ ଓ ରଖେ। କିଛି ନକରିବା କେବେ ନିଷ୍ପତ୍ତି ନୁହେଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਚੁਣੋ ਕਿ ਹਰ ਦਿਸ਼ਾ ਕੀ ਕਰੇ। “ਐਲਬਮ ਵਿੱਚ ਪਾਓ” ਫ਼ੋਟੋ ਨੂੰ ਫ਼ੋਟੋਆਂ ਐਪ ਦੀ ਕਿਸੇ ਐਲਬਮ ਵਿੱਚ ਜੋੜਦਾ ਹੈ ਅਤੇ ਉਸ ਨੂੰ ਰੱਖਦਾ ਹੈ। ਕੁਝ ਨਾ ਕਰਨਾ ਕਦੇ ਵੀ ਕੋਈ ਫ਼ੈਸਲਾ ਨਹੀਂ ਹੁੰਦਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz, co robi każdy kierunek. „Dodaj do albumu” dodaje zdjęcie do albumu w aplikacji Zdjęcia i je zachowuje. Brak działania nigdy nie jest decyzją."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha o que cada direção faz. “Colocar no álbum” adiciona a foto a um álbum do app Fotos e a mantém. Não fazer nada nunca é uma decisão."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe o que cada direção faz. «Pôr no álbum» adiciona a fotografia a um álbum da app Fotografias e mantém-na. Não fazer nada nunca é uma decisão."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege ce face fiecare direcție. „Pune în album” adaugă poza într-un album din aplicația Poze și o păstrează. A nu face nimic nu e niciodată o decizie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбери действие для каждого направления. «В альбом» добавляет фото в альбом приложения «Фото» и оставляет его. Бездействие никогда не считается решением."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte, čo robí každý smer. „Vložiť do albumu“ pridá fotku do albumu v aplikácii Fotky a ponechá ju. Nečinnosť nikdy nie je rozhodnutie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izberi, kaj naredi posamezna smer. »Daj v album« doda fotografijo v album v aplikaciji Fotografije in jo obdrži. Nedejavnost nikoli ni odločitev."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj vad varje riktning gör. ”Lägg i album” lägger till bilden i ett album i appen Bilder och behåller den. Att inte göra något är aldrig ett beslut."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒவ்வொரு திசையும் என்ன செய்ய வேண்டும் எனத் தேர்ந்தெடுங்கள். “ஆல்பத்தில் வை” புகைப்படத்தை Photos ஆப்பின் ஒரு ஆல்பத்தில் சேர்த்து வைத்திருக்கும். எதுவும் செய்யாமல் இருப்பது ஒருபோதும் முடிவல்ல."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రతి దిశ ఏమి చేయాలో ఎంచుకోండి. “ఆల్బమ్‌లో ఉంచండి” ఫోటోను Photos యాప్‌లోని ఒక ఆల్బమ్‌కి జోడించి ఉంచుతుంది. ఏమీ చేయకపోవడం ఎప్పుడూ నిర్ణయం కాదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกว่าแต่ละทิศทางจะทำอะไร “ใส่ในอัลบั้ม” จะเพิ่มรูปลงอัลบั้มในแอพรูปภาพและเก็บรูปไว้ การไม่ทำอะไรไม่นับเป็นการตัดสินใจ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her yönün ne yapacağını seç. “Albüme koy”, fotoğrafı Fotoğraflar uygulamasındaki bir albüme ekler ve saklar. Hiçbir şey yapmamak asla bir karar değildir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибери дію для кожного напрямку. «В альбом» додає фото до альбому застосунку «Фото» й залишає його. Бездіяльність ніколи не є рішенням."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "منتخب کریں کہ ہر سمت کیا کرے۔ ”البم میں رکھیں“ تصویر کو تصاویر ایپ کے البم میں شامل کر کے رکھتا ہے۔ کچھ نہ کرنا کبھی فیصلہ نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn hành động cho từng hướng. “Đưa vào album” thêm ảnh vào một album trong ứng dụng Ảnh và giữ lại ảnh. Không làm gì thì không bao giờ là một quyết định."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为每个方向选择操作。“放入相簿”会将照片添加到“照片”App 的相簿并保留。不做任何操作绝不会算作决定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇每個方向的動作。「放入相簿」會把照片加入「照片」App 的相簿並保留它。不做任何動作永遠不算決定。"
          }
        }
      }
    },
