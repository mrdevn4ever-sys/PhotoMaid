    "movie_transition_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بين مقطعين تصبح الصورة سوداء لحظة ثم تظهر تدريجيًا من جديد. عند الإيقاف: انتقال مباشر. يبقى الطول الكلي كما هو."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mellem to klip bliver billedet kort sort og toner derefter ind igen. Fra: hårdt klip. Den samlede længde forbliver den samme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwischen zwei Clips wird das Bild kurz schwarz und blendet dann wieder auf. Aus: harter Schnitt. Die Gesamtlänge bleibt gleich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Between two clips the picture briefly goes black and then fades back in. Off: a hard cut. The total length stays the same."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre dos clips, la imagen pasa un momento a negro y vuelve a aparecer. Desactivado: corte directo. La duración total no cambia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre deux clips, l’image passe brièvement au noir puis réapparaît. Désactivé : coupe franche. La durée totale ne change pas."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di antara dua klip, gambar sebentar menjadi hitam lalu muncul lagi. Mati: potongan langsung. Durasi total tetap sama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tra due clip l’immagine diventa nera per un attimo e poi riappare. Disattivato: stacco netto. La durata totale resta uguale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2つのクリップの間で画面が一瞬黒くなり、再びフェードインします。オフ：そのまま切り替え。全体の長さは変わりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 클립 사이에서 화면이 잠깐 검게 바뀌었다가 다시 나타나요. 끄면 바로 전환돼요. 전체 길이는 그대로예요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mellom to klipp blir bildet kort svart og toner deretter inn igjen. Av: hardt kutt. Den totale lengden forblir den samme."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tussen twee clips wordt het beeld even zwart en komt het daarna weer op. Uit: harde overgang. De totale duur blijft gelijk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Między dwoma klipami obraz na chwilę robi się czarny i znów się pojawia. Wyłączone: ostre cięcie. Łączna długość się nie zmienia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre dois clipes a imagem fica preta por um instante e depois volta aos poucos. Desativado: corte seco. A duração total continua igual."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre dois clipes, a imagem fica preta por instantes e depois volta a aparecer. Desativado: corte direto. A duração total mantém-se."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Între două clipuri, imaginea devine scurt neagră, apoi revine treptat. Dezactivat: tăietură directă. Durata totală rămâne aceeași."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Между двумя клипами изображение ненадолго становится чёрным, затем снова появляется. Выкл.: резкая склейка. Общая длина не меняется."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mellan två klipp blir bilden kort svart och tonar sedan in igen. Av: hårt klipp. Den totala längden förblir densamma."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระหว่างสองคลิป ภาพจะมืดลงครู่หนึ่งแล้วค่อยๆ กลับมา ปิด: ตัดตรง ความยาวรวมไม่เปลี่ยน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İki klip arasında görüntü kısa süre kararır, sonra yeniden belirir. Kapalı: doğrudan geçiş. Toplam süre aynı kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Між двома кліпами зображення ненадовго стає чорним, а потім знову з’являється. Вимк.: різка склейка. Загальна тривалість не змінюється."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữa hai đoạn, hình ảnh tối đen một chút rồi hiện dần trở lại. Tắt: cắt thẳng. Tổng thời lượng không đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
