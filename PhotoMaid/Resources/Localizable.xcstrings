    "vault_recovery_missing": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدون مفتاح استرداد، يضيع المحتوى إذا نسيت رمزك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রিকভারি কী ছাড়া কোড ভুলে গেলে বিষয়বস্তু হারিয়ে যায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Sense clau de recuperació, el contingut es perd si oblides el codi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez klíče pro obnovení je obsah ztracen, pokud zapomenete kód."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Uden gendannelsesnøgle går indholdet tabt, hvis du glemmer din kode."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Notfallschlüssel ist der Inhalt verloren, wenn du den Code vergisst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χωρίς κλειδί ανάκτησης, το περιεχόμενο χάνεται αν ξεχάσεις τον κωδικό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without a recovery key, the content is lost if you forget your code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin clave de recuperación, el contenido se pierde si olvidas tu código."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilman palautusavainta sisältö menetetään, jos unohdat koodisi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans clé de secours, le contenu est perdu si tu oublies ton code."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
