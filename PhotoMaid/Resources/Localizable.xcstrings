    "privacy_notifications_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختياري: تذكير عندما يحين وقت مراجعة شيء في «لاحقًا». لن تظهر أسماء الملفات على شاشة القفل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঐচ্ছিক: “পরে”-তে কিছু পর্যালোচনার জন্য প্রস্তুত হলে রিমাইন্ডার পান। ফাইলের নাম আপনার লক স্ক্রিনে দেখা যাবে না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional: rep un recordatori quan alguna cosa de «Més tard» estigui llesta per revisar. Els noms dels fitxers no apareixen a la pantalla bloquejada."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Volitelné: připomenutí, když je něco v „Později“ připraveno k procházení. Názvy souborů se na zamčené obrazovce nezobrazí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgfrit: få en påmindelse, når noget i “Senere” er klar til gennemgang. Filnavne vises ikke på låseskærmen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional: Wir erinnern dich, wenn etwas aus „Später“ wieder dran ist. Dateinamen erscheinen nicht auf dem Sperrbildschirm."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προαιρετικά: λάβε υπενθύμιση όταν κάτι στο «Αργότερα» είναι έτοιμο για έλεγχο. Τα ονόματα αρχείων δεν εμφανίζονται στην οθόνη κλειδώματος."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional: get a reminder when something in “Later” is ready to review. Filenames won’t appear on your lock screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional: recibe un aviso cuando toque revisar algo de «Después». Los nombres de archivo no aparecen en la pantalla de bloqueo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valinnainen: saat muistutuksen, kun jokin kohteessa ”Myöhemmin” on valmiina läpikäyntiin. Tiedostonimiä ei näytetä lukitulla näytöllä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif : reçois un rappel quand un élément de « Plus tard » est à revoir. Les noms de fichiers n’apparaissent pas sur l’écran verrouillé."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "વૈકલ્પિક: “પછી” માંનું કંઈક જોવા માટે તૈયાર થાય ત્યારે રિમાઇન્ડર મેળવો. ફાઇલનાં નામ લૉક સ્ક્રીન પર દેખાતાં નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אופציונלי: תזכורת כשמשהו ב„מאוחר יותר” מוכן לסקירה. שמות קבצים לא מופיעים במסך הנעילה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वैकल्पिक: जब “बाद में” में कुछ देखने के लिए तैयार हो, तब रिमाइंडर पाएँ। फ़ाइल नाम लॉक स्क्रीन पर नहीं दिखते।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neobavezno: dobij podsjetnik kad je nešto u „Kasnije” spremno za pregled. Nazivi datoteka ne prikazuju se na zaključanom zaslonu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem kötelező: emlékeztetőt kapsz, ha a „Később” valamelyik eleme átnézésre kész. A fájlnevek nem jelennek meg a zárolási képernyőn."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Opsional: dapatkan pengingat saat sesuatu di “Nanti” siap ditinjau. Nama file tidak muncul di layar kunci."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Facoltativo: ricevi un promemoria quando è il momento di rivedere qualcosa in «Più tardi». I nomi dei file non appaiono sulla schermata di blocco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意：「あとで」にあるものを確認する日に通知します。ロック画面にファイル名は表示しません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಐಚ್ಛಿಕ: “ನಂತರ” ದಲ್ಲಿರುವ ಏನೋ ಪರಿಶೀಲನೆಗೆ ಸಿದ್ಧವಾದಾಗ ಜ್ಞಾಪನೆ ಪಡೆಯಿರಿ. ಫೈಲ್ ಹೆಸರುಗಳು ನಿಮ್ಮ ಲಾಕ್ ಸ್ಕ್ರೀನ್‌ನಲ್ಲಿ ಕಾಣಿಸುವುದಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 사항: ‘나중에’에서 다시 볼 때가 되면 알려 드려요. 잠금 화면에는 파일 이름을 표시하지 않아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഓപ്ഷണൽ: “പിന്നീട്” എന്നതിലെ എന്തെങ്കിലും പരിശോധനയ്ക്ക് തയ്യാറാകുമ്പോൾ ഓർമ്മപ്പെടുത്തൽ നേടുക. ഫയൽ പേരുകൾ നിങ്ങളുടെ ലോക്ക് സ്ക്രീനിൽ ദൃശ്യമാകില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पर्यायी: “नंतर” मधील काहीतरी पाहण्यासाठी तयार झाल्यावर आठवण मिळवा. फाइलची नावे लॉक स्क्रीनवर दिसत नाहीत."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilihan: dapatkan peringatan apabila sesuatu dalam “Nanti” sedia untuk disemak. Nama fail tidak akan dipaparkan pada skrin kunci anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgfritt: få en påminnelse når noe i «Senere» er klart til gjennomgang. Filnavn vises ikke på låseskjermen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Optioneel: krijg een herinnering als iets uit ‘Later’ weer aan de beurt is. Bestandsnamen verschijnen niet op je vergrendelscherm."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ବୈକଳ୍ପିକ: “ପରେ”ରେ କିଛି ସମୀକ୍ଷା ପାଇଁ ପ୍ରସ୍ତୁତ ହେଲେ ସ୍ମାରକ ପାଆନ୍ତୁ। ଫାଇଲ୍ ନାମ ଆପଣଙ୍କ ଲକ୍ ସ୍କ୍ରିନ୍‌ରେ ଦେଖାଯିବ ନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਵਿਕਲਪਿਕ: ਜਦੋਂ “ਬਾਅਦ ਵਿੱਚ” ਵਿੱਚ ਕੁਝ ਸਮੀਖਿਆ ਲਈ ਤਿਆਰ ਹੋਵੇ ਤਾਂ ਯਾਦ-ਦਹਾਨੀ ਪ੍ਰਾਪਤ ਕਰੋ। ਫ਼ਾਈਲਾਂ ਦੇ ਨਾਂ ਤੁਹਾਡੀ ਲੌਕ ਸਕ੍ਰੀਨ ਉੱਤੇ ਨਹੀਂ ਦਿਸਣਗੇ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcjonalnie: otrzymasz przypomnienie, gdy przyjdzie czas na coś z „Później”. Nazwy plików nie pojawią się na ekranie blokady."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional: receba um lembrete quando algo em “Depois” estiver pronto para revisar. Nomes de arquivos não aparecem na tela bloqueada."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional: recebe um lembrete quando for altura de rever algo de «Mais tarde». Os nomes dos ficheiros não aparecem no ecrã bloqueado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Opțional: primești un memento când este timpul să revezi ceva din „Mai târziu”. Numele fișierelor nu apar pe ecranul blocat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По желанию: напоминание, когда пора посмотреть что-то из «Позже». Имена файлов не показываются на экране блокировки."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Voliteľné: pripomenutie, keď je niečo v „Neskôr“ pripravené na prezretie. Názvy súborov sa na zamknutej obrazovke nezobrazia."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neobvezno: prejmi opomnik, ko je nekaj v »Pozneje« pripravljeno za pregled. Imena datotek se ne prikažejo na zaklenjenem zaslonu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Valfritt: få en påminnelse när något i ”Senare” är redo att gå igenom. Filnamn visas inte på låsskärmen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "விருப்பத்தேர்வு: “பிறகு”-இல் உள்ள ஒன்று பார்வையிடத் தயாரானதும் நினைவூட்டலைப் பெறுங்கள். கோப்புப் பெயர்கள் உங்கள் பூட்டுத் திரையில் தோன்றாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఐచ్ఛికం: “తర్వాత”లోని ఏదైనా సమీక్షకు సిద్ధమైనప్పుడు రిమైండర్ పొందండి. ఫైల్ పేర్లు మీ లాక్ స్క్రీన్‌లో కనిపించవు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่บังคับ: รับการเตือนเมื่อมีรายการใน “ไว้ทีหลัง” พร้อมตรวจดู ชื่อไฟล์จะไม่ปรากฏบนหน้าจอล็อก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İsteğe bağlı: “Sonra” bölümündeki bir öğeyi inceleme zamanı gelince hatırlatma al. Kilit ekranında dosya adları görünmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За бажанням: нагадування, коли час переглянути щось із «Пізніше». Назви файлів не показуються на екрані блокування."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اختیاری: جب ”بعد میں“ میں کچھ جائزے کے لیے تیار ہو تو یاد دہانی پائیں۔ فائلوں کے نام لاک اسکرین پر نہیں دکھتے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tùy chọn: nhận lời nhắc khi có mục trong “Để sau” sẵn sàng xem lại. Tên tệp không hiện trên màn hình khóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选：当“稍后”中的内容可以再次查看时提醒你。锁屏通知不会显示文件名。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選用：當「稍後」中的項目可以整理時提醒你。檔名不會出現在鎖定畫面上。"
          }
        }
      }
    },
