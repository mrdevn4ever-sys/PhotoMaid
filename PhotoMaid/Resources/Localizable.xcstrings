        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಲಹೆ: ಅವು ಅಲ್ಲಿಂದಲೂ ಮಾಯವಾಗಬೇಕಿದ್ದರೆ ಫೋಟೋಗಳು ಆ್ಯಪ್‌ನಲ್ಲಿ “ಇತ್ತೀಚೆಗೆ ಅಳಿಸಲಾಗಿದೆ” ಖಾಲಿ ಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팁: 사진 앱에서도 없애려면 ‘최근 삭제된 항목’을 비우세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നുറുങ്ങ്: അവ അവിടെനിന്നും അപ്രത്യക്ഷമാകണമെങ്കിൽ ഫോട്ടോസ് ആപ്പിൽ “അടുത്തിടെ ഇല്ലാതാക്കിയവ” ശൂന്യമാക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "टीप: त्या तिथूनही नाहीशा व्हाव्यात असे वाटत असल्यास फोटो अ‍ॅपमधील “अलीकडे डिलीट केलेले” रिकामे करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Petua: kosongkan “Dipadam Baru-baru Ini” dalam app Foto jika ia perlu hilang di sana juga."
          }
        },
        "nb": {
          "stringUnit": {
