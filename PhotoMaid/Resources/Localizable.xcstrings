    "startup_failed_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تحميل قراراتك المحفوظة. لم يتغيّر أو يُحذف أي شيء. أعد تشغيل GaleriQ؛ وإن لم يُفد ذلك فشارك التشخيص."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine gemte beslutninger kunne ikke indlæses. Intet er ændret eller slettet. Genstart GaleriQ; hjælper det ikke, så del diagnosticeringen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine gespeicherten Entscheidungen konnten nicht geladen werden. Es wurde nichts verändert oder gelöscht. Starte GaleriQ neu; hilft das nicht, teile die Diagnose."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your saved decisions couldn’t be loaded. Nothing was changed or deleted. Restart GaleriQ; if that doesn’t help, share the diagnostics."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han podido cargar tus decisiones guardadas. No se ha cambiado ni borrado nada. Reinicia GaleriQ; si no funciona, comparte el diagnóstico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos décisions enregistrées n’ont pas pu être chargées. Rien n’a été modifié ni supprimé. Redémarrez GaleriQ ; si cela ne suffit pas, partagez le diagnostic."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Keputusan yang tersimpan tidak dapat dimuat. Tidak ada yang diubah atau dihapus. Mulai ulang GaleriQ; jika tidak membantu, bagikan diagnostik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile caricare le tue decisioni salvate. Nulla è stato modificato o eliminato. Riavvia GaleriQ; se non basta, condividi la diagnostica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存した判断を読み込めませんでした。何も変更・削除されていません。GaleriQを再起動し、それでも直らない場合は診断を共有してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 결정을 불러올 수 없습니다. 변경되거나 삭제된 것은 없습니다. GaleriQ를 다시 시작하고, 그래도 안 되면 진단을 공유하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "De lagrede beslutningene dine kunne ikke lastes inn. Ingenting er endret eller slettet. Start GaleriQ på nytt; hjelper ikke det, del diagnostikken."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je opgeslagen keuzes konden niet worden geladen. Er is niets gewijzigd of verwijderd. Start GaleriQ opnieuw; helpt dat niet, deel dan de diagnose."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się wczytać zapisanych decyzji. Niczego nie zmieniono ani nie usunięto. Uruchom GaleriQ ponownie; jeśli to nie pomoże, udostępnij diagnostykę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar suas decisões salvas. Nada foi alterado nem apagado. Reinicie o GaleriQ; se não ajudar, compartilhe o diagnóstico."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar as suas decisões guardadas. Nada foi alterado nem apagado. Reinicie o GaleriQ; se não resultar, partilhe o diagnóstico."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deciziile salvate nu au putut fi încărcate. Nimic nu a fost modificat sau șters. Repornește GaleriQ; dacă nu ajută, partajează diagnosticul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить сохранённые решения. Ничего не изменено и не удалено. Перезапустите GaleriQ; если не поможет, поделитесь диагностикой."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina sparade beslut kunde inte läsas in. Inget har ändrats eller raderats. Starta om GaleriQ; hjälper det inte, dela diagnostiken."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โหลดการตัดสินใจที่บันทึกไว้ไม่ได้ ไม่มีอะไรถูกเปลี่ยนหรือลบ เปิด GaleriQ ใหม่ หากยังไม่ได้ผล ให้แชร์ข้อมูลวินิจฉัย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlı kararların yüklenemedi. Hiçbir şey değiştirilmedi veya silinmedi. GaleriQ’i yeniden başlat; işe yaramazsa tanılamayı paylaş."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося завантажити збережені рішення. Нічого не змінено й не видалено. Перезапустіть GaleriQ; якщо не допоможе, поділіться діагностикою."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tải được các quyết định đã lưu. Không có gì bị thay đổi hay xóa. Hãy khởi động lại GaleriQ; nếu vẫn không được, hãy chia sẻ dữ liệu chẩn đoán."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法载入你保存的决定。没有任何内容被更改或删除。请重新启动 GaleriQ；若仍无效，请共享诊断信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法載入你已儲存的決定。沒有更改或刪除任何內容。請重新啟動 GaleriQ；若仍無法解決，請分享診斷資料。"
          }
        }
      }
    },
