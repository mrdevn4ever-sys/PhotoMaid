    "tools_exposure_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أقل من 0 يجعل الصور أغمق، وأكثر من 0 أفتح."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter 0 werden Fotos dunkler, über 0 heller."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Below 0 makes photos darker, above 0 brighter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por debajo de 0 las fotos se oscurecen; por encima, se aclaran."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En dessous de 0, les photos s’assombrissent ; au-dessus, elles s’éclaircissent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sotto lo 0 le foto diventano più scure, sopra più chiare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "0より下で暗く、0より上で明るくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "0보다 낮으면 어두워지고, 높으면 밝아져요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Onder 0 worden foto’s donkerder, boven 0 lichter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poniżej 0 zdjęcia ciemnieją, powyżej 0 jaśnieją."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abaixo de 0 as fotografias ficam mais escuras; acima, mais claras."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sub 0 fotografiile devin mai întunecate, peste 0 mai luminoase."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ниже 0 – фото темнее, выше 0 – светлее."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "0’ın altı fotoğrafları koyulaştırır, üstü aydınlatır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нижче 0 – фото темніші, вище 0 – світліші."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "低于 0 照片变暗，高于 0 变亮。"
          }
