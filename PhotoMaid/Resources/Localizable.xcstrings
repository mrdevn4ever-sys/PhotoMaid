    "blocks_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أكمل الصفوف واكتشف صورك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সারি খালি করুন এবং আপনার ফটো উন্মোচন করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina files i descobreix les teves fotos."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstraňujte řady a odhalujte své fotky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ryd rækker, og afslør dine fotos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entferne Reihen und entdecke deine Fotos."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Καθάρισε σειρές και αποκάλυψε τις φωτογραφίες σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear rows and discover your photos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa filas y descubre tus fotos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poista rivejä ja paljasta kuvasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Complète des lignes et découvre tes photos."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હાર સાફ કરો અને તમારા ફોટા ખોલો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לנקות שורות ולחשוף את התמונות שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पंक्तियाँ साफ़ करें और अपनी फ़ोटो खोलें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uklanjaj redove i otkrivaj svoje fotografije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüntess el sorokat, és fedd fel a fotóidat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus baris dan ungkap fotomu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa le righe e scopri le tue foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "列をそろえて、写真を見つけよう。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಾಲುಗಳನ್ನು ತೆರವುಗೊಳಿಸಿ ಮತ್ತು ನಿಮ್ಮ ಫೋಟೋಗಳನ್ನು ಅನಾವರಣಗೊಳಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "줄을 완성하고 내 사진을 발견하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വരികൾ മായ്ച്ച് നിങ്ങളുടെ ഫോട്ടോകൾ വെളിപ്പെടുത്തുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ओळी साफ करा आणि तुमचे फोटो उघडा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapuskan baris dan dedahkan foto anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjern rader og avslør bildene dine."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak rijen vol en ontdek je foto’s."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଧାଡ଼ି ସଫା କରନ୍ତୁ ଏବଂ ଆପଣଙ୍କ ଫଟୋ ଉନ୍ମୋଚନ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕਤਾਰਾਂ ਸਾਫ਼ ਕਰੋ ਅਤੇ ਆਪਣੀਆਂ ਫ਼ੋਟੋਆਂ ਖੋਲ੍ਹੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuwaj rzędy i odkrywaj swoje zdjęcia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpe linhas e revele suas fotos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa linhas e descobre as tuas fotografias."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Completează rânduri și descoperă-ți fotografiile."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заполняй ряды и открывай свои фото."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstraňujte rady a odhaľujte svoje fotky."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstranjuj vrstice in odkrivaj svoje fotografije."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rensa rader och avslöja dina bilder."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வரிசைகளை அழித்து உங்கள் புகைப்படங்களை வெளிப்படுத்துங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వరుసలను క్లియర్ చేసి మీ ఫోటోలను బయటపెట్టండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เคลียร์แถวแล้วเปิดเผยรูปภาพของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satırları tamamla, fotoğraflarını keşfet."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Заповнюй ряди й відкривай свої фото."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "قطاریں صاف کریں اور اپنی تصاویر کھولیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa hàng và làm lộ ảnh của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "消除整行，发现你的照片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "消除整行，揭曉你的照片。"
          }
        }
      }
