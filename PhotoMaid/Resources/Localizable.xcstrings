    "lib_hidden_none_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم «إخفاء في GaleriQ» على ألبوم أو صورة أو تحديد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো অ্যালবাম, ফটো বা নির্বাচনে “GaleriQ-এ লুকান” ব্যবহার করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fes servir «Amagar a GaleriQ» en un àlbum, una foto o una selecció."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použijte „Skrýt v GaleriQ“ u alba, fotky nebo výběru."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug “Skjul i GaleriQ” på et album, et foto eller et udvalg."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze „In GaleriQ ausblenden“ bei einem Album, einem Foto oder einer Auswahl."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρησιμοποίησε το «Απόκρυψη στο GaleriQ» σε άλμπουμ, φωτογραφία ή επιλογή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use “Hide in GaleriQ” on an album, a photo or a selection."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa «Ocultar en GaleriQ» en un álbum, una foto o una selección."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytä toimintoa ”Piilota GaleriQ:ssa” albumissa, kuvassa tai valinnassa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez « Masquer dans GaleriQ » sur un album, une photo ou une sélection."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આલ્બમ, ફોટો કે પસંદગી પર “GaleriQ માં છુપાવો” વાપરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר להשתמש ב„הסתרה ב-GaleriQ” באלבום, בתמונה או בבחירה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी एल्बम, फ़ोटो या चयन पर “GaleriQ में छिपाएँ” इस्तेमाल करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koristi „Sakrij u GaleriQ-u” na albumu, fotografiji ili odabiru."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Használd az „Elrejtés a GaleriQ-ban” funkciót egy albumon, fotón vagy kijelölésen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pakai “Sembunyikan di GaleriQ” pada album, foto, atau pilihan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa «Nascondi in GaleriQ» su un album, una foto o una selezione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アルバム、写真、選択項目で「GaleriQで非表示」を使います。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆಲ್ಬಮ್, ಫೋಟೋ ಅಥವಾ ಆಯ್ಕೆಯ ಮೇಲೆ “GaleriQ ನಲ್ಲಿ ಮರೆಮಾಡಿ” ಬಳಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앨범, 사진 또는 선택 항목에서 'GaleriQ에서 숨기기'를 사용하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരു ആൽബത്തിലോ ഫോട്ടോയിലോ തിരഞ്ഞെടുപ്പിലോ “GaleriQ-ൽ മറയ്ക്കുക” ഉപയോഗിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अल्बम, फोटो किंवा निवडीवर “GaleriQ मध्ये लपवा” वापरा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan “Sembunyikan dalam GaleriQ” pada album, foto atau pilihan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk «Skjul i GaleriQ» på et album, et bilde eller et utvalg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik ‘Verbergen in GaleriQ’ bij een album, foto of selectie."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏକ ଆଲବମ୍, ଫଟୋ କିମ୍ବା ଚୟନରେ “GaleriQରେ ଲୁଚାନ୍ତୁ” ବ୍ୟବହାର କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕਿਸੇ ਐਲਬਮ, ਫ਼ੋਟੋ ਜਾਂ ਚੋਣ ਉੱਤੇ “GaleriQ ਵਿੱਚ ਲੁਕਾਓ” ਵਰਤੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj „Ukryj w GaleriQ” przy albumie, zdjęciu lub zaznaczeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use “Ocultar no GaleriQ” num álbum, numa foto ou numa seleção."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Use «Ocultar no GaleriQ» num álbum, numa fotografia ou numa seleção."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Folosește „Ascunde în GaleriQ” la un album, o poză sau o selecție."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте «Скрыть в GaleriQ» для альбома, фото или выбранного."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Použite „Skryť v GaleriQ“ pri albume, fotke alebo výbere."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uporabi »Skrij v GaleriQ« na albumu, fotografiji ali izboru."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd ”Dölj i GaleriQ” på ett album, en bild eller ett urval."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு ஆல்பம், புகைப்படம் அல்லது தேர்வில் “GaleriQ-இல் மறை” பயன்படுத்துங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆల్బమ్, ఫోటో లేదా ఎంపికపై “GaleriQలో దాచు” వాడండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ “ซ่อนใน GaleriQ” กับอัลบั้ม รูปภาพ หรือรายการที่เลือก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir albümde, fotoğrafta veya seçimde \"GaleriQ’de gizle\"yi kullan."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скористайтеся «Сховати в GaleriQ» для альбому, фото чи вибраного."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کسی البم، تصویر یا انتخاب پر ”GaleriQ میں چھپائیں“ استعمال کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng “Ẩn trong GaleriQ” trên album, ảnh hoặc một lựa chọn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对相簿、照片或所选内容使用“在 GaleriQ 中隐藏”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在相簿、照片或選取的項目上使用「在 GaleriQ 中隱藏」。"
          }
        }
      }
    },
    "lib_hidden_none_title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا شيء مخفي"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কিছুই লুকানো নেই"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No hi ha res amagat"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic není skryto"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet skjult"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts ausgeblendet"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τίποτα κρυφό"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing hidden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada oculto"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitään ei ole piilotettu"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien de masqué"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કંઈ છુપાયેલું નથી"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שום דבר לא מוסתר"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ भी छिपा नहीं"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ništa nije skriveno"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Semmi sincs elrejtve"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada yang disembunyikan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente di nascosto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非表示の項目はありません"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಏನನ್ನೂ ಮರೆಮಾಡಿಲ್ಲ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "숨긴 항목 없음"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒന്നും മറച്ചിട്ടില്ല"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "काहीही लपवलेले नाही"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada yang tersembunyi"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting skjult"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niets verborgen"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "କିଛି ଲୁଚାଯାଇନାହିଁ"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੁਝ ਵੀ ਲੁਕਿਆ ਨਹੀਂ"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie jest ukryte"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada oculto"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada oculto"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimic ascuns"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего не скрыто"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nič nie je skryté"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nič ni skrito"
          }
