    "art_later_sub": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صور ما زلت مترددًا بشأنها."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos, du stadig er i tvivl om."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos, bei denen du dir noch unsicher bist."
          }
        },
        "en": {
