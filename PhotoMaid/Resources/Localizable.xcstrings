    "movie_music_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملفك الخاص، يُشغَّل من البداية ويتكرر عند الحاجة. لا يتضمن PhotoMaid موسيقى. انتبه للحقوق عند المشاركة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eigene Datei, von Anfang an und bei Bedarf wiederholt. PhotoMaid liefert keine Musik mit. Beim Teilen auf die Rechte achten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your own file, played from the start and repeated if needed. PhotoMaid includes no music. Mind the rights when sharing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu propio archivo, desde el inicio y repetido si hace falta. PhotoMaid no incluye música. Ten en cuenta los derechos al compartir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre propre fichier, depuis le début et répété si besoin. PhotoMaid ne fournit pas de musique. Attention aux droits en cas de partage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tuo file, dall’inizio e ripetuto se serve. PhotoMaid non include musica. Attenzione ai diritti quando condividi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分のファイルを先頭から再生し、必要なら繰り返します。PhotoMaidに音楽は含まれません。共有時は権利に注意してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 고른 파일이 처음부터 재생되며 필요하면 반복됩니다. PhotoMaid는 음악을 제공하지 않습니다. 공유할 때 권리에 유의하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je eigen bestand, vanaf het begin en zo nodig herhaald. PhotoMaid levert geen muziek. Let bij delen op de rechten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Własny plik, od początku i w razie potrzeby powtarzany. PhotoMaid nie zawiera muzyki. Przy udostępnianiu pamiętaj o prawach."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O seu próprio ficheiro, desde o início e repetido se necessário. O PhotoMaid não inclui música. Atenção aos direitos ao partilhar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fișierul tău, de la început și repetat la nevoie. PhotoMaid nu include muzică. Ai grijă la drepturi când distribui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш файл, с начала и с повтором при необходимости. В PhotoMaid нет встроенной музыки. При публикации учитывайте права."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendi dosyan, baştan çalar ve gerekirse tekrarlanır. PhotoMaid müzik içermez. Paylaşırken haklara dikkat et."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш файл, з початку й з повтором за потреби. У PhotoMaid немає вбудованої музики. Під час поширення зважайте на права."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用你自己的文件，从头播放，必要时循环。PhotoMaid 不附带音乐。分享时请注意版权。"
          }
        }
      }
    },
