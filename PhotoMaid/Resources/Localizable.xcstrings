        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld ಐಟಂಗಳ ಗಾತ್ರಗಳು ಅಜ್ಞಾತ. ಅವುಗಳನ್ನು ಒಟ್ಟು ಮೊತ್ತದಲ್ಲಿ ಸೇರಿಸಿಲ್ಲ."
