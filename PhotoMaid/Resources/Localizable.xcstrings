    "vid_cut_draft": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إزالة %1$@ – %2$@؟ اسحب المقابض الحمراء."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjern %1$@ – %2$@? Træk i de røde håndtag."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ – %2$@ entfernen? Rote Griffe ziehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove %1$@ – %2$@? Drag the red handles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Quitar %1$@ – %2$@? Arrastra los tiradores rojos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer %1$@ – %2$@ ? Fais glisser les poignées rouges."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus %1$@ – %2$@? Seret pegangan merah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuovere %1$@ – %2$@? Trascina le maniglie rosse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ – %2$@ を削除しますか？赤いハンドルをドラッグ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ – %2$@를 제거할까요? 빨간 핸들을 끌어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjerne %1$@ – %2$@? Dra i de røde håndtakene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ – %2$@ verwijderen? Sleep de rode grepen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunąć %1$@ – %2$@? Przeciągnij czerwone uchwyty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remover %1$@ – %2$@? Arraste as alças vermelhas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Remover %1$@ – %2$@? Arrasta as pegas vermelhas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimini %1$@ – %2$@? Trage de mânerele roșii."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить %1$@ – %2$@? Перетащи красные маркеры."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta bort %1$@ – %2$@? Dra i de röda handtagen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นำออก %1$@ – %2$@ ใช่ไหม? ลากจุดจับสีแดง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ – %2$@ kaldırılsın mı? Kırmızı tutamaçları sürükle."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видалити %1$@ – %2$@? Перетягни червоні маркери."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa %1$@ – %2$@? Kéo các tay cầm màu đỏ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除 %1$@ – %2$@？拖动红色手柄。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要移除 %1$@ – %2$@ 嗎？拖移紅色控點。"
          }
        }
      }
    },
    "vid_cut_hint_restore": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُزال المقاطع الحمراء فعلًا عند الحفظ (الطول الكلي %1$@). اضغط على مقطع أدناه لاستعادته."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Røde afsnit fjernes rigtigt, når du gemmer (i alt %1$@). Tryk på et afsnit nedenfor for at hente det tilbage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rote Bereiche werden beim Speichern wirklich entfernt (Gesamtlänge %1$@). Tippe unten auf einen Bereich, um ihn zurückzuholen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Red sections are really removed when saving (total %1$@). Tap a section below to bring it back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las zonas rojas se eliminan de verdad al guardar (total %1$@). Toca una abajo para recuperarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les passages rouges sont vraiment supprimés à l’enregistrement (durée totale %1$@). Touche un passage ci-dessous pour le récupérer."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bagian merah benar-benar dihapus saat disimpan (total %1$@). Ketuk bagian di bawah untuk mengembalikannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le parti rosse vengono davvero rimosse al salvataggio (totale %1$@). Tocca una parte qui sotto per recuperarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "赤い区間は保存時に実際に削除されます（全体 %1$@）。下の区間をタップすると元に戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빨간 구간은 저장할 때 실제로 제거돼요(전체 %1$@). 아래 구간을 탭하면 되돌려요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Røde deler fjernes virkelig når du lagrer (totalt %1$@). Trykk på en del nedenfor for å hente den tilbake."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rode stukken worden bij opslaan echt verwijderd (totaal %1$@). Tik hieronder op een stuk om het terug te halen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czerwone fragmenty są przy zapisie naprawdę usuwane (całość %1$@). Dotknij fragmentu poniżej, aby go przywrócić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As partes vermelhas são removidas de verdade ao salvar (total %1$@). Toque numa parte abaixo para trazê-la de volta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As partes vermelhas são mesmo removidas ao guardar (total %1$@). Toca numa parte abaixo para a recuperar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Porțiunile roșii sunt eliminate cu adevărat la salvare (total %1$@). Atinge o porțiune de mai jos ca s-o recuperezi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Красные фрагменты при сохранении действительно удаляются (всего %1$@). Нажми на фрагмент ниже, чтобы вернуть его."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Röda avsnitt tas verkligen bort när du sparar (totalt %1$@). Tryck på ett avsnitt nedan för att ta tillbaka det."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่วนสีแดงจะถูกนำออกจริงเมื่อบันทึก (รวม %1$@) แตะส่วนด้านล่างเพื่อนำกลับมา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kırmızı bölümler kaydederken gerçekten kaldırılır (toplam %1$@). Geri almak için aşağıdaki bir bölüme dokun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Червоні фрагменти під час збереження справді видаляються (усього %1$@). Торкнися фрагмента нижче, щоб повернути його."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các đoạn màu đỏ sẽ thật sự bị xóa khi lưu (tổng %1$@). Chạm vào một đoạn bên dưới để lấy lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "红色片段会在保存时真正删除（总长 %1$@）。点按下方片段即可恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "紅色片段會在儲存時真正移除（共 %1$@）。點一下下方的片段即可恢復。"
          }
        }
      }
    },
