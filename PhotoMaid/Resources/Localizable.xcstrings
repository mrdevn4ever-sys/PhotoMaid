    },
    "lib_hide_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن يعرضها GaleriQ بعد الآن – لا في «الصور» ولا أثناء التنظيف. تبقى الملفات كما هي وتظل مرئية في التطبيقات الأخرى. هذه ليست خزنة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ এগুলো আর দেখাবে না – ফটোতেও নয়, পরিষ্কারের সময়ও নয়। ফাইলগুলো অপরিবর্তিত থাকে এবং অন্য অ্যাপে দেখা যায়। এটি ভল্ট নয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ deixarà de mostrar-los, ni a Fotos ni en endreçar. Els fitxers no canvien i continuen visibles en altres apps. Això no és una caixa forta."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ je přestane zobrazovat – ve Fotkách ani při úklidu. Soubory zůstanou beze změny a v jiných aplikacích viditelné. Nejde o trezor."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ viser dem ikke længere – hverken under Fotos eller under oprydning. Filerne forbliver uændrede og er stadig synlige i andre apps. Dette er ikke en boks."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ zeigt sie nicht mehr – weder unter „Fotos“ noch beim Aufräumen. Die Dateien bleiben unverändert und in anderen Apps sichtbar. Das ist kein Tresor."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το GaleriQ δεν θα τα εμφανίζει πια – ούτε στις Φωτογραφίες ούτε στο τακτοποίημα. Τα αρχεία μένουν αμετάβλητα και ορατά σε άλλες εφαρμογές. Αυτό δεν είναι θησαυροφυλάκιο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ will no longer show them – not under Photos and not during cleanup. The files stay unchanged and remain visible in other apps. This is not a safe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ dejará de mostrarlos, ni en Fotos ni al limpiar. Los archivos no cambian y siguen visibles en otras apps. No es una caja fuerte."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ei enää näytä niitä – ei Kuvissa eikä siivotessa. Tiedostot pysyvät ennallaan ja näkyvät muissa apeissa. Tämä ei ole holvi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ne les affichera plus, ni dans Photos ni pendant le nettoyage. Les fichiers restent inchangés et visibles dans les autres apps. Ce n’est pas un coffre-fort."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ તેમને હવે બતાવશે નહીં – ન ફોટોમાં, ન સાફસફાઈમાં. ફાઇલો બદલાતી નથી અને બીજી ઍપમાં દેખાતી રહે છે. આ વૉલ્ટ નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ לא תציג אותם יותר – לא תחת ״תמונות״ ולא בזמן הסידור. הקבצים לא משתנים ונשארים גלויים ביישומים אחרים. זו לא כספת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ इन्हें अब नहीं दिखाएगा – न तस्वीरें में, न सफ़ाई में। फ़ाइलें नहीं बदलतीं और दूसरे ऐप में दिखती रहती हैं। यह तिजोरी नहीं है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ih više neće prikazivati – ni pod Fotografijama ni pri raščišćavanju. Datoteke ostaju nepromijenjene i vidljive u drugim aplikacijama. Ovo nije trezor."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A GaleriQ többé nem jeleníti meg őket – sem a Fotók alatt, sem rendrakáskor. A fájlok változatlanok, és más appokban láthatók maradnak. Ez nem széf."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ tidak akan menampilkannya lagi – tidak di Foto dan tidak saat merapikan. File-nya tidak berubah dan tetap terlihat di app lain. Ini bukan brankas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ non li mostrerà più, né in Foto né durante la pulizia. I file restano invariati e visibili nelle altre app. Non è una cassaforte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ では「写真」にも整理中にも表示されなくなります。ファイルはそのままで、他のアプリでは表示されます。金庫ではありません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ಇನ್ನು ಇವುಗಳನ್ನು ತೋರಿಸುವುದಿಲ್ಲ – ಫೋಟೋಗಳ ಅಡಿಯಲ್ಲೂ ಅಲ್ಲ, ಸ್ವಚ್ಛಗೊಳಿಸುವಾಗಲೂ ಅಲ್ಲ. ಫೈಲ್‌ಗಳು ಬದಲಾಗದೆ ಉಳಿಯುತ್ತವೆ ಮತ್ತು ಇತರ ಆ್ಯಪ್‌ಗಳಲ್ಲಿ ಕಾಣಿಸುತ್ತವೆ. ಇದು ವಾಲ್ಟ್ ಅಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ에서 더 이상 사진 탭과 정리 중에 표시되지 않습니다. 파일은 그대로이며 다른 앱에서는 계속 보입니다. 금고가 아닙니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ഇനി ഇവ കാണിക്കില്ല – ഫോട്ടോകൾക്ക് കീഴിലോ വൃത്തിയാക്കുമ്പോഴോ അല്ല. ഫയലുകൾക്ക് മാറ്റമില്ല, മറ്റ് ആപ്പുകളിൽ ദൃശ്യമായി തുടരും. ഇത് വോൾട്ട് അല്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ते आता दाखवणार नाही – फोटोमध्येही नाही आणि साफसफाईतही नाही. फाइल्स बदलत नाहीत आणि इतर अ‍ॅप्समध्ये दिसत राहतात. हे व्हॉल्ट नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ tidak akan menunjukkannya lagi – tidak di bawah Foto dan tidak semasa mengemas. Fail kekal tidak berubah dan masih kelihatan dalam app lain. Ini bukan peti besi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ viser dem ikke lenger – verken under Bilder eller under rydding. Filene forblir uendret og er fortsatt synlige i andre apper. Dette er ikke en safe."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ toont ze niet meer – niet bij Foto’s en niet bij opruimen. De bestanden blijven ongewijzigd en zichtbaar in andere apps. Dit is geen kluis."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ଏଗୁଡ଼ିକୁ ଆଉ ଦେଖାଇବ ନାହିଁ – ଫଟୋରେ ନୁହେଁ, ସଫା ସମୟରେ ମଧ୍ୟ ନୁହେଁ। ଫାଇଲ୍ ଅପରିବର୍ତ୍ତିତ ରହେ ଏବଂ ଅନ୍ୟ ଆପ୍‌ରେ ଦେଖାଯାଉଥାଏ। ଏହା ଭଲ୍ଟ ନୁହେଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ਇਨ੍ਹਾਂ ਨੂੰ ਹੁਣ ਨਹੀਂ ਦਿਖਾਏਗਾ – ਨਾ ਫ਼ੋਟੋਆਂ ਹੇਠ ਅਤੇ ਨਾ ਸਫ਼ਾਈ ਦੌਰਾਨ। ਫ਼ਾਈਲਾਂ ਬਿਨਾਂ ਬਦਲੇ ਰਹਿੰਦੀਆਂ ਹਨ ਅਤੇ ਹੋਰ ਐਪਾਂ ਵਿੱਚ ਦਿਸਦੀਆਂ ਰਹਿੰਦੀਆਂ ਹਨ। ਇਹ ਕੋਈ ਤਿਜੋਰੀ ਨਹੀਂ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ przestanie je pokazywać – ani w Zdjęciach, ani podczas porządków. Pliki pozostają bez zmian i są widoczne w innych aplikacjach. To nie jest sejf."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O GaleriQ não os mostrará mais – nem em Fotos nem durante a limpeza. Os arquivos não são alterados e continuam visíveis em outros apps. Isto não é um cofre."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O GaleriQ deixa de os mostrar – nem em Fotos nem na limpeza. Os ficheiros ficam inalterados e visíveis noutras apps. Isto não é um cofre."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ nu le va mai afișa – nici la Fotografii, nici la curățare. Fișierele rămân neschimbate și vizibile în alte aplicații. Nu este un seif."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ перестанет их показывать – ни в «Фото», ни при уборке. Файлы не меняются и видны в других приложениях. Это не сейф."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ich prestane zobrazovať – vo Fotkách ani pri upratovaní. Súbory zostanú bez zmeny a v iných aplikáciách viditeľné. Nejde o trezor."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ jih ne bo več prikazoval – ne pod Fotografije ne pri čiščenju. Datoteke ostanejo nespremenjene in vidne v drugih aplikacijah. To ni sef."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ visar dem inte längre – varken under Bilder eller vid rensning. Filerna förblir oförändrade och syns fortfarande i andra appar. Det här är inget valv."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ இனி இவற்றைக் காட்டாது – புகைப்படங்களிலும் இல்லை, சுத்தம் செய்யும்போதும் இல்லை. கோப்புகள் மாறாமல் இருக்கும், மற்ற ஆப்களில் தெரியும். இது லாக்கர் அல்ல."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ఇక వీటిని చూపించదు – ఫోటోల కింద కాదు, శుభ్రం చేసేటప్పుడూ కాదు. ఫైళ్లు మారవు, ఇతర యాప్‌లలో కనిపిస్తూనే ఉంటాయి. ఇది వాల్ట్ కాదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ จะไม่แสดงรายการเหล่านี้อีก – ทั้งในรูปภาพและขณะจัดระเบียบ ไฟล์ไม่เปลี่ยนแปลงและยังมองเห็นได้ในแอพอื่น นี่ไม่ใช่ตู้เซฟ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ bunları artık göstermez – ne Fotoğraflar’da ne de temizlikte. Dosyalar değişmez ve diğer uygulamalarda görünür kalır. Bu bir kasa değildir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ більше не показуватиме їх – ні у «Фото», ні під час прибирання. Файли не змінюються й видимі в інших застосунках. Це не сейф."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ انہیں اب نہیں دکھائے گا – نہ تصاویر میں، نہ صفائی میں۔ فائلیں تبدیل نہیں ہوتیں اور دوسری ایپس میں دکھتی رہتی ہیں۔ یہ والٹ نہیں ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ sẽ không hiển thị chúng nữa – không trong Ảnh và không khi dọn dẹp. Tệp không thay đổi và vẫn hiển thị trong ứng dụng khác. Đây không phải là két sắt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ 将不再显示它们——无论在“照片”中还是整理时。文件保持不变，在其他应用中仍可见。这不是保险箱。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ 將不再顯示它們 – 不論是在「照片」分頁或整理時。檔案保持不變，在其他 App 中仍然可見。這不是保險箱。"
          }
        }
      }
    },
