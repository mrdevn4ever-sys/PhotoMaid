    "vault2_local_only": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا حساب ولا خادم GaleriQ. لا تغادر الصادرات والنسخ الاحتياطية التطبيق إلا بإجراء صريح منك."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen konto og ingen GaleriQ-server. Eksporter og sikkerhedskopier forlader kun appen ved en udtrykkelig handling fra dig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Konto und kein GaleriQ-Server. Exporte und Backups verlassen die App nur durch deine ausdrückliche Aktion."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No account and no GaleriQ server. Exports and backups leave the app only through your explicit action."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin cuenta ni servidor GaleriQ. Las exportaciones y copias solo salen de la app por una acción explícita tuya."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun compte ni serveur GaleriQ. Les exports et sauvegardes quittent l’app uniquement sur votre action explicite."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa akun dan tanpa server GaleriQ. Ekspor dan cadangan hanya keluar dari app lewat tindakanmu sendiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun account o server GaleriQ. Esportazioni e backup escono dall’app solo con una tua azione esplicita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントもGaleriQサーバーも使いません。書き出しやバックアップは明示的に操作したときだけアプリの外に出ます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정이나 GaleriQ 서버가 없습니다. 명시적인 작업을 수행해야 내보내기와 백업이 앱 밖으로 나갑니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen konto og ingen GaleriQ-server. Eksporter og sikkerhetskopier forlater bare appen ved en uttrykkelig handling fra deg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen account of GaleriQ-server. Exports en back-ups verlaten de app alleen op jouw uitdrukkelijke verzoek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez konta i serwera GaleriQ. Eksporty i kopie opuszczają aplikację tylko po Twoim wyraźnym działaniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem conta e sem servidor do GaleriQ. Exportações e backups só saem do app por uma ação explícita sua."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem conta nem servidor GaleriQ. Exportações e cópias só saem da app por uma ação tua explícita."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fără cont și fără server GaleriQ. Exporturile și copiile părăsesc aplicația doar prin acțiunea ta explicită."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без аккаунта и сервера GaleriQ. Экспорт и резервные копии покидают приложение только по вашему явному действию."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget konto och ingen GaleriQ-server. Exporter och säkerhetskopior lämnar appen bara genom en uttrycklig åtgärd från dig."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีบัญชีและไม่มีเซิร์ฟเวอร์ของ GaleriQ การส่งออกและข้อมูลสำรองจะออกจากแอพเมื่อคุณสั่งเองเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap ve GaleriQ sunucusu yoktur. Dışa aktarımlar ve yedekler yalnızca açık işleminle uygulamadan çıkar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Без облікового запису та сервера GaleriQ. Експорт і копії залишають програму лише після вашої явної дії."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có tài khoản và không có máy chủ GaleriQ. Bản xuất và bản sao lưu chỉ rời ứng dụng khi bạn chủ động thực hiện."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需账户，不使用GaleriQ服务器。只有在你明确操作后，导出文件和备份才会离开应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有帳號，也沒有 GaleriQ 伺服器。輸出和備份只會在你明確操作時離開 App。"
          }
        }
      }
    },
