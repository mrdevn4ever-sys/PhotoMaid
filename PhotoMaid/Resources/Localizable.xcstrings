    "pro_f6d": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صور التُقطت بشكل متتالٍ جنبًا إلى جنب – أنت تختار ما يبقى."
          }
        },
