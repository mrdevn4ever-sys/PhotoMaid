    },
    "storage_c_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستطيع GaleriQ فحص التطبيقات الأخرى أو ملفات النظام أو المحتوى السحابي أو المجلدات التي لم تسمح له بها. لذلك لا يعرض حجمًا لها."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ kan ikke kontrollere andre apps, systemfiler, skyindhold eller mapper, du ikke har tilladt. Der vises ingen størrelse for disse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere Apps, Systemdateien, Cloud-Inhalte und nicht freigegebene Ordner kann GaleriQ nicht prüfen. Dafür wird keine Größe angezeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ can’t check other apps, system files, cloud content or folders you haven’t allowed. No size is shown for these."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ no puede revisar otras apps, archivos del sistema, contenido en la nube ni carpetas no autorizadas. No se muestra su tamaño."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ne peut pas vérifier les autres applications, les fichiers système, le contenu cloud ni les dossiers non autorisés. Aucune taille n’est affichée pour eux."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ tidak bisa memeriksa app lain, file sistem, konten cloud, atau folder yang belum kamu izinkan. Tidak ada ukuran yang ditampilkan untuk ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ non può controllare altre app, file di sistema, contenuti cloud e cartelle non autorizzate. Per questi non viene mostrata una dimensione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQでは他のアプリ、システムファイル、クラウド上のデータ、許可していないフォルダは確認できません。そのため、これらのサイズは表示しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 앱, 시스템 파일, 클라우드 콘텐츠, 허용하지 않은 폴더는 GaleriQ가 확인할 수 없어요. 이 항목들의 크기는 표시하지 않아요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ kan ikke kontrollere andre apper, systemfiler, skyinnhold eller mapper du ikke har tillatt. Ingen størrelse vises for disse."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ kan andere apps, systeembestanden, cloudinhoud en niet-toegestane mappen niet controleren. Daarvoor wordt geen grootte getoond."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ nie może sprawdzać innych aplikacji, plików systemowych, chmury ani folderów bez dostępu. Nie pokazuje dla nich rozmiaru."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O GaleriQ não pode verificar outros apps, arquivos do sistema, conteúdo na nuvem ou pastas que você não permitiu. Nenhum tamanho é mostrado para eles."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O GaleriQ não pode verificar outras apps, ficheiros do sistema, conteúdo na nuvem ou pastas não autorizadas. Não é mostrado um tamanho para estes dados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ nu poate verifica alte aplicații, fișiere de sistem, conținut cloud sau dosare fără acces. Pentru acestea nu afișează o dimensiune."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ не может проверять другие приложения, системные файлы, облачные данные и папки без доступа. Их размер не показывается."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ kan inte kontrollera andra appar, systemfiler, molninnehåll eller mappar du inte har tillåtit. Ingen storlek visas för dessa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ตรวจสอบแอพอื่น ไฟล์ระบบ เนื้อหาบนคลาวด์ หรือโฟลเดอร์ที่คุณไม่ได้อนุญาตไม่ได้ จะไม่แสดงขนาดของสิ่งเหล่านี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ diğer uygulamaları, sistem dosyalarını, bulut içeriğini ve izin verilmeyen klasörleri inceleyemez. Bunlar için boyut gösterilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ не може перевіряти інші застосунки, системні файли, хмарні дані й папки без доступу. Їхній розмір не показується."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ không thể kiểm tra ứng dụng khác, tệp hệ thống, nội dung đám mây hoặc thư mục bạn chưa cho phép. Không hiển thị kích thước cho những mục này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ 无法检查其他应用、系统文件、云端内容或未授权的文件夹，因此不显示这些内容的大小。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ 無法檢查其他 App、系統檔案、雲端內容或你未允許的檔案夾。這些不會顯示大小。"
          }
        }
      }
    },
