    "vault_new_code_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فتحت الخزنة باستخدام مفتاح الاسترداد. اختر رمزًا جديدًا الآن."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast den Tresor mit dem Notfallschlüssel geöffnet. Lege jetzt einen neuen Code fest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You opened the vault with the recovery key. Choose a new code now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has abierto la caja fuerte con la clave de recuperación. Elige ahora un código nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as ouvert le coffre-fort avec la clé de secours. Choisis maintenant un nouveau code."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai aperto la cassaforte con la chiave di recupero. Scegli ora un nuovo codice."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復旧キーで保管庫を開きました。新しいコードを設定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복구 키로 금고를 열었습니다. 이제 새 암호를 설정하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt de kluis met de herstelsleutel geopend. Kies nu een nieuwe code."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sejf otwarto kluczem odzyskiwania. Ustaw teraz nowy kod."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abriste o cofre com a chave de recuperação. Escolhe agora um novo código."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai deschis seiful cu cheia de recuperare. Alege acum un cod nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейф открыт с помощью ключа восстановления. Задай новый код."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasayı kurtarma anahtarıyla açtın. Şimdi yeni bir kod belirle."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейф відкрито за допомогою ключа відновлення. Задай новий код."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已使用恢复密钥打开保险箱。请立即设置新密码。"
          }
        }
      }
    },
