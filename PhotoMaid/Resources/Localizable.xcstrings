        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하루 %1$lld개 한도 없이 원하는 만큼 삭제하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjern så mye du vil — uten den daglige grensen på %1$lld."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijder zoveel je wilt, zonder de daglimiet van %1$lld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuwaj, ile chcesz — bez dziennego limitu %1$lld."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remova quanto quiser — sem o limite diário de %1$lld."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove o que quiseres, sem o limite diário de %1$lld."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimină cât vrei, fără limita zilnică de %1$lld."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляй сколько нужно — без дневного лимита %1$lld."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta bort så mycket du vill — utan den dagliga gränsen på %1$lld."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นำออกได้มากเท่าที่ต้องการ — ไม่มีขีดจำกัดรายวัน %1$lld"
