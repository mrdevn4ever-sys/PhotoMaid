    "archive_kind_device": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا المجلد على نفس مساحة التخزين التي تحتوي على صورك. لن تفيد نسخة ثانية هناك إذا ضاع هاتفك أو تعطل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ফোল্ডারটি আপনার ফটোর একই স্টোরেজে আছে। ফোন হারালে বা নষ্ট হলে সেখানে দ্বিতীয় কপি কাজে আসবে না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquesta carpeta és al mateix emmagatzematge que les teves fotos. Una segona còpia aquí no ajuda si perds el telèfon o s’espatlla."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato složka je na stejném úložišti jako vaše fotky. Druhá kopie tady nepomůže, když telefon ztratíte nebo se rozbije."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne mappe ligger på samme lager som dine fotos. En ekstra kopi her hjælper ikke, hvis telefonen bliver væk eller går i stykker."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Ordner liegt auf demselben Speicher wie deine Fotos. Eine zweite Kopie dort hilft nicht, wenn das Handy verloren geht oder kaputtgeht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτός ο φάκελος βρίσκεται στον ίδιο αποθηκευτικό χώρο με τις φωτογραφίες σου. Ένα δεύτερο αντίγραφο εδώ δεν βοηθά αν χαθεί ή χαλάσει το τηλέφωνο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This folder is on the same storage as your photos. A second copy there won’t help if your phone is lost or breaks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta carpeta está en el mismo almacenamiento que tus fotos. Una segunda copia ahí no sirve si pierdes el móvil o se estropea."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä kansio on samassa tallennustilassa kuin kuvasi. Toinen kopio täällä ei auta, jos puhelin katoaa tai hajoaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce dossier se trouve sur le même stockage que vos photos. Une deuxième copie à cet endroit n’aide pas si le téléphone est perdu ou cassé."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ ફોલ્ડર તમારા ફોટા જેવા જ સ્ટોરેજ પર છે. ફોન ખોવાય કે બગડે તો અહીંની બીજી નકલ કામ નહીં આવે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התיקייה הזו נמצאת באותו אחסון כמו התמונות שלך. עותק שני כאן לא יעזור אם הטלפון יאבד או יתקלקל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
