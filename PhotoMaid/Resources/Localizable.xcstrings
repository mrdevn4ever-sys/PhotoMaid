    "today_limited_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض GaleriQ فقط الصور والفيديوهات التي سمحت له بالوصول إليها. يمكنك ترتيبها كالمعتاد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ শুধু সেই ফটো ও ভিডিও দেখায় যেগুলোর অনুমতি আপনি দিয়েছেন। এগুলো যথারীতি পরিষ্কার করতে পারেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ només mostra les fotos i els vídeos que has permès. Els pots endreçar com sempre."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ zobrazuje jen fotky a videa, které jste povolili. Ty můžete uklízet jako obvykle."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ viser kun de fotos og videoer, du har tilladt. Du kan rydde op i dem som normalt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ zeigt nur freigegebene Fotos und Videos. Diese kannst du wie gewohnt aufräumen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το GaleriQ εμφανίζει μόνο τις φωτογραφίες και τα βίντεο που επέτρεψες. Μπορείς να τα τακτοποιήσεις κανονικά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ only shows the photos and videos you’ve allowed. You can clean these up as usual."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ solo muestra las fotos y los vídeos que has autorizado. Puedes revisarlos como siempre."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ näyttää vain sallimasi kuvat ja videot. Voit siivota niitä tavalliseen tapaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ affiche uniquement les photos et vidéos que tu as autorisées. Tu peux les trier normalement."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ફક્ત તમે મંજૂર કરેલા ફોટા અને વીડિયો બતાવે છે. તેમને તમે હંમેશની જેમ સાફ કરી શકો છો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ מציגה רק את התמונות והסרטונים שאישרת. אפשר לסדר אותם כרגיל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ सिर्फ़ वही फ़ोटो और वीडियो दिखाता है जिनकी आपने अनुमति दी है। इन्हें आप हमेशा की तरह साफ़ कर सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ prikazuje samo fotografije i videozapise koje si dopustio. Njih možeš raščistiti kao i obično."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A GaleriQ csak az általad engedélyezett fotókat és videókat mutatja. Ezeken a szokásos módon rakhatsz rendet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ hanya menampilkan foto dan video yang kamu izinkan. Kamu bisa merapikannya seperti biasa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ mostra solo le foto e i video che hai autorizzato. Puoi riordinarli normalmente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQには、許可した写真と動画だけが表示されます。表示されたものは通常どおり整理できます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಅನುಮತಿಸಿದ ಫೋಟೋಗಳು ಮತ್ತು ವೀಡಿಯೊಗಳನ್ನು ಮಾತ್ರ GaleriQ ತೋರಿಸುತ್ತದೆ. ಇವುಗಳನ್ನು ಎಂದಿನಂತೆ ಸ್ವಚ್ಛಗೊಳಿಸಬಹುದು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ에는 접근을 허용한 사진과 동영상만 표시돼요. 표시된 항목은 평소처럼 정리할 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ അനുവദിച്ച ഫോട്ടോകളും വീഡിയോകളും മാത്രമേ GaleriQ കാണിക്കൂ. ഇവ സാധാരണ പോലെ വൃത്തിയാക്കാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ फक्त तुम्ही परवानगी दिलेले फोटो आणि व्हिडिओ दाखवते. त्यांची तुम्ही नेहमीप्रमाणे साफसफाई करू शकता."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ hanya menunjukkan foto dan video yang anda benarkan. Anda boleh mengemasnya seperti biasa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ viser bare bildene og videoene du har tillatt. Du kan rydde i dem som vanlig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ toont alleen foto’s en video’s waarvoor je toegang hebt gegeven. Je kunt deze gewoon opruimen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ କେବଳ ଆପଣ ଅନୁମତି ଦେଇଥିବା ଫଟୋ ଓ ଭିଡିଓ ଦେଖାଏ। ଏଗୁଡ଼ିକୁ ସାଧାରଣ ଭାବେ ସଫା କରିପାରିବେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ਸਿਰਫ਼ ਉਹ ਫ਼ੋਟੋਆਂ ਅਤੇ ਵੀਡੀਓ ਦਿਖਾਉਂਦਾ ਹੈ ਜਿਨ੍ਹਾਂ ਦੀ ਤੁਸੀਂ ਇਜਾਜ਼ਤ ਦਿੱਤੀ ਹੈ। ਤੁਸੀਂ ਇਨ੍ਹਾਂ ਦੀ ਆਮ ਵਾਂਗ ਸਫ਼ਾਈ ਕਰ ਸਕਦੇ ਹੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ pokazuje tylko zdjęcia i filmy, na które zezwolisz. Możesz je porządkować jak zwykle."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O GaleriQ só mostra as fotos e vídeos que você permitiu. Você pode limpá-los normalmente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O GaleriQ só mostra as fotos e os vídeos que autorizaste. Podes organizá-los como habitualmente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ arată doar fotografiile și videoclipurile pentru care ai permis accesul. Le poți organiza ca de obicei."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ показывает только фото и видео, к которым ты разрешаешь доступ. Их можно разбирать как обычно."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ zobrazuje len fotky a videá, ktoré ste povolili. Tie môžete upratovať ako zvyčajne."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ prikazuje samo fotografije in videoposnetke, ki si jih dovolil. Te lahko čistiš kot običajno."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ visar bara de bilder och videor du har tillåtit. Du kan rensa dem som vanligt."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் அனுமதித்த புகைப்படங்களையும் வீடியோக்களையும் மட்டுமே GaleriQ காட்டுகிறது. இவற்றை வழக்கம்போல் சுத்தம் செய்யலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు అనుమతించిన ఫోటోలు, వీడియోలను మాత్రమే GaleriQ చూపిస్తుంది. వీటిని యథావిధిగా శుభ్రం చేయవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ แสดงเฉพาะรูปภาพและวิดีโอที่คุณอนุญาต คุณจัดระเบียบได้ตามปกติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ yalnızca izin verdiğin fotoğraf ve videoları gösterir. Bunları her zamanki gibi düzenleyebilirsin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ показує лише фото й відео, до яких ти надаєш доступ. Їх можна впорядковувати як завжди."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ صرف وہی تصاویر اور ویڈیوز دکھاتا ہے جن کی آپ نے اجازت دی ہے۔ انہیں آپ معمول کے مطابق صاف کر سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ chỉ hiển thị ảnh và video bạn đã cho phép. Bạn có thể dọn dẹp chúng như bình thường."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ 只会显示你允许访问的照片和视频。这些内容可以正常清理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ 只會顯示你允許的照片和影片。你可以照常整理它們。"
          }
        }
      }
    },
