    "pro_msg_ad_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تجربة أدوات Pro غير متاحة الآن. لم يتم تفعيل أي ميزة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Pro-Funktionen lassen sich gerade nicht testen. Es wurde nichts freigeschaltet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Pro tool preview isn’t available right now. Nothing was unlocked."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La prueba de herramientas Pro no está disponible ahora. No se ha desbloqueado nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’essai des outils Pro est indisponible pour le moment. Rien n’a été débloqué."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La prova degli strumenti Pro non è disponibile ora. Non è stato sbloccato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今はProのツールをお試し利用できません。特典は適用されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 Pro 도구를 체험할 수 없어요. 적용된 혜택은 없어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De Pro-functietest is nu niet beschikbaar. Er is niets ontgrendeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Test narzędzi Pro jest teraz niedostępny. Nic nie odblokowano."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O teste das ferramentas Pro não está disponível de momento. Nada foi desbloqueado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Testarea instrumentelor Pro nu este disponibilă acum. Nu s-a deblocat nimic."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас пробный доступ к инструментам Pro недоступен. Ничего не открыто."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro araç denemesi şu anda kullanılamıyor. Hiçbir şey açılmadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зараз тест інструментів Pro недоступний. Нічого не відкрито."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法试用 Pro 工具，未解锁任何权益。"
          }
        }
      }
    },
    "pro_msg_dismissed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُغلق الإعلان مبكرًا. لم يتم تفعيل أي ميزة. يمكنك المحاولة مرة أخرى اليوم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Werbung wurde vorzeitig geschlossen. Du hast keine Freischaltung erhalten und kannst es heute erneut versuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The ad was closed early. Nothing was unlocked. You can try again today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El anuncio se ha cerrado antes de terminar. No se ha desbloqueado nada. Puedes volver a intentarlo hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La publicité a été fermée trop tôt. Rien n’a été débloqué. Tu peux réessayer aujourd’hui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La pubblicità è stata chiusa prima della fine. Non è stato sbloccato nulla. Puoi riprovare oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "広告を途中で閉じたため、特典は適用されていません。今日もう一度試せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "광고를 일찍 닫아 혜택이 적용되지 않았어요. 오늘 다시 시도할 수 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De advertentie is te vroeg gesloten. Er is niets ontgrendeld. Je kunt het vandaag opnieuw proberen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Reklama została zamknięta przed końcem. Nic nie odblokowano. Możesz spróbować jeszcze raz dzisiaj."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O anúncio foi fechado antes de terminar. Nada foi desbloqueado. Podes tentar novamente hoje."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Reclama a fost închisă înainte de final. Nu s-a deblocat nimic. Poți încerca din nou azi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Реклама закрыта до завершения. Ничего не открыто. Сегодня можно попробовать ещё раз."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reklam erken kapatıldı. Hiçbir şey açılmadı. Bugün yeniden deneyebilirsin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рекламу закрито до завершення. Нічого не відкрито. Сьогодні можна спробувати ще раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "广告提前关闭，未解锁任何权益。今天仍可重试。"
          }
        }
      }
    },
