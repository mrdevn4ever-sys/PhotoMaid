    "org_albums_footer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الألبومات موجودة في PhotoMaid فقط. تُظهر المجلدات مكان تخزين الملف، وتجد المجموعات الوسائط وفق شرط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alben gibt es nur in PhotoMaid. Ordner zeigen, wo eine Datei liegt; Sammlungen finden Fotos über eine Bedingung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Albums exist only in PhotoMaid. Folders show where a file is stored; collections find photos by a condition."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los álbumes solo existen en PhotoMaid. Las carpetas muestran dónde está un archivo; las colecciones encuentran contenido según una condición."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les albums n’existent que dans PhotoMaid. Les dossiers indiquent où se trouve un fichier ; les collections trouvent des médias selon une condition."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli album esistono solo in PhotoMaid. Le cartelle mostrano dove si trova un file; le raccolte trovano i contenuti in base a una condizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アルバムはPhotoMaidの中だけのものです。フォルダはファイルの保存場所、コレクションは条件で見つけたメディアです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앨범은 PhotoMaid 안에만 있어요. 폴더는 파일이 저장된 위치를, 모음은 조건으로 찾은 미디어를 보여 줘요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Albums bestaan alleen in PhotoMaid. Mappen tonen waar een bestand staat; collecties vinden media via een voorwaarde."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Albumy istnieją tylko w PhotoMaid. Foldery pokazują, gdzie leży plik; kolekcje znajdują multimedia według warunku."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os álbuns só existem no PhotoMaid. As pastas mostram onde está um ficheiro; as coleções encontram multimédia por uma condição."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Albumele există doar în PhotoMaid. Dosarele arată unde se află un fișier; colecțiile găsesc conținut după o condiție."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Альбомы есть только в PhotoMaid. Папки показывают, где лежит файл; подборки находят медиа по условию."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Albümler yalnızca PhotoMaid’de vardır. Klasörler dosyanın nerede olduğunu gösterir; koleksiyonlar medyayı bir koşula göre bulur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Альбоми є лише в PhotoMaid. Папки показують, де лежить файл; добірки знаходять медіа за умовою."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相册只存在于 PhotoMaid 中。文件夹显示文件的存储位置，合集按条件查找媒体。"
          }
        }
      }
    },
