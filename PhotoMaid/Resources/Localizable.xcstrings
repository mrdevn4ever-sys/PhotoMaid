    "size_approx_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "«حوالي» = تقدير من صورك وفيديوهاتك المقاسة. لا يكشف iOS الحجم الدقيق لأصول iCloud إلا بعد التنزيل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„ca.“ = geschätzt aus deinen gemessenen Fotos und Videos. Die genaue Größe von iCloud-Originalen nennt iOS erst nach dem Herunterladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“approx.” = estimated from your measured photos and videos. iOS only reveals the exact size of iCloud originals after downloading."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«aprox.» = estimado a partir de tus fotos y vídeos medidos. iOS solo indica el tamaño exacto de los originales de iCloud tras descargarlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« env. » = estimé d’après tes photos et vidéos mesurées. iOS n’indique la taille exacte des originaux iCloud qu’après téléchargement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«circa» = stimato dalle tue foto e dai tuoi video misurati. iOS indica la dimensione esatta degli originali iCloud solo dopo il download."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「約」＝計測済みの写真や動画からの推定です。iCloudのオリジナルの正確なサイズは、ダウンロード後にのみiOSが示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘약’ = 측정한 사진과 동영상을 바탕으로 한 추정치예요. iCloud 원본의 정확한 크기는 다운로드한 후에만 iOS가 알려 줘요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘ca.’ = geschat op basis van je gemeten foto’s en video’s. De exacte grootte van iCloud-originelen geeft iOS pas na het downloaden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„ok.” = szacunek na podstawie zmierzonych zdjęć i filmów. Dokładny rozmiar oryginałów z iCloud iOS podaje dopiero po pobraniu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "«aprox.» = estimado a partir das tuas fotografias e vídeos medidos. O iOS só indica o tamanho exato dos originais do iCloud depois de os descarregar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "„cca.” = estimat din fotografiile și videoclipurile tale măsurate. iOS arată dimensiunea exactă a originalelor din iCloud abia după descărcare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«≈» = оценка по измеренным фото и видео. Точный размер оригиналов в iCloud iOS сообщает только после загрузки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“yaklaşık” = ölçülmüş fotoğraf ve videolarından tahmin edilir. iOS, iCloud orijinallerinin tam boyutunu ancak indirdikten sonra gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«≈» = оцінка за виміряними фото й відео. Точний розмір оригіналів в iCloud iOS повідомляє лише після завантаження."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“约”= 根据你已测量的照片和视频估算。iCloud 原件的确切大小只有下载后 iOS 才会提供。"
          }
        }
      }
    },
