    "dup_incomplete_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت قراءة بعض المحتويات. قد تحتوي العناصر التي لم تُفحص على نسخ متطابقة أخرى."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Noget indhold kunne ikke læses. Ukontrollerede emner kan indeholde flere identiske kopier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht alle Inhalte konnten gelesen werden. Ungeprüfte Elemente können weitere identische Kopien enthalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some content could not be read. Unchecked items may contain more identical copies."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer todo el contenido. Los elementos sin comprobar pueden contener más copias idénticas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains contenus n’ont pas pu être lus. Les éléments non vérifiés peuvent contenir d’autres copies identiques."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebagian konten tidak dapat dibaca. Item yang belum diperiksa mungkin masih berisi salinan identik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile leggere tutti i contenuti. Gli elementi non verificati potrebbero contenere altre copie identiche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部のコンテンツを読み取れませんでした。未確認の項目に同一のコピーが含まれている可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 콘텐츠를 읽을 수 없었습니다. 확인하지 못한 항목에 동일한 복사본이 더 있을 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Noe innhold kunne ikke leses. Ukontrollerte elementer kan inneholde flere identiske kopier."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet alle inhoud kon worden gelezen. Niet-gecontroleerde items kunnen meer identieke kopieën bevatten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się odczytać całej zawartości. Niesprawdzone elementy mogą zawierać kolejne identyczne kopie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Parte do conteúdo não pôde ser lida. Itens não verificados podem conter mais cópias idênticas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler todo o conteúdo. Os itens não verificados podem conter mais cópias idênticas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O parte din conținut nu a putut fi citită. Elementele neverificate pot conține alte copii identice."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать часть содержимого. Среди непроверенных объектов могут быть другие идентичные копии."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En del innehåll kunde inte läsas. Okontrollerade objekt kan innehålla fler identiska kopior."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านเนื้อหาบางส่วนไม่ได้ รายการที่ยังไม่ได้ตรวจอาจมีสำเนาที่เหมือนกันอีก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazı içerikler okunamadı. Denetlenmeyen öğeler başka özdeş kopyalar içerebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Частину вмісту не вдалося прочитати. Неперевірені елементи можуть містити інші ідентичні копії."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không đọc được một số nội dung. Các mục chưa kiểm tra có thể còn bản sao giống hệt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分内容无法读取。未检查的项目中可能还有其他完全相同的副本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分內容無法讀取。未檢查的項目可能還有更多相同的副本。"
          }
        }
      }
    },
