    "vault2_attachment_in_use": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الملف ما زال مرفقًا بملاحظة، ربما في سلة الخزنة. افصله أولًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ফাইলটি এখনো একটি নোটে সংযুক্ত, হয়তো ভল্টের ট্র্যাশে। আগে এটি বিচ্ছিন্ন করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquest fitxer encara està adjunt a una nota, potser a la paperera de la caixa forta. Primer desadjunta’l."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento soubor je stále připojen k poznámce, možná v koši trezoru. Nejdřív ho odpojte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne fil er stadig vedhæftet en note, måske i boksens papirkurv. Fjern vedhæftningen først."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei ist noch an eine Notiz angehängt, auch möglicherweise im Tresor-Papierkorb. Löse zuerst den Anhang."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το αρχείο είναι ακόμη συνημμένο σε σημείωση, ίσως στον κάδο του θησαυροφυλακίου. Αποσύνδεσέ το πρώτα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file is still attached to a note, possibly in vault trash. Detach it first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo sigue adjunto a una nota, quizá en la papelera de la caja fuerte. Desvincúlalo primero."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä tiedosto on yhä liitetty muistiinpanoon, ehkä holvin roskakorissa. Irrota se ensin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier est encore joint à une note, peut-être dans la corbeille du coffre. Détachez-le d’abord."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ ફાઇલ હજી કોઈ નોંધ સાથે જોડાયેલી છે, કદાચ વૉલ્ટ ટ્રેશમાં. પહેલાં તેને અલગ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקובץ הזה עדיין מצורף להערה, אולי בפח של הכספת. יש לנתק אותו קודם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह फ़ाइल अभी किसी नोट से जुड़ी है, शायद तिजोरी के ट्रैश में। पहले इसे अलग करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ova je datoteka još priložena bilješci, možda u smeću trezora. Najprije je odvoji."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a fájl még egy jegyzethez van csatolva, talán a széf kukájában. Előbb válaszd le."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File ini masih terlampir di sebuah catatan, mungkin di sampah brankas. Lepaskan dulu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file è ancora allegato a una nota, forse nel cestino della cassaforte. Prima scollegalo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルはメモに添付されています。保管庫のゴミ箱内のメモも確認し、先に添付を解除してください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಫೈಲ್ ಇನ್ನೂ ಒಂದು ಟಿಪ್ಪಣಿಗೆ ಲಗತ್ತಿಸಲಾಗಿದೆ, ಬಹುಶಃ ವಾಲ್ಟ್ ಕಸದ ಬುಟ್ಟಿಯಲ್ಲಿ. ಮೊದಲು ಅದನ್ನು ಬೇರ್ಪಡಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일이 아직 메모에 첨부되어 있습니다. 보관함 휴지통의 메모일 수도 있습니다. 먼저 첨부를 해제하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ഫയൽ ഇപ്പോഴും ഒരു കുറിപ്പിൽ അറ്റാച്ച് ചെയ്തിട്ടുണ്ട്, ഒരുപക്ഷേ വോൾട്ട് ട്രാഷിൽ. ആദ്യം അത് വേർപെടുത്തുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ही फाइल अजूनही एखाद्या नोंदीला जोडलेली आहे, कदाचित व्हॉल्ट ट्रॅशमध्ये. आधी ती वेगळी करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Fail ini masih dilampirkan pada nota, mungkin dalam sampah peti besi. Tanggalkannya dahulu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne filen er fortsatt vedlagt et notat, kanskje i safens papirkurv. Fjern vedlegget først."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit bestand is nog bijgevoegd bij een notitie, mogelijk in de kluisprullenmand. Koppel het eerst los."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହି ଫାଇଲ୍ ଏବେ ବି ଏକ ନୋଟ୍ ସହ ସଂଲଗ୍ନ, ହୁଏତ ଭଲ୍ଟ ଟ୍ରାସରେ। ପ୍ରଥମେ ଏହାକୁ ଅଲଗା କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਫ਼ਾਈਲ ਹਾਲੇ ਵੀ ਕਿਸੇ ਨੋਟ ਨਾਲ ਨੱਥੀ ਹੈ, ਸ਼ਾਇਦ ਵੌਲਟ ਦੀ ਰੱਦੀ ਵਿੱਚ। ਪਹਿਲਾਂ ਇਸ ਨੂੰ ਵੱਖ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plik jest nadal załączony do notatki, być może w koszu sejfu. Najpierw go odłącz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este arquivo ainda está anexado a uma nota, talvez na lixeira do cofre. Desanexe-o primeiro."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O ficheiro ainda está anexado a uma nota, talvez no lixo do cofre. Desassocia-o primeiro."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fișierul este încă atașat unei notițe, posibil în coșul seifului. Detașează-l mai întâi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл ещё прикреплён к заметке, возможно в корзине сейфа. Сначала открепите его."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento súbor je stále pripojený k poznámke, možno v koši trezoru. Najprv ho odpojte."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta datoteka je še priložena zapisku, morda v košu sefa. Najprej jo odstrani iz priloge."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här filen är fortfarande bifogad till en anteckning, kanske i valvets papperskorg. Koppla loss den först."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தக் கோப்பு இன்னும் ஒரு குறிப்புடன் இணைக்கப்பட்டுள்ளது, ஒருவேளை லாக்கர் குப்பையில். முதலில் அதைப் பிரியுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ ఫైల్ ఇంకా ఒక నోట్‌కి అటాచ్ అయి ఉంది, బహుశా వాల్ట్ ట్రాష్‌లో. ముందుగా దాన్ని వేరు చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์นี้ยังแนบอยู่กับโน้ต อาจอยู่ในถังขยะตู้เซฟ ถอดการแนบก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya hâlâ bir nota ekli; not kasa çöp kutusunda olabilir. Önce eki ayır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл ще прикріплено до нотатки, можливо в кошику сховища. Спочатку відкріпіть його."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ فائل ابھی کسی نوٹ سے منسلک ہے، شاید والٹ کی ردی میں۔ پہلے اسے الگ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp này vẫn đang đính kèm vào một ghi chú, có thể trong thùng rác két sắt. Hãy gỡ đính kèm trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件仍附加在笔记中，笔记可能位于保险库废纸篓。请先取消附加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個檔案仍附加在某則備忘錄上，可能在保險箱垃圾桶中。請先取消附加。"
          }
        }
      }
    },
