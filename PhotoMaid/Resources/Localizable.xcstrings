        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelado. No se ha guardado nada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Peruttu. Mitään ei tallennettu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulé. Rien n’a été enregistré."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "રદ કર્યું. કંઈ સચવાયું નથી."
