    "vault2_camera_permission": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الكاميرا غير متاحة أو الوصول غير مسموح."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kamera ist nicht verfügbar oder der Zugriff wurde nicht erlaubt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera unavailable or access not allowed."
          }
        },
        "es": {
