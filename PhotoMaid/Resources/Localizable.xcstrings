        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪೂರ್ವವೀಕ್ಷಣೆ ಉಚಿತ · ಉಳಿಸಲು Pro ಅಥವಾ 30 ನಿಮಿಷಗಳ ಪರೀಕ್ಷೆ ಬೇಕು"
