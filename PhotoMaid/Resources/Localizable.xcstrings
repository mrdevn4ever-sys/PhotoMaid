    "game_photos_missing": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتاج الجولة إلى %1$lld صورة قابلة للاستخدام على الأقل من المصدر المختار. اختر مصدرًا آخر أو مجموعة أصغر أو اسمح بالتنزيل من iCloud."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই রাউন্ডের জন্য বেছে নেওয়া উৎস থেকে অন্তত %1$lldটি ব্যবহারযোগ্য ফটো দরকার। অন্য উৎস, ছোট নির্বাচন বেছে নিন বা iCloud ডাউনলোডের অনুমতি দিন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquesta ronda necessita com a mínim %1$lld fotos utilitzables de l’origen triat. Tria un altre origen, una selecció més petita o permet les baixades d’iCloud."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto kolo potřebuje nejméně %1$lld použitelných fotek z vybraného zdroje. Zvolte jiný zdroj, menší výběr nebo povolte stahování z iCloudu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne runde kræver mindst %1$lld brugbare fotos fra den valgte kilde. Vælg en anden kilde, et mindre udvalg, eller tillad hentning fra iCloud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Runde benötigt mindestens %1$lld nutzbare Fotos aus der gewählten Quelle. Wähle eine andere Quelle, eine kleinere Auswahl oder erlaube iCloud-Downloads."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτός ο γύρος χρειάζεται τουλάχιστον %1$lld κατάλληλες φωτογραφίες από την επιλεγμένη πηγή. Επίλεξε άλλη πηγή, μικρότερη επιλογή ή επίτρεψε λήψεις από το iCloud."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This round needs at least %1$lld usable photos from the chosen source. Choose another source, a smaller selection or allow iCloud downloads."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ronda necesita al menos %1$lld fotos utilizables del origen elegido. Elige otro origen, una selección menor o permite descargas de iCloud."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä kierros tarvitsee vähintään %1$lld käyttökelpoista kuvaa valitusta lähteestä. Valitse toinen lähde, pienempi valinta tai salli iCloud-lataukset."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette partie nécessite au moins %1$lld photos utilisables de la source choisie. Changez de source, réduisez la sélection ou autorisez les téléchargements iCloud."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ રાઉન્ડ માટે પસંદ કરેલા સ્રોતમાંથી ઓછામાં ઓછા %1$lld વાપરી શકાય તેવા ફોટા જોઈએ. બીજો સ્રોત, નાની પસંદગી પસંદ કરો અથવા iCloud ડાઉનલોડની મંજૂરી આપો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הסיבוב הזה צריך לפחות %1$lld תמונות שמישות מהמקור שנבחר. יש לבחור מקור אחר, בחירה קטנה יותר או לאפשר הורדות מ-iCloud."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस राउंड के लिए चुने स्रोत से कम से कम %1$lld इस्तेमाल लायक फ़ोटो चाहिए। दूसरा स्रोत, छोटा चयन चुनें या iCloud डाउनलोड की अनुमति दें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ova runda treba najmanje %1$lld upotrebljivih fotografija iz odabranog izvora. Odaberi drugi izvor, manji odabir ili dopusti preuzimanja iz iClouda."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ehhez a körhöz legalább %1$lld használható fotó kell a kiválasztott forrásból. Válassz másik forrást, kisebb válogatást, vagy engedélyezd az iCloud-letöltéseket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ronde ini butuh setidaknya %1$lld foto yang bisa dipakai dari sumber yang dipilih. Pilih sumber lain, pilihan yang lebih kecil, atau izinkan unduhan iCloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Servono almeno %1$lld foto utilizzabili dall’origine scelta. Cambia origine, riduci la selezione o consenti i download da iCloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択元に利用可能な写真が最低%1$lld枚必要です。選択元を変えるか、枚数を減らすか、iCloudからのダウンロードを許可してください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಸುತ್ತಿಗೆ ಆಯ್ಕೆಮಾಡಿದ ಮೂಲದಿಂದ ಕನಿಷ್ಠ %1$lld ಬಳಸಬಹುದಾದ ಫೋಟೋಗಳು ಬೇಕು. ಬೇರೆ ಮೂಲ, ಚಿಕ್ಕ ಆಯ್ಕೆ ಆಯ್ಕೆಮಾಡಿ ಅಥವಾ iCloud ಡೌನ್‌ಲೋಡ್‌ಗಳಿಗೆ ಅನುಮತಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 출처에서 사용 가능한 사진이 최소 %1$lld장 필요합니다. 다른 출처나 더 적은 사진을 선택하거나 iCloud 다운로드를 허용하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ റൗണ്ടിന് തിരഞ്ഞെടുത്ത ഉറവിടത്തിൽ നിന്ന് കുറഞ്ഞത് %1$lld ഉപയോഗയോഗ്യമായ ഫോട്ടോകൾ വേണം. മറ്റൊരു ഉറവിടം, ചെറിയ തിരഞ്ഞെടുപ്പ് തിരഞ്ഞെടുക്കുക അല്ലെങ്കിൽ iCloud ഡൗൺലോഡുകൾ അനുവദിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या फेरीसाठी निवडलेल्या स्रोतातून किमान %1$lld वापरण्यायोग्य फोटो हवेत. दुसरा स्रोत, लहान निवड निवडा किंवा iCloud डाउनलोडला परवानगी द्या."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pusingan ini memerlukan sekurang-kurangnya %1$lld foto yang boleh digunakan daripada sumber yang dipilih. Pilih sumber lain, pilihan yang lebih kecil atau benarkan muat turun iCloud."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne runden trenger minst %1$lld brukbare bilder fra den valgte kilden. Velg en annen kilde, et mindre utvalg eller tillat nedlasting fra iCloud."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze ronde heeft minstens %1$lld bruikbare foto's uit de gekozen bron nodig. Kies een andere bron, minder foto's of sta iCloud-downloads toe."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହି ରାଉଣ୍ଡ ପାଇଁ ବଛାଯାଇଥିବା ଉତ୍ସରୁ ଅନ୍ତତଃ %1$lldଟି ବ୍ୟବହାରଯୋଗ୍ୟ ଫଟୋ ଦରକାର। ଅନ୍ୟ ଉତ୍ସ, ଛୋଟ ଚୟନ ବାଛନ୍ତୁ କିମ୍ବା iCloud ଡାଉନଲୋଡ୍‌ର ଅନୁମତି ଦିଅନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਦੌਰ ਲਈ ਚੁਣੇ ਸਰੋਤ ਤੋਂ ਘੱਟੋ-ਘੱਟ %1$lld ਵਰਤਣਯੋਗ ਫ਼ੋਟੋਆਂ ਚਾਹੀਦੀਆਂ ਹਨ। ਕੋਈ ਹੋਰ ਸਰੋਤ, ਛੋਟੀ ਚੋਣ ਚੁਣੋ ਜਾਂ iCloud ਡਾਊਨਲੋਡਾਂ ਦੀ ਇਜਾਜ਼ਤ ਦਿਓ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta runda wymaga co najmniej %1$lld dostępnych zdjęć z wybranego źródła. Wybierz inne źródło, mniej zdjęć lub zezwól na pobieranie z iCloud."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta rodada precisa de pelo menos %1$lld fotos utilizáveis da origem escolhida. Escolha outra origem, uma seleção menor ou permita downloads do iCloud."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta ronda precisa de pelo menos %1$lld fotos utilizáveis da origem escolhida. Escolha outra origem, menos fotos ou permita descargas do iCloud."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Runda necesită cel puțin %1$lld poze utilizabile din sursa aleasă. Alege altă sursă, mai puține poze sau permite descărcarea din iCloud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужно не менее %1$lld доступных фото из выбранного источника. Выберите другой источник, меньше фото или разрешите загрузку из iCloud."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto kolo potrebuje najmenej %1$lld použiteľných fotiek z vybraného zdroja. Zvoľte iný zdroj, menší výber alebo povoľte sťahovanie z iCloudu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta krog potrebuje vsaj %1$lld uporabnih fotografij iz izbranega vira. Izberi drug vir, manjši izbor ali dovoli prenose iz iClouda."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här omgången behöver minst %1$lld användbara bilder från den valda källan. Välj en annan källa, ett mindre urval eller tillåt hämtning från iCloud."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தச் சுற்றுக்குத் தேர்ந்தெடுத்த மூலத்திலிருந்து குறைந்தது %1$lld பயன்படுத்தக்கூடிய புகைப்படங்கள் தேவை. வேறு மூலம், சிறிய தேர்வைத் தேர்ந்தெடுங்கள் அல்லது iCloud பதிவிறக்கங்களை அனுமதியுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ రౌండ్‌కి ఎంచుకున్న మూలం నుండి కనీసం %1$lld వాడదగిన ఫోటోలు అవసరం. వేరే మూలం, చిన్న ఎంపిక ఎంచుకోండి లేదా iCloud డౌన్‌లోడ్‌లను అనుమతించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รอบนี้ต้องใช้รูปที่ใช้ได้อย่างน้อย %1$lld รูปจากแหล่งที่เลือก เลือกแหล่งอื่น เลือกให้น้อยลง หรืออนุญาตให้ดาวน์โหลดจาก iCloud"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen kaynaktan en az %1$lld kullanılabilir fotoğraf gerekiyor. Başka bir kaynak, daha az fotoğraf seç veya iCloud indirmelerine izin ver."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Потрібно щонайменше %1$lld доступних фото з вибраного джерела. Вибери інше джерело, менше фото або дозволь завантаження з iCloud."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس راؤنڈ کے لیے منتخب ماخذ سے کم از کم %1$lld قابل استعمال تصاویر چاہییں۔ دوسرا ماخذ، چھوٹا انتخاب منتخب کریں یا iCloud ڈاؤن لوڈ کی اجازت دیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lượt này cần ít nhất %1$lld ảnh dùng được từ nguồn đã chọn. Hãy chọn nguồn khác, lựa chọn nhỏ hơn hoặc cho phép tải từ iCloud."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本局需要所选来源中至少 %1$lld 张可用照片。请选择其他来源、更少的照片，或允许从 iCloud 下载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這一回合至少需要所選來源中 %1$lld 張可用的照片。請選擇其他來源、較少的選擇，或允許從 iCloud 下載。"
          }
        }
      }
    },
