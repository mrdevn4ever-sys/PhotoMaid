          "stringUnit": {
            "state": "translated",
            "value": "Недавно добавленные сначала – в порядке приложения «Фото»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Naposledy pridané navrchu – v poradí aplikácie Fotky."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
