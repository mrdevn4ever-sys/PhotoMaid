    "vault_delete_all_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم حذف العناصر نهائيًا: %1$lld. أعِدها أولًا إلى تطبيق الصور إذا أردت الاحتفاظ بها."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld emner slettes permanent. Læg dem først tilbage i appen Fotos, hvis du vil beholde dem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld Inhalte werden unwiderruflich gelöscht. Lege Medien vorher zurück in die Fotos-App, wenn du sie behalten willst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld items will be deleted permanently. Put them back into the Photos app first if you want to keep them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán %1$lld elementos de forma permanente. Si quieres conservarlos, devuélvelos antes a la app Fotos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld éléments seront supprimés définitivement. Remets-les d’abord dans l’app Photos si tu veux les garder."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld item akan dihapus permanen. Kembalikan dulu ke app Foto jika ingin menyimpannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld elementi verranno eliminati definitivamente. Se vuoi conservarli, rimettili prima nell’app Foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld項目が完全に削除されます。残したい場合は、先に写真アプリに戻してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목 %1$lld개가 영구적으로 삭제됩니다. 보관하려면 먼저 사진 앱으로 되돌리세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld elementer slettes permanent. Legg dem tilbake i Bilder-appen først hvis du vil beholde dem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld onderdelen worden definitief verwijderd. Zet ze eerst terug in de Foto’s-app als je ze wilt houden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elementy do trwałego usunięcia: %1$lld. Jeśli chcesz je zachować, najpierw przenieś je z powrotem do aplikacji Zdjęcia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld itens serão apagados permanentemente. Devolva-os primeiro ao app Fotos se quiser mantê-los."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld itens serão apagados definitivamente. Se os quiseres manter, devolve-os primeiro à app Fotografias."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Elemente care vor fi șterse definitiv: %1$lld. Mută-le mai întâi înapoi în aplicația Poze dacă vrei să le păstrezi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Объекты будут удалены безвозвратно: %1$lld. Если хочешь их сохранить, сначала верни их в «Фото»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld objekt raderas permanent. Lägg tillbaka dem i appen Bilder först om du vill behålla dem."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld รายการจะถูกลบถาวร ใส่กลับไปที่แอพรูปภาพก่อนหากต้องการเก็บไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld öğe kalıcı olarak silinecek. Saklamak istiyorsan önce Fotoğraflar uygulamasına geri taşı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Об’єкти буде видалено безповоротно: %1$lld. Якщо хочеш їх зберегти, спочатку поверни їх у «Фото»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld mục sẽ bị xóa vĩnh viễn. Hãy đưa chúng về ứng dụng Ảnh trước nếu muốn giữ lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 项将被永久删除。如果想保留，请先将它们放回“照片”App。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 個項目將被永久刪除。若要保留，請先將它們放回「照片」App。"
          }
        }
      }
    },
    "vault_delete_all_title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حذف الخزنة وكل ما فيها؟"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slet boksen og alt i den?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tresor und alles darin löschen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete the vault and everything in it?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar la caja fuerte y todo su contenido?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer le coffre-fort et tout son contenu ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus brankas dan semua isinya?"
          }
        },
        "it": {
          "stringUnit": {
