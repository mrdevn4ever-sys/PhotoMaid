          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunas fotos ya no están disponibles y se omiten."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jotkin kuvat eivät ole enää saatavilla, ja ne jätetään pois."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines photos ne sont plus disponibles et sont ignorées."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કેટલાક ફોટા હવે ઉપલબ્ધ નથી અને છોડી દેવાયા છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חלק מהתמונות כבר לא זמינות והן מושמטות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ फ़ोटो अब उपलब्ध नहीं हैं और छोड़ दी गई हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neke fotografije više nisu dostupne pa su izostavljene."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Néhány fotó már nem érhető el, ezért kimarad."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beberapa foto sudah tidak tersedia dan dilewati."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcune foto non sono più disponibili e vengono omesse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部の写真が見つからないため、表示されません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
