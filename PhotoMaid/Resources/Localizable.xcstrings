        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse ensin kopioitavat kohteet ja kohdekansio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez d’abord ce qu’il faut copier et un dossier de destination."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પહેલાં શું કૉપિ કરવું અને ગંતવ્ય ફોલ્ડર પસંદ કરો."
