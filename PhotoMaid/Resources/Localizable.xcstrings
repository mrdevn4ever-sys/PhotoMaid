    "set_language_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم PhotoMaid لغة iPhone. اضغط لاختيار لغة أخرى لـ PhotoMaid فقط من «اللغة» في إعدادات iOS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid nutzt die Sprache deines iPhones. Tippe hier, um in den iOS-Einstellungen unter „Sprache“ eine andere Sprache nur für PhotoMaid zu wählen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid uses your iPhone’s language. Tap to choose a different language just for PhotoMaid under “Language” in iOS Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid usa el idioma de tu iPhone. Toca para elegir otro idioma solo para PhotoMaid en «Idioma» de los Ajustes de iOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid utilise la langue de ton iPhone. Touche ici pour choisir une autre langue rien que pour PhotoMaid sous « Langue » dans les réglages iOS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid usa la lingua del tuo iPhone. Tocca per scegliere un’altra lingua solo per PhotoMaid in «Lingua» nelle Impostazioni di iOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaidはiPhoneの言語を使います。タップすると、iOSの設定の「言語」でPhotoMaidだけ別の言語を選べます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid는 iPhone의 언어를 사용해요. 탭하면 iOS 설정의 ‘언어’에서 PhotoMaid에만 다른 언어를 선택할 수 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid gebruikt de taal van je iPhone. Tik om bij ‘Taal’ in iOS-instellingen een andere taal alleen voor PhotoMaid te kiezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid używa języka iPhone’a. Stuknij, aby w ustawieniach iOS w sekcji „Język” wybrać inny język tylko dla PhotoMaid."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O PhotoMaid usa o idioma do teu iPhone. Toca para escolher outro idioma só para o PhotoMaid em “Idioma” nas Definições do iOS."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid folosește limba iPhone-ului. Atinge pentru a alege altă limbă doar pentru PhotoMaid la „Limbă” în configurările iOS."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid использует язык iPhone. Нажми, чтобы выбрать другой язык только для PhotoMaid в разделе «Язык» в настройках iOS."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid iPhone’unun dilini kullanır. Yalnızca PhotoMaid için başka bir dil seçmek üzere iOS Ayarları’nda “Dil”e gitmek için dokun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid використовує мову iPhone. Торкнись, щоб у параметрах iOS у розділі «Мова» вибрати іншу мову лише для PhotoMaid."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid 使用 iPhone 的语言。轻点后可在 iOS 设置的“语言”中只为 PhotoMaid 选择其他语言。"
          }
        }
      }
    },
