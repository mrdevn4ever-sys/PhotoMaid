    "col_draft_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك المتابعة لاحقًا في الاستوديو. لا يُحفظ شيء في المعرض."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "You can continue later in Studio. Nothing is saved to your gallery."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst später im Studio weitermachen. In der Galerie wird nichts gespeichert."
