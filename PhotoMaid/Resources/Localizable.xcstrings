    "grid_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر للتحديد، واضغط مطولًا واسحب لتحديد عدة عناصر. النقل ليس قرارًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বেছে নিতে ট্যাপ করুন, একাধিক বেছে নিতে চেপে ধরে টানুন। সরানো কোনো সিদ্ধান্ত নয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca per seleccionar; mantén premut i arrossega per seleccionar-ne diversos. Moure no és una decisió."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím vyberete, podržením a tažením vyberete více. Posouvání není rozhodnutí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk for at vælge, hold og træk for at vælge flere. At flytte er ikke en beslutning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen wählt aus, lange drücken und ziehen wählt mehrere. Verschieben ist keine Entscheidung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάτησε για επιλογή, πάτησε παρατεταμένα και σύρε για πολλαπλή επιλογή. Η μετακίνηση δεν είναι απόφαση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to select, long-press and drag to select several. Moving is not a decision."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca para seleccionar; mantén pulsado y arrastra para elegir varios. Mover no es una decisión."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta valitaksesi, paina pitkään ja vedä valitaksesi useita. Siirtäminen ei ole päätös."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche pour sélectionner, appuie longuement et fais glisser pour en choisir plusieurs. Déplacer n’est pas une décision."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પસંદ કરવા ટૅપ કરો, અનેક પસંદ કરવા દબાવીને ખેંચો. ખસેડવું એ નિર્ણય નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקשה בוחרת, לחיצה ארוכה וגרירה בוחרות כמה. הזזה אינה החלטה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुनने के लिए टैप करें, कई चुनने के लिए दबाकर खींचें। हिलाना फ़ैसला नहीं है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirni za odabir, dugo pritisni i povuci za odabir više stavki. Pomicanje nije odluka."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints a kijelöléshez, tartsd lenyomva és húzd több elem kijelöléséhez. A mozgatás nem döntés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk untuk memilih, tekan lama dan seret untuk memilih beberapa. Memindah bukan keputusan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca per selezionare, tieni premuto e trascina per sceglierne diversi. Spostare non è una decisione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップで選択、長押ししてドラッグで複数選択。移動は選択（残す・ゴミ箱・あとで）ではありません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆಯ್ಕೆಮಾಡಲು ಟ್ಯಾಪ್ ಮಾಡಿ, ಹಲವನ್ನು ಆಯ್ಕೆಮಾಡಲು ಒತ್ತಿ ಹಿಡಿದು ಎಳೆಯಿರಿ. ಸರಿಸುವುದು ನಿರ್ಧಾರವಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭하면 선택, 길게 누른 채 드래그하면 여러 개를 선택해요. 이동은 선택에 포함되지 않아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "തിരഞ്ഞെടുക്കാൻ ടാപ്പ് ചെയ്യുക, പലതും തിരഞ്ഞെടുക്കാൻ അമർത്തിപ്പിടിച്ച് വലിക്കുക. നീക്കുന്നത് തീരുമാനമല്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "निवडण्यासाठी टॅप करा, अनेक निवडण्यासाठी दाबून ओढा. हलवणे हा निर्णय नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik untuk memilih, tekan lama dan seret untuk memilih beberapa. Mengalih bukanlah keputusan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk for å velge, hold og dra for å velge flere. Å flytte er ikke en beslutning."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik om te selecteren, houd ingedrukt en sleep om er meerdere te kiezen. Verplaatsen is geen keuze."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ବାଛିବାକୁ ଟାପ୍ କରନ୍ତୁ, ଅନେକ ବାଛିବାକୁ ଦବାଇ ଧରି ଟାଣନ୍ତୁ। ଘୁଞ୍ଚାଇବା ନିଷ୍ପତ୍ତି ନୁହେଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਚੁਣਨ ਲਈ ਟੈਪ ਕਰੋ, ਕਈ ਚੁਣਨ ਲਈ ਦਬਾ ਕੇ ਰੱਖੋ ਅਤੇ ਖਿੱਚੋ। ਹਿਲਾਉਣਾ ਕੋਈ ਫ਼ੈਸਲਾ ਨਹੀਂ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotknij, aby zaznaczyć; przytrzymaj i przeciągnij, aby zaznaczyć kilka. Przeniesienie to nie decyzja."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque para selecionar; toque e segure e arraste para selecionar vários. Mover não é uma decisão."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca para selecionar; mantém premido e arrasta para escolher vários. Mover não é uma decisão."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge pentru a selecta, ține apăsat și trage pentru mai multe. Mutarea nu este o decizie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажми, чтобы выбрать; удерживай и веди, чтобы выбрать несколько. Перемещение — не решение."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím vyberiete, podržaním a potiahnutím vyberiete viac. Posúvanie nie je rozhodnutie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapni za izbiro, dolgo pritisni in povleci za izbiro več. Premikanje ni odločitev."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck för att markera, håll ned och dra för att markera flera. Att flytta är inget beslut."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தேர்ந்தெடுக்கத் தட்டுங்கள், பலவற்றைத் தேர்ந்தெடுக்க அழுத்திப் பிடித்து இழுங்கள். நகர்த்துவது முடிவல்ல."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఎంచుకోవడానికి ట్యాప్ చేయండి, చాలా ఎంచుకోవడానికి నొక్కి పట్టుకుని లాగండి. తరలించడం నిర్ణయం కాదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะเพื่อเลือก กดค้างแล้วลากเพื่อเลือกหลายรายการ การย้ายไม่ใช่การตัดสินใจ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçmek için dokun, birden fazlası için basılı tutup sürükle. Taşımak bir karar değildir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкнись, щоб вибрати; утримуй і тягни, щоб вибрати кілька. Переміщення — не рішення."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "منتخب کرنے کے لیے ٹیپ کریں، کئی منتخب کرنے کے لیے دبا کر کھینچیں۔ ہلانا فیصلہ نہیں ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm để chọn, nhấn giữ và kéo để chọn nhiều. Di chuyển không phải là quyết định."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按选择，长按并拖动可选择多个。移动不算作选择。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下即可選取，長按並拖移可選取多項。移動不算決定。"
          }
        }
      }
    },
