            "value": "Alcune foto non sono più disponibili e vengono omesse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部の写真が見つからないため、表示されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 사진을 더 이상 찾을 수 없어 빠졌어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Noen bilder finnes ikke lenger og er utelatt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sommige foto’s zijn niet meer beschikbaar en worden weggelaten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niektóre zdjęcia są już niedostępne i zostaną pominięte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algumas fotos não estão mais disponíveis e ficaram de fora."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Algumas fotos já não estão disponíveis e ficam de fora."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Unele fotografii nu mai sunt disponibile și sunt omise."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Некоторых фото больше нет, они пропущены."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Några bilder finns inte längre och utelämnas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บางรูปไม่มีอยู่แล้วและถูกข้ามไป"
          }
        },
        "tr": {
