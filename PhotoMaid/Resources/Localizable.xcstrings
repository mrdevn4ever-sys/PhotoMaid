    "onb_story_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "راجع صورك وفيديوهاتك واختر ما يبقى. اسحب واحدة تلو الأخرى، بالسرعة التي تناسبك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ফটো ও ভিডিও দেখুন এবং কী থাকবে ঠিক করুন। একবারে একটি সোয়াইপ, নিজের গতিতে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa les teves fotos i vídeos i decideix què es queda. Un lliscament cada vegada, al teu ritme."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Projděte své fotky a videa a rozhodněte, co zůstane. Jedno přejetí po druhém, vlastním tempem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gå dine fotos og videoer igennem, og bestem, hvad der bliver. Ét swipe ad gangen, i dit eget tempo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh dir deine Fotos und Videos an und entscheide, was bleiben soll. Ein Wisch nach dem anderen, in deinem Tempo."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πέρασε τις φωτογραφίες και τα βίντεό σου και αποφάσισε τι μένει. Ένα σάρωμα τη φορά, με τον δικό σου ρυθμό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go through your photos and videos and decide what stays. One swipe at a time, at your own pace."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa tus fotos y vídeos y decide qué conservar. Un gesto cada vez, a tu ritmo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käy kuvasi ja videosi läpi ja päätä, mitä jää. Yksi pyyhkäisy kerrallaan, omaan tahtiisi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parcours tes photos et vidéos et décide de ce qui reste. Un geste à la fois, à ton rythme."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારા ફોટા અને વીડિયો જુઓ અને શું રહેશે તે નક્કી કરો. એક સમયે એક સ્વાઇપ, તમારી ગતિએ."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לעבור על התמונות והסרטונים ולהחליט מה נשאר. החלקה אחת בכל פעם, בקצב שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी फ़ोटो और वीडियो देखें और तय करें कि क्या रहेगा। एक बार में एक स्वाइप, अपनी रफ़्तार से।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prođi kroz svoje fotografije i videozapise i odluči što ostaje. Jedno po jedno povlačenje, svojim tempom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nézd át a fotóidat és videóidat, és döntsd el, mi marad. Egyszerre egy húzással, a saját tempódban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Telusuri foto dan videomu dan putuskan apa yang tetap. Satu geseran setiap kali, sesuai kecepatanmu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda le tue foto e i tuoi video e decidi cosa tenere. Un gesto alla volta, con i tuoi tempi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真や動画を見ながら、残すものを選びましょう。ひとつずつスワイプして、自分のペースで。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಫೋಟೋಗಳು ಮತ್ತು ವೀಡಿಯೊಗಳನ್ನು ನೋಡಿ ಮತ್ತು ಏನು ಉಳಿಯಬೇಕು ಎಂದು ನಿರ್ಧರಿಸಿ. ಒಮ್ಮೆಗೆ ಒಂದು ಸ್ವೈಪ್, ನಿಮ್ಮ ವೇಗದಲ್ಲಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진과 동영상을 보면서 남길 항목을 선택하세요. 하나씩 넘기며 내 속도대로 정리해요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ഫോട്ടോകളും വീഡിയോകളും കണ്ട് എന്ത് നിലനിർത്തണമെന്ന് തീരുമാനിക്കുക. ഒരു സമയം ഒരു സ്വൈപ്പ്, നിങ്ങളുടെ വേഗതയിൽ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचे फोटो आणि व्हिडिओ पाहा आणि काय ठेवायचे ते ठरवा. एका वेळी एक स्वाइप, तुमच्या वेगाने."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semak foto dan video anda dan tentukan apa yang kekal. Satu leretan pada satu masa, mengikut rentak anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gå gjennom bildene og videoene dine og bestem hva som blir. Ett sveip om gangen, i ditt eget tempo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekijk je foto’s en video’s en beslis wat blijft. Eén veeg tegelijk, in je eigen tempo."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ ଫଟୋ ଓ ଭିଡିଓ ଦେଖନ୍ତୁ ଏବଂ କ’ଣ ରହିବ ସ୍ଥିର କରନ୍ତୁ। ଥରକେ ଗୋଟିଏ ସ୍ୱାଇପ୍, ନିଜ ଗତିରେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਆਪਣੀਆਂ ਫ਼ੋਟੋਆਂ ਅਤੇ ਵੀਡੀਓ ਦੇਖੋ ਅਤੇ ਤੈਅ ਕਰੋ ਕਿ ਕੀ ਰਹੇਗਾ। ਇੱਕ ਵਾਰ ਵਿੱਚ ਇੱਕ ਸਵਾਈਪ, ਆਪਣੀ ਰਫ਼ਤਾਰ ਨਾਲ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeglądaj zdjęcia i filmy i decyduj, co zostaje. Jeden gest po drugim, we własnym tempie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe por suas fotos e vídeos e decida o que fica. Um gesto de cada vez, no seu ritmo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Vê as tuas fotos e vídeos e decide o que fica. Um gesto de cada vez, ao teu ritmo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Privește fotografiile și videoclipurile și decide ce rămâne. Câte un gest, în ritmul tău."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Просматривай фото и видео и решай, что оставить. Один жест за другим, в своём темпе."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prejdite svoje fotky a videá a rozhodnite, čo zostane. Jedno potiahnutie za druhým, vlastným tempom."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Preglej svoje fotografije in videoposnetke ter odloči, kaj ostane. Eno podrsanje naenkrat, v svojem tempu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gå igenom dina bilder och videor och bestäm vad som blir kvar. Ett svep i taget, i din egen takt."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் புகைப்படங்களையும் வீடியோக்களையும் பார்த்து எது இருக்க வேண்டும் என முடிவு செய்யுங்கள். ஒரு நேரத்தில் ஒரு ஸ்வைப், உங்கள் வேகத்தில்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ ఫోటోలు, వీడియోలను చూసి ఏది ఉండాలో నిర్ణయించండి. ఒకసారికి ఒక స్వైప్, మీ వేగంతో."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูรูปภาพและวิดีโอของคุณแล้วตัดสินใจว่าจะเก็บอะไร ปัดทีละครั้ง ตามจังหวะของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraf ve videolarına bak, hangilerinin kalacağına karar ver. Her seferinde bir kaydırma, kendi hızında."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переглядай фото й відео та вирішуй, що залишити. Один змах за іншим, у власному темпі."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنی تصاویر اور ویڈیوز دیکھیں اور طے کریں کہ کیا رہے گا۔ ایک وقت میں ایک سوائپ، اپنی رفتار سے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem qua ảnh và video và quyết định giữ lại gì. Mỗi lần một cú vuốt, theo nhịp của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "逐一浏览照片和视频，决定留下什么。每次一滑，按自己的节奏来。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "逐一瀏覽你的照片和影片，決定要留下什麼。一次滑一下，按你自己的步調。"
          }
        }
      }
    },
