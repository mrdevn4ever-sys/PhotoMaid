    "edit_err_declined": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم التغيير – لم يحصل iOS على الإذن. الأصل بلا تغيير."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বদলানো হয়নি – iOS অনুমতি পায়নি। মূলটি অপরিবর্তিত।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Sense canvis: l’iOS no ha obtingut permís. L’original no ha canviat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nezměněno – iOS nedostal povolení. Originál je beze změny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke ændret – iOS fik ikke tilladelse. Originalen er uændret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht geändert – iOS hat keine Erlaubnis erhalten. Das Original ist unverändert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χωρίς αλλαγή – το iOS δεν πήρε άδεια. Το πρωτότυπο δεν άλλαξε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not changed – iOS didn’t get permission. The original is unchanged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin cambios: iOS no recibió permiso. El original no ha cambiado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei muutettu – iOS ei saanut lupaa. Alkuperäinen on ennallaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’a changé – iOS n’a pas reçu l’autorisation. L’original est inchangé."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બદલાયું નથી – iOS ને મંજૂરી મળી નથી. મૂળ બદલાયું નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא השתנה – iOS לא קיבלה הרשאה. המקור לא השתנה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नहीं बदला – iOS को अनुमति नहीं मिली। मूल नहीं बदला।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nije promijenjeno – iOS nije dobio dopuštenje. Original je nepromijenjen."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs módosítás – az iOS nem kapott engedélyt. Az eredeti változatlan."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak diubah – iOS tidak mendapat izin. Aslinya tidak berubah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna modifica: iOS non ha ricevuto il permesso. L’originale è invariato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更されていません。iOSで許可されませんでした。オリジナルはそのままです。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಬದಲಾಗಿಲ್ಲ – iOS ಗೆ ಅನುಮತಿ ಸಿಗಲಿಲ್ಲ. ಮೂಲ ಬದಲಾಗಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경되지 않음 – iOS에서 허용되지 않았습니다. 원본은 그대로입니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മാറ്റിയില്ല – iOS-ന് അനുമതി ലഭിച്ചില്ല. ഒറിജിനലിന് മാറ്റമില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "बदल झाला नाही – iOS ला परवानगी मिळाली नाही. मूळ बदलले नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak diubah – iOS tidak mendapat kebenaran. Yang asal tidak berubah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke endret – iOS fikk ikke tillatelse. Originalen er uendret."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet gewijzigd – iOS kreeg geen toestemming. Het origineel is ongewijzigd."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ବଦଳିଲା ନାହିଁ – iOS ଅନୁମତି ପାଇଲା ନାହିଁ। ମୂଳ ଅପରିବର୍ତ୍ତିତ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਨਹੀਂ ਬਦਲਿਆ – iOS ਨੂੰ ਇਜਾਜ਼ਤ ਨਹੀਂ ਮਿਲੀ। ਮੂਲ ਨਹੀਂ ਬਦਲਿਆ।"
