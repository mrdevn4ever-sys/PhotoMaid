    "qa_remove_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُزال الاختصار فقط. تبقى ملفاتك واختياراتك محفوظة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun genvejen fjernes. Dine filer og valg bevares."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur der Schnellzugriff wird entfernt. Dateien und Entscheidungen bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the shortcut is removed. Your files and choices are kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se quita el acceso rápido. Tus archivos y decisiones se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul le raccourci est retiré. Tes fichiers et tes choix sont conservés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya pintasan yang dihapus. File dan pilihanmu tetap disimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Viene rimosso solo l’accesso rapido. I file e le tue scelte restano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットだけが外れます。ファイルとこれまでの選択は残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바로가기만 제거해요. 파일과 이전 선택은 그대로 남아요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare snarveien fjernes. Filene og valgene dine beholdes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen de snelkoppeling wordt verwijderd. Je bestanden en keuzes blijven bewaard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuwany jest tylko skrót. Pliki i Twoje wybory pozostają zapisane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só o atalho é removido. Seus arquivos e escolhas são mantidos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Só o atalho é removido. Os ficheiros e as tuas escolhas mantêm-se."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Este eliminată doar scurtătura. Fișierele și alegerile tale rămân."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Убирается только ярлык. Файлы и прежние решения остаются."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara genvägen tas bort. Dina filer och val behålls."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบเฉพาะทางลัด ไฟล์และการเลือกของคุณยังคงอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca kısayol kaldırılır. Dosyaların ve seçimlerin korunur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прибирається лише ярлик. Файли й попередні рішення залишаються."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ lối tắt bị xóa. Tệp và lựa chọn của bạn vẫn được giữ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只会移除快捷入口，文件和之前的选择都会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只會移除捷徑。你的檔案和選擇都會保留。"
          }
        }
      }
    },
