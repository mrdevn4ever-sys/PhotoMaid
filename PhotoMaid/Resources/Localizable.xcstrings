            "value": "Tippe auf etwas Hinzugefügtes, um es zu verschieben. Zwei Finger ändern Größe und Drehung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap something you added to move it. Two fingers resize and rotate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca algo que hayas añadido para moverlo. Con dos dedos cambias tamaño y giro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche un élément ajouté pour le déplacer. Deux doigts pour la taille et la rotation."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk sesuatu yang kamu tambahkan untuk memindahkannya. Dua jari mengubah ukuran dan memutar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca un elemento aggiunto per spostarlo. Con due dita cambi dimensione e rotazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加したものをタップすると移動できます。2本指でサイズと回転を変更。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추가한 항목을 눌러 옮기세요. 두 손가락으로 크기와 회전을 바꿔요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på noe du har lagt til for å flytte det. To fingre endrer størrelse og roterer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op iets wat je hebt toegevoegd om het te verplaatsen. Met twee vingers wijzig je grootte en draaiing."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotknij dodanego elementu, aby go przesunąć. Dwa palce zmieniają rozmiar i obrót."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em algo que você adicionou para movê-lo. Dois dedos redimensionam e giram."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca em algo que adicionaste para o mover. Com dois dedos mudas o tamanho e a rotação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge un element adăugat ca să-l muți. Cu două degete schimbi mărimea și rotirea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажми на добавленный элемент, чтобы переместить его. Двумя пальцами — размер и поворот."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på något du lagt till för att flytta det. Två fingrar ändrar storlek och roterar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะสิ่งที่คุณเพิ่มเพื่อย้าย สองนิ้วเพื่อปรับขนาดและหมุน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taşımak için eklediğin bir öğeye dokun. İki parmakla boyut ve dönüşü değiştir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкнися доданого елемента, щоб перемістити його. Двома пальцями — розмір і поворот."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm vào thứ bạn đã thêm để di chuyển. Hai ngón để đổi kích thước và xoay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按已添加的内容即可移动，双指可调整大小和旋转。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下你加入的內容即可移動。兩指可調整大小和旋轉。"
          }
        }
      }
    },
    "edit_mk_hint_ios": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على نص أو ملصق لتحديده، ثم اسحبه إلى المكان الذي تريده."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på en tekst eller et klistermærke for at vælge det, og træk det derefter derhen, hvor du vil have det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf einen Text oder Sticker, um ihn auszuwählen, und zieh ihn an die gewünschte Stelle."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a text or sticker to select it, then drag it where you want it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un texto o sticker para seleccionarlo y arrástralo adonde quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez un texte ou un autocollant pour le sélectionner, puis faites-le glisser à l’endroit voulu."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk teks atau stiker untuk memilihnya, lalu seret ke tempat yang kamu mau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca un testo o uno sticker per selezionarlo, poi trascinalo dove vuoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストやステッカーをタップして選択し、好きな位置へドラッグします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "텍스트나 스티커를 탭해 선택한 다음 원하는 위치로 드래그하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på en tekst eller et klistremerke for å velge det, og dra det dit du vil."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op een tekst of sticker om hem te selecteren en sleep hem naar de gewenste plek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij tekst lub naklejkę, aby ją zaznaczyć, i przeciągnij w wybrane miejsce."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque num texto ou adesivo para selecioná-lo e arraste-o para onde quiser."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque num texto ou autocolante para o selecionar e arraste-o para onde quiser."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge un text sau un sticker pentru a-l selecta, apoi trage-l unde vrei."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь текста или стикера, чтобы выбрать его, и перетащите в нужное место."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på en text eller dekal för att markera den och dra den sedan dit du vill."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะข้อความหรือสติกเกอร์เพื่อเลือก แล้วลากไปยังที่ที่ต้องการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçmek için bir metne veya çıkartmaya dokun, ardından istediğin yere sürükle."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться тексту чи наліпки, щоб вибрати, і перетягніть у потрібне місце."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm vào chữ hoặc nhãn dán để chọn, rồi kéo đến nơi bạn muốn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点文字或贴纸将其选中，然后拖到想要的位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下文字或貼圖來選取，再拖到你想要的位置。"
          }
        }
      }
    },
