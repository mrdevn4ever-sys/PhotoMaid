    "onb_story_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "راجع صورك وفيديوهاتك واختر ما يبقى. اسحب واحدة تلو الأخرى، بالسرعة التي تناسبك."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gå dine fotos og videoer igennem, og bestem, hvad der bliver. Ét swipe ad gangen, i dit eget tempo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh dir deine Fotos und Videos an und entscheide, was bleiben soll. Ein Wisch nach dem anderen, in deinem Tempo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go through your photos and videos and decide what stays. One swipe at a time, at your own pace."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa tus fotos y vídeos y decide qué conservar. Un gesto cada vez, a tu ritmo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parcours tes photos et vidéos et décide de ce qui reste. Un geste à la fois, à ton rythme."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Telusuri foto dan videomu dan putuskan apa yang tetap. Satu geseran setiap kali, sesuai kecepatanmu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda le tue foto e i tuoi video e decidi cosa tenere. Un gesto alla volta, con i tuoi tempi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真や動画を見ながら、残すものを選びましょう。ひとつずつスワイプして、自分のペースで。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진과 동영상을 보면서 남길 항목을 선택하세요. 하나씩 넘기며 내 속도대로 정리해요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gå gjennom bildene og videoene dine og bestem hva som blir. Ett sveip om gangen, i ditt eget tempo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekijk je foto’s en video’s en beslis wat blijft. Eén veeg tegelijk, in je eigen tempo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeglądaj zdjęcia i filmy i decyduj, co zostaje. Jeden gest po drugim, we własnym tempie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe por suas fotos e vídeos e decida o que fica. Um gesto de cada vez, no seu ritmo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Vê as tuas fotos e vídeos e decide o que fica. Um gesto de cada vez, ao teu ritmo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Privește fotografiile și videoclipurile și decide ce rămâne. Câte un gest, în ritmul tău."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Просматривай фото и видео и решай, что оставить. Один жест за другим, в своём темпе."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gå igenom dina bilder och videor och bestäm vad som blir kvar. Ett svep i taget, i din egen takt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูรูปภาพและวิดีโอของคุณแล้วตัดสินใจว่าจะเก็บอะไร ปัดทีละครั้ง ตามจังหวะของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraf ve videolarına bak, hangilerinin kalacağına karar ver. Her seferinde bir kaydırma, kendi hızında."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переглядай фото й відео та вирішуй, що залишити. Один змах за іншим, у власному темпі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem qua ảnh và video và quyết định giữ lại gì. Mỗi lần một cú vuốt, theo nhịp của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "逐一浏览照片和视频，决定留下什么。每次一滑，按自己的节奏来。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "逐一瀏覽你的照片和影片，決定要留下什麼。一次滑一下，按你自己的步調。"
          }
        }
      }
    },
