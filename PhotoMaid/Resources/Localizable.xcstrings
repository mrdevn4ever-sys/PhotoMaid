    "set_rate_app_sub": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رأيك يساعدنا كثيرًا – شكرًا!"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det hjælper os virkelig – tak!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hilft uns sehr – danke!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It really helps us – thank you!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nos ayuda mucho. ¡Gracias!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ça nous aide beaucoup, merci !"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Itu sangat membantu kami – terima kasih!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ci aiuta molto, grazie!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "とても励みになります。ありがとうございます！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "큰 힘이 돼요. 고마워요!"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det hjelper oss virkelig – takk!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat helpt ons enorm. Bedankt!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To nam bardzo pomaga. Dziękujemy!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso nos ajuda muito – obrigado!"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuda-nos muito. Obrigado!"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne ajută mult. Mulțumim!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это очень нам помогает. Спасибо!"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det hjälper oss verkligen – tack!"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ช่วยเราได้มากจริงๆ – ขอบคุณ!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bize çok yardımcı olur. Teşekkürler!"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це дуже нам допомагає. Дякуємо!"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điều đó thật sự giúp chúng tôi – cảm ơn bạn!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这对我们帮助很大，谢谢！"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這對我們真的很有幫助 – 謝謝你！"
