    "picker_no_date_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن يعود تلقائيًا. ستجده في «لاحقًا › مؤجَّلة»."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det kommer ikke tilbage af sig selv. Du finder det under Senere › Lagt til side."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kommt nicht von selbst zurück. Du findest es unter Später › Beiseitegelegt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It won’t come back on its own. You’ll find it under Later › Set aside."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No volverá por sí solo. Lo encontrarás en Después › Apartados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne reviendra pas tout seul. Tu le retrouveras dans Plus tard › Mis de côté."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Item ini tidak akan kembali sendiri. Kamu akan menemukannya di Nanti › Disisihkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non tornerà da solo. Lo trovi in Più tardi › Messi da parte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動では戻りません。「あとで › 保留中」にあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저절로 다시 나타나지 않아요. ‘나중에 › 따로 둠’에서 찾을 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det kommer ikke tilbake av seg selv. Du finner det under Senere › Lagt til side."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Komt niet vanzelf terug. Je vindt het onder Later › Opzijgelegd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie wróci samo. Znajdziesz je w Później › Odłożone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não volta sozinho. Você o encontra em Depois › Deixados de lado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não volta sozinho. Encontra-o em Mais tarde › Postos de parte."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu revine singur. Îl găsești la Mai târziu › Puse deoparte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Само не вернётся. Найдёшь в «Позже › Отложено»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den kommer inte tillbaka av sig själv. Du hittar den under Senare › Undanlagt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการนี้จะไม่กลับมาเอง คุณจะพบได้ใน ไว้ทีหลัง › แยกไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendiliğinden geri gelmez. Sonra › Ayrılanlar bölümünde bulursun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Саме не повернеться. Знайдеш у «Пізніше › Відкладено»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mục này sẽ không tự quay lại. Bạn sẽ tìm thấy nó trong Để sau › Để riêng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不会自动回来。可在“稍后 › 已搁置”中找到。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它不會自動回來。你可以在「稍後 › 已擱置」中找到。"
          }
        }
      }
    },
