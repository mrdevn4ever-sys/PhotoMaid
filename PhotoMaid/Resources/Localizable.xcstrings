    "slideshow_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المشاهدة ليست قرارًا أبدًا. تبقى الشاشة مضاءة أثناء عرض الشرائح."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দেখা কখনো সিদ্ধান্ত নয়। স্লাইডশো চলাকালীন স্ক্রিন চালু থাকে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mirar mai no és una decisió. La pantalla es manté encesa durant la presentació."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sledování nikdy není rozhodnutí. Obrazovka během prezentace zůstává zapnutá."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At se er aldrig en beslutning. Skærmen forbliver tændt under diasshowet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ansehen ist nie eine Entscheidung. Während der Diashow bleibt der Bildschirm an."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η προβολή δεν είναι ποτέ απόφαση. Η οθόνη μένει αναμμένη κατά την παρουσίαση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watching is never a decision. The screen stays on during the slideshow."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ver nunca es una decisión. La pantalla permanece encendida durante la presentación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Katsominen ei ole koskaan päätös. Näyttö pysyy päällä diaesityksen ajan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regarder n’est jamais une décision. L’écran reste allumé pendant le diaporama."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જોવું ક્યારેય નિર્ણય નથી. સ્લાઇડશો દરમિયાન સ્ક્રીન ચાલુ રહે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "צפייה אף פעם אינה החלטה. המסך נשאר דולק במהלך המצגת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "देखना कभी फ़ैसला नहीं होता। स्लाइडशो के दौरान स्क्रीन चालू रहती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gledanje nikad nije odluka. Zaslon ostaje uključen tijekom dijaprojekcije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A nézés sosem döntés. A képernyő a diavetítés alatt bekapcsolva marad."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menonton tidak pernah dianggap keputusan. Layar tetap menyala selama tayangan slide."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardare non è mai una decisione. Lo schermo resta acceso durante la presentazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見るだけでは何も決定されません。スライドショー中は画面がオンのままです。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೋಡುವುದು ಎಂದಿಗೂ ನಿರ್ಧಾರವಲ್ಲ. ಸ್ಲೈಡ್‌ಶೋ ಸಮಯದಲ್ಲಿ ಪರದೆ ಆನ್ ಆಗಿರುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보는 것은 결정이 아닙니다. 슬라이드쇼 중에는 화면이 켜져 있습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കാണുന്നത് ഒരിക്കലും തീരുമാനമല്ല. സ്ലൈഡ്‌ഷോ സമയത്ത് സ്ക്രീൻ ഓണായി തുടരും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पाहणे कधीच निर्णय नसतो. स्लाइडशो दरम्यान स्क्रीन चालू राहते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menonton bukanlah keputusan. Skrin kekal hidup semasa tayangan slaid."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å se på er aldri en beslutning. Skjermen forblir på under lysbildeserien."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekijken is nooit een beslissing. Het scherm blijft aan tijdens de diavoorstelling."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଦେଖିବା କେବେ ନିଷ୍ପତ୍ତି ନୁହେଁ। ସ୍ଲାଇଡସୋ ସମୟରେ ସ୍କ୍ରିନ୍ ଚାଲୁ ରହେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਦੇਖਣਾ ਕਦੇ ਵੀ ਫ਼ੈਸਲਾ ਨਹੀਂ ਹੁੰਦਾ। ਸਲਾਈਡਸ਼ੋ ਦੌਰਾਨ ਸਕ੍ਰੀਨ ਚਾਲੂ ਰਹਿੰਦੀ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oglądanie nigdy nie jest decyzją. Podczas pokazu ekran pozostaje włączony."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Assistir nunca é uma decisão. A tela fica ligada durante a apresentação."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ver nunca é uma decisão. O ecrã fica ligado durante a apresentação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vizionarea nu este niciodată o decizie. Ecranul rămâne aprins în timpul prezentării."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Просмотр никогда не является решением. Во время слайд-шоу экран не гаснет."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sledovanie nikdy nie je rozhodnutie. Obrazovka počas prezentácie zostáva zapnutá."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogledovanje nikoli ni odločitev. Zaslon med diaprojekcijo ostane vklopljen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att titta är aldrig ett beslut. Skärmen förblir på under bildspelet."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பார்ப்பது ஒருபோதும் முடிவல்ல. ஸ்லைடுஷோவின்போது திரை இயக்கத்தில் இருக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చూడడం ఎప్పుడూ నిర్ణయం కాదు. స్లైడ్‌షో సమయంలో స్క్రీన్ ఆన్‌లో ఉంటుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การดูไม่นับเป็นการตัดสินใจ หน้าจอจะเปิดค้างระหว่างสไลด์โชว์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzlemek asla bir karar değildir. Slayt gösterisi sırasında ekran açık kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перегляд ніколи не є рішенням. Під час слайд-шоу екран не гасне."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دیکھنا کبھی فیصلہ نہیں۔ سلائیڈ شو کے دوران اسکرین آن رہتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem không bao giờ là một quyết định. Màn hình luôn bật trong khi trình chiếu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "观看绝不会做出任何决定。幻灯片播放期间屏幕保持常亮。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "觀看永遠不算決定。播放幻燈片時螢幕會保持開啟。"
          }
        }
      }
    },
