    "done_estimated": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقديري («حوالي»): %1$lld – لا يكشف iOS حجمها الدقيق إلا بعد التنزيل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আনুমানিক (“প্রায়”): %1$lld – iOS ডাউনলোডের পরেই এদের সঠিক আকার জানায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimat («aprox.»): %1$lld. L’iOS només en revela la mida exacta després de baixar-los."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odhad („cca“): %1$lld – iOS jejich přesnou velikost prozradí až po stažení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Anslået (“ca.”): %1$lld – iOS viser først den præcise størrelse efter download."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geschätzt („ca.“): %1$lld – ihre genaue Größe nennt iOS erst nach dem Herunterladen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εκτίμηση («περ.»): %1$lld – το iOS δείχνει το ακριβές μέγεθός τους μόνο μετά τη λήψη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimated (“approx.”): %1$lld – iOS only reveals their exact size after downloading."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimados («aprox.»): %1$lld; iOS solo indica su tamaño exacto tras descargarlos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Arvioitu (”n.”): %1$lld – iOS kertoo niiden tarkan koon vasta latauksen jälkeen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimés (« env. ») : %1$lld – iOS n’indique leur taille exacte qu’après téléchargement."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અંદાજિત (“આશરે”): %1$lld – iOS તેમનું ચોક્કસ કદ ડાઉનલોડ પછી જ જણાવે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הערכה („בערך”): %1$lld – iOS חושפת את הגודל המדויק רק אחרי הורדה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुमानित (“लगभग”): %1$lld – iOS उनका सही साइज़ डाउनलोड के बाद ही बताता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Procijenjeno („pribl.”): %1$lld – iOS otkriva njihovu točnu veličinu tek nakon preuzimanja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Becsült („kb.”): %1$lld – a pontos méretüket az iOS csak letöltés után árulja el."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perkiraan (“sekitar”): %1$lld – iOS baru memberi tahu ukuran pastinya setelah diunduh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stimati («circa»): %1$lld – iOS ne indica la dimensione esatta solo dopo il download."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "推定（「約」）：%1$lld – 正確なサイズはダウンロード後にのみiOSが示します。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅಂದಾಜು (“ಸುಮಾರು”): %1$lld – ಡೌನ್‌ಲೋಡ್ ಮಾಡಿದ ನಂತರವೇ iOS ಅವುಗಳ ನಿಖರ ಗಾತ್ರ ತಿಳಿಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추정(‘약’): %1$lld – 정확한 크기는 다운로드한 후에만 iOS가 알려 줘요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കണക്കാക്കിയത് (“ഏകദേശം”): %1$lld – ഡൗൺലോഡ് ചെയ്ത ശേഷം മാത്രമേ iOS അവയുടെ കൃത്യമായ വലുപ്പം വെളിപ്പെടുത്തൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अंदाजे (“सुमारे”): %1$lld – iOS त्यांचा अचूक आकार डाउनलोडनंतरच सांगते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anggaran (“lebih kurang”): %1$lld – iOS hanya mendedahkan saiz tepatnya selepas dimuat turun."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Anslått («ca.»): %1$lld – iOS viser den nøyaktige størrelsen først etter nedlasting."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geschat (‘ca.’): %1$lld – de exacte grootte geeft iOS pas na het downloaden."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଅନୁମାନିତ (“ପ୍ରାୟ”): %1$lld – ଡାଉନଲୋଡ୍ ପରେ ହିଁ iOS ସେଗୁଡ଼ିକର ସଠିକ୍ ଆକାର ଜଣାଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਅੰਦਾਜ਼ਨ (“ਲਗਭਗ”): %1$lld – iOS ਉਨ੍ਹਾਂ ਦਾ ਸਹੀ ਆਕਾਰ ਡਾਊਨਲੋਡ ਤੋਂ ਬਾਅਦ ਹੀ ਦੱਸਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szacowane („ok.”): %1$lld – dokładny rozmiar iOS podaje dopiero po pobraniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimado (“aprox.”): %1$lld – o iOS só informa o tamanho exato depois do download."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimados («aprox.»): %1$lld – o iOS só indica o tamanho exato depois de os descarregar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimate („cca.”): %1$lld – iOS arată dimensiunea exactă abia după descărcare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оценка («≈»): %1$lld – точный размер iOS сообщает только после загрузки."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odhad („cca“): %1$lld – iOS ich presnú veľkosť prezradí až po stiahnutí."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocenjeno (»pribl.«): %1$lld – iOS njihovo natančno velikost razkrije šele po prenosu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uppskattat (”ca”): %1$lld – iOS visar den exakta storleken först efter hämtning."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மதிப்பீடு (“சுமார்”): %1$lld – பதிவிறக்கிய பின்னரே iOS அவற்றின் சரியான அளவைக் காட்டும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అంచనా (“సుమారు”): %1$lld – డౌన్‌లోడ్ తర్వాతే iOS వాటి ఖచ్చితమైన పరిమాణం చెబుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ประมาณการ (“ประมาณ”): %1$lld – iOS จะบอกขนาดที่แน่นอนหลังดาวน์โหลดเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahmini (“yaklaşık”): %1$lld – iOS tam boyutu ancak indirdikten sonra gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оцінка («≈»): %1$lld – точний розмір iOS повідомляє лише після завантаження."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اندازاً (”تقریباً“): %1$lld – iOS ان کا درست سائز ڈاؤن لوڈ کے بعد ہی بتاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ước tính (“khoảng”): %1$lld – iOS chỉ cho biết kích thước chính xác sau khi tải về."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "估算（“约”）：%1$lld – 只有下载后 iOS 才会提供确切大小。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "估計（「約」）：%1$lld – iOS 只有在下載後才會提供確切大小。"
          }
        }
      }
    },
