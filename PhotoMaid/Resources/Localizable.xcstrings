        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有されたファイルはこの端末のフォトライブラリにありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유된 파일 중 이 기기의 사진 보관함에 있는 파일이 없어요."
          }
        },
        "nl": {
