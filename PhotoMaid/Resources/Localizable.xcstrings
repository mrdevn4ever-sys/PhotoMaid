    "albums_footer_ios": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ألبومات ومجلدات تطبيق الصور. الإضافة إلى ألبوم لا تغيّر الملفات، وتتم مزامنتها مع صور iCloud إذا كانت مفعّلة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফটো অ্যাপের অ্যালবাম ও ফোল্ডার। অ্যালবামে যোগ করলে ফাইল বদলায় না, এবং iCloud ফটো চালু থাকলে তার সাথে সিঙ্ক হয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Àlbums i carpetes de l’app Fotos. Afegir a un àlbum no canvia els fitxers i se sincronitza amb Fotos d’iCloud si està activat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Alba a složky z aplikace Fotky. Přidání do alba nemění soubory a synchronizuje se s Fotkami na iCloudu, pokud jsou zapnuté."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Albummer og mapper fra appen Fotos. At føje til et album ændrer ikke filerne og synkroniseres med iCloud-fotos, hvis det er slået til."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alben und Ordner der Fotos-App. Hinzufügen ändert nichts an den Dateien und wird mit iCloud-Fotos synchronisiert, falls aktiviert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άλμπουμ και φάκελοι από την εφαρμογή Φωτογραφίες. Η προσθήκη σε άλμπουμ δεν αλλάζει τα αρχεία και συγχρονίζεται με τις Φωτογραφίες iCloud, αν είναι ενεργές."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Albums and folders from the Photos app. Adding to an album doesn’t change the files and syncs with iCloud Photos if it’s turned on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Álbumes y carpetas de la app Fotos. Añadir a un álbum no cambia los archivos y se sincroniza con Fotos de iCloud si está activado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Albumit ja kansiot Kuvat-apista. Albumiin lisääminen ei muuta tiedostoja ja synkronoituu iCloud-kuviin, jos ne ovat käytössä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Albums et dossiers de l’app Photos. Ajouter à un album ne modifie pas les fichiers et se synchronise avec Photos iCloud s’il est activé."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફોટો ઍપના આલ્બમ અને ફોલ્ડર. આલ્બમમાં ઉમેરવાથી ફાઇલો બદલાતી નથી, અને iCloud ફોટો ચાલુ હોય તો તે સિંક થાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אלבומים ותיקיות מהיישום ״תמונות״. הוספה לאלבום לא משנה את הקבצים, ומסונכרנת עם ״תמונות iCloud״ אם האפשרות מופעלת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तस्वीरें ऐप के एल्बम और फ़ोल्डर। एल्बम में जोड़ने से फ़ाइलें नहीं बदलतीं, और iCloud तस्वीरें चालू हो तो यह सिंक होता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Albumi i mape iz aplikacije Fotografije. Dodavanje u album ne mijenja datoteke i sinkronizira se s iCloud fotografijama ako su uključene."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Albumok és mappák a Fotók appból. Az albumba helyezés nem módosítja a fájlokat, és szinkronizálódik az iCloud-fotókkal, ha be vannak kapcsolva."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Album dan folder dari app Foto. Menambahkan ke album tidak mengubah file dan disinkronkan dengan Foto iCloud jika aktif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Album e cartelle dell’app Foto. L’aggiunta a un album non modifica i file e si sincronizza con Foto di iCloud, se attivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真アプリのアルバムとフォルダです。アルバムに追加してもファイルは変わらず、iCloud写真がオンなら同期されます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಫೋಟೋಗಳು ಆ್ಯಪ್‌ನ ಆಲ್ಬಮ್‌ಗಳು ಮತ್ತು ಫೋಲ್ಡರ್‌ಗಳು. ಆಲ್ಬಮ್‌ಗೆ ಸೇರಿಸುವುದರಿಂದ ಫೈಲ್‌ಗಳು ಬದಲಾಗುವುದಿಲ್ಲ, ಮತ್ತು iCloud ಫೋಟೋಗಳು ಆನ್ ಆಗಿದ್ದರೆ ಅದರೊಂದಿಗೆ ಸಿಂಕ್ ಆಗುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 앱의 앨범과 폴더입니다. 앨범에 추가해도 파일은 바뀌지 않으며, iCloud 사진이 켜져 있으면 동기화됩니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഫോട്ടോസ് ആപ്പിലെ ആൽബങ്ങളും ഫോൾഡറുകളും. ആൽബത്തിലേക്ക് ചേർക്കുന്നത് ഫയലുകളെ മാറ്റില്ല, iCloud ഫോട്ടോസ് ഓണാണെങ്കിൽ അതുമായി സമന്വയിപ്പിക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फोटो अ‍ॅपमधील अल्बम आणि फोल्डर. अल्बममध्ये जोडल्याने फाइल्स बदलत नाहीत आणि iCloud फोटो चालू असल्यास ते सिंक होते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Album dan folder daripada app Foto. Menambah ke album tidak mengubah fail dan disegerakkan dengan Foto iCloud jika dihidupkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Album og mapper fra Bilder-appen. Å legge til i et album endrer ikke filene og synkroniseres med iCloud-bilder hvis det er slått på."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Albums en mappen uit de Foto’s-app. Toevoegen aan een album wijzigt de bestanden niet en wordt gesynchroniseerd met iCloud-foto’s als dat aanstaat."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଫଟୋ ଆପ୍‌ର ଆଲବମ୍ ଓ ଫୋଲ୍ଡର। ଆଲବମ୍‌ରେ ଯୋଗ କଲେ ଫାଇଲ୍ ବଦଳେ ନାହିଁ, ଏବଂ iCloud ଫଟୋ ଚାଲୁ ଥିଲେ ସେଥିସହ ସିଙ୍କ୍ ହୁଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਫ਼ੋਟੋਆਂ ਐਪ ਦੀਆਂ ਐਲਬਮਾਂ ਅਤੇ ਫ਼ੋਲਡਰ। ਐਲਬਮ ਵਿੱਚ ਜੋੜਨ ਨਾਲ ਫ਼ਾਈਲਾਂ ਨਹੀਂ ਬਦਲਦੀਆਂ, ਅਤੇ iCloud ਫ਼ੋਟੋਆਂ ਚਾਲੂ ਹੋਣ ਤਾਂ ਇਹ ਸਿੰਕ ਹੁੰਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Albumy i foldery z aplikacji Zdjęcia. Dodanie do albumu nie zmienia plików i synchronizuje się ze Zdjęciami iCloud, jeśli są włączone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Álbuns e pastas do app Fotos. Adicionar a um álbum não altera os arquivos e sincroniza com as Fotos do iCloud, se estiverem ativadas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Álbuns e pastas da app Fotografias. Adicionar a um álbum não altera os ficheiros e sincroniza com Fotografias em iCloud, se estiver ativado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Albume și dosare din aplicația Poze. Adăugarea într-un album nu modifică fișierele și se sincronizează cu Poze iCloud, dacă e activat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Альбомы и папки приложения «Фото». Добавление в альбом не меняет файлы и синхронизируется с Фото iCloud, если оно включено."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Albumy a priečinky z aplikácie Fotky. Pridanie do albumu nemení súbory a synchronizuje sa s Fotkami na iCloude, ak sú zapnuté."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Albumi in mape iz aplikacije Fotografije. Dodajanje v album ne spremeni datotek in se sinhronizira s Fotografijami iCloud, če so vklopljene."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Album och mappar från appen Bilder. Att lägga till i ett album ändrar inte filerna och synkas med iCloud-bilder om det är på."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos ஆப்பின் ஆல்பங்களும் கோப்புறைகளும். ஆல்பத்தில் சேர்ப்பது கோப்புகளை மாற்றாது, iCloud புகைப்படங்கள் இயக்கத்தில் இருந்தால் அதனுடன் ஒத்திசைக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos యాప్‌లోని ఆల్బమ్‌లు, ఫోల్డర్‌లు. ఆల్బమ్‌కి జోడించడం ఫైళ్లను మార్చదు, iCloud ఫోటోలు ఆన్‌లో ఉంటే దానితో సింక్ అవుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อัลบั้มและโฟลเดอร์จากแอพรูปภาพ การเพิ่มลงอัลบั้มไม่เปลี่ยนไฟล์ และจะซิงค์กับรูปภาพ iCloud หากเปิดอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraflar uygulamasındaki albümler ve klasörler. Albüme eklemek dosyaları değiştirmez; açıksa iCloud Fotoğrafları ile eşzamanlanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Альбоми й папки програми «Фото». Додавання до альбому не змінює файли й синхронізується з Фото iCloud, якщо їх увімкнено."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تصاویر ایپ کے البمز اور فولڈرز۔ البم میں شامل کرنے سے فائلیں تبدیل نہیں ہوتیں، اور iCloud تصاویر آن ہوں تو یہ سنک ہوتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Album và thư mục từ ứng dụng Ảnh. Thêm vào album không thay đổi tệp và sẽ đồng bộ với Ảnh iCloud nếu đang bật."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自“照片”App 的相簿和文件夹。添加到相簿不会更改文件；若已开启 iCloud 照片，则会同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「照片」App 中的相簿和檔案夾。加入相簿不會更改檔案；若已開啟「iCloud 照片」，會同步到其他裝置。"
          }
        }
      }
    },
