    "tour_lib_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هنا كل صورك ومقاطع الفيديو – حسب اليوم أو الشهر أو السنة، في الألبومات والمفضلة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখানে আপনার সব ফটো ও ভিডিও – দিন, মাস বা বছর অনুযায়ী, অ্যালবাম ও পছন্দের মধ্যে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí tens totes les teves fotos i vídeos: per dia, mes o any, en àlbums i preferits."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tady jsou všechny vaše fotky a videa – podle dnů, měsíců nebo let, v albech a oblíbených."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Her er alle dine fotos og videoer – efter dag, måned eller år, i albummer og favoritter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier findest du alle Fotos und Videos – nach Tagen, Monaten oder Jahren, in Alben und Favoriten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εδώ είναι όλες οι φωτογραφίες και τα βίντεό σου – ανά ημέρα, μήνα ή έτος, σε άλμπουμ και αγαπημένα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Here are all your photos and videos – by day, month or year, in albums and favourites."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí están todas tus fotos y vídeos: por día, mes o año, en álbumes y favoritos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Täällä ovat kaikki kuvasi ja videosi – päivän, kuukauden tai vuoden mukaan, albumeissa ja suosikeissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retrouvez ici toutes vos photos et vidéos – par jour, mois ou année, dans les albums et favoris."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અહીં તમારા બધા ફોટા અને વીડિયો છે – દિવસ, મહિના કે વર્ષ મુજબ, આલ્બમ અને મનપસંદમાં."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כאן כל התמונות והסרטונים שלך – לפי יום, חודש או שנה, באלבומים ובמועדפים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहाँ आपकी सारी फ़ोटो और वीडियो हैं – दिन, महीने या साल के हिसाब से, एल्बम और पसंदीदा में।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovdje su sve tvoje fotografije i videozapisi – po danu, mjesecu ili godini, u albumima i omiljenima."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Itt van minden fotód és videód – nap, hónap vagy év szerint, albumokban és a kedvencek között."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini semua foto dan videomu – per hari, bulan, atau tahun, di album dan favorit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui trovi tutte le foto e i video, per giorno, mese o anno, negli album e nei preferiti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての写真とビデオを日・月・年別に、アルバムやお気に入りで見られます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇಲ್ಲಿ ನಿಮ್ಮ ಎಲ್ಲಾ ಫೋಟೋಗಳು ಮತ್ತು ವೀಡಿಯೊಗಳಿವೆ – ದಿನ, ತಿಂಗಳು ಅಥವಾ ವರ್ಷದ ಪ್ರಕಾರ, ಆಲ್ಬಮ್‌ಗಳು ಮತ್ತು ಮೆಚ್ಚಿನವುಗಳಲ್ಲಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 사진과 비디오를 일, 월, 연도별로, 앨범과 즐겨찾기에서 볼 수 있습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇവിടെ നിങ്ങളുടെ എല്ലാ ഫോട്ടോകളും വീഡിയോകളും ഉണ്ട് – ദിവസം, മാസം അല്ലെങ്കിൽ വർഷം അനുസരിച്ച്, ആൽബങ്ങളിലും പ്രിയപ്പെട്ടവയിലും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "इथे तुमचे सर्व फोटो आणि व्हिडिओ आहेत – दिवस, महिना किंवा वर्षानुसार, अल्बम आणि आवडत्यांमध्ये."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Di sini terdapat semua foto dan video anda – mengikut hari, bulan atau tahun, dalam album dan kegemaran."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Her er alle bildene og videoene dine – etter dag, måned eller år, i album og favoritter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier vind je al je foto’s en video’s – per dag, maand of jaar, in albums en favorieten."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏଠାରେ ଆପଣଙ୍କ ସବୁ ଫଟୋ ଓ ଭିଡିଓ – ଦିନ, ମାସ କିମ୍ବା ବର୍ଷ ଅନୁସାରେ, ଆଲବମ୍ ଓ ପସନ୍ଦରରେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇੱਥੇ ਤੁਹਾਡੀਆਂ ਸਾਰੀਆਂ ਫ਼ੋਟੋਆਂ ਅਤੇ ਵੀਡੀਓ ਹਨ – ਦਿਨ, ਮਹੀਨੇ ਜਾਂ ਸਾਲ ਅਨੁਸਾਰ, ਐਲਬਮਾਂ ਅਤੇ ਮਨਪਸੰਦ ਵਿੱਚ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu znajdziesz wszystkie zdjęcia i filmy – według dni, miesięcy lub lat, w albumach i ulubionych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aqui estão todas as suas fotos e vídeos – por dia, mês ou ano, em álbuns e favoritos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Aqui estão todas as fotografias e vídeos – por dia, mês ou ano, em álbuns e favoritos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aici găsești toate pozele și videoclipurile – pe zile, luni sau ani, în albume și favorite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь все ваши фото и видео — по дням, месяцам или годам, в альбомах и избранном."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu sú všetky vaše fotky a videá – podľa dní, mesiacov alebo rokov, v albumoch a obľúbených."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tukaj so vse tvoje fotografije in videoposnetki – po dnevih, mesecih ali letih, v albumih in priljubljenih."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Här finns alla dina bilder och videor – per dag, månad eller år, i album och favoriter."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இங்கே உங்கள் எல்லாப் புகைப்படங்களும் வீடியோக்களும் – நாள், மாதம் அல்லது ஆண்டுவாரியாக, ஆல்பங்களிலும் பிடித்தவையிலும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇక్కడ మీ అన్ని ఫోటోలు, వీడియోలు ఉన్నాయి – రోజు, నెల లేదా సంవత్సరం వారీగా, ఆల్బమ్‌లు, ఇష్టమైనవిలో."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นี่คือรูปภาพและวิดีโอทั้งหมดของคุณ – ตามวัน เดือน หรือปี ในอัลบั้มและรายการโปรด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm fotoğrafların ve videoların burada – güne, aya veya yıla göre, albümlerde ve favorilerde."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут усі ваші фото й відео — за днями, місяцями чи роками, в альбомах і вибраному."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہاں آپ کی تمام تصاویر اور ویڈیوز ہیں – دن، مہینے یا سال کے لحاظ سے، البمز اور پسندیدہ میں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây là tất cả ảnh và video của bạn – theo ngày, tháng hoặc năm, trong album và mục ưa thích."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里有你所有的照片和视频——按日、月或年，以及相簿和个人收藏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這裡有你所有的照片和影片 – 依日、月或年排列，還有相簿和個人收藏。"
          }
        }
      }
    },
