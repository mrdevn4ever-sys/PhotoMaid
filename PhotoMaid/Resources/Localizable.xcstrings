    "tools_trash_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "معطّل افتراضيًا. يسأل Android مرة واحدة لكل الملفات؛ وتبقى قابلة للاستعادة هناك ما دام Android يحتفظ بها. لا تتحرر المساحة إلا عندما يفرغ Android السلة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard aus. Android fragt einmal für alle Dateien; dort bleiben sie wiederherstellbar, solange Android sie aufbewahrt. Platz wird erst frei, wenn Android den Papierkorb leert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off by default. Android asks once for all files; they stay restorable there for as long as Android keeps them. Space is only freed when Android empties its trash."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado por defecto. Android pregunta una sola vez por todos; allí se pueden recuperar mientras Android los conserve. El espacio solo se libera cuando Android vacía la papelera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé par défaut. Android demande une seule fois pour tous les fichiers ; ils restent restaurables tant qu’Android les conserve. L’espace n’est libéré que lorsque Android vide la corbeille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivato di default. Android chiede una volta per tutti i file; restano ripristinabili finché Android li conserva. Lo spazio si libera solo quando Android svuota il cestino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "初期設定はオフ。Androidがすべてのファイルについて1回だけ確認し、Androidが保管している間は復元できます。容量が空くのはAndroidがゴミ箱を空にしたときです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본값은 꺼짐입니다. Android가 모든 파일에 대해 한 번 확인하며, Android가 보관하는 동안 복원할 수 있습니다. 공간은 Android가 휴지통을 비울 때 확보됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Standaard uit. Android vraagt één keer voor alle bestanden; ze blijven herstelbaar zolang Android ze bewaart. Ruimte komt pas vrij als Android de prullenbak leegt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Domyślnie wyłączone. Android zapyta raz o wszystkie pliki; można je przywrócić, dopóki Android je przechowuje. Miejsce zwalnia się dopiero, gdy Android opróżni kosz."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Desligado por predefinição. O Android pergunta uma vez para todos; ficam recuperáveis enquanto o Android os guardar. O espaço só é libertado quando o Android esvazia o lixo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dezactivat implicit. Android întreabă o dată pentru toate fișierele; rămân recuperabile cât timp Android le păstrează. Spațiul se eliberează doar când Android golește coșul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По умолчанию выключено. Android спросит один раз для всех файлов; их можно восстановить, пока Android их хранит. Место освобождается, только когда Android очистит корзину."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsayılan olarak kapalı. Android tüm dosyalar için bir kez sorar; Android sakladığı sürece geri yüklenebilir. Alan ancak Android çöp kutusunu boşalttığında açılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Типово вимкнено. Android запитає один раз для всіх файлів; їх можна відновити, доки Android їх зберігає. Місце звільняється, лише коли Android очистить кошик."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认关闭。Android 会对所有文件确认一次；在 Android 保留期间可以恢复。只有在 Android 清空回收站后才会释放空间。"
          }
        }
      }
    },
