    "edit_hint_lossless": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بلا فقد: يتغير الاتجاه فقط وتبقى جودة الصورة كما هي تمامًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lossless: only the orientation changes, image quality stays exactly the same."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlustfrei: Nur die Ausrichtung ändert sich, die Bildqualität bleibt exakt gleich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lossless: only the orientation changes, image quality stays exactly the same."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin pérdida: solo cambia la orientación; la calidad se mantiene exactamente igual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans perte : seule l’orientation change, la qualité reste exactement la même."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lossless: only the orientation changes, image quality stays exactly the same."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza perdita: cambia solo l’orientamento, la qualità resta identica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "劣化なし：向きだけが変わり、画質はまったく同じです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무손실: 방향만 바뀌고 화질은 그대로예요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lossless: only the orientation changes, image quality stays exactly the same."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verliesvrij: alleen de stand verandert, de beeldkwaliteit blijft precies gelijk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezstratnie: zmienia się tylko orientacja, jakość pozostaje dokładnie taka sama."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lossless: only the orientation changes, image quality stays exactly the same."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem perdas: só muda a orientação, a qualidade fica exatamente igual."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fără pierderi: se schimbă doar orientarea, calitatea rămâne identică."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без потерь: меняется только ориентация, качество остаётся прежним."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lossless: only the orientation changes, image quality stays exactly the same."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lossless: only the orientation changes, image quality stays exactly the same."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıpsız: Yalnızca yön değişir, görüntü kalitesi tamamen aynı kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Без втрат: змінюється лише орієнтація, якість лишається такою самою."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lossless: only the orientation changes, image quality stays exactly the same."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无损：只改变方向，画质完全不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lossless: only the orientation changes, image quality stays exactly the same."
          }
        }
      }
    },
    "edit_hint_replace_confirm": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيطلب Android مرة واحدة تأكيد نقل الأصل إلى سلة مهملات Android."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
