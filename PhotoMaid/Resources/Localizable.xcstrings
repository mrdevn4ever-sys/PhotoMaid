    "game_records_local": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى النتائج الشخصية على هذا الجهاز. تُفصل أوقات لعبة الأزواج حسب حجم الجولة والصور أو الرموز وطريقة التقليب. وتُفصل نتائج الثعبان حسب الوضع والسرعة والتحكم."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Personal records stay on this device. Pairs best times are separated by round size, photos or symbols and reveal mode. Snake records are separated by mode, speed and controls."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Persönliche Bestwerte bleiben auf diesem Gerät. Paare-Bestzeiten werden nach Rundengröße, Fotos oder Motiven und Umdrehmodus getrennt. Snake-Rekorde nach Modus, Tempo und Steuerung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Personal records stay on this device. Pairs best times are separated by round size, photos or symbols and reveal mode. Snake records are separated by mode, speed and controls."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los récords personales permanecen en este dispositivo. Los tiempos de Parejas se separan por tamaño, fotos o símbolos y modo de volteo. Los de Snake, por modo, velocidad y controles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les records restent sur cet appareil. Les temps de Paires sont séparés selon la taille, les photos ou symboles et le mode de retournement. Ceux du serpent selon le mode, la vitesse et les commandes."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Personal records stay on this device. Pairs best times are separated by round size, photos or symbols and reveal mode. Snake records are separated by mode, speed and controls."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I record personali restano su questo dispositivo. I tempi di Coppie sono separati per dimensione, foto o simboli e modalità di scoperta. I record di Snake per modalità, velocità e comandi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自己ベストはこのデバイスに保存されます。ペアはペア数、写真・シンボル、カードを伏せる方法ごとに、スネークはモード、速さ、操作方法ごとに記録します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개인 기록은 이 기기에 저장됩니다. 짝맞추기는 짝 수, 사진 또는 기호, 뒤집기 방식별로, 스네이크는 모드, 속도, 조작 방식별로 기록합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Personal records stay on this device. Pairs best times are separated by round size, photos or symbols and reveal mode. Snake records are separated by mode, speed and controls."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Persoonlijke records blijven op dit apparaat. Tijden voor Paren worden gescheiden op grootte, foto’s of symbolen en omdraaimodus. Snake-records op modus, tempo en bediening."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekordy osobiste pozostają na tym urządzeniu. Czasy gry Pary są osobne dla rozmiaru, zdjęć lub symboli i trybu odkrywania. Rekordy Snake zależą od trybu, tempa i sterowania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Personal records stay on this device. Pairs best times are separated by round size, photos or symbols and reveal mode. Snake records are separated by mode, speed and controls."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os recordes pessoais ficam neste dispositivo. Os tempos de Pares são separados por tamanho, fotos ou símbolos e modo de virar. Os de Snake por modo, velocidade e controlos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Recordurile rămân pe acest dispozitiv. Timpii pentru Perechi sunt separați după mărime, poze sau simboluri și modul de întoarcere. Recordurile Snake după mod, viteză și comenzi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Личные рекорды хранятся на этом устройстве. Время игры «Пары» учитывается отдельно по размеру, фото или символам и режиму переворота. Рекорды змейки — по режиму, скорости и управлению."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Personal records stay on this device. Pairs best times are separated by round size, photos or symbols and reveal mode. Snake records are separated by mode, speed and controls."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Personal records stay on this device. Pairs best times are separated by round size, photos or symbols and reveal mode. Snake records are separated by mode, speed and controls."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kişisel rekorlar bu cihazda kalır. Çiftler süreleri boyuta, fotoğraf veya simgelere ve çevirme moduna göre; yılan rekorları mod, hız ve kontrollere göre ayrılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Особисті рекорди зберігаються на цьому пристрої. Час гри «Пари» враховується окремо за розміром, фото чи символами й режимом перевертання. Рекорди змійки — за режимом, швидкістю та керуванням."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Personal records stay on this device. Pairs best times are separated by round size, photos or symbols and reveal mode. Snake records are separated by mode, speed and controls."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "个人纪录保存在此设备上。配对按规模、照片或图案及翻牌方式分别计时；贪吃蛇按模式、速度和控制方式分别记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Personal records stay on this device. Pairs best times are separated by round size, photos or symbols and reveal mode. Snake records are separated by mode, speed and controls."
          }
        }
      }
    },
    "game_records_save_failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
