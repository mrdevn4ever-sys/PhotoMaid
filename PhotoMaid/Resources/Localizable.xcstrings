    "limit_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المحدد: %2$lld. من دون Pro يمكنك إزالة ما يصل إلى %1$lld يوميًا. يبقى الباقي في سلة مهملات GaleriQ."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgt: %2$lld. Uden Pro kan du fjerne op til %1$lld om dagen. Resten bliver i GaleriQ-papirkurven."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgewählt: %2$lld. Ohne Pro kannst du pro Tag bis zu %1$lld entfernen. Alles Weitere bleibt im GaleriQ-Papierkorb."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected: %2$lld. Without Pro, you can remove up to %1$lld per day. Everything else stays in the GaleriQ trash."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleccionados: %2$lld. Sin Pro, puedes quitar hasta %1$lld al día. El resto sigue en la papelera de GaleriQ."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélection : %2$lld. Sans Pro, tu peux en retirer jusqu’à %1$lld par jour. Le reste demeure dans la corbeille GaleriQ."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipilih: %2$lld. Tanpa Pro, kamu bisa menghapus hingga %1$lld per hari. Sisanya tetap di sampah GaleriQ."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Selezionati: %2$lld. Senza Pro puoi rimuoverne fino a %1$lld al giorno. Il resto rimane nel cestino di GaleriQ."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択中：%2$lld件。Proなしでは1日%1$lld件まで削除できます。残りはGaleriQのゴミ箱に残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 항목: %2$lld개. Pro 없이 하루 최대 %1$lld개까지 삭제할 수 있어요. 나머지는 GaleriQ 휴지통에 남아요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgt: %2$lld. Uten Pro kan du fjerne opptil %1$lld om dagen. Resten blir i GaleriQ-papirkurven."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geselecteerd: %2$lld. Zonder Pro kun je er maximaal %1$lld per dag verwijderen. De rest blijft in de GaleriQ-prullenbak."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznaczono: %2$lld. Bez Pro możesz usunąć maksymalnie %1$lld dziennie. Reszta pozostaje w koszu GaleriQ."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecionados: %2$lld. Sem o Pro, você pode remover até %1$lld por dia. O resto fica na lixeira do GaleriQ."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecionados: %2$lld. Sem Pro, podes remover até %1$lld por dia. O resto continua no lixo do GaleriQ."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Selectate: %2$lld. Fără Pro poți elimina cel mult %1$lld pe zi. Restul rămân în coșul GaleriQ."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбрано: %2$lld. Без Pro можно удалить до %1$lld в день. Остальное останется в корзине GaleriQ."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Valda: %2$lld. Utan Pro kan du ta bort upp till %1$lld per dag. Resten stannar i GaleriQ-papperskorgen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกแล้ว: %2$lld หากไม่มี Pro คุณนำออกได้สูงสุด %1$lld ต่อวัน ส่วนที่เหลือยังอยู่ในถังขยะ GaleriQ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen: %2$lld. Pro olmadan günde en fazla %1$lld kaldırabilirsin. Diğerleri GaleriQ çöp kutusunda kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибрано: %2$lld. Без Pro можна видалити до %1$lld за день. Решта залишиться в кошику GaleriQ."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã chọn: %2$lld. Không có Pro, bạn có thể xóa tối đa %1$lld mỗi ngày. Phần còn lại vẫn ở trong thùng rác GaleriQ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已选 %2$lld 项。无需 Pro，每天最多可移除 %1$lld 项。其余内容会留在 GaleriQ 回收站中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已選擇：%2$lld。沒有 Pro 時，每天最多可移除 %1$lld 項。其餘的會留在 GaleriQ 垃圾桶中。"
