    "archive_no_cleanup_device": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النسخ موجودة على نفس مساحة التخزين التي تحتوي على صورك، لذلك لا يعرض PhotoMaid هنا إزالة الأصول."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kopien liegen auf demselben Speicher wie deine Fotos. Deshalb bietet PhotoMaid hier nicht an, Originale zu entfernen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The copies are on the same storage as your photos, so PhotoMaid doesn’t offer to remove originals here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las copias están en el mismo almacenamiento que tus fotos, así que PhotoMaid no ofrece aquí quitar los originales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les copies sont sur le même stockage que vos photos ; PhotoMaid ne propose donc pas ici de retirer les originaux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le copie sono sulla stessa memoria delle tue foto, quindi qui PhotoMaid non propone di rimuovere gli originali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピーは写真と同じストレージにあるため、PhotoMaidはここで元のファイルを削除する提案をしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사본이 사진과 같은 저장 공간에 있어서 PhotoMaid는 여기서 원본을 지우자고 하지 않아요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De kopieën staan op dezelfde opslag als je foto’s. Daarom biedt PhotoMaid hier niet aan om originelen te verwijderen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopie są w tej samej pamięci co Twoje zdjęcia, więc PhotoMaid nie proponuje tu usunięcia oryginałów."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As cópias estão no mesmo armazenamento que as suas fotos, por isso o PhotoMaid não propõe aqui remover os originais."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiile sunt pe aceeași memorie ca fotografiile tale, așa că PhotoMaid nu propune aici eliminarea originalelor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копии лежат в той же памяти, что и ваши фото, поэтому PhotoMaid не предлагает здесь убрать оригиналы."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopyalar fotoğraflarınla aynı depolama alanında; bu yüzden PhotoMaid burada orijinalleri kaldırmayı önermez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Копії лежать у тій самій пам’яті, що й ваші фото, тому PhotoMaid не пропонує тут прибрати оригінали."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "副本与照片位于同一存储空间，因此 PhotoMaid 不会在此建议移除原件。"
          }
        }
      }
    },
    "archive_no_cleanup_provider": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النسخ لدى تطبيق آخر. لا يستطيع PhotoMaid معرفة إن كانت آمنة هناك، لذلك لا يعرض إزالة الأصول."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kopien liegen bei einer anderen App. Ob sie dort sicher sind, kann PhotoMaid nicht sehen – deshalb kein Angebot, Originale zu entfernen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The copies are with another app. PhotoMaid can’t see whether they’re safe there, so it doesn’t offer to remove originals."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las copias están en otra app. PhotoMaid no puede ver si están seguras ahí, así que no ofrece quitar los originales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les copies sont dans une autre app. PhotoMaid ne peut pas voir si elles y sont en sécurité ; il ne propose donc pas de retirer les originaux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le copie si trovano in un’altra app. PhotoMaid non può vedere se lì sono al sicuro, quindi non propone di rimuovere gli originali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピーは別のアプリにあります。そこで安全かどうかPhotoMaidには分からないため、元のファイルを削除する提案はしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사본이 다른 앱에 있어요. 그곳에서 안전한지 PhotoMaid는 알 수 없어서 원본을 지우자고 하지 않아요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De kopieën staan bij een andere app. PhotoMaid kan niet zien of ze daar veilig zijn – daarom geen aanbod om originelen te verwijderen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopie są w innej aplikacji. PhotoMaid nie widzi, czy są tam bezpieczne, więc nie proponuje usunięcia oryginałów."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As cópias estão noutra app. O PhotoMaid não consegue ver se estão seguras aí, por isso não propõe remover os originais."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiile sunt la altă aplicație. PhotoMaid nu poate vedea dacă sunt în siguranță acolo, așa că nu propune eliminarea originalelor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копии находятся в другом приложении. PhotoMaid не видит, надёжно ли они там хранятся, поэтому не предлагает убрать оригиналы."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopyalar başka bir uygulamada. PhotoMaid orada güvende olup olmadıklarını göremez; bu yüzden orijinalleri kaldırmayı önermez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Копії зберігаються в іншому застосунку. PhotoMaid не бачить, чи вони там у безпеці, тому не пропонує прибрати оригінали."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "副本在另一个应用中。PhotoMaid 无法判断它们在那里是否安全，因此不会建议移除原件。"
          }
        }
      }
    },
