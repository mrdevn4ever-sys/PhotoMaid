    "months_intro": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مدى تقدمك في كل شهر. العناصر المؤجلة لوقت لاحق تُحسب كمراجعة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটি মাসে আপনি কতদূর এগিয়েছেন। পরের জন্য আলাদা রাখা আইটেম পর্যালোচিত হিসেবে গণ্য হয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fins on has arribat en cada mes. Els elements apartats per a més tard compten com a revisats."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak daleko jste v každém měsíci. Položky odložené na později se počítají jako prošlé."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor langt du er i hver måned. Emner, der er lagt til side til senere, tæller som gennemgået."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So weit bist du in jedem Monat. Was du auf später gelegt hast, zählt als durchgesehen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πόσο έχεις προχωρήσει σε κάθε μήνα. Τα στοιχεία που έβαλες για αργότερα μετράνε ως ελεγμένα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How far you are in each month. Items set aside for later count as reviewed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que llevas de cada mes. Lo dejado para después cuenta como revisado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuinka pitkällä olet kunkin kuukauden kanssa. Myöhemmäksi siirretyt lasketaan läpikäydyiksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Où tu en es pour chaque mois. Ce qui est remis à plus tard compte comme passé en revue."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "દરેક મહિનામાં તમે કેટલા આગળ છો. પછી માટે બાજુએ રાખેલી આઇટમ જોયેલી ગણાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כמה התקדמת בכל חודש. פריטים שהועברו הצידה למאוחר יותר נחשבים כנסקרו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर महीने में आप कितना आगे हैं। बाद के लिए अलग रखे आइटम देखे हुए गिने जाते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koliko si napredovao u svakom mjesecu. Stavke odložene za kasnije broje se kao pregledane."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hol tartasz az egyes hónapokban. A későbbre félretett elemek átnézettnek számítanak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sejauh mana kamu di setiap bulan. Item yang disisihkan untuk nanti dihitung sudah ditinjau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A che punto sei in ogni mese. Ciò che è rimandato conta come rivisto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各月の進み具合です。「あとで」にしたものは見直し済みとして数えます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪ್ರತಿ ತಿಂಗಳಲ್ಲಿ ನೀವು ಎಷ್ಟು ಮುಂದೆ ಸಾಗಿದ್ದೀರಿ. ನಂತರಕ್ಕೆ ಪಕ್ಕಕ್ಕಿಟ್ಟ ಐಟಂಗಳನ್ನು ಪರಿಶೀಲಿಸಿದವು ಎಂದು ಎಣಿಸಲಾಗುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "월별 진행 상황이에요. ‘나중에’로 미룬 항목은 확인한 것으로 세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഓരോ മാസത്തിലും നിങ്ങൾ എത്രത്തോളം എത്തി. പിന്നീടേക്ക് മാറ്റിവച്ച ഇനങ്ങൾ പരിശോധിച്ചതായി കണക്കാക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्येक महिन्यात तुम्ही किती पुढे आहात. नंतरसाठी बाजूला ठेवलेले आयटम पाहिलेले म्हणून मोजले जातात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sejauh mana anda dalam setiap bulan. Item yang diketepikan untuk nanti dikira sebagai disemak."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor langt du har kommet i hver måned. Elementer lagt til side til senere teller som gått gjennom."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zo ver ben je per maand. Wat voor later is bewaard, telt als bekeken."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପ୍ରତ୍ୟେକ ମାସରେ ଆପଣ କେତେ ଆଗେଇଛନ୍ତି। ପରେ ପାଇଁ ଅଲଗା ରଖାଯାଇଥିବା ଆଇଟମ୍ ସମୀକ୍ଷିତ ଭାବେ ଗଣାଯାଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹਰ ਮਹੀਨੇ ਵਿੱਚ ਤੁਸੀਂ ਕਿੱਥੋਂ ਤੱਕ ਪਹੁੰਚੇ ਹੋ। ਬਾਅਦ ਲਈ ਵੱਖ ਰੱਖੀਆਂ ਆਈਟਮਾਂ ਸਮੀਖਿਆ ਹੋਈਆਂ ਗਿਣੀਆਂ ਜਾਂਦੀਆਂ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Postęp w każdym miesiącu. Odłożone na później liczą się jako przejrzane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto você já avançou em cada mês. Itens deixados para depois contam como revisados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O teu progresso em cada mês. O que ficou para mais tarde conta como revisto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cât ai avansat în fiecare lună. Ce ai amânat contează ca revizuit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твой прогресс по месяцам. Отложенное на потом считается просмотренным."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako ďaleko ste v každom mesiaci. Položky odložené na neskôr sa počítajú ako prezreté."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kako daleč si v posameznem mesecu. Elementi, odloženi za pozneje, štejejo kot pregledani."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hur långt du har kommit i varje månad. Objekt som lagts undan till senare räknas som genomgångna."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒவ்வொரு மாதத்திலும் நீங்கள் எவ்வளவு முன்னேறியுள்ளீர்கள். பிறகுக்கு ஒதுக்கியவை பார்வையிடப்பட்டவையாகக் கணக்கிடப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రతి నెలలో మీరు ఎంత దూరం వచ్చారు. తర్వాతకు పక్కన పెట్టిన అంశాలు సమీక్షించినవిగా లెక్కించబడతాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความคืบหน้าของคุณในแต่ละเดือน รายการที่แยกไว้ทีหลังนับว่าตรวจดูแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her ayda ne kadar ilerlediğin. Sonraya bırakılanlar gözden geçirilmiş sayılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Твій прогрес за місяцями. Відкладене на потім вважається переглянутим."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر مہینے میں آپ کتنا آگے ہیں۔ بعد کے لیے الگ رکھے آئٹمز جائزہ شدہ گنے جاتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã đi được bao xa trong mỗi tháng. Các mục để sau được tính là đã xem lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个月的进度。设为稍后的内容计为已查看。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你在每個月份的進度。存為稍後的項目也算已整理。"
          }
        }
      }
    },
    "months_title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
