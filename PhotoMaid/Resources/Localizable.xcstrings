    "today_continue_sub": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تابع من حيث توقفت."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsæt, hvor du slap."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es geht dort weiter, wo du aufgehört hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick up where you left off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Continúa donde lo dejaste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reprends là où tu t’étais arrêté."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lanjutkan dari tempat terakhir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riprendi da dove avevi lasciato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回の続きから始められます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지난번에 멈춘 곳부터 이어서 해요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsett der du slapp."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ga verder waar je gebleven was."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wróć do miejsca, w którym skończyły się ostatnie porządki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue de onde parou."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua de onde ficaste."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuă de unde ai rămas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжай с того места, где закончился прошлый просмотр."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsätt där du slutade."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำต่อจากที่ค้างไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaldığın yerden devam et."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Продовжуй із того місця, де завершився попередній перегляд."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiếp tục từ chỗ bạn đã dừng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从上次停下的地方继续。"
