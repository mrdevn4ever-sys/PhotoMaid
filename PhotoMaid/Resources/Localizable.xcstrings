            "value": "Tüm galeri gözden geçirildi"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усю галерею переглянуто"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پوری لائبریری کا جائزہ مکمل"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã xem lại toàn bộ thư viện"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "整个媒体库已整理"
          }
        },
        "zh-Hant": {
