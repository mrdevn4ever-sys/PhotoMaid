    "export_expired": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنهى iOS التصدير في الخلفية. لم يُحفظ شيء – ابدأه من جديد وأبقِ GaleriQ مفتوحًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS afsluttede eksporten i baggrunden. Intet blev gemt – start igen, og hold GaleriQ åben."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS hat den Export im Hintergrund beendet. Es wurde nichts gespeichert – starte ihn erneut und lass GaleriQ geöffnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ended the export in the background. Nothing was saved – start it again and keep GaleriQ open."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ha detenido la exportación en segundo plano. No se ha guardado nada: vuelve a empezar y deja GaleriQ abierta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS a arrêté l’export en arrière-plan. Rien n’a été enregistré – relancez-le et laissez GaleriQ ouverte."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS menghentikan ekspor di latar belakang. Tidak ada yang disimpan – mulai lagi dan biarkan GaleriQ tetap terbuka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ha interrotto l’esportazione in background. Non è stato salvato nulla: riavviala e lascia GaleriQ aperta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOSがバックグラウンドで書き出しを終了しました。何も保存されていません。もう一度開始し、GaleriQを開いたままにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS가 백그라운드에서 내보내기를 종료했습니다. 아무것도 저장되지 않았습니다. 다시 시작하고 GaleriQ를 열어 두세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS avsluttet eksporten i bakgrunnen. Ingenting ble lagret – start på nytt og hold GaleriQ åpen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS heeft de export op de achtergrond beëindigd. Er is niets bewaard – start opnieuw en houd GaleriQ open."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS zakończył eksport w tle. Nic nie zapisano – uruchom go ponownie i nie zamykaj GaleriQ."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iOS encerrou a exportação em segundo plano. Nada foi salvo – comece de novo e mantenha o GaleriQ aberto."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O iOS terminou a exportação em segundo plano. Nada foi guardado – comece de novo e mantenha o GaleriQ aberto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS a oprit exportul în fundal. Nu s-a salvat nimic – pornește-l din nou și lasă GaleriQ deschisă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS прервал экспорт в фоне. Ничего не сохранено – запустите заново и не закрывайте GaleriQ."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS avslutade exporten i bakgrunden. Inget sparades – starta igen och håll GaleriQ öppen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS หยุดการส่งออกในเบื้องหลัง ไม่มีอะไรถูกบันทึก – เริ่มใหม่และเปิด GaleriQ ค้างไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS dışa aktarmayı arka planda sonlandırdı. Hiçbir şey kaydedilmedi; yeniden başlat ve GaleriQ’i açık tut."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS перервав експорт у фоні. Нічого не збережено – запустіть знову й не закривайте GaleriQ."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS đã dừng việc xuất trong nền. Không có gì được lưu – hãy bắt đầu lại và giữ GaleriQ mở."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 在后台结束了导出。未存储任何内容 – 请重新开始并保持 GaleriQ 打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 在背景結束了輸出。沒有儲存任何內容 – 請重新開始，並保持 GaleriQ 開啟。"
          }
        }
      }
    },
    "export_keep_open": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك الانتقال إلى تطبيق آخر لفترة قصيرة. إذا أنهى iOS الوقت، يتوقف GaleriQ بشكل سليم ولا يُحفظ شيء غير مكتمل."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan kort skifte til en anden app. Hvis iOS afslutter tiden, stopper GaleriQ pænt – intet halvfærdigt gemmes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst kurz in eine andere App wechseln. Beendet iOS die Zeit, bricht GaleriQ sauber ab – es wird nichts Halbes gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can briefly switch to another app. If iOS ends the time, GaleriQ stops cleanly – nothing half-finished is saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes cambiar un momento a otra app. Si iOS agota el tiempo, GaleriQ se detiene sin problemas y no se guarda nada a medias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez passer brièvement à une autre app. Si iOS met fin au délai, GaleriQ s’arrête proprement – rien d’inachevé n’est enregistré."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu bisa berpindah sebentar ke app lain. Jika iOS mengakhiri waktunya, GaleriQ berhenti dengan rapi – tidak ada yang setengah jadi disimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi passare per poco a un’altra app. Se iOS esaurisce il tempo, GaleriQ si ferma in modo pulito e non salva nulla a metà."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "少しの間ならほかのアプリに切り替えられます。iOSが時間を打ち切った場合、GaleriQは安全に中止し、途中までのものは保存しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠시 다른 앱으로 전환해도 됩니다. iOS가 시간을 종료하면 GaleriQ는 깔끔하게 중단하며 반쯤 된 결과는 저장하지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan kort bytte til en annen app. Hvis iOS avslutter tiden, stopper GaleriQ ryddig – ingenting halvferdig lagres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt even naar een andere app gaan. Beëindigt iOS de tijd, dan stopt GaleriQ netjes – er wordt niets half bewaard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz na chwilę przejść do innej aplikacji. Jeśli iOS zakończy czas, GaleriQ przerwie bezpiecznie – nic niedokończonego nie zostanie zapisane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode trocar rapidamente para outro app. Se o iOS encerrar o tempo, o GaleriQ para de forma limpa – nada pela metade é salvo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode mudar por pouco tempo para outra app. Se o iOS terminar o tempo, o GaleriQ para em segurança – nada incompleto é guardado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Poți trece scurt în altă aplicație. Dacă iOS încheie timpul, GaleriQ se oprește curat – nu se salvează nimic pe jumătate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно ненадолго переключиться на другое приложение. Если iOS прервёт время, GaleriQ аккуратно остановится – ничего недоделанного не сохранится."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan kort byta till en annan app. Om iOS avslutar tiden stoppar GaleriQ snyggt – inget halvfärdigt sparas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณสลับไปแอพอื่นได้สักครู่ หาก iOS หมดเวลา GaleriQ จะหยุดอย่างเรียบร้อย – ไม่มีอะไรที่ทำค้างไว้ถูกบันทึก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kısa süreliğine başka bir uygulamaya geçebilirsin. iOS süreyi sonlandırırsa GaleriQ düzgünce durur, yarım kalan hiçbir şey kaydedilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Можна ненадовго перейти до іншої програми. Якщо iOS завершить час, GaleriQ акуратно зупиниться – нічого незавершеного не збережеться."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể chuyển nhanh sang ứng dụng khác. Nếu iOS hết thời gian, GaleriQ dừng gọn gàng – không lưu gì dở dang."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以短暂切换到其他 App。如果 iOS 结束了时间，GaleriQ 会干净地停止，不会存储未完成的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以短暫切換到其他 App。如果 iOS 結束了時間，GaleriQ 會乾淨地停止 – 不會儲存未完成的內容。"
          }
        }
      }
    },
