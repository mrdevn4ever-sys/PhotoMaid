        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copier dans un dossier choisi et vérifier chaque copie"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પસંદ કરેલા ફોલ્ડરમાં કૉપિ કરો અને દરેક નકલ ચકાસો"
          }
        },
