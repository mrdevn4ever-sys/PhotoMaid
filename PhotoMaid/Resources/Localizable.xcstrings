    "memory_intro": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعثر على الصور المتطابقة. بلا مؤقت — عُد إلى صورك متى شئت."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Find matching pictures. No timer — return to your photos whenever you like."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finde gleiche Bilder. Ohne Zeitdruck — kehre jederzeit zu deinen Fotos zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find matching pictures. No timer — return to your photos whenever you like."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra las imágenes iguales. Sin límite de tiempo: vuelve a tus fotos cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retrouvez les images identiques. Sans chronomètre : revenez à vos photos quand vous voulez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Find matching pictures. No timer — return to your photos whenever you like."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trova le immagini uguali. Senza timer: torna alle tue foto quando vuoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ絵柄を見つけましょう。時間制限はありません。いつでも写真に戻れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 그림을 찾아보세요. 시간제한 없이 언제든 사진으로 돌아갈 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Find matching pictures. No timer — return to your photos whenever you like."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vind dezelfde afbeeldingen. Zonder tijdsdruk — ga terug naar je foto's wanneer je wilt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znajdź takie same obrazki. Bez presji czasu — wróć do zdjęć, kiedy chcesz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Find matching pictures. No timer — return to your photos whenever you like."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontre imagens iguais. Sem limite de tempo — volte às suas fotos quando quiser."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Găsește imaginile identice. Fără cronometru — revino la poze oricând dorești."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Находите одинаковые картинки. Без таймера — возвращайтесь к фото в любой момент."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Find matching pictures. No timer — return to your photos whenever you like."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Find matching pictures. No timer — return to your photos whenever you like."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı resimleri bul. Süre sınırı yok; istediğin zaman fotoğraflarına dön."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Знаходь однакові зображення. Без таймера — повертайся до фото будь-коли."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Find matching pictures. No timer — return to your photos whenever you like."
          }
        },
        "zh-Hans": {
          "stringUnit": {
