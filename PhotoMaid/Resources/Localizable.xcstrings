    "ana2_stage_storage": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر حفظ النتائج. تحقّق من المساحة المتاحة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফলাফল সংরক্ষণ করা যায়নি। খালি স্টোরেজ দেখুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s’han pogut desar els resultats. Comprova l’espai lliure."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Výsledky se nepodařilo uložit. Zkontrolujte volné místo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Resultaterne kunne ikke gemmes. Tjek ledig plads."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ergebnisse konnten nicht gespeichert werden. Prüfe den freien Speicher."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η αποθήκευση των αποτελεσμάτων. Έλεγξε τον ελεύθερο χώρο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Results could not be saved. Check free storage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han podido guardar los resultados. Comprueba el espacio libre."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuloksia ei voitu tallentaa. Tarkista vapaa tila."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer les résultats. Vérifie l’espace libre."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પરિણામો સાચવી શકાયાં નથી. ખાલી સ્ટોરેજ તપાસો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה לשמור את התוצאות. כדאי לבדוק את האחסון הפנוי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नतीजे सहेजे नहीं जा सके। खाली स्टोरेज जाँचें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezultate nije bilo moguće spremiti. Provjeri slobodnu pohranu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az eredmények nem menthetők. Ellenőrizd a szabad tárhelyet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasil tidak dapat disimpan. Periksa ruang kosong."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare i risultati. Controlla lo spazio libero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "結果を保存できませんでした。空き容量を確認してください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಫಲಿತಾಂಶಗಳನ್ನು ಉಳಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ. ಖಾಲಿ ಸಂಗ್ರಹಣೆಯನ್ನು ಪರಿಶೀಲಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결과를 저장할 수 없습니다. 여유 공간을 확인하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഫലങ്ങൾ സംരക്ഷിക്കാനായില്ല. ഒഴിവുള്ള സ്റ്റോറേജ് പരിശോധിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "निकाल जतन करता आले नाहीत. मोकळे स्टोरेज तपासा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Keputusan tidak dapat disimpan. Semak storan kosong."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Resultatene kunne ikke lagres. Sjekk ledig plass."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Resultaten konden niet worden bewaard. Controleer de vrije opslag."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଫଳାଫଳ ସେଭ୍ ହୋଇପାରିଲା ନାହିଁ। ଖାଲି ଷ୍ଟୋରେଜ୍ ଯାଞ୍ଚ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਨਤੀਜੇ ਸੰਭਾਲੇ ਨਹੀਂ ਜਾ ਸਕੇ। ਖਾਲੀ ਸਟੋਰੇਜ ਜਾਂਚੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zapisać wyników. Sprawdź wolne miejsce."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar os resultados. Verifique o espaço livre."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível guardar os resultados. Verifica o espaço livre."
