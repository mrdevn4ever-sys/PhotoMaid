    "vault2_discard_warning": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستبقى آخر نسخة محفوظة فقط. ستُفقد التغييرات غير المحفوظة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু শেষ সফলভাবে সংরক্ষিত সংস্করণটি থাকবে। অসংরক্ষিত পরিবর্তন হারিয়ে যাবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Només es conservarà l’última versió desada correctament. Els canvis no desats es perdran."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zůstane jen poslední úspěšně uložená verze. Neuložené změny budou ztraceny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun den senest gemte version bliver tilbage. Ændringer, der ikke er gemt, går tabt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur der zuletzt erfolgreich gespeicherte Stand bleibt erhalten. Die ungespeicherten Änderungen gehen verloren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θα μείνει μόνο η τελευταία επιτυχώς αποθηκευμένη έκδοση. Οι μη αποθηκευμένες αλλαγές θα χαθούν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the last successfully saved version will remain. Unsaved changes will be lost."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo quedará la última versión guardada. Se perderán los cambios sin guardar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain viimeisin onnistuneesti tallennettu versio jää jäljelle. Tallentamattomat muutokset menetetään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seule la dernière version enregistrée sera conservée. Les modifications non enregistrées seront perdues."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફક્ત છેલ્લું સફળતાથી સાચવેલું વર્ઝન રહેશે. ન સાચવેલા ફેરફારો ખોવાઈ જશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רק הגרסה האחרונה שנשמרה בהצלחה תישאר. שינויים שלא נשמרו יאבדו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिर्फ़ आखिरी सफलतापूर्वक सहेजा वर्शन रहेगा। बिना सहेजे बदलाव खो जाएँगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostat će samo posljednja uspješno spremljena verzija. Nespremljene promjene bit će izgubljene."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak az utolsó sikeresen mentett változat marad meg. A nem mentett módosítások elvesznek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya versi terakhir yang berhasil disimpan yang akan tersisa. Perubahan yang belum disimpan akan hilang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Resterà solo l’ultima versione salvata. Le modifiche non salvate andranno perse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最後に保存できた状態だけが残ります。未保存の変更は失われます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕೊನೆಯದಾಗಿ ಯಶಸ್ವಿಯಾಗಿ ಉಳಿಸಿದ ಆವೃತ್ತಿ ಮಾತ್ರ ಉಳಿಯುತ್ತದೆ. ಉಳಿಸದ ಬದಲಾವಣೆಗಳು ಕಳೆದುಹೋಗುತ್ತವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막으로 저장된 버전만 남습니다. 저장하지 않은 변경 사항은 사라집니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അവസാനമായി വിജയകരമായി സംരക്ഷിച്ച പതിപ്പ് മാത്രം നിലനിൽക്കും. സംരക്ഷിക്കാത്ത മാറ്റങ്ങൾ നഷ്ടമാകും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फक्त शेवटची यशस्वीपणे जतन केलेली आवृत्ती राहील. जतन न केलेले बदल गमावले जातील."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya versi terakhir yang berjaya disimpan akan kekal. Perubahan yang belum disimpan akan hilang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare den sist lagrede versjonen blir igjen. Endringer som ikke er lagret, går tapt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen de laatst opgeslagen versie blijft behouden. Niet-opgeslagen wijzigingen gaan verloren."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "କେବଳ ଶେଷ ସଫଳ ଭାବେ ସେଭ୍ ହୋଇଥିବା ସଂସ୍କରଣ ରହିବ। ସେଭ୍ ହୋଇନଥିବା ପରିବର୍ତ୍ତନ ହଜିଯିବ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਿਰਫ਼ ਆਖ਼ਰੀ ਵਾਰ ਸਫਲਤਾ ਨਾਲ ਸੰਭਾਲਿਆ ਰੂਪ ਰਹੇਗਾ। ਨਾ ਸੰਭਾਲੇ ਬਦਲਾਅ ਗੁੰਮ ਹੋ ਜਾਣਗੇ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozostanie tylko ostatnia zapisana wersja. Niezapisane zmiany zostaną utracone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só a última versão salva com sucesso permanecerá. As alterações não salvas serão perdidas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Só fica a última versão guardada. As alterações não guardadas serão perdidas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Va rămâne doar ultima versiune salvată. Modificările nesalvate se vor pierde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Останется только последняя сохранённая версия. Несохранённые изменения будут потеряны."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostane len posledná úspešne uložená verzia. Neuložené zmeny sa stratia."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostala bo le zadnja uspešno shranjena različica. Neshranjene spremembe bodo izgubljene."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara den senast sparade versionen blir kvar. Osparade ändringar går förlorade."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கடைசியாக வெற்றிகரமாகச் சேமித்த பதிப்பு மட்டுமே இருக்கும். சேமிக்காத மாற்றங்கள் இழக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చివరిగా విజయవంతంగా సేవ్ చేసిన వెర్షన్ మాత్రమే ఉంటుంది. సేవ్ చేయని మార్పులు పోతాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จะเหลือเฉพาะเวอร์ชันล่าสุดที่บันทึกสำเร็จ การเปลี่ยนแปลงที่ยังไม่บันทึกจะหายไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca son kaydedilen sürüm kalır. Kaydedilmemiş değişiklikler kaybolur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишиться лише остання збережена версія. Незбережені зміни буде втрачено."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف آخری کامیابی سے محفوظ ورژن رہے گا۔ غیر محفوظ تبدیلیاں ضائع ہو جائیں گی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ phiên bản đã lưu thành công gần nhất được giữ lại. Thay đổi chưa lưu sẽ mất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅保留最后成功保存的版本，未保存的更改将丢失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只會保留最後一次成功儲存的版本。未儲存的更改將會遺失。"
          }
        }
      }
    },
