    "collage_originals_safe": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى صورك الأصلية دون تغيير. يُنشأ ملف جديد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার মূল ফটো অপরিবর্তিত থাকে। একটি নতুন ফাইল তৈরি হয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fotos originals no canvien. Es crea un fitxer nou."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše původní fotky zůstanou beze změny. Vytvoří se nový soubor."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine originale fotos forbliver uændrede. Der oprettes en ny fil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Originalfotos bleiben unverändert. Es entsteht eine neue Datei."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι πρωτότυπες φωτογραφίες σου μένουν αμετάβλητες. Δημιουργείται νέο αρχείο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your original photos stay unchanged. A new file is created."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus fotos originales no cambian. Se crea un archivo nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Alkuperäiset kuvasi pysyvät ennallaan. Luodaan uusi tiedosto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos photos originales restent inchangées. Un nouveau fichier est créé."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારા મૂળ ફોટા બદલાતા નથી. નવી ફાઇલ બને છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התמונות המקוריות שלך לא משתנות. נוצר קובץ חדש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी मूल फ़ोटो नहीं बदलतीं। एक नई फ़ाइल बनती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje originalne fotografije ostaju nepromijenjene. Izrađuje se nova datoteka."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az eredeti fotóid változatlanok maradnak. Új fájl jön létre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto aslimu tidak berubah. File baru dibuat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le foto originali restano invariate. Viene creato un nuovo file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元の写真は変更されません。新しいファイルが作成されます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಮೂಲ ಫೋಟೋಗಳು ಬದಲಾಗದೆ ಉಳಿಯುತ್ತವೆ. ಹೊಸ ಫೈಲ್ ರಚನೆಯಾಗುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본 사진은 그대로 유지되고 새 파일이 만들어집니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ഒറിജിനൽ ഫോട്ടോകൾക്ക് മാറ്റമില്ല. ഒരു പുതിയ ഫയൽ സൃഷ്‌ടിക്കപ്പെടുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचे मूळ फोटो बदलत नाहीत. नवीन फाइल तयार होते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto asal anda kekal tidak berubah. Fail baharu dicipta."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Originalbildene dine forblir uendret. En ny fil opprettes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je originele foto’s blijven ongewijzigd. Er wordt een nieuw bestand gemaakt."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ ମୂଳ ଫଟୋ ଅପରିବର୍ତ୍ତିତ ରହେ। ଏକ ନୂଆ ଫାଇଲ୍ ତିଆରି ହୁଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੀਆਂ ਮੂਲ ਫ਼ੋਟੋਆਂ ਨਹੀਂ ਬਦਲਦੀਆਂ। ਇੱਕ ਨਵੀਂ ਫ਼ਾਈਲ ਬਣਦੀ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oryginalne zdjęcia pozostają bez zmian. Powstaje nowy plik."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas fotos originais não são alteradas. Um novo arquivo é criado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As fotografias originais ficam inalteradas. É criado um ficheiro novo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozele originale rămân neschimbate. Se creează un fișier nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оригиналы фото не меняются. Создаётся новый файл."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše pôvodné fotky zostanú nezmenené. Vytvorí sa nový súbor."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje izvirne fotografije ostanejo nespremenjene. Ustvari se nova datoteka."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina originalbilder ändras inte. En ny fil skapas."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் அசல் புகைப்படங்கள் மாறாமல் இருக்கும். புதிய கோப்பு உருவாக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ ఒరిజినల్ ఫోటోలు మారవు. కొత్త ఫైల్ సృష్టించబడుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปต้นฉบับของคุณไม่เปลี่ยนแปลง จะสร้างไฟล์ใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Orijinal fotoğrafların değişmez. Yeni bir dosya oluşturulur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оригінальні фото не змінюються. Створюється новий файл."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی اصل تصاویر تبدیل نہیں ہوتیں۔ ایک نئی فائل بنتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh gốc của bạn không thay đổi. Một tệp mới sẽ được tạo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原始照片保持不变，将创建一个新文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的原始照片不會更改。會建立新檔案。"
          }
        }
      }
    },
