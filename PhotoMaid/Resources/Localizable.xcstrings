    "tools_fmt_heic_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملفات أصغر، لكن لا تفتحها كل الأجهزة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ছোট ফাইল, তবে সব ডিভাইস খুলতে পারে না"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fitxers més petits, però no tots els dispositius els poden obrir"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Menší soubory, ale ne každé zařízení je otevře"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindre filer, men ikke alle enheder kan åbne dem"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleinere Dateien, aber nicht jedes Gerät kann sie öffnen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μικρότερα αρχεία, αλλά δεν τα ανοίγει κάθε συσκευή"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Smaller files, but not every device can open them"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivos más pequeños, pero no todos los dispositivos los abren"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pienemmät tiedostot, mutta kaikki laitteet eivät avaa niitä"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichiers plus légers, mais tous les appareils ne les ouvrent pas"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "નાની ફાઇલો, પણ દરેક ઉપકરણ તેમને ખોલી શકતું નથી"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קבצים קטנים יותר, אבל לא כל מכשיר יכול לפתוח אותם"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "छोटी फ़ाइलें, लेकिन हर डिवाइस इन्हें नहीं खोल सकता"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Manje datoteke, ali ih ne može otvoriti svaki uređaj"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kisebb fájlok, de nem minden eszköz nyitja meg őket"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File lebih kecil, tapi tidak semua perangkat bisa membukanya"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "File più piccoli, ma non tutti i dispositivi li aprono"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルは小さいですが、開けない機器もあります"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಚಿಕ್ಕ ಫೈಲ್‌ಗಳು, ಆದರೆ ಎಲ್ಲಾ ಸಾಧನಗಳು ತೆರೆಯಲಾರವು"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일이 작지만 일부 기기에서는 열리지 않아요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ചെറിയ ഫയലുകൾ, പക്ഷേ എല്ലാ ഉപകരണങ്ങൾക്കും തുറക്കാനാകില്ല"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "लहान फाइल्स, पण प्रत्येक डिव्हाइस त्या उघडू शकत नाही"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Fail lebih kecil, tetapi tidak semua peranti boleh membukanya"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindre filer, men ikke alle enheter kan åpne dem"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleinere bestanden, maar niet elk apparaat opent ze"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଛୋଟ ଫାଇଲ୍, କିନ୍ତୁ ସବୁ ଡିଭାଇସ୍ ଖୋଲିପାରେ ନାହିଁ"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਛੋਟੀਆਂ ਫ਼ਾਈਲਾਂ, ਪਰ ਹਰ ਡਿਵਾਈਸ ਇਨ੍ਹਾਂ ਨੂੰ ਨਹੀਂ ਖੋਲ੍ਹ ਸਕਦਾ"
          }
        },
        "pl": {
          "stringUnit": {
