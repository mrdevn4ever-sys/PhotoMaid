    "vault_settings_row_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مكان مخفي ومحمي برمز للصور ومقاطع الفيديو. تختفي من تطبيق الصور."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফটো ও ভিডিওর জন্য লুকানো, কোড-সুরক্ষিত জায়গা। এগুলো ফটো অ্যাপ থেকে উধাও হয়ে যায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Lloc amagat i protegit amb codi per a fotos i vídeos. Desapareixen de l’app Fotos."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Skryté, kódem chráněné místo pro fotky a videa. Zmizí z aplikace Fotky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjult, kodebeskyttet sted til fotos og videoer. De forsvinder fra appen Fotos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versteckter, mit Code geschützter Ort für Fotos und Videos. Sie verschwinden aus der Fotos-App."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κρυφό σημείο με κωδικό για φωτογραφίες και βίντεο. Εξαφανίζονται από την εφαρμογή Φωτογραφίες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidden, code-protected place for photos and videos. They disappear from the Photos app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lugar oculto y protegido con código para fotos y vídeos. Desaparecen de la app Fotos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Piilotettu, koodilla suojattu paikka kuville ja videoille. Ne katoavat Kuvat-apista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Endroit caché et protégé par code pour les photos et vidéos. Elles disparaissent de l’app Photos."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફોટા અને વીડિયો માટે છુપાયેલી, કોડથી સુરક્ષિત જગ્યા. તે ફોટો ઍપમાંથી ગાયબ થાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מקום מוסתר ומוגן בקוד לתמונות ולסרטונים. הם נעלמים מהיישום ״תמונות״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोटो और वीडियो के लिए छिपी, कोड से सुरक्षित जगह। ये तस्वीरें ऐप से गायब हो जाते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriveno mjesto zaštićeno kôdom za fotografije i videozapise. Nestaju iz aplikacije Fotografije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejtett, kóddal védett hely fotóknak és videóknak. Eltűnnek a Fotók appból."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempat tersembunyi yang dilindungi kode untuk foto dan video. Semuanya hilang dari app Foto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spazio nascosto e protetto da codice per foto e video. Spariscono dall’app Foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真とビデオのための、コードで保護された隠し場所です。写真アプリからは消えます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಫೋಟೋಗಳು ಮತ್ತು ವೀಡಿಯೊಗಳಿಗಾಗಿ ಮರೆಮಾಡಿದ, ಕೋಡ್-ರಕ್ಷಿತ ಸ್ಥಳ. ಅವು ಫೋಟೋಗಳು ಆ್ಯಪ್‌ನಿಂದ ಮಾಯವಾಗುತ್ತವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진과 비디오를 위한, 암호로 보호된 숨겨진 공간입니다. 사진 앱에서는 사라집니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഫോട്ടോകൾക്കും വീഡിയോകൾക്കുമായി മറഞ്ഞിരിക്കുന്ന, കോഡ് സംരക്ഷിത ഇടം. അവ ഫോട്ടോസ് ആപ്പിൽ നിന്ന് അപ്രത്യക്ഷമാകും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फोटो आणि व्हिडिओसाठी लपलेली, कोडने संरक्षित जागा. ते फोटो अ‍ॅपमधून नाहीसे होतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempat tersembunyi yang dilindungi kod untuk foto dan video. Ia hilang daripada app Foto."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjult, kodebeskyttet sted for bilder og videoer. De forsvinner fra Bilder-appen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verborgen, met een code beveiligde plek voor foto’s en video’s. Ze verdwijnen uit de Foto’s-app."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଫଟୋ ଓ ଭିଡିଓ ପାଇଁ ଲୁଚା, କୋଡ୍-ସୁରକ୍ଷିତ ସ୍ଥାନ। ସେଗୁଡ଼ିକ ଫଟୋ ଆପ୍‌ରୁ ଅଦୃଶ୍ୟ ହୋଇଯାଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਫ਼ੋਟੋਆਂ ਅਤੇ ਵੀਡੀਓ ਲਈ ਲੁਕੀ, ਕੋਡ ਨਾਲ ਸੁਰੱਖਿਅਤ ਥਾਂ। ਇਹ ਫ਼ੋਟੋਆਂ ਐਪ ਤੋਂ ਗ਼ਾਇਬ ਹੋ ਜਾਂਦੀਆਂ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukryte, chronione kodem miejsce na zdjęcia i filmy. Znikają z aplikacji Zdjęcia."
