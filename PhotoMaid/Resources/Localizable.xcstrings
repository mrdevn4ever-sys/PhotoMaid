        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld개는 크기를 알 수 없어 합계에서 제외했습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld വലുപ്പങ്ങൾ അജ്ഞാതം – ആകെയിൽ ഉൾപ്പെടുന്നില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld आकार अज्ञात – एकूणमध्ये समाविष्ट नाहीत."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld saiz tidak diketahui – tidak termasuk dalam jumlah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld størrelser ukjente – ikke med i summen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij %1$lld bestanden is de grootte onbekend – niet meegeteld."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lldଟିର ଆକାର ଅଜଣା – ମୋଟରେ ଅନ୍ତର୍ଭୁକ୍ତ ନୁହେଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld ਆਕਾਰ ਅਗਿਆਤ – ਕੁੱਲ ਵਿੱਚ ਸ਼ਾਮਲ ਨਹੀਂ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieznany rozmiar %1$lld pliku – nie wliczono."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld tamanhos desconhecidos – não incluídos no total."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld tamanhos desconhecidos – não incluídos no total."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimensiune necunoscută pentru %1$lld de fișiere – neinclusă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Размер %1$lld файла неизвестен – не учтён."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld veľkostí neznámych – nie sú zahrnuté v súčte."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld velikosti neznanih – niso vključene v seštevek."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld storlekar okända – inte med i summan."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld அளவுகள் தெரியவில்லை – மொத்தத்தில் சேர்க்கப்படவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld పరిమాణాలు తెలియవు – మొత్తంలో చేర్చలేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ทราบขนาด %1$lld รายการ – ไม่รวมในยอดรวม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld dosyanın boyutu bilinmiyor; toplama katılmadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розмір %1$lld файлу невідомий – не враховано."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld سائز نامعلوم – کل میں شامل نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld kích thước không rõ – không tính vào tổng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 个文件大小未知，未计入总数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 項大小未知 – 未計入總數。"
          }
        }
      }
    },
