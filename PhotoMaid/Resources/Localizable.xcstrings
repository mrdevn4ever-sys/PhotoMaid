    "pro_f5d": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احفظ فلاترك، مثل «فيديوهات أكبر من 500 ميغابايت». ضغطة واحدة تعرض المحتوى المطابق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichere eigene Filter, zum Beispiel „Videos größer als 500 MB“. Ein Tipp öffnet die passenden Inhalte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save your own filters, such as “Videos larger than 500 MB”. One tap opens matching content."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda tus filtros, como «Vídeos de más de 500 MB». Un toque abre el contenido que coincida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre tes filtres, par exemple « Vidéos de plus de 500 Mo ». Un toucher ouvre le contenu correspondant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva i tuoi filtri, come «Video oltre 500 MB». Un tocco apre i contenuti corrispondenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「500 MBより大きい動画」など、自分の条件を保存できます。ワンタップで該当するものを開けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘500 MB보다 큰 동영상’처럼 나만의 필터를 저장하세요. 한 번 누르면 조건에 맞는 항목이 열려요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sla je eigen filters op, zoals ‘Video’s groter dan 500 MB’. Eén tik opent de passende inhoud."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisuj własne filtry, np. „Filmy powyżej 500 MB”. Jedno dotknięcie otwiera pasujące treści."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda os teus filtros, como «Vídeos com mais de 500 MB». Um toque abre o conteúdo correspondente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvează filtre proprii, de exemplu „Videoclipuri mai mari de 500 MB”. O atingere deschide conținutul potrivit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняй свои фильтры, например «Видео больше 500 МБ». Одно нажатие открывает подходящее содержимое."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“500 MB’tan büyük videolar” gibi kendi filtrelerini kaydet. Tek dokunuşla eşleşen içerikleri aç."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберігай власні фільтри, наприклад «Відео понад 500 МБ». Один дотик відкриває відповідний вміст."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存自己的筛选条件，例如“大于 500 MB 的视频”。轻点即可查看符合条件的内容。"
          }
        }
      }
    },
