    "tour_studio_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عدّل الصور، واصنع صورًا مجمّعة وأفلامًا قصيرة وملفات PDF، واستخدم أدوات مفيدة. تحصل دائمًا على ملفات جديدة – وتبقى الأصول كما هي."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফটো সম্পাদনা করুন, কোলাজ, ছোট ফিল্ম ও PDF তৈরি করুন এবং কাজের টুল ব্যবহার করুন। আপনি সবসময় নতুন ফাইল পান – আপনার মূল ফাইল যেমন আছে তেমনই থাকে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Edita fotos, fes collages, pel·lícules curtes i PDF, i fes servir eines pràctiques. Sempre obtens fitxers nous: els originals es queden com són."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Upravujte fotky, tvořte koláže, krátké filmy a PDF a používejte praktické nástroje. Vždy vzniknou nové soubory – originály zůstanou beze změny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Rediger fotos, lav collager, kortfilm og PDF'er, og brug praktiske værktøjer. Du får altid nye filer – dine originaler forbliver, som de er."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos bearbeiten, Collagen, kleine Filme, PDFs und praktische Werkzeuge. Dabei entstehen immer neue Dateien – deine Originale bleiben, wie sie sind."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επεξεργάσου φωτογραφίες, φτιάξε κολάζ, μικρές ταινίες και PDF και χρησιμοποίησε χρήσιμα εργαλεία. Παίρνεις πάντα νέα αρχεία – τα πρωτότυπα μένουν όπως είναι."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit photos, make collages, short films and PDFs, and use handy tools. You always get new files – your originals stay as they are."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Edita fotos, crea collages, películas cortas y PDF, y usa herramientas prácticas. Siempre se crean archivos nuevos: tus originales no cambian."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muokkaa kuvia, tee kollaaseja, lyhytelokuvia ja PDF:iä ja käytä käteviä työkaluja. Saat aina uusia tiedostoja – alkuperäiset pysyvät ennallaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retouchez vos photos, créez des collages, de petits films et des PDF, et utilisez des outils pratiques. De nouveaux fichiers sont toujours créés – vos originaux restent intacts."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફોટામાં ફેરફાર કરો, કોલાજ, ટૂંકી ફિલ્મો અને PDF બનાવો, અને ઉપયોગી સાધનો વાપરો. તમને હંમેશાં નવી ફાઇલો મળે છે – મૂળ જેમ છે તેમ રહે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לערוך תמונות, ליצור קולאז׳ים, סרטים קצרים וקובצי PDF ולהשתמש בכלים שימושיים. תמיד מקבלים קבצים חדשים – המקוריים נשארים כמו שהם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोटो एडिट करें, कोलाज, छोटी फ़िल्में और PDF बनाएँ, और काम के टूल इस्तेमाल करें। आपको हमेशा नई फ़ाइलें मिलती हैं – मूल जैसे हैं वैसे रहते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uređuj fotografije, izrađuj kolaže, kratke filmove i PDF-ove te koristi praktične alate. Uvijek dobivaš nove datoteke – originali ostaju kakvi jesu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szerkessz fotókat, készíts kollázsokat, rövidfilmeket és PDF-eket, és használj praktikus eszközöket. Mindig új fájlokat kapsz – az eredetik változatlanok maradnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit foto, buat kolase, film pendek, dan PDF, dan pakai alat praktis. Kamu selalu mendapat file baru – aslimu tetap seperti semula."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifica le foto, crea collage, brevi filmati e PDF e usa strumenti pratici. Nascono sempre nuovi file: gli originali restano come sono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真の編集、コラージュ、短いムービー、PDF、便利なツール。いつも新しいファイルが作られ、元の写真はそのままです。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಫೋಟೋಗಳನ್ನು ಎಡಿಟ್ ಮಾಡಿ, ಕೊಲಾಜ್‌ಗಳು, ಕಿರುಚಿತ್ರಗಳು ಮತ್ತು PDF ಗಳನ್ನು ಮಾಡಿ, ಮತ್ತು ಉಪಯುಕ್ತ ಉಪಕರಣಗಳನ್ನು ಬಳಸಿ. ನಿಮಗೆ ಯಾವಾಗಲೂ ಹೊಸ ಫೈಲ್‌ಗಳು ಸಿಗುತ್ತವೆ – ನಿಮ್ಮ ಮೂಲಗಳು ಹಾಗೆಯೇ ಉಳಿಯುತ್ತವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 편집, 콜라주, 짧은 영상, PDF, 편리한 도구까지. 항상 새 파일이 만들어지고 원본은 그대로예요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഫോട്ടോകൾ എഡിറ്റ് ചെയ്യുക, കൊളാഷുകൾ, ഹ്രസ്വ ചിത്രങ്ങൾ, PDF-കൾ എന്നിവ ഉണ്ടാക്കുക, ഉപയോഗപ്രദമായ ടൂളുകൾ ഉപയോഗിക്കുക. നിങ്ങൾക്ക് എപ്പോഴും പുതിയ ഫയലുകൾ ലഭിക്കും – നിങ്ങളുടെ ഒറിജിനലുകൾ അതുപോലെ തുടരും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फोटो संपादित करा, कोलाज, छोटे चित्रपट आणि PDF बनवा, आणि उपयुक्त साधने वापरा. तुम्हाला नेहमी नवीन फाइल्स मिळतात – मूळ जशीच्या तशी राहतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunting foto, buat kolaj, filem pendek dan PDF, dan gunakan alat yang berguna. Anda sentiasa mendapat fail baharu – fail asal kekal seperti sedia ada."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rediger bilder, lag collager, kortfilmer og PDF-er, og bruk nyttige verktøy. Du får alltid nye filer – originalene dine forblir som de er."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto’s bewerken, collages, korte films, pdf’s en handige hulpmiddelen. Er komen altijd nieuwe bestanden bij – je originelen blijven zoals ze zijn."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଫଟୋ ଏଡିଟ୍ କରନ୍ତୁ, କୋଲାଜ୍, ଛୋଟ ଫିଲ୍ମ ଓ PDF ତିଆରି କରନ୍ତୁ, ଏବଂ ଉପଯୋଗୀ ଟୁଲ୍ ବ୍ୟବହାର କରନ୍ତୁ। ଆପଣ ସବୁବେଳେ ନୂଆ ଫାଇଲ୍ ପାଆନ୍ତି – ଆପଣଙ୍କ ମୂଳ ଫାଇଲ୍ ଯେମିତି ଅଛି ସେମିତି ରହେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਫ਼ੋਟੋਆਂ ਸੋਧੋ, ਕੋਲਾਜ, ਛੋਟੀਆਂ ਫ਼ਿਲਮਾਂ ਅਤੇ PDF ਬਣਾਓ, ਅਤੇ ਕੰਮ ਦੇ ਟੂਲ ਵਰਤੋ। ਤੁਹਾਨੂੰ ਹਮੇਸ਼ਾ ਨਵੀਆਂ ਫ਼ਾਈਲਾਂ ਮਿਲਦੀਆਂ ਹਨ – ਤੁਹਾਡੇ ਮੂਲ ਜਿਵੇਂ ਹਨ ਉਵੇਂ ਹੀ ਰਹਿੰਦੇ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Edytuj zdjęcia, twórz kolaże, krótkie filmy i pliki PDF, korzystaj z przydatnych narzędzi. Zawsze powstają nowe pliki – oryginały zostają bez zmian."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Edite fotos, faça colagens, filmes curtos e PDFs e use ferramentas práticas. Você sempre recebe arquivos novos – seus originais ficam como estão."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Edite fotos, crie colagens, pequenos filmes e PDF e use ferramentas práticas. São sempre criados ficheiros novos – os originais ficam como estão."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Editează fotografii, fă colaje, filmulețe și PDF-uri și folosește unelte practice. Se creează mereu fișiere noi – originalele rămân neschimbate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Редактируйте фото, делайте коллажи, короткие фильмы и PDF, пользуйтесь удобными инструментами. Всегда создаются новые файлы – оригиналы остаются как есть."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Upravujte fotky, tvorte koláže, krátke filmy a PDF a používajte praktické nástroje. Vždy vzniknú nové súbory – originály zostanú bez zmeny."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Urejaj fotografije, ustvarjaj kolaže, kratke filme in PDF-je ter uporabljaj priročna orodja. Vedno dobiš nove datoteke – izvirniki ostanejo, kakršni so."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Redigera bilder, gör collage, kortfilmer och PDF:er och använd smarta verktyg. Du får alltid nya filer – dina original förblir som de är."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "புகைப்படங்களைத் திருத்துங்கள், கொலாஜ்கள், சிறு படங்கள், PDF-களை உருவாக்குங்கள், பயனுள்ள கருவிகளைப் பயன்படுத்துங்கள். நீங்கள் எப்போதும் புதிய கோப்புகளைப் பெறுவீர்கள் – உங்கள் அசல்கள் அப்படியே இருக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫోటోలను ఎడిట్ చేయండి, కొలాజ్‌లు, చిన్న ఫిల్మ్‌లు, PDFలు తయారు చేయండి, ఉపయోగకరమైన టూల్స్ వాడండి. మీకు ఎప్పుడూ కొత్త ఫైళ్లు వస్తాయి – మీ ఒరిజినల్‌లు అలాగే ఉంటాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แก้ไขรูป ทำภาพตัดปะ หนังสั้น และ PDF พร้อมเครื่องมือที่มีประโยชน์ คุณจะได้ไฟล์ใหม่เสมอ – ต้นฉบับยังคงเหมือนเดิม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğrafları düzenle, kolaj, kısa film ve PDF yap, pratik araçları kullan. Her zaman yeni dosyalar oluşur – orijinallerin olduğu gibi kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Редагуйте фото, створюйте колажі, короткі фільми й PDF, користуйтеся зручними інструментами. Завжди створюються нові файли – оригінали лишаються як є."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تصاویر میں ترمیم کریں، کولاج، مختصر فلمیں اور PDF بنائیں، اور کارآمد ٹولز استعمال کریں۔ آپ کو ہمیشہ نئی فائلیں ملتی ہیں – اصل جوں کے توں رہتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sửa ảnh, làm ảnh ghép, phim ngắn và PDF, cùng các công cụ tiện dụng. Bạn luôn nhận được tệp mới – bản gốc giữ nguyên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑照片，制作拼图、小影片和 PDF，并使用实用工具。始终生成新文件——原始照片保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "編輯照片，製作拼貼、短片和 PDF，還有實用的工具。你永遠會得到新檔案 – 原始檔保持原樣。"
          }
        }
      }
    },
