    "help_delete_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يؤدي السحب إلى حذف أي شيء. تنتقل العناصر أولاً إلى سلة GaleriQ، وبعد تأكيدك ينقلها iOS إلى «المحذوفة مؤخراً»."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সোয়াইপ করলে কখনো কিছু মুছে যায় না। আইটেম আগে GaleriQ-এর ট্র্যাশে যায়। সেখানে আপনি নিশ্চিত করার পরেই iOS ফটো ও ভিডিও “সম্প্রতি মুছে ফেলা”-তে সরায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Lliscar mai no esborra res. Primer els elements van a la paperera de GaleriQ. Només quan ho confirmes allà, l’iOS mou les fotos i els vídeos a Eliminat recentment."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přejetí nikdy nic nemaže. Položky nejdřív jdou do koše GaleriQ. Teprve když to tam potvrdíte, iOS přesune fotky a videa do Nedávno smazaných."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipes sletter aldrig noget. Emner havner først i GaleriQ-papirkurven. Først når du bekræfter der, flytter iOS fotos og videoer til Senest slettet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Wischen wird nie etwas gelöscht. Medien landen zuerst im GaleriQ-Papierkorb. Erst nach deiner Bestätigung verschiebt iOS Fotos und Videos in ‚Zuletzt gelöscht‘."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το σάρωμα δεν διαγράφει ποτέ τίποτα. Τα στοιχεία πάνε πρώτα στον κάδο του GaleriQ. Μόνο όταν επιβεβαιώσεις εκεί, το iOS μετακινεί φωτογραφίες και βίντεο στα Πρόσφατα διαγραμμένα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swiping never deletes anything. Items first enter GaleriQ’s trash. Only after you confirm there does iOS move photos and videos to Recently Deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslizar nunca elimina nada. Los elementos van primero a la papelera de GaleriQ; tras confirmarlo, iOS los mueve a Eliminado recientemente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pyyhkäisy ei koskaan poista mitään. Kohteet menevät ensin GaleriQ-roskakoriin. Vasta kun vahvistat siellä, iOS siirtää kuvat ja videot kansioon Äskettäin poistetut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un balayage ne supprime rien. Les éléments vont d’abord dans la corbeille GaleriQ ; après confirmation, iOS les place dans Suppressions récentes."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સ્વાઇપ કરવાથી ક્યારેય કંઈ ડિલીટ થતું નથી. આઇટમ પહેલાં GaleriQ ટ્રેશમાં જાય છે. ત્યાં તમારી પુષ્ટિ પછી જ iOS ફોટા અને વીડિયોને તાજેતરમાં ડિલીટ કરેલમાં ખસેડે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החלקה אף פעם לא מוחקת דבר. הפריטים עוברים קודם לפח של GaleriQ. רק אחרי אישור שם, iOS מעבירה תמונות וסרטונים אל „נמחקו לאחרונה”."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्वाइप करने से कभी कुछ डिलीट नहीं होता। आइटम पहले GaleriQ ट्रैश में जाते हैं। वहाँ आपकी पुष्टि के बाद ही iOS फ़ोटो और वीडियो को हाल ही में डिलीट किए गए में ले जाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Povlačenje nikad ništa ne briše. Stavke najprije idu u GaleriQ smeće. Tek kad ondje potvrdiš, iOS premješta fotografije i videozapise u Nedavno izbrisano."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A húzás soha semmit nem töröl. Az elemek először a GaleriQ kukájába kerülnek. Csak ha ott megerősíted, akkor helyezi át az iOS a fotókat és videókat a Nemrég törölt albumba."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menggeser tidak pernah menghapus apa pun. Item masuk dulu ke sampah GaleriQ. Baru setelah kamu konfirmasi di sana, iOS memindahkan foto dan video ke Baru Dihapus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo scorrimento non elimina nulla. Gli elementi vanno prima nel cestino GaleriQ; dopo la conferma iOS li sposta in Eliminati di recente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スワイプだけでは削除されません。まずGaleriQのゴミ箱に入り、確認後にiOSの「最近削除した項目」へ移動します。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ವೈಪ್ ಮಾಡುವುದರಿಂದ ಎಂದಿಗೂ ಏನೂ ಅಳಿಸಲಾಗುವುದಿಲ್ಲ. ಐಟಂಗಳು ಮೊದಲು GaleriQ ಕಸದ ಬುಟ್ಟಿಗೆ ಹೋಗುತ್ತವೆ. ಅಲ್ಲಿ ನೀವು ದೃಢೀಕರಿಸಿದ ನಂತರವೇ iOS ಫೋಟೋಗಳು ಮತ್ತು ವೀಡಿಯೊಗಳನ್ನು “ಇತ್ತೀಚೆಗೆ ಅಳಿಸಲಾಗಿದೆ” ಗೆ ಸರಿಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쓸어 넘기기만으로 삭제되지 않습니다. 먼저 GaleriQ 휴지통에 들어가며 확인 후 iOS의 최근 삭제된 항목으로 이동합니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്വൈപ്പ് ചെയ്യുന്നത് ഒരിക്കലും ഒന്നും ഇല്ലാതാക്കില്ല. ഇനങ്ങൾ ആദ്യം GaleriQ ട്രാഷിലേക്ക് പോകും. അവിടെ നിങ്ങൾ സ്ഥിരീകരിച്ച ശേഷം മാത്രമേ iOS ഫോട്ടോകളും വീഡിയോകളും “അടുത്തിടെ ഇല്ലാതാക്കിയവ”-ലേക്ക് നീക്കൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "स्वाइपने कधीच काहीही डिलीट होत नाही. आयटम आधी GaleriQ ट्रॅशमध्ये जातात. तिथे तुम्ही पुष्टी केल्यानंतरच iOS फोटो आणि व्हिडिओ अलीकडे डिलीट केलेले मध्ये हलवते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Meleret tidak pernah memadam apa-apa. Item masuk ke sampah GaleriQ dahulu. Hanya selepas anda mengesahkan di sana, iOS mengalihkan foto dan video ke Dipadam Baru-baru Ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sveiping sletter aldri noe. Elementer havner først i GaleriQ-papirkurven. Først når du bekrefter der, flytter iOS bilder og videoer til Nylig slettet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vegen verwijdert niets. Items gaan eerst naar de GaleriQ-prullenbak; na bevestiging verplaatst iOS ze naar Recent verwijderd."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସ୍ୱାଇପ୍ କଲେ କେବେ କିଛି ଡିଲିଟ୍ ହୁଏ ନାହିଁ। ଆଇଟମ୍ ପ୍ରଥମେ GaleriQ ଟ୍ରାସକୁ ଯାଏ। ସେଠାରେ ଆପଣ ନିଶ୍ଚିତ କରିବା ପରେ ହିଁ iOS ଫଟୋ ଓ ଭିଡିଓକୁ “ନିକଟରେ ଡିଲିଟ୍ ହୋଇଥିବା”କୁ ଘୁଞ୍ଚାଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਵਾਈਪ ਕਰਨ ਨਾਲ ਕਦੇ ਕੁਝ ਨਹੀਂ ਮਿਟਦਾ। ਆਈਟਮਾਂ ਪਹਿਲਾਂ GaleriQ ਦੀ ਰੱਦੀ ਵਿੱਚ ਜਾਂਦੀਆਂ ਹਨ। ਉੱਥੇ ਤੁਹਾਡੀ ਪੁਸ਼ਟੀ ਤੋਂ ਬਾਅਦ ਹੀ iOS ਫ਼ੋਟੋਆਂ ਅਤੇ ਵੀਡੀਓ ਨੂੰ “ਹਾਲ ਹੀ ਵਿੱਚ ਮਿਟਾਏ ਗਏ” ਵਿੱਚ ਭੇਜਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesunięcie niczego nie usuwa. Elementy trafiają najpierw do kosza GaleriQ; po potwierdzeniu iOS przenosi je do Ostatnio usuniętych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslizar nunca apaga nada. Os itens vão primeiro para a lixeira do GaleriQ. Só depois que você confirmar lá o iOS move fotos e vídeos para Apagados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslizar não elimina nada. Os itens vão primeiro para o lixo do GaleriQ; após confirmar, o iOS move-os para Apagados recentemente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Glisarea nu șterge nimic. Elementele ajung întâi în coșul GaleriQ; după confirmare, iOS le mută în Șterse recent."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смахивание ничего не удаляет. Объекты сначала попадают в корзину GaleriQ; после подтверждения iOS перемещает их в «Недавно удалённые»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Potiahnutie nikdy nič nemaže. Položky najprv idú do koša GaleriQ. Až keď to tam potvrdíte, iOS presunie fotky a videá do Nedávno vymazaných."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podrsanje nikoli ničesar ne izbriše. Elementi najprej gredo v koš GaleriQ. Šele ko tam potrdiš, iOS premakne fotografije in videoposnetke v Nedavno izbrisano."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att svepa raderar aldrig något. Objekten hamnar först i GaleriQ-papperskorgen. Först när du bekräftar där flyttar iOS bilder och videor till Nyligen raderade."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஸ்வைப் செய்வதால் ஒருபோதும் எதுவும் நீக்கப்படாது. உருப்படிகள் முதலில் GaleriQ குப்பைக்குச் செல்லும். அங்கே நீங்கள் உறுதிப்படுத்திய பின்னரே iOS புகைப்படங்களையும் வீடியோக்களையும் “சமீபத்தில் நீக்கியவை”-க்கு நகர்த்தும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "స్వైప్ చేయడం వల్ల ఎప్పుడూ ఏదీ తొలగించబడదు. అంశాలు ముందుగా GaleriQ ట్రాష్‌కి వెళ్తాయి. అక్కడ మీరు నిర్ధారించిన తర్వాతే iOS ఫోటోలు, వీడియోలను “ఇటీవల తొలగించినవి”కి తరలిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การปัดไม่เคยลบอะไร รายการจะเข้าถังขยะของ GaleriQ ก่อน หลังจากคุณยืนยันที่นั่นแล้วเท่านั้น iOS จึงย้ายรูปภาพและวิดีโอไปที่ “ที่ลบล่าสุด”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydırma hiçbir şeyi silmez. Öğeler önce GaleriQ çöpüne gider; onaydan sonra iOS onları Son Silinenler’e taşır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гортання нічого не видаляє. Об’єкти спочатку потрапляють у кошик GaleriQ; після підтвердження iOS переміщує їх у «Недавно видалені»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سوائپ کرنے سے کبھی کچھ حذف نہیں ہوتا۔ آئٹمز پہلے GaleriQ ردی میں جاتے ہیں۔ وہاں آپ کی تصدیق کے بعد ہی iOS تصاویر اور ویڈیوز کو حال ہی میں حذف کردہ میں لے جاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuốt không bao giờ xóa gì cả. Các mục vào thùng rác GaleriQ trước. Chỉ sau khi bạn xác nhận ở đó, iOS mới chuyển ảnh và video vào Đã xóa gần đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻扫不会删除任何内容。项目会先进入 GaleriQ 废纸篓，确认后 iOS 才会将其移到“最近删除”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "滑動永遠不會刪除任何內容。項目會先進入 GaleriQ 垃圾桶。只有在你在那裡確認後，iOS 才會將照片和影片移到「最近刪除」。"
          }
        }
      }
    },
