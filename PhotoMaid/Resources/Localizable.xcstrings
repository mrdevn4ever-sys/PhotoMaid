    "offer_pro_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بلا إعلانات ولا حد يومي. بالإضافة إلى مقارنة سلاسل الصور والبحث عن النسخ المتطابقة ومجموعاتك الخاصة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No ads or daily limit. Plus photo series comparison, identical-copy search and custom collections."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Werbung und Tageslimit. Dazu Fotoserien vergleichen, identische Kopien finden und eigene Sammlungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No ads or daily limit. Plus photo series comparison, identical-copy search and custom collections."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin anuncios ni límite diario. Además, comparar series de fotos, buscar copias idénticas y tus propias colecciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans pub ni limite quotidienne. Avec la comparaison de séries de photos, la recherche de copies identiques et les collections personnalisées."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No ads or daily limit. Plus photo series comparison, identical-copy search and custom collections."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza pubblicità né limite giornaliero. In più, confronto delle serie di foto, ricerca di copie identiche e raccolte personalizzate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "広告なし、1日の上限なし。連続写真の比較、同じコピーの検索、カスタムコレクションも使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "광고도 하루 한도도 없어요. 연속 사진 비교, 같은 사본 찾기, 나만의 모음도 이용할 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No ads or daily limit. Plus photo series comparison, identical-copy search and custom collections."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen advertenties en geen daglimiet. Inclusief fotoreeksen vergelijken, identieke kopieën zoeken en eigen verzamelingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez reklam i limitu dziennego. Do tego porównywanie serii zdjęć, wyszukiwanie identycznych kopii i własne kolekcje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No ads or daily limit. Plus photo series comparison, identical-copy search and custom collections."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem anúncios nem limite diário. Inclui comparação de séries de fotos, pesquisa de cópias idênticas e coleções personalizadas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fără reclame și fără limită zilnică. Plus compararea seriilor de fotografii, căutarea copiilor identice și colecții proprii."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без рекламы и дневного лимита. Плюс сравнение серий фото, поиск одинаковых копий и свои подборки."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No ads or daily limit. Plus photo series comparison, identical-copy search and custom collections."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No ads or daily limit. Plus photo series comparison, identical-copy search and custom collections."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reklamsız ve günlük sınır yok. Ayrıca fotoğraf serisi karşılaştırma, aynı kopyaları bulma ve özel koleksiyonlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Без реклами й денного ліміту. А також порівняння серій фото, пошук ідентичних копій і власні добірки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No ads or daily limit. Plus photo series comparison, identical-copy search and custom collections."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无广告，无每日上限。还能比较连拍照片、查找相同副本、自建合集。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No ads or daily limit. Plus photo series comparison, identical-copy search and custom collections."
          }
        }
      }
    },
