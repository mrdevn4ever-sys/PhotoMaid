    "tour_months_row_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر على شهر لمراجعة صوره وفيديوهاته غير المراجَعة فقط."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på en måned for kun at gennemgå dens fotos og videoer, der endnu ikke er gennemgået."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf einen Monat, um nur dessen offene Fotos und Videos durchzusehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a month to review only its open photos and videos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un mes para revisar solo sus fotos y vídeos pendientes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche un mois pour ne passer en revue que ses photos et vidéos en attente."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk bulan untuk meninjau hanya foto dan video yang belum ditinjau di bulan itu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca un mese per rivedere solo le sue foto e i video in sospeso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "月をタップすると、その月の未確認の写真と動画だけを見直せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "월을 탭하면 그 달의 남은 사진과 동영상만 볼 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på en måned for å gå gjennom bare månedens bilder og videoer som du ennå ikke har gått gjennom."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op een maand om alleen de openstaande foto’s en video’s te bekijken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotknij miesiąca, aby przejrzeć tylko jego nieprzejrzane zdjęcia i filmy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque num mês para revisar só as fotos e vídeos em aberto dele."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca num mês para rever só as fotos e vídeos pendentes."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge o lună ca să revizuiești doar fotografiile și videoclipurile rămase."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажми на месяц, чтобы просмотреть только его непросмотренные фото и видео."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på en månad för att bara gå igenom dess bilder och videor som du inte har gått igenom än."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะเดือนเพื่อตรวจดูเฉพาะรูปภาพและวิดีโอที่ยังค้างของเดือนนั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca o ayın bekleyen fotoğraf ve videolarını gözden geçirmek için bir aya dokun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкнись місяця, щоб переглянути лише його непереглянуті фото й відео."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm vào một tháng để chỉ xem những ảnh và video của tháng đó mà bạn chưa xem lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按月份，只查看该月未查看的照片和视频。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下月份，只整理該月份尚未整理的照片和影片。"
          }
        }
      }
    },
    "tour_months_row_title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مدى تقدمك"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor langt du er nået"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So weit bist du"
          }
        },
        "en": {
