    "onb_try_done": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هكذا تعمل. حان دور صورك الآن."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sådan virker det. Nu til dine fotos."
          }
        },
        "de": {
