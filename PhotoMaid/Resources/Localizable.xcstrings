    "basket_confirm_files_trash_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنتقل الملفات إلى سلة مهملات موقع تخزينها ويمكن استعادتها من هناك. لا تتحرر المساحة إلا بعد حذفها من هناك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Dateien kommen in den Papierkorb ihres Speicherorts und lassen sich dort wiederherstellen. Speicher wird erst frei, wenn sie dort gelöscht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The files go to the trash of their storage location and can be restored there. Space is freed only when they’re deleted there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos van a la papelera de su ubicación y se pueden restaurar allí. El espacio solo se libera cuando se eliminan allí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers vont dans la corbeille de leur emplacement et peuvent y être restaurés. L’espace n’est libéré qu’une fois supprimés là-bas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file finiscono nel cestino della loro posizione e lì si possono ripristinare. Lo spazio si libera solo quando vengono eliminati da lì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルは保存先のゴミ箱に移動し、そこから復元できます。容量はそこで削除したときに空きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일은 저장 위치의 휴지통으로 옮겨지며 그곳에서 복원할 수 있어요. 공간은 그곳에서 삭제해야 확보돼요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bestanden gaan naar de prullenbak van hun opslaglocatie en zijn daar te herstellen. Ruimte komt pas vrij als ze daar worden verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pliki trafią do kosza swojej lokalizacji i można je tam przywrócić. Miejsce zwolni się dopiero po usunięciu ich stamtąd."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os ficheiros vão para o lixo do seu local e podem ser restaurados aí. O espaço só fica livre quando forem eliminados aí."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fișierele ajung în coșul locației lor și pot fi restaurate de acolo. Spațiul se eliberează doar după ce sunt șterse acolo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлы попадут в корзину своего хранилища, оттуда их можно восстановить. Место освободится, только когда их удалят там."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyalar depolama konumlarının çöp kutusuna gider ve oradan geri yüklenebilir. Alan ancak orada silindiklerinde boşalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файли потраплять у кошик свого сховища, звідти їх можна відновити. Місце звільниться, лише коли їх видалять там."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件会进入其存储位置的回收站，可在那里恢复。只有在那里删除后才会释放空间。"
          }
        }
      }
    },
