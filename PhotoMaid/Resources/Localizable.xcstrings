    "tour_editor_trim_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب المقبضين للاحتفاظ بالجزء الذي تريده فقط. لا يُكتب شيء حتى تضغط على حفظ."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Drag the two handles to keep just the part you want. Nothing is written until you tap Save."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe die beiden Griffe, um nur den gewünschten Teil zu behalten. Geschrieben wird erst, wenn du auf Speichern tippst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag the two handles to keep just the part you want. Nothing is written until you tap Save."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra los dos controles para quedarte solo con la parte que quieres. No se escribe nada hasta que tocas Guardar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais glisser les deux poignées pour ne garder que la partie voulue. Rien n’est écrit avant que tu touches Enregistrer."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Drag the two handles to keep just the part you want. Nothing is written until you tap Save."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina le due maniglie per tenere solo la parte che vuoi. Nulla viene scritto finché non tocchi Salva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2つのハンドルをドラッグして、残したい部分だけを選びます。保存をタップするまで何も書き込まれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 핸들을 끌어 원하는 부분만 남기세요. 저장을 누르기 전에는 아무것도 바뀌지 않아요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Drag the two handles to keep just the part you want. Nothing is written until you tap Save."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep de twee grepen om alleen het gewenste deel te houden. Er wordt pas iets geschreven als je op Opslaan tikt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij oba uchwyty, aby zostawić tylko wybraną część. Nic nie jest zapisywane, dopóki nie dotkniesz Zapisz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Drag the two handles to keep just the part you want. Nothing is written until you tap Save."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrasta as duas pegas para ficares só com a parte que queres. Nada é escrito até tocares em Guardar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trage cele două mânere ca să păstrezi doar partea dorită. Nimic nu se scrie până nu atingi Salvează."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащи оба ползунка, чтобы оставить только нужную часть. Ничего не записывается, пока не нажмёшь «Сохранить»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Drag the two handles to keep just the part you want. Nothing is written until you tap Save."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Drag the two handles to keep just the part you want. Nothing is written until you tap Save."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İstediğin kısmı tutmak için iki tutamacı sürükle. Kaydet'e dokunana kadar hiçbir şey yazılmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягни обидва повзунки, щоб залишити лише потрібну частину. Нічого не записується, доки не торкнешся «Зберегти»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Drag the two handles to keep just the part you want. Nothing is written until you tap Save."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动两侧手柄，只保留你想要的部分。在你点按“保存”之前不会写入任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Drag the two handles to keep just the part you want. Nothing is written until you tap Save."
          }
        }
      }
    },
    "tour_feed_actions_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "علّم المفضلة أو شارك العناصر أو أضفها إلى ألبوم. لا يجعلها ذلك محفوظة أو مُستبعدة أو مؤجلة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Markér favoritter, del emner, eller føj dem til et album. Det markerer dem ikke som beholdt, i papirkurven eller gemt til senere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markiere Favoriten, teile Inhalte oder füge sie einem Album hinzu. Dadurch werden sie nicht als behalten, aussortiert oder später markiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark favorites, share items or add them to an album. This doesn’t mark them as kept, trashed or saved for later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca favoritos, comparte elementos o añádelos a un álbum. Eso no los marca como guardados, descartados ni pospuestos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marquez des favoris, partagez des éléments ou ajoutez-les à un album. Cela ne les marque pas comme conservés, à jeter ou pour plus tard."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tandai favorit, bagikan item, atau tambahkan ke album. Ini tidak menandainya sebagai disimpan, di sampah, atau untuk nanti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segna i preferiti, condividi elementi o aggiungili a un album. Questo non li segna come tenuti, scartati o rimandati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お気に入りにする、共有する、アルバムに追加する。これらは「残す・ゴミ箱・あとで」の判断にはなりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "즐겨찾기 표시, 공유, 앨범에 추가를 할 수 있습니다. 이렇게 해도 보관, 휴지통, 나중에로 표시되지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Merk favoritter, del elementer eller legg dem til i et album. Det merker dem ikke som beholdt, i papirkurven eller lagret til senere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Markeer favorieten, deel items of voeg ze toe aan een album. Daarmee worden ze niet bewaard, weggegooid of voor later gemarkeerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznaczaj ulubione, udostępniaj lub dodawaj do albumu. Nie oznacza to zachowania, odrzucenia ani odłożenia na później."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque favoritos, compartilhe itens ou adicione-os a um álbum. Isso não os marca como mantidos, na lixeira ou guardados para depois."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque favoritos, partilhe itens ou adicione-os a um álbum. Isso não os marca como guardados, descartados ou para mais tarde."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Marchează favorite, partajează sau adaugă într-un album. Asta nu le marchează ca păstrate, aruncate sau pentru mai târziu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отмечайте избранное, отправляйте или добавляйте в альбом. Это не отмечает объекты как оставленные, удалённые или отложенные."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Markera favoriter, dela objekt eller lägg till dem i ett album. Det markerar dem inte som behållna, i papperskorgen eller sparade till senare."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำเครื่องหมายรายการโปรด แชร์รายการ หรือเพิ่มลงอัลบั้ม การทำเช่นนี้ไม่ได้ทำเครื่องหมายว่าเก็บไว้ ใส่ถังขยะ หรือไว้ทีหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Favori işaretle, paylaş veya albüme ekle. Bu, öğeleri tutulan, atılan veya sonraya bırakılan olarak işaretlemez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позначайте вибране, надсилайте або додавайте до альбому. Це не позначає об’єкти як залишені, видалені чи відкладені."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đánh dấu ưa thích, chia sẻ hoặc thêm vào album. Việc này không đánh dấu chúng là đã giữ, vào thùng rác hay để sau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标记个人收藏、共享或添加到相簿。这些操作不会将其标记为保留、丢弃或稍后处理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標示個人收藏、分享項目或加入相簿。這不會將它們標示為保留、放入垃圾桶或存為稍後。"
          }
        }
      }
    },
