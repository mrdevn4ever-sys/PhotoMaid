    "memory_random_missing": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتاج هذه الجولة إلى %1$lld صورة قابلة للاستخدام من المصدر المختار. اختر أزواجًا أقل أو مصدرًا آخر أو اسمح بالتنزيل من iCloud."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "This round needs %1$lld usable photos from the chosen source. Choose fewer pairs, another source or allow iCloud downloads."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diese Runde werden %1$lld nutzbare Fotos aus der gewählten Quelle benötigt. Wähle weniger Paare, eine andere Quelle oder erlaube iCloud-Downloads."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This round needs %1$lld usable photos from the chosen source. Choose fewer pairs, another source or allow iCloud downloads."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta ronda necesita %1$lld fotos utilizables del origen elegido. Elige menos pares, otro origen o permite las descargas de iCloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette partie nécessite %1$lld photos utilisables de la source choisie. Choisissez moins de paires, une autre source ou autorisez les téléchargements iCloud."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "This round needs %1$lld usable photos from the chosen source. Choose fewer pairs, another source or allow iCloud downloads."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Servono %1$lld foto utilizzabili dall’origine scelta. Scegli meno coppie, un’altra origine o consenti i download da iCloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択元に利用可能な写真が%1$lld枚必要です。ペアを減らすか、別の選択元にするか、iCloudからのダウンロードを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 출처에서 사용 가능한 사진 %1$lld장이 필요합니다. 짝 수를 줄이거나 다른 출처를 선택하거나 iCloud 다운로드를 허용하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "This round needs %1$lld usable photos from the chosen source. Choose fewer pairs, another source or allow iCloud downloads."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze ronde heeft %1$lld bruikbare foto's uit de gekozen bron nodig. Kies minder paren, een andere bron of sta iCloud-downloads toe."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta runda wymaga %1$lld dostępnych zdjęć z wybranego źródła. Wybierz mniej par, inne źródło lub zezwól na pobieranie z iCloud."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "This round needs %1$lld usable photos from the chosen source. Choose fewer pairs, another source or allow iCloud downloads."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta ronda precisa de %1$lld fotos utilizáveis da origem escolhida. Escolha menos pares, outra origem ou permita descargas do iCloud."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Runda necesită %1$lld poze utilizabile din sursa aleasă. Alege mai puține perechi, altă sursă sau permite descărcarea din iCloud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для раунда нужно %1$lld доступных фото из выбранного источника. Выберите меньше пар, другой источник или разрешите загрузку из iCloud."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
