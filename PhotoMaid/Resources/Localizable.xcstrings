    "vault_hide_entry_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تختفي الخزنة من الإعدادات. لفتحها، اضغط مطولًا على «اليوم» أعلى شاشة البداية لمدة ثانيتين."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Tresor verschwindet aus den Einstellungen. Zum Öffnen hältst du auf der Startseite oben „Heute“ 2 Sekunden lang gedrückt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The vault disappears from Settings. To open it, press and hold “Today” at the top of the start screen for 2 seconds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La caja fuerte desaparece de Ajustes. Para abrirla, mantén pulsado «Hoy» en la parte superior de la pantalla de inicio durante 2 segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le coffre-fort disparaît des Paramètres. Pour l’ouvrir, maintiens le doigt sur « Aujourd’hui » en haut de l’écran d’accueil pendant 2 secondes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cassaforte scompare dalle Impostazioni. Per aprirla, tieni premuto «Oggi» in alto nella schermata iniziale per 2 secondi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保管庫が設定から消えます。開くには、スタート画面上部の「今日」を2秒間長押しします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "금고가 설정에서 사라집니다. 열려면 시작 화면 상단의 ‘오늘’을 2초 동안 길게 누르세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De kluis verdwijnt uit Instellingen. Houd ‘Vandaag’ bovenaan het startscherm 2 seconden ingedrukt om hem te openen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sejf znika z Ustawień. Aby go otworzyć, przytrzymaj „Dzisiaj” u góry ekranu startowego przez 2 sekundy."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O cofre desaparece das Definições. Para o abrir, mantém premido «Hoje» no topo do ecrã inicial durante 2 segundos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Seiful dispare din Setări. Pentru a-l deschide, ține apăsat „Azi” în partea de sus a ecranului de start timp de 2 secunde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейф исчезнет из настроек. Чтобы открыть его, нажми и удерживай «Сегодня» вверху начального экрана 2 секунды."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasa Ayarlar’dan kaybolur. Açmak için başlangıç ekranının üstündeki “Bugün”e 2 saniye basılı tut."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейф зникне з налаштувань. Щоб відкрити його, натисни й утримуй «Сьогодні» вгорі початкового екрана 2 секунди."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保险箱将从“设置”中消失。要打开它，请在开始屏幕顶部按住“今天”2 秒。"
          }
        }
      }
    },
