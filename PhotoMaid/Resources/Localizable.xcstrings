    "vault_ad_folder_dismissed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُغلق الإعلان مبكرًا. لم يُنشأ أي مجلد – يمكنك المحاولة مرة أخرى."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Reklamen blev lukket for tidligt. Der blev ikke oprettet nogen mappe – du kan prøve igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Werbung wurde vorzeitig geschlossen. Es wurde kein Ordner angelegt – du kannst es erneut versuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The ad was closed early. No folder was created – you can try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El anuncio se cerró antes de tiempo. No se creó ninguna carpeta; puedes intentarlo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La publicité a été fermée trop tôt. Aucun dossier n’a été créé – tu peux réessayer."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Iklan ditutup lebih awal. Tidak ada folder yang dibuat – kamu bisa mencoba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La pubblicità è stata chiusa in anticipo. Nessuna cartella creata: puoi riprovare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "広告が途中で閉じられました。フォルダは作成されていません。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "광고가 일찍 닫혔어요. 폴더가 만들어지지 않았어요. 다시 시도할 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Annonsen ble lukket for tidlig. Ingen mappe ble opprettet – du kan prøve igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De advertentie is te vroeg gesloten. Er is geen map gemaakt – je kunt het opnieuw proberen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Reklama została zamknięta zbyt wcześnie. Nie utworzono folderu – możesz spróbować ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O anúncio foi fechado antes do fim. Nenhuma pasta foi criada – você pode tentar de novo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O anúncio foi fechado antes do tempo. Não foi criada nenhuma pasta – podes tentar novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Reclama a fost închisă prea devreme. Nu s-a creat niciun dosar – poți încerca din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Реклама была закрыта раньше времени. Папка не создана – можно попробовать снова."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Annonsen stängdes i förtid. Ingen mapp skapades – du kan försöka igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โฆษณาถูกปิดก่อนจบ ไม่มีการสร้างโฟลเดอร์ – คุณลองอีกครั้งได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reklam erken kapatıldı. Klasör oluşturulmadı – tekrar deneyebilirsin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рекламу закрито передчасно. Теку не створено – можна спробувати ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quảng cáo bị đóng sớm. Chưa tạo thư mục nào – bạn có thể thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "广告被提前关闭，未新建文件夹——你可以再试一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "廣告提早關閉。沒有建立檔案夾 – 你可以再試一次。"
          }
        }
      }
    },
    "vault_ad_folder_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في النسخة المجانية يحتاج كل مجلد جديد إلى فيديو إعلاني قصير. مع Pro تنشئ المجلدات بلا إعلانات."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "I gratisversionen kræver hver ny mappe en kort reklamevideo. Med Pro oprettes mapper uden reklamer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der Gratis-Version braucht jeder neue Ordner ein kurzes Werbevideo. Mit Pro legst du Ordner ohne Werbung an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the free version, each new folder needs a short ad video. With Pro, folders are created without ads."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la versión gratuita, cada carpeta nueva requiere un breve vídeo publicitario. Con Pro creas carpetas sin anuncios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans la version gratuite, chaque nouveau dossier nécessite une courte vidéo publicitaire. Avec Pro, tu crées des dossiers sans publicité."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di versi gratis, setiap folder baru butuh video iklan pendek. Dengan Pro, folder dibuat tanpa iklan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nella versione gratuita ogni nuova cartella richiede un breve video pubblicitario. Con Pro crei cartelle senza pubblicità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料版では新しいフォルダごとに短い広告動画が必要です。Proなら広告なしでフォルダを作成できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 버전에서는 새 폴더마다 짧은 광고 동영상이 필요해요. Pro에서는 광고 없이 폴더를 만들어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "I gratisversjonen krever hver nye mappe en kort annonsevideo. Med Pro opprettes mapper uten annonser."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In de gratis versie heeft elke nieuwe map een korte advertentievideo nodig. Met Pro maak je mappen zonder advertenties."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W wersji bezpłatnej każdy nowy folder wymaga krótkiego filmu reklamowego. Z Pro tworzysz foldery bez reklam."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Na versão grátis, cada nova pasta exige um vídeo curto de anúncio. Com o Pro, as pastas são criadas sem anúncios."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Na versão gratuita, cada nova pasta requer um curto vídeo publicitário. Com o Pro crias pastas sem anúncios."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În versiunea gratuită, fiecare dosar nou necesită un scurt videoclip publicitar. Cu Pro creezi dosare fără reclame."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В бесплатной версии для каждой новой папки нужно короткое рекламное видео. С Pro папки создаются без рекламы."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "I gratisversionen kräver varje ny mapp en kort annonsvideo. Med Pro skapas mappar utan annonser."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในเวอร์ชันฟรี แต่ละโฟลเดอร์ใหม่ต้องดูวิดีโอโฆษณาสั้นๆ กับ Pro จะสร้างโฟลเดอร์ได้โดยไม่มีโฆษณา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ücretsiz sürümde her yeni klasör için kısa bir reklam videosu gerekir. Pro ile klasörleri reklamsız oluşturursun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У безкоштовній версії для кожної нової теки потрібне коротке рекламне відео. З Pro теки створюються без реклами."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ở bản miễn phí, mỗi thư mục mới cần xem một video quảng cáo ngắn. Với Pro, thư mục được tạo không cần quảng cáo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免费版中，每个新文件夹都需要观看一段简短的广告视频。使用 Pro 可无广告新建文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在免費版中，每個新檔案夾都需要觀看一段短廣告影片。使用 Pro 建立檔案夾不需看廣告。"
          }
        }
      }
    },
    "vault_ad_folder_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يتوفر إعلان الآن. حاول لاحقًا – مع Pro تنشئ المجلدات بلا إعلانات."
