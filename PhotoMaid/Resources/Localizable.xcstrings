        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ট্র্যাশে – কিছুই মুছে ফেলা হয় না। সিদ্ধান্ত আপনি পরে সেখানে নেবেন।"
          }
