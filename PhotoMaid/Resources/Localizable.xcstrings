        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please choose a name that isn’t empty and doesn’t exist yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un nombre que no esté vacío y que no exista todavía."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse nimi, joka ei ole tyhjä eikä ole vielä käytössä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis un nom qui n’est pas vide et qui n’existe pas encore."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ખાલી ન હોય અને પહેલેથી ન હોય તેવું નામ પસંદ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לבחור שם שאינו ריק ועדיין לא קיים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐसा नाम चुनें जो खाली न हो और पहले से मौजूद न हो।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberi naziv koji nije prazan i još ne postoji."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Olyan nevet válassz, amely nem üres és még nem létezik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih nama yang tidak kosong dan belum ada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un nome non vuoto e non ancora esistente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空ではなく、まだ使われていない名前を選んでください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ದಯವಿಟ್ಟು ಖಾಲಿಯಲ್ಲದ ಮತ್ತು ಈಗಾಗಲೇ ಇಲ್ಲದ ಹೆಸರನ್ನು ಆಯ್ಕೆಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비어 있지 않고 아직 없는 이름을 선택하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ശൂന്യമല്ലാത്തതും ഇതിനകം ഇല്ലാത്തതുമായ ഒരു പേര് തിരഞ്ഞെടുക്കുക."
