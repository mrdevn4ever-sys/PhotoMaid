        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮೊದಲು ಏನನ್ನು ನಕಲಿಸಬೇಕು ಮತ್ತು ಗಮ್ಯ ಫೋಲ್ಡರ್ ಆಯ್ಕೆಮಾಡಿ."
