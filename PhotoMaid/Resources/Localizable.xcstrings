    "lib_folders_footer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعرض المجلدات مكان حفظ صورك وفيديوهاتك. لا يعرف Android المجلدات الفارغة: يظهر المجلد الجديد عندما تنقل إليه شيئًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordner zeigen, wo deine Fotos und Videos liegen. Android kennt keine leeren Ordner: Ein neuer Ordner erscheint, sobald du etwas hineinverschiebst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Folders come from where your photos and videos are stored. Android has no empty folders: a new folder appears once you move something into it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las carpetas muestran dónde están tus fotos y vídeos. Android no tiene carpetas vacías: una carpeta nueva aparece cuando mueves algo a ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dossiers indiquent où se trouvent vos photos et vidéos. Android ne connaît pas les dossiers vides : un nouveau dossier apparaît dès que vous y déplacez quelque chose."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le cartelle mostrano dove si trovano foto e video. Android non conosce cartelle vuote: una nuova cartella appare quando ci sposti qualcosa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダは写真や動画の保存場所です。Android には空のフォルダはありません。何かを移動すると新しいフォルダが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더는 사진과 동영상이 저장된 위치입니다. Android에는 빈 폴더가 없으며, 무언가를 옮기면 새 폴더가 나타납니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mappen laten zien waar je foto’s en video’s staan. Android kent geen lege mappen: een nieuwe map verschijnt zodra je er iets naartoe verplaatst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Foldery pokazują, gdzie są Twoje zdjęcia i filmy. Android nie zna pustych folderów: nowy folder pojawia się, gdy coś do niego przeniesiesz."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As pastas mostram onde estão as suas fotos e vídeos. O Android não tem pastas vazias: uma pasta nova aparece quando mover algo para ela."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosarele arată unde sunt fotografiile și videoclipurile tale. Android nu are dosare goale: un dosar nou apare după ce muți ceva în el."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Папки показывают, где хранятся фото и видео. В Android нет пустых папок: новая папка появится, когда вы переместите в неё файл."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klasörler fotoğraf ve videolarının nerede olduğunu gösterir. Android’de boş klasör olmaz: içine bir şey taşıdığında yeni klasör görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Папки показують, де зберігаються фото й відео. В Android немає порожніх папок: нова папка з’явиться, коли ви перемістите в неї файл."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件夹显示照片和视频的存放位置。Android 没有空文件夹：移入内容后新文件夹才会出现。"
          }
        }
      }
    },
