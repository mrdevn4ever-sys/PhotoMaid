    "help_tours_again": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عرض الجولة والنصائح مرة أخرى"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ট্যুর ও টিপস আবার দেখান"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tornar a mostrar el recorregut i els consells"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Znovu zobrazit prohlídku a tipy"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis rundvisningen og tips igen"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rundgang und Tipps noch einmal zeigen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφάνιση ξανά της ξενάγησης και των συμβουλών"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show the tour and tips again"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar de nuevo el recorrido y los consejos"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näytä esittely ja vinkit uudelleen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Revoir la visite et les astuces"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ટૂર અને ટિપ્સ ફરી બતાવો"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הצגה חוזרת של הסיור והטיפים"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टूर और सुझाव फिर दिखाएँ"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponovno prikaži obilazak i savjete"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A bemutató és a tippek újbóli megjelenítése"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilkan tur dan tips lagi"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra di nuovo la guida e i suggerimenti"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツアーとヒントをもう一度表示"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪ್ರವಾಸ ಮತ್ತು ಸಲಹೆಗಳನ್ನು ಮತ್ತೆ ತೋರಿಸಿ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "둘러보기와 팁 다시 보기"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ടൂറും നുറുങ്ങുകളും വീണ്ടും കാണിക്കുക"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "टूर आणि टिप्स पुन्हा दाखवा"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunjukkan semula lawatan dan petua"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis omvisningen og tipsene igjen"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rondleiding en tips opnieuw tonen"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
