    "export_busy": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هناك تصدير آخر قيد التشغيل. انتظر حتى ينتهي."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আরেকটি এক্সপোর্ট ইতিমধ্যে চলছে। অনুগ্রহ করে সেটি শেষ হওয়া পর্যন্ত অপেক্ষা করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja hi ha una altra exportació en curs. Espera que acabi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Už probíhá jiný export. Počkejte prosím, až skončí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En anden eksport kører allerede. Vent, til den er færdig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerade läuft schon ein Export. Warte bitte, bis er fertig ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εκτελείται ήδη άλλη εξαγωγή. Περίμενε να ολοκληρωθεί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another export is already running. Please wait until it’s finished."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya hay otra exportación en curso. Espera a que termine."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toinen vienti on jo käynnissä. Odota, kunnes se on valmis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un autre export est déjà en cours. Attendez qu’il soit terminé."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બીજું એક્સપોર્ટ પહેલેથી ચાલુ છે. કૃપા કરીને તે પૂર્ણ થાય ત્યાં સુધી રાહ જુઓ."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ייצוא אחר כבר פועל. יש להמתין עד שיסתיים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक और एक्सपोर्ट पहले से चल रहा है। कृपया उसके पूरा होने तक रुकें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Već je u tijeku drugi izvoz. Pričekaj da završi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Már fut egy másik exportálás. Várd meg, amíg befejeződik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekspor lain sedang berjalan. Tunggu sampai selesai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È già in corso un’altra esportazione. Attendi che finisca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の書き出しを実行中です。終わるまでお待ちください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇನ್ನೊಂದು ಎಕ್ಸ್‌ಪೋರ್ಟ್ ಈಗಾಗಲೇ ನಡೆಯುತ್ತಿದೆ. ದಯವಿಟ್ಟು ಅದು ಮುಗಿಯುವವರೆಗೆ ಕಾಯಿರಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 내보내기가 이미 진행 중입니다. 끝날 때까지 기다려 주세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മറ്റൊരു എക്‌സ്‌പോർട്ട് ഇതിനകം നടക്കുന്നു. അത് പൂർത്തിയാകുന്നതുവരെ ദയവായി കാത്തിരിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "दुसरी एक्सपोर्ट आधीच सुरू आहे. कृपया ती पूर्ण होईपर्यंत थांबा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksport lain sedang berjalan. Sila tunggu sehingga ia selesai."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En annen eksport pågår allerede. Vent til den er ferdig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er loopt al een andere export. Wacht tot die klaar is."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆଉ ଏକ ଏକ୍ସପୋର୍ଟ ପୂର୍ବରୁ ଚାଲୁଛି। ଦୟାକରି ତାହା ଶେଷ ହେବା ପର୍ଯ୍ୟନ୍ତ ଅପେକ୍ଷା କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇੱਕ ਹੋਰ ਐਕਸਪੋਰਟ ਪਹਿਲਾਂ ਹੀ ਚੱਲ ਰਿਹਾ ਹੈ। ਕਿਰਪਾ ਕਰਕੇ ਉਸ ਦੇ ਪੂਰਾ ਹੋਣ ਤੱਕ ਉਡੀਕ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trwa już inny eksport. Poczekaj, aż się zakończy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outra exportação já está em andamento. Espere até ela terminar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Já está a decorrer outra exportação. Aguarde até terminar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Rulează deja un alt export. Așteaptă să se termine."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уже идёт другой экспорт. Дождитесь его завершения."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Už prebieha iný export. Počkajte, kým skončí."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Drug izvoz že teče. Počakaj, da se konča."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En annan export pågår redan. Vänta tills den är klar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மற்றொரு ஏற்றுமதி ஏற்கனவே இயங்குகிறது. அது முடியும் வரை காத்திருங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మరో ఎక్స్‌పోర్ట్ ఇప్పటికే జరుగుతోంది. అది పూర్తయ్యే వరకు దయచేసి వేచి ఉండండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีการส่งออกอื่นกำลังทำงานอยู่ โปรดรอจนเสร็จ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaten başka bir dışa aktarma sürüyor. Bitmesini bekle."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Уже триває інший експорт. Зачекайте, доки він завершиться."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک اور ایکسپورٹ پہلے سے چل رہا ہے۔ براہ کرم اس کے مکمل ہونے تک انتظار کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một lần xuất khác đang chạy. Vui lòng đợi đến khi xong."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已有另一个导出正在进行。请等待其完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已有另一個輸出正在進行。請等它完成。"
          }
        }
      }
    },
    "export_cancelled": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم الإلغاء. لم يُحفظ شيء."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বাতিল করা হয়েছে। কিছুই সংরক্ষিত হয়নি।"
