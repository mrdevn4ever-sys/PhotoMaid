    "tour_grid_note_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النقل أو الإضافة إلى المفضلة لا يغيّر الاحتفاظ أو السلة أو لاحقًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Moving or marking favorites doesn’t change keep, trash or later."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschieben oder Favorisieren ändert nichts an Behalten, Papierkorb oder Später."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moving or marking favorites doesn’t change keep, trash or later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mover o marcar favoritos no cambia conservar, papelera ni después."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacer ou mettre en favori ne change rien à Garder, Corbeille ou Plus tard."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Moving or marking favorites doesn’t change keep, trash or later."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spostare o aggiungere ai preferiti non cambia Conserva, Cestino o Più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "移動やお気に入りは「残す」「ゴミ箱」「あとで」に影響しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이동하거나 즐겨찾기해도 보관, 휴지통, 나중에는 바뀌지 않아요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Moving or marking favorites doesn’t change keep, trash or later."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verplaatsen of als favoriet markeren verandert niets aan bewaren, prullenbak of later."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przenoszenie i ulubione nie zmieniają decyzji Zachowaj, Kosz ani Później."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Moving or marking favorites doesn’t change keep, trash or later."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mover ou marcar favoritos não altera manter, lixo ou mais tarde."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mutarea sau marcarea ca favorit nu schimbă păstrarea, coșul sau mai târziu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перемещение и избранное не меняют «Оставить», «Корзину» или «Позже»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Moving or marking favorites doesn’t change keep, trash or later."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Moving or marking favorites doesn’t change keep, trash or later."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taşımak veya favorilere eklemek saklama, çöp kutusu ya da sonra kararını değiştirmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переміщення й обране не змінюють «Залишити», «Кошик» чи «Пізніше»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Moving or marking favorites doesn’t change keep, trash or later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移动或收藏不会改变保留、回收站或稍后。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
