    "large_unreadable_footer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه العناصر على هذا الـ iPhone لكن تعذّرت قراءتها. تظهر في القائمة بحجم تقديري («حوالي»)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Medien liegen auf dem iPhone, ließen sich aber nicht lesen. In der Liste stehen sie mit geschätzter Größe („ca.“)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These items are on this iPhone but couldn’t be read. In the list, they appear with an estimated size (“approx.”)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos elementos están en el iPhone, pero no se pudieron leer. En la lista aparecen con un tamaño estimado («aprox.»)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces éléments sont sur l’iPhone mais n’ont pas pu être lus. Dans la liste, ils apparaissent avec une taille estimée (« env. »)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questi elementi sono sull’iPhone ma non è stato possibile leggerli. Nell’elenco compaiono con una dimensione stimata («circa»)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの項目はこのiPhoneにありますが、読み取れませんでした。リストには推定サイズ（「約」）で表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 항목은 iPhone에 있지만 읽을 수 없었어요. 목록에는 추정 크기(‘약’)로 표시돼요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze items staan op de iPhone, maar konden niet worden gelezen. In de lijst staan ze met een geschatte grootte (‘ca.’)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te elementy są na iPhonie, ale nie dało się ich odczytać. Na liście mają szacowany rozmiar („ok.”)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Estes itens estão no iPhone, mas não foi possível lê-los. Na lista aparecem com um tamanho estimado («aprox.»)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceste elemente sunt pe iPhone, dar nu au putut fi citite. În listă apar cu dimensiune estimată („cca.”)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти объекты есть на iPhone, но их не удалось прочитать. В списке они показаны с оценкой размера («≈»)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu öğeler iPhone’da ama okunamadı. Listede tahmini boyutla (“yaklaşık”) görünürler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ці об’єкти є на iPhone, але їх не вдалося прочитати. У списку вони мають оцінений розмір («≈»)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些项目在这台 iPhone 上，但无法读取。它们在列表中以估算大小（“约”）显示。"
          }
        }
      }
    },
