    "movie_failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر إنشاء الفيديو. لم يُحفظ شيء وتبقى الأصول دون تغيير."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভিডিও তৈরি করা যায়নি। কিছুই সংরক্ষিত হয়নি এবং মূল ফাইল অপরিবর্তিত।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s’ha pogut crear el vídeo. No s’ha desat res i els originals no han canviat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Video se nepodařilo vytvořit. Nic nebylo uloženo a originály jsou beze změny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Videoen kunne ikke oprettes. Intet blev gemt, og originalerne er uændrede."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Video konnte nicht erstellt werden. Es wurde nichts gespeichert, die Originale sind unverändert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η δημιουργία του βίντεο. Δεν αποθηκεύτηκε τίποτα και τα πρωτότυπα δεν άλλαξαν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The video could not be created. Nothing was saved and the originals are unchanged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo crear el vídeo. No se guardó nada y los originales no cambian."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Videota ei voitu luoda. Mitään ei tallennettu, ja alkuperäiset ovat ennallaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de créer la vidéo. Rien n’a été enregistré, les originaux sont intacts."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "વીડિયો બનાવી શકાયો નથી. કંઈ સચવાયું નથી અને મૂળ બદલાયાં નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה ליצור את הסרטון. שום דבר לא נשמר והמקוריים לא השתנו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वीडियो नहीं बन सका। कुछ भी सहेजा नहीं गया और मूल नहीं बदले।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Videozapis nije bilo moguće izraditi. Ništa nije spremljeno, a originali su nepromijenjeni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A videó nem hozható létre. Semmi sem lett mentve, az eredetik változatlanok."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Video tidak dapat dibuat. Tidak ada yang disimpan dan aslinya tidak berubah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile creare il video. Non è stato salvato nulla e gli originali restano invariati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画を作成できませんでした。何も保存されず、元のファイルは変わっていません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ವೀಡಿಯೊ ರಚಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ. ಏನನ್ನೂ ಉಳಿಸಲಾಗಿಲ್ಲ ಮತ್ತು ಮೂಲಗಳು ಬದಲಾಗಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동영상을 만들지 못했습니다. 아무것도 저장되지 않았고 원본은 그대로입니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വീഡിയോ സൃഷ്‌ടിക്കാനായില്ല. ഒന്നും സംരക്ഷിച്ചില്ല, ഒറിജിനലുകൾക്ക് മാറ്റമില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "व्हिडिओ तयार करता आला नाही. काहीही जतन झाले नाही आणि मूळ बदलले नाहीत."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Video tidak dapat dicipta. Tiada apa disimpan dan fail asal tidak berubah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Videoen kunne ikke opprettes. Ingenting ble lagret, og originalene er uendret."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De video kon niet worden gemaakt. Er is niets opgeslagen en de originelen zijn ongewijzigd."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଭିଡିଓ ତିଆରି ହୋଇପାରିଲା ନାହିଁ। କିଛି ସେଭ୍ ହୋଇନାହିଁ ଏବଂ ମୂଳ ଅପରିବର୍ତ୍ତିତ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਵੀਡੀਓ ਬਣਾਈ ਨਹੀਂ ਜਾ ਸਕੀ। ਕੁਝ ਨਹੀਂ ਸੰਭਾਲਿਆ ਗਿਆ ਅਤੇ ਮੂਲ ਬਿਨਾਂ ਬਦਲੇ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się utworzyć filmu. Nic nie zapisano, oryginały są bez zmian."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível criar o vídeo. Nada foi salvo e os originais não foram alterados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível criar o vídeo. Nada foi guardado e os originais ficam inalterados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Videoclipul nu a putut fi creat. Nu s-a salvat nimic, iar originalele sunt neschimbate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось создать видео. Ничего не сохранено, оригиналы не изменены."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Video sa nepodarilo vytvoriť. Nič nebolo uložené a originály sú bez zmeny."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Videa ni bilo mogoče ustvariti. Nič ni bilo shranjeno, izvirniki so nespremenjeni."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Videon kunde inte skapas. Inget sparades och originalen är oförändrade."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வீடியோவை உருவாக்க முடியவில்லை. எதுவும் சேமிக்கப்படவில்லை, அசல்கள் மாறவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వీడియోను సృష్టించడం సాధ్యం కాలేదు. ఏదీ సేవ్ కాలేదు, ఒరిజినల్‌లు మారలేదు."
