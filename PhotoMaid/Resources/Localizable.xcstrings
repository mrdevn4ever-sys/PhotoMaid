    "vid_trim_hint_short": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب المقابض لتحديد البداية والنهاية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুরু ও শেষ ঠিক করতে হ্যান্ডেল টানুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrossega les nanses per fixar l’inici i el final."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přetažením úchytů nastavíte začátek a konec."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træk i håndtagene for at angive start og slut."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe die Griffe, um Anfang und Ende festzulegen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σύρε τις λαβές για να ορίσεις αρχή και τέλος."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag the handles to set the start and end."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra los controles para fijar el inicio y el final."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aseta alku ja loppu vetämällä kahvoja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais glisser les poignées pour définir le début et la fin."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "શરૂઆત અને અંત નક્કી કરવા હૅન્ડલ ખેંચો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גרירת הידיות קובעת את ההתחלה והסוף."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शुरुआत और अंत तय करने के लिए हैंडल खींचें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Povuci ručke za postavljanje početka i kraja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kezdet és a vég beállításához húzd a fogantyúkat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret pegangan untuk mengatur awal dan akhir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina le maniglie per impostare inizio e fine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハンドルをドラッグして開始と終了を決めます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆರಂಭ ಮತ್ತು ಅಂತ್ಯ ಹೊಂದಿಸಲು ಹ್ಯಾಂಡಲ್‌ಗಳನ್ನು ಎಳೆಯಿರಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "핸들을 끌어 시작과 끝을 정하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "തുടക്കവും അവസാനവും നിശ്ചയിക്കാൻ ഹാൻഡിലുകൾ വലിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सुरुवात आणि शेवट ठरवण्यासाठी हँडल ओढा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret pemegang untuk menetapkan permulaan dan penghujung."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra i håndtakene for å angi start og slutt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep de grepen om begin en einde te bepalen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆରମ୍ଭ ଓ ଶେଷ ସ୍ଥିର କରିବାକୁ ହ୍ୟାଣ୍ଡେଲ୍ ଟାଣନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸ਼ੁਰੂ ਅਤੇ ਅੰਤ ਤੈਅ ਕਰਨ ਲਈ ਹੈਂਡਲ ਖਿੱਚੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij uchwyty, aby ustawić początek i koniec."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste as alças para definir o início e o fim."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrasta as pegas para definir o início e o fim."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trage de mânere pentru a stabili începutul și sfârșitul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащи ползунки, чтобы задать начало и конец."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Potiahnutím úchytov nastavíte začiatok a koniec."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Povleci ročici, da nastaviš začetek in konec."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra i handtagen för att ange start och slut."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தொடக்கத்தையும் முடிவையும் அமைக்கக் கைப்பிடிகளை இழுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రారంభం, ముగింపు సెట్ చేయడానికి హ్యాండిల్‌లను లాగండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลากจุดจับเพื่อตั้งจุดเริ่มต้นและจุดสิ้นสุด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlangıcı ve bitişi belirlemek için tutamaçları sürükle."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягни повзунки, щоб задати початок і кінець."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شروع اور آخر طے کرنے کے لیے ہینڈلز کھینچیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kéo các tay cầm để đặt điểm đầu và cuối."
          }
        },
        "zh-Hans": {
