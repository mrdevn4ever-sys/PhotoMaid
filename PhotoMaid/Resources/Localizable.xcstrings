    "onb_safe_local": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى صورك على جهازك. بلا حساب GaleriQ أو رفع للصور."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ফটো আপনার ডিভাইসেই থাকে। কোনো GaleriQ অ্যাকাউন্ট নেই, কোনো ফটো আপলোড নেই।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les teves fotos es queden al dispositiu. Sense compte de GaleriQ i sense penjar fotos."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše fotky zůstávají v zařízení. Žádný účet GaleriQ, žádné nahrávání fotek."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine fotos bliver på din enhed. Ingen GaleriQ-konto, ingen upload af fotos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Fotos bleiben auf deinem Gerät. Kein GaleriQ-Konto, kein Foto-Upload."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι φωτογραφίες σου μένουν στη συσκευή σου. Χωρίς λογαριασμό GaleriQ, χωρίς ανέβασμα φωτογραφιών."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your photos stay on your device. No GaleriQ account, no photo uploads."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus fotos se quedan en tu dispositivo. Sin cuenta de GaleriQ ni subidas de fotos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvasi pysyvät laitteellasi. Ei GaleriQ-tiliä, ei kuvien lähettämistä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes photos restent sur ton appareil. Sans compte GaleriQ ni envoi de photos."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારા ફોટા તમારા ઉપકરણ પર રહે છે. કોઈ GaleriQ એકાઉન્ટ નહીં, કોઈ ફોટો અપલોડ નહીં."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התמונות שלך נשארות במכשיר. בלי חשבון GaleriQ, בלי העלאת תמונות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी फ़ोटो आपके डिवाइस पर रहती हैं। कोई GaleriQ खाता नहीं, कोई फ़ोटो अपलोड नहीं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje fotografije ostaju na uređaju. Bez GaleriQ računa, bez prijenosa fotografija."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fotóid az eszközödön maradnak. Nincs GaleriQ-fiók, nincs fotófeltöltés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotomu tetap di perangkatmu. Tanpa akun GaleriQ, tanpa unggah foto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue foto restano sul dispositivo. Nessun account GaleriQ, nessun caricamento di foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真は端末内に残ります。GaleriQアカウントも写真のアップロードも不要です。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಫೋಟೋಗಳು ನಿಮ್ಮ ಸಾಧನದಲ್ಲೇ ಉಳಿಯುತ್ತವೆ. GaleriQ ಖಾತೆ ಇಲ್ಲ, ಫೋಟೋ ಅಪ್‌ಲೋಡ್ ಇಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진은 기기에 남아요. GaleriQ 계정도 사진 업로드도 필요 없어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ഫോട്ടോകൾ നിങ്ങളുടെ ഉപകരണത്തിൽ തന്നെ തുടരും. GaleriQ അക്കൗണ്ടില്ല, ഫോട്ടോ അപ്‌ലോഡുകളില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचे फोटो तुमच्या डिव्हाइसवर राहतात. GaleriQ खाते नाही, फोटो अपलोड नाहीत."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto anda kekal pada peranti anda. Tiada akaun GaleriQ, tiada muat naik foto."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildene dine blir på enheten din. Ingen GaleriQ-konto, ingen opplasting av bilder."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je foto’s blijven op je apparaat. Geen GaleriQ-account en geen foto-uploads."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ ଫଟୋ ଆପଣଙ୍କ ଡିଭାଇସ୍‌ରେ ହିଁ ରହେ। କୌଣସି GaleriQ ଆକାଉଣ୍ଟ ନାହିଁ, କୌଣସି ଫଟୋ ଅପଲୋଡ୍ ନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੀਆਂ ਫ਼ੋਟੋਆਂ ਤੁਹਾਡੇ ਡਿਵਾਈਸ ਉੱਤੇ ਰਹਿੰਦੀਆਂ ਹਨ। ਕੋਈ GaleriQ ਖਾਤਾ ਨਹੀਂ, ਕੋਈ ਫ਼ੋਟੋ ਅੱਪਲੋਡ ਨਹੀਂ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdjęcia pozostają na urządzeniu. Bez konta GaleriQ i wysyłania zdjęć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas fotos ficam no seu aparelho. Sem conta do GaleriQ, sem envio de fotos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As tuas fotos ficam no teu dispositivo. Sem conta GaleriQ nem envio de fotos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografiile rămân pe dispozitivul tău. Fără cont GaleriQ și fără încărcarea fotografiilor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото остаются на твоём устройстве. Без аккаунта GaleriQ и загрузки фото на сервер."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše fotky zostávajú v zariadení. Žiadny účet GaleriQ, žiadne nahrávanie fotiek."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje fotografije ostanejo v napravi. Brez računa GaleriQ, brez nalaganja fotografij."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina bilder stannar på din enhet. Inget GaleriQ-konto, ingen bilduppladdning."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் புகைப்படங்கள் உங்கள் சாதனத்திலேயே இருக்கும். GaleriQ கணக்கு இல்லை, புகைப்படப் பதிவேற்றம் இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ ఫోటోలు మీ పరికరంలోనే ఉంటాయి. GaleriQ ఖాతా లేదు, ఫోటో అప్‌లోడ్‌లు లేవు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปภาพของคุณอยู่บนอุปกรณ์ของคุณ ไม่มีบัญชี GaleriQ ไม่มีการอัปโหลดรูป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğrafların cihazında kalır. GaleriQ hesabı ve fotoğraf yüklemesi yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото залишаються на твоєму пристрої. Без облікового запису GaleriQ і завантаження фото на сервер."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی تصاویر آپ کی ڈیوائس پر رہتی ہیں۔ کوئی GaleriQ اکاؤنٹ نہیں، کوئی تصویر اپ لوڈ نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh của bạn ở lại trên thiết bị. Không có tài khoản GaleriQ, không tải ảnh lên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片留在设备上，无需 GaleriQ 账号，也不上传照片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的照片留在你的裝置上。沒有 GaleriQ 帳號，不會上傳照片。"
          }
        }
      }
    },
