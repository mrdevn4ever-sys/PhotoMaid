    "collage_hint_crop": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب لتحريك الصورة داخل خانتها، وكبّر أو صغّر بإصبعين."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe, um das Foto im Feld zu verschieben, und zoome mit zwei Fingern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to move the photo in its cell, pinch to zoom."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra para mover la foto en su celda y pellizca para hacer zoom."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser pour déplacer la photo dans sa case, pincez pour zoomer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina per spostare la foto nella cella, pizzica per lo zoom."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグで枠内の写真を移動、ピンチでズームします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드래그하여 칸 안에서 사진을 옮기고, 두 손가락으로 확대/축소하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep om de foto in het vak te verschuiven, knijp om te zoomen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij, aby przesunąć zdjęcie w polu; zsuń lub rozsuń palce, aby powiększyć."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste para mover a fotografia na célula e junte ou afaste os dedos para ampliar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trage ca să muți poza în casetă, ciupește pentru zoom."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите, чтобы сдвинуть фото в ячейке; сведите или разведите пальцы для масштаба."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğrafı hücresinde kaydırmak için sürükle, yakınlaştırmak için iki parmağını kullan."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягніть, щоб зсунути фото в клітинці; зведіть або розведіть пальці для масштабу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动可在格子内移动照片，双指捏合可缩放。"
          }
        }
      }
    },
    "collage_hint_free": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب الصور لتحريكها. استخدم إصبعين لتغيير الحجم والتدوير."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe Fotos, um sie zu verschieben. Mit zwei Fingern änderst du Größe und Drehung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag photos to move them. Two fingers resize and rotate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra las fotos para moverlas. Con dos dedos cambias el tamaño y el giro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser les photos pour les déplacer. Deux doigts changent la taille et la rotation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina le foto per spostarle. Con due dita ne cambi dimensione e rotazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真をドラッグして移動。2本指でサイズと回転を変更します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진을 드래그해 옮기세요. 두 손가락으로 크기와 회전을 바꿀 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep foto’s om ze te verplaatsen. Met twee vingers wijzig je grootte en draaiing."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągaj zdjęcia, aby je przesuwać. Dwoma palcami zmienisz rozmiar i obrót."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste as fotografias para as mover. Com dois dedos altera o tamanho e a rotação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trage pozele ca să le muți. Cu două degete schimbi mărimea și rotația."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетаскивайте фото, чтобы двигать их. Двумя пальцами меняйте размер и поворот."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğrafları taşımak için sürükle. İki parmakla boyutu ve dönüşü değiştir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягуйте фото, щоб переміщувати їх. Двома пальцями змінюйте розмір і поворот."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动照片可移动位置，双指可调整大小和旋转。"
          }
        }
      }
    },
