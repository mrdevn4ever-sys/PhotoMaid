    "lib_trash_action": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نقل إلى السلة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In den Papierkorb"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move to trash"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mover a la papelera"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettre à la corbeille"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sposta nel cestino"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴミ箱へ移動"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통으로 이동"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naar prullenbak"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do kosza"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mover para o lixo"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mută în coș"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В корзину"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çöp kutusuna taşı"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У кошик"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移到回收站"
          }
        }
      }
    },
    "lib_trash_fav_protected": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا عنصر مفضل. „حماية المفضلة“ مفعّل، لذا لن يُنقل إلى السلة. يمكنك تغيير ذلك في الإعدادات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist ein Favorit. „Favoriten schützen“ ist an, deshalb kommt er nicht in den Papierkorb. Ändern kannst du das in den Einstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a favourite. “Protect favourites” is on, so it stays out of the trash. You can change this in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es un favorito. «Proteger favoritos» está activado, así que no va a la papelera. Puedes cambiarlo en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est un favori. « Protéger les favoris » est activé, il ne va donc pas à la corbeille. Tu peux le modifier dans les réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È un preferito. «Proteggi preferiti» è attivo, quindi non va nel cestino. Puoi cambiarlo nelle impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これはお気に入りです。「お気に入りを保護」がオンのため、ゴミ箱には入りません。設定で変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "즐겨찾기 항목이에요. '즐겨찾기 보호'가 켜져 있어 휴지통에 넣지 않아요. 설정에서 바꿀 수 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is een favoriet. ‘Favorieten beschermen’ staat aan, dus hij gaat niet naar de prullenbak. Je kunt dit wijzigen in Instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To ulubione. „Chroń ulubione” jest włączone, więc nie trafi do kosza. Możesz to zmienić w ustawieniach."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "É um favorito. «Proteger favoritos» está ativo, por isso não vai para o lixo. Podes mudar isto nas definições."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Este un favorit. „Protejează favoritele” e activ, așa că nu ajunge în coș. Poți schimba asta în setări."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это избранное. Включено «Защищать избранное», поэтому оно не попадёт в корзину. Это можно изменить в настройках."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bir favori. „Favorileri koru” açık olduğu için çöp kutusuna gitmez. Bunu ayarlardan değiştirebilirsin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це обране. Увімкнено «Захищати обране», тому воно не потрапить у кошик. Змінити це можна в налаштуваннях."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是收藏项。已开启“保护收藏”，因此不会移到回收站。可在设置中更改。"
          }
        }
      }
    },
    "lib_trash_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إلى سلة PhotoMaid – لا يُحذف شيء. تقرر لاحقًا هناك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In den PhotoMaid-Papierkorb – es wird nichts gelöscht. Du entscheidest dort später."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Into the PhotoMaid trash – nothing is deleted. You decide there later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A la papelera de PhotoMaid; no se borra nada. Decides allí más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans la corbeille PhotoMaid – rien n’est supprimé. Tu décides plus tard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nel cestino di PhotoMaid: non viene eliminato nulla. Decidi lì più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaidのゴミ箱へ。何も削除されません。あとでそこで決めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid 휴지통으로 – 아무것도 삭제되지 않아요. 나중에 거기서 결정해요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naar de PhotoMaid-prullenbak – er wordt niets verwijderd. Je beslist daar later."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do kosza PhotoMaid – nic nie zostanie usunięte. Zdecydujesz tam później."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para o lixo do PhotoMaid – nada é eliminado. Decides lá mais tarde."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În coșul PhotoMaid – nu se șterge nimic. Decizi acolo mai târziu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В корзину PhotoMaid — ничего не удаляется. Решишь там позже."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid çöp kutusuna – hiçbir şey silinmez. Sonra orada karar verirsin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У кошик PhotoMaid — нічого не видаляється. Вирішиш там пізніше."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移到 PhotoMaid 回收站——不会删除任何内容，稍后在那里决定。"
          }
        }
      }
    },
    "lib_trash_text_fav": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إلى سلة PhotoMaid – لا يُحذف شيء. تبقى المفضلة („حماية المفضلة“ مفعّل)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In den PhotoMaid-Papierkorb – es wird nichts gelöscht. Favoriten bleiben („Favoriten schützen“ ist an)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Into the PhotoMaid trash – nothing is deleted. Favourites stay (“Protect favourites” is on)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A la papelera de PhotoMaid; no se borra nada. Los favoritos se quedan («Proteger favoritos» está activado)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans la corbeille PhotoMaid – rien n’est supprimé. Les favoris restent (« Protéger les favoris » est activé)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nel cestino di PhotoMaid: non viene eliminato nulla. I preferiti restano («Proteggi preferiti» è attivo)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaidのゴミ箱へ。何も削除されません。お気に入りは残ります（「お気に入りを保護」がオン）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid 휴지통으로 – 아무것도 삭제되지 않아요. 즐겨찾기는 남아요('즐겨찾기 보호' 켜짐)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naar de PhotoMaid-prullenbak – er wordt niets verwijderd. Favorieten blijven (‘Favorieten beschermen’ staat aan)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do kosza PhotoMaid – nic nie zostanie usunięte. Ulubione zostają (włączone „Chroń ulubione”)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para o lixo do PhotoMaid – nada é eliminado. Os favoritos ficam («Proteger favoritos» está ativo)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În coșul PhotoMaid – nu se șterge nimic. Favoritele rămân („Protejează favoritele” e activ)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В корзину PhotoMaid — ничего не удаляется. Избранное остаётся (включено «Защищать избранное»)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid çöp kutusuna – hiçbir şey silinmez. Favoriler kalır („Favorileri koru” açık)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У кошик PhotoMaid — нічого не видаляється. Обране залишається (увімкнено «Захищати обране»)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移到 PhotoMaid 回收站——不会删除任何内容。收藏会保留（已开启“保护收藏”）。"
          }
        }
      }
    },
