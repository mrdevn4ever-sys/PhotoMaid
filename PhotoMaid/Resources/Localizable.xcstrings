    "edit_save_replace_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يطلب iOS التأكيد. ينتقل الأصل إلى «المحذوفة مؤخرًا» في تطبيق الصور ويمكن عادةً استعادته من هناك خلال 30 يومًا. لا تتحرر المساحة إلا بعد ذلك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS নিশ্চিত করতে বলে। মূলটি ফটো অ্যাপের “সম্প্রতি মুছে ফেলা”-তে যায় এবং সেখান থেকে সাধারণত ৩০ দিন পর্যন্ত পুনরুদ্ধার করা যায়। জায়গা খালি হয় তার পরেই।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’iOS demana confirmació. L’original va a «Eliminat recentment» a l’app Fotos i normalment s’hi pot recuperar durant 30 dies. L’espai s’allibera després."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS požádá o potvrzení. Originál se přesune do „Nedávno smazaných“ v aplikaci Fotky a obvykle ho tam lze 30 dní obnovit. Místo se uvolní až potom."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS beder om bekræftelse. Originalen havner i “Senest slettet” i appen Fotos og kan normalt gendannes der i 30 dage. Pladsen frigøres først derefter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS fragt nach. Das Original kommt in „Zuletzt gelöscht“ der Fotos-App und lässt sich dort normalerweise 30 Tage wiederherstellen. Speicher wird erst danach frei."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το iOS ζητά επιβεβαίωση. Το πρωτότυπο πηγαίνει στα «Πρόσφατα διαγραμμένα» της εφαρμογής Φωτογραφίες και συνήθως επαναφέρεται από εκεί για 30 ημέρες. Ο χώρος ελευθερώνεται μόνο μετά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS asks to confirm. The original goes to “Recently Deleted” in the Photos app and can usually be restored there for 30 days. Space is freed only after that."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS pide confirmación. El original pasa a «Eliminado» en la app Fotos y normalmente se puede recuperar allí durante 30 días. El espacio se libera solo después."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS pyytää vahvistuksen. Alkuperäinen siirtyy Kuvat-apin kansioon ”Äskettäin poistetut”, ja sen voi yleensä palauttaa sieltä 30 päivän ajan. Tilaa vapautuu vasta sen jälkeen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS demande confirmation. L’original va dans « Suppressions récentes » de l’app Photos et peut généralement y être récupéré pendant 30 jours. L’espace n’est libéré qu’ensuite."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS પુષ્ટિ માગે છે. મૂળ ફોટો ઍપના “તાજેતરમાં ડિલીટ કરેલ” માં જાય છે અને સામાન્ય રીતે ત્યાંથી 30 દિવસ સુધી પુનઃસ્થાપિત થઈ શકે છે. જગ્યા ત્યાર પછી જ ખાલી થાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS מבקשת אישור. המקור עובר אל „נמחקו לאחרונה” ביישום ״תמונות״ ובדרך כלל אפשר לשחזר אותו שם במשך 30 יום. המקום מתפנה רק אחרי כן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS पुष्टि माँगता है। मूल तस्वीरें ऐप के “हाल ही में डिलीट किए गए” में जाता है और आमतौर पर वहाँ से 30 दिन तक रीस्टोर हो सकता है। जगह उसके बाद ही खाली होती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS traži potvrdu. Original ide u „Nedavno izbrisano” u aplikaciji Fotografije i ondje se obično može vratiti 30 dana. Prostor se oslobađa tek nakon toga."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az iOS megerősítést kér. Az eredeti a Fotók app „Nemrég törölt” albumába kerül, ahonnan általában 30 napig visszaállítható. Hely csak utána szabadul fel."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS meminta konfirmasi. Aslinya masuk ke “Baru Dihapus” di app Foto dan biasanya bisa dipulihkan di sana selama 30 hari. Ruang baru kosong setelah itu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS chiede conferma. L’originale finisce in «Eliminati di recente» nell’app Foto e di solito si può recuperare lì per 30 giorni. Lo spazio si libera solo dopo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOSが確認します。オリジナルは写真アプリの「最近削除した項目」に移動し、通常は30日間そこから復元できます。空き容量が増えるのはその後です。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ದೃಢೀಕರಿಸಲು ಕೇಳುತ್ತದೆ. ಮೂಲವು ಫೋಟೋಗಳು ಆ್ಯಪ್‌ನ “ಇತ್ತೀಚೆಗೆ ಅಳಿಸಲಾಗಿದೆ” ಗೆ ಹೋಗುತ್ತದೆ ಮತ್ತು ಸಾಮಾನ್ಯವಾಗಿ ಅಲ್ಲಿಂದ 30 ದಿನಗಳವರೆಗೆ ಮರುಸ್ಥಾಪಿಸಬಹುದು. ಅದರ ನಂತರವೇ ಸ್ಥಳ ಮುಕ್ತವಾಗುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS가 확인을 요청합니다. 원본은 사진 앱의 '최근 삭제된 항목'으로 이동하며 보통 30일 동안 그곳에서 복구할 수 있습니다. 공간은 그 이후에 확보됩니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS സ്ഥിരീകരണം ചോദിക്കും. ഒറിജിനൽ ഫോട്ടോസ് ആപ്പിലെ “അടുത്തിടെ ഇല്ലാതാക്കിയവ”-ലേക്ക് പോകും, സാധാരണയായി അവിടെ നിന്ന് 30 ദിവസം വരെ പുനഃസ്ഥാപിക്കാം. അതിനുശേഷം മാത്രമേ സ്ഥലം ഒഴിവാകൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS पुष्टी मागते. मूळ फोटो अ‍ॅपच्या “अलीकडे डिलीट केलेले” मध्ये जाते आणि सहसा तिथून 30 दिवस पुनर्संचयित करता येते. जागा त्यानंतरच मोकळी होते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS meminta pengesahan. Yang asal masuk ke “Dipadam Baru-baru Ini” dalam app Foto dan biasanya boleh dipulihkan di sana selama 30 hari. Ruang hanya dikosongkan selepas itu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ber om bekreftelse. Originalen havner i «Nylig slettet» i Bilder-appen og kan vanligvis gjenopprettes der i 30 dager. Plassen frigjøres først etter det."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS vraagt om bevestiging. Het origineel gaat naar ‘Recent verwijderd’ in de Foto’s-app en is daar meestal 30 dagen te herstellen. Pas daarna komt ruimte vrij."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ନିଶ୍ଚିତ କରିବାକୁ କହେ। ମୂଳ ଫଟୋ ଆପ୍‌ର “ନିକଟରେ ଡିଲିଟ୍ ହୋଇଥିବା”କୁ ଯାଏ ଏବଂ ସାଧାରଣତଃ ସେଠାରୁ 30 ଦିନ ପର୍ଯ୍ୟନ୍ତ ପୁନରୁଦ୍ଧାର କରିହେବ। ତାପରେ ହିଁ ସ୍ଥାନ ଖାଲି ହୁଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ਪੁਸ਼ਟੀ ਲਈ ਪੁੱਛਦਾ ਹੈ। ਮੂਲ ਫ਼ੋਟੋਆਂ ਐਪ ਦੇ “ਹਾਲ ਹੀ ਵਿੱਚ ਮਿਟਾਏ ਗਏ” ਵਿੱਚ ਜਾਂਦਾ ਹੈ ਅਤੇ ਆਮ ਤੌਰ ’ਤੇ ਉੱਥੋਂ 30 ਦਿਨਾਂ ਤੱਕ ਵਾਪਸ ਲਿਆਂਦਾ ਜਾ ਸਕਦਾ ਹੈ। ਥਾਂ ਉਸ ਤੋਂ ਬਾਅਦ ਹੀ ਖਾਲੀ ਹੁੰਦੀ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS poprosi o potwierdzenie. Oryginał trafi do „Ostatnio usunięte” w aplikacji Zdjęcia i zwykle można go tam odzyskać przez 30 dni. Miejsce zwolni się dopiero potem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iOS pede confirmação. O original vai para “Apagados” no app Fotos e normalmente pode ser restaurado lá por 30 dias. O espaço só é liberado depois disso."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O iOS pede confirmação. O original passa para «Apagados recentemente» na app Fotografias e normalmente pode ser recuperado aí durante 30 dias. O espaço só é libertado depois."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS cere confirmarea. Originalul ajunge în „Șterse recent” din aplicația Poze și de obicei poate fi recuperat de acolo timp de 30 de zile. Spațiul se eliberează abia după aceea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS попросит подтверждение. Оригинал попадёт в «Недавно удаленные» приложения «Фото», обычно его можно восстановить там в течение 30 дней. Место освободится только после этого."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS požiada o potvrdenie. Originál sa presunie do „Nedávno vymazaných“ v aplikácii Fotky a zvyčajne ho tam možno 30 dní obnoviť. Miesto sa uvoľní až potom."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS zahteva potrditev. Izvirnik gre v »Nedavno izbrisano« v aplikaciji Fotografije in ga je tam običajno mogoče obnoviti 30 dni. Prostor se sprosti šele nato."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ber om bekräftelse. Originalet hamnar i ”Nyligen raderade” i appen Bilder och kan oftast återställas där i 30 dagar. Utrymmet frigörs först därefter."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS உறுதிப்படுத்தக் கேட்கும். அசல் Photos ஆப்பின் “சமீபத்தில் நீக்கியவை”-க்குச் செல்லும், பொதுவாக அங்கிருந்து 30 நாட்கள் வரை மீட்டெடுக்கலாம். அதன் பிறகே இடம் காலியாகும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS నిర్ధారించమని అడుగుతుంది. ఒరిజినల్ Photos యాప్‌లోని “ఇటీవల తొలగించినవి”కి వెళ్తుంది, సాధారణంగా అక్కడి నుండి 30 రోజుల వరకు పునరుద్ధరించవచ్చు. ఆ తర్వాతే స్థలం ఖాళీ అవుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS จะขอให้ยืนยัน ต้นฉบับจะไปที่ “ที่ลบล่าสุด” ในแอพรูปภาพ และโดยปกติกู้คืนได้ที่นั่นภายใน 30 วัน พื้นที่จะว่างหลังจากนั้นเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS onay ister. Orijinal Fotoğraflar uygulamasındaki \"Son Silinenler\"e taşınır ve genellikle orada 30 gün boyunca geri yüklenebilir. Alan ancak bundan sonra boşalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS попросить підтвердження. Оригінал потрапить до «Нещодавно видалених» у програмі «Фото», зазвичай його можна відновити там протягом 30 днів. Місце звільниться лише після цього."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS تصدیق مانگتا ہے۔ اصل تصاویر ایپ کے ”حال ہی میں حذف کردہ“ میں جاتا ہے اور عموماً وہاں سے 30 دن تک بحال ہو سکتا ہے۔ جگہ اس کے بعد ہی خالی ہوتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS sẽ yêu cầu xác nhận. Bản gốc chuyển vào “Đã xóa gần đây” trong ứng dụng Ảnh và thường có thể khôi phục ở đó trong 30 ngày. Dung lượng chỉ được giải phóng sau đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 会请你确认。原件将移到“照片”App 的“最近删除”中，通常可在 30 天内从那里恢复。之后才会释放空间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 會請你確認。原始檔會移到「照片」App 的「最近刪除」，通常 30 天內可在那裡復原。之後才會釋放空間。"
          }
        }
      }
    },
