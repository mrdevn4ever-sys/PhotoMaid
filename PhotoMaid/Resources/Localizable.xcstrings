    "vault_edit_replace_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك استعادة الأصل من سلة المحذوفات الآمنة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভল্টের ট্র্যাশ থেকে মূলটি পুনরুদ্ধার করতে পারেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Pots recuperar l’original des de la paperera de la caixa forta."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Originál můžete obnovit z koše trezoru."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan gendanne originalen fra boksens papirkurv."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Original lässt sich aus dem Tresor-Papierkorb zurückholen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείς να επαναφέρεις το πρωτότυπο από τον κάδο του θησαυροφυλακίου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can restore the original from the vault trash."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes recuperar el original desde la papelera de la caja fuerte."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit palauttaa alkuperäisen holvin roskakorista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu peux récupérer l’original dans la corbeille du coffre."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે વૉલ્ટ ટ્રેશમાંથી મૂળ પુનઃસ્થાપિત કરી શકો છો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר לשחזר את המקור מהפח של הכספת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप तिजोरी के ट्रैश से मूल वापस ला सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Original možeš vratiti iz smeća trezora."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az eredetit visszaállíthatod a széf kukájából."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu bisa memulihkan aslinya dari sampah brankas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi recuperare l’originale dal cestino della cassaforte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元のファイルは保管庫のゴミ箱から戻せます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮೂಲವನ್ನು ವಾಲ್ಟ್ ಕಸದ ಬುಟ್ಟಿಯಿಂದ ಮರುಸ್ಥಾಪಿಸಬಹುದು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본은 보관함 휴지통에서 되돌릴 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒറിജിനൽ വോൾട്ട് ട്രാഷിൽ നിന്ന് പുനഃസ്ഥാപിക്കാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही व्हॉल्ट ट्रॅशमधून मूळ परत आणू शकता."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda boleh memulihkan yang asal daripada sampah peti besi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan gjenopprette originalen fra safens papirkurv."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt het origineel terugzetten vanuit de kluisprullenmand."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣ ମୂଳକୁ ଭଲ୍ଟ ଟ୍ରାସରୁ ପୁନରୁଦ୍ଧାର କରିପାରିବେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਸੀਂ ਮੂਲ ਨੂੰ ਵੌਲਟ ਦੀ ਰੱਦੀ ਤੋਂ ਬਹਾਲ ਕਰ ਸਕਦੇ ਹੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oryginał możesz przywrócić z kosza sejfu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode restaurar o original a partir da lixeira do cofre."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Podes recuperar o original no lixo do cofre."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Poți recupera originalul din coșul seifului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оригинал можно вернуть из корзины сейфа."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Originál môžete obnoviť z koša trezoru."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izvirnik lahko obnoviš iz koša sefa."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan återställa originalet från valvets papperskorg."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அசலை லாக்கர் குப்பையிலிருந்து மீட்டமைக்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఒరిజినల్‌ను వాల్ట్ ట్రాష్ నుండి పునరుద్ధరించవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณกู้คืนต้นฉบับได้จากถังขยะตู้เซฟ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Orijinali kasa çöp kutusundan geri alabilirsin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оригінал можна повернути з кошика сховища."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ والٹ کی ردی سے اصل بحال کر سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể khôi phục bản gốc từ thùng rác két sắt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可从保险库废纸篓中恢复原件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以從保險箱垃圾桶還原原始檔。"
          }
        }
      }
    },
    "vault_edit_replaced": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حُفظت في الخزنة. الأصل في سلة المحذوفات الآمنة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভল্টে সংরক্ষিত। মূলটি ভল্টের ট্র্যাশে আছে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Desat a la caixa forta. L’original és a la paperera de la caixa forta."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uloženo v trezoru. Originál je v koši trezoru."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemt i boksen. Originalen ligger i boksens papirkurv."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Tresor gespeichert. Das Original liegt im Tresor-Papierkorb."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αποθηκεύτηκε στο θησαυροφυλάκιο. Το πρωτότυπο είναι στον κάδο του θησαυροφυλακίου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved in the vault. The original is in the vault trash."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardado en la caja fuerte. El original está en la papelera de la caja fuerte."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallennettu holviin. Alkuperäinen on holvin roskakorissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistré dans le coffre. L’original est dans la corbeille du coffre."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "વૉલ્ટમાં સાચવ્યું. મૂળ વૉલ્ટ ટ્રેશમાં છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נשמר בכספת. המקור נמצא בפח של הכספת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तिजोरी में सहेजा गया। मूल तिजोरी के ट्रैश में है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spremljeno u trezor. Original je u smeću trezora."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mentve a széfbe. Az eredeti a széf kukájában van."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Disimpan di brankas. Aslinya ada di sampah brankas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvato nella cassaforte. L’originale è nel cestino della cassaforte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保管庫に保存しました。元のファイルは保管庫のゴミ箱にあります。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ವಾಲ್ಟ್‌ನಲ್ಲಿ ಉಳಿಸಲಾಗಿದೆ. ಮೂಲ ವಾಲ್ಟ್ ಕಸದ ಬುಟ್ಟಿಯಲ್ಲಿದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "금고에 저장했어요. 원본은 보관함 휴지통에 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വോൾട്ടിൽ സംരക്ഷിച്ചു. ഒറിജിനൽ വോൾട്ട് ട്രാഷിലാണ്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "व्हॉल्टमध्ये जतन केले. मूळ व्हॉल्ट ट्रॅशमध्ये आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Disimpan dalam peti besi. Yang asal berada dalam sampah peti besi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagret i safen. Originalen ligger i safens papirkurv."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opgeslagen in de kluis. Het origineel staat in de kluisprullenmand."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଭଲ୍ଟରେ ସେଭ୍ ହେଲା। ମୂଳ ଭଲ୍ଟ ଟ୍ରାସରେ ଅଛି।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਵੌਲਟ ਵਿੱਚ ਸੰਭਾਲਿਆ। ਮੂਲ ਵੌਲਟ ਦੀ ਰੱਦੀ ਵਿੱਚ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisano w sejfie. Oryginał jest w koszu sejfu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvo no cofre. O original está na lixeira do cofre."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardado no cofre. O original está no lixo do cofre."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvat în seif. Originalul este în coșul seifului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранено в сейфе. Оригинал — в корзине сейфа."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Uložené v trezore. Originál je v koši trezoru."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Shranjeno v sef. Izvirnik je v košu sefa."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparat i valvet. Originalet ligger i valvets papperskorg."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "லாக்கரில் சேமிக்கப்பட்டது. அசல் லாக்கர் குப்பையில் உள்ளது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వాల్ట్‌లో సేవ్ అయింది. ఒరిజినల్ వాల్ట్ ట్రాష్‌లో ఉంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกในตู้เซฟแล้ว ต้นฉบับอยู่ในถังขยะตู้เซฟ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasaya kaydedildi. Orijinal kasa çöp kutusunda."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збережено в сейфі. Оригінал — у кошику сховища."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "والٹ میں محفوظ۔ اصل والٹ کی ردی میں ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã lưu trong két sắt. Bản gốc nằm trong thùng rác két sắt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已存入保险箱。原件在保险库废纸篓中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已儲存到保險箱。原始檔在保險箱垃圾桶中。"
          }
        }
      }
    },
