    "wf_empty": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد مسارات عمل خاصة بعد. استخدم قالبًا أو أنشئ سير عمل جديدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine eigenen Abläufe. Übernimm eine Vorlage oder lege einen neuen Ablauf an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No workflows of your own yet. Use a template or create a new workflow."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no tienes flujos propios. Usa una plantilla o crea uno nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore de flux personnel. Utilise un modèle ou crée un nouveau flux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessun flusso personale. Usa un modello o creane uno nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分のワークフローはまだありません。テンプレートを使うか新しく作成してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 나만의 작업 흐름이 없어요. 템플릿을 사용하거나 새로 만드세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen eigen werkstromen. Gebruik een sjabloon of maak een nieuwe."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak własnych przepływów. Użyj szablonu lub utwórz nowy."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não tens fluxos próprios. Usa um modelo ou cria um novo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încă nu ai fluxuri proprii. Folosește un șablon sau creează unul nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Своих сценариев пока нет. Используйте шаблон или создайте новый."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz kendi iş akışın yok. Bir şablon kullan veya yeni bir akış oluştur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Власних сценаріїв ще немає. Використайте шаблон або створіть новий."
          }
        },
        "zh-Hans": {
