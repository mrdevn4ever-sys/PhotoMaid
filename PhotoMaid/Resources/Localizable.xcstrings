    "edit_save_replace_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يطلب iOS التأكيد. ينتقل الأصل إلى «المحذوفة مؤخرًا» في تطبيق الصور ويمكن عادةً استعادته من هناك خلال 30 يومًا. لا تتحرر المساحة إلا بعد ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS fragt nach. Das Original kommt in „Zuletzt gelöscht“ der Fotos-App und lässt sich dort normalerweise 30 Tage wiederherstellen. Speicher wird erst danach frei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS asks to confirm. The original goes to “Recently Deleted” in the Photos app and can usually be restored there for 30 days. Space is freed only after that."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS pide confirmación. El original pasa a «Eliminado» en la app Fotos y normalmente se puede recuperar allí durante 30 días. El espacio se libera solo después."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS demande confirmation. L’original va dans « Suppressions récentes » de l’app Photos et peut généralement y être récupéré pendant 30 jours. L’espace n’est libéré qu’ensuite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS chiede conferma. L’originale finisce in «Eliminati di recente» nell’app Foto e di solito si può recuperare lì per 30 giorni. Lo spazio si libera solo dopo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOSが確認します。オリジナルは写真アプリの「最近削除した項目」に移動し、通常は30日間そこから復元できます。空き容量が増えるのはその後です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS가 확인을 요청합니다. 원본은 사진 앱의 '최근 삭제된 항목'으로 이동하며 보통 30일 동안 그곳에서 복구할 수 있습니다. 공간은 그 이후에 확보됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS vraagt om bevestiging. Het origineel gaat naar ‘Recent verwijderd’ in de Foto’s-app en is daar meestal 30 dagen te herstellen. Pas daarna komt ruimte vrij."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS poprosi o potwierdzenie. Oryginał trafi do „Ostatnio usunięte” w aplikacji Zdjęcia i zwykle można go tam odzyskać przez 30 dni. Miejsce zwolni się dopiero potem."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O iOS pede confirmação. O original passa para «Apagados recentemente» na app Fotografias e normalmente pode ser recuperado aí durante 30 dias. O espaço só é libertado depois."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS cere confirmarea. Originalul ajunge în „Șterse recent” din aplicația Poze și de obicei poate fi recuperat de acolo timp de 30 de zile. Spațiul se eliberează abia după aceea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS попросит подтверждение. Оригинал попадёт в «Недавно удаленные» приложения «Фото», обычно его можно восстановить там в течение 30 дней. Место освободится только после этого."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS onay ister. Orijinal Fotoğraflar uygulamasındaki \"Son Silinenler\"e taşınır ve genellikle orada 30 gün boyunca geri yüklenebilir. Alan ancak bundan sonra boşalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS попросить підтвердження. Оригінал потрапить до «Нещодавно видалених» у програмі «Фото», зазвичай його можна відновити там протягом 30 днів. Місце звільниться лише після цього."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 会请你确认。原件将移到“照片”App 的“最近删除”中，通常可在 30 天内从那里恢复。之后才会释放空间。"
          }
        }
      }
    },
