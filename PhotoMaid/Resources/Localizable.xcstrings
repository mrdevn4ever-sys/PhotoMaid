    "vault_limit_reached": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدّ الخزنة في Free: %1$lld. مع Pro تصبح الخزنة بلا حدود."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratisversionen tillader %1$lld emner i boksen. Med Pro er boksen ubegrænset."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Free erlaubt %1$lld Medien im Tresor. Mit Pro ist er unbegrenzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free allows %1$lld items in the vault. With Pro the vault is unlimited."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Free permite %1$lld elementos en la caja fuerte. Con Pro, la caja fuerte es ilimitada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Free autorise %1$lld éléments dans le coffre-fort. Avec Pro, le coffre-fort est illimité."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Versi gratis mengizinkan %1$lld item di brankas. Dengan Pro, brankas tanpa batas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Free consente %1$lld elementi nella cassaforte. Con Pro la cassaforte è illimitata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Freeでは保管庫に%1$lld項目まで追加できます。Proなら無制限です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Free는 금고에 %1$lld개까지 허용합니다. Pro에서는 금고가 무제한입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratisversjonen tillater %1$lld elementer i safen. Med Pro er safen ubegrenset."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Free staat %1$lld onderdelen in de kluis toe. Met Pro is de kluis onbeperkt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit sejfu w Free: %1$lld. Z Pro sejf nie ma limitu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A versão grátis permite %1$lld itens no cofre. Com o Pro o cofre é ilimitado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Free permite %1$lld itens no cofre. Com o Pro, o cofre é ilimitado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Limita seifului în Free: %1$lld. Cu Pro, seiful este nelimitat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лимит сейфа во Free: %1$lld. С Pro сейф без ограничений."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratisversionen tillåter %1$lld objekt i valvet. Med Pro är valvet obegränsat."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวอร์ชันฟรีเก็บในตู้เซฟได้ %1$lld รายการ กับ Pro ตู้เซฟไม่จำกัด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Free, kasada %1$lld öğeye izin verir. Pro ile kasa sınırsızdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ліміт сейфа у Free: %1$lld. З Pro сейф без обмежень."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản miễn phí cho phép %1$lld mục trong két sắt. Với Pro, két sắt không giới hạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Free 版保险箱最多 %1$lld 项。使用 Pro 时保险箱不限数量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "免費版保險箱可存放 %1$lld 個項目。使用 Pro 則無限制。"
          }
        }
      }
    },
    "vault_locked_wait": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محاولات كثيرة جدًا. حاول مرة أخرى بعد %1$@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For mange forsøg. Prøv igen om %1$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele Versuche. Versuche es in %1$@ erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many attempts. Try again in %1$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiados intentos. Inténtalo de nuevo dentro de %1$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de tentatives. Réessaie dans %1$@."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terlalu banyak percobaan. Coba lagi dalam %1$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Troppi tentativi. Riprova tra %1$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "試行回数が多すぎます。%1$@後にもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시도 횟수가 너무 많습니다. %1$@ 후에 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For mange forsøk. Prøv igjen om %1$@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te veel pogingen. Probeer het over %1$@ opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbyt wiele prób. Spróbuj ponownie za %1$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tentativas demais. Tente de novo em %1$@."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiadas tentativas. Tenta novamente daqui a %1$@."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Prea multe încercări. Încearcă din nou peste %1$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слишком много попыток. Попробуй ещё раз через %1$@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För många försök. Försök igen om %1$@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลองหลายครั้งเกินไป ลองอีกครั้งใน %1$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çok fazla deneme yapıldı. %1$@ sonra tekrar dene."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Забагато спроб. Спробуй ще раз через %1$@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thử quá nhiều lần. Hãy thử lại sau %1$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尝试次数过多。请在 %1$@后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "嘗試次數過多。請在 %1$@ 後再試一次。"
          }
        }
      }
    },
