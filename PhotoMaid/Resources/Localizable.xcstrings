        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видаляй скільки потрібно — без денного ліміту %1$lld."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa bao nhiêu tùy thích — không có giới hạn hằng ngày %1$lld."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
