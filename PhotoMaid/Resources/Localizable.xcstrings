        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipp: Leere „Zuletzt gelöscht“ in der Fotos-App, wenn sie auch dort verschwinden sollen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συμβουλή: άδειασε τα «Πρόσφατα διαγραμμένα» στις Φωτογραφίες αν πρέπει να χαθούν κι από εκεί."
          }
        },
        "en": {
