    "snake_shuffle_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُطبق الخلط على اللعبة الجديدة التالية. تغيير الصور يوقف اللعبة الحالية مؤقتًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এলোমেলো করা পরের নতুন গেমে প্রযোজ্য। ফটো বদলালে বর্তমান গেম থেমে যায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La barreja s’aplica a la pròxima partida nova. Canviar les fotos posa en pausa la partida actual."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamíchání platí pro příští novou hru. Změna fotek pozastaví aktuální hru."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanding gælder for det næste nye spil. Skift af fotos sætter det aktuelle spil på pause."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mischen gilt für die nächste neue Runde. Fotoänderungen pausieren das laufende Spiel."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το ανακάτεμα ισχύει για το επόμενο νέο παιχνίδι. Η αλλαγή φωτογραφιών θέτει σε παύση το τρέχον παιχνίδι."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shuffle applies to the next new game. Changing photos pauses the current game."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mezcla se aplica a la siguiente partida nueva. Cambiar fotos pausa la partida actual."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekoitus koskee seuraavaa uutta peliä. Kuvien vaihtaminen keskeyttää nykyisen pelin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mélange s’applique à la prochaine nouvelle partie. Modifier les photos met la partie actuelle en pause."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "મિક્સ કરવું આગળની નવી રમતને લાગુ થાય છે. ફોટા બદલવાથી વર્તમાન રમત થોભે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הערבוב חל על המשחק החדש הבא. החלפת תמונות משהה את המשחק הנוכחי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मिलाना अगले नए गेम पर लागू होता है। फ़ोटो बदलने से मौजूदा गेम रुक जाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Miješanje vrijedi za sljedeću novu igru. Promjena fotografija pauzira trenutačnu igru."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A keverés a következő új játékra vonatkozik. A fotók módosítása szünetelteti az aktuális játékot."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Acak berlaku untuk game baru berikutnya. Mengganti foto menjeda game saat ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La riproduzione casuale si applica alla prossima nuova partita. Cambiare foto mette in pausa la partita attuale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シャッフルは次の新しいゲームに適用されます。写真を変更すると現在のゲームが一時停止します。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಷಫಲ್ ಮುಂದಿನ ಹೊಸ ಆಟಕ್ಕೆ ಅನ್ವಯಿಸುತ್ತದೆ. ಫೋಟೋಗಳನ್ನು ಬದಲಾಯಿಸಿದರೆ ಪ್ರಸ್ತುತ ಆಟ ವಿರಾಮಗೊಳ್ಳುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "섞기는 다음 새 게임에 적용됩니다. 사진을 바꾸면 현재 게임이 일시 정지됩니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഷഫിൾ അടുത്ത പുതിയ ഗെയിമിന് ബാധകമാണ്. ഫോട്ടോകൾ മാറ്റിയാൽ നിലവിലെ ഗെയിം താൽക്കാലികമായി നിർത്തും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मिसळणे पुढच्या नव्या खेळाला लागू होते. फोटो बदलल्याने सध्याचा खेळ थांबतो."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kocok terpakai untuk permainan baharu seterusnya. Menukar foto menjeda permainan semasa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Blandingen gjelder neste nye spill. Å bytte bilder setter det pågående spillet på pause."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengen geldt voor het volgende nieuwe spel. Foto's wijzigen pauzeert het huidige spel."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ମିଶାଇବା ପରବର୍ତ୍ତୀ ନୂଆ ଖେଳରେ ଲାଗୁ ହୁଏ। ଫଟୋ ବଦଳାଇଲେ ବର୍ତ୍ତମାନର ଖେଳ ବିରତି ହୁଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਰਲਾਉਣਾ ਅਗਲੀ ਨਵੀਂ ਖੇਡ ਉੱਤੇ ਲਾਗੂ ਹੁੰਦਾ ਹੈ। ਫ਼ੋਟੋਆਂ ਬਦਲਣ ਨਾਲ ਮੌਜੂਦਾ ਖੇਡ ਰੁਕ ਜਾਂਦੀ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasowanie dotyczy następnej nowej gry. Zmiana zdjęć wstrzymuje bieżącą grę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Embaralhar vale para o próximo jogo novo. Trocar fotos pausa o jogo atual."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A mistura aplica-se ao próximo jogo novo. Alterar fotos pausa o jogo atual."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Amestecarea se aplică următorului joc nou. Modificarea fotografiilor pune jocul curent pe pauză."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перемешивание применяется к следующей новой игре. Изменение фото ставит текущую игру на паузу."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamiešanie platí pre ďalšiu novú hru. Zmena fotiek pozastaví aktuálnu hru."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mešanje velja za naslednjo novo igro. Sprememba fotografij začasno ustavi trenutno igro."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Blandningen gäller nästa nya spel. Att byta bilder pausar det pågående spelet."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கலக்குதல் அடுத்த புதிய விளையாட்டிற்குப் பொருந்தும். புகைப்படங்களை மாற்றினால் தற்போதைய விளையாட்டு இடைநிறுத்தப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "షఫుల్ తదుపరి కొత్త గేమ్‌కి వర్తిస్తుంది. ఫోటోలు మారిస్తే ప్రస్తుత గేమ్ పాజ్ అవుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การสลับจะมีผลกับเกมใหม่ครั้งถัดไป การเปลี่ยนรูปจะหยุดเกมปัจจุบันชั่วคราว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karıştırma sonraki yeni oyun için geçerlidir. Fotoğrafları değiştirmek mevcut oyunu duraklatır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перемішування діє для наступної нової гри. Зміна фото призупиняє поточну гру."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ملانا اگلی نئی گیم پر لاگو ہوتا ہے۔ تصاویر بدلنے سے موجودہ گیم رک جاتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xáo trộn áp dụng cho ván mới tiếp theo. Đổi ảnh sẽ tạm dừng ván hiện tại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打乱仅用于下一局新游戏。更改照片会暂停当前游戏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隨機排列會套用到下一場新遊戲。更換照片會暫停目前的遊戲。"
          }
        }
      }
    },
