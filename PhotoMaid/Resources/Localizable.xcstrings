    "blocks_gestures": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اللوحة: اسحب جانبياً، انقر للتدوير، واسحب للأسفل ببطء أو بسرعة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বোর্ড: পাশে সোয়াইপ করুন, ঘোরাতে ট্যাপ করুন, নিচে টানুন বা ঝটকা দিন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tauler: llisca de costat, toca per girar, arrossega o llisca ràpid avall."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hrací plocha: přejeďte do strany, klepnutím otočíte, táhněte nebo švihněte dolů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Spillebræt: swipe til siden, tryk for at rotere, træk eller svirp nedad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spielfeld: seitlich wischen, zum Drehen tippen, nach unten ziehen oder schnell wischen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ταμπλό: σύρε πλάγια, πάτησε για περιστροφή, σύρε ή τίναξε προς τα κάτω."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Board: swipe sideways, tap to rotate, drag or flick down."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tablero: desliza a los lados, toca para girar y arrastra o desliza rápido hacia abajo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelilauta: pyyhkäise sivulle, napauta kääntääksesi, vedä tai sipaise alas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plateau : glisse de côté, touche pour tourner, glisse lentement ou rapidement vers le bas."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બોર્ડ: બાજુમાં સ્વાઇપ કરો, ફેરવવા ટૅપ કરો, નીચે ખેંચો કે ઝટકો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לוח: החלקה הצידה, הקשה לסיבוב, גרירה או הנפה למטה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बोर्ड: बगल में स्वाइप करें, घुमाने के लिए टैप करें, नीचे खींचें या झटकें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ploča: povuci u stranu, dodirni za okretanje, povuci ili brzo potegni prema dolje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tábla: húzd oldalra, koppints a forgatáshoz, húzd vagy pöccintsd lefelé."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Papan: geser ke samping, ketuk untuk memutar, seret atau sentak ke bawah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Campo: scorri di lato, tocca per ruotare, trascina o scorri velocemente in basso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "盤面：左右にスワイプ、タップで回転、下にドラッグまたは素早くスワイプ。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಬೋರ್ಡ್: ಪಕ್ಕಕ್ಕೆ ಸ್ವೈಪ್ ಮಾಡಿ, ತಿರುಗಿಸಲು ಟ್ಯಾಪ್ ಮಾಡಿ, ಕೆಳಗೆ ಎಳೆಯಿರಿ ಅಥವಾ ಫ್ಲಿಕ್ ಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보드: 좌우로 밀기, 탭하여 회전, 아래로 끌거나 빠르게 밀기."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ബോർഡ്: വശത്തേക്ക് സ്വൈപ്പ് ചെയ്യുക, തിരിക്കാൻ ടാപ്പ് ചെയ്യുക, താഴേക്ക് വലിക്കുക അല്ലെങ്കിൽ ഫ്ലിക്ക് ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "बोर्ड: बाजूला स्वाइप करा, फिरवण्यासाठी टॅप करा, खाली ओढा किंवा झटका."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Papan: leret ke tepi, ketik untuk putar, seret atau jentik ke bawah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Brett: sveip sidelengs, trykk for å rotere, dra eller sveip raskt ned."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Speelveld: veeg opzij, tik om te draaien, sleep of veeg snel omlaag."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ବୋର୍ଡ: ପାର୍ଶ୍ୱକୁ ସ୍ୱାଇପ୍ କରନ୍ତୁ, ଘୁରାଇବାକୁ ଟାପ୍ କରନ୍ତୁ, ତଳକୁ ଟାଣନ୍ତୁ କିମ୍ବା ଝଟକା ଦିଅନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਬੋਰਡ: ਪਾਸੇ ਸਵਾਈਪ ਕਰੋ, ਘੁਮਾਉਣ ਲਈ ਟੈਪ ਕਰੋ, ਹੇਠਾਂ ਖਿੱਚੋ ਜਾਂ ਝਟਕੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plansza: przesuń w bok, stuknij, aby obrócić, przeciągnij lub szybko przesuń w dół."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabuleiro: deslize para os lados, toque para girar, arraste ou deslize rapidamente para baixo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabuleiro: desliza para os lados, toca para rodar, arrasta ou desliza rapidamente para baixo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tablă: glisează lateral, atinge pentru rotire, trage sau glisează rapid în jos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поле: свайп вбок, касание для поворота, медленный или резкий свайп вниз."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hracia plocha: potiahnite nabok, klepnutím otočíte, ťahajte alebo švihnite nadol."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plošča: podrsaj vstran, tapni za vrtenje, vleci ali hitro podrsaj navzdol."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spelplan: svep åt sidan, tryck för att rotera, dra eller snärta nedåt."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பலகை: பக்கவாட்டில் ஸ்வைப் செய்யுங்கள், சுழற்ற தட்டுங்கள், கீழே இழுங்கள் அல்லது சுண்டுங்கள்."
          }
