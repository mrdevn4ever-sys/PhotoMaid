    "result_reconcile": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سنتحقق من النتيجة عند فتح التطبيق مجددًا. لن يُحذف أي شيء مرة أخرى."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi tjekker resultatet, næste gang du åbner appen. Intet slettes igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim nächsten Start prüfen wir das Ergebnis. Es wird nichts erneut gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We’ll check the result next time you open the app. Nothing will be deleted again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprobaremos el resultado la próxima vez que abras la app. No se volverá a borrar nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous vérifierons le résultat à la prochaine ouverture. Rien ne sera supprimé une seconde fois."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami akan memeriksa hasilnya saat kamu membuka app lagi. Tidak ada yang akan dihapus lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificheremo il risultato alla prossima apertura. Nulla verrà eliminato una seconda volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次回アプリを開いたときに結果を確認します。同じ削除を繰り返すことはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음에 앱을 열 때 결과를 확인해요. 같은 삭제 작업을 반복하지 않아요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi sjekker resultatet neste gang du åpner appen. Ingenting slettes på nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We controleren het resultaat bij de volgende start. Er wordt niets opnieuw verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdzimy wynik przy następnym uruchomieniu. Nic nie zostanie usunięte ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vamos conferir o resultado na próxima vez que você abrir o app. Nada será apagado de novo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificaremos o resultado na próxima abertura. Nada será eliminado novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vom verifica rezultatul la următoarea deschidere. Nimic nu va fi șters din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверим результат при следующем запуске. Ничего не будет удалено повторно."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi kontrollerar resultatet nästa gång du öppnar appen. Inget raderas igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เราจะตรวจสอบผลลัพธ์ในครั้งถัดไปที่คุณเปิดแอพ จะไม่มีอะไรถูกลบซ้ำ"
