            "value": "Els elements es queden a la caixa forta, però sense carpeta."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Položky zůstanou v trezoru, jen bez složky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Emnerne bliver i boksen, bare uden mappe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Medien bleiben im Tresor, nur ohne Ordner."
