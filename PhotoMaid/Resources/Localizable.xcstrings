    "basket_confirm_media_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أكّد بعد ذلك في نافذة iOS. تنتقل الصور ومقاطع الفيديو إلى «المحذوفة مؤخرًا» في تطبيق الصور."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তারপর iOS ডায়ালগে নিশ্চিত করুন। ফটো ও ভিডিও ফটো অ্যাপের “সম্প্রতি মুছে ফেলা”-তে চলে যায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Després confirma-ho al diàleg de l’iOS. Les fotos i els vídeos passen a «Eliminat recentment» a l’app Fotos."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pak potvrďte v dialogu iOS. Fotky a videa se přesunou do „Nedávno smazaných“ v aplikaci Fotky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekræft derefter i iOS-dialogen. Fotos og videoer flyttes til “Senest slettet” i appen Fotos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätige anschließend im Dialog von iOS. Die Fotos und Videos kommen in „Zuletzt gelöscht“ der Fotos-App."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μετά επιβεβαίωσε στο παράθυρο του iOS. Οι φωτογραφίες και τα βίντεο μετακινούνται στα «Πρόσφατα διαγραμμένα» της εφαρμογής Φωτογραφίες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Then confirm in the iOS dialog. The photos and videos move to “Recently Deleted” in the Photos app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después confirma en el cuadro de iOS. Las fotos y los vídeos pasan a «Eliminado» en la app Fotos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vahvista sitten iOS:n valintaikkunassa. Kuvat ja videot siirtyvät Kuvat-apin kansioon ”Äskettäin poistetut”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmez ensuite dans la fenêtre d’iOS. Les photos et vidéos vont dans « Suppressions récentes » de l’app Photos."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પછી iOS સંવાદમાં પુષ્ટિ કરો. ફોટા અને વીડિયો ફોટો ઍપના “તાજેતરમાં ડિલીટ કરેલ” માં જાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אחר כך יש לאשר בחלון של iOS. התמונות והסרטונים עוברים אל „נמחקו לאחרונה” ביישום ״תמונות״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फिर iOS डायलॉग में पुष्टि करें। फ़ोटो और वीडियो तस्वीरें ऐप के “हाल ही में डिलीट किए गए” में चले जाते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatim potvrdi u iOS dijalogu. Fotografije i videozapisi prelaze u „Nedavno izbrisano” u aplikaciji Fotografije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezután erősítsd meg az iOS párbeszédablakában. A fotók és videók a Fotók app „Nemrég törölt” albumába kerülnek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lalu konfirmasi di dialog iOS. Foto dan video dipindahkan ke “Baru Dihapus” di app Foto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Poi conferma nella finestra di iOS. Foto e video finiscono in «Eliminati di recente» nell’app Foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続けてiOSのダイアログで確認してください。写真とビデオは写真アプリの「最近削除した項目」に移動します。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಂತರ iOS ಡೈಲಾಗ್‌ನಲ್ಲಿ ದೃಢೀಕರಿಸಿ. ಫೋಟೋಗಳು ಮತ್ತು ವೀಡಿಯೊಗಳು ಫೋಟೋಗಳು ಆ್ಯಪ್‌ನ “ಇತ್ತೀಚೆಗೆ ಅಳಿಸಲಾಗಿದೆ” ಗೆ ಹೋಗುತ್ತವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이어서 iOS 대화상자에서 확인하세요. 사진과 비디오는 사진 앱의 '최근 삭제된 항목'으로 이동합니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "തുടർന്ന് iOS ഡയലോഗിൽ സ്ഥിരീകരിക്കുക. ഫോട്ടോകളും വീഡിയോകളും ഫോട്ടോസ് ആപ്പിലെ “അടുത്തിടെ ഇല്ലാതാക്കിയവ”-ലേക്ക് നീങ്ങും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मग iOS संवादात पुष्टी करा. फोटो आणि व्हिडिओ फोटो अ‍ॅपच्या “अलीकडे डिलीट केलेले” मध्ये जातात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kemudian sahkan dalam dialog iOS. Foto dan video dialihkan ke “Dipadam Baru-baru Ini” dalam app Foto."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekreft deretter i iOS-dialogen. Bildene og videoene flyttes til «Nylig slettet» i Bilder-appen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevestig daarna in het iOS-venster. De foto’s en video’s gaan naar ‘Recent verwijderd’ in de Foto’s-app."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ତାପରେ iOS ଡାଏଲଗ୍‌ରେ ନିଶ୍ଚିତ କରନ୍ତୁ। ଫଟୋ ଓ ଭିଡିଓ ଫଟୋ ଆପ୍‌ର “ନିକଟରେ ଡିଲିଟ୍ ହୋଇଥିବା”କୁ ଯାଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਫਿਰ iOS ਡਾਇਲਾਗ ਵਿੱਚ ਪੁਸ਼ਟੀ ਕਰੋ। ਫ਼ੋਟੋਆਂ ਅਤੇ ਵੀਡੀਓ ਫ਼ੋਟੋਆਂ ਐਪ ਦੇ “ਹਾਲ ਹੀ ਵਿੱਚ ਮਿਟਾਏ ਗਏ” ਵਿੱਚ ਚਲੇ ਜਾਂਦੇ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potem potwierdź w oknie iOS. Zdjęcia i filmy trafią do „Ostatnio usunięte” w aplikacji Zdjęcia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois confirme no diálogo do iOS. As fotos e vídeos vão para “Apagados” no app Fotos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois confirme na janela do iOS. As fotografias e vídeos passam para «Apagados recentemente» na app Fotografias."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apoi confirmă în dialogul iOS. Pozele și videoclipurile ajung în „Șterse recent” din aplicația Poze."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Затем подтвердите в окне iOS. Фото и видео попадут в «Недавно удаленные» приложения «Фото»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Potom potvrďte v dialógu iOS. Fotky a videá sa presunú do „Nedávno vymazaných“ v aplikácii Fotky."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nato potrdi v pogovornem oknu iOS. Fotografije in videoposnetki se premaknejo v »Nedavno izbrisano« v aplikaciji Fotografije."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekräfta sedan i iOS-dialogen. Bilderna och videorna flyttas till ”Nyligen raderade” i appen Bilder."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பின்னர் iOS உரையாடலில் உறுதிப்படுத்துங்கள். புகைப்படங்களும் வீடியோக்களும் Photos ஆப்பின் “சமீபத்தில் நீக்கியவை”-க்குச் செல்லும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆ తర్వాత iOS డైలాగ్‌లో నిర్ధారించండి. ఫోటోలు, వీడియోలు Photos యాప్‌లోని “ఇటీవల తొలగించినవి”కి వెళ్తాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จากนั้นยืนยันในหน้าต่างของ iOS รูปภาพและวิดีโอจะย้ายไปที่ “ที่ลบล่าสุด” ในแอพรูปภาพ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ardından iOS penceresinde onayla. Fotoğraflar ve videolar Fotoğraflar uygulamasındaki \"Son Silinenler\"e taşınır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Потім підтвердьте у вікні iOS. Фото й відео потраплять до «Нещодавно видалених» у програмі «Фото»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پھر iOS ڈائیلاگ میں تصدیق کریں۔ تصاویر اور ویڈیوز تصاویر ایپ کے ”حال ہی میں حذف کردہ“ میں چلی جاتی ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sau đó xác nhận trong hộp thoại iOS. Ảnh và video sẽ chuyển vào “Đã xóa gần đây” trong ứng dụng Ảnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "然后在 iOS 对话框中确认。照片和视频将移到“照片”App 的“最近删除”中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "接著在 iOS 對話框中確認。照片和影片會移到「照片」App 的「最近刪除」。"
          }
        }
      }
    },
