    "pro_msg_pending": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عملية الشراء بانتظار التأكيد. سيتم تفعيل Pro بعد تأكيدها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার কেনাকাটা নিশ্চিতকরণের অপেক্ষায়। নিশ্চিত হলেই Pro আনলক হবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La compra està pendent de confirmació. Pro es desbloquejarà quan es confirmi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš nákup čeká na potvrzení. Pro se odemkne po potvrzení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit køb venter på bekræftelse. Pro låses op, så snart det er bekræftet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Kauf wird noch bestätigt. Danach wird Pro freigeschaltet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αγορά σου περιμένει επιβεβαίωση. Το Pro θα ξεκλειδωθεί μόλις επιβεβαιωθεί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your purchase is awaiting confirmation. Pro will unlock once it’s confirmed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu compra está pendiente de confirmación. Pro se desbloqueará cuando se confirme."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostosi odottaa vahvistusta. Pro avautuu, kun osto on vahvistettu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton achat attend une confirmation. Pro sera débloqué une fois l’achat confirmé."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારી ખરીદી પુષ્ટિની રાહમાં છે. પુષ્ટિ થતાં જ Pro અનલૉક થશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הרכישה ממתינה לאישור. Pro ייפתח כשהיא תאושר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी खरीदारी पुष्टि की प्रतीक्षा में है। पुष्टि होते ही Pro अनलॉक होगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoja kupnja čeka potvrdu. Pro će se otključati nakon potvrde."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A vásárlásod megerősítésre vár. A Pro a megerősítés után oldódik fel."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembelianmu menunggu konfirmasi. Pro akan terbuka setelah dikonfirmasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo acquisto è in attesa di conferma. Pro verrà sbloccato appena sarà confermato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入の確認を待っています。確認後にProが有効になります。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಖರೀದಿ ದೃಢೀಕರಣಕ್ಕಾಗಿ ಕಾಯುತ್ತಿದೆ. ದೃಢೀಕರಿಸಿದ ತಕ್ಷಣ Pro ಅನ್‌ಲಾಕ್ ಆಗುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매 확인을 기다리고 있어요. 확인되면 Pro가 활성화돼요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ വാങ്ങൽ സ്ഥിരീകരണത്തിനായി കാത്തിരിക്കുന്നു. സ്ഥിരീകരിച്ചാലുടൻ Pro അൺലോക്ക് ആകും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमची खरेदी पुष्टीच्या प्रतीक्षेत आहे. पुष्टी होताच Pro अनलॉक होईल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembelian anda menunggu pengesahan. Pro akan dibuka setelah ia disahkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjøpet ditt venter på bekreftelse. Pro låses opp når det er bekreftet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je aankoop wacht op bevestiging. Daarna wordt Pro ontgrendeld."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ କିଣାକିଣି ନିଶ୍ଚିତକରଣ ଅପେକ୍ଷାରେ। ନିଶ୍ଚିତ ହେବା ମାତ୍ରେ Pro ଅନଲକ୍ ହେବ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੀ ਖ਼ਰੀਦ ਪੁਸ਼ਟੀ ਦੀ ਉਡੀਕ ਵਿੱਚ ਹੈ। ਪੁਸ਼ਟੀ ਹੁੰਦੇ ਹੀ Pro ਅਨਲੌਕ ਹੋ ਜਾਵੇਗਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój zakup czeka na potwierdzenie. Po potwierdzeniu Pro zostanie odblokowane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua compra aguarda confirmação. O Pro será desbloqueado assim que for confirmada."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A tua compra aguarda confirmação. O Pro será desbloqueado quando for confirmada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Achiziția ta așteaptă confirmarea. Pro se va debloca după confirmare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покупка ожидает подтверждения. После этого Pro станет доступен."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš nákup čaká na potvrdenie. Pro sa odomkne po potvrdení."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoj nakup čaka na potrditev. Pro se odklene po potrditvi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt köp väntar på bekräftelse. Pro låses upp när det bekräftats."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் வாங்குதல் உறுதிப்படுத்தலுக்காகக் காத்திருக்கிறது. உறுதிப்படுத்தியதும் Pro திறக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ కొనుగోలు నిర్ధారణ కోసం వేచి ఉంది. నిర్ధారించిన వెంటనే Pro అన్‌లాక్ అవుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การซื้อของคุณกำลังรอการยืนยัน Pro จะปลดล็อกเมื่อได้รับการยืนยัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satın alman onay bekliyor. Onaylanınca Pro açılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Покупка очікує підтвердження. Після нього Pro стане доступним."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی خریداری تصدیق کی منتظر ہے۔ تصدیق ہوتے ہی Pro ان لاک ہو گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giao dịch mua đang chờ xác nhận. Pro sẽ mở khóa khi được xác nhận."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "购买正在等待确认。确认后即可启用 Pro。"
