    "wf_target_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقيس PhotoMaid النتيجة. إذا تعذّر بلوغ الهدف ضمن هذه الحدود فلن يُنشأ ملف وسترى السبب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid misst das Ergebnis. Ist das Ziel innerhalb dieser Grenzen nicht erreichbar, entsteht keine Datei und du siehst, warum."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid measures the result. If the target can’t be reached within these limits, no file is created and you’ll see why."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid mide el resultado. Si no se puede alcanzar el objetivo dentro de estos límites, no se crea ningún archivo y verás por qué."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid mesure le résultat. Si l’objectif est inatteignable dans ces limites, aucun fichier n’est créé et tu sauras pourquoi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid misura il risultato. Se l’obiettivo non è raggiungibile entro questi limiti, non viene creato alcun file e vedrai perché."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaidは結果を測定します。この範囲で目標に届かない場合はファイルを作らず、理由を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid는 결과를 측정해요. 이 범위에서 목표에 도달할 수 없으면 파일을 만들지 않고 이유를 보여 줘요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid meet het resultaat. Is het doel binnen deze grenzen niet haalbaar, dan ontstaat er geen bestand en zie je waarom."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid mierzy wynik. Jeśli celu nie da się osiągnąć w tych granicach, plik nie powstanie, a zobaczysz dlaczego."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O PhotoMaid mede o resultado. Se o objetivo não for alcançável dentro destes limites, não é criado nenhum ficheiro e vês porquê."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid măsoară rezultatul. Dacă ținta nu poate fi atinsă în aceste limite, nu se creează niciun fișier și vezi de ce."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid измеряет результат. Если цель недостижима в этих пределах, файл не создаётся, и вы увидите причину."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid sonucu ölçer. Hedefe bu sınırlar içinde ulaşılamazsa dosya oluşturulmaz ve nedenini görürsün."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid вимірює результат. Якщо мети не досягти в цих межах, файл не створюється, і ви побачите причину."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid 会测量结果。如果在这些限制内无法达到目标，就不会创建文件，并显示原因。"
          }
        }
      }
    },
