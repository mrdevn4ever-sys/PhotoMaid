    "help_delete_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يؤدي السحب إلى حذف أي شيء. تنتقل العناصر أولاً إلى سلة GaleriQ، وبعد تأكيدك ينقلها iOS إلى «المحذوفة مؤخراً»."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipes sletter aldrig noget. Emner havner først i GaleriQ-papirkurven. Først når du bekræfter der, flytter iOS fotos og videoer til Senest slettet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Wischen wird nie etwas gelöscht. Medien landen zuerst im GaleriQ-Papierkorb. Erst nach deiner Bestätigung verschiebt iOS Fotos und Videos in ‚Zuletzt gelöscht‘."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swiping never deletes anything. Items first enter GaleriQ’s trash. Only after you confirm there does iOS move photos and videos to Recently Deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslizar nunca elimina nada. Los elementos van primero a la papelera de GaleriQ; tras confirmarlo, iOS los mueve a Eliminado recientemente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un balayage ne supprime rien. Les éléments vont d’abord dans la corbeille GaleriQ ; après confirmation, iOS les place dans Suppressions récentes."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menggeser tidak pernah menghapus apa pun. Item masuk dulu ke sampah GaleriQ. Baru setelah kamu konfirmasi di sana, iOS memindahkan foto dan video ke Baru Dihapus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo scorrimento non elimina nulla. Gli elementi vanno prima nel cestino GaleriQ; dopo la conferma iOS li sposta in Eliminati di recente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スワイプだけでは削除されません。まずGaleriQのゴミ箱に入り、確認後にiOSの「最近削除した項目」へ移動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쓸어 넘기기만으로 삭제되지 않습니다. 먼저 GaleriQ 휴지통에 들어가며 확인 후 iOS의 최근 삭제된 항목으로 이동합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sveiping sletter aldri noe. Elementer havner først i GaleriQ-papirkurven. Først når du bekrefter der, flytter iOS bilder og videoer til Nylig slettet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vegen verwijdert niets. Items gaan eerst naar de GaleriQ-prullenbak; na bevestiging verplaatst iOS ze naar Recent verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesunięcie niczego nie usuwa. Elementy trafiają najpierw do kosza GaleriQ; po potwierdzeniu iOS przenosi je do Ostatnio usuniętych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslizar nunca apaga nada. Os itens vão primeiro para a lixeira do GaleriQ. Só depois que você confirmar lá o iOS move fotos e vídeos para Apagados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslizar não elimina nada. Os itens vão primeiro para o lixo do GaleriQ; após confirmar, o iOS move-os para Apagados recentemente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Glisarea nu șterge nimic. Elementele ajung întâi în coșul GaleriQ; după confirmare, iOS le mută în Șterse recent."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смахивание ничего не удаляет. Объекты сначала попадают в корзину GaleriQ; после подтверждения iOS перемещает их в «Недавно удалённые»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att svepa raderar aldrig något. Objekten hamnar först i GaleriQ-papperskorgen. Först när du bekräftar där flyttar iOS bilder och videor till Nyligen raderade."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การปัดไม่เคยลบอะไร รายการจะเข้าถังขยะของ GaleriQ ก่อน หลังจากคุณยืนยันที่นั่นแล้วเท่านั้น iOS จึงย้ายรูปภาพและวิดีโอไปที่ “ที่ลบล่าสุด”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydırma hiçbir şeyi silmez. Öğeler önce GaleriQ çöpüne gider; onaydan sonra iOS onları Son Silinenler’e taşır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гортання нічого не видаляє. Об’єкти спочатку потрапляють у кошик GaleriQ; після підтвердження iOS переміщує їх у «Недавно видалені»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuốt không bao giờ xóa gì cả. Các mục vào thùng rác GaleriQ trước. Chỉ sau khi bạn xác nhận ở đó, iOS mới chuyển ảnh và video vào Đã xóa gần đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻扫不会删除任何内容。项目会先进入 GaleriQ 废纸篓，确认后 iOS 才会将其移到“最近删除”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "滑動永遠不會刪除任何內容。項目會先進入 GaleriQ 垃圾桶。只有在你在那裡確認後，iOS 才會將照片和影片移到「最近刪除」。"
          }
        }
      }
    },
