    "edits_empty_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عندما تعدّل صورة أو تحفظ كولاجًا أو فيلمًا أو صورًا مصغّرة، تظهر النتيجة هنا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি কোনো ফটো সম্পাদনা করলে বা কোলাজ, মুভি বা আকার বদলানো ছবি সংরক্ষণ করলে ফলাফল এখানে দেখা যায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Quan editis una foto o desis un collage, una pel·lícula o imatges redimensionades, el resultat apareixerà aquí."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když upravíte fotku nebo uložíte koláž, film či zmenšené obrázky, výsledek se zobrazí tady."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du redigerer et foto eller gemmer en collage, en film eller billeder med ændret størrelse, vises resultatet her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du ein Foto bearbeitest oder eine Collage, einen Film oder verkleinerte Bilder speicherst, erscheint das Ergebnis hier."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν επεξεργαστείς μια φωτογραφία ή αποθηκεύσεις κολάζ, ταινία ή μικρότερες εικόνες, το αποτέλεσμα εμφανίζεται εδώ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you edit a photo or save a collage, a movie or resized images, the result appears here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando editas una foto o guardas un collage, una película o imágenes reducidas, el resultado aparece aquí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun muokkaat kuvaa tai tallennat kollaasin, elokuvan tai pienennettyjä kuvia, tulos näkyy tässä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand tu modifies une photo ou enregistres un collage, un film ou des images réduites, le résultat apparaît ici."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે ફોટામાં ફેરફાર કરો અથવા કોલાજ, મૂવી કે નાની કરેલી છબીઓ સાચવો ત્યારે પરિણામ અહીં દેખાશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כשעורכים תמונה או שומרים קולאז׳, סרט או תמונות מוקטנות, התוצאה מופיעה כאן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब आप कोई फ़ोटो एडिट करें या कोलाज, मूवी या छोटी की गई इमेज सहेजें, तो नतीजा यहाँ दिखेगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad urediš fotografiju ili spremiš kolaž, film ili smanjene slike, rezultat se prikazuje ovdje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha szerkesztesz egy fotót, vagy kollázst, filmet vagy kicsinyített képeket mentesz, az eredmény itt jelenik meg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat kamu mengedit foto atau menyimpan kolase, film, atau gambar yang diubah ukurannya, hasilnya muncul di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando modifichi una foto o salvi un collage, un filmato o immagini ridotte, il risultato compare qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真を編集したり、コラージュ、ムービー、縮小した画像を保存したりすると、ここに表示されます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಫೋಟೋ ಎಡಿಟ್ ಮಾಡಿದಾಗ ಅಥವಾ ಕೊಲಾಜ್, ಮೂವಿ ಅಥವಾ ಗಾತ್ರ ಬದಲಿಸಿದ ಚಿತ್ರಗಳನ್ನು ಉಳಿಸಿದಾಗ ಫಲಿತಾಂಶ ಇಲ್ಲಿ ಕಾಣಿಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진을 편집하거나 콜라주, 영상, 축소한 이미지를 저장하면 결과가 여기에 표시돼요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ ഒരു ഫോട്ടോ എഡിറ്റ് ചെയ്യുമ്പോഴോ കൊളാഷ്, മൂവി അല്ലെങ്കിൽ വലുപ്പം മാറ്റിയ ചിത്രങ്ങൾ സംരക്ഷിക്കുമ്പോഴോ ഫലം ഇവിടെ കാണാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही फोटो संपादित केल्यावर किंवा कोलाज, मूव्ही किंवा लहान केलेल्या प्रतिमा जतन केल्यावर निकाल इथे दिसेल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apabila anda menyunting foto atau menyimpan kolaj, filem atau imej yang dikecilkan, hasilnya dipaparkan di sini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du redigerer et bilde eller lagrer en collage, en film eller bilder med endret størrelse, vises resultatet her."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je een foto bewerkt of een collage, film of verkleinde afbeeldingen bewaart, verschijnt het resultaat hier."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣ ଏକ ଫଟୋ ଏଡିଟ୍ କଲେ କିମ୍ବା କୋଲାଜ୍, ମୁଭି କିମ୍ବା ଆକାର ବଦଳାଯାଇଥିବା ଛବି ସେଭ୍ କଲେ ଫଳାଫଳ ଏଠାରେ ଦେଖାଯାଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਦੋਂ ਤੁਸੀਂ ਕੋਈ ਫ਼ੋਟੋ ਸੋਧਦੇ ਹੋ ਜਾਂ ਕੋਲਾਜ, ਮੂਵੀ ਜਾਂ ਆਕਾਰ ਬਦਲੀਆਂ ਤਸਵੀਰਾਂ ਸੰਭਾਲਦੇ ਹੋ, ਤਾਂ ਨਤੀਜਾ ਇੱਥੇ ਦਿਸਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy edytujesz zdjęcie lub zapiszesz kolaż, film albo pomniejszone obrazy, wynik pojawi się tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando você edita uma foto ou salva uma colagem, um filme ou imagens redimensionadas, o resultado aparece aqui."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando editas uma fotografia ou guardas uma colagem, um filme ou imagens reduzidas, o resultado aparece aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Când editezi o poză sau salvezi un colaj, un film ori imagini micșorate, rezultatul apare aici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда ты редактируешь фото или сохраняешь коллаж, фильм или уменьшенные изображения, результат появится здесь."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Keď upravíte fotku alebo uložíte koláž, film či zmenšené obrázky, výsledok sa zobrazí tu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko urediš fotografijo ali shraniš kolaž, film ali pomanjšane slike, se rezultat prikaže tukaj."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När du redigerar en bild eller sparar ett collage, en film eller storleksändrade bilder visas resultatet här."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் ஒரு புகைப்படத்தைத் திருத்தும்போது அல்லது கொலாஜ், மூவி அல்லது அளவு மாற்றிய படங்களைச் சேமிக்கும்போது முடிவு இங்கே தோன்றும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఫోటోను ఎడిట్ చేసినప్పుడు లేదా కొలాజ్, మూవీ లేదా పరిమాణం మార్చిన చిత్రాలను సేవ్ చేసినప్పుడు ఫలితం ఇక్కడ కనిపిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อคุณแก้ไขรูปหรือบันทึกภาพตัดปะ ภาพยนตร์ หรือรูปที่ปรับขนาด ผลลัพธ์จะปรากฏที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir fotoğrafı düzenlediğinde ya da kolaj, film veya küçültülmüş görseller kaydettiğinde sonuç burada görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли ти редагуєш фото або зберігаєш колаж, фільм чи зменшені зображення, результат з’явиться тут."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب آپ کسی تصویر میں ترمیم کریں یا کولاج، مووی یا چھوٹی کی گئی تصاویر محفوظ کریں، تو نتیجہ یہاں دکھے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi bạn sửa ảnh hoặc lưu ảnh ghép, phim hay ảnh đã đổi kích thước, kết quả sẽ hiện ở đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当你编辑照片或保存拼贴、影片或缩小的图片时，结果会显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當你編輯照片或儲存拼貼、影片或調整大小的圖片時，結果會顯示在這裡。"
          }
        }
      }
    },
    "edits_empty_title": {
