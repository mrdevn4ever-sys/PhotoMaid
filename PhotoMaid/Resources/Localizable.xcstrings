    "vid_speed_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُسرَّع الصوت أو يُبطَّأ مع الحفاظ على طبقته."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শব্দ একই সুরে দ্রুত বা ধীর করা হয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El so s’accelera o s’alenteix mantenint el mateix to."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvuk se zrychlí nebo zpomalí se stejnou výškou tónu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyden gøres hurtigere eller langsommere med samme tonehøjde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ton wird mit gleicher Tonhöhe schneller oder langsamer."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο ήχος επιταχύνεται ή επιβραδύνεται με το ίδιο τονικό ύψος."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sound is sped up or slowed down with the same pitch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sonido se acelera o ralentiza sin cambiar el tono."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ääntä nopeutetaan tai hidastetaan samalla sävelkorkeudella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le son est accéléré ou ralenti sans changer de hauteur."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અવાજ એ જ પિચ પર ઝડપી કે ધીમો થાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הצליל מואץ או מואט באותו גובה צליל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आवाज़ उसी पिच पर तेज़ या धीमी होती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvuk se ubrzava ili usporava uz istu visinu tona."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hang ugyanazzal a hangmagassággal gyorsul vagy lassul."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Suara dipercepat atau diperlambat dengan nada yang sama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio viene accelerato o rallentato mantenendo l’intonazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声は音程を保ったまま速く・遅くなります。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಧ್ವನಿಯನ್ನು ಅದೇ ಸ್ವರದೊಂದಿಗೆ ವೇಗಗೊಳಿಸಲಾಗುತ್ತದೆ ಅಥವಾ ನಿಧಾನಗೊಳಿಸಲಾಗುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소리는 음높이를 유지한 채 빨라지거나 느려져요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ശബ്ദം അതേ സ്വരസ്ഥായിയിൽ വേഗത്തിലാക്കുകയോ പതുക്കെയാക്കുകയോ ചെയ്യും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आवाज त्याच पिचवर वेगवान किंवा हळू होतो."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunyi dipercepat atau diperlahankan dengan nada yang sama."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyden gjøres raskere eller saktere med samme tonehøyde."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het geluid wordt sneller of langzamer met dezelfde toonhoogte."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଧ୍ୱନି ସମାନ ସ୍ୱରରେ ଦ୍ରୁତ କିମ୍ବା ଧୀର କରାଯାଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਆਵਾਜ਼ ਉਸੇ ਸੁਰ ਨਾਲ ਤੇਜ਼ ਜਾਂ ਹੌਲੀ ਕੀਤੀ ਜਾਂਦੀ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dźwięk przyspiesza lub zwalnia bez zmiany wysokości."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O som é acelerado ou desacelerado com o mesmo tom."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O som fica mais rápido ou lento sem mudar o tom."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunetul se accelerează sau încetinește fără să-și schimbe tonalitatea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звук ускоряется или замедляется без изменения высоты."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvuk sa zrýchli alebo spomalí s rovnakou výškou tónu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvok se pospeši ali upočasni z enako višino tona."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ljudet snabbas upp eller saktas ned med samma tonhöjd."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒலி அதே சுருதியில் வேகப்படுத்தப்படும் அல்லது மெதுவாக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ధ్వని అదే స్థాయి (పిచ్)తో వేగంగా లేదా నెమ్మదిగా చేయబడుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสียงจะเร็วขึ้นหรือช้าลงโดยความสูงต่ำของเสียงไม่เปลี่ยนแปลง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses, perdesi değişmeden hızlanır veya yavaşlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Звук пришвидшується чи сповільнюється без зміни висоти."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آواز اسی پچ پر تیز یا آہستہ ہوتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Âm thanh được tăng hoặc giảm tốc với cao độ không đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "声音会变快或变慢，音调保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "聲音會加快或放慢，音調保持不變。"
          }
        }
      }
    },
