    "wf_target_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقيس GaleriQ النتيجة. إذا تعذّر بلوغ الهدف ضمن هذه الحدود فلن يُنشأ ملف وسترى السبب."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "GaleriQ measures the result. If the target can’t be reached within these limits, no file is created and you’ll see why."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ misst das Ergebnis. Ist das Ziel innerhalb dieser Grenzen nicht erreichbar, entsteht keine Datei und du siehst, warum."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ measures the result. If the target can’t be reached within these limits, no file is created and you’ll see why."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ mide el resultado. Si no se puede alcanzar el objetivo dentro de estos límites, no se crea ningún archivo y verás por qué."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ mesure le résultat. Si l’objectif est inatteignable dans ces limites, aucun fichier n’est créé et tu sauras pourquoi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "GaleriQ measures the result. If the target can’t be reached within these limits, no file is created and you’ll see why."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ misura il risultato. Se l’obiettivo non è raggiungibile entro questi limiti, non viene creato alcun file e vedrai perché."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQは結果を測定します。この範囲で目標に届かない場合はファイルを作らず、理由を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ는 결과를 측정해요. 이 범위에서 목표에 도달할 수 없으면 파일을 만들지 않고 이유를 보여 줘요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "GaleriQ measures the result. If the target can’t be reached within these limits, no file is created and you’ll see why."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ meet het resultaat. Is het doel binnen deze grenzen niet haalbaar, dan ontstaat er geen bestand en zie je waarom."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ mierzy wynik. Jeśli celu nie da się osiągnąć w tych granicach, plik nie powstanie, a zobaczysz dlaczego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "GaleriQ measures the result. If the target can’t be reached within these limits, no file is created and you’ll see why."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O GaleriQ mede o resultado. Se o objetivo não for alcançável dentro destes limites, não é criado nenhum ficheiro e vês porquê."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ măsoară rezultatul. Dacă ținta nu poate fi atinsă în aceste limite, nu se creează niciun fișier și vezi de ce."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ измеряет результат. Если цель недостижима в этих пределах, файл не создаётся, и вы увидите причину."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "GaleriQ measures the result. If the target can’t be reached within these limits, no file is created and you’ll see why."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "GaleriQ measures the result. If the target can’t be reached within these limits, no file is created and you’ll see why."
          }
