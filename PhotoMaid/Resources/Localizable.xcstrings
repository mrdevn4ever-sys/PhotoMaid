    "share_never": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن يُحذف أو يُقرَّر أي شيء. لا يُنشأ ملف جديد إلا عند الحفظ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts wird gelöscht oder entschieden. Eine neue Datei entsteht erst, wenn du speicherst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is deleted or decided. A new file is only saved when you choose to."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se elimina ni se decide nada. Solo se crea un archivo nuevo cuando guardas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’est supprimé ni décidé. Un nouveau fichier n’est créé que si vous enregistrez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nulla viene eliminato o deciso. Un nuovo file viene creato solo quando salvi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除や判定は行われません。新しいファイルは保存したときだけ作成されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제되거나 결정되는 것은 없어요. 저장할 때만 새 파일이 만들어져요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wordt niets verwijderd of beslist. Een nieuw bestand ontstaat pas als je opslaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie jest usuwane ani rozstrzygane. Nowy plik powstaje dopiero po zapisaniu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada é eliminado nem decidido. Só é criado um ficheiro novo quando guarda."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimic nu este șters sau decis. Un fișier nou apare doar când salvezi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего не удаляется и не решается. Новый файл появится, только когда вы сохраните."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir şey silinmez veya karara bağlanmaz. Yeni dosya yalnızca kaydettiğinde oluşur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нічого не видаляється і не вирішується. Новий файл з’явиться, лише коли ви збережете."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不会删除或决定任何内容。只有在你保存时才会生成新文件。"
          }
        }
      }
    },
    "share_no_access": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن لـ PhotoMaid الوصول إلى صورك بعد. اسمح بالوصول في الإعدادات ثم أرسل مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid hat noch keinen Zugriff auf deine Fotos. Erlaube den Zugriff in den Einstellungen und sende erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid can’t access your photos yet. Allow access in Settings, then send again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid aún no puede acceder a tus fotos. Permite el acceso en Ajustes y vuelve a enviar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid n’a pas encore accès à vos photos. Autorisez l’accès dans les réglages, puis renvoyez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid non ha ancora accesso alle tue foto. Consenti l’accesso nelle impostazioni e invia di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid はまだ写真にアクセスできません。設定でアクセスを許可してから、もう一度送ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid가 아직 사진에 접근할 수 없어요. 설정에서 접근을 허용한 후 다시 보내 주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid heeft nog geen toegang tot je foto’s. Sta toegang toe in Instellingen en stuur opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid nie ma jeszcze dostępu do zdjęć. Zezwól na dostęp w ustawieniach i wyślij ponownie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O PhotoMaid ainda não tem acesso às suas fotos. Permita o acesso nas definições e envie novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid nu are încă acces la fotografii. Permite accesul în setări, apoi trimite din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У PhotoMaid пока нет доступа к фото. Разрешите доступ в настройках и отправьте снова."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid henüz fotoğraflarına erişemiyor. Ayarlarda erişime izin verip yeniden gönder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid ще не має доступу до фото. Дозвольте доступ у налаштуваннях і надішліть знову."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid 尚无法访问你的照片。请在设置中允许访问，然后重新发送。"
          }
        }
      }
    },
    "share_none": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد أي من الملفات المشتركة في مكتبة صور هذا الجهاز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine der geteilten Dateien liegt in der Mediathek dieses Geräts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "None of the shared files are in this device’s photo library."
