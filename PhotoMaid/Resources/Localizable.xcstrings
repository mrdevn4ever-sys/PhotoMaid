    "col_draft_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك المتابعة لاحقًا في الاستوديو. لا يُحفظ شيء في المعرض."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst später im Studio weitermachen. In der Galerie wird nichts gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can continue later in Studio. Nothing is saved to your gallery."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes seguir más tarde en Estudio. No se guarda nada en la galería."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu pourras continuer plus tard dans Studio. Rien n’est enregistré dans la galerie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi continuare più tardi in Studio. Nella galleria non viene salvato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "後でスタジオから続けられます。ギャラリーには何も保存されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나중에 스튜디오에서 이어서 할 수 있어요. 갤러리에는 저장되지 않아요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt later verder in Studio. Er wordt niets in je galerij opgeslagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz kontynuować później w Studio. Nic nie zostanie zapisane w galerii."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Podes continuar mais tarde no Estúdio. Nada é guardado na galeria."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Poți continua mai târziu în Studio. Nimic nu se salvează în galerie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно продолжить позже в Студии. В галерею ничего не сохраняется."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha sonra Stüdyo’da devam edebilirsin. Galeriye hiçbir şey kaydedilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Можна продовжити пізніше в Студії. До галереї нічого не зберігається."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以稍后在工作室继续。不会保存到图库。"
          }
        }
      }
