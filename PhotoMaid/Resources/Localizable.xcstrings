    "lib_hidden_intro": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يعرض PhotoMaid هذه العناصر في أي مكان. الملفات لم تتغير وتعرضها التطبيقات الأخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid zeigt das hier nirgends. Die Dateien sind unverändert, andere Apps zeigen sie weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid doesn’t show these anywhere. The files are unchanged and other apps still show them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid no muestra esto en ningún sitio. Los archivos no cambian y otras apps los siguen mostrando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid ne les affiche nulle part. Les fichiers sont inchangés et les autres apps les affichent toujours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid non li mostra da nessuna parte. I file sono invariati e le altre app li mostrano ancora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらは PhotoMaid のどこにも表示されません。ファイルは変更されず、他のアプリでは表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid는 이 항목을 어디에도 표시하지 않습니다. 파일은 그대로이며 다른 앱에서는 계속 보입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid toont dit nergens. De bestanden zijn ongewijzigd en andere apps tonen ze nog."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid nigdzie tego nie pokazuje. Pliki są bez zmian, a inne aplikacje nadal je pokazują."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O PhotoMaid não mostra isto em lado nenhum. Os ficheiros estão inalterados e outras apps continuam a mostrá-los."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid nu le afișează nicăieri. Fișierele sunt neschimbate, iar alte aplicații le afișează în continuare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid нигде это не показывает. Файлы не изменены, другие приложения их показывают."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid bunları hiçbir yerde göstermez. Dosyalar değişmedi, diğer uygulamalar göstermeye devam eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid ніде цього не показує. Файли не змінено, інші застосунки їх показують."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid 不会在任何地方显示这些内容。文件未改变，其他应用仍会显示。"
          }
        }
      }
    },
