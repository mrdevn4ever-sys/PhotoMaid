    "basket_media_footer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يطلب iOS التأكيد مرة أخرى وينقل الصور ومقاطع الفيديو إلى «المحذوفة مؤخرًا». يمكنك عادةً استعادتها من هناك خلال 30 يومًا. مع صور iCloud يسري الحذف على جميع أجهزتك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS আবার নিশ্চিত করতে বলে এবং ফটো ও ভিডিও “সম্প্রতি মুছে ফেলা”-তে সরায়। সেখান থেকে সাধারণত ৩০ দিন পর্যন্ত পুনরুদ্ধার করা যায়। iCloud ফটো চালু থাকলে মুছে ফেলা আপনার সব ডিভাইসে প্রযোজ্য।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’iOS et demana una altra confirmació i mou les fotos i els vídeos a «Eliminat recentment». Normalment els pots recuperar allà durant 30 dies. Amb Fotos d’iCloud, l’eliminació s’aplica a tots els teus dispositius."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS vás požádá o další potvrzení a přesune fotky a videa do „Nedávno smazaných“. Tam je obvykle můžete 30 dní obnovit. S Fotkami na iCloudu platí smazání na všech vašich zařízeních."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS beder dig bekræfte igen og flytter fotos og videoer til “Senest slettet”. Der kan du normalt gendanne dem i 30 dage. Med iCloud-fotos gælder sletningen på alle dine enheder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS fragt noch einmal nach und legt Fotos und Videos in „Zuletzt gelöscht“. Dort lassen sie sich normalerweise 30 Tage wiederherstellen. Mit iCloud-Fotos gilt das Löschen auf allen deinen Geräten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το iOS ζητά ξανά επιβεβαίωση και μετακινεί φωτογραφίες και βίντεο στα «Πρόσφατα διαγραμμένα». Εκεί συνήθως μπορείς να τα επαναφέρεις για 30 ημέρες. Με τις Φωτογραφίες iCloud η διαγραφή ισχύει σε όλες τις συσκευές σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS asks you to confirm again and moves photos and videos to “Recently Deleted”. You can usually restore them there for 30 days. With iCloud Photos, deleting applies to all your devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS vuelve a pedir confirmación y mueve las fotos y vídeos a «Eliminado». Normalmente puedes recuperarlos allí durante 30 días. Con Fotos de iCloud, el borrado se aplica a todos tus dispositivos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS pyytää vielä vahvistuksen ja siirtää kuvat ja videot kansioon ”Äskettäin poistetut”. Siellä ne voi yleensä palauttaa 30 päivän ajan. iCloud-kuvien kanssa poisto koskee kaikkia laitteitasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS demande une nouvelle confirmation et place les photos et vidéos dans « Suppressions récentes ». Vous pouvez généralement les y récupérer pendant 30 jours. Avec Photos iCloud, la suppression s’applique à tous vos appareils."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ફરી પુષ્ટિ માગે છે અને ફોટા તથા વીડિયોને “તાજેતરમાં ડિલીટ કરેલ” માં ખસેડે છે. ત્યાંથી તમે સામાન્ય રીતે 30 દિવસ સુધી પુનઃસ્થાપિત કરી શકો છો. iCloud ફોટો સાથે ડિલીટ કરવું તમારાં બધાં ઉપકરણો પર લાગુ થાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS מבקשת אישור נוסף ומעבירה את התמונות והסרטונים אל „נמחקו לאחרונה”. בדרך כלל אפשר לשחזר אותם שם במשך 30 יום. עם ״תמונות iCloud״, המחיקה חלה על כל המכשירים שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS फिर से पुष्टि माँगता है और फ़ोटो व वीडियो को “हाल ही में डिलीट किए गए” में ले जाता है। वहाँ से आप आमतौर पर 30 दिन तक उन्हें रीस्टोर कर सकते हैं। iCloud तस्वीरें के साथ डिलीट करना आपके सभी डिवाइस पर लागू होता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS traži ponovnu potvrdu i premješta fotografije i videozapise u „Nedavno izbrisano”. Ondje ih obično možeš vratiti 30 dana. Uz iCloud fotografije brisanje vrijedi na svim tvojim uređajima."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az iOS újra megerősítést kér, és a fotókat és videókat a „Nemrég törölt” albumba helyezi. Ott általában 30 napig visszaállíthatók. iCloud-fotókkal a törlés minden eszközödre érvényes."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS meminta konfirmasi lagi dan memindahkan foto serta video ke “Baru Dihapus”. Biasanya kamu bisa memulihkannya di sana selama 30 hari. Dengan Foto iCloud, penghapusan berlaku di semua perangkatmu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS chiede di nuovo conferma e sposta foto e video in «Eliminati di recente». Di solito puoi recuperarli lì per 30 giorni. Con Foto di iCloud l’eliminazione vale su tutti i tuoi dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOSがもう一度確認し、写真とビデオを「最近削除した項目」に移動します。通常は30日間そこから復元できます。iCloud写真を使っている場合、削除はすべてのデバイスに反映されます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ಮತ್ತೆ ದೃಢೀಕರಿಸಲು ಕೇಳುತ್ತದೆ ಮತ್ತು ಫೋಟೋಗಳು ಹಾಗೂ ವೀಡಿಯೊಗಳನ್ನು “ಇತ್ತೀಚೆಗೆ ಅಳಿಸಲಾಗಿದೆ” ಗೆ ಸರಿಸುತ್ತದೆ. ಸಾಮಾನ್ಯವಾಗಿ ಅಲ್ಲಿಂದ 30 ದಿನಗಳವರೆಗೆ ಮರುಸ್ಥಾಪಿಸಬಹುದು. iCloud ಫೋಟೋಗಳೊಂದಿಗೆ, ಅಳಿಸುವಿಕೆ ನಿಮ್ಮ ಎಲ್ಲಾ ಸಾಧನಗಳಿಗೆ ಅನ್ವಯಿಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS가 다시 확인을 요청하고 사진과 비디오를 '최근 삭제된 항목'으로 옮깁니다. 보통 30일 동안 그곳에서 복구할 수 있습니다. iCloud 사진을 사용하면 삭제가 모든 기기에 적용됩니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS വീണ്ടും സ്ഥിരീകരിക്കാൻ ആവശ്യപ്പെടുകയും ഫോട്ടോകളും വീഡിയോകളും “അടുത്തിടെ ഇല്ലാതാക്കിയവ”-ലേക്ക് നീക്കുകയും ചെയ്യും. സാധാരണയായി അവിടെ നിന്ന് 30 ദിവസം വരെ പുനഃസ്ഥാപിക്കാം. iCloud ഫോട്ടോസ് ഉണ്ടെങ്കിൽ, ഇല്ലാതാക്കൽ നിങ്ങളുടെ എല്ലാ ഉപകരണങ്ങൾക്കും ബാധകമാണ്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS पुन्हा पुष्टी मागते आणि फोटो व व्हिडिओ “अलीकडे डिलीट केलेले” मध्ये हलवते. तिथून तुम्ही सहसा 30 दिवस ते पुनर्संचयित करू शकता. iCloud फोटोसह डिलीट करणे तुमच्या सर्व डिव्हाइसवर लागू होते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS meminta anda mengesahkan sekali lagi dan mengalihkan foto dan video ke “Dipadam Baru-baru Ini”. Biasanya anda boleh memulihkannya di sana selama 30 hari. Dengan Foto iCloud, pemadaman berlaku pada semua peranti anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ber deg bekrefte igjen og flytter bilder og videoer til «Nylig slettet». Der kan du vanligvis gjenopprette dem i 30 dager. Med iCloud-bilder gjelder slettingen alle enhetene dine."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS vraagt nogmaals om bevestiging en zet foto’s en video’s in ‘Recent verwijderd’. Daar kun je ze meestal 30 dagen herstellen. Met iCloud-foto’s geldt het verwijderen op al je apparaten."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ପୁଣି ନିଶ୍ଚିତ କରିବାକୁ କହେ ଏବଂ ଫଟୋ ଓ ଭିଡିଓକୁ “ନିକଟରେ ଡିଲିଟ୍ ହୋଇଥିବା”କୁ ଘୁଞ୍ଚାଏ। ସାଧାରଣତଃ ସେଠାରୁ 30 ଦିନ ପର୍ଯ୍ୟନ୍ତ ପୁନରୁଦ୍ଧାର କରିହେବ। iCloud ଫଟୋ ସହ, ଡିଲିଟ୍ ଆପଣଙ୍କ ସବୁ ଡିଭାଇସ୍‌ରେ ଲାଗୁ ହୁଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ਦੁਬਾਰਾ ਪੁਸ਼ਟੀ ਮੰਗਦਾ ਹੈ ਅਤੇ ਫ਼ੋਟੋਆਂ ਤੇ ਵੀਡੀਓ ਨੂੰ “ਹਾਲ ਹੀ ਵਿੱਚ ਮਿਟਾਏ ਗਏ” ਵਿੱਚ ਲੈ ਜਾਂਦਾ ਹੈ। ਉੱਥੋਂ ਤੁਸੀਂ ਆਮ ਤੌਰ ’ਤੇ 30 ਦਿਨਾਂ ਤੱਕ ਉਨ੍ਹਾਂ ਨੂੰ ਬਹਾਲ ਕਰ ਸਕਦੇ ਹੋ। iCloud ਫ਼ੋਟੋਆਂ ਨਾਲ ਮਿਟਾਉਣਾ ਤੁਹਾਡੀਆਂ ਸਾਰੀਆਂ ਡਿਵਾਈਸਾਂ ਉੱਤੇ ਲਾਗੂ ਹੁੰਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ponownie poprosi o potwierdzenie i przeniesie zdjęcia oraz filmy do „Ostatnio usunięte”. Zwykle można je tam odzyskać przez 30 dni. Przy Zdjęciach iCloud usunięcie dotyczy wszystkich Twoich urządzeń."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iOS pede outra confirmação e move fotos e vídeos para “Apagados”. Normalmente você pode restaurá-los lá por 30 dias. Com as Fotos do iCloud, a exclusão vale para todos os seus aparelhos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O iOS pede nova confirmação e move as fotografias e vídeos para «Apagados recentemente». Normalmente pode recuperá-los aí durante 30 dias. Com Fotografias em iCloud, a eliminação aplica-se a todos os seus dispositivos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS cere din nou confirmarea și mută pozele și videoclipurile în „Șterse recent”. De obicei le poți recupera de acolo timp de 30 de zile. Cu Poze iCloud, ștergerea se aplică pe toate dispozitivele tale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ещё раз попросит подтверждение и переместит фото и видео в «Недавно удаленные». Обычно их можно восстановить там в течение 30 дней. С Фото iCloud удаление действует на всех ваших устройствах."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS vás požiada o ďalšie potvrdenie a presunie fotky a videá do „Nedávno vymazaných“. Tam ich zvyčajne môžete 30 dní obnoviť. S Fotkami na iCloude platí vymazanie na všetkých vašich zariadeniach."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS znova zahteva potrditev in premakne fotografije in videoposnetke v »Nedavno izbrisano«. Tam jih običajno lahko obnoviš 30 dni. S Fotografijami iCloud izbris velja na vseh tvojih napravah."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ber dig bekräfta igen och flyttar bilder och videor till ”Nyligen raderade”. Där kan du oftast återställa dem i 30 dagar. Med iCloud-bilder gäller raderingen alla dina enheter."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS மீண்டும் உறுதிப்படுத்தக் கேட்டு, புகைப்படங்களையும் வீடியோக்களையும் “சமீபத்தில் நீக்கியவை”-க்கு நகர்த்தும். பொதுவாக அங்கிருந்து 30 நாட்கள் வரை மீட்டெடுக்கலாம். iCloud புகைப்படங்களுடன், நீக்குதல் உங்கள் எல்லாச் சாதனங்களுக்கும் பொருந்தும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS మళ్లీ నిర్ధారించమని అడిగి ఫోటోలు, వీడియోలను “ఇటీవల తొలగించినవి”కి తరలిస్తుంది. సాధారణంగా అక్కడి నుండి 30 రోజుల వరకు పునరుద్ధరించవచ్చు. iCloud ఫోటోలతో, తొలగింపు మీ అన్ని పరికరాలకూ వర్తిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS จะขอให้ยืนยันอีกครั้งและย้ายรูปภาพและวิดีโอไปที่ “ที่ลบล่าสุด” โดยปกติคุณจะกู้คืนได้ที่นั่นภายใน 30 วัน หากใช้รูปภาพ iCloud การลบจะมีผลกับทุกอุปกรณ์ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS yeniden onay ister ve fotoğrafları ile videoları \"Son Silinenler\"e taşır. Genellikle orada 30 gün boyunca geri yükleyebilirsin. iCloud Fotoğrafları ile silme tüm aygıtlarına uygulanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ще раз попросить підтвердження й перемістить фото та відео до «Нещодавно видалених». Зазвичай їх можна відновити там протягом 30 днів. З Фото iCloud видалення діє на всіх ваших пристроях."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS دوبارہ تصدیق مانگتا ہے اور تصاویر و ویڈیوز کو ”حال ہی میں حذف کردہ“ میں لے جاتا ہے۔ وہاں سے آپ عموماً 30 دن تک انہیں بحال کر سکتے ہیں۔ iCloud تصاویر کے ساتھ حذف کرنا آپ کی تمام ڈیوائسز پر لاگو ہوتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS sẽ yêu cầu bạn xác nhận lại và chuyển ảnh, video vào “Đã xóa gần đây”. Thường bạn có thể khôi phục chúng ở đó trong 30 ngày. Với Ảnh iCloud, việc xóa áp dụng cho mọi thiết bị của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 会再次请你确认，并将照片和视频移到“最近删除”。通常可在 30 天内从那里恢复。若使用 iCloud 照片，删除会作用于你的所有设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 會再次請你確認，並將照片和影片移到「最近刪除」。通常 30 天內都可在那裡復原。使用「iCloud 照片」時，刪除會套用到你所有的裝置。"
          }
        }
      }
    },
