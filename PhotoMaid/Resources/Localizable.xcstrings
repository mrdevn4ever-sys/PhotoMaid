    "large_unreadable_footer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه العناصر على هذا الـ iPhone لكن تعذّرت قراءتها. تظهر في القائمة بحجم تقديري («حوالي»)."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই আইটেমগুলো এই iPhone-এ আছে কিন্তু পড়া যায়নি। তালিকায় এগুলো অনুমানিক আকারে (“প্রায়”) দেখা যায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquests elements són en aquest iPhone, però no s’han pogut llegir. A la llista apareixen amb una mida estimada («aprox.»)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tyto položky jsou v tomto iPhonu, ale nepodařilo se je přečíst. V seznamu se zobrazují s odhadnutou velikostí („cca“)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Disse emner ligger på denne iPhone, men kunne ikke læses. På listen vises de med en anslået størrelse (“ca.”)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Medien liegen auf dem iPhone, ließen sich aber nicht lesen. In der Liste stehen sie mit geschätzter Größe („ca.“)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτά τα στοιχεία βρίσκονται σε αυτό το iPhone αλλά δεν διαβάστηκαν. Στη λίστα εμφανίζονται με εκτιμώμενο μέγεθος («περ.»)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These items are on this iPhone but couldn’t be read. In the list, they appear with an estimated size (“approx.”)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos elementos están en el iPhone, pero no se pudieron leer. En la lista aparecen con un tamaño estimado («aprox.»)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nämä kohteet ovat tässä iPhonessa, mutta niitä ei voitu lukea. Luettelossa niillä on arvioitu koko (”n.”)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces éléments sont sur l’iPhone mais n’ont pas pu être lus. Dans la liste, ils apparaissent avec une taille estimée (« env. »)."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ આઇટમ આ iPhone પર છે, પણ વાંચી શકાઈ નથી. સૂચિમાં તે અંદાજિત કદ (“આશરે”) સાથે દેખાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפריטים האלה נמצאים ב-iPhone הזה, אבל לא ניתן היה לקרוא אותם. ברשימה הם מוצגים עם גודל משוער („בערך”)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ये आइटम इस iPhone पर हैं, लेकिन पढ़े नहीं जा सके। सूची में ये अनुमानित साइज़ (“लगभग”) के साथ दिखते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ove su stavke na ovom iPhoneu, ali ih nije bilo moguće pročitati. Na popisu se prikazuju s procijenjenom veličinom („pribl.”)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezek az elemek ezen az iPhone-on vannak, de nem sikerült beolvasni őket. A listában becsült mérettel („kb.”) jelennek meg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Item ini ada di iPhone ini tapi tidak dapat dibaca. Di daftar, item ini muncul dengan ukuran perkiraan (“sekitar”)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questi elementi sono sull’iPhone ma non è stato possibile leggerli. Nell’elenco compaiono con una dimensione stimata («circa»)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの項目はこのiPhoneにありますが、読み取れませんでした。リストには推定サイズ（「約」）で表示されます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಐಟಂಗಳು ಈ iPhone ನಲ್ಲಿವೆ ಆದರೆ ಓದಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ. ಪಟ್ಟಿಯಲ್ಲಿ ಅವು ಅಂದಾಜು ಗಾತ್ರದೊಂದಿಗೆ (“ಸುಮಾರು”) ಕಾಣಿಸುತ್ತವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 항목은 iPhone에 있지만 읽을 수 없었어요. 목록에는 추정 크기(‘약’)로 표시돼요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ഇനങ്ങൾ ഈ iPhone-ൽ ഉണ്ട്, പക്ഷേ വായിക്കാനായില്ല. ലിസ്റ്റിൽ അവ കണക്കാക്കിയ വലുപ്പത്തോടെ (“ഏകദേശം”) കാണാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हे आयटम या iPhone वर आहेत, पण वाचता आले नाहीत. यादीत ते अंदाजे आकारासह (“सुमारे”) दिसतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Item ini berada pada iPhone ini tetapi tidak dapat dibaca. Dalam senarai, ia dipaparkan dengan saiz anggaran (“lebih kurang”)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Disse elementene ligger på denne iPhonen, men kunne ikke leses. I listen vises de med anslått størrelse («ca.»)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze items staan op de iPhone, maar konden niet worden gelezen. In de lijst staan ze met een geschatte grootte (‘ca.’)."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହି ଆଇଟମ୍‌ଗୁଡ଼ିକ ଏହି iPhoneରେ ଅଛି କିନ୍ତୁ ପଢ଼ାଯାଇପାରିଲା ନାହିଁ। ତାଲିକାରେ ଏଗୁଡ଼ିକ ଅନୁମାନିତ ଆକାର (“ପ୍ରାୟ”) ସହ ଦେଖାଯାଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਆਈਟਮਾਂ ਇਸ iPhone ਉੱਤੇ ਹਨ ਪਰ ਪੜ੍ਹੀਆਂ ਨਹੀਂ ਜਾ ਸਕੀਆਂ। ਸੂਚੀ ਵਿੱਚ ਇਹ ਅੰਦਾਜ਼ਨ ਆਕਾਰ (“ਲਗਭਗ”) ਨਾਲ ਦਿਸਦੀਆਂ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te elementy są na iPhonie, ale nie dało się ich odczytać. Na liście mają szacowany rozmiar („ok.”)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estes itens estão neste iPhone, mas não puderam ser lidos. Na lista, aparecem com tamanho estimado (“aprox.”)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Estes itens estão no iPhone, mas não foi possível lê-los. Na lista aparecem com um tamanho estimado («aprox.»)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceste elemente sunt pe iPhone, dar nu au putut fi citite. În listă apar cu dimensiune estimată („cca.”)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти объекты есть на iPhone, но их не удалось прочитать. В списке они показаны с оценкой размера («≈»)."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieto položky sú v tomto iPhone, ale nepodarilo sa ich prečítať. V zozname sa zobrazujú s odhadnutou veľkosťou („cca“)."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti elementi so v tem iPhonu, vendar jih ni bilo mogoče prebrati. Na seznamu so prikazani z ocenjeno velikostjo (»pribl.«)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De här objekten finns på den här iPhonen men kunde inte läsas. I listan visas de med uppskattad storlek (”ca”)."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த உருப்படிகள் இந்த iPhone-இல் உள்ளன, ஆனால் படிக்க முடியவில்லை. பட்டியலில் அவை மதிப்பிட்ட அளவுடன் (“சுமார்”) தோன்றும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ అంశాలు ఈ iPhoneలో ఉన్నాయి కానీ చదవలేకపోయారు. జాబితాలో అవి అంచనా పరిమాణంతో (“సుమారు”) కనిపిస్తాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการเหล่านี้อยู่บน iPhone เครื่องนี้แต่อ่านไม่ได้ ในรายการจะแสดงด้วยขนาดโดยประมาณ (“ประมาณ”)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu öğeler iPhone’da ama okunamadı. Listede tahmini boyutla (“yaklaşık”) görünürler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ці об’єкти є на iPhone, але їх не вдалося прочитати. У списку вони мають оцінений розмір («≈»)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ آئٹمز اس iPhone پر ہیں، لیکن پڑھے نہیں جا سکے۔ فہرست میں یہ اندازاً سائز (”تقریباً“) کے ساتھ دکھتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các mục này ở trên iPhone này nhưng không đọc được. Trong danh sách, chúng hiện với kích thước ước tính (“khoảng”)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
