    "pro_f6d": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صور التُقطت بشكل متتالٍ جنبًا إلى جنب – أنت تختار ما يبقى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurz hintereinander aufgenommene Fotos nebeneinander – du wählst, was bleibt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos taken in quick succession side by side – you choose what stays."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos tomadas seguidas, una junto a otra: tú eliges cuáles se quedan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos prises coup sur coup côte à côte – tu choisis ce qui reste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto scattate di seguito affiancate: scegli tu cosa resta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "連続して撮った写真を並べて表示。残すものはあなたが選びます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연속으로 찍은 사진을 나란히 보고 남길 사진을 직접 골라요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kort na elkaar gemaakte foto’s naast elkaar – jij kiest wat blijft."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdjęcia zrobione jedno po drugim obok siebie – ty wybierasz, co zostaje."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos tiradas em sequência lado a lado – tu escolhes o que fica."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografii făcute una după alta, alăturate – tu alegi ce rămâne."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото, снятые подряд, рядом друг с другом — ты выбираешь, что оставить."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Art arda çekilen fotoğraflar yan yana – neyin kalacağını sen seçersin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото, зняті поспіль, поруч — ти вибираєш, що залишити."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "并排显示连续拍摄的照片，由你决定保留哪些。"
          }
        }
      }
    },
