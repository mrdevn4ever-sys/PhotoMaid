    "backup_step_settings": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُستعاد الإعدادات (باستثناء «حذف نهائيًا»)، وتُضاف مسارات سير العمل والإعدادات المسبقة ومجموعاتك الخاصة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen werden übernommen (außer „Endgültig löschen“); Abläufe, Vorlagen und eigene Sammlungen kommen dazu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings are taken over (except “Permanently delete”); workflows, presets and your own collections are added."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se recuperan los ajustes (excepto «Eliminar definitivamente»); se añaden flujos de trabajo, ajustes guardados y tus colecciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réglages sont repris (sauf « Supprimer définitivement ») ; les flux de travail, préréglages et vos collections sont ajoutés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le impostazioni vengono riprese (tranne «Elimina definitivamente»); flussi di lavoro, preset e le tue raccolte vengono aggiunti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定を引き継ぎます（「完全に削除」を除く）。ワークフロー、プリセット、自分のコレクションは追加されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정을 가져와요(‘영구 삭제’ 제외). 작업 흐름, 프리셋, 내 모음은 추가돼요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Instellingen worden overgenomen (behalve ‘Definitief verwijderen’); werkstromen, voorinstellingen en eigen verzamelingen komen erbij."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustawienia zostaną przejęte (oprócz „Trwale usuwaj”); przepływy pracy, ustawienia filtrów i Twoje kolekcje zostaną dodane."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As definições são recuperadas (exceto “Eliminar definitivamente”); fluxos de trabalho, predefinições e as suas coleções são adicionados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Setările sunt preluate (cu excepția „Șterge definitiv”); fluxurile de lucru, presetările și colecțiile tale sunt adăugate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройки переносятся (кроме «Удалять навсегда»); сценарии, пресеты и ваши подборки добавляются."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlar aktarılır (“Kalıcı olarak sil” hariç); iş akışları, hazır ayarlar ve kendi koleksiyonların eklenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Налаштування переносяться (крім «Видаляти назавжди»); сценарії, пресети й ваші добірки додаються."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置会被沿用（“永久删除”除外）；工作流程、预设和你的合集会被添加。"
          }
        }
      }
    },
