    "ana2_cloud_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحمَّل صور iCloud كمعاينات صغيرة فقط عبر Wi-Fi. لا يتم رفع أي شيء."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ফটো শুধু Wi-Fi-তে ছোট প্রিভিউ হিসেবে লোড হয়। কিছুই আপলোড হয় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fotos d’iCloud només es carreguen com a previsualitzacions petites per Wi-Fi. No es penja res."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotky z iCloudu se načítají jen jako malé náhledy přes Wi-Fi. Nic se nenahrává."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud-fotos indlæses kun som små eksempler via Wi-Fi. Intet uploades."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud-Fotos werden nur als kleine Vorschau über WLAN geladen. Es wird nichts hochgeladen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι φωτογραφίες iCloud φορτώνονται μόνο ως μικρές προεπισκοπήσεις μέσω Wi-Fi. Τίποτα δεν ανεβαίνει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud photos are only loaded as small previews over Wi-Fi. Nothing is uploaded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos de iCloud solo se cargan como vistas previas pequeñas por Wi-Fi. No se sube nada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud-kuvat ladataan vain pieninä esikatseluina Wi-Fin kautta. Mitään ei lähetetä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos iCloud ne sont chargées qu’en petits aperçus via le Wi-Fi. Rien n’est envoyé."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ફોટા ફક્ત Wi-Fi પર નાના પ્રીવ્યૂ તરીકે લોડ થાય છે. કંઈ અપલોડ થતું નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תמונות iCloud נטענות רק כתצוגות מקדימות קטנות דרך Wi-Fi. שום דבר לא מועלה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud फ़ोटो केवल Wi-Fi पर छोटे प्रीव्यू के रूप में लोड होती हैं। कुछ भी अपलोड नहीं होता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud fotografije učitavaju se samo kao mali pregledi preko Wi-Fija. Ništa se ne prenosi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az iCloud-fotók csak kis előnézetként töltődnek be Wi-Fin keresztül. Semmi sem kerül feltöltésre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto iCloud hanya dimuat sebagai pratinjau kecil lewat Wi-Fi. Tidak ada yang diunggah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le foto di iCloud vengono caricate solo come piccole anteprime tramite Wi-Fi. Non viene caricato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud写真はWi-Fi経由で小さなプレビューとしてのみ読み込まれます。何もアップロードされません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ಫೋಟೋಗಳನ್ನು Wi-Fi ಮೂಲಕ ಸಣ್ಣ ಪೂರ್ವವೀಕ್ಷಣೆಗಳಾಗಿ ಮಾತ್ರ ಲೋಡ್ ಮಾಡಲಾಗುತ್ತದೆ. ಏನನ್ನೂ ಅಪ್‌ಲೋಡ್ ಮಾಡಲಾಗುವುದಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 사진은 Wi-Fi를 통해 작은 미리보기로만 불러옵니다. 아무것도 업로드되지 않습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ഫോട്ടോകൾ Wi-Fi വഴി ചെറിയ പ്രിവ്യൂകളായി മാത്രം ലോഡ് ചെയ്യുന്നു. ഒന്നും അപ്‌ലോഡ് ചെയ്യുന്നില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud फोटो फक्त Wi-Fi वर छोट्या पूर्वावलोकनांच्या रूपात लोड होतात. काहीही अपलोड होत नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto iCloud hanya dimuatkan sebagai pratonton kecil melalui Wi-Fi. Tiada apa dimuat naik."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud-bilder lastes bare inn som små forhåndsvisninger via Wi-Fi. Ingenting lastes opp."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud-foto’s worden alleen als kleine voorvertoning via wifi geladen. Er wordt niets geüpload."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ଫଟୋ କେବଳ Wi-Fiରେ ଛୋଟ ପ୍ରିଭ୍ୟୁ ଭାବେ ଲୋଡ୍ ହୁଏ। କିଛି ଅପଲୋଡ୍ ହୁଏ ନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ਫ਼ੋਟੋਆਂ ਸਿਰਫ਼ Wi-Fi ਉੱਤੇ ਛੋਟੇ ਪ੍ਰੀਵਿਊ ਵਜੋਂ ਲੋਡ ਹੁੰਦੀਆਂ ਹਨ। ਕੁਝ ਵੀ ਅੱਪਲੋਡ ਨਹੀਂ ਹੁੰਦਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdjęcia z iCloud są wczytywane tylko jako małe podglądy przez Wi-Fi. Nic nie jest wysyłane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos do iCloud só são carregadas como pequenas prévias via Wi-Fi. Nada é enviado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As fotografias do iCloud só são carregadas como pequenas pré-visualizações por Wi-Fi. Nada é enviado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozele din iCloud se încarcă doar ca previzualizări mici prin Wi-Fi. Nu se încarcă nimic în cloud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото из iCloud загружаются только как небольшие превью по Wi-Fi. Ничего не выгружается."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotky z iCloudu sa načítavajú len ako malé náhľady cez Wi-Fi. Nič sa nenahráva."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografije iCloud se naložijo le kot majhni predogledi prek Wi-Fi. Nič se ne naloži v splet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud-bilder läses bara in som små förhandsvisningar via wifi. Inget laddas upp."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud புகைப்படங்கள் Wi-Fi மூலம் சிறிய முன்னோட்டங்களாக மட்டுமே ஏற்றப்படும். எதுவும் பதிவேற்றப்படாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ఫోటోలు Wi-Fi ద్వారా చిన్న ప్రివ్యూలుగా మాత్రమే లోడ్ అవుతాయి. ఏదీ అప్‌లోడ్ కాదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปภาพ iCloud จะโหลดเป็นภาพตัวอย่างขนาดเล็กผ่าน Wi-Fi เท่านั้น ไม่มีการอัปโหลดใดๆ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud fotoğrafları yalnızca Wi-Fi üzerinden küçük önizlemeler olarak yüklenir. Hiçbir şey karşıya yüklenmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото з iCloud завантажуються лише як невеликі прев’ю через Wi-Fi. Нічого не вивантажується."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud تصاویر صرف Wi-Fi پر چھوٹے پیش منظر کے طور پر لوڈ ہوتی ہیں۔ کچھ بھی اپ لوڈ نہیں ہوتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh iCloud chỉ được tải dưới dạng bản xem trước nhỏ qua Wi-Fi. Không có gì được tải lên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 照片仅通过无线局域网以小预览形式载入。不会上传任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 照片只會透過 Wi-Fi 載入小型預覽。不會上傳任何內容。"
          }
        }
      }
    },
