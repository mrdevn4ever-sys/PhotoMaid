    "tools_copies_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى الأصول دون تغيير – يحفظ GaleriQ نسخًا جديدة في مكتبتك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার মূল ফাইল অপরিবর্তিত থাকে – GaleriQ আপনার লাইব্রেরিতে নতুন কপি সংরক্ষণ করে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els originals no canvien: GaleriQ desa còpies noves a la fototeca."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše originály zůstanou beze změny – GaleriQ uloží nové kopie do knihovny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine originaler forbliver uændrede – GaleriQ gemmer nye kopier i dit bibliotek."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Originale bleiben unverändert – GaleriQ speichert neue Kopien in deiner Mediathek."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα πρωτότυπά σου μένουν αμετάβλητα – το GaleriQ αποθηκεύει νέα αντίγραφα στη βιβλιοθήκη σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your originals stay unchanged – GaleriQ saves new copies in your library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus originales no cambian: GaleriQ guarda copias nuevas en tu fototeca."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Alkuperäisesi pysyvät ennallaan – GaleriQ tallentaa uudet kopiot kirjastoon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos originaux restent inchangés – GaleriQ enregistre de nouvelles copies dans votre photothèque."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારાં મૂળ બદલાતાં નથી – GaleriQ તમારી લાઇબ્રેરીમાં નવી નકલો સાચવે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המקוריים שלך לא משתנים – GaleriQ שומרת עותקים חדשים בספרייה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके मूल नहीं बदलते – GaleriQ आपकी लाइब्रेरी में नई कॉपी सहेजता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoji originali ostaju nepromijenjeni – GaleriQ sprema nove kopije u medijateku."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az eredetijeid változatlanok maradnak – a GaleriQ új másolatokat ment a könyvtáradba."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aslimu tidak berubah – GaleriQ menyimpan salinan baru di pustakamu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi originali restano invariati: GaleriQ salva nuove copie nella tua libreria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元の写真は変更されません。GaleriQは新しいコピーをライブラリに保存します。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಮೂಲಗಳು ಬದಲಾಗದೆ ಉಳಿಯುತ್ತವೆ – GaleriQ ನಿಮ್ಮ ಲೈಬ್ರರಿಯಲ್ಲಿ ಹೊಸ ಪ್ರತಿಗಳನ್ನು ಉಳಿಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본은 바뀌지 않아요. GaleriQ가 새 사본을 보관함에 저장해요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ഒറിജിനലുകൾക്ക് മാറ്റമുണ്ടാകില്ല – GaleriQ നിങ്ങളുടെ ലൈബ്രറിയിൽ പുതിയ പകർപ്പുകൾ സംരക്ഷിക്കുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमची मूळ बदलत नाहीत – GaleriQ तुमच्या लायब्ररीत नवीन प्रती जतन करते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Fail asal anda kekal tidak berubah – GaleriQ menyimpan salinan baharu dalam pustaka anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Originalene dine forblir uendret – GaleriQ lagrer nye kopier i biblioteket ditt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je originelen blijven ongewijzigd – GaleriQ bewaart nieuwe kopieën in je bibliotheek."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ ମୂଳ ଫାଇଲ୍ ଅପରିବର୍ତ୍ତିତ ରହେ – GaleriQ ଆପଣଙ୍କ ଲାଇବ୍ରେରୀରେ ନୂଆ କପି ସେଭ୍ କରେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੇ ਮੂਲ ਬਿਨਾਂ ਬਦਲੇ ਰਹਿੰਦੇ ਹਨ – GaleriQ ਤੁਹਾਡੀ ਲਾਇਬ੍ਰੇਰੀ ਵਿੱਚ ਨਵੀਆਂ ਕਾਪੀਆਂ ਸੰਭਾਲਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje oryginały pozostają bez zmian – GaleriQ zapisuje nowe kopie w bibliotece."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus originais não são alterados – o GaleriQ salva novas cópias na sua biblioteca."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os seus originais ficam inalterados – o GaleriQ guarda novas cópias na sua fototeca."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Originalele tale rămân neschimbate – GaleriQ salvează copii noi în fototecă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши оригиналы не меняются – GaleriQ сохраняет новые копии в медиатеке."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše originály zostanú bez zmeny – GaleriQ uloží nové kópie do knižnice."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoji izvirniki ostanejo nespremenjeni – GaleriQ shrani nove kopije v knjižnico."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina original förblir oförändrade – GaleriQ sparar nya kopior i ditt bibliotek."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் அசல்கள் மாறாமல் இருக்கும் – GaleriQ உங்கள் நூலகத்தில் புதிய நகல்களைச் சேமிக்கிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ ఒరిజినల్‌లు మారవు – GaleriQ మీ లైబ్రరీలో కొత్త కాపీలను సేవ్ చేస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้นฉบับของคุณไม่เปลี่ยนแปลง – GaleriQ บันทึกสำเนาใหม่ในคลังของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Orijinallerin değişmez; GaleriQ yeni kopyaları arşivine kaydeder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші оригінали не змінюються – GaleriQ зберігає нові копії в медіатеці."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے اصل تبدیل نہیں ہوتے – GaleriQ آپ کی لائبریری میں نئی کاپیاں محفوظ کرتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản gốc không thay đổi – GaleriQ lưu bản sao mới trong thư viện."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原件保持不变——GaleriQ 会将新副本存储到你的图库中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的原始檔保持不變 – GaleriQ 會在圖庫中儲存新副本。"
          }
        }
      }
    },
