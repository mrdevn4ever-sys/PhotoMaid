    "movie_transition_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بين مقطعين تصبح الصورة سوداء لحظة ثم تظهر تدريجيًا من جديد. عند الإيقاف: انتقال مباشر. يبقى الطول الكلي كما هو."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দুটি ক্লিপের মাঝে ছবি অল্প সময়ের জন্য কালো হয়ে আবার ফুটে ওঠে। বন্ধ: সরাসরি কাট। মোট দৈর্ঘ্য একই থাকে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre dos clips, la imatge es torna negra un moment i després reapareix. Desactivat: tall sec. La durada total no canvia."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mezi dvěma klipy obraz krátce zčerná a pak se znovu objeví. Vypnuto: tvrdý střih. Celková délka zůstane stejná."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mellem to klip bliver billedet kort sort og toner derefter ind igen. Fra: hårdt klip. Den samlede længde forbliver den samme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwischen zwei Clips wird das Bild kurz schwarz und blendet dann wieder auf. Aus: harter Schnitt. Die Gesamtlänge bleibt gleich."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανάμεσα σε δύο κλιπ η εικόνα μαυρίζει για λίγο και μετά επανέρχεται. Ανενεργό: απότομη αλλαγή. Η συνολική διάρκεια μένει ίδια."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Between two clips the picture briefly goes black and then fades back in. Off: a hard cut. The total length stays the same."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre dos clips, la imagen pasa un momento a negro y vuelve a aparecer. Desactivado: corte directo. La duración total no cambia."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kahden leikkeen välissä kuva muuttuu hetkeksi mustaksi ja palaa sitten esiin. Pois: kova leikkaus. Kokonaispituus pysyy samana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre deux clips, l’image passe brièvement au noir puis réapparaît. Désactivé : coupe franche. La durée totale ne change pas."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બે ક્લિપ વચ્ચે ચિત્ર થોડી ક્ષણ કાળું થાય છે અને પછી પાછું આવે છે. બંધ: સીધો કટ. કુલ લંબાઈ એટલી જ રહે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בין שני קליפים התמונה משחירה לרגע ואז חוזרת. כבוי: חיתוך חד. האורך הכולל לא משתנה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दो क्लिप के बीच तस्वीर कुछ पल काली होती है और फिर लौट आती है। बंद: सीधा कट। कुल लंबाई वही रहती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Između dva isječka slika nakratko postaje crna, a zatim se ponovno pojavljuje. Isključeno: oštar rez. Ukupna duljina ostaje ista."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Két klip között a kép rövid időre elsötétül, majd újra megjelenik. Ki: éles vágás. A teljes hossz nem változik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di antara dua klip, gambar sebentar menjadi hitam lalu muncul lagi. Mati: potongan langsung. Durasi total tetap sama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tra due clip l’immagine diventa nera per un attimo e poi riappare. Disattivato: stacco netto. La durata totale resta uguale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2つのクリップの間で画面が一瞬黒くなり、再びフェードインします。オフ：そのまま切り替え。全体の長さは変わりません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಎರಡು ಕ್ಲಿಪ್‌ಗಳ ನಡುವೆ ಚಿತ್ರ ಸ್ವಲ್ಪ ಸಮಯ ಕಪ್ಪಾಗಿ ನಂತರ ಮತ್ತೆ ಮೂಡುತ್ತದೆ. ಆಫ್: ನೇರ ಕಟ್. ಒಟ್ಟು ಉದ್ದ ಹಾಗೆಯೇ ಇರುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 클립 사이에서 화면이 잠깐 검게 바뀌었다가 다시 나타나요. 끄면 바로 전환돼요. 전체 길이는 그대로예요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "രണ്ട് ക്ലിപ്പുകൾക്കിടയിൽ ചിത്രം അൽപ്പനേരം കറുപ്പാകുകയും പിന്നീട് തെളിഞ്ഞുവരികയും ചെയ്യും. ഓഫ്: നേരിട്ടുള്ള കട്ട്. ആകെ ദൈർഘ്യം അതേപടി തുടരും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "दोन क्लिपदरम्यान चित्र क्षणभर काळे होते आणि मग परत येते. बंद: थेट कट. एकूण लांबी तेवढीच राहते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Antara dua klip, gambar menjadi hitam seketika dan kemudian muncul semula. Mati: potongan terus. Jumlah tempoh kekal sama."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mellom to klipp blir bildet kort svart og toner deretter inn igjen. Av: hardt kutt. Den totale lengden forblir den samme."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tussen twee clips wordt het beeld even zwart en komt het daarna weer op. Uit: harde overgang. De totale duur blijft gelijk."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଦୁଇଟି କ୍ଲିପ୍ ମଧ୍ୟରେ ଛବି କିଛି କ୍ଷଣ କଳା ହୋଇ ପୁଣି ଫୁଟିଉଠେ। ବନ୍ଦ: ସିଧା କଟ୍। ମୋଟ ଦୈର୍ଘ୍ୟ ସମାନ ରହେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਦੋ ਕਲਿੱਪਾਂ ਵਿਚਕਾਰ ਤਸਵੀਰ ਥੋੜ੍ਹੀ ਦੇਰ ਲਈ ਕਾਲੀ ਹੁੰਦੀ ਹੈ ਅਤੇ ਫਿਰ ਹੌਲੀ-ਹੌਲੀ ਵਾਪਸ ਆਉਂਦੀ ਹੈ। ਬੰਦ: ਸਿੱਧਾ ਕੱਟ। ਕੁੱਲ ਲੰਬਾਈ ਉਹੀ ਰਹਿੰਦੀ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Między dwoma klipami obraz na chwilę robi się czarny i znów się pojawia. Wyłączone: ostre cięcie. Łączna długość się nie zmienia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre dois clipes a imagem fica preta por um instante e depois volta aos poucos. Desativado: corte seco. A duração total continua igual."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre dois clipes, a imagem fica preta por instantes e depois volta a aparecer. Desativado: corte direto. A duração total mantém-se."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Între două clipuri, imaginea devine scurt neagră, apoi revine treptat. Dezactivat: tăietură directă. Durata totală rămâne aceeași."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Между двумя клипами изображение ненадолго становится чёрным, затем снова появляется. Выкл.: резкая склейка. Общая длина не меняется."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Medzi dvoma klipmi obraz krátko sčernie a potom sa znova objaví. Vypnuté: tvrdý strih. Celková dĺžka zostane rovnaká."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Med dvema posnetkoma slika za trenutek postane črna in se nato spet prikaže. Izklopljeno: oster rez. Skupna dolžina ostane enaka."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mellan två klipp blir bilden kort svart och tonar sedan in igen. Av: hårt klipp. Den totala längden förblir densamma."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இரண்டு கிளிப்களுக்கு இடையே படம் சிறிது நேரம் கருப்பாகி மீண்டும் தோன்றும். முடக்கினால்: நேரடி வெட்டு. மொத்த நீளம் அப்படியே இருக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రెండు క్లిప్‌ల మధ్య చిత్రం కాసేపు నల్లగా మారి మళ్లీ కనిపిస్తుంది. ఆఫ్: నేరుగా కట్. మొత్తం నిడివి అలాగే ఉంటుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระหว่างสองคลิป ภาพจะมืดลงครู่หนึ่งแล้วค่อยๆ กลับมา ปิด: ตัดตรง ความยาวรวมไม่เปลี่ยน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İki klip arasında görüntü kısa süre kararır, sonra yeniden belirir. Kapalı: doğrudan geçiş. Toplam süre aynı kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Між двома кліпами зображення ненадовго стає чорним, а потім знову з’являється. Вимк.: різка склейка. Загальна тривалість не змінюється."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دو کلپس کے درمیان تصویر لمحہ بھر کے لیے سیاہ ہوتی ہے اور پھر واپس آتی ہے۔ بند: سیدھا کٹ۔ کل لمبائی وہی رہتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữa hai đoạn, hình ảnh tối đen một chút rồi hiện dần trở lại. Tắt: cắt thẳng. Tổng thời lượng không đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两个片段之间画面会短暂变黑再淡入。关闭：直接切换。总时长不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩個片段之間畫面會短暫變黑再淡入。關閉：直接切換。總長度不變。"
          }
        }
      }
    },
