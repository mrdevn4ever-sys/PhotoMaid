    "archive_by_month_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرتّب النسخ في مجلدات فرعية حسب تاريخ الالتقاط، مثل «2026/10». عند الإيقاف: توضع كل الملفات في مجلد واحد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কপিগুলো তোলার তারিখ অনুযায়ী সাবফোল্ডারে সাজায়, যেমন “2026/10”। বন্ধ: সব ফাইল একটি ফোল্ডারে যায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordena les còpies en subcarpetes per data de presa, p. ex. «2026/10». Desactivat: tots els fitxers van a una sola carpeta."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Řadí kopie do podsložek podle data pořízení, např. „2026/10“. Vypnuto: všechny soubory jdou do jedné složky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorterer kopierne i undermapper efter optagelsesdato, f.eks. “2026/10”. Fra: alle filer i én mappe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sortiert die Kopien nach Aufnahmedatum in Unterordner, z. B. „2026/10“. Aus: alle Dateien landen in einem Ordner."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ταξινομεί τα αντίγραφα σε υποφακέλους κατά ημερομηνία λήψης, π.χ. «2026/10». Ανενεργό: όλα τα αρχεία πάνε σε έναν φάκελο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorts the copies into subfolders by date taken, e.g. “2026/10”. Off: all files go into one folder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordena las copias en subcarpetas por fecha de captura, p. ej. «2026/10». Desactivado: todos los archivos van a una sola carpeta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lajittelee kopiot alikansioihin kuvauspäivän mukaan, esim. ”2026/10”. Pois: kaikki tiedostot menevät yhteen kansioon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Range les copies dans des sous-dossiers selon la date de prise, p. ex. « 2026/10 ». Désactivé : tous les fichiers vont dans un seul dossier."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "નકલોને લીધાની તારીખ મુજબ પેટા-ફોલ્ડરમાં ગોઠવે છે, દા.ત. “2026/10”. બંધ: બધી ફાઇલો એક જ ફોલ્ડરમાં જાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ממיין את העותקים לתיקיות משנה לפי תאריך הצילום, למשל „2026/10”. כבוי: כל הקבצים נכנסים לתיקייה אחת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कॉपी को ली गई तारीख के अनुसार सबफ़ोल्डर में रखता है, जैसे “2026/10”। बंद: सभी फ़ाइलें एक ही फ़ोल्डर में जाती हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Razvrstava kopije u podmape po datumu snimanja, npr. „2026/10”. Isključeno: sve datoteke idu u jednu mapu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A másolatokat a készítés dátuma szerint almappákba rendezi, pl. „2026/10”. Ki: minden fájl egy mappába kerül."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengurutkan salinan ke subfolder menurut tanggal diambil, misalnya “2026/10”. Mati: semua file masuk ke satu folder."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordina le copie in sottocartelle per data di scatto, ad es. «2026/10». Disattivato: tutti i file in un’unica cartella."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "撮影日ごとにサブフォルダ（例：「2026/10」）に分けます。オフ：すべてのファイルを1つのフォルダに入れます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪ್ರತಿಗಳನ್ನು ತೆಗೆದ ದಿನಾಂಕದ ಪ್ರಕಾರ ಉಪಫೋಲ್ಡರ್‌ಗಳಲ್ಲಿ ವಿಂಗಡಿಸುತ್ತದೆ, ಉದಾ. “2026/10”. ಆಫ್: ಎಲ್ಲಾ ಫೈಲ್‌ಗಳು ಒಂದೇ ಫೋಲ್ಡರ್‌ಗೆ ಹೋಗುತ್ತವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "촬영 날짜별 하위 폴더(예: ‘2026/10’)로 정리해요. 끄면 모든 파일이 한 폴더에 들어가요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പകർപ്പുകൾ എടുത്ത തീയതി അനുസരിച്ച് ഉപഫോൾഡറുകളിലേക്ക് അടുക്കുന്നു, ഉദാ. “2026/10”. ഓഫ്: എല്ലാ ഫയലുകളും ഒരു ഫോൾഡറിലേക്ക് പോകും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रती काढलेल्या तारखेनुसार उपफोल्डरमध्ये लावते, उदा. “2026/10”. बंद: सर्व फाइल्स एकाच फोल्डरमध्ये जातात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengisih salinan ke dalam subfolder mengikut tarikh diambil, cth. “2026/10”. Mati: semua fail masuk ke satu folder."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorterer kopiene i undermapper etter opptaksdato, f.eks. «2026/10». Av: alle filer havner i én mappe."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorteert de kopieën op opnamedatum in submappen, bijv. ‘2026/10’. Uit: alle bestanden in één map."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "କପିଗୁଡ଼ିକୁ ଉଠାଯାଇଥିବା ତାରିଖ ଅନୁସାରେ ସବଫୋଲ୍ଡରରେ ସଜାଏ, ଯେପରି “2026/10”। ବନ୍ଦ: ସବୁ ଫାଇଲ୍ ଗୋଟିଏ ଫୋଲ୍ଡରକୁ ଯାଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕਾਪੀਆਂ ਨੂੰ ਖਿੱਚਣ ਦੀ ਤਾਰੀਖ ਅਨੁਸਾਰ ਸਬ-ਫ਼ੋਲਡਰਾਂ ਵਿੱਚ ਰੱਖਦਾ ਹੈ, ਜਿਵੇਂ “2026/10”। ਬੰਦ: ਸਾਰੀਆਂ ਫ਼ਾਈਲਾਂ ਇੱਕੋ ਫ਼ੋਲਡਰ ਵਿੱਚ ਜਾਂਦੀਆਂ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Układa kopie w podfolderach według daty wykonania, np. „2026/10”. Wyłączone: wszystkie pliki w jednym folderze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Organiza as cópias em subpastas pela data de captura, por exemplo “2026/10”. Desativado: todos os arquivos vão para uma pasta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Organiza as cópias em subpastas pela data de captura, p. ex. «2026/10». Desativado: todos os ficheiros numa só pasta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sortează copiile în subdosare după data fotografierii, de ex. „2026/10”. Dezactivat: toate fișierele într-un singur dosar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Раскладывает копии по подпапкам по дате съёмки, например «2026/10». Выкл.: все файлы в одной папке."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Triedi kópie do podpriečinkov podľa dátumu nasnímania, napr. „2026/10“. Vypnuté: všetky súbory idú do jedného priečinka."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Razvrsti kopije v podmape po datumu posnetka, npr. »2026/10«. Izklopljeno: vse datoteke gredo v eno mapo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorterar kopiorna i undermappar efter tagningsdatum, t.ex. ”2026/10”. Av: alla filer hamnar i en mapp."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நகல்களை எடுத்த தேதியின்படி துணைக் கோப்புறைகளில் வரிசைப்படுத்துகிறது, எ.கா. “2026/10”. முடக்கினால்: அனைத்துக் கோப்புகளும் ஒரே கோப்புறைக்குச் செல்லும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కాపీలను తీసిన తేదీ ప్రకారం సబ్‌ఫోల్డర్‌లలో అమరుస్తుంది, ఉదా. “2026/10”. ఆఫ్: అన్ని ఫైళ్లు ఒకే ఫోల్డర్‌లోకి వెళ్తాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จัดสำเนาลงในโฟลเดอร์ย่อยตามวันที่ถ่าย เช่น “2026/10” ปิด: ไฟล์ทั้งหมดอยู่ในโฟลเดอร์เดียว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopyaları çekim tarihine göre alt klasörlere ayırır, örneğin “2026/10”. Kapalı: tüm dosyalar tek klasöre gider."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розкладає копії по підпапках за датою зйомки, наприклад «2026/10». Вимк.: усі файли в одній папці."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کاپیوں کو لینے کی تاریخ کے مطابق ذیلی فولڈرز میں رکھتا ہے، جیسے ”2026/10“۔ بند: تمام فائلیں ایک ہی فولڈر میں جاتی ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xếp các bản sao vào thư mục con theo ngày chụp, ví dụ “2026/10”. Tắt: mọi tệp vào một thư mục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按拍摄日期将副本放入子文件夹，例如“2026/10”。关闭：所有文件放在同一文件夹中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依拍攝日期將副本分到子檔案夾，例如「2026/10」。關閉：所有檔案都放在同一個檔案夾。"
          }
        }
      }
    },
