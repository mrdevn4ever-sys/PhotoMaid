    "vault_code_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الرمز غير متاح على هذا الـ iPhone (مثلًا بعد الاستعادة دون نسخة احتياطية مشفّرة). افتح الخزنة باستخدام مفتاح الاسترداد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই iPhone-এ কোডটি পাওয়া যাচ্ছে না (যেমন এনক্রিপ্ট করা ব্যাকআপ ছাড়া পুনরুদ্ধারের পরে)। আপনার রিকভারি কী দিয়ে ভল্ট খুলুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El codi no està disponible en aquest iPhone (per exemple, després de restaurar sense una còpia xifrada). Obre la caixa forta amb la clau de recuperació."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kód není v tomto iPhonu k dispozici (například po obnovení bez šifrované zálohy). Otevřete trezor klíčem pro obnovení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Koden er ikke tilgængelig på denne iPhone (f.eks. efter gendannelse uden krypteret sikkerhedskopi). Åbn boksen med din gendannelsesnøgle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Code ist auf diesem iPhone nicht verfügbar (z. B. nach einer Wiederherstellung ohne verschlüsseltes Backup). Öffne den Tresor mit deinem Notfallschlüssel."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο κωδικός δεν είναι διαθέσιμος σε αυτό το iPhone (π.χ. μετά από επαναφορά χωρίς κρυπτογραφημένο αντίγραφο). Άνοιξε το θησαυροφυλάκιο με το κλειδί ανάκτησης."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The code isn’t available on this iPhone (for example after restoring without an encrypted backup). Open the vault with your recovery key."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El código no está disponible en este iPhone (por ejemplo, tras restaurar sin una copia de seguridad cifrada). Abre la caja fuerte con tu clave de recuperación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Koodi ei ole käytettävissä tässä iPhonessa (esimerkiksi palautuksen jälkeen ilman salattua varmuuskopiota). Avaa holvi palautusavaimella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le code n’est pas disponible sur cet iPhone (par exemple après une restauration sans sauvegarde chiffrée). Ouvre le coffre-fort avec ta clé de secours."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ iPhone પર કોડ ઉપલબ્ધ નથી (દા.ત. એન્ક્રિપ્ટેડ બૅકઅપ વિના પુનઃસ્થાપન પછી). તમારી પુનઃપ્રાપ્તિ ચાવીથી વૉલ્ટ ખોલો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקוד לא זמין ב-iPhone הזה (למשל אחרי שחזור בלי גיבוי מוצפן). אפשר לפתוח את הכספת עם מפתח השחזור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस iPhone पर कोड उपलब्ध नहीं है (जैसे बिना एन्क्रिप्टेड बैकअप के रीस्टोर के बाद)। तिजोरी अपनी रिकवरी कुंजी से खोलें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kôd nije dostupan na ovom iPhoneu (npr. nakon vraćanja bez šifrirane sigurnosne kopije). Otvori trezor ključem za oporavak."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kód nem érhető el ezen az iPhone-on (például titkosított mentés nélküli visszaállítás után). Nyisd meg a széfet a helyreállítási kulccsal."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kode tidak tersedia di iPhone ini (misalnya setelah memulihkan tanpa cadangan terenkripsi). Buka brankas dengan kunci pemulihanmu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il codice non è disponibile su questo iPhone (ad esempio dopo un ripristino senza backup crittografato). Apri la cassaforte con la tua chiave di recupero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPhoneではコードを使用できません（暗号化されていないバックアップから復元した場合など）。復旧キーで保管庫を開いてください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ iPhone ನಲ್ಲಿ ಕೋಡ್ ಲಭ್ಯವಿಲ್ಲ (ಉದಾ. ಎನ್‌ಕ್ರಿಪ್ಟ್ ಮಾಡಿದ ಬ್ಯಾಕಪ್ ಇಲ್ಲದೆ ಮರುಸ್ಥಾಪಿಸಿದ ನಂತರ). ನಿಮ್ಮ ಮರುಪಡೆಯುವಿಕೆ ಕೀಲಿಯಿಂದ ವಾಲ್ಟ್ ತೆರೆಯಿರಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone에서는 암호를 사용할 수 없습니다(예: 암호화되지 않은 백업으로 복원한 경우). 복구 키로 금고를 여세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ iPhone-ൽ കോഡ് ലഭ്യമല്ല (ഉദാ. എൻക്രിപ്റ്റ് ചെയ്ത ബാക്കപ്പില്ലാതെ പുനഃസ്ഥാപിച്ച ശേഷം). നിങ്ങളുടെ റിക്കവറി കീ ഉപയോഗിച്ച് വോൾട്ട് തുറക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या iPhone वर कोड उपलब्ध नाही (उदा. एन्क्रिप्टेड बॅकअपशिवाय पुनर्संचयनानंतर). तुमच्या पुनर्प्राप्ती किल्लीने व्हॉल्ट उघडा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod tidak tersedia pada iPhone ini (contohnya selepas dipulihkan tanpa sandaran disulitkan). Buka peti besi dengan kunci pemulihan anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Koden er ikke tilgjengelig på denne iPhonen (f.eks. etter gjenoppretting uten kryptert sikkerhetskopi). Åpne safen med gjenopprettingsnøkkelen din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De code is niet beschikbaar op deze iPhone (bijvoorbeeld na herstel zonder versleutelde reservekopie). Open de kluis met je herstelsleutel."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହି iPhoneରେ କୋଡ୍ ଉପଲବ୍ଧ ନାହିଁ (ଯେପରି ଏନକ୍ରିପ୍ଟେଡ୍ ବ୍ୟାକଅପ୍ ବିନା ପୁନରୁଦ୍ଧାର ପରେ)। ଆପଣଙ୍କ ରିକଭରି କି ସହ ଭଲ୍ଟ ଖୋଲନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਕੋਡ ਇਸ iPhone ਉੱਤੇ ਉਪਲਬਧ ਨਹੀਂ (ਜਿਵੇਂ ਇਨਕ੍ਰਿਪਟਡ ਬੈਕਅੱਪ ਤੋਂ ਬਿਨਾਂ ਬਹਾਲ ਕਰਨ ਤੋਂ ਬਾਅਦ)। ਆਪਣੀ ਰਿਕਵਰੀ ਕੁੰਜੀ ਨਾਲ ਵੌਲਟ ਖੋਲ੍ਹੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod nie jest dostępny na tym iPhonie (np. po przywróceniu bez zaszyfrowanej kopii zapasowej). Otwórz sejf kluczem odzyskiwania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O código não está disponível neste iPhone (por exemplo, após restaurar sem um backup criptografado). Abra o cofre com sua chave de recuperação."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O código não está disponível neste iPhone (por exemplo, após restaurar sem uma cópia de segurança encriptada). Abre o cofre com a tua chave de recuperação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Codul nu este disponibil pe acest iPhone (de exemplu, după o restaurare fără backup criptat). Deschide seiful cu cheia de recuperare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Код недоступен на этом iPhone (например, после восстановления без зашифрованной резервной копии). Открой сейф с помощью ключа восстановления."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kód nie je v tomto iPhone dostupný (napríklad po obnovení bez šifrovanej zálohy). Otvorte trezor kľúčom na obnovenie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koda v tem iPhonu ni na voljo (na primer po obnovitvi brez šifrirane varnostne kopije). Odpri sef z obnovitvenim ključem."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Koden är inte tillgänglig på den här iPhonen (t.ex. efter återställning utan krypterad säkerhetskopia). Öppna valvet med din återställningsnyckel."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த iPhone-இல் குறியீடு கிடைக்கவில்லை (எ.கா. குறியாக்கப்பட்ட காப்புப்பிரதி இல்லாமல் மீட்டமைத்த பின்). உங்கள் மீட்புச் சாவியுடன் லாக்கரைத் திறங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ iPhoneలో కోడ్ అందుబాటులో లేదు (ఉదా. ఎన్‌క్రిప్ట్ చేసిన బ్యాకప్ లేకుండా పునరుద్ధరించిన తర్వాత). మీ రికవరీ కీతో వాల్ట్ తెరవండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รหัสไม่พร้อมใช้งานบน iPhone เครื่องนี้ (เช่น หลังกู้คืนโดยไม่มีข้อมูลสำรองแบบเข้ารหัส) เปิดตู้เซฟด้วยกุญแจกู้คืนของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod bu iPhone’da kullanılamıyor (örneğin şifreli yedek olmadan geri yükledikten sonra). Kasayı kurtarma anahtarınla aç."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Код недоступний на цьому iPhone (наприклад, після відновлення без зашифрованої резервної копії). Відкрий сейф за допомогою ключа відновлення."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس iPhone پر کوڈ دستیاب نہیں (مثلاً خفیہ بیک اپ کے بغیر بحالی کے بعد)۔ والٹ اپنی ریکوری کلید سے کھولیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mã không có sẵn trên iPhone này (ví dụ sau khi khôi phục mà không có bản sao lưu mã hóa). Hãy mở két sắt bằng khóa khôi phục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 iPhone 上无法使用该密码（例如在没有加密备份的情况下恢复后）。请使用恢复密钥打开保险箱。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這部 iPhone 上無法使用此密碼（例如在沒有加密備份的情況下還原後）。請用你的復原金鑰打開保險箱。"
          }
        }
      }
    },
