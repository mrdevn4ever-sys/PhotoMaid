    "edit_share_only_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يشارك النسخة المعدلة دون حفظها في المعرض. تتم إزالة الموقع."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Deler den redigerede version uden at gemme den i dit galleri. Lokaliteten fjernes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teilt die bearbeitete Fassung, ohne sie in der Galerie zu speichern. Der Standort wird entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shares the edited version without saving it to your gallery. Location is removed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte la versión editada sin guardarla en la galería. Se quita la ubicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partage la version modifiée sans l’enregistrer dans la galerie. La position est retirée."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membagikan versi hasil edit tanpa menyimpannya ke galerimu. Lokasi dihapus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Condivide la versione modificata senza salvarla in galleria. La posizione viene rimossa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "編集版をギャラリーに保存せずに共有します。位置情報は削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편집본을 갤러리에 저장하지 않고 공유해요. 위치 정보는 삭제돼요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Deler den redigerte versjonen uten å lagre den i galleriet ditt. Stedet fjernes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deelt de bewerkte versie zonder haar in je galerij op te slaan. De locatie wordt verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Udostępnia edytowaną wersję bez zapisywania jej w galerii. Lokalizacja zostaje usunięta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartilha a versão editada sem salvá-la na sua galeria. A localização é removida."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Partilha a versão editada sem a guardar na galeria. A localização é removida."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Distribuie versiunea editată fără a o salva în galerie. Locația este eliminată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправляет изменённую версию, не сохраняя её в галерее. Геоданные удаляются."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Delar den redigerade versionen utan att spara den i ditt galleri. Platsen tas bort."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แชร์เวอร์ชันที่แก้ไขโดยไม่บันทึกลงคลังภาพ ตำแหน่งจะถูกลบออก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düzenlenmiş sürümü galeriye kaydetmeden paylaşır. Konum kaldırılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надсилає змінену версію, не зберігаючи її в галереї. Геодані видаляються."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chia sẻ bản đã sửa mà không lưu vào thư viện. Vị trí sẽ bị xóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分享编辑后的版本而不保存到图库，位置信息会被移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分享編輯後的版本，但不儲存到你的圖庫。會移除位置資訊。"
          }
        }
      }
    },
