    "lib_fav_empty_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط ♡ على صورة أو فيديو لجعله مفضلًا. المفضلة هي نفسها في تطبيق الصور."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো ফটো বা ভিডিও পছন্দের করতে তাতে ♡ ট্যাপ করুন। পছন্দেরগুলো ফটো অ্যাপের মতোই।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca ♡ en una foto o un vídeo per fer-lo preferit. Els preferits són els mateixos que a l’app Fotos."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na ♡ u fotky nebo videa ho označíte jako oblíbené. Oblíbené jsou stejné jako v aplikaci Fotky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på ♡ på et foto eller en video for at gøre det til favorit. Favoritterne er de samme som i appen Fotos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe bei einem Foto oder Video auf ♡, um es zum Favoriten zu machen. Es sind dieselben Favoriten wie in der Fotos-App."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάτησε ♡ σε μια φωτογραφία ή ένα βίντεο για να το κάνεις αγαπημένο. Τα αγαπημένα είναι ίδια με της εφαρμογής Φωτογραφίες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap ♡ on a photo or video to make it a favourite. Favourites are the same as in the Photos app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca ♡ en una foto o vídeo para marcarlo como favorito. Son los mismos favoritos que en la app Fotos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta ♡ kuvassa tai videossa tehdäksesi siitä suosikin. Suosikit ovat samat kuin Kuvat-apissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez ♡ sur une photo ou une vidéo pour l’ajouter aux favoris. Ce sont les mêmes favoris que dans l’app Photos."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફોટો કે વીડિયોને મનપસંદ બનાવવા ♡ પર ટૅપ કરો. મનપસંદ ફોટો ઍપ જેવાં જ છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקשה על ♡ בתמונה או בסרטון הופכת אותם למועדפים. המועדפים זהים לאלה שביישום ״תמונות״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी फ़ोटो या वीडियो को पसंदीदा बनाने के लिए ♡ पर टैप करें। पसंदीदा वही हैं जो तस्वीरें ऐप में हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirni ♡ na fotografiji ili videozapisu da ga označiš kao omiljeno. Omiljene stavke iste su kao u aplikaciji Fotografije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints a ♡ ikonra egy fotón vagy videón, hogy kedvenccé tedd. A kedvencek ugyanazok, mint a Fotók appban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk ♡ pada foto atau video untuk menjadikannya favorit. Favorit sama dengan di app Foto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca ♡ su una foto o un video per aggiungerlo ai preferiti. Sono gli stessi preferiti dell’app Foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真やビデオの♡をタップするとお気に入りになります。写真アプリと同じお気に入りです。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಫೋಟೋ ಅಥವಾ ವೀಡಿಯೊವನ್ನು ಮೆಚ್ಚಿನದಾಗಿಸಲು ಅದರ ಮೇಲೆ ♡ ಟ್ಯಾಪ್ ಮಾಡಿ. ಮೆಚ್ಚಿನವು ಫೋಟೋಗಳು ಆ್ಯಪ್‌ನಲ್ಲಿರುವಂತೆಯೇ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진이나 비디오에서 ♡를 탭하면 즐겨찾기가 됩니다. 사진 앱과 같은 즐겨찾기입니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരു ഫോട്ടോയോ വീഡിയോയോ പ്രിയപ്പെട്ടതാക്കാൻ അതിൽ ♡ ടാപ്പ് ചെയ്യുക. പ്രിയപ്പെട്ടവ ഫോട്ടോസ് ആപ്പിലേതു തന്നെയാണ്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फोटो किंवा व्हिडिओ आवडते करण्यासाठी ♡ वर टॅप करा. आवडते फोटो अ‍ॅपमधील सारखेच आहेत."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik ♡ pada foto atau video untuk menjadikannya kegemaran. Kegemaran sama seperti dalam app Foto."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på ♡ på et bilde eller en video for å gjøre det til favoritt. Favorittene er de samme som i Bilder-appen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op ♡ bij een foto of video om er een favoriet van te maken. Het zijn dezelfde favorieten als in de Foto’s-app."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏକ ଫଟୋ କିମ୍ବା ଭିଡିଓକୁ ପସନ୍ଦର କରିବାକୁ ତାହା ଉପରେ ♡ ଟାପ୍ କରନ୍ତୁ। ପସନ୍ଦରଗୁଡ଼ିକ ଫଟୋ ଆପ୍‌ର ପସନ୍ଦର ସହ ସମାନ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕਿਸੇ ਫ਼ੋਟੋ ਜਾਂ ਵੀਡੀਓ ਨੂੰ ਮਨਪਸੰਦ ਬਣਾਉਣ ਲਈ ਉਸ ਉੱਤੇ ♡ ਟੈਪ ਕਰੋ। ਮਨਪਸੰਦ ਉਹੀ ਹਨ ਜੋ ਫ਼ੋਟੋਆਂ ਐਪ ਵਿੱਚ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij ♡ przy zdjęciu lub filmie, aby dodać je do ulubionych. To te same ulubione, co w aplikacji Zdjęcia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em ♡ numa foto ou vídeo para torná-lo favorito. Os Favoritos são os mesmos do app Fotos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em ♡ numa fotografia ou vídeo para o tornar favorito. São os mesmos favoritos da app Fotografias."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge ♡ la o poză sau un videoclip ca să-l faci favorit. Sunt aceleași favorite ca în aplicația Poze."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите ♡ на фото или видео, чтобы добавить его в избранное. Это то же избранное, что и в приложении «Фото»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na ♡ pri fotke alebo videu ho označíte ako obľúbené. Obľúbené sú rovnaké ako v aplikácii Fotky."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapni ♡ na fotografiji ali videoposnetku, da ga dodaš med priljubljene. Priljubljene so enake kot v aplikaciji Fotografije."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på ♡ på en bild eller video för att göra den till favorit. Favoriterna är desamma som i appen Bilder."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு புகைப்படம் அல்லது வீடியோவைப் பிடித்ததாக்க அதில் ♡ தட்டுங்கள். பிடித்தவை Photos ஆப்பில் உள்ளவையே."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫోటో లేదా వీడియోను ఇష్టమైనదిగా చేయడానికి దానిపై ♡ ట్యాప్ చేయండి. ఇష్టమైనవి Photos యాప్‌లోనివే."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะ ♡ บนรูปหรือวิดีโอเพื่อตั้งเป็นรายการโปรด รายการโปรดเหมือนกับในแอพรูปภาพ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir fotoğraf veya videoda ♡ simgesine dokunarak favori yap. Favoriler Fotoğraflar uygulamasındakilerle aynıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться ♡ на фото чи відео, щоб додати його до вибраного. Це те саме вибране, що й у програмі «Фото»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کسی تصویر یا ویڈیو کو پسندیدہ بنانے کے لیے ♡ پر ٹیپ کریں۔ پسندیدہ وہی ہیں جو تصاویر ایپ میں ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm ♡ trên ảnh hoặc video để đánh dấu ưa thích. Mục ưa thích giống với trong ứng dụng Ảnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点照片或视频上的 ♡ 即可设为个人收藏。与“照片”App 中的个人收藏相同。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在照片或影片上點一下 ♡ 即可設為個人收藏。個人收藏與「照片」App 中相同。"
          }
