        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna modifica: iOS non ha ricevuto il permesso. L’originale è invariato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更されていません。iOSで許可されませんでした。オリジナルはそのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경되지 않음 – iOS에서 허용되지 않았습니다. 원본은 그대로입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet gewijzigd – iOS kreeg geen toestemming. Het origineel is ongewijzigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez zmian – iOS nie otrzymał zgody. Oryginał pozostał bez zmian."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem alterações – o iOS não recebeu autorização. O original não foi alterado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nemodificat – iOS nu a primit permisiunea. Originalul a rămas neschimbat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без изменений – iOS не получил разрешение. Оригинал не изменён."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değiştirilmedi – iOS izin almadı. Orijinal değişmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Без змін – iOS не отримав дозволу. Оригінал не змінено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未更改 – iOS 未获得许可。原件保持不变。"
          }
        }
      }
    },
    "edit_err_gone": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تغيير هذا العنصر أو نقله أو حذفه في هذه الأثناء. لم يُحفظ أي شيء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Foto oder Video wurde inzwischen geändert, verschoben oder gelöscht. Es wurde nichts gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This item was changed, moved or deleted in the meantime. Nothing was saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este elemento se ha cambiado, movido o eliminado mientras tanto. No se guardó nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet élément a été modifié, déplacé ou supprimé entre-temps. Rien n’a été enregistré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nel frattempo l’elemento è stato modificato, spostato o eliminato. Non è stato salvato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その間にこのメディアが変更・移動・削除されました。何も保存されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그사이에 이 항목이 변경·이동·삭제되었어요. 아무것도 저장되지 않았어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit item is intussen gewijzigd, verplaatst of verwijderd. Er is niets opgeslagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W międzyczasie element został zmieniony, przeniesiony lub usunięty. Nic nie zapisano."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Entretanto, este item foi alterado, movido ou eliminado. Nada foi guardado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Între timp, elementul a fost modificat, mutat sau șters. Nu s-a salvat nimic."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тем временем файл изменили, переместили или удалили. Ничего не сохранено."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu öğe bu arada değiştirildi, taşındı veya silindi. Hiçbir şey kaydedilmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тим часом файл змінили, перемістили або видалили. Нічого не збережено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此项目已在此期间被更改、移动或删除，未保存任何内容。"
          }
        }
      }
    },
    "edit_err_load": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن فتح هذا العنصر للتعديل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Foto oder Video lässt sich leider nicht bearbeiten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This item can’t be opened for editing."
          }
        },
        "es": {
