    "wf_never_delete": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينشئ سير العمل ملفات جديدة فقط. لا يحذف شيئًا ولا ينقل الأصول إلى سلة المهملات."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A workflow only creates new files. It never deletes anything or moves originals to a trash."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Ablauf erstellt nur neue Dateien. Er löscht nichts und legt keine Originale in einen Papierkorb."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A workflow only creates new files. It never deletes anything or moves originals to a trash."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un flujo solo crea archivos nuevos. Nunca elimina nada ni mueve originales a una papelera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un flux crée uniquement de nouveaux fichiers. Il ne supprime rien et ne met aucun original à la corbeille."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A workflow only creates new files. It never deletes anything or moves originals to a trash."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un flusso crea solo nuovi file. Non elimina nulla e non sposta originali nel cestino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークフローは新しいファイルを作るだけです。何も削除せず、元のファイルをゴミ箱に移しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 흐름은 새 파일만 만들어요. 아무것도 삭제하지 않고 원본을 휴지통으로 옮기지 않아요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A workflow only creates new files. It never deletes anything or moves originals to a trash."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een werkstroom maakt alleen nieuwe bestanden. Hij verwijdert niets en verplaatst geen originelen naar een prullenbak."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przepływ tworzy tylko nowe pliki. Niczego nie usuwa i nie przenosi oryginałów do kosza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A workflow only creates new files. It never deletes anything or moves originals to a trash."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um fluxo só cria ficheiros novos. Nunca elimina nada nem move originais para um lixo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un flux creează doar fișiere noi. Nu șterge nimic și nu mută originalele în coș."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сценарий только создаёт новые файлы. Он ничего не удаляет и не переносит оригиналы в корзину."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A workflow only creates new files. It never deletes anything or moves originals to a trash."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A workflow only creates new files. It never deletes anything or moves originals to a trash."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir iş akışı yalnızca yeni dosyalar oluşturur. Hiçbir şeyi silmez ve orijinalleri çöp kutusuna taşımaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сценарій лише створює нові файли. Він нічого не видаляє й не переносить оригінали в кошик."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A workflow only creates new files. It never deletes anything or moves originals to a trash."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工作流程只会创建新文件，绝不删除任何内容，也不会把原文件移到回收站。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A workflow only creates new files. It never deletes anything or moves originals to a trash."
          }
        }
      }
    },
