    "dup_none_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم نجد نسخًا متطابقة في الأقسام المتاحة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাক্সেসযোগ্য জায়গায় কোনো অভিন্ন কপি পাওয়া যায়নি।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s’han trobat còpies idèntiques a les zones accessibles."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V dostupných oblastech nebyly nalezeny žádné identické kopie."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der blev ikke fundet identiske kopier i de tilgængelige områder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In den zugänglichen Bereichen wurden keine identischen Kopien gefunden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν βρέθηκαν πανομοιότυπα αντίγραφα στις προσβάσιμες περιοχές."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No identical copies were found in the accessible areas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han encontrado copias idénticas en las zonas accesibles."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytettävissä olevilta alueilta ei löytynyt identtisiä kopioita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune copie identique n’a été trouvée dans les zones accessibles."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઍક્સેસ કરી શકાય તેવા ભાગોમાં કોઈ સરખી નકલ મળી નથી."
