    "snake_photos_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم حتى 12 معاينة عشوائية أو اختر حتى 18 صورة. تبقى المعاينات في الذاكرة، وتُستبعد صور الخزنة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Use up to 12 random previews or choose up to 18 photos yourself. Previews stay in memory; vault photos are excluded."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Use up to 12 random previews or choose up to 18 photos yourself. Previews stay in memory; vault photos are excluded."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Use up to 12 random previews or choose up to 18 photos yourself. Previews stay in memory; vault photos are excluded."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Use up to 12 random previews or choose up to 18 photos yourself. Previews stay in memory; vault photos are excluded."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze bis zu 12 zufällige Vorschauen oder wähle bis zu 18 Fotos selbst. Vorschauen bleiben im Arbeitsspeicher; Tresorfotos sind ausgeschlossen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Use up to 12 random previews or choose up to 18 photos yourself. Previews stay in memory; vault photos are excluded."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use up to 12 random previews or choose up to 18 photos yourself. Previews stay in memory; vault photos are excluded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa hasta 12 vistas previas aleatorias o elige hasta 18 fotos. Las vistas previas quedan en memoria; se excluyen las fotos de la caja fuerte."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Use up to 12 random previews or choose up to 18 photos yourself. Previews stay in memory; vault photos are excluded."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez jusqu’à 12 aperçus aléatoires ou choisissez jusqu’à 18 photos. Les aperçus restent en mémoire ; les photos du coffre sont exclues."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Use up to 12 random previews or choose up to 18 photos yourself. Previews stay in memory; vault photos are excluded."
          }
        },
        "he": {
