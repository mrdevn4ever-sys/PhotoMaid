    "vid_remove_audio_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يُكتب مسار الصوت في الملف إطلاقًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lydsporet skrives slet ikke ind i filen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tonspur wird gar nicht in die Datei geschrieben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sound track is not written into the file at all."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pista de sonido no se escribe en el archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La piste son n’est pas du tout écrite dans le fichier."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Trek suara sama sekali tidak ditulis ke file."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La traccia audio non viene scritta nel file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声トラックはファイルに書き込まれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소리 트랙이 파일에 아예 기록되지 않아요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lydsporet skrives ikke inn i filen i det hele tatt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het geluidsspoor wordt helemaal niet in het bestand geschreven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ścieżka dźwiękowa w ogóle nie trafia do pliku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A faixa de som nem é gravada no arquivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A faixa de som não é escrita no ficheiro."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pista audio nu este scrisă deloc în fișier."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звуковая дорожка вообще не записывается в файл."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ljudspåret skrivs inte alls in i filen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แทร็กเสียงจะไม่ถูกเขียนลงไฟล์เลย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses kanalı dosyaya hiç yazılmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Звукова доріжка взагалі не записується у файл."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rãnh âm thanh hoàn toàn không được ghi vào tệp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音轨完全不会写入文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "聲音軌完全不會寫入檔案。"
          }
        }
      }
    },
    "vid_speed_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُسرَّع الصوت أو يُبطَّأ مع الحفاظ على طبقته."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyden gøres hurtigere eller langsommere med samme tonehøjde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ton wird mit gleicher Tonhöhe schneller oder langsamer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sound is sped up or slowed down with the same pitch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sonido se acelera o ralentiza sin cambiar el tono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le son est accéléré ou ralenti sans changer de hauteur."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Suara dipercepat atau diperlambat dengan nada yang sama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio viene accelerato o rallentato mantenendo l’intonazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声は音程を保ったまま速く・遅くなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소리는 음높이를 유지한 채 빨라지거나 느려져요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyden gjøres raskere eller saktere med samme tonehøyde."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het geluid wordt sneller of langzamer met dezelfde toonhoogte."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dźwięk przyspiesza lub zwalnia bez zmiany wysokości."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O som é acelerado ou desacelerado com o mesmo tom."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O som fica mais rápido ou lento sem mudar o tom."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunetul se accelerează sau încetinește fără să-și schimbe tonalitatea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звук ускоряется или замедляется без изменения высоты."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ljudet snabbas upp eller saktas ned med samma tonhöjd."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสียงจะเร็วขึ้นหรือช้าลงโดยความสูงต่ำของเสียงไม่เปลี่ยนแปลง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses, perdesi değişmeden hızlanır veya yavaşlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Звук пришвидшується чи сповільнюється без зміни висоти."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Âm thanh được tăng hoặc giảm tốc với cao độ không đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "声音会变快或变慢，音调保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "聲音會加快或放慢，音調保持不變。"
          }
        }
      }
    },
