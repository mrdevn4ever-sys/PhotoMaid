        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplit le nouveau format ; les bords en trop sont coupés."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "નવું ફૉર્મેટ ભરે છે; બહારની કિનારીઓ કપાય છે."
