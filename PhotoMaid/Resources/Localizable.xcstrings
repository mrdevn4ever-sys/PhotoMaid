    "archive_write_list_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحفظ جدولًا (ملف CSV) في مجلد الوجهة يتضمن اسم كل ملف وتاريخه وحجمه ومجموعه الاختباري، إضافة إلى ألبوماتك ووسومك وملاحظاتك – لتتمكن من فحص النسخ لاحقًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "গন্তব্য ফোল্ডারে একটি টেবিল (CSV ফাইল) সংরক্ষণ করে, যাতে প্রতিটি ফাইলের নাম, তারিখ, আকার ও চেকসাম এবং আপনার অ্যালবাম, ট্যাগ ও নোট থাকে – যাতে পরে কপিগুলো যাচাই করতে পারেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Desa una taula (fitxer CSV) a la carpeta de destinació amb el nom, la data, la mida i la suma de verificació de cada fitxer, a més dels teus àlbums, etiquetes i notes, perquè puguis comprovar les còpies més endavant."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uloží do cílové složky tabulku (soubor CSV) s názvem, datem, velikostí a kontrolním součtem každého souboru a také s vašimi alby, štítky a poznámkami – abyste mohli kopie později zkontrolovat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemmer en tabel (CSV-fil) i destinationsmappen med hver fils navn, dato, størrelse og kontrolsum samt dine albummer, tags og noter – så du kan kontrollere kopierne senere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt eine Tabelle (CSV-Datei) in den Zielordner: Name, Datum, Größe und Prüfsumme jeder Datei sowie deine Alben, Schlagwörter und Notizen – damit du die Kopien später nachprüfen kannst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αποθηκεύει έναν πίνακα (αρχείο CSV) στον φάκελο προορισμού με όνομα, ημερομηνία, μέγεθος και άθροισμα ελέγχου κάθε αρχείου, καθώς και τα άλμπουμ, τις ετικέτες και τις σημειώσεις σου – για να ελέγξεις τα αντίγραφα αργότερα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves a table (CSV file) in the destination folder with each file’s name, date, size and checksum, plus your albums, tags and notes – so you can check the copies later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda una tabla (archivo CSV) en la carpeta de destino con el nombre, la fecha, el tamaño y la suma de comprobación de cada archivo, además de tus álbumes, etiquetas y notas, para poder comprobar las copias más tarde."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallentaa kohdekansioon taulukon (CSV-tiedosto), jossa on jokaisen tiedoston nimi, päivä, koko ja tarkistussumma sekä albumisi, tunnisteesi ja muistiinpanosi – jotta voit tarkistaa kopiot myöhemmin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre un tableau (fichier CSV) dans le dossier de destination avec le nom, la date, la taille et la somme de contrôle de chaque fichier, ainsi que vos albums, mots-clés et notes – pour pouvoir vérifier les copies plus tard."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ગંતવ્ય ફોલ્ડરમાં એક કોષ્ટક (CSV ફાઇલ) સાચવે છે જેમાં દરેક ફાઇલનું નામ, તારીખ, કદ અને ચેકસમ, સાથે તમારા આલ્બમ, ટૅગ અને નોંધો હોય છે – જેથી તમે પછી નકલો ચકાસી શકો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שומר טבלה (קובץ CSV) בתיקיית היעד עם השם, התאריך, הגודל וסכום הביקורת של כל קובץ, וגם את האלבומים, התגיות וההערות שלך – כדי שאפשר יהיה לבדוק את העותקים בהמשך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गंतव्य फ़ोल्डर में एक टेबल (CSV फ़ाइल) सहेजता है जिसमें हर फ़ाइल का नाम, तारीख, साइज़ और चेकसम, साथ ही आपके एल्बम, टैग और नोट होते हैं – ताकि आप बाद में कॉपी जाँच सकें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprema tablicu (CSV datoteku) u odredišnu mapu s nazivom, datumom, veličinom i kontrolnim zbrojem svake datoteke te tvojim albumima, oznakama i bilješkama – da kopije možeš provjeriti kasnije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy táblázatot (CSV-fájlt) ment a célmappába minden fájl nevével, dátumával, méretével és ellenőrzőösszegével, valamint az albumaiddal, címkéiddel és jegyzeteiddel – hogy később ellenőrizhesd a másolatokat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyimpan tabel (file CSV) di folder tujuan berisi nama, tanggal, ukuran, dan checksum setiap file, plus album, tag, dan catatanmu – agar kamu bisa memeriksa salinan nanti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva una tabella (file CSV) nella cartella di destinazione con nome, data, dimensione e checksum di ogni file, oltre ad album, tag e note, così potrai verificare le copie in seguito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存先フォルダに表（CSVファイル）を保存します。各ファイルの名前、日付、サイズ、チェックサムと、アルバム、タグ、メモが含まれ、後でコピーを確認できます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಗಮ್ಯ ಫೋಲ್ಡರ್‌ನಲ್ಲಿ ಒಂದು ಟೇಬಲ್ (CSV ಫೈಲ್) ಉಳಿಸುತ್ತದೆ, ಅದರಲ್ಲಿ ಪ್ರತಿ ಫೈಲ್‌ನ ಹೆಸರು, ದಿನಾಂಕ, ಗಾತ್ರ ಮತ್ತು ಚೆಕ್‌ಸಮ್, ಜೊತೆಗೆ ನಿಮ್ಮ ಆಲ್ಬಮ್‌ಗಳು, ಟ್ಯಾಗ್‌ಗಳು ಮತ್ತು ಟಿಪ್ಪಣಿಗಳು ಇರುತ್ತವೆ – ಇದರಿಂದ ನಂತರ ಪ್ರತಿಗಳನ್ನು ಪರಿಶೀಲಿಸಬಹುದು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대상 폴더에 표(CSV 파일)를 저장해요. 각 파일의 이름, 날짜, 크기, 체크섬과 앨범, 태그, 메모가 담겨 있어 나중에 사본을 확인할 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ലക്ഷ്യ ഫോൾഡറിൽ ഒരു പട്ടിക (CSV ഫയൽ) സംരക്ഷിക്കുന്നു, അതിൽ ഓരോ ഫയലിന്റെയും പേര്, തീയതി, വലുപ്പം, ചെക്ക്‌സം എന്നിവയും നിങ്ങളുടെ ആൽബങ്ങൾ, ടാഗുകൾ, കുറിപ്പുകൾ എന്നിവയും ഉണ്ടാകും – പിന്നീട് പകർപ്പുകൾ പരിശോധിക്കാൻ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "गंतव्य फोल्डरमध्ये एक तक्ता (CSV फाइल) जतन करते ज्यात प्रत्येक फाइलचे नाव, तारीख, आकार आणि चेकसम, तसेच तुमचे अल्बम, टॅग आणि नोंदी असतात – जेणेकरून तुम्ही नंतर प्रती तपासू शकता."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyimpan jadual (fail CSV) dalam folder destinasi dengan nama, tarikh, saiz dan hasil tambah semak setiap fail, serta album, tag dan nota anda – supaya anda boleh menyemak salinan kemudian."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagrer en tabell (CSV-fil) i målmappen med hver fils navn, dato, størrelse og kontrollsum, i tillegg til albumene, etikettene og notatene dine – slik at du kan kontrollere kopiene senere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaart een tabel (csv-bestand) in de doelmap met naam, datum, grootte en controlegetal van elk bestand, plus je albums, tags en notities – zo kun je de kopieën later controleren."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଗନ୍ତବ୍ୟ ଫୋଲ୍ଡରରେ ଏକ ସାରଣୀ (CSV ଫାଇଲ୍) ସେଭ୍ କରେ, ଯେଉଁଥିରେ ପ୍ରତ୍ୟେକ ଫାଇଲ୍‌ର ନାମ, ତାରିଖ, ଆକାର ଓ ଚେକସମ୍, ସହିତ ଆପଣଙ୍କ ଆଲବମ୍, ଟ୍ୟାଗ୍ ଓ ନୋଟ୍ ଥାଏ – ଯାହାଦ୍ୱାରା ପରେ କପିଗୁଡ଼ିକ ଯାଞ୍ଚ କରିପାରିବେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮੰਜ਼ਿਲ ਫ਼ੋਲਡਰ ਵਿੱਚ ਇੱਕ ਸਾਰਣੀ (CSV ਫ਼ਾਈਲ) ਸੰਭਾਲਦਾ ਹੈ ਜਿਸ ਵਿੱਚ ਹਰ ਫ਼ਾਈਲ ਦਾ ਨਾਮ, ਤਾਰੀਖ, ਆਕਾਰ ਅਤੇ ਚੈੱਕਸਮ, ਨਾਲ ਹੀ ਤੁਹਾਡੀਆਂ ਐਲਬਮਾਂ, ਟੈਗ ਅਤੇ ਨੋਟ ਹੁੰਦੇ ਹਨ – ਤਾਂ ਜੋ ਤੁਸੀਂ ਬਾਅਦ ਵਿੱਚ ਕਾਪੀਆਂ ਜਾਂਚ ਸਕੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisuje w folderze docelowym tabelę (plik CSV) z nazwą, datą, rozmiarem i sumą kontrolną każdego pliku oraz Twoimi albumami, tagami i notatkami – aby można było później sprawdzić kopie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva uma tabela (arquivo CSV) na pasta de destino com nome, data, tamanho e soma de verificação de cada arquivo, além dos seus álbuns, etiquetas e notas – para você conferir as cópias depois."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda uma tabela (ficheiro CSV) na pasta de destino com o nome, a data, o tamanho e a soma de verificação de cada ficheiro, além dos seus álbuns, etiquetas e notas – para poder verificar as cópias mais tarde."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvează în dosarul de destinație un tabel (fișier CSV) cu numele, data, dimensiunea și suma de control a fiecărui fișier, plus albumele, etichetele și notițele tale – ca să poți verifica copiile mai târziu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняет в папке назначения таблицу (CSV-файл) с именем, датой, размером и контрольной суммой каждого файла, а также вашими альбомами, тегами и заметками – чтобы позже проверить копии."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Uloží do cieľového priečinka tabuľku (súbor CSV) s názvom, dátumom, veľkosťou a kontrolným súčtom každého súboru a tiež s vašimi albumami, štítkami a poznámkami – aby ste mohli kópie neskôr skontrolovať."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "V ciljno mapo shrani tabelo (datoteko CSV) z imenom, datumom, velikostjo in kontrolno vsoto vsake datoteke ter s tvojimi albumi, oznakami in zapiski – da lahko kopije pozneje preveriš."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparar en tabell (CSV-fil) i målmappen med varje fils namn, datum, storlek och kontrollsumma, plus dina album, taggar och anteckningar – så att du kan kontrollera kopiorna senare."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இலக்குக் கோப்புறையில் ஒரு அட்டவணையைச் (CSV கோப்பு) சேமிக்கிறது: ஒவ்வொரு கோப்பின் பெயர், தேதி, அளவு, செக்சம் மற்றும் உங்கள் ஆல்பங்கள், குறிச்சொற்கள், குறிப்புகள் – பின்னர் நகல்களைச் சரிபார்க்க."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "గమ్య ఫోల్డర్‌లో ఒక టేబుల్ (CSV ఫైల్) సేవ్ చేస్తుంది: ప్రతి ఫైల్ పేరు, తేదీ, పరిమాణం, చెక్‌సమ్, అలాగే మీ ఆల్బమ్‌లు, ట్యాగ్‌లు, నోట్‌లు – తర్వాత కాపీలను తనిఖీ చేయడానికి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกตาราง (ไฟล์ CSV) ในโฟลเดอร์ปลายทาง พร้อมชื่อ วันที่ ขนาด และค่าตรวจสอบของแต่ละไฟล์ รวมถึงอัลบั้ม แท็ก และโน้ตของคุณ – เพื่อให้ตรวจสอบสำเนาได้ภายหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hedef klasöre her dosyanın adı, tarihi, boyutu ve sağlama toplamı ile albümlerin, etiketlerin ve notların bulunduğu bir tablo (CSV dosyası) kaydeder; böylece kopyaları sonra kontrol edebilirsin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберігає в папці призначення таблицю (CSV-файл) з назвою, датою, розміром і контрольною сумою кожного файлу, а також вашими альбомами, тегами й нотатками – щоб пізніше перевірити копії."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "منزل کے فولڈر میں ایک ٹیبل (CSV فائل) محفوظ کرتا ہے جس میں ہر فائل کا نام، تاریخ، سائز اور چیک سم، نیز آپ کے البمز، ٹیگز اور نوٹس ہوتے ہیں – تاکہ آپ بعد میں کاپیاں جانچ سکیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu một bảng (tệp CSV) trong thư mục đích với tên, ngày, kích thước và mã kiểm tra của từng tệp, cùng album, thẻ và ghi chú của bạn – để bạn kiểm tra bản sao sau này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在目标文件夹中存储一张表格（CSV 文件），包含每个文件的名称、日期、大小和校验和，以及你的相簿、标签和备注，方便日后核对副本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在目的地檔案夾中儲存一份表格（CSV 檔），包含每個檔案的名稱、日期、大小和校驗碼，以及你的相簿、標籤和備註 – 方便日後檢查副本。"
          }
        }
      }
    },
