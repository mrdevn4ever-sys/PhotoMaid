    "collage_res_strip_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في الشريط يخص الرقم العرض (عموديًا) أو الارتفاع (أفقيًا). تُصغَّر الشرائط الطويلة جدًا ليمكن حفظها."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For striber er tallet bredden (oppefra og ned) eller højden (side om side). Meget lange striber formindskes, så de kan gemmes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Streifen gilt die Zahl für die Breite (untereinander) bzw. die Höhe (nebeneinander). Sehr lange Streifen werden verkleinert, damit sie sich speichern lassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For strips, the number is the width (top to bottom) or the height (side by side). Very long strips are reduced so they can be saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En las tiras, el número es el ancho (de arriba abajo) o el alto (lado a lado). Las tiras muy largas se reducen para poder guardarlas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour les bandes, le nombre correspond à la largeur (de haut en bas) ou à la hauteur (côte à côte). Les bandes très longues sont réduites pour pouvoir être enregistrées."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk strip, angkanya adalah lebar (atas ke bawah) atau tinggi (berdampingan). Strip yang sangat panjang diperkecil agar bisa disimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per le strisce il numero indica la larghezza (dall’alto in basso) o l’altezza (affiancate). Le strisce molto lunghe vengono ridotte per poterle salvare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストリップでは、縦並びは幅、横並びは高さの値です。とても長いストリップは保存できるように縮小されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스트립에서는 숫자가 너비(세로 배치) 또는 높이(가로 배치)를 뜻합니다. 아주 긴 스트립은 저장할 수 있도록 축소됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For striper er tallet bredden (ovenfra og ned) eller høyden (side om side). Svært lange striper forminskes slik at de kan lagres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij stroken is het getal de breedte (onder elkaar) of de hoogte (naast elkaar). Heel lange stroken worden verkleind zodat ze kunnen worden bewaard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W pasku liczba oznacza szerokość (jeden pod drugim) lub wysokość (obok siebie). Bardzo długie paski są zmniejszane, aby dało się je zapisać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em faixas, o número é a largura (de cima para baixo) ou a altura (lado a lado). Faixas muito longas são reduzidas para poderem ser salvas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nas tiras, o número é a largura (de cima para baixo) ou a altura (lado a lado). Tiras muito longas são reduzidas para poderem ser guardadas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "La benzi, numărul este lățimea (una sub alta) sau înălțimea (una lângă alta). Benzile foarte lungi sunt micșorate ca să poată fi salvate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для ленты число — ширина (сверху вниз) или высота (в ряд). Очень длинные ленты уменьшаются, чтобы их можно было сохранить."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För remsor är talet bredden (uppifrån och ned) eller höjden (sida vid sida). Mycket långa remsor förminskas så att de kan sparas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สำหรับแถบ ตัวเลขคือความกว้าง (บนลงล่าง) หรือความสูง (เคียงข้างกัน) แถบที่ยาวมากจะถูกย่อเพื่อให้บันทึกได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şeritlerde sayı genişliği (alt alta) veya yüksekliği (yan yana) belirtir. Çok uzun şeritler kaydedilebilmeleri için küçültülür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для стрічки число — ширина (згори вниз) або висота (в ряд). Дуже довгі стрічки зменшуються, щоб їх можна було зберегти."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Với dải, con số là chiều rộng (trên xuống dưới) hoặc chiều cao (cạnh nhau). Dải quá dài sẽ được thu nhỏ để có thể lưu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长条拼图中，数字指宽度（上下排列）或高度（左右排列）。过长的长条会缩小以便保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "長條拼貼的數字代表寬度（上下排列）或高度（左右並排）。過長的長條會縮小以便儲存。"
          }
        }
      }
    },
