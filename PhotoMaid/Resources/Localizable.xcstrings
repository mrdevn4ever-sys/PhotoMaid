    "fc_buttons_footer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم «تعديل» لتغيير الترتيب أو إزالة الأزرار. 6 أزرار كحد أقصى. تؤدي الأزرار نفس عمل السحب تمامًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্রম বদলাতে বা বোতাম সরাতে “সম্পাদনা” ব্যবহার করুন। সর্বোচ্চ ৬টি বোতাম। বোতামগুলো হুবহু সোয়াইপের মতোই কাজ করে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fes servir «Editar» per canviar l’ordre o treure botons. Fins a 6 botons. Els botons fan exactament el mateix que els lliscaments."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomocí „Upravit“ změníte pořadí nebo odeberete tlačítka. Až 6 tlačítek. Tlačítka dělají přesně totéž co přejetí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug “Rediger” til at ændre rækkefølgen eller fjerne knapper. Op til 6 knapper. Knapperne gør præcis det samme som swipes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit „Bearbeiten“ Reihenfolge ändern oder Tasten entfernen. Höchstens 6 Tasten. Tasten lösen dasselbe aus wie die Wischgesten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Με την «Επεξεργασία» αλλάζεις τη σειρά ή αφαιρείς κουμπιά. Έως 6 κουμπιά. Τα κουμπιά κάνουν ακριβώς ό,τι και τα σαρώματα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use “Edit” to change the order or remove buttons. Up to 6 buttons. Buttons do exactly the same as the swipes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa «Editar» para cambiar el orden o quitar botones. Hasta 6 botones. Los botones hacen exactamente lo mismo que los gestos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muuta järjestystä tai poista painikkeita valinnalla ”Muokkaa”. Enintään 6 painiketta. Painikkeet tekevät täsmälleen saman kuin pyyhkäisyt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise « Modifier » pour changer l’ordre ou retirer des boutons. 6 boutons au maximum. Les boutons font exactement la même chose que les balayages."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ક્રમ બદલવા કે બટન દૂર કરવા “ફેરફાર કરો” વાપરો. વધુમાં વધુ 6 બટન. બટન બરાબર સ્વાઇપ જેવું જ કામ કરે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר להשתמש ב„עריכה” כדי לשנות את הסדר או להסיר כפתורים. עד 6 כפתורים. הכפתורים עושים בדיוק את מה שעושות ההחלקות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्रम बदलने या बटन हटाने के लिए “संपादित करें” का उपयोग करें। ज़्यादा से ज़्यादा 6 बटन। बटन बिल्कुल वही करते हैं जो स्वाइप करते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koristi „Uredi” za promjenu redoslijeda ili uklanjanje tipki. Do 6 tipki. Tipke rade isto što i povlačenja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A „Szerkesztés” gombbal módosíthatod a sorrendet vagy eltávolíthatsz gombokat. Legfeljebb 6 gomb. A gombok pontosan ugyanazt teszik, mint a húzások."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pakai “Edit” untuk mengubah urutan atau menghapus tombol. Maksimal 6 tombol. Tombol melakukan hal yang persis sama dengan geseran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa «Modifica» per cambiare l’ordine o rimuovere pulsanti. Fino a 6 pulsanti. I pulsanti fanno esattamente lo stesso dei gesti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「編集」で順序の変更やボタンの削除ができます。ボタンは最大6個です。ボタンはスワイプとまったく同じ動作をします。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕ್ರಮ ಬದಲಿಸಲು ಅಥವಾ ಬಟನ್‌ಗಳನ್ನು ತೆಗೆದುಹಾಕಲು “ಎಡಿಟ್ ಮಾಡಿ” ಬಳಸಿ. ಗರಿಷ್ಠ 6 ಬಟನ್‌ಗಳು. ಬಟನ್‌ಗಳು ಸ್ವೈಪ್‌ಗಳಂತೆಯೇ ನಿಖರವಾಗಿ ಕೆಲಸ ಮಾಡುತ್ತವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘편집’으로 순서를 바꾸거나 버튼을 삭제하세요. 버튼은 최대 6개예요. 버튼은 스와이프와 똑같이 동작해요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ക്രമം മാറ്റാനോ ബട്ടണുകൾ നീക്കം ചെയ്യാനോ “എഡിറ്റ് ചെയ്യുക” ഉപയോഗിക്കുക. പരമാവധി 6 ബട്ടണുകൾ. ബട്ടണുകൾ സ്വൈപ്പുകൾ ചെയ്യുന്നത് തന്നെ കൃത്യമായി ചെയ്യുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "क्रम बदलण्यासाठी किंवा बटणे काढण्यासाठी “संपादित करा” वापरा. जास्तीत जास्त 6 बटणे. बटणे स्वाइपसारखेच काम करतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan “Edit” untuk menukar susunan atau membuang butang. Sehingga 6 butang. Butang melakukan perkara yang sama seperti leretan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk «Rediger» for å endre rekkefølgen eller fjerne knapper. Opptil 6 knapper. Knappene gjør nøyaktig det samme som sveipene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik ‘Wijzig’ om de volgorde te veranderen of knoppen te verwijderen. Maximaal 6 knoppen. Knoppen doen precies hetzelfde als vegen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "କ୍ରମ ବଦଳାଇବାକୁ କିମ୍ବା ବଟନ୍ ହଟାଇବାକୁ “ଏଡିଟ୍ କରନ୍ତୁ” ବ୍ୟବହାର କରନ୍ତୁ। ସର୍ବାଧିକ 6ଟି ବଟନ୍। ବଟନ୍ ଠିକ୍ ସ୍ୱାଇପ୍ ଭଳି କାମ କରେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕ੍ਰਮ ਬਦਲਣ ਜਾਂ ਬਟਨ ਹਟਾਉਣ ਲਈ “ਸੋਧੋ” ਵਰਤੋ। ਵੱਧ ਤੋਂ ਵੱਧ 6 ਬਟਨ। ਬਟਨ ਬਿਲਕੁਲ ਸਵਾਈਪਾਂ ਵਾਲਾ ਹੀ ਕੰਮ ਕਰਦੇ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj „Edytuj”, aby zmienić kolejność lub usunąć przyciski. Maksymalnie 6 przycisków. Przyciski działają dokładnie jak przesunięcia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use “Editar” para mudar a ordem ou remover botões. Até 6 botões. Os botões fazem exatamente o mesmo que os gestos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa «Editar» para mudar a ordem ou remover botões. Até 6 botões. Os botões fazem exatamente o mesmo que os gestos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Folosește „Editează” ca să schimbi ordinea sau să elimini butoane. Maximum 6 butoane. Butoanele fac exact ce fac glisările."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажми «Изменить», чтобы поменять порядок или удалить кнопки. Не больше 6 кнопок. Кнопки делают ровно то же, что и смахивания."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomocou „Upraviť“ zmeníte poradie alebo odstránite tlačidlá. Až 6 tlačidiel. Tlačidlá robia presne to isté ako potiahnutia."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Z »Uredi« spremeniš vrstni red ali odstraniš gumbe. Do 6 gumbov. Gumbi naredijo natanko isto kot podrsanja."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd ”Redigera” för att ändra ordning eller ta bort knappar. Upp till 6 knappar. Knapparna gör exakt samma sak som sveptagen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வரிசையை மாற்ற அல்லது பொத்தான்களை அகற்ற “திருத்து” பயன்படுத்துங்கள். அதிகபட்சம் 6 பொத்தான்கள். பொத்தான்கள் ஸ்வைப்களைப் போலவே சரியாகச் செயல்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "క్రమం మార్చడానికి లేదా బటన్‌లను తీసివేయడానికి “ఎడిట్ చేయండి” వాడండి. గరిష్ఠంగా 6 బటన్‌లు. బటన్‌లు స్వైప్‌లు చేసేదాన్నే ఖచ్చితంగా చేస్తాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ “แก้ไข” เพื่อเปลี่ยนลำดับหรือลบปุ่ม สูงสุด 6 ปุ่ม ปุ่มทำงานเหมือนการปัดทุกประการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sırayı değiştirmek ya da düğme kaldırmak için “Düzenle”yi kullan. En fazla 6 düğme. Düğmeler kaydırmalarla tamamen aynı işi yapar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисни «Редагувати», щоб змінити порядок або вилучити кнопки. Не більше 6 кнопок. Кнопки роблять те саме, що й змахування."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ترتیب بدلنے یا بٹن ہٹانے کے لیے ”ترمیم کریں“ استعمال کریں۔ زیادہ سے زیادہ 6 بٹن۔ بٹن بالکل وہی کرتے ہیں جو سوائپ کرتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng “Sửa” để đổi thứ tự hoặc xóa nút. Tối đa 6 nút. Nút làm đúng như các thao tác vuốt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用“编辑”更改顺序或移除按钮。最多 6 个按钮。按钮与滑动的作用完全相同。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用「編輯」來更改順序或移除按鈕。最多 6 個按鈕。按鈕的功能與滑動完全相同。"
          }
        }
      }
    },
