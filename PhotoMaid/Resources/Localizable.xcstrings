            "value": "At most %1$lld photos per PDF – the first %1$lld were taken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Como máximo %1$lld fotos por PDF: se han incluido las primeras %1$lld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
