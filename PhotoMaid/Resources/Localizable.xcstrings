          "stringUnit": {
            "state": "translated",
            "value": "उपलब्ध भागांत एकसारख्या प्रती सापडल्या नाहीत."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada salinan sama ditemui dalam kawasan yang boleh diakses."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fant ingen identiske kopier i de tilgjengelige områdene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn geen identieke kopieën gevonden in de toegankelijke gedeelten."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆକ୍ସେସଯୋଗ୍ୟ ସ୍ଥାନରେ କୌଣସି ସମାନ କପି ମିଳିଲା ନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪਹੁੰਚਯੋਗ ਹਿੱਸਿਆਂ ਵਿੱਚ ਕੋਈ ਇੱਕੋ ਜਿਹੀ ਕਾਪੀ ਨਹੀਂ ਮਿਲੀ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono identycznych kopii w dostępnych obszarach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma cópia idêntica foi encontrada nas áreas acessíveis."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foram encontradas cópias idênticas nas áreas acessíveis."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu s-au găsit copii identice în zonele accesibile."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В доступных разделах одинаковые копии не найдены."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "V dostupných oblastiach sa nenašli žiadne identické kópie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "V dostopnih območjih ni bilo najdenih enakih kopij."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga identiska kopior hittades i de tillgängliga områdena."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அணுகக்கூடிய இடங்களில் ஒரே மாதிரியான நகல்கள் கிடைக்கவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "యాక్సెస్ చేయగల ప్రాంతాల్లో ఒకేలాంటి కాపీలు కనుగొనబడలేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่พบสำเนาที่เหมือนกันในพื้นที่ที่เข้าถึงได้"
          }
        },
        "tr": {
