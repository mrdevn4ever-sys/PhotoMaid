    "result_allowance#few": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المحدد: %2$lld. المتاح للإزالة اليوم: %1$lld. حدّد حتى %1$lld أو احصل على GaleriQ Pro."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vybráno: %2$lld. Dnes můžete odstranit ještě %1$lld položky. Vyberte nejvýše %1$lld nebo si pořiďte GaleriQ Pro."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odabrano: %2$lld. Danas možeš ukloniti još %1$lld stavke. Odaberi najviše %1$lld ili nabavi GaleriQ Pro."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznaczono: %2$lld. Dziś możesz usunąć jeszcze %1$lld elementy. Wybierz maksymalnie %1$lld lub skorzystaj z GaleriQ Pro."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Selectate: %2$lld. Azi mai poți elimina %1$lld elemente. Selectează cel mult %1$lld sau alege GaleriQ Pro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбрано: %2$lld. Сегодня можно удалить ещё %1$lld элемента. Выбери не более %1$lld или воспользуйся GaleriQ Pro."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vybraté: %2$lld. Dnes môžete odstrániť ešte %1$lld položky. Vyberte najviac %1$lld alebo si zaobstarajte GaleriQ Pro."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izbrano: %2$lld. Danes lahko odstraniš še %1$lld elemente. Izberi največ %1$lld ali si omisli GaleriQ Pro."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибрано: %2$lld. Сьогодні можна видалити ще %1$lld елементи. Вибери не більше %1$lld або скористайся GaleriQ Pro."
          }
        }
      }
    },
