    "snake_gallery_privacy": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُستخدم صورك المختارة فقط. تبقى نسخ صغيرة على هذا iPhone خارج نسخة iCloud الاحتياطية. أزلها هنا لحذف النسخ."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু আপনার বেছে নেওয়া ফটো ব্যবহার হয়। ছোট কপিগুলো এই iPhone-এ, iCloud ব্যাকআপের বাইরে থাকে। এই কপিগুলো মুছতে এখান থেকে সরান।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Només es fan servir les fotos que tries. Les còpies petites es queden en aquest iPhone, fora de la còpia de seguretat d’iCloud. Treu-les aquí per esborrar aquestes còpies."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Používají se jen fotky, které vyberete. Malé kopie zůstávají v tomto iPhonu, mimo zálohu na iCloudu. Odeberte je tady a tyto kopie se smažou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun dine valgte fotos bruges. Små kopier bliver på denne iPhone, uden for iCloud-sikkerhedskopien. Fjern dem her for at slette kopierne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur deine ausgewählten Fotos werden verwendet. Kleine Kopien bleiben auf diesem iPhone, ohne iCloud-Backup. Entferne sie hier, um diese Kopien zu löschen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρησιμοποιούνται μόνο οι φωτογραφίες που επιλέγεις. Μικρά αντίγραφα μένουν σε αυτό το iPhone, εκτός αντιγράφου ασφαλείας iCloud. Αφαίρεσέ τες εδώ για να διαγραφούν αυτά τα αντίγραφα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only your chosen photos are used. Small copies stay on this iPhone, outside iCloud backup. Remove them here to delete these copies."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se usan las fotos que elijas. Las copias pequeñas quedan en este iPhone, fuera de la copia de iCloud. Elimínalas aquí para borrar las copias."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain valitsemiasi kuvia käytetään. Pienet kopiot pysyvät tässä iPhonessa iCloud-varmuuskopion ulkopuolella. Poista ne täältä poistaaksesi nämä kopiot."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les photos choisies sont utilisées. De petites copies restent sur cet iPhone, hors sauvegarde iCloud. Retirez-les ici pour effacer ces copies."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફક્ત તમે પસંદ કરેલા ફોટા વપરાય છે. નાની નકલો આ જ iPhone પર, iCloud બૅકઅપની બહાર રહે છે. આ નકલો ડિલીટ કરવા તેમને અહીંથી દૂર કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רק התמונות שבחרת משמשות במשחק. עותקים קטנים נשארים ב-iPhone הזה, מחוץ לגיבוי iCloud. הסרה כאן מוחקת את העותקים האלה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिर्फ़ आपकी चुनी फ़ोटो इस्तेमाल होती हैं। छोटी कॉपी इसी iPhone पर, iCloud बैकअप से बाहर रहती हैं। इन कॉपी को डिलीट करने के लिए उन्हें यहाँ से हटाएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koriste se samo fotografije koje odabereš. Male kopije ostaju na ovom iPhoneu, izvan iCloud sigurnosne kopije. Ukloni ih ovdje da izbrišeš te kopije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak az általad kiválasztott fotók használhatók. A kis másolatok ezen az iPhone-on maradnak, az iCloud-mentésen kívül. Itt távolítsd el őket, hogy ezek a másolatok törlődjenek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya foto pilihanmu yang dipakai. Salinan kecil tetap di iPhone ini, di luar cadangan iCloud. Hapus di sini untuk menghapus salinan ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vengono usate solo le foto scelte. Piccole copie restano su questo iPhone, fuori dal backup iCloud. Rimuovile qui per eliminare le copie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した写真だけを使用します。小さなコピーはこのiPhoneに保存され、iCloudバックアップには含まれません。ここで削除するとコピーも削除されます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಆಯ್ಕೆಮಾಡಿದ ಫೋಟೋಗಳನ್ನು ಮಾತ್ರ ಬಳಸಲಾಗುತ್ತದೆ. ಚಿಕ್ಕ ಪ್ರತಿಗಳು ಈ iPhone ನಲ್ಲಿ, iCloud ಬ್ಯಾಕಪ್‌ನ ಹೊರಗೆ ಉಳಿಯುತ್ತವೆ. ಈ ಪ್ರತಿಗಳನ್ನು ಅಳಿಸಲು ಇಲ್ಲಿಂದ ತೆಗೆದುಹಾಕಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 사진만 사용합니다. 작은 사본은 이 iPhone에 저장되며 iCloud 백업에 포함되지 않습니다. 여기서 제거하면 사본이 삭제됩니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ തിരഞ്ഞെടുത്ത ഫോട്ടോകൾ മാത്രം ഉപയോഗിക്കുന്നു. ചെറിയ പകർപ്പുകൾ ഈ iPhone-ൽ, iCloud ബാക്കപ്പിന് പുറത്ത് തുടരും. ഈ പകർപ്പുകൾ ഇല്ലാതാക്കാൻ ഇവിടെ നിന്ന് നീക്കം ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फक्त तुम्ही निवडलेले फोटो वापरले जातात. लहान प्रती याच iPhone वर, iCloud बॅकअपच्या बाहेर राहतात. या प्रती डिलीट करण्यासाठी त्या इथून काढा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya foto yang anda pilih digunakan. Salinan kecil kekal pada iPhone ini, di luar sandaran iCloud. Buang di sini untuk memadam salinan ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare bildene du har valgt, brukes. Små kopier blir på denne iPhonen, utenfor iCloud-sikkerhetskopien. Fjern dem her for å slette kopiene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen gekozen foto's worden gebruikt. Kleine kopieën blijven op deze iPhone, buiten iCloud-reservekopieën. Verwijder ze hier om die kopieën te wissen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "କେବଳ ଆପଣ ବାଛିଥିବା ଫଟୋ ବ୍ୟବହାର ହୁଏ। ଛୋଟ କପିଗୁଡ଼ିକ ଏହି iPhoneରେ, iCloud ବ୍ୟାକଅପ୍ ବାହାରେ ରହେ। ଏହି କପି ଡିଲିଟ୍ କରିବାକୁ ଏଠାରୁ ହଟାନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਿਰਫ਼ ਤੁਹਾਡੀਆਂ ਚੁਣੀਆਂ ਫ਼ੋਟੋਆਂ ਵਰਤੀਆਂ ਜਾਂਦੀਆਂ ਹਨ। ਛੋਟੀਆਂ ਕਾਪੀਆਂ ਇਸ iPhone ਉੱਤੇ, iCloud ਬੈਕਅੱਪ ਤੋਂ ਬਾਹਰ ਰਹਿੰਦੀਆਂ ਹਨ। ਇਹ ਕਾਪੀਆਂ ਮਿਟਾਉਣ ਲਈ ਇਨ੍ਹਾਂ ਨੂੰ ਇੱਥੋਂ ਹਟਾਓ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Używane są tylko wybrane zdjęcia. Małe kopie pozostają na tym iPhonie, poza backupem iCloud. Usuń je tutaj, aby skasować kopie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só as fotos escolhidas são usadas. Cópias pequenas ficam neste iPhone, fora do backup do iCloud. Remova-as aqui para apagar essas cópias."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Só são usadas as fotos escolhidas. Pequenas cópias ficam neste iPhone, fora da cópia de segurança iCloud. Remove-as aqui para apagar as cópias."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunt folosite doar fotografiile alese. Copii mici rămân pe acest iPhone, în afara backupului iCloud. Elimină-le aici pentru a șterge copiile."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используются только выбранные фото. Небольшие копии остаются на этом iPhone без резервного копирования в iCloud. Удалите их здесь, чтобы стереть копии."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Používajú sa len fotky, ktoré vyberiete. Malé kópie zostávajú v tomto iPhone, mimo zálohy na iCloude. Odstráňte ich tu a tieto kópie sa vymažú."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uporabljajo se le fotografije, ki jih izbereš. Majhne kopije ostanejo v tem iPhonu, zunaj varnostne kopije iCloud. Odstrani jih tukaj, da izbrišeš te kopije."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara dina valda bilder används. Små kopior stannar på den här iPhonen, utanför iCloud-säkerhetskopian. Ta bort dem här för att radera kopiorna."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் தேர்ந்தெடுத்த புகைப்படங்கள் மட்டுமே பயன்படுத்தப்படும். சிறிய நகல்கள் இந்த iPhone-இல், iCloud காப்புப்பிரதிக்கு வெளியே இருக்கும். இந்த நகல்களை நீக்க இங்கிருந்து அகற்றுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఎంచుకున్న ఫోటోలు మాత్రమే వాడబడతాయి. చిన్న కాపీలు ఈ iPhoneలో, iCloud బ్యాకప్ బయట ఉంటాయి. ఈ కాపీలను తొలగించడానికి వాటిని ఇక్కడి నుండి తీసివేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้เฉพาะรูปที่คุณเลือก สำเนาขนาดเล็กอยู่บน iPhone เครื่องนี้ นอกข้อมูลสำรอง iCloud นำออกที่นี่เพื่อลบสำเนาเหล่านี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca seçtiğin fotoğraflar kullanılır. Küçük kopyalar bu iPhone'da kalır, iCloud yedeğine eklenmez. Kopyaları silmek için buradan kaldır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовуються лише вибрані фото. Невеликі копії залишаються на цьому iPhone без резервної копії iCloud. Видали їх тут, щоб стерти копії."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف آپ کی منتخب تصاویر استعمال ہوتی ہیں۔ چھوٹی کاپیاں اسی iPhone پر، iCloud بیک اپ سے باہر رہتی ہیں۔ ان کاپیوں کو حذف کرنے کے لیے انہیں یہاں سے ہٹائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ dùng ảnh bạn đã chọn. Bản sao nhỏ ở lại trên iPhone này, ngoài bản sao lưu iCloud. Xóa chúng ở đây để xóa các bản sao này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅使用你选择的照片。小尺寸副本保留在此iPhone上，不纳入iCloud备份。在此移除即可删除副本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只會使用你選擇的照片。小型副本會留在這部 iPhone 上，不包含在 iCloud 備份中。在這裡移除即可刪除這些副本。"
          }
        }
      }
    },
