    "edit_err_declined": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم التغيير – لم يحصل iOS على الإذن. الأصل بلا تغيير."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke ændret – iOS fik ikke tilladelse. Originalen er uændret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht geändert – iOS hat keine Erlaubnis erhalten. Das Original ist unverändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not changed – iOS didn’t get permission. The original is unchanged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin cambios: iOS no recibió permiso. El original no ha cambiado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’a changé – iOS n’a pas reçu l’autorisation. L’original est inchangé."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak diubah – iOS tidak mendapat izin. Aslinya tidak berubah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna modifica: iOS non ha ricevuto il permesso. L’originale è invariato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更されていません。iOSで許可されませんでした。オリジナルはそのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경되지 않음 – iOS에서 허용되지 않았습니다. 원본은 그대로입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke endret – iOS fikk ikke tillatelse. Originalen er uendret."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet gewijzigd – iOS kreeg geen toestemming. Het origineel is ongewijzigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez zmian – iOS nie otrzymał zgody. Oryginał pozostał bez zmian."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não alterado – o iOS não recebeu permissão. O original não foi alterado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem alterações – o iOS não recebeu autorização. O original não foi alterado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nemodificat – iOS nu a primit permisiunea. Originalul a rămas neschimbat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без изменений – iOS не получил разрешение. Оригинал не изменён."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inte ändrat – iOS fick inte behörighet. Originalet är oförändrat."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ได้เปลี่ยน – iOS ไม่ได้รับอนุญาต ต้นฉบับไม่เปลี่ยนแปลง"
