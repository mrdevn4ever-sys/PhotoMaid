    "vault2_backup_explanation": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تشمل الوسائط والملاحظات والملفات والمجلدات وسلة الخزنة. استخدم كلمة مرور قوية ومنفصلة. لا يمكن الاستعادة بدونها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মিডিয়া, নোট, ফাইল, ফোল্ডার ও ভল্টের ট্র্যাশ অন্তর্ভুক্ত। একটি শক্তিশালী, আলাদা ব্যাকআপ পাসওয়ার্ড ব্যবহার করুন। এটি ছাড়া ব্যাকআপ পুনরুদ্ধার করা যায় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclou contingut multimèdia, notes, fitxers, carpetes i la paperera de la caixa forta. Fes servir una contrasenya de còpia forta i diferent. Sense ella, la còpia no es pot restaurar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsahuje média, poznámky, soubory, složky a koš trezoru. Použijte silné, samostatné heslo zálohy. Bez něj zálohu nelze obnovit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indeholder medier, noter, filer, mapper og boksens papirkurv. Brug en stærk, separat adgangskode til sikkerhedskopien. Uden den kan sikkerhedskopien ikke gendannes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichert Medien, Notizen, Dateien, Ordner und den Tresor-Papierkorb. Verwende ein starkes, eigenes Backup-Passwort. Ohne dieses Passwort ist das Backup nicht wiederherstellbar."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Περιλαμβάνει πολυμέσα, σημειώσεις, αρχεία, φακέλους και τον κάδο του θησαυροφυλακίου. Χρησιμοποίησε ισχυρό, ξεχωριστό κωδικό αντιγράφου. Χωρίς αυτόν το αντίγραφο δεν επαναφέρεται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Includes media, notes, files, folders and vault trash. Use a strong, separate backup password. Without it, the backup cannot be restored."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluye medios, notas, archivos, carpetas y papelera. Usa una contraseña segura y distinta. Sin ella no se puede restaurar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sisältää mediat, muistiinpanot, tiedostot, kansiot ja holvin roskakorin. Käytä vahvaa, erillistä varmuuskopion salasanaa. Ilman sitä varmuuskopiota ei voi palauttaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclut médias, notes, fichiers, dossiers et corbeille du coffre. Utilisez un mot de passe fort et distinct. Sans lui, la sauvegarde est irrécupérable."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તેમાં મીડિયા, નોંધો, ફાઇલો, ફોલ્ડર અને વૉલ્ટ ટ્રેશ સામેલ છે. મજબૂત, અલગ બૅકઅપ પાસવર્ડ વાપરો. તેના વિના બૅકઅપ પુનઃસ્થાપિત થઈ શકતો નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כולל מדיה, הערות, קבצים, תיקיות ואת הפח של הכספת. כדאי להשתמש בסיסמת גיבוי חזקה ונפרדת. בלעדיה אי אפשר לשחזר את הגיבוי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसमें मीडिया, नोट, फ़ाइलें, फ़ोल्डर और तिजोरी का ट्रैश शामिल है। मज़बूत, अलग बैकअप पासवर्ड इस्तेमाल करें। इसके बिना बैकअप रीस्टोर नहीं हो सकता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uključuje medije, bilješke, datoteke, mape i smeće trezora. Koristi snažnu, zasebnu lozinku za sigurnosnu kopiju. Bez nje se sigurnosna kopija ne može vratiti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tartalmazza a médiát, jegyzeteket, fájlokat, mappákat és a széf kukáját. Használj erős, külön biztonsági mentési jelszót. Nélküle a mentés nem állítható vissza."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mencakup media, catatan, file, folder, dan sampah brankas. Pakai kata sandi cadangan yang kuat dan terpisah. Tanpa itu, cadangan tidak dapat dipulihkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Include media, note, file, cartelle e cestino. Usa una password forte e separata. Senza di essa il backup non è ripristinabile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メディア、メモ、ファイル、フォルダ、保管庫のゴミ箱を含みます。専用の強力なパスワードを使ってください。忘れると復元できません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮಾಧ್ಯಮ, ಟಿಪ್ಪಣಿಗಳು, ಫೈಲ್‌ಗಳು, ಫೋಲ್ಡರ್‌ಗಳು ಮತ್ತು ವಾಲ್ಟ್ ಕಸದ ಬುಟ್ಟಿ ಸೇರಿವೆ. ಬಲವಾದ, ಪ್ರತ್ಯೇಕ ಬ್ಯಾಕಪ್ ಪಾಸ್‌ವರ್ಡ್ ಬಳಸಿ. ಅದಿಲ್ಲದೆ ಬ್ಯಾಕಪ್ ಮರುಸ್ಥಾಪಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미디어, 메모, 파일, 폴더, 휴지통이 포함됩니다. 강력한 별도 비밀번호를 사용하세요. 비밀번호 없이는 복원할 수 없습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മീഡിയ, കുറിപ്പുകൾ, ഫയലുകൾ, ഫോൾഡറുകൾ, വോൾട്ട് ട്രാഷ് എന്നിവ ഉൾപ്പെടുന്നു. ശക്തമായ, പ്രത്യേക ബാക്കപ്പ് പാസ്‌വേഡ് ഉപയോഗിക്കുക. അതില്ലാതെ ബാക്കപ്പ് പുനഃസ്ഥാപിക്കാനാകില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "यात मीडिया, नोंदी, फाइल्स, फोल्डर आणि व्हॉल्ट ट्रॅश समाविष्ट आहे. मजबूत, वेगळा बॅकअप पासवर्ड वापरा. त्याशिवाय बॅकअप पुनर्संचयित करता येत नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Termasuk media, nota, fail, folder dan sampah peti besi. Gunakan kata laluan sandaran yang kuat dan berasingan. Tanpanya, sandaran tidak dapat dipulihkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Inneholder medier, notater, filer, mapper og safens papirkurv. Bruk et sterkt, separat passord for sikkerhetskopien. Uten det kan sikkerhetskopien ikke gjenopprettes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevat media, notities, bestanden, mappen en kluisprullenmand. Gebruik een sterk, apart wachtwoord. Zonder dat wachtwoord is herstellen onmogelijk."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ମିଡିଆ, ନୋଟ୍, ଫାଇଲ୍, ଫୋଲ୍ଡର ଓ ଭଲ୍ଟ ଟ୍ରାସ ଅନ୍ତର୍ଭୁକ୍ତ। ଏକ ଦୃଢ଼, ଅଲଗା ବ୍ୟାକଅପ୍ ପାସୱାର୍ଡ ବ୍ୟବହାର କରନ୍ତୁ। ଏହା ବିନା ବ୍ୟାକଅପ୍ ପୁନରୁଦ୍ଧାର ହୋଇପାରିବ ନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮੀਡੀਆ, ਨੋਟ, ਫ਼ਾਈਲਾਂ, ਫ਼ੋਲਡਰ ਅਤੇ ਵੌਲਟ ਦੀ ਰੱਦੀ ਸ਼ਾਮਲ ਹੈ। ਮਜ਼ਬੂਤ, ਵੱਖਰਾ ਬੈਕਅੱਪ ਪਾਸਵਰਡ ਵਰਤੋ। ਇਸ ਤੋਂ ਬਿਨਾਂ ਬੈਕਅੱਪ ਬਹਾਲ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obejmuje multimedia, notatki, pliki, foldery i kosz sejfu. Użyj silnego, osobnego hasła. Bez niego nie można przywrócić kopii."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclui mídias, notas, arquivos, pastas e a lixeira do cofre. Use uma senha de backup forte e separada. Sem ela, o backup não pode ser restaurado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclui multimédia, notas, ficheiros, pastas e lixo do cofre. Usa uma palavra-passe forte e própria. Sem ela, não é possível restaurar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Include media, notițe, fișiere, dosare și coșul seifului. Folosește o parolă puternică, separată. Fără ea, copia nu poate fi restaurată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включает медиа, заметки, файлы, папки и корзину сейфа. Используйте надёжный отдельный пароль. Без него копию нельзя восстановить."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsahuje médiá, poznámky, súbory, priečinky a kôš trezoru. Použite silné, samostatné heslo zálohy. Bez neho zálohu nemožno obnoviť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vključuje medije, zapiske, datoteke, mape in koš sefa. Uporabi močno, ločeno geslo za varnostno kopijo. Brez njega varnostne kopije ni mogoče obnoviti."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Innehåller medier, anteckningar, filer, mappar och valvets papperskorg. Använd ett starkt, separat lösenord för säkerhetskopian. Utan det kan säkerhetskopian inte återställas."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மீடியா, குறிப்புகள், கோப்புகள், கோப்புறைகள், லாக்கர் குப்பை அடங்கும். வலுவான, தனியான காப்புப்பிரதிக் கடவுச்சொல்லைப் பயன்படுத்துங்கள். அது இல்லாமல் காப்புப்பிரதியை மீட்டமைக்க முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీడియా, నోట్‌లు, ఫైళ్లు, ఫోల్డర్‌లు, వాల్ట్ ట్రాష్ చేరి ఉంటాయి. బలమైన, ప్రత్యేక బ్యాకప్ పాస్‌వర్డ్ వాడండి. అది లేకుండా బ్యాకప్‌ను పునరుద్ధరించలేము."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รวมสื่อ โน้ต ไฟล์ โฟลเดอร์ และถังขยะตู้เซฟ ใช้รหัสผ่านสำรองที่แข็งแรงและแยกต่างหาก หากไม่มีรหัสนี้จะกู้คืนข้อมูลสำรองไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Medya, notlar, dosyalar, klasörler ve kasa çöp kutusunu içerir. Güçlü ve ayrı bir parola kullan. Parola olmadan yedek geri yüklenemez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Містить медіа, нотатки, файли, папки й кошик сховища. Використовуйте надійний окремий пароль. Без нього копію неможливо відновити."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس میں میڈیا، نوٹس، فائلیں، فولڈرز اور والٹ کی ردی شامل ہے۔ مضبوط، الگ بیک اپ پاس ورڈ استعمال کریں۔ اس کے بغیر بیک اپ بحال نہیں ہو سکتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bao gồm phương tiện, ghi chú, tệp, thư mục và thùng rác két sắt. Hãy dùng mật khẩu sao lưu mạnh và riêng. Không có nó, bản sao lưu không thể khôi phục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包含媒体、笔记、文件、文件夹和保险库废纸篓。请使用独立的强密码。没有此密码便无法恢复备份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "包含媒體、備忘錄、檔案、檔案夾和保險箱垃圾桶。請使用強度高且獨立的備份密碼。沒有它就無法還原備份。"
          }
        }
      }
    },
    "vault2_backup_failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تُستعد النسخة: كلمة مرور خاطئة أو ملف تالف أو جلسة مقفلة أو مساحة غير كافية. المحتوى الحالي لم يتغير."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ব্যাকআপ পুনরুদ্ধার হয়নি। পাসওয়ার্ড ভুল, ফাইল নষ্ট, সেশন লক বা স্টোরেজ অপর্যাপ্ত হতে পারে। বিদ্যমান বিষয়বস্তু অপরিবর্তিত।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s’ha restaurat la còpia. Pot ser que la contrasenya sigui incorrecta, el fitxer estigui malmès, la sessió estigui bloquejada o no hi hagi prou espai. El contingut existent no canvia."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Záloha nebyla obnovena. Heslo může být chybné, soubor poškozený, relace zamčená nebo nedostatek úložiště. Stávající obsah zůstává beze změny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikkerhedskopien blev ikke gendannet. Adgangskoden kan være forkert, filen beskadiget, sessionen låst eller lageret utilstrækkeligt. Eksisterende indhold er uændret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup nicht wiederhergestellt. Passwort falsch, Datei beschädigt, Sitzung gesperrt oder Speicherplatz unzureichend. Vorhandene Inhalte bleiben unverändert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το αντίγραφο δεν επαναφέρθηκε. Ο κωδικός ίσως είναι λάθος, το αρχείο κατεστραμμένο, η συνεδρία κλειδωμένη ή ο χώρος ανεπαρκής. Το υπάρχον περιεχόμενο δεν άλλαξε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup not restored. The password may be wrong, the file damaged, the session locked or storage insufficient. Existing content is unchanged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se restauró: contraseña incorrecta, archivo dañado, sesión bloqueada o poco espacio. El contenido existente no cambia."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Varmuuskopiota ei palautettu. Salasana voi olla väärä, tiedosto vahingoittunut, istunto lukittu tai tallennustila riittämätön. Nykyinen sisältö on ennallaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauvegarde non restaurée : mot de passe incorrect, fichier endommagé, session verrouillée ou espace insuffisant. Le contenu existant reste inchangé."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બૅકઅપ પુનઃસ્થાપિત થયો નથી. પાસવર્ડ ખોટો, ફાઇલ ખરાબ, સત્ર લૉક કે સ્ટોરેજ અપૂરતું હોઈ શકે. હાલની સામગ્રી બદલાઈ નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגיבוי לא שוחזר. ייתכן שהסיסמה שגויה, הקובץ פגום, הסשן נעול או שאין מספיק אחסון. התוכן הקיים לא השתנה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बैकअप रीस्टोर नहीं हुआ। पासवर्ड गलत, फ़ाइल खराब, सत्र लॉक या स्टोरेज कम हो सकता है। मौजूदा सामग्री नहीं बदली।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigurnosna kopija nije vraćena. Lozinka je možda pogrešna, datoteka oštećena, sesija zaključana ili nema dovoljno pohrane. Postojeći sadržaj je nepromijenjen."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A mentés nem lett visszaállítva. Lehet, hogy hibás a jelszó, sérült a fájl, zárolt a munkamenet, vagy nincs elég tárhely. A meglévő tartalom változatlan."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cadangan tidak dipulihkan. Kata sandi mungkin salah, file rusak, sesi terkunci, atau penyimpanan tidak cukup. Konten yang ada tidak berubah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup non ripristinato: password errata, file danneggiato, sessione bloccata o spazio insufficiente. I contenuti esistenti restano invariati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復元できませんでした。パスワード、ファイル破損、ロック、空き容量を確認してください。既存の内容は変更されていません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಬ್ಯಾಕಪ್ ಮರುಸ್ಥಾಪನೆಯಾಗಿಲ್ಲ. ಪಾಸ್‌ವರ್ಡ್ ತಪ್ಪಾಗಿರಬಹುದು, ಫೈಲ್ ಹಾಳಾಗಿರಬಹುದು, ಸೆಷನ್ ಲಾಕ್ ಆಗಿರಬಹುದು ಅಥವಾ ಸಂಗ್ರಹಣೆ ಸಾಕಾಗದಿರಬಹುದು. ಅಸ್ತಿತ್ವದಲ್ಲಿರುವ ವಿಷಯ ಬದಲಾಗಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복원하지 못했습니다. 잘못된 비밀번호, 파일 손상, 세션 잠금 또는 공간 부족일 수 있습니다. 기존 내용은 변경되지 않았습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ബാക്കപ്പ് പുനഃസ്ഥാപിച്ചില്ല. പാസ്‌വേഡ് തെറ്റായിരിക്കാം, ഫയൽ കേടായിരിക്കാം, സെഷൻ ലോക്കായിരിക്കാം അല്ലെങ്കിൽ സ്റ്റോറേജ് അപര്യാപ്തമായിരിക്കാം. നിലവിലുള്ള ഉള്ളടക്കത്തിന് മാറ്റമില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "बॅकअप पुनर्संचयित झाला नाही. पासवर्ड चुकीचा, फाइल खराब, सत्र लॉक किंवा स्टोरेज अपुरे असू शकते. सध्याचा मजकूर बदललेला नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sandaran tidak dipulihkan. Kata laluan mungkin salah, fail rosak, sesi dikunci atau storan tidak mencukupi. Kandungan sedia ada tidak berubah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikkerhetskopien ble ikke gjenopprettet. Passordet kan være feil, filen skadet, økten låst eller lagringen utilstrekkelig. Eksisterende innhold er uendret."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet hersteld: onjuist wachtwoord, beschadigd bestand, vergrendelde sessie of onvoldoende ruimte. Bestaande inhoud blijft ongewijzigd."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ବ୍ୟାକଅପ୍ ପୁନରୁଦ୍ଧାର ହେଲା ନାହିଁ। ପାସୱାର୍ଡ ଭୁଲ, ଫାଇଲ୍ ଖରାପ, ସେସନ୍ ଲକ୍ କିମ୍ବା ଷ୍ଟୋରେଜ୍ ଅପର୍ଯ୍ୟାପ୍ତ ହୋଇପାରେ। ବିଦ୍ୟମାନ ବିଷୟବସ୍ତୁ ଅପରିବର୍ତ୍ତିତ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਬੈਕਅੱਪ ਬਹਾਲ ਨਹੀਂ ਹੋਇਆ। ਹੋ ਸਕਦਾ ਹੈ ਪਾਸਵਰਡ ਗ਼ਲਤ ਹੋਵੇ, ਫ਼ਾਈਲ ਖ਼ਰਾਬ ਹੋਵੇ, ਸੈਸ਼ਨ ਲੌਕ ਹੋਵੇ ਜਾਂ ਸਟੋਰੇਜ ਨਾਕਾਫ਼ੀ ਹੋਵੇ। ਮੌਜੂਦਾ ਸਮੱਗਰੀ ਬਿਨਾਂ ਬਦਲੇ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie przywrócono: błędne hasło, uszkodzony plik, zablokowana sesja lub brak miejsca. Istniejąca zawartość pozostaje bez zmian."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup não restaurado. A senha pode estar errada, o arquivo danificado, a sessão bloqueada ou o armazenamento insuficiente. O conteúdo existente não foi alterado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi restaurado: palavra-passe errada, ficheiro danificado, sessão bloqueada ou espaço insuficiente. O conteúdo existente não muda."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia nu a fost restaurată: parolă greșită, fișier deteriorat, sesiune blocată sau spațiu insuficient. Conținutul existent rămâne neschimbat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копия не восстановлена: неверный пароль, повреждённый файл, блокировка или нехватка места. Существующие данные не изменены."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Záloha nebola obnovená. Heslo môže byť nesprávne, súbor poškodený, relácia zamknutá alebo nedostatok úložiska. Existujúci obsah zostáva bez zmeny."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Varnostna kopija ni bila obnovljena. Geslo je morda napačno, datoteka poškodovana, seja zaklenjena ali ni dovolj prostora. Obstoječa vsebina je nespremenjena."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Säkerhetskopian återställdes inte. Lösenordet kan vara fel, filen skadad, sessionen låst eller lagringen otillräcklig. Befintligt innehåll är oförändrat."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "காப்புப்பிரதி மீட்டமைக்கப்படவில்லை. கடவுச்சொல் தவறாக இருக்கலாம், கோப்பு சேதமடைந்திருக்கலாம், அமர்வு பூட்டப்பட்டிருக்கலாம் அல்லது சேமிப்பகம் போதாமல் இருக்கலாம். ஏற்கனவே உள்ள உள்ளடக்கம் மாறவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "బ్యాకప్ పునరుద్ధరించబడలేదు. పాస్‌వర్డ్ తప్పు కావచ్చు, ఫైల్ పాడై ఉండవచ్చు, సెషన్ లాక్ అయి ఉండవచ్చు లేదా స్టోరేజ్ సరిపోకపోవచ్చు. ఇప్పటికే ఉన్న కంటెంట్ మారలేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ได้กู้คืนข้อมูลสำรอง รหัสผ่านอาจผิด ไฟล์เสียหาย เซสชันถูกล็อก หรือพื้นที่ไม่พอ เนื้อหาที่มีอยู่ไม่เปลี่ยนแปลง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yedek yüklenemedi: yanlış parola, bozuk dosya, kilitli oturum veya yetersiz alan. Mevcut içerik değişmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Копію не відновлено: неправильний пароль, пошкоджений файл, блокування або брак місця. Наявні дані не змінено."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بیک اپ بحال نہیں ہوا۔ پاس ورڈ غلط، فائل خراب، سیشن لاک یا اسٹوریج کم ہو سکتا ہے۔ موجودہ مواد تبدیل نہیں ہوا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa khôi phục bản sao lưu. Có thể mật khẩu sai, tệp bị hỏng, phiên bị khóa hoặc không đủ dung lượng. Nội dung hiện có không thay đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未恢复备份。可能是密码错误、文件损坏、会话锁定或空间不足。现有内容保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "備份未還原。可能是密碼錯誤、檔案損壞、工作階段已鎖定或儲存空間不足。現有內容保持不變。"
          }
        }
      }
    },
