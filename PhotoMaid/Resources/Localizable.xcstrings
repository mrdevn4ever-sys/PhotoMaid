    "movie_format_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شكل الفيديو النهائي. 9:16 يملأ شاشة الهاتف عموديًا، و16:9 يناسب التلفاز والكمبيوتر. «مثل المقطع الأول» يستخدم شكل مقطعك الأول."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তৈরি ভিডিওর আকৃতি। 9:16 সোজা করে ধরা ফোনের স্ক্রিন পূরণ করে, 16:9 টিভি ও কম্পিউটারের জন্য উপযুক্ত। “প্রথম ক্লিপের মতো” আপনার প্রথম ক্লিপের আকৃতি নেয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Forma del vídeo acabat. El 9:16 omple la pantalla d’un telèfon en vertical, el 16:9 va bé per a televisors i ordinadors. «Com el primer clip» fa servir la forma del primer clip."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvar hotového videa. 9:16 vyplní displej telefonu drženého na výšku, 16:9 se hodí pro televize a počítače. „Jako první klip“ použije tvar vašeho prvního klipu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den færdige videos form. 9:16 fylder en lodret telefonskærm, 16:9 passer til tv og computere. “Som første klip” bruger formen fra dit første klip."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seitenverhältnis des fertigen Videos. 9:16 füllt den Handybildschirm hochkant, 16:9 passt zu Fernseher und Computer. „Wie erster Clip“ übernimmt die Form deines ersten Clips."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το σχήμα του τελικού βίντεο. Το 9:16 γεμίζει την οθόνη ενός κατακόρυφου τηλεφώνου, το 16:9 ταιριάζει σε τηλεοράσεις και υπολογιστές. Το «Όπως το πρώτο κλιπ» χρησιμοποιεί το σχήμα του πρώτου κλιπ σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shape of the finished video. 9:16 fills a phone screen held upright, 16:9 suits TVs and computers. “Like first clip” uses the shape of your first clip."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Forma del vídeo final. 9:16 llena la pantalla del móvil en vertical; 16:9 va bien en televisores y ordenadores. «Como el primer clip» usa la forma de tu primer clip."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valmiin videon muoto. 9:16 täyttää pystyssä pidetyn puhelimen näytön, 16:9 sopii televisioihin ja tietokoneisiin. ”Kuten ensimmäinen leike” käyttää ensimmäisen leikkeesi muotoa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Format de la vidéo finale. 9:16 remplit l’écran d’un téléphone tenu verticalement, 16:9 convient aux téléviseurs et ordinateurs. « Comme le 1er clip » reprend le format de votre premier clip."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તૈયાર વીડિયોનો આકાર. 9:16 ઊભા પકડેલા ફોનની સ્ક્રીન ભરે છે, 16:9 ટીવી અને કમ્પ્યુટર માટે યોગ્ય છે. “પહેલી ક્લિપ જેવું” તમારી પહેલી ક્લિપનો આકાર વાપરે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "צורת הסרטון הסופי. 9:16 ממלא מסך של טלפון מוחזק לאורך, 16:9 מתאים לטלוויזיות ולמחשבים. „כמו הקליפ הראשון” משתמש בצורת הקליפ הראשון שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तैयार वीडियो का आकार। 9:16 सीधे पकड़े फ़ोन की स्क्रीन भरता है, 16:9 टीवी और कंप्यूटर के लिए ठीक है। “पहली क्लिप जैसा” आपकी पहली क्लिप का आकार लेता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oblik gotovog videozapisa. 9:16 ispunjava uspravno držan zaslon telefona, 16:9 odgovara televizorima i računalima. „Kao prvi isječak” koristi oblik tvog prvog isječka."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kész videó alakja. A 9:16 kitölti az állva tartott telefon képernyőjét, a 16:9 tévékhez és számítógépekhez illik. A „Mint az első klip” az első klip alakját használja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bentuk video jadi. 9:16 memenuhi layar ponsel tegak, 16:9 cocok untuk TV dan komputer. “Seperti klip pertama” memakai bentuk klip pertamamu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Forma del video finale. 9:16 riempie lo schermo del telefono in verticale, 16:9 è adatto a TV e computer. «Come la prima clip» usa la forma della tua prima clip."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完成した動画の縦横比です。9:16は縦向きのスマートフォン画面いっぱい、16:9はテレビやパソコン向けです。「最初のクリップと同じ」は最初のクリップの形を使います。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಿದ್ಧ ವೀಡಿಯೊದ ಆಕಾರ. 9:16 ನೇರವಾಗಿ ಹಿಡಿದ ಫೋನ್ ಪರದೆ ತುಂಬಿಸುತ್ತದೆ, 16:9 ಟಿವಿ ಮತ್ತು ಕಂಪ್ಯೂಟರ್‌ಗಳಿಗೆ ಸೂಕ್ತ. “ಮೊದಲ ಕ್ಲಿಪ್‌ನಂತೆ” ನಿಮ್ಮ ಮೊದಲ ಕ್ಲಿಪ್‌ನ ಆಕಾರ ಬಳಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완성된 동영상의 비율이에요. 9:16은 세로로 든 휴대폰 화면을 채우고, 16:9는 TV와 컴퓨터에 맞아요. ‘첫 클립과 같게’는 첫 클립의 비율을 사용해요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പൂർത്തിയായ വീഡിയോയുടെ ആകൃതി. 9:16 നേരെ പിടിച്ച ഫോൺ സ്ക്രീൻ നിറയ്ക്കുന്നു, 16:9 ടിവികൾക്കും കമ്പ്യൂട്ടറുകൾക്കും അനുയോജ്യം. “ആദ്യ ക്ലിപ്പ് പോലെ” നിങ്ങളുടെ ആദ്യ ക്ലിപ്പിന്റെ ആകൃതി ഉപയോഗിക്കുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तयार व्हिडिओचा आकार. 9:16 उभ्या धरलेल्या फोनची स्क्रीन भरतो, 16:9 टीव्ही आणि संगणकासाठी योग्य. “पहिल्या क्लिपसारखे” तुमच्या पहिल्या क्लिपचा आकार वापरते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bentuk video siap. 9:16 mengisi skrin telefon yang dipegang tegak, 16:9 sesuai untuk TV dan komputer. “Seperti klip pertama” menggunakan bentuk klip pertama anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Formen på den ferdige videoen. 9:16 fyller en stående telefonskjerm, 16:9 passer til TV og datamaskiner. «Som første klipp» bruker formen på det første klippet ditt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorm van de uiteindelijke video. 9:16 vult een rechtop gehouden telefoonscherm, 16:9 past bij tv’s en computers. ‘Zoals eerste clip’ neemt de vorm van je eerste clip over."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପ୍ରସ୍ତୁତ ଭିଡିଓର ଆକୃତି। 9:16 ଠିଆ କରି ଧରାଯାଇଥିବା ଫୋନ୍ ସ୍କ୍ରିନ୍ ପୂର୍ଣ୍ଣ କରେ, 16:9 ଟିଭି ଓ କମ୍ପ୍ୟୁଟର ପାଇଁ ଉପଯୁକ୍ତ। “ପ୍ରଥମ କ୍ଲିପ୍ ଭଳି” ଆପଣଙ୍କ ପ୍ରଥମ କ୍ଲିପ୍‌ର ଆକୃତି ବ୍ୟବହାର କରେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤਿਆਰ ਵੀਡੀਓ ਦਾ ਆਕਾਰ। 9:16 ਸਿੱਧੇ ਫੜੇ ਫ਼ੋਨ ਦੀ ਸਕ੍ਰੀਨ ਭਰਦਾ ਹੈ, 16:9 ਟੀਵੀ ਅਤੇ ਕੰਪਿਊਟਰਾਂ ਲਈ ਢੁਕਵਾਂ ਹੈ। “ਪਹਿਲੀ ਕਲਿੱਪ ਵਾਂਗ” ਤੁਹਾਡੀ ਪਹਿਲੀ ਕਲਿੱਪ ਦਾ ਆਕਾਰ ਵਰਤਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kształt gotowego filmu. 9:16 wypełnia ekran telefonu trzymanego pionowo, 16:9 pasuje do telewizorów i komputerów. „Jak pierwszy klip” przejmuje kształt pierwszego klipu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Formato do vídeo final. 9:16 preenche a tela de um celular na vertical, 16:9 combina com TVs e computadores. “Como o primeiro clipe” usa o formato do seu primeiro clipe."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Forma do vídeo final. 9:16 preenche o ecrã do telemóvel na vertical, 16:9 é adequado a televisores e computadores. «Como o primeiro clipe» usa a forma do seu primeiro clipe."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Forma videoclipului final. 9:16 umple ecranul telefonului ținut vertical, 16:9 se potrivește la televizoare și computere. „Ca primul clip” folosește forma primului tău clip."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Форма готового видео. 9:16 заполняет экран телефона в вертикальном положении, 16:9 подходит для телевизоров и компьютеров. «Как первый клип» берёт форму вашего первого клипа."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvar hotového videa. 9:16 vyplní displej telefónu drženého na výšku, 16:9 sa hodí pre televízory a počítače. „Ako prvý klip“ použije tvar vášho prvého klipu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oblika končnega videa. 9:16 zapolni zaslon pokončno držanega telefona, 16:9 je primeren za televizorje in računalnike. »Kot prvi posnetek« uporabi obliko tvojega prvega posnetka."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den färdiga videons form. 9:16 fyller en upprättstående telefonskärm, 16:9 passar tv och datorer. ”Som första klippet” använder formen på ditt första klipp."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முடிந்த வீடியோவின் வடிவம். 9:16 நேராகப் பிடித்த ஃபோன் திரையை நிரப்பும், 16:9 டிவி, கணினிகளுக்கு ஏற்றது. “முதல் கிளிப் போல” உங்கள் முதல் கிளிப்பின் வடிவத்தைப் பயன்படுத்தும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పూర్తయిన వీడియో ఆకారం. 9:16 నిలువుగా పట్టుకున్న ఫోన్ స్క్రీన్‌ను నింపుతుంది, 16:9 టీవీలు, కంప్యూటర్‌లకు సరిపోతుంది. “మొదటి క్లిప్ లాగా” మీ మొదటి క్లిప్ ఆకారాన్ని వాడుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปทรงของวิดีโอที่เสร็จแล้ว 9:16 เต็มหน้าจอโทรศัพท์แนวตั้ง 16:9 เหมาะกับทีวีและคอมพิวเตอร์ “เหมือนคลิปแรก” ใช้รูปทรงของคลิปแรก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitmiş videonun şekli. 9:16 dik tutulan telefon ekranını doldurur, 16:9 televizyon ve bilgisayarlara uyar. “İlk klip gibi” ilk klibinin şeklini kullanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Форма готового відео. 9:16 заповнює екран телефона у вертикальному положенні, 16:9 підходить для телевізорів і комп’ютерів. «Як перший кліп» бере форму вашого першого кліпу."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تیار ویڈیو کی شکل۔ 9:16 سیدھے پکڑے فون کی اسکرین بھرتا ہے، 16:9 ٹی وی اور کمپیوٹر کے لیے موزوں ہے۔ ”پہلے کلپ جیسا“ آپ کے پہلے کلپ کی شکل لیتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hình dạng của video hoàn chỉnh. 9:16 lấp đầy màn hình điện thoại cầm dọc, 16:9 hợp với TV và máy tính. “Như đoạn đầu tiên” dùng hình dạng của đoạn đầu tiên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "成品视频的比例。9:16 可填满竖握的手机屏幕，16:9 适合电视和电脑。“同第一个片段”使用第一个片段的比例。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "完成影片的形狀。9:16 可填滿直拿的手機螢幕，16:9 適合電視和電腦。「與第一個片段相同」會使用第一個片段的形狀。"
          }
        }
      }
    },
