            "value": "Пока больше нет видео для просмотра."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Momentálne už nie sú žiadne videá na prezretie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trenutno ni več videoposnetkov za pregled."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det finns inga fler videor att gå igenom just nu."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இப்போது பார்வையிட மேலும் வீடியோக்கள் இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రస్తుతం సమీక్షించడానికి ఇంకా వీడియోలు లేవు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนนี้ไม่มีวิดีโอให้ตรวจดูอีกแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu anda incelenecek başka video yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Наразі більше немає відео для перегляду."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ابھی جائزے کے لیے مزید ویڈیوز نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện không còn video nào để xem lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时没有其他需要查看的视频。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前沒有更多影片需要整理。"
          }
        }
      }
    },
    "feed_icloud_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوجد على هذا الـ iPhone معاينة صغيرة فقط. نزّل الأصل لعرضه كاملًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই iPhone-এ শুধু একটি ছোট প্রিভিউ রাখা আছে। পুরোটা দেখতে মূলটি ডাউনলোড করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "En aquest iPhone només hi ha una previsualització petita. Baixa l’original per veure’l sencer."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V tomto iPhonu je uložen jen malý náhled. Stáhněte originál, abyste ho viděli celý."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun et lille eksempel er gemt på denne iPhone. Hent originalen for at se den helt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem iPhone ist nur eine kleine Vorschau gespeichert. Lade das Original, um es groß anzusehen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σε αυτό το iPhone υπάρχει μόνο μια μικρή προεπισκόπηση. Κάνε λήψη του πρωτοτύπου για να το δεις ολόκληρο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only a small preview is stored on this iPhone. Download the original to see it in full."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En este iPhone solo hay una vista previa pequeña. Descarga el original para verlo completo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tähän iPhoneen on tallennettu vain pieni esikatselu. Lataa alkuperäinen nähdäksesi sen kokonaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul un petit aperçu est stocké sur cet iPhone. Téléchargez l’original pour le voir en grand."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ iPhone પર ફક્ત નાનો પ્રીવ્યૂ છે. આખું જોવા મૂળ ડાઉનલોડ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ב-iPhone הזה שמורה רק תצוגה מקדימה קטנה. אפשר להוריד את המקור כדי לראות אותו במלואו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस iPhone पर सिर्फ़ छोटा प्रीव्यू है। पूरा देखने के लिए मूल डाउनलोड करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Na ovom je iPhoneu spremljen samo mali pregled. Preuzmi original da ga vidiš u cijelosti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezen az iPhone-on csak egy kis előnézet van. Töltsd le az eredetit a teljes megtekintéshez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya pratinjau kecil yang tersimpan di iPhone ini. Unduh aslinya untuk melihatnya utuh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su questo iPhone c’è solo un’anteprima piccola. Scarica l’originale per vederlo per intero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPhoneには小さなプレビューしかありません。大きく見るにはオリジナルを読み込んでください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ iPhone ನಲ್ಲಿ ಸಣ್ಣ ಪೂರ್ವವೀಕ್ಷಣೆ ಮಾತ್ರ ಸಂಗ್ರಹವಾಗಿದೆ. ಸಂಪೂರ್ಣವಾಗಿ ನೋಡಲು ಮೂಲವನ್ನು ಡೌನ್‌ಲೋಡ್ ಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone에는 작은 미리보기만 있습니다. 크게 보려면 원본을 다운로드하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ iPhone-ൽ ഒരു ചെറിയ പ്രിവ്യൂ മാത്രമേ സംഭരിച്ചിട്ടുള്ളൂ. മുഴുവനായി കാണാൻ ഒറിജിനൽ ഡൗൺലോഡ് ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या iPhone वर फक्त छोटे पूर्वावलोकन आहे. पूर्ण पाहण्यासाठी मूळ डाउनलोड करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya pratonton kecil disimpan pada iPhone ini. Muat turun yang asal untuk melihatnya sepenuhnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare en liten forhåndsvisning er lagret på denne iPhonen. Last ned originalen for å se den i sin helhet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op deze iPhone staat alleen een kleine voorvertoning. Download het origineel om het groot te bekijken."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହି iPhoneରେ କେବଳ ଏକ ଛୋଟ ପ୍ରିଭ୍ୟୁ ଷ୍ଟୋର୍ ହୋଇଛି। ସମ୍ପୂର୍ଣ୍ଣ ଦେଖିବାକୁ ମୂଳ ଡାଉନଲୋଡ୍ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ iPhone ਉੱਤੇ ਸਿਰਫ਼ ਇੱਕ ਛੋਟੀ ਪੂਰਵ-ਝਲਕ ਸਟੋਰ ਹੈ। ਪੂਰਾ ਦੇਖਣ ਲਈ ਮੂਲ ਡਾਊਨਲੋਡ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na tym iPhonie jest tylko mały podgląd. Pobierz oryginał, aby zobaczyć go w całości."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só uma pequena prévia está guardada neste iPhone. Baixe o original para vê-lo completo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Neste iPhone existe apenas uma pré-visualização pequena. Descarregue o original para o ver por inteiro."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pe acest iPhone există doar o previzualizare mică. Descarcă originalul pentru a-l vedea mare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом iPhone хранится только маленькое превью. Загрузите оригинал, чтобы увидеть его полностью."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "V tomto iPhone je uložený len malý náhľad. Stiahnite originál, aby ste ho videli celý."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "V tem iPhonu je shranjen le majhen predogled. Prenesi izvirnik, da ga vidiš v celoti."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara en liten förhandsvisning finns på den här iPhonen. Hämta originalet för att se det helt."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த iPhone-இல் சிறிய முன்னோட்டம் மட்டுமே சேமிக்கப்பட்டுள்ளது. முழுமையாகப் பார்க்க அசலைப் பதிவிறக்குங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ iPhoneలో చిన్న ప్రివ్యూ మాత్రమే నిల్వ ఉంది. పూర్తిగా చూడడానికి ఒరిజినల్‌ను డౌన్‌లోడ్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีเพียงภาพตัวอย่างขนาดเล็กบน iPhone เครื่องนี้ ดาวน์โหลดต้นฉบับเพื่อดูแบบเต็ม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu iPhone’da yalnızca küçük bir önizleme var. Tam görmek için orijinali indir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На цьому iPhone є лише маленьке прев’ю. Завантажте оригінал, щоб переглянути повністю."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس iPhone پر صرف چھوٹا پیش منظر ہے۔ پورا دیکھنے کے لیے اصل ڈاؤن لوڈ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ có bản xem trước nhỏ được lưu trên iPhone này. Tải bản gốc để xem đầy đủ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 iPhone 上只存有小预览。下载原件即可查看大图。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這部 iPhone 上只存有小型預覽。下載原始檔即可完整查看。"
          }
        }
      }
    },
