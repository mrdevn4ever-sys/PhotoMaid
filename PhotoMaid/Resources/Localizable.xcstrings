    "offer_limit_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أزل حتى %1$lld يوميًا. شاهد إعلان فيديو لإزالة %2$lld إضافية اليوم."
          }
