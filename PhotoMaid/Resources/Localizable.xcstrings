    "vid_cut_hint_restore": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُزال المقاطع الحمراء فعلًا عند الحفظ (الطول الكلي %1$@). اضغط على مقطع أدناه لاستعادته."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লাল অংশগুলো সংরক্ষণের সময় সত্যিই সরানো হয় (মোট %1$@)। কোনো অংশ ফেরাতে নিচে তাতে ট্যাপ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les seccions vermelles s’eliminen de debò en desar (total %1$@). Toca una secció a sota per recuperar-la."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Červené úseky se při uložení opravdu odstraní (celkem %1$@). Klepnutím na úsek níže ho vrátíte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Røde afsnit fjernes rigtigt, når du gemmer (i alt %1$@). Tryk på et afsnit nedenfor for at hente det tilbage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rote Bereiche werden beim Speichern wirklich entfernt (Gesamtlänge %1$@). Tippe unten auf einen Bereich, um ihn zurückzuholen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα κόκκινα τμήματα αφαιρούνται πραγματικά κατά την αποθήκευση (συνολικά %1$@). Πάτησε ένα τμήμα παρακάτω για να το επαναφέρεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Red sections are really removed when saving (total %1$@). Tap a section below to bring it back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las zonas rojas se eliminan de verdad al guardar (total %1$@). Toca una abajo para recuperarla."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Punaiset osat poistetaan oikeasti tallennettaessa (yhteensä %1$@). Napauta alla olevaa osaa palauttaaksesi sen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les passages rouges sont vraiment supprimés à l’enregistrement (durée totale %1$@). Touche un passage ci-dessous pour le récupérer."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "લાલ ભાગો સાચવતી વખતે ખરેખર દૂર થાય છે (કુલ %1$@). કોઈ ભાગ પાછો લાવવા નીચે તેના પર ટૅપ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קטעים אדומים מוסרים באמת בשמירה (סך הכול %1$@). הקשה על קטע למטה מחזירה אותו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लाल हिस्से सहेजते समय सच में हट जाते हैं (कुल %1$@)। किसी हिस्से को वापस लाने के लिए नीचे उस पर टैप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crveni dijelovi stvarno se uklanjaju pri spremanju (ukupno %1$@). Dodirni dio ispod da ga vratiš."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A piros szakaszok mentéskor valóban eltávolításra kerülnek (összesen %1$@). Koppints alább egy szakaszra a visszahozásához."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bagian merah benar-benar dihapus saat disimpan (total %1$@). Ketuk bagian di bawah untuk mengembalikannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le parti rosse vengono davvero rimosse al salvataggio (totale %1$@). Tocca una parte qui sotto per recuperarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "赤い区間は保存時に実際に削除されます（全体 %1$@）。下の区間をタップすると元に戻ります。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಉಳಿಸುವಾಗ ಕೆಂಪು ಭಾಗಗಳನ್ನು ನಿಜವಾಗಿಯೂ ತೆಗೆದುಹಾಕಲಾಗುತ್ತದೆ (ಒಟ್ಟು %1$@). ಒಂದು ಭಾಗವನ್ನು ಮರಳಿ ತರಲು ಕೆಳಗೆ ಅದನ್ನು ಟ್ಯಾಪ್ ಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빨간 구간은 저장할 때 실제로 제거돼요(전체 %1$@). 아래 구간을 탭하면 되돌려요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സംരക്ഷിക്കുമ്പോൾ ചുവന്ന ഭാഗങ്ങൾ ശരിക്കും നീക്കം ചെയ്യും (ആകെ %1$@). ഒരു ഭാഗം തിരികെ കൊണ്ടുവരാൻ താഴെ അതിൽ ടാപ്പ് ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "लाल भाग जतन करताना खरोखर काढले जातात (एकूण %1$@). भाग परत आणण्यासाठी खाली त्यावर टॅप करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bahagian merah benar-benar dibuang semasa menyimpan (jumlah %1$@). Ketik bahagian di bawah untuk mengembalikannya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Røde deler fjernes virkelig når du lagrer (totalt %1$@). Trykk på en del nedenfor for å hente den tilbake."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rode stukken worden bij opslaan echt verwijderd (totaal %1$@). Tik hieronder op een stuk om het terug te halen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସେଭ୍ କରିବା ସମୟରେ ଲାଲ ଅଂଶଗୁଡ଼ିକ ସତରେ ହଟାଯାଏ (ମୋଟ %1$@)। ଏକ ଅଂଶ ଫେରାଇବାକୁ ତଳେ ତାହାରେ ଟାପ୍ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਲਾਲ ਹਿੱਸੇ ਸੰਭਾਲਣ ਵੇਲੇ ਸੱਚਮੁੱਚ ਹਟਾਏ ਜਾਂਦੇ ਹਨ (ਕੁੱਲ %1$@)। ਕਿਸੇ ਹਿੱਸੇ ਨੂੰ ਵਾਪਸ ਲਿਆਉਣ ਲਈ ਹੇਠਾਂ ਉਸ ਉੱਤੇ ਟੈਪ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czerwone fragmenty są przy zapisie naprawdę usuwane (całość %1$@). Dotknij fragmentu poniżej, aby go przywrócić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As partes vermelhas são removidas de verdade ao salvar (total %1$@). Toque numa parte abaixo para trazê-la de volta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As partes vermelhas são mesmo removidas ao guardar (total %1$@). Toca numa parte abaixo para a recuperar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Porțiunile roșii sunt eliminate cu adevărat la salvare (total %1$@). Atinge o porțiune de mai jos ca s-o recuperezi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Красные фрагменты при сохранении действительно удаляются (всего %1$@). Нажми на фрагмент ниже, чтобы вернуть его."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Červené úseky sa pri uložení naozaj odstránia (spolu %1$@). Klepnutím na úsek nižšie ho vrátite."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rdeči odseki se ob shranjevanju res odstranijo (skupaj %1$@). Tapni odsek spodaj, da ga vrneš."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Röda avsnitt tas verkligen bort när du sparar (totalt %1$@). Tryck på ett avsnitt nedan för att ta tillbaka det."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சேமிக்கும்போது சிவப்புப் பகுதிகள் உண்மையில் அகற்றப்படும் (மொத்தம் %1$@). ஒரு பகுதியைத் திரும்பக் கொண்டுவரக் கீழே அதைத் தட்டுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సేవ్ చేసేటప్పుడు ఎరుపు భాగాలు నిజంగా తీసివేయబడతాయి (మొత్తం %1$@). ఒక భాగాన్ని తిరిగి తీసుకురావడానికి కింద దాన్ని ట్యాప్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่วนสีแดงจะถูกนำออกจริงเมื่อบันทึก (รวม %1$@) แตะส่วนด้านล่างเพื่อนำกลับมา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kırmızı bölümler kaydederken gerçekten kaldırılır (toplam %1$@). Geri almak için aşağıdaki bir bölüme dokun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Червоні фрагменти під час збереження справді видаляються (усього %1$@). Торкнися фрагмента нижче, щоб повернути його."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سرخ حصے محفوظ کرتے وقت واقعی ہٹ جاتے ہیں (کل %1$@)۔ کسی حصے کو واپس لانے کے لیے نیچے اس پر ٹیپ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các đoạn màu đỏ sẽ thật sự bị xóa khi lưu (tổng %1$@). Chạm vào một đoạn bên dưới để lấy lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "红色片段会在保存时真正删除（总长 %1$@）。点按下方片段即可恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "紅色片段會在儲存時真正移除（共 %1$@）。點一下下方的片段即可恢復。"
          }
        }
      }
    },
