    "tools_convert_intro": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحفظ الصور بصيغة ملف أخرى، مثل HEIC بصيغة JPEG للأجهزة التي لا تفتح HEIC."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemmer fotos i et andet filformat, f.eks. HEIC som JPEG til enheder, der ikke kan åbne HEIC."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichert Fotos in einem anderen Dateiformat, z. B. HEIC als JPEG für Geräte, die HEIC nicht öffnen können."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves photos in another file format, e.g. HEIC as JPEG for devices that can’t open HEIC."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda las fotos en otro formato de archivo, p. ej. HEIC como JPEG para dispositivos que no abren HEIC."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre les photos dans un autre format de fichier, p. ex. HEIC en JPEG pour les appareils qui n’ouvrent pas le HEIC."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyimpan foto dalam format file lain, misalnya HEIC sebagai JPEG untuk perangkat yang tidak bisa membuka HEIC."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva le foto in un altro formato di file, ad es. HEIC come JPEG per i dispositivi che non aprono HEIC."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真を別のファイル形式で保存します。例：HEICを開けない機器向けにHEICをJPEGに。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진을 다른 파일 형식으로 저장해요. 예: HEIC를 열 수 없는 기기를 위해 JPEG로."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagrer bilder i et annet filformat, f.eks. HEIC som JPEG for enheter som ikke kan åpne HEIC."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaart foto’s in een ander bestandsformaat, bijv. HEIC als JPEG voor apparaten die HEIC niet openen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisuje zdjęcia w innym formacie pliku, np. HEIC jako JPEG dla urządzeń, które nie otwierają HEIC."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva fotos em outro formato de arquivo, por exemplo HEIC como JPEG para aparelhos que não abrem HEIC."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda as fotografias noutro formato de ficheiro, p. ex. HEIC como JPEG para dispositivos que não abrem HEIC."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvează fotografiile în alt format de fișier, de ex. HEIC ca JPEG pentru dispozitivele care nu deschid HEIC."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняет фото в другом формате, например HEIC как JPEG для устройств, которые не открывают HEIC."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparar bilder i ett annat filformat, t.ex. HEIC som JPEG för enheter som inte kan öppna HEIC."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกรูปในรูปแบบไฟล์อื่น เช่น HEIC เป็น JPEG สำหรับอุปกรณ์ที่เปิด HEIC ไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğrafları başka bir dosya biçiminde kaydeder; örneğin HEIC açamayan cihazlar için HEIC’i JPEG olarak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберігає фото в іншому форматі, наприклад HEIC як JPEG для пристроїв, які не відкривають HEIC."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu ảnh ở định dạng tệp khác, ví dụ HEIC thành JPEG cho thiết bị không mở được HEIC."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将照片存储为其他文件格式，例如为无法打开 HEIC 的设备将 HEIC 转为 JPEG。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將照片儲存為其他檔案格式，例如將 HEIC 轉成 JPEG，供無法打開 HEIC 的裝置使用。"
          }
        }
      }
    },
    "tools_convert_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل الأجهزة تفتح JPEG. يحتفظ PNG بكل التفاصيل لكن الملفات تصبح أكبر. تُتخطّى الصور التي بهذا التنسيق أصلًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle enheder kan åbne JPEG. PNG bevarer alle detaljer, men filerne bliver større. Fotos, der allerede har dette format, springes over."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JPEG öffnet jedes Gerät. PNG verliert keine Details, die Dateien werden aber größer. Fotos, die schon dieses Format haben, werden übersprungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every device opens JPEG. PNG keeps every detail, but files get bigger. Photos already in this format are skipped."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquier dispositivo abre JPEG. PNG conserva todos los detalles, pero los archivos son más grandes. Las fotos que ya tienen este formato se omiten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les appareils ouvrent le JPEG. Le PNG garde tous les détails, mais les fichiers sont plus gros. Les photos déjà dans ce format sont ignorées."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua perangkat bisa membuka JPEG. PNG mempertahankan semua detail, tapi file jadi lebih besar. Foto yang sudah dalam format ini dilewati."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni dispositivo apre i JPEG. PNG conserva tutti i dettagli, ma i file diventano più grandi. Le foto già in questo formato vengono saltate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "JPEG はどの端末でも開けます。PNG は細部まで残りますが、ファイルが大きくなります。すでにこの形式の写真はスキップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "JPEG는 어느 기기에서나 열려요. PNG는 세부까지 그대로지만 파일이 커져요. 이미 이 형식인 사진은 건너뛰어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle enheter kan åpne JPEG. PNG beholder alle detaljer, men filene blir større. Bilder som allerede har dette formatet, hoppes over."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elk apparaat opent JPEG. PNG behoudt alle details, maar bestanden worden groter. Foto’s die al dit formaat hebben, worden overgeslagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każde urządzenie otworzy JPEG. PNG zachowuje wszystkie szczegóły, ale pliki są większe. Zdjęcia już w tym formacie są pomijane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo aparelho abre JPEG. PNG mantém todos os detalhes, mas os arquivos ficam maiores. Fotos que já estão nesse formato são puladas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualquer dispositivo abre JPEG. PNG mantém todos os detalhes, mas os ficheiros ficam maiores. As fotos já neste formato são ignoradas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Orice dispozitiv deschide JPEG. PNG păstrează toate detaliile, dar fișierele sunt mai mari. Fotografiile care au deja acest format sunt omise."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "JPEG открывается на любом устройстве. PNG сохраняет все детали, но файлы больше. Фото, которые уже в этом формате, пропускаются."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla enheter kan öppna JPEG. PNG behåller alla detaljer, men filerna blir större. Bilder som redan har det här formatet hoppas över."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกอุปกรณ์เปิด JPEG ได้ PNG เก็บทุกรายละเอียดแต่ไฟล์ใหญ่ขึ้น รูปที่อยู่ในรูปแบบนี้แล้วจะถูกข้าม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "JPEG’i her cihaz açar. PNG tüm ayrıntıları korur ama dosyalar büyür. Zaten bu biçimde olan fotoğraflar atlanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "JPEG відкривається на будь-якому пристрої. PNG зберігає всі деталі, але файли більші. Фото, які вже в цьому форматі, пропускаються."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi thiết bị đều mở được JPEG. PNG giữ mọi chi tiết nhưng tệp lớn hơn. Ảnh đã ở định dạng này sẽ bị bỏ qua."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有设备都能打开 JPEG。PNG 保留所有细节，但文件更大。已是该格式的照片会被跳过。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有裝置都能打開 JPEG。PNG 保留所有細節，但檔案較大。已經是此格式的照片會略過。"
          }
        }
      }
    },
    "tools_convert_sub": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
