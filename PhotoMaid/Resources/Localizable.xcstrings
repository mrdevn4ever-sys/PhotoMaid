    "collage_res_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الرقم يخص الضلع الأطول. الدقة الأعلى أوضح عند التكبير أو الطباعة، لكن الملف يصبح أكبر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zahl gilt für die längere Seite. Höher wirkt beim Zoomen und Drucken schärfer, ergibt aber eine größere Datei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The number is the longer side. Higher looks sharper when zoomed in or printed, but the file gets larger."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El número es el lado más largo. Una resolución más alta se ve más nítida al ampliar o imprimir, pero el archivo es más grande."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nombre correspond au côté le plus long. Plus elle est élevée, plus l’image est nette au zoom ou à l’impression, mais le fichier est plus lourd."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il numero indica il lato più lungo. Più è alta, più l’immagine è nitida con lo zoom o in stampa, ma il file è più grande."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "数値は長辺のピクセル数です。高いほど拡大や印刷でくっきりしますが、ファイルは大きくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "숫자는 긴 변의 길이입니다. 높을수록 확대하거나 인쇄할 때 선명하지만 파일이 커집니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het getal is de langste zijde. Hoger is scherper bij inzoomen of afdrukken, maar het bestand wordt groter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Liczba dotyczy dłuższego boku. Wyższa rozdzielczość wygląda ostrzej po powiększeniu lub wydruku, ale plik jest większy."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O número refere-se ao lado mais comprido. Uma resolução mais alta fica mais nítida ao ampliar ou imprimir, mas o ficheiro fica maior."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Numărul se referă la latura mai lungă. O rezoluție mai mare arată mai clar la mărire sau tipărire, dar fișierul e mai mare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Число — длина большей стороны. Чем выше, тем чётче при увеличении и печати, но файл больше."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayı uzun kenarı belirtir. Daha yüksek değer yakınlaştırınca ve baskıda daha net görünür, ancak dosya büyür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Число — довжина більшої сторони. Що вище, то чіткіше при збільшенні й друку, але файл більший."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数字指较长边。越高放大或打印时越清晰，但文件越大。"
          }
        }
      }
    },
