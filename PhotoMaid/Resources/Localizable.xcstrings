    "movie_clips_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم ⋯ لنقل مقطع أو إزالته. تبقى الصور والفيديوهات نفسها دون تغيير."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো ক্লিপ সরাতে বা বাদ দিতে ⋯ ব্যবহার করুন। ফটো ও ভিডিওগুলো নিজে অপরিবর্তিত থাকে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fes servir ⋯ per moure o treure un clip. Les fotos i els vídeos no canvien."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomocí ⋯ klip přesunete nebo odeberete. Samotné fotky a videa zůstanou beze změny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug ⋯ til at flytte eller fjerne et klip. Selve fotos og videoer forbliver uændrede."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über ⋯ verschiebst oder entfernst du einen Clip. Die Fotos und Videos selbst bleiben unverändert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Με το ⋯ μετακινείς ή αφαιρείς ένα κλιπ. Οι ίδιες οι φωτογραφίες και τα βίντεο δεν αλλάζουν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use ⋯ to move or remove a clip. The photos and videos themselves stay unchanged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa ⋯ para mover o quitar un clip. Las fotos y los vídeos en sí no cambian."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siirrä tai poista leike ⋯-valikolla. Kuvat ja videot itse pysyvät ennallaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez ⋯ pour déplacer ou retirer un clip. Les photos et vidéos elles-mêmes restent inchangées."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ક્લિપ ખસેડવા કે દૂર કરવા ⋯ વાપરો. ફોટા અને વીડિયો પોતે બદલાતા નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עם ⋯ אפשר להזיז או להסיר קליפ. התמונות והסרטונים עצמם לא משתנים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्लिप हिलाने या हटाने के लिए ⋯ का उपयोग करें। फ़ोटो और वीडियो खुद नहीं बदलते।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koristi ⋯ za pomicanje ili uklanjanje isječka. Same fotografije i videozapisi ostaju nepromijenjeni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A ⋯ gombbal mozgathatsz vagy eltávolíthatsz egy klipet. Maguk a fotók és videók változatlanok maradnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pakai ⋯ untuk memindah atau menghapus klip. Foto dan videonya sendiri tidak berubah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa ⋯ per spostare o togliere una clip. Le foto e i video restano invariati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⋯ からクリップを移動または削除できます。写真やビデオ自体は変更されません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕ್ಲಿಪ್ ಸರಿಸಲು ಅಥವಾ ತೆಗೆದುಹಾಕಲು ⋯ ಬಳಸಿ. ಫೋಟೋಗಳು ಮತ್ತು ವೀಡಿಯೊಗಳು ಸ್ವತಃ ಬದಲಾಗದೆ ಉಳಿಯುತ್ತವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⋯에서 클립을 옮기거나 뺄 수 있어요. 사진과 동영상 자체는 바뀌지 않아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരു ക്ലിപ്പ് നീക്കാനോ നീക്കം ചെയ്യാനോ ⋯ ഉപയോഗിക്കുക. ഫോട്ടോകൾക്കും വീഡിയോകൾക്കും മാറ്റമുണ്ടാകില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "क्लिप हलवण्यासाठी किंवा काढण्यासाठी ⋯ वापरा. फोटो आणि व्हिडिओ स्वतः बदलत नाहीत."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan ⋯ untuk mengalih atau membuang klip. Foto dan video itu sendiri kekal tidak berubah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk ⋯ for å flytte eller fjerne et klipp. Selve bildene og videoene forblir uendret."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met ⋯ verplaats of verwijder je een clip. De foto’s en video’s zelf blijven ongewijzigd."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏକ କ୍ଲିପ୍ ଘୁଞ୍ଚାଇବାକୁ କିମ୍ବା ହଟାଇବାକୁ ⋯ ବ୍ୟବହାର କରନ୍ତୁ। ଫଟୋ ଓ ଭିଡିଓ ନିଜେ ଅପରିବର୍ତ୍ତିତ ରହେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕਿਸੇ ਕਲਿੱਪ ਨੂੰ ਹਿਲਾਉਣ ਜਾਂ ਹਟਾਉਣ ਲਈ ⋯ ਵਰਤੋ। ਫ਼ੋਟੋਆਂ ਅਤੇ ਵੀਡੀਓ ਖ਼ੁਦ ਬਿਨਾਂ ਬਦਲੇ ਰਹਿੰਦੀਆਂ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przez ⋯ przeniesiesz lub usuniesz klip. Same zdjęcia i filmy pozostają bez zmian."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use ⋯ para mover ou remover um clipe. As fotos e vídeos em si não são alterados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Use ⋯ para mover ou retirar um clipe. As fotografias e os vídeos em si não são alterados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Folosește ⋯ ca să muți sau să scoți un clip. Fotografiile și videoclipurile rămân neschimbate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Через ⋯ можно переместить или убрать клип. Сами фото и видео не меняются."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomocou ⋯ klip presuniete alebo odstránite. Samotné fotky a videá zostanú bez zmeny."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Z ⋯ premakneš ali odstraniš posnetek. Same fotografije in videoposnetki ostanejo nespremenjeni."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd ⋯ för att flytta eller ta bort ett klipp. Själva bilderna och videorna förblir oförändrade."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு கிளிப்பை நகர்த்த அல்லது அகற்ற ⋯ பயன்படுத்துங்கள். புகைப்படங்களும் வீடியோக்களும் மாறாமல் இருக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "క్లిప్‌ను కదపడానికి లేదా తీసివేయడానికి ⋯ వాడండి. ఫోటోలు, వీడియోలు మారవు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ ⋯ เพื่อย้ายหรือนำคลิปออก รูปภาพและวิดีโอเองไม่เปลี่ยนแปลง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir klibi taşımak veya çıkarmak için ⋯ simgesine dokun. Fotoğraf ve videoların kendisi değişmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Через ⋯ можна перемістити або прибрати кліп. Самі фото й відео не змінюються."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کلپ ہلانے یا ہٹانے کے لیے ⋯ استعمال کریں۔ تصاویر اور ویڈیوز خود تبدیل نہیں ہوتیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng ⋯ để di chuyển hoặc xóa một đoạn. Bản thân ảnh và video không thay đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 ⋯ 可移动或移除片段。照片和视频本身不会改变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 ⋯ 來移動或移除片段。照片和影片本身保持不變。"
          }
        }
      }
    },
