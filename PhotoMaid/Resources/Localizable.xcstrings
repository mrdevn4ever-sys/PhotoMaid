    "tour_today_quick_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صور أو فيديو أو لقطات شاشة أو ألبوم: أنشئ اختصارات لما ترتّبه كثيرًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফটো, ভিডিও, স্ক্রিনশট বা কোনো অ্যালবাম: যা প্রায়ই পরিষ্কার করেন তার জন্য শর্টকাট তৈরি করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos, vídeos, captures de pantalla o un àlbum: crea dreceres al que endreces sovint."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotky, videa, snímky obrazovky nebo album: vytvořte si zkratky k tomu, co často uklízíte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos, videoer, skærmbilleder eller et album: opret genveje til det, du ofte rydder op i."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos, Videos, Screenshots oder ein Album: Lege Schnellzugriffe für das an, was du oft aufräumst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Φωτογραφίες, βίντεο, στιγμιότυπα ή ένα άλμπουμ: φτιάξε συντομεύσεις σε ό,τι τακτοποιείς συχνά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos, videos, screenshots or an album: create shortcuts to what you clean up often."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos, vídeos, capturas o un álbum: crea accesos rápidos a lo que ordenas a menudo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvat, videot, kuvakaappaukset tai albumi: luo oikoteitä siihen, mitä siivoat usein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos, vidéos, captures ou un album : créez des raccourcis vers ce que vous triez souvent."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફોટા, વીડિયો, સ્ક્રીનશૉટ કે કોઈ આલ્બમ: જેની તમે વારંવાર સાફસફાઈ કરો છો તેના શૉર્ટકટ બનાવો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תמונות, סרטונים, צילומי מסך או אלבום: אפשר ליצור קיצורים למה שמסדרים לעיתים קרובות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोटो, वीडियो, स्क्रीनशॉट या कोई एल्बम: जिसकी आप अक्सर सफ़ाई करते हैं, उसके शॉर्टकट बनाएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografije, videozapisi, snimke zaslona ili album: izradi prečace do onoga što često raščišćavaš."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotók, videók, képernyőképek vagy egy album: hozz létre parancsikonokat ahhoz, amit gyakran rendezel."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto, video, tangkapan layar, atau album: buat pintasan ke apa yang sering kamu rapikan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto, video, screenshot o un album: crea scorciatoie per ciò che riordini spesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真、ビデオ、スクリーンショット、アルバム：よく整理するものへのショートカットを作れます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಫೋಟೋಗಳು, ವೀಡಿಯೊಗಳು, ಸ್ಕ್ರೀನ್‌ಶಾಟ್‌ಗಳು ಅಥವಾ ಆಲ್ಬಮ್: ನೀವು ಆಗಾಗ ಸ್ವಚ್ಛಗೊಳಿಸುವುದಕ್ಕೆ ಶಾರ್ಟ್‌ಕಟ್‌ಗಳನ್ನು ರಚಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진, 비디오, 스크린샷 또는 앨범: 자주 정리하는 항목의 바로가기를 만드세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഫോട്ടോകൾ, വീഡിയോകൾ, സ്ക്രീൻഷോട്ടുകൾ അല്ലെങ്കിൽ ഒരു ആൽബം: നിങ്ങൾ പതിവായി വൃത്തിയാക്കുന്നവയ്ക്ക് കുറുക്കുവഴികൾ സൃഷ്‌ടിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फोटो, व्हिडिओ, स्क्रीनशॉट किंवा एखादा अल्बम: ज्याची तुम्ही वारंवार साफसफाई करता त्याचे शॉर्टकट तयार करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto, video, syot layar atau album: cipta pintasan ke perkara yang kerap anda kemas."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilder, videoer, skjermbilder eller et album: lag snarveier til det du ofte rydder i."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto’s, video’s, screenshots of een album: maak snelkoppelingen naar wat je vaak opruimt."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଫଟୋ, ଭିଡିଓ, ସ୍କ୍ରିନସଟ୍ କିମ୍ବା ଏକ ଆଲବମ୍: ଯାହା ଆପଣ ପ୍ରାୟ ସଫା କରନ୍ତି ତା ପାଇଁ ସର୍ଟକଟ୍ ତିଆରି କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਫ਼ੋਟੋਆਂ, ਵੀਡੀਓ, ਸਕ੍ਰੀਨਸ਼ਾਟ ਜਾਂ ਕੋਈ ਐਲਬਮ: ਜਿਸ ਦੀ ਤੁਸੀਂ ਅਕਸਰ ਸਫ਼ਾਈ ਕਰਦੇ ਹੋ, ਉਸ ਲਈ ਸ਼ਾਰਟਕੱਟ ਬਣਾਓ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdjęcia, filmy, zrzuty ekranu lub album: utwórz skróty do tego, co często porządkujesz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos, vídeos, capturas de tela ou um álbum: crie atalhos para o que você limpa com frequência."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografias, vídeos, capturas ou um álbum: crie atalhos para o que arruma com frequência."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Poze, videoclipuri, capturi sau un album: creează scurtături pentru ce ordonezi des."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото, видео, скриншоты или альбом: создайте быстрый доступ к тому, что убираете часто."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotky, videá, snímky obrazovky alebo album: vytvorte si skratky k tomu, čo často upratujete."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografije, videoposnetki, zaslonske slike ali album: ustvari bližnjice do tistega, kar pogosto čistiš."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilder, videor, skärmavbilder eller ett album: skapa genvägar till det du ofta rensar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "புகைப்படங்கள், வீடியோக்கள், ஸ்கிரீன்ஷாட்கள் அல்லது ஒரு ஆல்பம்: நீங்கள் அடிக்கடி சுத்தம் செய்பவற்றுக்குக் குறுக்குவழிகளை உருவாக்குங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫోటోలు, వీడియోలు, స్క్రీన్‌షాట్‌లు లేదా ఒక ఆల్బమ్: మీరు తరచుగా శుభ్రం చేసేవాటికి షార్ట్‌కట్‌లు సృష్టించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปภาพ วิดีโอ ภาพหน้าจอ หรืออัลบั้ม: สร้างทางลัดไปยังสิ่งที่คุณจัดระเบียบบ่อย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraflar, videolar, ekran görüntüleri veya bir albüm: sık temizlediklerin için kısayol oluştur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото, відео, знімки екрана чи альбом: створіть швидкий доступ до того, що прибираєте часто."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تصاویر، ویڈیوز، اسکرین شاٹس یا کوئی البم: جس کی آپ اکثر صفائی کرتے ہیں، اس کے شارٹ کٹ بنائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh, video, ảnh chụp màn hình hoặc album: tạo lối tắt đến những gì bạn hay dọn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片、视频、截屏或某个相簿：为你经常整理的内容创建快捷入口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "照片、影片、截圖或相簿：為你常整理的內容建立捷徑。"
          }
        }
      }
    },
