        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಹಲವು ಫೋಟೋಗಳ ಎಕ್ಸ್‌ಪೋಶರ್ ಅನ್ನು ಒಮ್ಮೆಗೇ ಬದಲಾಯಿಸುತ್ತದೆ."
