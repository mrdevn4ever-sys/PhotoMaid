          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Raz dziennie. Bonus jest ważny tylko dzisiaj."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma vez por dia. O bónus só é válido hoje."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O dată pe zi. Bonusul este valabil doar azi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Раз в день. Бонус действует только сегодня."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günde bir kez. Bonus yalnızca bugün geçerlidir."
          }
