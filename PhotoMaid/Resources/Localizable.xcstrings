    "lib_search_none_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا شيء يطابق «%1$@». لا تهم علامات التشكيل ولا الأحرف الكبيرة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts passt zu „%1$@“. Akzente und Großbuchstaben spielen keine Rolle."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing matches “%1$@”. Accents and capital letters don’t matter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada coincide con «%1$@». Los acentos y las mayúsculas no importan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ne correspond à « %1$@ ». Les accents et les majuscules n’ont pas d’importance."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun risultato per «%1$@». Accenti e maiuscole non contano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」に一致するものはありません。アクセントや大文字小文字は区別しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'%1$@'와(과) 일치하는 항목이 없어요. 악센트와 대소문자는 상관없어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niets komt overeen met ‘%1$@’. Accenten en hoofdletters maken niet uit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie pasuje do „%1$@”. Akcenty i wielkie litery nie mają znaczenia."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada corresponde a «%1$@». Os acentos e as maiúsculas não contam."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimic nu se potrivește cu „%1$@”. Diacriticele și majusculele nu contează."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего не подходит под «%1$@». Акценты и регистр не важны."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@” ile eşleşen bir şey yok. Aksanlar ve büyük harfler fark etmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нічого не відповідає «%1$@». Наголоси й регістр не важливі."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有与“%1$@”匹配的内容。不区分重音和大小写。"
          }
        }
      }
    },
