    "vault2_remove_original_warning": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن يُزال الأصل غير المعدّل من مصدره إلا بعد التحقق من نسخة الخزنة. قد تبقى نسخ أخرى وسلة مزوّد الملفات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভল্টের কপি যাচাই হওয়ার পরেই অপরিবর্তিত মূলটি তার উৎস থেকে সরানো হবে। অন্য কপি ও ফাইল প্রদানকারীর ট্র্যাশ থেকে যেতে পারে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Només després de verificar la còpia de la caixa forta s’eliminarà l’original sense canvis del seu origen. Poden quedar altres còpies i la paperera del proveïdor de fitxers."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nezměněný originál se ze zdroje odstraní až po ověření kopie v trezoru. Jiné kopie a koš poskytovatele souborů mohou zůstat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Først når kopien i boksen er kontrolleret, fjernes den uændrede original fra kilden. Andre kopier og filudbyderens papirkurv kan stadig findes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur nach Prüfung der Tresorkopie wird die unveränderte Originaldatei am Quellort entfernt. Weitere Kopien und der Papierkorb des Dateianbieters können bestehen bleiben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το αμετάβλητο πρωτότυπο αφαιρείται από την πηγή του μόνο μετά την επαλήθευση του αντιγράφου στο θησαυροφυλάκιο. Άλλα αντίγραφα και ο κάδος του παρόχου αρχείων μπορεί να παραμείνουν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only after verifying the vault copy will the unchanged original be removed from its source. Other copies and the file provider’s trash may remain."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El original sin cambios se eliminará solo tras verificar la copia de la caja fuerte. Pueden quedar otras copias y la papelera del proveedor."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muuttamaton alkuperäinen poistetaan lähteestään vasta, kun holvin kopio on tarkistettu. Muut kopiot ja tiedostopalvelun roskakori voivat jäädä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’original inchangé sera supprimé à la source uniquement après vérification de la copie du coffre. D’autres copies et la corbeille du fournisseur peuvent subsister."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "વૉલ્ટ નકલ ચકાસ્યા પછી જ બદલાયા વિનાનું મૂળ તેના સ્રોતમાંથી દૂર થશે. બીજી નકલો અને ફાઇલ પ્રદાતાનું ટ્રેશ રહી શકે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רק אחרי אימות העותק בכספת, המקור ללא השינויים יוסר מהמקום שלו. עותקים אחרים והפח של ספק הקבצים עשויים להישאר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तिजोरी की कॉपी जाँचने के बाद ही बिना बदला मूल अपने स्रोत से हटेगा। दूसरी कॉपी और फ़ाइल प्रदाता का ट्रैश बचे रह सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepromijenjeni original uklonit će se iz izvora tek nakon provjere kopije u trezoru. Druge kopije i smeće pružatelja datoteka mogu ostati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A változatlan eredeti csak a széfbeli másolat ellenőrzése után törlődik a forrásból. Más másolatok és a fájlszolgáltató kukája megmaradhatnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya setelah salinan di brankas diperiksa, aslinya yang tidak berubah dihapus dari sumbernya. Salinan lain dan sampah penyedia file mungkin masih ada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’originale invariato verrà rimosso solo dopo aver verificato la copia nella cassaforte. Altre copie e il cestino del provider possono rimanere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保管庫のコピーを検証してから、変更されていない元のファイルを削除します。他のコピーやプロバイダのゴミ箱には残る場合があります。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ವಾಲ್ಟ್ ಪ್ರತಿಯನ್ನು ಪರಿಶೀಲಿಸಿದ ನಂತರವೇ ಬದಲಾಗದ ಮೂಲವನ್ನು ಅದರ ಮೂಲಸ್ಥಾನದಿಂದ ತೆಗೆದುಹಾಕಲಾಗುತ್ತದೆ. ಇತರ ಪ್ರತಿಗಳು ಮತ್ತು ಫೈಲ್ ಪೂರೈಕೆದಾರರ ಕಸದ ಬುಟ್ಟಿ ಉಳಿಯಬಹುದು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관함 사본을 검증한 뒤 변경되지 않은 원본만 원래 위치에서 삭제합니다. 다른 사본과 제공업체 휴지통에는 남을 수 있습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വോൾട്ട് പകർപ്പ് പരിശോധിച്ച ശേഷം മാത്രമേ മാറ്റമില്ലാത്ത ഒറിജിനൽ അതിന്റെ ഉറവിടത്തിൽ നിന്ന് നീക്കം ചെയ്യൂ. മറ്റ് പകർപ്പുകളും ഫയൽ ദാതാവിന്റെ ട്രാഷും നിലനിന്നേക്കാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "व्हॉल्ट प्रत तपासल्यानंतरच न बदललेले मूळ त्याच्या स्रोतातून काढले जाईल. इतर प्रती आणि फाइल पुरवठादाराचा ट्रॅश राहू शकतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya selepas salinan peti besi disahkan, yang asal tanpa perubahan akan dibuang daripada sumbernya. Salinan lain dan sampah penyedia fail mungkin kekal."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Først når kopien i safen er kontrollert, fjernes den uendrede originalen fra kilden. Andre kopier og filleverandørens papirkurv kan fortsatt finnes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het ongewijzigde origineel wordt pas verwijderd na controle van de kluiskopie. Andere kopieën en de prullenmand van de provider kunnen blijven bestaan."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଭଲ୍ଟ କପି ଯାଞ୍ଚ ପରେ ହିଁ ଅପରିବର୍ତ୍ତିତ ମୂଳକୁ ଏହାର ଉତ୍ସରୁ ହଟାଯିବ। ଅନ୍ୟ କପି ଓ ଫାଇଲ୍ ପ୍ରଦାତାଙ୍କ ଟ୍ରାସ ରହିପାରେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਵੌਲਟ ਕਾਪੀ ਦੀ ਪੁਸ਼ਟੀ ਤੋਂ ਬਾਅਦ ਹੀ ਬਿਨਾਂ ਬਦਲਿਆ ਮੂਲ ਉਸ ਦੇ ਸਰੋਤ ਤੋਂ ਹਟਾਇਆ ਜਾਵੇਗਾ। ਹੋਰ ਕਾਪੀਆਂ ਅਤੇ ਫ਼ਾਈਲ ਪ੍ਰਦਾਤਾ ਦੀ ਰੱਦੀ ਰਹਿ ਸਕਦੀ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niezmieniony oryginał zostanie usunięty dopiero po sprawdzeniu kopii w sejfie. Inne kopie i kosz dostawcy mogą pozostać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só depois de verificar a cópia do cofre o original inalterado é removido da origem. Outras cópias e a lixeira do provedor de arquivos podem continuar existindo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O original inalterado só será removido após verificar a cópia do cofre. Outras cópias e o lixo do fornecedor podem permanecer."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Originalul nemodificat va fi eliminat doar după verificarea copiei din seif. Alte copii și coșul furnizorului pot rămâne."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неизменённый оригинал будет удалён только после проверки копии в сейфе. Другие копии и корзина провайдера могут сохраниться."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nezmenený originál sa zo zdroja odstráni až po overení kópie v trezore. Iné kópie a kôš poskytovateľa súborov môžu zostať."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nespremenjeni izvirnik se iz vira odstrani šele po preverjanju kopije v sefu. Druge kopije in koš ponudnika datotek lahko ostanejo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Först när valvkopian är kontrollerad tas det oförändrade originalet bort från källan. Andra kopior och filleverantörens papperskorg kan finnas kvar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "லாக்கர் நகலைச் சரிபார்த்த பின்னரே மாறாத அசல் அதன் மூலத்திலிருந்து அகற்றப்படும். மற்ற நகல்களும் கோப்பு வழங்குநரின் குப்பையும் இருக்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వాల్ట్ కాపీని తనిఖీ చేసిన తర్వాతే మారని ఒరిజినల్ దాని మూలం నుండి తీసివేయబడుతుంది. ఇతర కాపీలు, ఫైల్ ప్రొవైడర్ ట్రాష్ మిగిలి ఉండవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หลังจากตรวจสอบสำเนาในตู้เซฟแล้วเท่านั้น ต้นฉบับที่ไม่เปลี่ยนแปลงจะถูกลบออกจากแหล่งที่มา สำเนาอื่นและถังขยะของผู้ให้บริการไฟล์อาจยังคงอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değişmemiş orijinal, kasa kopyası doğrulandıktan sonra kaldırılır. Diğer kopyalar ve sağlayıcının çöp kutusu kalabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Незмінений оригінал буде видалено лише після перевірки копії у сховищі. Інші копії та кошик постачальника можуть залишитися."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "والٹ کی کاپی کی تصدیق کے بعد ہی غیر تبدیل شدہ اصل اپنے ماخذ سے ہٹے گا۔ دوسری کاپیاں اور فائل فراہم کنندہ کی ردی باقی رہ سکتی ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ sau khi kiểm tra bản sao trong két sắt, bản gốc không thay đổi mới bị xóa khỏi nguồn. Các bản sao khác và thùng rác của nhà cung cấp tệp có thể vẫn còn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "验证保险库副本后，才会从来源位置移除未更改的原件。其他副本及文件提供方的废纸篓中可能仍有内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有在驗證保險箱副本後，才會從來源移除未更改的原始檔。其他副本和檔案提供者的垃圾桶中可能仍有保留。"
          }
        }
      }
    },
