    "ana2_background_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض iOS التقدّم وقد يوقف التحليل في أي وقت، ثم يتابع عند فتح PhotoMaid في المرة التالية. لا يغادر أي شيء هذا الـ iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS zeigt den Fortschritt an und kann die Analyse jederzeit beenden. Sie geht dann beim nächsten Öffnen von PhotoMaid weiter. Nichts verlässt dieses iPhone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS shows the progress and may stop the analysis at any time. It then continues the next time you open PhotoMaid. Nothing leaves this iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS muestra el progreso y puede detener el análisis en cualquier momento. Continuará la próxima vez que abras PhotoMaid. Nada sale de este iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS affiche la progression et peut arrêter l’analyse à tout moment. Elle reprend à la prochaine ouverture de PhotoMaid. Rien ne quitte cet iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS mostra l’avanzamento e può interrompere l’analisi in qualsiasi momento. Riprende alla prossima apertura di PhotoMaid. Nulla lascia questo iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "進行状況はiOSが表示し、iOSが分析をいつでも終了することがあります。その場合は次にPhotoMaidを開いたときに続行します。データはこのiPhoneから出ません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS가 진행 상황을 보여 주며 언제든 분석을 멈출 수 있어요. 그러면 다음에 PhotoMaid를 열 때 이어서 진행돼요. 어떤 데이터도 이 iPhone 밖으로 나가지 않아요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS toont de voortgang en kan de analyse altijd stoppen. Hij gaat dan verder als je PhotoMaid weer opent. Niets verlaat deze iPhone."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS pokazuje postęp i może w każdej chwili przerwać analizę. Wtedy będzie kontynuowana przy następnym otwarciu PhotoMaid. Nic nie opuszcza tego iPhone’a."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O iOS mostra o progresso e pode parar a análise a qualquer momento. Ela continua na próxima vez que abrires o PhotoMaid. Nada sai deste iPhone."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS afișează progresul și poate opri oricând analiza. Ea continuă data viitoare când deschizi PhotoMaid. Nimic nu părăsește acest iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS показывает ход работы и может в любой момент остановить анализ. Тогда он продолжится при следующем открытии PhotoMaid. Ничто не покидает этот iPhone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlerlemeyi iOS gösterir ve analizi her an durdurabilir. Analiz, PhotoMaid’i bir sonraki açışında devam eder. Hiçbir şey bu iPhone’dan çıkmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS показує поступ і може будь-коли зупинити аналіз. Тоді він продовжиться під час наступного відкриття PhotoMaid. Ніщо не залишає цей iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 会显示进度，并可能随时停止分析。下次打开 PhotoMaid 时会继续。任何内容都不会离开这台 iPhone。"
          }
        }
      }
    },
