    "vault_intro_1": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصور ومقاطع الفيديو في الخزنة مشفّرة برمزك ولا تظهر إلا هنا – وليس في أي مكان آخر في PhotoMaid."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos und Videos im Tresor sind mit deinem Code verschlüsselt und nur hier zu sehen – nirgends sonst in PhotoMaid."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos and videos in the vault are encrypted with your code and visible only here – nowhere else in PhotoMaid."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos y los vídeos de la caja fuerte están cifrados con tu código y solo se ven aquí, en ningún otro lugar de PhotoMaid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos et vidéos du coffre-fort sont chiffrées avec ton code et visibles uniquement ici – nulle part ailleurs dans PhotoMaid."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto e video nella cassaforte sono crittografati con il tuo codice e visibili solo qui, in nessun’altra parte di PhotoMaid."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保管庫内の写真とビデオはあなたのコードで暗号化され、ここでのみ表示されます。PhotoMaidのほかの場所には表示されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "금고 안의 사진과 비디오는 암호로 암호화되어 여기에서만 보이며, PhotoMaid의 다른 곳에는 표시되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto’s en video’s in de kluis zijn versleuteld met je code en alleen hier zichtbaar – nergens anders in PhotoMaid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdjęcia i filmy w sejfie są zaszyfrowane Twoim kodem i widoczne tylko tutaj – nigdzie indziej w PhotoMaid."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As fotografias e os vídeos no cofre estão encriptados com o teu código e só são visíveis aqui – em mais nenhum lugar do PhotoMaid."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozele și videoclipurile din seif sunt criptate cu codul tău și vizibile doar aici – nicăieri altundeva în PhotoMaid."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото и видео в сейфе зашифрованы твоим кодом и видны только здесь — больше нигде в PhotoMaid."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasadaki fotoğraflar ve videolar kodunla şifrelenir ve yalnızca burada görünür – PhotoMaid’in başka hiçbir yerinde görünmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото й відео в сейфі зашифровано твоїм кодом, і їх видно лише тут — більше ніде в PhotoMaid."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保险箱中的照片和视频已用你的密码加密，只在这里可见，PhotoMaid 的其他地方都看不到。"
          }
        }
      }
    },
    "vault_intro_2": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند إضافة عناصر، يسألك iOS هل يمكن حذفها من تطبيق الصور. بعدها تبقى في «المحذوفة مؤخرًا» لمدة 30 يومًا ما لم تُفرغه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Ablegen fragt iOS, ob sie aus der Fotos-App gelöscht werden dürfen. Danach liegen sie dort noch 30 Tage in „Zuletzt gelöscht“, außer du leerst den Ordner."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you add items, iOS asks whether they may be deleted from the Photos app. They then stay in “Recently Deleted” for 30 days unless you empty it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al añadir elementos, iOS pregunta si se pueden eliminar de la app Fotos. Después permanecen 30 días en «Eliminado», salvo que lo vacíes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand tu ajoutes des éléments, iOS demande s’ils peuvent être supprimés de l’app Photos. Ils restent ensuite 30 jours dans « Suppressions récentes », sauf si tu le vides."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando aggiungi elementi, iOS chiede se possono essere eliminati dall’app Foto. Poi restano per 30 giorni in «Eliminati di recente», a meno che tu non lo svuoti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "項目を追加すると、写真アプリから削除してよいかiOSが確認します。その後、空にしない限り30日間「最近削除した項目」に残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목을 추가하면 iOS가 사진 앱에서 삭제해도 되는지 묻습니다. 이후 직접 비우지 않는 한 30일 동안 ‘최근 삭제된 항목’에 남아 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je onderdelen toevoegt, vraagt iOS of ze uit de Foto’s-app mogen worden verwijderd. Daarna blijven ze nog 30 dagen in ‘Recent verwijderd’, tenzij je dat leegmaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy dodajesz elementy, iOS pyta, czy można je usunąć z aplikacji Zdjęcia. Potem pozostają przez 30 dni w albumie „Ostatnio usunięte”, chyba że go opróżnisz."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando adicionas itens, o iOS pergunta se podem ser apagados da app Fotografias. Depois ficam 30 dias em «Apagados recentemente», a não ser que o esvazies."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Când adaugi elemente, iOS întreabă dacă pot fi șterse din aplicația Poze. Apoi rămân 30 de zile în „Șterse recent”, dacă nu golești dosarul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При добавлении iOS спрашивает, можно ли удалить объекты из «Фото». Затем они ещё 30 дней остаются в «Недавно удаленных», если ты не очистишь этот альбом."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Öğe eklediğinde iOS, Fotoğraflar uygulamasından silinip silinemeyeceklerini sorar. Ardından sen boşaltmadıkça 30 gün boyunca “Son Silinenler”de kalırlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під час додавання iOS запитує, чи можна видалити об’єкти з «Фото». Потім вони ще 30 днів залишаються в «Нещодавно видалених», якщо ти не очистиш цей альбом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加项目时，iOS 会询问是否可以从“照片”App 中删除它们。之后它们会在“最近删除”中保留 30 天，除非你将其清空。"
          }
        }
      }
    },
    "vault_intro_3": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الخزنة مضمّنة في نسخة iPhone الاحتياطية (مشفّرة). إذا حذفت PhotoMaid، تختفي الخزنة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Tresor ist verschlüsselt in deinem iPhone-Backup enthalten. Löschst du PhotoMaid, ist er weg."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The vault is included in your iPhone backup (encrypted). If you delete PhotoMaid, the vault is gone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La caja fuerte se incluye en la copia de seguridad de tu iPhone (cifrada). Si eliminas PhotoMaid, la caja fuerte desaparece."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le coffre-fort est inclus dans la sauvegarde de ton iPhone (chiffré). Si tu supprimes PhotoMaid, le coffre-fort disparaît."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cassaforte è inclusa nel backup del tuo iPhone (crittografata). Se elimini PhotoMaid, la cassaforte sparisce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保管庫はiPhoneのバックアップに（暗号化された状態で）含まれます。PhotoMaidを削除すると、保管庫はなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "금고는 iPhone 백업에 (암호화된 상태로) 포함됩니다. PhotoMaid를 삭제하면 금고도 사라집니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De kluis zit (versleuteld) in je iPhone-reservekopie. Als je PhotoMaid verwijdert, is de kluis weg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sejf jest (w postaci zaszyfrowanej) częścią kopii zapasowej Twojego iPhone’a. Jeśli usuniesz PhotoMaid, sejf zniknie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O cofre está incluído na cópia de segurança do teu iPhone (encriptado). Se apagares o PhotoMaid, o cofre desaparece."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Seiful este inclus (criptat) în backupul iPhone-ului tău. Dacă ștergi PhotoMaid, seiful dispare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейф входит в резервную копию iPhone (в зашифрованном виде). Если удалишь PhotoMaid, сейф пропадёт."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasa, iPhone yedeğine (şifreli olarak) dahildir. PhotoMaid’i silersen kasa da gider."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейф входить до резервної копії iPhone (у зашифрованому вигляді). Якщо видалиш PhotoMaid, сейф зникне."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保险箱（已加密）包含在你的 iPhone 备份中。如果删除 PhotoMaid，保险箱也会随之消失。"
          }
        }
      }
    },
    "vault_intro_4": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في النسخة المجانية يحتاج كل مجلد جديد إلى فيديو إعلاني قصير. مع Pro تنشئ المجلدات بلا إعلانات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der Gratis-Version braucht jeder neue Ordner ein kurzes Werbevideo. Mit Pro legst du Ordner ohne Werbung an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the free version, each new folder needs a short ad video. With Pro, folders are created without ads."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la versión gratuita, cada carpeta nueva requiere un breve vídeo publicitario. Con Pro creas carpetas sin anuncios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans la version gratuite, chaque nouveau dossier nécessite une courte vidéo publicitaire. Avec Pro, tu crées des dossiers sans publicité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nella versione gratuita ogni nuova cartella richiede un breve video pubblicitario. Con Pro crei cartelle senza pubblicità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料版では新しいフォルダごとに短い広告動画が必要です。Proなら広告なしでフォルダを作成できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 버전에서는 새 폴더마다 짧은 광고 동영상이 필요해요. Pro에서는 광고 없이 폴더를 만들어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In de gratis versie heeft elke nieuwe map een korte advertentievideo nodig. Met Pro maak je mappen zonder advertenties."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W wersji bezpłatnej każdy nowy folder wymaga krótkiego filmu reklamowego. Z Pro tworzysz foldery bez reklam."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Na versão gratuita, cada nova pasta requer um curto vídeo publicitário. Com o Pro crias pastas sem anúncios."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În versiunea gratuită, fiecare dosar nou necesită un scurt videoclip publicitar. Cu Pro creezi dosare fără reclame."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В бесплатной версии для каждой новой папки нужно короткое рекламное видео. С Pro папки создаются без рекламы."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ücretsiz sürümde her yeni klasör için kısa bir reklam videosu gerekir. Pro ile klasörleri reklamsız oluşturursun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У безкоштовній версії для кожної нової теки потрібне коротке рекламне відео. З Pro теки створюються без реклами."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免费版中，每个新文件夹都需要观看一段简短的广告视频。使用 Pro 可无广告新建文件夹。"
          }
        }
      }
    },
    "vault_intro_title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خزنتك الخاصة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein privater Tresor"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your private vault"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu caja fuerte privada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton coffre-fort privé"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua cassaforte privata"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたのプライベート保管庫"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나만의 금고"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je privékluis"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój prywatny sejf"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O teu cofre privado"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Seiful tău privat"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твой личный сейф"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özel kasan"
