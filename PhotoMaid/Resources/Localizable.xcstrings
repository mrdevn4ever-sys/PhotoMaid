    "tour_editor_compare_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المس الصورة مع الاستمرار لرؤية الأصل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte den Finger auf dem Foto, um das Original zu sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch and hold the photo to see the original."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsada la foto para ver el original."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintiens le doigt sur la photo pour voir l’original."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuta la foto per vedere l’originale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真を長押しすると元の写真を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진을 길게 누르면 원본이 보여요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd je vinger op de foto om het origineel te zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymaj zdjęcie, aby zobaczyć oryginał."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém o dedo na foto para ver o original."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ține degetul pe fotografie pentru a vedea originalul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживай фото, чтобы увидеть оригинал."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Orijinali görmek için fotoğrafa basılı tut."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Утримуй фото, щоб побачити оригінал."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长按照片查看原图。"
          }
        }
