    "org_basket_clear_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُفرَغ السلة فقط. تبقى الصور ومقاطع الفيديو دون تغيير."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু ঝুড়ি খালি হয়। ফটো ও ভিডিও অপরিবর্তিত থাকে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Només es buida la cistella. Les fotos i els vídeos no canvien."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyprázdní se jen košík. Fotky a videa zůstanou beze změny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun kurven tømmes. Fotos og videoer forbliver uændrede."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur die Zusammenstellung wird geleert. Die Fotos und Videos bleiben unverändert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αδειάζει μόνο το καλάθι. Οι φωτογραφίες και τα βίντεο μένουν αμετάβλητα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the basket is emptied. The photos and videos stay unchanged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se vacía la cesta. Las fotos y los vídeos no cambian."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain kori tyhjennetään. Kuvat ja videot pysyvät ennallaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul le panier est vidé. Les photos et vidéos restent inchangées."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફક્ત ટોપલી ખાલી થાય છે. ફોટા અને વીડિયો બદલાતા નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רק הסל מתרוקן. התמונות והסרטונים לא משתנים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिर्फ़ टोकरी खाली होती है। फ़ोटो और वीडियो नहीं बदलते।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prazni se samo košarica. Fotografije i videozapisi ostaju nepromijenjeni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak a kosár ürül ki. A fotók és videók változatlanok maradnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya keranjang yang dikosongkan. Foto dan video tidak berubah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si svuota solo il cestino. Foto e video restano invariati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空になるのはかごだけです。写真と動画は変わりません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಬುಟ್ಟಿ ಮಾತ್ರ ಖಾಲಿಯಾಗುತ್ತದೆ. ಫೋಟೋಗಳು ಮತ್ತು ವೀಡಿಯೊಗಳು ಬದಲಾಗದೆ ಉಳಿಯುತ್ತವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바구니만 비워져요. 사진과 동영상은 그대로예요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കൊട്ട മാത്രം ശൂന്യമാകും. ഫോട്ടോകൾക്കും വീഡിയോകൾക്കും മാറ്റമുണ്ടാകില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फक्त टोपली रिकामी होते. फोटो आणि व्हिडिओ बदलत नाहीत."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya bakul dikosongkan. Foto dan video kekal tidak berubah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare kurven tømmes. Bildene og videoene forblir uendret."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen de mand wordt geleegd. De foto’s en video’s blijven ongewijzigd."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "କେବଳ ଟୋକେଇ ଖାଲି ହୁଏ। ଫଟୋ ଓ ଭିଡିଓ ଅପରିବର୍ତ୍ତିତ ରହେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਿਰਫ਼ ਟੋਕਰੀ ਖਾਲੀ ਹੁੰਦੀ ਹੈ। ਫ਼ੋਟੋਆਂ ਅਤੇ ਵੀਡੀਓ ਬਿਨਾਂ ਬਦਲੇ ਰਹਿੰਦੀਆਂ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opróżniany jest tylko koszyk. Zdjęcia i filmy pozostają bez zmian."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só a cesta é esvaziada. As fotos e vídeos não são alterados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Só o cesto é esvaziado. As fotos e os vídeos ficam inalterados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se golește doar coșul. Fotografiile și videoclipurile rămân neschimbate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очищается только корзина. Фото и видео не изменятся."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyprázdni sa len košík. Fotky a videá zostanú bez zmeny."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izprazni se samo košarica. Fotografije in videoposnetki ostanejo nespremenjeni."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara korgen töms. Bilderna och videorna förblir oförändrade."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கூடை மட்டுமே காலியாகும். புகைப்படங்களும் வீடியோக்களும் மாறாமல் இருக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "బుట్ట మాత్రమే ఖాళీ అవుతుంది. ఫోటోలు, వీడియోలు మారవు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ล้างเฉพาะตะกร้า รูปภาพและวิดีโอไม่เปลี่ยนแปลง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca sepet boşaltılır. Fotoğraflar ve videolar değişmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Очищається лише кошик. Фото й відео не зміняться."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف ٹوکری خالی ہوتی ہے۔ تصاویر اور ویڈیوز تبدیل نہیں ہوتیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ giỏ được làm trống. Ảnh và video không thay đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只清空选择篮。照片和视频保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只會清空選擇籃。照片和影片保持不變。"
          }
        }
      }
    },
