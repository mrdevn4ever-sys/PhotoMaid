        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les copies sont dans une autre app. GaleriQ ne peut pas voir si elles y sont en sécurité ; il ne propose donc pas de retirer les originaux."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "The copies are with another app. GaleriQ can’t see whether they’re safe there, so it doesn’t offer to remove originals."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le copie si trovano in un’altra app. GaleriQ non può vedere se lì sono al sicuro, quindi non propone di rimuovere gli originali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピーは別のアプリにあります。そこで安全かどうかGaleriQには分からないため、元のファイルを削除する提案はしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사본이 다른 앱에 있어요. 그곳에서 안전한지 GaleriQ는 알 수 없어서 원본을 지우자고 하지 않아요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "The copies are with another app. GaleriQ can’t see whether they’re safe there, so it doesn’t offer to remove originals."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De kopieën staan bij een andere app. GaleriQ kan niet zien of ze daar veilig zijn – daarom geen aanbod om originelen te verwijderen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopie są w innej aplikacji. GaleriQ nie widzi, czy są tam bezpieczne, więc nie proponuje usunięcia oryginałów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "The copies are with another app. GaleriQ can’t see whether they’re safe there, so it doesn’t offer to remove originals."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As cópias estão noutra app. O GaleriQ não consegue ver se estão seguras aí, por isso não propõe remover os originais."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiile sunt la altă aplicație. GaleriQ nu poate vedea dacă sunt în siguranță acolo, așa că nu propune eliminarea originalelor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копии находятся в другом приложении. GaleriQ не видит, надёжно ли они там хранятся, поэтому не предлагает убрать оригиналы."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "The copies are with another app. GaleriQ can’t see whether they’re safe there, so it doesn’t offer to remove originals."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "The copies are with another app. GaleriQ can’t see whether they’re safe there, so it doesn’t offer to remove originals."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopyalar başka bir uygulamada. GaleriQ orada güvende olup olmadıklarını göremez; bu yüzden orijinalleri kaldırmayı önermez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Копії зберігаються в іншому застосунку. GaleriQ не бачить, чи вони там у безпеці, тому не пропонує прибрати оригінали."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "The copies are with another app. GaleriQ can’t see whether they’re safe there, so it doesn’t offer to remove originals."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "副本在另一个应用中。GaleriQ 无法判断它们在那里是否安全，因此不会建议移除原件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "The copies are with another app. GaleriQ can’t see whether they’re safe there, so it doesn’t offer to remove originals."
          }
        }
      }
