          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਐਪ ਬਦਲਣ ’ਤੇ ਵੀ ਚੱਲਦਾ ਰਹਿੰਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Działa dalej, nawet gdy przełączysz aplikację."
