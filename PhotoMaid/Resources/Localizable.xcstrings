    "movie_too_long": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "30 دقيقة كحد أقصى إجمالًا. قصّر المقاطع أو أزل بعضها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মোট সর্বোচ্চ ৩০ মিনিট। ক্লিপ ছোট করুন বা কিছু সরান।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Com a màxim 30 minuts en total. Escurça clips o treu-ne alguns."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Celkem nejvýše 30 minut. Zkraťte klipy nebo některé odeberte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Højst 30 minutter i alt. Forkort klip, eller fjern nogle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Insgesamt höchstens 30 Minuten. Kürze Clips oder nimm welche heraus."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έως 30 λεπτά συνολικά. Συντόμευσε κλιπ ή αφαίρεσε μερικά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At most 30 minutes in total. Shorten clips or remove some."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Como máximo 30 minutos en total. Acorta o quita clips."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhteensä enintään 30 minuuttia. Lyhennä leikkeitä tai poista joitakin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "30 minutes au maximum au total. Raccourcissez ou retirez des clips."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કુલ વધુમાં વધુ 30 મિનિટ. ક્લિપ ટૂંકી કરો અથવા થોડી દૂર કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לכל היותר 30 דקות בסך הכול. אפשר לקצר קליפים או להסיר חלק מהם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुल ज़्यादा से ज़्यादा 30 मिनट। क्लिप छोटी करें या कुछ हटाएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Najviše 30 minuta ukupno. Skrati isječke ili ukloni neke."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Összesen legfeljebb 30 perc. Rövidíts klipeket, vagy távolíts el néhányat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Maksimal total 30 menit. Persingkat atau hapus beberapa klip."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al massimo 30 minuti in tutto. Accorcia o togli delle clip."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "合計30分までです。クリップを短くするか減らしてください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಒಟ್ಟು ಗರಿಷ್ಠ 30 ನಿಮಿಷಗಳು. ಕ್ಲಿಪ್‌ಗಳನ್ನು ಚಿಕ್ಕದಾಗಿಸಿ ಅಥವಾ ಕೆಲವನ್ನು ತೆಗೆದುಹಾಕಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 최대 30분입니다. 클립을 줄이거나 빼세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആകെ പരമാവധി 30 മിനിറ്റ്. ക്ലിപ്പുകൾ ചുരുക്കുകയോ ചിലത് നീക്കം ചെയ്യുകയോ ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "एकूण जास्तीत जास्त 30 मिनिटे. क्लिप लहान करा किंवा काही काढा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Paling lama 30 minit secara keseluruhan. Pendekkan klip atau buang sebahagian."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Maks 30 minutter totalt. Kort ned klipp eller fjern noen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximaal 30 minuten in totaal. Kort clips in of haal er een paar weg."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ମୋଟ ସର୍ବାଧିକ 30 ମିନିଟ୍। କ୍ଲିପ୍ ଛୋଟ କରନ୍ତୁ କିମ୍ବା କିଛି ହଟାନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੁੱਲ ਵੱਧ ਤੋਂ ਵੱਧ 30 ਮਿੰਟ। ਕਲਿੱਪਾਂ ਛੋਟੀਆਂ ਕਰੋ ਜਾਂ ਕੁਝ ਹਟਾਓ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Łącznie maksymalnie 30 minut. Skróć lub usuń klipy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No máximo 30 minutos no total. Encurte ou remova alguns clipes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "No máximo 30 minutos no total. Encurte ou retire clipes."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cel mult 30 de minute în total. Scurtează sau elimină clipuri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всего не более 30 минут. Сократите или уберите клипы."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Spolu najviac 30 minút. Skráťte klipy alebo niektoré odstráňte."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skupaj največ 30 minut. Skrajšaj posnetke ali nekatere odstrani."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Högst 30 minuter totalt. Korta klippen eller ta bort några."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மொத்தம் அதிகபட்சம் 30 நிமிடங்கள். கிளிப்களைச் சுருக்குங்கள் அல்லது சிலவற்றை அகற்றுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మొత్తం గరిష్ఠంగా 30 నిమిషాలు. క్లిప్‌లను కుదించండి లేదా కొన్నింటిని తీసివేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รวมได้สูงสุด 30 นาที ตัดให้สั้นลงหรือนำบางคลิปออก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toplam en fazla 30 dakika. Klipleri kısalt veya çıkar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Загалом не більше 30 хвилин. Скоротіть або приберіть кліпи."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کل زیادہ سے زیادہ 30 منٹ۔ کلپس چھوٹے کریں یا کچھ ہٹائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tổng cộng tối đa 30 phút. Hãy rút ngắn hoặc xóa bớt đoạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "总时长最多 30 分钟。请缩短或移除部分片段。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "總長最多 30 分鐘。請縮短或移除部分片段。"
          }
        }
      }
    },
