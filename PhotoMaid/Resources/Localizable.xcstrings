    "tools_gif_intro": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحوّل عدة صور إلى رسوم متحركة قصيرة تتكرر بلا نهاية – بترتيب التقاطها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একাধিক ফটোকে একটি ছোট অ্যানিমেশনে পরিণত করে যা অবিরাম পুনরাবৃত্তি হয় – তোলার ক্রমে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Converteix diverses fotos en una animació curta que es repeteix sense fi, en l’ordre en què es van fer."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Promění několik fotek v krátkou animaci, která se donekonečna opakuje – v pořadí pořízení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gør flere fotos til en kort animation, der gentages i det uendelige – i den rækkefølge, de blev taget."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Macht aus mehreren Fotos eine kurze Animation, die sich endlos wiederholt – in der Reihenfolge der Aufnahme."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μετατρέπει πολλές φωτογραφίες σε μια σύντομη κίνηση που επαναλαμβάνεται ατελείωτα – με τη σειρά λήψης."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turns several photos into a short animation that repeats endlessly – in the order they were taken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Convierte varias fotos en una animación corta que se repite sin fin, en el orden en que se hicieron."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekee useista kuvista lyhyen animaation, joka toistuu loputtomasti – kuvausjärjestyksessä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transforme plusieurs photos en une courte animation qui se répète sans fin, dans l’ordre de prise."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઘણા ફોટાને ટૂંકા ઍનિમેશનમાં ફેરવે છે જે સતત ફરી ચાલે છે – લીધેલા ક્રમમાં."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הופך כמה תמונות לאנימציה קצרה שחוזרת בלי סוף – לפי סדר הצילום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कई फ़ोटो को एक छोटे एनिमेशन में बदलता है जो लगातार दोहराता है – लेने के क्रम में।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pretvara više fotografija u kratku animaciju koja se beskonačno ponavlja – redoslijedom snimanja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Több fotóból rövid, végtelenül ismétlődő animációt készít – a készítés sorrendjében."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengubah beberapa foto menjadi animasi pendek yang berulang terus – sesuai urutan pengambilan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trasforma più foto in una breve animazione che si ripete all’infinito, nell’ordine in cui sono state scattate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複数の写真を、撮影順に繰り返し再生される短いアニメーションにします。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಹಲವು ಫೋಟೋಗಳನ್ನು ನಿರಂತರವಾಗಿ ಪುನರಾವರ್ತಿಸುವ ಚಿಕ್ಕ ಅನಿಮೇಷನ್ ಆಗಿ ಮಾಡುತ್ತದೆ – ತೆಗೆದ ಕ್ರಮದಲ್ಲಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여러 사진을 촬영 순서대로 끝없이 반복되는 짧은 애니메이션으로 만들어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിരവധി ഫോട്ടോകളെ അനന്തമായി ആവർത്തിക്കുന്ന ഒരു ചെറിയ ആനിമേഷനാക്കുന്നു – എടുത്ത ക്രമത്തിൽ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अनेक फोटोंना एका छोट्या अ‍ॅनिमेशनमध्ये बदलते जे सतत पुन्हा चालते – काढलेल्या क्रमाने."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menjadikan beberapa foto animasi pendek yang berulang tanpa henti – mengikut susunan ia diambil."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjør flere bilder om til en kort animasjon som gjentas i det uendelige – i den rekkefølgen de ble tatt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maakt van meerdere foto’s een korte animatie die eindeloos herhaalt – in de volgorde waarin ze zijn gemaakt."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଅନେକ ଫଟୋକୁ ଏକ ଛୋଟ ଆନିମେସନ୍‌ରେ ପରିଣତ କରେ ଯାହା ଅନନ୍ତ ଭାବେ ପୁନରାବୃତ୍ତି ହୁଏ – ଉଠାଯାଇଥିବା କ୍ରମରେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕਈ ਫ਼ੋਟੋਆਂ ਨੂੰ ਇੱਕ ਛੋਟੇ ਐਨੀਮੇਸ਼ਨ ਵਿੱਚ ਬਦਲਦਾ ਹੈ ਜੋ ਬੇਅੰਤ ਦੁਹਰਾਇਆ ਜਾਂਦਾ ਹੈ – ਖਿੱਚੇ ਜਾਣ ਦੇ ਕ੍ਰਮ ਵਿੱਚ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tworzy z kilku zdjęć krótką animację powtarzaną bez końca – w kolejności wykonania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transforma várias fotos numa animação curta que se repete sem fim – na ordem em que foram tiradas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Transforma várias fotografias numa animação curta que se repete sem fim, pela ordem em que foram tiradas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Transformă mai multe fotografii într-o animație scurtă care se repetă la nesfârșit, în ordinea în care au fost făcute."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Превращает несколько фото в короткую бесконечно повторяющуюся анимацию в порядке съёмки."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Premení niekoľko fotiek na krátku animáciu, ktorá sa donekonečna opakuje – v poradí nasnímania."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iz več fotografij naredi kratko animacijo, ki se neskončno ponavlja – v vrstnem redu posnetkov."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gör flera bilder till en kort animation som upprepas i oändlighet – i den ordning de togs."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பல புகைப்படங்களை முடிவின்றி மீண்டும் இயங்கும் சிறிய அனிமேஷனாக மாற்றுகிறது – எடுக்கப்பட்ட வரிசையில்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చాలా ఫోటోలను అంతులేకుండా పునరావృతమయ్యే చిన్న యానిమేషన్‌గా మారుస్తుంది – తీసిన క్రమంలో."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปลี่ยนหลายรูปเป็นภาพเคลื่อนไหวสั้นๆ ที่เล่นวนไม่สิ้นสุด – ตามลำดับที่ถ่าย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birkaç fotoğrafı, çekilme sırasına göre sonsuz tekrar eden kısa bir animasyona dönüştürür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетворює кілька фото на коротку анімацію, що повторюється безкінечно, у порядку зйомки."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کئی تصاویر کو ایک مختصر اینیمیشن میں بدلتا ہے جو مسلسل دہراتی ہے – لینے کی ترتیب میں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Biến nhiều ảnh thành một hoạt ảnh ngắn lặp lại mãi – theo thứ tự chụp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将多张照片按拍摄顺序制作成无限循环的短动画。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將多張照片做成無限重複播放的短動畫 – 依拍攝順序排列。"
          }
        }
      }
    },
    "tools_gif_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتوي ملفات GIF على 256 لونًا كحد أقصى ولا صوت – قد تبدو الصور محببة قليلًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF-এ সর্বোচ্চ ২৫৬টি রং থাকে এবং কোনো শব্দ নেই – ফটো একটু দানাদার দেখাতে পারে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els GIF tenen com a màxim 256 colors i no tenen so: les fotos poden semblar una mica granulades."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "GIFy mají nejvýše 256 barev a žádný zvuk – fotky mohou vypadat trochu zrnitě."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF'er har højst 256 farver og ingen lyd – fotos kan se lidt kornede ud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GIFs haben höchstens 256 Farben und keinen Ton – Fotos können etwas körnig wirken."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα GIF έχουν έως 256 χρώματα και χωρίς ήχο – οι φωτογραφίες μπορεί να φαίνονται λίγο κοκκώδεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GIFs have at most 256 colours and no sound – photos can look a little grainy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los GIF tienen como máximo 256 colores y no tienen sonido: las fotos pueden verse algo granuladas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF-kuvissa on enintään 256 väriä eikä ääntä – kuvat voivat näyttää hieman rakeisilta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les GIF ont au plus 256 couleurs et pas de son : les photos peuvent paraître un peu granuleuses."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF માં વધુમાં વધુ 256 રંગો હોય છે અને અવાજ નથી – ફોટા થોડા દાણાદાર લાગી શકે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ל-GIF יש לכל היותר 256 צבעים ואין צליל – התמונות עשויות להיראות מעט גרעיניות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF में ज़्यादा से ज़्यादा 256 रंग होते हैं और आवाज़ नहीं – फ़ोटो थोड़ी दानेदार दिख सकती हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF-ovi imaju najviše 256 boja i nemaju zvuk – fotografije mogu izgledati malo zrnato."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A GIF legfeljebb 256 színű és hangtalan – a fotók kissé szemcsésnek tűnhetnek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF punya maksimal 256 warna dan tanpa suara – foto bisa terlihat sedikit berbintik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le GIF hanno al massimo 256 colori e niente audio: le foto possono sembrare un po’ sgranate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GIFは最大256色で音声はありません。写真は少し粗く見えることがあります。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF ಗಳಲ್ಲಿ ಗರಿಷ್ಠ 256 ಬಣ್ಣಗಳಿರುತ್ತವೆ ಮತ್ತು ಧ್ವನಿ ಇರುವುದಿಲ್ಲ – ಫೋಟೋಗಳು ಸ್ವಲ್ಪ ಕಣಕಣವಾಗಿ ಕಾಣಬಹುದು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF는 최대 256색이며 소리가 없습니다. 사진이 약간 거칠어 보일 수 있습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF-കളിൽ പരമാവധി 256 നിറങ്ങളുണ്ട്, ശബ്ദമില്ല – ഫോട്ടോകൾ അൽപ്പം തരിതരിയായി തോന്നാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF मध्ये जास्तीत जास्त 256 रंग असतात आणि आवाज नसतो – फोटो थोडे दाणेदार दिसू शकतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF mempunyai paling banyak 256 warna dan tiada bunyi – foto mungkin kelihatan sedikit berbintik."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF-er har maks 256 farger og ingen lyd – bildene kan se litt kornete ut."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF’s hebben hoogstens 256 kleuren en geen geluid – foto’s kunnen wat korrelig ogen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "GIFରେ ସର୍ବାଧିକ 256ଟି ରଙ୍ଗ ଥାଏ ଏବଂ କୌଣସି ଧ୍ୱନି ନଥାଏ – ଫଟୋ ଟିକେ ଦାନାଦାର ଦେଖାଯାଇପାରେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF ਵਿੱਚ ਵੱਧ ਤੋਂ ਵੱਧ 256 ਰੰਗ ਹੁੰਦੇ ਹਨ ਅਤੇ ਕੋਈ ਆਵਾਜ਼ ਨਹੀਂ – ਫ਼ੋਟੋਆਂ ਥੋੜ੍ਹੀਆਂ ਦਾਣੇਦਾਰ ਲੱਗ ਸਕਦੀਆਂ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF-y mają najwyżej 256 kolorów i brak dźwięku – zdjęcia mogą wyglądać nieco ziarniście."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "GIFs têm no máximo 256 cores e não têm som – as fotos podem parecer um pouco granuladas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os GIF têm no máximo 256 cores e não têm som – as fotos podem parecer um pouco granuladas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF-urile au cel mult 256 de culori și nu au sunet – fotografiile pot părea puțin granulate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В GIF не более 256 цветов и нет звука – фото могут выглядеть немного зернистыми."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF-y majú najviac 256 farieb a žiadny zvuk – fotky môžu vyzerať trochu zrnito."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF-i imajo največ 256 barv in nimajo zvoka – fotografije so lahko nekoliko zrnate."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF:ar har högst 256 färger och inget ljud – bilderna kan se lite korniga ut."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF-களில் அதிகபட்சம் 256 நிறங்கள், ஒலி இல்லை – புகைப்படங்கள் சற்றுத் துகள்களாகத் தோன்றலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "GIFలలో గరిష్ఠంగా 256 రంగులు ఉంటాయి, ధ్వని ఉండదు – ఫోటోలు కొంచెం గరుకుగా కనిపించవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF มีสีได้สูงสุด 256 สีและไม่มีเสียง – รูปอาจดูมีเกรนเล็กน้อย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF’lerde en çok 256 renk vardır ve ses yoktur; fotoğraflar biraz grenli görünebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У GIF щонайбільше 256 кольорів і немає звуку – фото можуть виглядати трохи зернистими."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF میں زیادہ سے زیادہ 256 رنگ ہوتے ہیں اور آواز نہیں – تصاویر تھوڑی دانے دار لگ سکتی ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF có tối đa 256 màu và không có âm thanh – ảnh có thể hơi sạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF 最多 256 色且没有声音，照片可能略显颗粒感。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF 最多只有 256 種顏色且沒有聲音 – 照片看起來可能略有顆粒感。"
          }
        }
      }
    },
