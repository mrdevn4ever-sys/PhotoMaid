        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naar de GaleriQ-prullenbak – er wordt niets verwijderd. Je beslist daar later."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ଟ୍ରାସକୁ – କିଛି ଡିଲିଟ୍ ହୁଏ ନାହିଁ। ପରେ ସେଠାରେ ଆପଣ ନିଷ୍ପତ୍ତି ନେବେ।"
