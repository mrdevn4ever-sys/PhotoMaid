    "vid_estimate_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقدير تقريبي فقط. سترى الحجم الفعلي بعد الحفظ."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু একটি মোটামুটি অনুমান। সংরক্ষণের পরে আসল ফাইলের আকার দেখবেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Només és una estimació aproximada. Veuràs la mida real del fitxer després de desar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jen hrubý odhad. Skutečnou velikost souboru uvidíte po uložení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun et groft skøn. Den rigtige filstørrelse ser du efter gemning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur ungefähr. Wie groß die Datei wirklich wird, siehst du nach dem Speichern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόνο πρόχειρη εκτίμηση. Θα δεις το πραγματικό μέγεθος αρχείου μετά την αποθήκευση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only a rough guess. You’ll see the real file size after saving."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo es aproximado. Verás el tamaño real después de guardar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain karkea arvio. Näet todellisen tiedostokoon tallennuksen jälkeen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est seulement une estimation. Vous verrez la vraie taille après l’enregistrement."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફક્ત સ્થૂળ અંદાજ. સાચું ફાઇલ કદ સાચવ્યા પછી દેખાશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רק הערכה גסה. את גודל הקובץ האמיתי רואים אחרי השמירה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिर्फ़ मोटा अनुमान। असली फ़ाइल साइज़ सहेजने के बाद दिखेगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo gruba procjena. Stvarnu veličinu datoteke vidjet ćeš nakon spremanja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak durva becslés. A valódi fájlméretet mentés után látod."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya perkiraan kasar. Kamu akan melihat ukuran file sebenarnya setelah menyimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È solo una stima. La dimensione reale la vedi dopo il salvataggio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "おおよその目安です。実際のサイズは保存後にわかります。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕೇವಲ ಒರಟು ಅಂದಾಜು. ಉಳಿಸಿದ ನಂತರ ನಿಜವಾದ ಫೈಲ್ ಗಾತ್ರ ಕಾಣುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대략적인 크기예요. 실제 크기는 저장한 뒤 확인할 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരു ഏകദേശ കണക്ക് മാത്രം. സംരക്ഷിച്ച ശേഷം യഥാർത്ഥ ഫയൽ വലുപ്പം കാണാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फक्त ढोबळ अंदाज. खरा फाइल आकार जतन केल्यानंतर दिसेल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya anggaran kasar. Anda akan melihat saiz fail sebenar selepas menyimpan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare et grovt anslag. Den faktiske filstørrelsen ser du etter lagring."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen een schatting. De echte grootte zie je na het opslaan."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "କେବଳ ଏକ ମୋଟାମୋଟି ଅନୁମାନ। ସେଭ୍ ପରେ ଆପଣ ପ୍ରକୃତ ଫାଇଲ୍ ଆକାର ଦେଖିବେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਿਰਫ਼ ਇੱਕ ਮੋਟਾ ਅੰਦਾਜ਼ਾ। ਅਸਲ ਫ਼ਾਈਲ ਆਕਾਰ ਤੁਹਾਨੂੰ ਸੰਭਾਲਣ ਤੋਂ ਬਾਅਦ ਦਿਸੇਗਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To tylko przybliżenie. Rzeczywisty rozmiar zobaczysz po zapisaniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só uma estimativa aproximada. Você verá o tamanho real do arquivo depois de salvar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "É apenas uma estimativa. Verá o tamanho real depois de guardar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar aproximativ. Mărimea reală o vezi după salvare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это лишь примерная оценка. Точный размер вы увидите после сохранения."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Len hrubý odhad. Skutočnú veľkosť súboru uvidíte po uložení."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Le groba ocena. Pravo velikost datoteke vidiš po shranjevanju."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara en grov uppskattning. Den verkliga filstorleken ser du efter sparandet."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தோராயமான மதிப்பீடு மட்டுமே. சேமித்த பின் உண்மையான கோப்பு அளவைக் காண்பீர்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కేవలం స్థూల అంచనా. సేవ్ చేసిన తర్వాత అసలు ఫైల్ పరిమాణం కనిపిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เป็นเพียงการประมาณคร่าวๆ คุณจะเห็นขนาดไฟล์จริงหลังบันทึก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca yaklaşık. Gerçek boyutu kaydettikten sonra görürsün."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це лише приблизно. Справжній розмір ви побачите після збереження."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف موٹا اندازہ۔ اصل فائل سائز محفوظ کرنے کے بعد دکھے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ là ước tính sơ bộ. Bạn sẽ thấy kích thước thật sau khi lưu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这只是大致估算。保存后可看到实际大小。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只是粗略估計。儲存後才會看到實際檔案大小。"
          }
        }
      }
    },
