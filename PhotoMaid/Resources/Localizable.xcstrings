    "export_bg_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستمر حتى إذا انتقلت إلى تطبيق آخر."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsætter, hvis du skifter app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Läuft weiter, auch wenn du die App wechselst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps running if you switch apps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue aunque cambies de app."
          }
        },
        "fr": {
