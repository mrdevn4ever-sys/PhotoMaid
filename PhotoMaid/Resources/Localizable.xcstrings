    "viewer_controls_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على الصورة أو الفيديو لإظهار عناصر التحكم أو إخفائها."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på fotoet eller videoen for at vise eller skjule betjeningen."
