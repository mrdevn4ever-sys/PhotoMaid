    "summary_basket_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن يُحذف شيء حتى تفرغ سلة المهملات وتؤكد ذلك."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet slettes, før du tømmer papirkurven og bekræfter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelöscht wird erst, wenn du den Papierkorb leerst und bestätigst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is deleted until you empty the trash and confirm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se borra nada hasta que vacíes la papelera y confirmes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’est supprimé avant que tu vides la corbeille et confirmes."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada yang dihapus sampai kamu mengosongkan sampah dan konfirmasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nulla viene eliminato finché non svuoti il cestino e confermi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴミ箱を空にして確認するまで、何も削除されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통을 비우고 확인하기 전에는 아무것도 삭제되지 않아요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting slettes før du tømmer papirkurven og bekrefter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wordt pas iets verwijderd als je de prullenbak leegt en bevestigt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie zostanie usunięte, dopóki nie opróżnisz kosza i nie potwierdzisz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada é apagado até você esvaziar a lixeira e confirmar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada é eliminado até esvaziares o lixo e confirmares."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimic nu este șters până nu golești coșul și confirmi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего не удаляется, пока ты не очистишь корзину и не подтвердишь действие."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget raderas förrän du tömmer papperskorgen och bekräftar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีอะไรถูกลบจนกว่าคุณจะล้างถังขยะและยืนยัน"
