    "excl_confirm_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن تظهر عناصر هذا الألبوم أثناء الترتيب بعد الآن. لا يُحذف أو يُنقل أي شيء. للتراجع: الإعدادات › الألبومات المستبعدة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Emner i dette album vises ikke længere, når du rydder op. Intet slettes eller flyttes. Fortryd under Indstillinger › Udeladte albummer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos und Videos aus diesem Album erscheinen nicht mehr beim Aufräumen. Nichts wird gelöscht oder verschoben. Rückgängig in Einstellungen › Ausgenommene Alben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Items in this album will no longer appear while cleaning up. Nothing is deleted or moved. Undo in Settings › Excluded albums."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los elementos de este álbum ya no aparecerán al ordenar. No se borra ni se mueve nada. Puedes deshacerlo en Ajustes › Álbumes excluidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les éléments de cet album n’apparaîtront plus pendant le tri. Rien n’est supprimé ni déplacé. Annulable dans Réglages › Albums exclus."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Item di album ini tidak akan muncul lagi saat merapikan. Tidak ada yang dihapus atau dipindah. Urungkan di Pengaturan › Album yang dikecualikan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli elementi di questo album non compariranno più durante il riordino. Nulla viene eliminato o spostato. Annulla in Impostazioni › Album esclusi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアルバムの項目は整理中に表示されなくなります。削除も移動もされません。元に戻すには 設定 › 除外したアルバム。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앨범의 항목은 더 이상 정리 중에 표시되지 않습니다. 삭제되거나 이동되는 것은 없습니다. 설정 › 제외된 앨범에서 되돌릴 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Elementer i dette albumet vises ikke lenger når du rydder. Ingenting slettes eller flyttes. Angre under Innstillinger › Utelatte album."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Items uit dit album verschijnen niet meer tijdens het opruimen. Er wordt niets verwijderd of verplaatst. Terugdraaien via Instellingen › Uitgesloten albums."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elementy z tego albumu nie będą już pojawiać się podczas porządkowania. Nic nie zostanie usunięte ani przeniesione. Cofniesz to w Ustawienia › Wykluczone albumy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os itens deste álbum não aparecerão mais durante a limpeza. Nada é apagado nem movido. Desfaça em Ajustes › Álbuns excluídos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os itens deste álbum deixam de aparecer ao arrumar. Nada é apagado nem movido. Anule em Definições › Álbuns excluídos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Elementele din acest album nu vor mai apărea la ordonare. Nimic nu este șters sau mutat. Anulezi din Configurări › Albume excluse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Объекты из этого альбома больше не будут появляться при уборке. Ничего не удаляется и не перемещается. Отменить: Настройки › Исключённые альбомы."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Objekt i det här albumet visas inte längre när du rensar. Inget raderas eller flyttas. Ångra i Inställningar › Undantagna album."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการในอัลบั้มนี้จะไม่ปรากฏขณะจัดระเบียบอีก ไม่มีอะไรถูกลบหรือย้าย เลิกทำได้ในการตั้งค่า › อัลบั้มที่ยกเว้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu albümdeki öğeler temizlik sırasında artık görünmez. Hiçbir şey silinmez veya taşınmaz. Geri almak için Ayarlar › Hariç tutulan albümler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Об’єкти з цього альбому більше не з’являтимуться під час прибирання. Нічого не видаляється й не переміщується. Скасувати: Налаштування › Виключені альбоми."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các mục trong album này sẽ không còn xuất hiện khi dọn dẹp. Không có gì bị xóa hoặc di chuyển. Hoàn tác trong Cài đặt › Album bị loại trừ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此相簿中的项目将不再在整理时出现。不会删除或移动任何内容。可在“设置 › 已排除的相簿”中撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "整理時將不再顯示這個相簿中的項目。不會刪除或移動任何內容。可在「設定 › 排除的相簿」中還原。"
          }
        }
      }
    },
    "excl_confirm_title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إخفاء «%1$@» أثناء الترتيب؟"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjul “%1$@”, når du rydder op?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ beim Aufräumen ausblenden?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide “%1$@” while cleaning up?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Ocultar «%1$@» al ordenar?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquer « %1$@ » pendant le tri ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sembunyikan “%1$@” saat merapikan?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nascondere «%1$@» durante il riordino?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "整理時に「%1$@」を非表示にしますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정리할 때 ‘%1$@’을(를) 숨길까요?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjule «%1$@» når du rydder?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%1$@’ verbergen tijdens het opruimen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukryć „%1$@” podczas porządkowania?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar “%1$@” durante a limpeza?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar “%1$@” ao arrumar?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ascunzi „%1$@” la ordonare?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрыть «%1$@» при наведении порядка?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dölj ”%1$@” när du rensar?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ซ่อน “%1$@” ขณะจัดระเบียบใช่ไหม?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düzenlerken “%1$@” gizlensin mi?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Приховати «%1$@» під час упорядкування?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ẩn “%1$@” khi dọn dẹp?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "整理时隐藏“%1$@”？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要在整理時隱藏「%1$@」嗎？"
          }
        }
      }
    },
