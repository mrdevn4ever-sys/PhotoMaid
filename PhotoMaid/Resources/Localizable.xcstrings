          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action ne peut pas être annulée pour le moment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al momento non puoi annullare questa azione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 실행을 취소할 수 없어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit kan nu niet ongedaan worden gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można teraz cofnąć tego działania."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível anular esta ação de momento."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această acțiune nu poate fi anulată acum."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас это действие нельзя отменить."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem şu anda geri alınamıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зараз цю дію не можна скасувати."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法撤销。"
          }
        }
      }
    },
