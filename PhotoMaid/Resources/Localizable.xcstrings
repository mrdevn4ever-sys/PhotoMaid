    "help_delete_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يؤدي السحب إلى حذف أي شيء. تنتقل العناصر أولاً إلى سلة PhotoMaid، وبعد تأكيدك ينقلها iOS إلى «المحذوفة مؤخراً»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Wischen wird nie etwas gelöscht. Medien landen zuerst im PhotoMaid-Papierkorb. Erst nach deiner Bestätigung verschiebt iOS Fotos und Videos in ‚Zuletzt gelöscht‘."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swiping never deletes anything. Items first enter PhotoMaid’s trash. Only after you confirm there does iOS move photos and videos to Recently Deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslizar nunca elimina nada. Los elementos van primero a la papelera de PhotoMaid; tras confirmarlo, iOS los mueve a Eliminado recientemente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un balayage ne supprime rien. Les éléments vont d’abord dans la corbeille PhotoMaid ; après confirmation, iOS les place dans Suppressions récentes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo scorrimento non elimina nulla. Gli elementi vanno prima nel cestino PhotoMaid; dopo la conferma iOS li sposta in Eliminati di recente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スワイプだけでは削除されません。まずPhotoMaidのゴミ箱に入り、確認後にiOSの「最近削除した項目」へ移動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쓸어 넘기기만으로 삭제되지 않습니다. 먼저 PhotoMaid 휴지통에 들어가며 확인 후 iOS의 최근 삭제된 항목으로 이동합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vegen verwijdert niets. Items gaan eerst naar de PhotoMaid-prullenbak; na bevestiging verplaatst iOS ze naar Recent verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesunięcie niczego nie usuwa. Elementy trafiają najpierw do kosza PhotoMaid; po potwierdzeniu iOS przenosi je do Ostatnio usuniętych."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslizar não elimina nada. Os itens vão primeiro para o lixo do PhotoMaid; após confirmar, o iOS move-os para Apagados recentemente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Glisarea nu șterge nimic. Elementele ajung întâi în coșul PhotoMaid; după confirmare, iOS le mută în Șterse recent."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смахивание ничего не удаляет. Объекты сначала попадают в корзину PhotoMaid; после подтверждения iOS перемещает их в «Недавно удалённые»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydırma hiçbir şeyi silmez. Öğeler önce PhotoMaid çöpüne gider; onaydan sonra iOS onları Son Silinenler’e taşır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гортання нічого не видаляє. Об’єкти спочатку потрапляють у кошик PhotoMaid; після підтвердження iOS переміщує їх у «Недавно видалені»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻扫不会删除任何内容。项目会先进入 PhotoMaid 废纸篓，确认后 iOS 才会将其移到“最近删除”。"
          }
        }
      }
    },
