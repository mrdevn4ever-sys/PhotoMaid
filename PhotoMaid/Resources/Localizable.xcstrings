          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún archivo accesible de tamaño conocido supera los %1$lld MB."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikään käytettävissä oleva tunnetun kokoinen tiedosto ei ole yli %1$lld Mt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
