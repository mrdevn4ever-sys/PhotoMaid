    "export_expired": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنهى iOS التصدير في الخلفية. لم يُحفظ شيء – ابدأه من جديد وأبقِ GaleriQ مفتوحًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ব্যাকগ্রাউন্ডে এক্সপোর্ট থামিয়ে দিয়েছে। কিছুই সংরক্ষিত হয়নি – আবার শুরু করুন এবং GaleriQ খোলা রাখুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’iOS ha aturat l’exportació en segon pla. No s’ha desat res: torna-la a iniciar i deixa GaleriQ obert."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ukončil export na pozadí. Nic nebylo uloženo – spusťte ho znovu a nechte GaleriQ otevřený."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS afsluttede eksporten i baggrunden. Intet blev gemt – start igen, og hold GaleriQ åben."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS hat den Export im Hintergrund beendet. Es wurde nichts gespeichert – starte ihn erneut und lass GaleriQ geöffnet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το iOS τερμάτισε την εξαγωγή στο παρασκήνιο. Δεν αποθηκεύτηκε τίποτα – ξεκίνησέ τη ξανά και κράτα το GaleriQ ανοιχτό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ended the export in the background. Nothing was saved – start it again and keep GaleriQ open."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ha detenido la exportación en segundo plano. No se ha guardado nada: vuelve a empezar y deja GaleriQ abierta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS lopetti viennin taustalla. Mitään ei tallennettu – aloita se uudelleen ja pidä GaleriQ auki."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS a arrêté l’export en arrière-plan. Rien n’a été enregistré – relancez-le et laissez GaleriQ ouverte."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS એ પૃષ્ઠભૂમિમાં એક્સપોર્ટ બંધ કર્યું. કંઈ સચવાયું નથી – તેને ફરી શરૂ કરો અને GaleriQ ખુલ્લું રાખો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS עצרה את הייצוא ברקע. שום דבר לא נשמר – יש להתחיל שוב ולהשאיר את GaleriQ פתוחה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ने बैकग्राउंड में एक्सपोर्ट रोक दिया। कुछ भी सहेजा नहीं गया – इसे फिर शुरू करें और GaleriQ खुला रखें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS je prekinuo izvoz u pozadini. Ništa nije spremljeno – pokreni ga ponovno i ostavi GaleriQ otvoren."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az iOS leállította az exportálást a háttérben. Semmi sem lett mentve – indítsd újra, és hagyd nyitva a GaleriQ-t."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS menghentikan ekspor di latar belakang. Tidak ada yang disimpan – mulai lagi dan biarkan GaleriQ tetap terbuka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ha interrotto l’esportazione in background. Non è stato salvato nulla: riavviala e lascia GaleriQ aperta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOSがバックグラウンドで書き出しを終了しました。何も保存されていません。もう一度開始し、GaleriQを開いたままにしてください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ಹಿನ್ನೆಲೆಯಲ್ಲಿ ಎಕ್ಸ್‌ಪೋರ್ಟ್ ನಿಲ್ಲಿಸಿದೆ. ಏನನ್ನೂ ಉಳಿಸಲಾಗಿಲ್ಲ – ಮತ್ತೆ ಪ್ರಾರಂಭಿಸಿ ಮತ್ತು GaleriQ ತೆರೆದಿಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS가 백그라운드에서 내보내기를 종료했습니다. 아무것도 저장되지 않았습니다. 다시 시작하고 GaleriQ를 열어 두세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS പശ്ചാത്തലത്തിൽ എക്‌സ്‌പോർട്ട് അവസാനിപ്പിച്ചു. ഒന്നും സംരക്ഷിച്ചില്ല – വീണ്ടും ആരംഭിച്ച് GaleriQ തുറന്നുവയ്ക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ने पार्श्वभूमीत एक्सपोर्ट थांबवली. काहीही जतन झाले नाही – पुन्हा सुरू करा आणि GaleriQ उघडे ठेवा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS menamatkan eksport di latar belakang. Tiada apa disimpan – mulakan semula dan biarkan GaleriQ terbuka."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS avsluttet eksporten i bakgrunnen. Ingenting ble lagret – start på nytt og hold GaleriQ åpen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS heeft de export op de achtergrond beëindigd. Er is niets bewaard – start opnieuw en houd GaleriQ open."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ପୃଷ୍ଠଭୂମିରେ ଏକ୍ସପୋର୍ଟ ବନ୍ଦ କଲା। କିଛି ସେଭ୍ ହୋଇନାହିଁ – ପୁଣି ଆରମ୍ଭ କରନ୍ତୁ ଏବଂ GaleriQ ଖୋଲା ରଖନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ਨੇ ਪਿਛੋਕੜ ਵਿੱਚ ਐਕਸਪੋਰਟ ਬੰਦ ਕਰ ਦਿੱਤਾ। ਕੁਝ ਨਹੀਂ ਸੰਭਾਲਿਆ ਗਿਆ – ਇਸ ਨੂੰ ਦੁਬਾਰਾ ਸ਼ੁਰੂ ਕਰੋ ਅਤੇ GaleriQ ਖੁੱਲ੍ਹਾ ਰੱਖੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS zakończył eksport w tle. Nic nie zapisano – uruchom go ponownie i nie zamykaj GaleriQ."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iOS encerrou a exportação em segundo plano. Nada foi salvo – comece de novo e mantenha o GaleriQ aberto."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O iOS terminou a exportação em segundo plano. Nada foi guardado – comece de novo e mantenha o GaleriQ aberto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS a oprit exportul în fundal. Nu s-a salvat nimic – pornește-l din nou și lasă GaleriQ deschisă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS прервал экспорт в фоне. Ничего не сохранено – запустите заново и не закрывайте GaleriQ."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ukončil export na pozadí. Nič nebolo uložené – spustite ho znova a nechajte GaleriQ otvorený."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS je končal izvoz v ozadju. Nič ni bilo shranjeno – zaženi ga znova in pusti GaleriQ odprt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS avslutade exporten i bakgrunden. Inget sparades – starta igen och håll GaleriQ öppen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS பின்னணியில் ஏற்றுமதியை நிறுத்தியது. எதுவும் சேமிக்கப்படவில்லை – மீண்டும் தொடங்கி GaleriQ-ஐத் திறந்தே வையுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS బ్యాక్‌గ్రౌండ్‌లో ఎక్స్‌పోర్ట్‌ను ఆపేసింది. ఏదీ సేవ్ కాలేదు – మళ్లీ ప్రారంభించి GaleriQను తెరిచి ఉంచండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS หยุดการส่งออกในเบื้องหลัง ไม่มีอะไรถูกบันทึก – เริ่มใหม่และเปิด GaleriQ ค้างไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS dışa aktarmayı arka planda sonlandırdı. Hiçbir şey kaydedilmedi; yeniden başlat ve GaleriQ’i açık tut."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS перервав експорт у фоні. Нічого не збережено – запустіть знову й не закривайте GaleriQ."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS نے پس منظر میں ایکسپورٹ روک دیا۔ کچھ بھی محفوظ نہیں ہوا – اسے دوبارہ شروع کریں اور GaleriQ کھلا رکھیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS đã dừng việc xuất trong nền. Không có gì được lưu – hãy bắt đầu lại và giữ GaleriQ mở."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 在后台结束了导出。未存储任何内容 – 请重新开始并保持 GaleriQ 打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 在背景結束了輸出。沒有儲存任何內容 – 請重新開始，並保持 GaleriQ 開啟。"
          }
        }
      }
    },
    "export_keep_open": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك الانتقال إلى تطبيق آخر لفترة قصيرة. إذا أنهى iOS الوقت، يتوقف GaleriQ بشكل سليم ولا يُحفظ شيء غير مكتمل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি কিছুক্ষণের জন্য অন্য অ্যাপে যেতে পারেন। iOS সময় শেষ করে দিলে GaleriQ পরিচ্ছন্নভাবে থেমে যায় – অর্ধেক কিছুই সংরক্ষিত হয় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Pots canviar una estona a una altra app. Si l’iOS esgota el temps, GaleriQ s’atura correctament: no es desa res a mitges."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Můžete krátce přepnout do jiné aplikace. Pokud iOS čas ukončí, GaleriQ se čistě zastaví – nic napůl hotového se neuloží."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan kort skifte til en anden app. Hvis iOS afslutter tiden, stopper GaleriQ pænt – intet halvfærdigt gemmes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst kurz in eine andere App wechseln. Beendet iOS die Zeit, bricht GaleriQ sauber ab – es wird nichts Halbes gespeichert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείς να πας για λίγο σε άλλη εφαρμογή. Αν το iOS τερματίσει τον χρόνο, το GaleriQ σταματά σωστά – τίποτα μισοτελειωμένο δεν αποθηκεύεται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can briefly switch to another app. If iOS ends the time, GaleriQ stops cleanly – nothing half-finished is saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes cambiar un momento a otra app. Si iOS agota el tiempo, GaleriQ se detiene sin problemas y no se guarda nada a medias."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit hetkeksi vaihtaa toiseen appiin. Jos iOS lopettaa ajan, GaleriQ pysähtyy siististi – mitään keskeneräistä ei tallenneta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez passer brièvement à une autre app. Si iOS met fin au délai, GaleriQ s’arrête proprement – rien d’inachevé n’est enregistré."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે થોડી વાર માટે બીજી ઍપ પર જઈ શકો છો. જો iOS સમય પૂરો કરે, તો GaleriQ વ્યવસ્થિત રીતે અટકે છે – અધૂરું કંઈ સચવાતું નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר לעבור לרגע ליישום אחר. אם iOS מסיימת את הזמן, GaleriQ נעצרת בצורה מסודרת – שום דבר חצי גמור לא נשמר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप थोड़ी देर के लिए दूसरे ऐप पर जा सकते हैं। अगर iOS समय खत्म कर दे, तो GaleriQ ठीक से रुक जाता है – कुछ भी अधूरा सहेजा नहीं जाता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Možeš nakratko prijeći u drugu aplikaciju. Ako iOS prekine vrijeme, GaleriQ se uredno zaustavlja – ništa napola gotovo ne sprema se."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Rövid időre átválthatsz egy másik appra. Ha az iOS lejártatja az időt, a GaleriQ szabályosan leáll – félkész semmi sem mentődik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu bisa berpindah sebentar ke app lain. Jika iOS mengakhiri waktunya, GaleriQ berhenti dengan rapi – tidak ada yang setengah jadi disimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi passare per poco a un’altra app. Se iOS esaurisce il tempo, GaleriQ si ferma in modo pulito e non salva nulla a metà."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "少しの間ならほかのアプリに切り替えられます。iOSが時間を打ち切った場合、GaleriQは安全に中止し、途中までのものは保存しません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ವಲ್ಪ ಸಮಯ ಇನ್ನೊಂದು ಆ್ಯಪ್‌ಗೆ ಹೋಗಬಹುದು. iOS ಸಮಯ ಮುಗಿಸಿದರೆ GaleriQ ಸ್ವಚ್ಛವಾಗಿ ನಿಲ್ಲುತ್ತದೆ – ಅರ್ಧ ಮುಗಿದ ಏನನ್ನೂ ಉಳಿಸಲಾಗುವುದಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠시 다른 앱으로 전환해도 됩니다. iOS가 시간을 종료하면 GaleriQ는 깔끔하게 중단하며 반쯤 된 결과는 저장하지 않습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അൽപ്പനേരം മറ്റൊരു ആപ്പിലേക്ക് മാറാം. iOS സമയം അവസാനിപ്പിച്ചാൽ GaleriQ വൃത്തിയായി നിർത്തും – പാതി പൂർത്തിയായ ഒന്നും സംരക്ഷിക്കില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही थोड्या वेळासाठी दुसऱ्या अ‍ॅपवर जाऊ शकता. iOS ने वेळ संपवल्यास GaleriQ व्यवस्थित थांबते – अर्धवट काहीही जतन होत नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda boleh bertukar ke app lain sebentar. Jika iOS menamatkan masa, GaleriQ berhenti dengan kemas – tiada apa yang separuh siap disimpan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan kort bytte til en annen app. Hvis iOS avslutter tiden, stopper GaleriQ ryddig – ingenting halvferdig lagres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt even naar een andere app gaan. Beëindigt iOS de tijd, dan stopt GaleriQ netjes – er wordt niets half bewaard."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣ କିଛି ସମୟ ପାଇଁ ଅନ୍ୟ ଆପ୍‌କୁ ଯାଇପାରିବେ। iOS ସମୟ ଶେଷ କଲେ GaleriQ ପରିଚ୍ଛନ୍ନ ଭାବେ ବନ୍ଦ ହୁଏ – ଅଧା କାମ କିଛି ସେଭ୍ ହୁଏ ନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਸੀਂ ਥੋੜ੍ਹੀ ਦੇਰ ਲਈ ਕਿਸੇ ਹੋਰ ਐਪ ’ਤੇ ਜਾ ਸਕਦੇ ਹੋ। ਜੇ iOS ਸਮਾਂ ਖ਼ਤਮ ਕਰ ਦਿੰਦਾ ਹੈ, ਤਾਂ GaleriQ ਸਾਫ਼-ਸੁਥਰੇ ਢੰਗ ਨਾਲ ਰੁਕ ਜਾਂਦਾ ਹੈ – ਕੁਝ ਵੀ ਅੱਧਾ-ਅਧੂਰਾ ਨਹੀਂ ਸੰਭਾਲਿਆ ਜਾਂਦਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz na chwilę przejść do innej aplikacji. Jeśli iOS zakończy czas, GaleriQ przerwie bezpiecznie – nic niedokończonego nie zostanie zapisane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode trocar rapidamente para outro app. Se o iOS encerrar o tempo, o GaleriQ para de forma limpa – nada pela metade é salvo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode mudar por pouco tempo para outra app. Se o iOS terminar o tempo, o GaleriQ para em segurança – nada incompleto é guardado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Poți trece scurt în altă aplicație. Dacă iOS încheie timpul, GaleriQ se oprește curat – nu se salvează nimic pe jumătate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно ненадолго переключиться на другое приложение. Если iOS прервёт время, GaleriQ аккуратно остановится – ничего недоделанного не сохранится."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Môžete krátko prepnúť do inej aplikácie. Ak iOS čas ukončí, GaleriQ sa čisto zastaví – nič napoly hotové sa neuloží."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za kratek čas lahko preklopiš v drugo aplikacijo. Če iOS čas prekine, se GaleriQ čisto ustavi – nič napol narejenega se ne shrani."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan kort byta till en annan app. Om iOS avslutar tiden stoppar GaleriQ snyggt – inget halvfärdigt sparas."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சிறிது நேரம் வேறொரு ஆப்பிற்கு மாறலாம். iOS நேரத்தை முடித்தால், GaleriQ சுத்தமாக நிற்கும் – பாதி முடிந்த எதுவும் சேமிக்கப்படாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కాసేపు మరో యాప్‌కి వెళ్లవచ్చు. iOS సమయం ముగిస్తే GaleriQ సురక్షితంగా ఆగుతుంది – సగం పూర్తయినది ఏదీ సేవ్ కాదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณสลับไปแอพอื่นได้สักครู่ หาก iOS หมดเวลา GaleriQ จะหยุดอย่างเรียบร้อย – ไม่มีอะไรที่ทำค้างไว้ถูกบันทึก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kısa süreliğine başka bir uygulamaya geçebilirsin. iOS süreyi sonlandırırsa GaleriQ düzgünce durur, yarım kalan hiçbir şey kaydedilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Можна ненадовго перейти до іншої програми. Якщо iOS завершить час, GaleriQ акуратно зупиниться – нічого незавершеного не збережеться."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ تھوڑی دیر کے لیے دوسری ایپ پر جا سکتے ہیں۔ اگر iOS وقت ختم کر دے تو GaleriQ صاف طریقے سے رک جاتا ہے – کچھ بھی ادھورا محفوظ نہیں ہوتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
