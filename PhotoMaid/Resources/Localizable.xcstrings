        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認済みのコピーだけが有効です。違いがあったコピーはすぐに削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인된 사본만 인정돼요. 다른 사본은 바로 지워요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Only checked copies count. If one differs, it is removed right away."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen gecontroleerde kopieën tellen. Wijkt er een af, dan wordt die meteen weer verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Liczą się tylko sprawdzone kopie. Jeśli któraś się różni, zostaje od razu usunięta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
