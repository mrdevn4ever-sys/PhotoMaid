    "result_reconcile": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سنتحقق من النتيجة عند فتح التطبيق مجددًا. لن يُحذف أي شيء مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পরের বার অ্যাপ খুললে আমরা ফলাফল যাচাই করব। কিছুই আবার মুছে ফেলা হবে না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprovarem el resultat la pròxima vegada que obris l’app. No es tornarà a esborrar res."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Výsledek zkontrolujeme při příštím otevření aplikace. Nic se znovu mazat nebude."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi tjekker resultatet, næste gang du åbner appen. Intet slettes igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim nächsten Start prüfen wir das Ergebnis. Es wird nichts erneut gelöscht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θα ελέγξουμε το αποτέλεσμα την επόμενη φορά που θα ανοίξεις την εφαρμογή. Τίποτα δεν θα διαγραφεί ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We’ll check the result next time you open the app. Nothing will be deleted again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprobaremos el resultado la próxima vez que abras la app. No se volverá a borrar nada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarkistamme tuloksen, kun avaat apin seuraavan kerran. Mitään ei poisteta uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous vérifierons le résultat à la prochaine ouverture. Rien ne sera supprimé une seconde fois."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આગલી વાર ઍપ ખોલશો ત્યારે અમે પરિણામ તપાસીશું. કંઈ ફરી ડિલીટ નહીં થાય."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נבדוק את התוצאה בפעם הבאה שהיישום ייפתח. שום דבר לא יימחק שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगली बार ऐप खोलने पर हम नतीजा जाँचेंगे। कुछ भी दोबारा डिलीट नहीं होगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezultat ćemo provjeriti sljedeći put kad otvoriš aplikaciju. Ništa se neće ponovno brisati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az eredményt az app következő megnyitásakor ellenőrizzük. Semmi sem törlődik újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami akan memeriksa hasilnya saat kamu membuka app lagi. Tidak ada yang akan dihapus lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificheremo il risultato alla prossima apertura. Nulla verrà eliminato una seconda volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次回アプリを開いたときに結果を確認します。同じ削除を繰り返すことはありません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮುಂದಿನ ಬಾರಿ ಆ್ಯಪ್ ತೆರೆದಾಗ ನಾವು ಫಲಿತಾಂಶ ಪರಿಶೀಲಿಸುತ್ತೇವೆ. ಏನನ್ನೂ ಮತ್ತೆ ಅಳಿಸಲಾಗುವುದಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음에 앱을 열 때 결과를 확인해요. 같은 삭제 작업을 반복하지 않아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അടുത്ത തവണ ആപ്പ് തുറക്കുമ്പോൾ ഞങ്ങൾ ഫലം പരിശോധിക്കും. ഒന്നും വീണ്ടും ഇല്ലാതാക്കില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पुढच्या वेळी अ‍ॅप उघडल्यावर आम्ही निकाल तपासू. काहीही पुन्हा डिलीट होणार नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami akan menyemak hasilnya apabila anda membuka app lain kali. Tiada apa akan dipadam semula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi sjekker resultatet neste gang du åpner appen. Ingenting slettes på nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We controleren het resultaat bij de volgende start. Er wordt niets opnieuw verwijderd."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପରବର୍ତ୍ତୀ ଥର ଆପ୍ ଖୋଲିଲେ ଆମେ ଫଳାଫଳ ଯାଞ୍ଚ କରିବୁ। କିଛି ପୁଣି ଡିଲିଟ୍ ହେବ ନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਅਸੀਂ ਅਗਲੀ ਵਾਰ ਐਪ ਖੋਲ੍ਹਣ ’ਤੇ ਨਤੀਜਾ ਜਾਂਚਾਂਗੇ। ਕੁਝ ਵੀ ਦੁਬਾਰਾ ਨਹੀਂ ਮਿਟਾਇਆ ਜਾਵੇਗਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdzimy wynik przy następnym uruchomieniu. Nic nie zostanie usunięte ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vamos conferir o resultado na próxima vez que você abrir o app. Nada será apagado de novo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificaremos o resultado na próxima abertura. Nada será eliminado novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vom verifica rezultatul la următoarea deschidere. Nimic nu va fi șters din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверим результат при следующем запуске. Ничего не будет удалено повторно."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Výsledok skontrolujeme pri ďalšom otvorení aplikácie. Nič sa znova mazať nebude."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezultat bomo preverili, ko boš naslednjič odprl aplikacijo. Nič ne bo znova izbrisano."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi kontrollerar resultatet nästa gång du öppnar appen. Inget raderas igen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அடுத்த முறை ஆப்பைத் திறக்கும்போது முடிவைச் சரிபார்ப்போம். எதுவும் மீண்டும் நீக்கப்படாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "తదుపరిసారి యాప్ తెరిచినప్పుడు ఫలితాన్ని తనిఖీ చేస్తాం. ఏదీ మళ్లీ తొలగించబడదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เราจะตรวจสอบผลลัพธ์ในครั้งถัดไปที่คุณเปิดแอพ จะไม่มีอะไรถูกลบซ้ำ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonucu bir sonraki açılışta kontrol edeceğiz. Hiçbir şey yeniden silinmeyecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевіримо результат під час наступного запуску. Нічого не буде видалено повторно."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اگلی بار ایپ کھولنے پر ہم نتیجہ چیک کریں گے۔ کچھ بھی دوبارہ حذف نہیں ہو گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng tôi sẽ kiểm tra kết quả lần tới bạn mở ứng dụng. Sẽ không có gì bị xóa lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下次打开应用时会核对结果，不会重复删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下次打開 App 時我們會檢查結果。不會再次刪除任何內容。"
          }
        }
      }
    },
