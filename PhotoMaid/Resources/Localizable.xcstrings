    "wf_delete_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحذف سير العمل المحفوظ فقط. تبقى الملفات التي أنشأها."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Only the saved workflow is deleted. Files it already created stay."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur der gespeicherte Ablauf wird gelöscht. Bereits erstellte Dateien bleiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the saved workflow is deleted. Files it already created stay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se elimina el flujo guardado. Los archivos ya creados se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul le flux enregistré est supprimé. Les fichiers déjà créés restent."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Only the saved workflow is deleted. Files it already created stay."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Viene eliminato solo il flusso salvato. I file già creati restano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存したワークフローだけが削除されます。作成済みのファイルは残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 작업 흐름만 삭제돼요. 이미 만든 파일은 남아요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Only the saved workflow is deleted. Files it already created stay."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen de opgeslagen werkstroom wordt verwijderd. Al gemaakte bestanden blijven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuwany jest tylko zapisany przepływ. Utworzone pliki zostają."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Only the saved workflow is deleted. Files it already created stay."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Só o fluxo guardado é eliminado. Os ficheiros já criados mantêm-se."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se șterge doar fluxul salvat. Fișierele create rămân."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляется только сохранённый сценарий. Созданные файлы остаются."
          }
        },
        "sv": {
