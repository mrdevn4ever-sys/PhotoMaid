    "onb_safe_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنتقل العناصر أولاً إلى سلة GaleriQ. تؤكد الإزالة هناك، ويسألك iOS مرة أخرى قبل نقل الصور والفيديوهات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আইটেম আগে GaleriQ-এর ট্র্যাশে যায়। সেখানে আপনি সরানো নিশ্চিত করেন, এবং ফটো ও ভিডিও “সম্প্রতি মুছে ফেলা”-তে সরানোর আগে iOS আবার জিজ্ঞেস করে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Primer, els elements van a la paperera de GaleriQ. Allà confirmes l’eliminació, i l’iOS torna a preguntar abans de moure les fotos i els vídeos a Eliminat recentment."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Položky nejdřív jdou do koše GaleriQ. Tam odstranění potvrdíte a iOS se ještě jednou zeptá, než přesune fotky a videa do Nedávno smazaných."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Emner havner først i GaleriQ-papirkurven. Der bekræfter du fjernelsen, og iOS spørger igen, før fotos og videoer flyttes til Senest slettet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Medien landen zuerst im GaleriQ-Papierkorb. Dort bestätigst du das Entfernen; iOS fragt vor ‚Zuletzt gelöscht‘ noch einmal nach."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα στοιχεία πάνε πρώτα στον κάδο του GaleriQ. Εκεί επιβεβαιώνεις την αφαίρεση και το iOS ρωτά ξανά πριν μετακινήσει φωτογραφίες και βίντεο στα Πρόσφατα διαγραμμένα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Items first go to GaleriQ’s trash. You confirm removal there, and iOS asks again before moving photos and videos to Recently Deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los elementos van primero a la papelera de GaleriQ. Confirmas allí y iOS vuelve a preguntar antes de mover fotos y vídeos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kohteet menevät ensin GaleriQ-roskakoriin. Vahvistat poiston siellä, ja iOS kysyy vielä ennen kuin siirtää kuvat ja videot kansioon Äskettäin poistetut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les éléments vont d’abord dans la corbeille GaleriQ. Vous confirmez, puis iOS redemande avant de déplacer photos et vidéos."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આઇટમ પહેલાં GaleriQ ટ્રેશમાં જાય છે. ત્યાં તમે દૂર કરવાની પુષ્ટિ કરો છો, અને ફોટા તથા વીડિયોને તાજેતરમાં ડિલીટ કરેલમાં ખસેડતા પહેલાં iOS ફરી પૂછે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפריטים עוברים קודם לפח של GaleriQ. שם מאשרים את ההסרה, ו-iOS שואלת שוב לפני שהיא מעבירה תמונות וסרטונים אל „נמחקו לאחרונה”."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आइटम पहले GaleriQ ट्रैश में जाते हैं। वहाँ आप हटाने की पुष्टि करते हैं, और फ़ोटो व वीडियो को हाल ही में डिलीट किए गए में ले जाने से पहले iOS फिर पूछता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stavke najprije idu u GaleriQ smeće. Ondje potvrđuješ uklanjanje, a iOS ponovno pita prije nego što premjesti fotografije i videozapise u Nedavno izbrisano."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az elemek először a GaleriQ kukájába kerülnek. Ott megerősíted az eltávolítást, és az iOS még egyszer rákérdez, mielőtt a fotókat és videókat a Nemrég törölt albumba helyezi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Item masuk dulu ke sampah GaleriQ. Kamu mengonfirmasi penghapusan di sana, dan iOS bertanya lagi sebelum memindahkan foto dan video ke Baru Dihapus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli elementi vanno prima nel cestino GaleriQ. Confermi lì e iOS chiede di nuovo prima di spostare foto e video."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まずGaleriQのゴミ箱に入ります。そこで確認し、写真やビデオを移動する前にiOSがもう一度確認します。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಐಟಂಗಳು ಮೊದಲು GaleriQ ಕಸದ ಬುಟ್ಟಿಗೆ ಹೋಗುತ್ತವೆ. ಅಲ್ಲಿ ನೀವು ತೆಗೆದುಹಾಕುವುದನ್ನು ದೃಢೀಕರಿಸುತ್ತೀರಿ, ಮತ್ತು ಫೋಟೋಗಳು ಹಾಗೂ ವೀಡಿಯೊಗಳನ್ನು “ಇತ್ತೀಚೆಗೆ ಅಳಿಸಲಾಗಿದೆ” ಗೆ ಸರಿಸುವ ಮೊದಲು iOS ಮತ್ತೆ ಕೇಳುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 GaleriQ 휴지통에 들어갑니다. 여기서 확인하면 사진과 비디오를 옮기기 전에 iOS가 다시 묻습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇനങ്ങൾ ആദ്യം GaleriQ ട്രാഷിലേക്ക് പോകും. അവിടെ നിങ്ങൾ നീക്കം ചെയ്യൽ സ്ഥിരീകരിക്കും, ഫോട്ടോകളും വീഡിയോകളും “അടുത്തിടെ ഇല്ലാതാക്കിയവ”-ലേക്ക് നീക്കുന്നതിന് മുമ്പ് iOS വീണ്ടും ചോദിക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आयटम आधी GaleriQ ट्रॅशमध्ये जातात. तिथे तुम्ही काढण्याची पुष्टी करता, आणि फोटो व व्हिडिओ अलीकडे डिलीट केलेले मध्ये हलवण्यापूर्वी iOS पुन्हा विचारते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Item masuk ke sampah GaleriQ dahulu. Anda mengesahkan pembuangan di sana, dan iOS bertanya sekali lagi sebelum mengalihkan foto dan video ke Dipadam Baru-baru Ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Elementer havner først i GaleriQ-papirkurven. Der bekrefter du fjerningen, og iOS spør igjen før bilder og videoer flyttes til Nylig slettet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Items gaan eerst naar de GaleriQ-prullenbak. Je bevestigt daar; iOS vraagt opnieuw voordat foto’s en video’s worden verplaatst."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆଇଟମ୍ ପ୍ରଥମେ GaleriQ ଟ୍ରାସକୁ ଯାଏ। ସେଠାରେ ଆପଣ ହଟାଇବା ନିଶ୍ଚିତ କରନ୍ତି, ଏବଂ ଫଟୋ ଓ ଭିଡିଓକୁ “ନିକଟରେ ଡିଲିଟ୍ ହୋଇଥିବା”କୁ ଘୁଞ୍ଚାଇବା ପୂର୍ବରୁ iOS ପୁଣି ପଚାରେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਆਈਟਮਾਂ ਪਹਿਲਾਂ GaleriQ ਦੀ ਰੱਦੀ ਵਿੱਚ ਜਾਂਦੀਆਂ ਹਨ। ਉੱਥੇ ਤੁਸੀਂ ਹਟਾਉਣ ਦੀ ਪੁਸ਼ਟੀ ਕਰਦੇ ਹੋ, ਅਤੇ ਫ਼ੋਟੋਆਂ ਅਤੇ ਵੀਡੀਓ ਨੂੰ “ਹਾਲ ਹੀ ਵਿੱਚ ਮਿਟਾਏ ਗਏ” ਵਿੱਚ ਭੇਜਣ ਤੋਂ ਪਹਿਲਾਂ iOS ਦੁਬਾਰਾ ਪੁੱਛਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elementy trafiają najpierw do kosza GaleriQ. Tam potwierdzasz; iOS pyta ponownie przed przeniesieniem zdjęć i filmów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os itens vão primeiro para a lixeira do GaleriQ. Você confirma a remoção lá, e o iOS pergunta de novo antes de mover fotos e vídeos para Apagados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os itens vão primeiro para o lixo do GaleriQ. Confirma aí; o iOS volta a perguntar antes de mover fotos e vídeos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Elementele ajung întâi în coșul GaleriQ. Confirmi acolo; iOS întreabă din nou înainte de a muta pozele și clipurile."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Объекты сначала попадают в корзину GaleriQ. Вы подтверждаете там; iOS спросит ещё раз перед перемещением фото и видео."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Položky najprv idú do koša GaleriQ. Tam odstránenie potvrdíte a iOS sa ešte raz opýta, kým presunie fotky a videá do Nedávno vymazaných."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elementi najprej gredo v koš GaleriQ. Tam potrdiš odstranitev, iOS pa znova vpraša, preden premakne fotografije in videoposnetke v Nedavno izbrisano."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Objekt hamnar först i GaleriQ-papperskorgen. Där bekräftar du borttagningen, och iOS frågar igen innan bilder och videor flyttas till Nyligen raderade."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உருப்படிகள் முதலில் GaleriQ குப்பைக்குச் செல்லும். அங்கே நீங்கள் அகற்றுவதை உறுதிப்படுத்துவீர்கள், புகைப்படங்களையும் வீடியோக்களையும் “சமீபத்தில் நீக்கியவை”-க்கு நகர்த்தும் முன் iOS மீண்டும் கேட்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అంశాలు ముందుగా GaleriQ ట్రాష్‌కి వెళ్తాయి. అక్కడ మీరు తీసివేతను నిర్ధారిస్తారు, ఫోటోలు, వీడియోలను “ఇటీవల తొలగించినవి”కి తరలించే ముందు iOS మళ్లీ అడుగుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการจะเข้าถังขยะของ GaleriQ ก่อน คุณยืนยันการนำออกที่นั่น และ iOS จะถามอีกครั้งก่อนย้ายรูปภาพและวิดีโอไปที่ “ที่ลบล่าสุด”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Öğeler önce GaleriQ çöpüne gider. Orada onaylarsın; iOS fotoğraf ve videoları taşımadan önce tekrar sorar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Об’єкти спочатку потрапляють у кошик GaleriQ. Там ви підтверджуєте; iOS перепитає перед переміщенням фото й відео."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آئٹمز پہلے GaleriQ ردی میں جاتے ہیں۔ وہاں آپ ہٹانے کی تصدیق کرتے ہیں، اور تصاویر و ویڈیوز کو حال ہی میں حذف کردہ میں لے جانے سے پہلے iOS دوبارہ پوچھتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các mục vào thùng rác GaleriQ trước. Bạn xác nhận việc xóa ở đó, và iOS hỏi lại trước khi chuyển ảnh và video vào Đã xóa gần đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "项目会先进入 GaleriQ 废纸篓。你在其中确认；iOS 在移动照片和视频前还会再次询问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "項目會先進入 GaleriQ 垃圾桶。你在那裡確認移除，iOS 也會在將照片和影片移到「最近刪除」前再次詢問。"
          }
        }
      }
    },
    "onb_safe_title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت تقرر ما يُحذف"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কী মুছে ফেলা হবে তা আপনিই ঠিক করেন"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu decideixes què s’esborra"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Co se smaže, rozhodujete vy"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bestemmer, hvad der slettes"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du entscheidest, was gelöscht wird"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εσύ αποφασίζεις τι διαγράφεται"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You decide what gets deleted"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tú decides qué se borra"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinä päätät, mitä poistetaan"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu décides de ce qui est supprimé"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "શું ડિલીટ થશે તે તમે નક્કી કરો છો"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההחלטה מה נמחק היא שלך"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या डिलीट होगा, यह आप तय करते हैं"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti odlučuješ što se briše"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Te döntöd el, mi törlődik"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu yang memutuskan apa yang dihapus"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Decidi tu cosa eliminare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除するものは自分で選べます"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಏನನ್ನು ಅಳಿಸಬೇಕು ಎಂದು ನೀವೇ ನಿರ್ಧರಿಸುತ್ತೀರಿ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제할 항목은 직접 선택해요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എന്ത് ഇല്ലാതാക്കണമെന്ന് നിങ്ങൾ തീരുമാനിക്കുന്നു"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "काय डिलीट होईल ते तुम्ही ठरवता"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda yang tentukan apa yang dipadam"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bestemmer hva som slettes"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jij bepaalt wat wordt verwijderd"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "କ’ଣ ଡିଲିଟ୍ ହେବ ଆପଣ ହିଁ ନିଷ୍ପତ୍ତି ନିଅନ୍ତି"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੀ ਮਿਟਾਇਆ ਜਾਵੇ, ਇਹ ਤੁਸੀਂ ਤੈਅ ਕਰਦੇ ਹੋ"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ty decydujesz, co usunąć"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você decide o que é apagado"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu decides o que é eliminado"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu decizi ce se șterge"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ты решаешь, что удалить"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "O tom, čo sa vymaže, rozhodujete vy"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti odločiš, kaj se izbriše"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bestämmer vad som raderas"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எதை நீக்குவது என்பதை நீங்களே முடிவு செய்கிறீர்கள்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఏది తొలగించాలో మీరే నిర్ణయిస్తారు"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณเป็นผู้ตัดสินใจว่าจะลบอะไร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neyin silineceğine sen karar ver"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ти вирішуєш, що видалити"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیا حذف ہو گا، یہ آپ طے کرتے ہیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn quyết định thứ gì bị xóa"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由你决定删除什么"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除什麼由你決定"
          }
        }
      }
    },
