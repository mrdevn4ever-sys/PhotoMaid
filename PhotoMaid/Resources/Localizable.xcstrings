      }
    },
    "vault_delete_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه السلة للخزنة فقط. يبقى المحتوى مشفّرًا حتى تستعيده أو تحذفه نهائيًا بقرار صريح. لا يوجد حذف تلقائي."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ট্র্যাশ শুধু ভল্টের। আপনি পুনরুদ্ধার না করা বা স্পষ্টভাবে স্থায়ীভাবে না মোছা পর্যন্ত বিষয়বস্তু এনক্রিপ্ট করা থাকে। কিছুই স্বয়ংক্রিয়ভাবে মুছে ফেলা হয় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquesta paperera només pertany a la caixa forta. El contingut es manté xifrat fins que el recuperes o l’esborres definitivament de manera explícita. No s’esborra res automàticament."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento koš patří jen trezoru. Obsah zůstává šifrovaný, dokud ho neobnovíte nebo výslovně trvale nesmažete. Nic se nemaže automaticky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne papirkurv hører kun til boksen. Indholdet forbliver krypteret, indtil du gendanner det eller udtrykkeligt sletter det permanent. Intet slettes automatisk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Papierkorb gehört nur zum Tresor. Inhalte bleiben verschlüsselt, bis du sie wiederherstellst oder ausdrücklich endgültig löschst. Keine automatische Löschung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτός ο κάδος ανήκει μόνο στο θησαυροφυλάκιο. Το περιεχόμενο μένει κρυπτογραφημένο μέχρι να το επαναφέρεις ή να το διαγράψεις ρητά οριστικά. Τίποτα δεν διαγράφεται αυτόματα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This trash belongs only to the vault. Content stays encrypted until you restore it or explicitly delete it permanently. Nothing is deleted automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta papelera es solo de la caja fuerte. El contenido sigue cifrado hasta restaurarlo o eliminarlo permanentemente. Nada se elimina automáticamente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä roskakori kuuluu vain holville. Sisältö pysyy salattuna, kunnes palautat sen tai poistat sen nimenomaisesti pysyvästi. Mitään ei poisteta automaattisesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette corbeille appartient au coffre. Le contenu reste chiffré jusqu’à sa restauration ou sa suppression définitive explicite. Aucune suppression automatique."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ ટ્રેશ ફક્ત વૉલ્ટનું છે. તમે પુનઃસ્થાપિત ન કરો કે સ્પષ્ટપણે કાયમ માટે ડિલીટ ન કરો ત્યાં સુધી સામગ્રી એન્ક્રિપ્ટેડ રહે છે. કંઈ આપમેળે ડિલીટ થતું નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפח הזה שייך רק לכספת. התוכן נשאר מוצפן עד ששוחזר או נמחק לצמיתות במפורש. שום דבר לא נמחק אוטומטית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह ट्रैश सिर्फ़ तिजोरी का है। सामग्री तब तक एन्क्रिप्टेड रहती है जब तक आप उसे वापस न रखें या स्पष्ट रूप से स्थायी रूप से डिलीट न करें। कुछ भी अपने-आप डिलीट नहीं होता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo smeće pripada samo trezoru. Sadržaj ostaje šifriran dok ga ne vratiš ili izričito trajno izbrišeš. Ništa se ne briše automatski."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a kuka csak a széfhez tartozik. A tartalom titkosítva marad, amíg vissza nem állítod vagy kifejezetten véglegesen nem törlöd. Semmi sem törlődik automatikusan."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sampah ini hanya milik brankas. Konten tetap terenkripsi sampai kamu memulihkannya atau menghapusnya secara permanen dengan sengaja. Tidak ada yang dihapus otomatis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo cestino appartiene alla cassaforte. I contenuti restano crittografati fino al ripristino o all’eliminazione definitiva esplicita. Nessuna eliminazione automatica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このゴミ箱は保管庫専用です。内容は復元または明示的な完全削除まで暗号化されたままです。自動削除はありません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಕಸದ ಬುಟ್ಟಿ ವಾಲ್ಟ್‌ಗೆ ಮಾತ್ರ ಸೇರಿದೆ. ನೀವು ಮರುಸ್ಥಾಪಿಸುವವರೆಗೆ ಅಥವಾ ಸ್ಪಷ್ಟವಾಗಿ ಶಾಶ್ವತವಾಗಿ ಅಳಿಸುವವರೆಗೆ ವಿಷಯ ಎನ್‌ಕ್ರಿಪ್ಟ್ ಆಗಿರುತ್ತದೆ. ಏನನ್ನೂ ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಅಳಿಸಲಾಗುವುದಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 휴지통은 보관함 전용입니다. 복원하거나 명시적으로 영구 삭제할 때까지 암호화됩니다. 자동 삭제되지 않습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ട്രാഷ് വോൾട്ടിന് മാത്രമുള്ളതാണ്. നിങ്ങൾ പുനഃസ്ഥാപിക്കുകയോ വ്യക്തമായി ശാശ്വതമായി ഇല്ലാതാക്കുകയോ ചെയ്യുന്നതുവരെ ഉള്ളടക്കം എൻക്രിപ്റ്റ് ചെയ്തിരിക്കും. ഒന്നും സ്വയമേവ ഇല്ലാതാക്കില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हा ट्रॅश फक्त व्हॉल्टचा आहे. तुम्ही तो परत ठेवेपर्यंत किंवा स्पष्टपणे कायमचा डिलीट करेपर्यंत मजकूर एन्क्रिप्टेड राहतो. काहीही आपोआप डिलीट होत नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sampah ini milik peti besi sahaja. Kandungan kekal disulitkan sehingga anda memulihkannya atau memadamnya secara kekal dengan jelas. Tiada apa dipadam secara automatik."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne papirkurven hører bare til safen. Innholdet forblir kryptert til du gjenoppretter det eller uttrykkelig sletter det permanent. Ingenting slettes automatisk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze prullenmand hoort alleen bij de kluis. Inhoud blijft versleuteld tot je die herstelt of definitief verwijdert. Niets wordt automatisch verwijderd."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହି ଟ୍ରାସ କେବଳ ଭଲ୍ଟର। ଆପଣ ପୁନରୁଦ୍ଧାର ନକରିବା କିମ୍ବା ସ୍ପଷ୍ଟ ଭାବେ ସ୍ଥାୟୀ ଡିଲିଟ୍ ନକରିବା ପର୍ଯ୍ୟନ୍ତ ବିଷୟବସ୍ତୁ ଏନକ୍ରିପ୍ଟେଡ୍ ରହେ। କିଛି ସ୍ୱୟଂଚାଳିତ ଭାବେ ଡିଲିଟ୍ ହୁଏ ନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਰੱਦੀ ਸਿਰਫ਼ ਵੌਲਟ ਦੀ ਹੈ। ਸਮੱਗਰੀ ਤਦ ਤੱਕ ਇਨਕ੍ਰਿਪਟਡ ਰਹਿੰਦੀ ਹੈ ਜਦ ਤੱਕ ਤੁਸੀਂ ਇਸ ਨੂੰ ਬਹਾਲ ਨਹੀਂ ਕਰਦੇ ਜਾਂ ਸਪਸ਼ਟ ਤੌਰ ’ਤੇ ਪੱਕੇ ਤੌਰ ’ਤੇ ਨਹੀਂ ਮਿਟਾਉਂਦੇ। ਕੁਝ ਵੀ ਆਪਣੇ-ਆਪ ਨਹੀਂ ਮਿਟਦਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten kosz należy tylko do sejfu. Zawartość pozostaje zaszyfrowana do przywrócenia lub świadomego trwałego usunięcia. Nic nie jest usuwane automatycznie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta lixeira pertence só ao cofre. O conteúdo fica criptografado até você restaurá-lo ou apagá-lo permanentemente de forma explícita. Nada é apagado automaticamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este lixo pertence apenas ao cofre. O conteúdo continua cifrado até o restaurares ou apagares permanentemente. Nada é apagado automaticamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest coș aparține doar seifului. Conținutul rămâne criptat până îl restaurezi sau îl ștergi definitiv în mod explicit. Fără ștergere automată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта корзина относится только к сейфу. Данные остаются зашифрованными до восстановления или явного удаления навсегда. Автоматического удаления нет."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento kôš patrí len trezoru. Obsah zostáva šifrovaný, kým ho neobnovíte alebo výslovne natrvalo nevymažete. Nič sa nemaže automaticky."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta koš pripada samo sefu. Vsebina ostane šifrirana, dokler je ne obnoviš ali izrecno trajno izbrišeš. Nič se ne izbriše samodejno."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här papperskorgen tillhör bara valvet. Innehållet förblir krypterat tills du återställer det eller uttryckligen raderar det permanent. Inget raderas automatiskt."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தக் குப்பை லாக்கருக்கு மட்டுமே சொந்தமானது. நீங்கள் மீட்டமைக்கும் வரை அல்லது வெளிப்படையாக நிரந்தரமாக நீக்கும் வரை உள்ளடக்கம் குறியாக்கப்பட்டிருக்கும். எதுவும் தானாக நீக்கப்படாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ ట్రాష్ వాల్ట్‌కి మాత్రమే చెందినది. మీరు పునరుద్ధరించే వరకు లేదా స్పష్టంగా శాశ్వతంగా తొలగించే వరకు కంటెంట్ ఎన్‌క్రిప్ట్ అయి ఉంటుంది. ఏదీ ఆటోమేటిక్‌గా తొలగించబడదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถังขยะนี้เป็นของตู้เซฟเท่านั้น เนื้อหายังคงเข้ารหัสจนกว่าคุณจะกู้คืนหรือสั่งลบถาวรเอง ไม่มีอะไรถูกลบโดยอัตโนมัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu çöp kutusu yalnızca kasaya aittir. İçerik geri yüklenene veya açıkça kalıcı silinene kadar şifreli kalır. Otomatik silme yapılmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей кошик належить лише сховищу. Дані залишаються зашифрованими до відновлення або явного видалення назавжди. Автоматичного видалення немає."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ ردی صرف والٹ کی ہے۔ مواد تب تک خفیہ رہتا ہے جب تک آپ اسے بحال نہ کریں یا واضح طور پر مستقل حذف نہ کریں۔ کچھ بھی خود بخود حذف نہیں ہوتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thùng rác này chỉ thuộc về két sắt. Nội dung vẫn được mã hóa cho đến khi bạn khôi phục hoặc chủ động xóa vĩnh viễn. Không có gì bị xóa tự động."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此废纸篓仅属于保险库。内容会保持加密，直到你恢复或明确永久删除。不会自动删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個垃圾桶只屬於保險箱。內容會保持加密，直到你還原它或明確地永久刪除。不會自動刪除任何內容。"
          }
        }
      }
    },
