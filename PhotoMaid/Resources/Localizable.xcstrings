    "archive_cleanup_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توجد الآن نسخة تم التحقق منها من هذه الصور والفيديوهات على «%1$@». ستنتقل فقط إلى سلة مهملات GaleriQ. لن يُحذف شيء حتى تفرغها ويسألك Android مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "There is now a checked copy of these photos and videos on “%1$@”. They only go to the GaleriQ trash. Nothing is deleted until you empty it and Android asks once more."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "There is now a checked copy of these photos and videos on “%1$@”. They only go to the GaleriQ trash. Nothing is deleted until you empty it and Android asks once more."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "There is now a checked copy of these photos and videos on “%1$@”. They only go to the GaleriQ trash. Nothing is deleted until you empty it and Android asks once more."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "There is now a checked copy of these photos and videos on “%1$@”. They only go to the GaleriQ trash. Nothing is deleted until you empty it and Android asks once more."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von diesen Fotos und Videos gibt es jetzt eine geprüfte Kopie auf „%1$@“. Sie kommen nur in den GaleriQ-Papierkorb. Gelöscht wird erst, wenn du ihn leerst und Android noch einmal nachfragt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "There is now a checked copy of these photos and videos on “%1$@”. They only go to the GaleriQ trash. Nothing is deleted until you empty it and Android asks once more."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is now a checked copy of these photos and videos on “%1$@”. They only go to the GaleriQ trash. Nothing is deleted until you empty it and Android asks once more."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora hay una copia comprobada de estas fotos y vídeos en «%1$@». Solo van a la papelera de GaleriQ. No se borra nada hasta que la vacíes y Android vuelva a preguntar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "There is now a checked copy of these photos and videos on “%1$@”. They only go to the GaleriQ trash. Nothing is deleted until you empty it and Android asks once more."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il existe maintenant une copie vérifiée de ces photos et vidéos sur « %1$@ ». Elles vont seulement dans la corbeille GaleriQ. Rien n’est supprimé tant que vous ne la videz pas et qu’Android ne redemande pas."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "There is now a checked copy of these photos and videos on “%1$@”. They only go to the GaleriQ trash. Nothing is deleted until you empty it and Android asks once more."
          }
