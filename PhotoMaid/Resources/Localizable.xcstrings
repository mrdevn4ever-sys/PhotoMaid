    "tools_freed_later": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في سلة مهملات Android، ولم تتحرر بعد: عندما يفرغها Android ستشغل الملفات مساحة أقل بمقدار %1$@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "In the Android trash, not freed yet: once Android empties it, these files take up %1$@ less."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Android-Papierkorb, noch nicht frei: Sobald Android ihn leert, belegen die Dateien %1$@ weniger."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
