      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعض الصور لم تعد متاحة ولن تظهر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কিছু ফটো আর পাওয়া যায় না এবং বাদ দেওয়া হয়েছে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunes fotos ja no estan disponibles i s’ometen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Některé fotky už nejsou k dispozici a jsou vynechány."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nogle fotos findes ikke længere og er udeladt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Fotos sind nicht mehr vorhanden und fehlen in der Collage."
          }
        },
        "el": {
          "stringUnit": {
