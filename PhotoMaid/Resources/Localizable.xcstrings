      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُقفل الخزنة دائمًا في الخلفية. تُحجب المعاينات عند تبديل التطبيقات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ব্যাকগ্রাউন্ডে ভল্ট সবসময় লক হয়। অ্যাপ বদলানোর সময় প্রিভিউ ঢেকে দেওয়া হয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La caixa forta sempre es bloqueja en segon pla. Les previsualitzacions es tapen en canviar d’app."
