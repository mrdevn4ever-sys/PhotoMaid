        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आइटम तिजोरी में रहते हैं, बस बिना फ़ोल्डर के।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stavke ostaju u trezoru, samo bez mape."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az elemek a széfben maradnak, csak mappa nélkül."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Item tetap di brankas, hanya tanpa folder."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli elementi restano nella cassaforte, solo senza cartella."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "項目は保管庫に残り、フォルダなしになります。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಐಟಂಗಳು ವಾಲ್ಟ್‌ನಲ್ಲೇ ಉಳಿಯುತ್ತವೆ, ಫೋಲ್ಡರ್ ಇಲ್ಲದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목은 금고에 남고 폴더만 없어집니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇനങ്ങൾ വോൾട്ടിൽ തന്നെ തുടരും, ഫോൾഡറില്ലാതെ."
