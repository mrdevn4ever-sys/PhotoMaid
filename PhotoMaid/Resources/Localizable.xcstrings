    "pro_details_cleanup": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يُحتسب في الحد اليومي إلا ما تزيله فعلًا من سلة المهملات. التمرير لا يُحتسب أبدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Tageslimit zählt nur, was du im Papierkorb wirklich entfernst. Wischen zählt nie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only what you actually remove from the trash counts toward the daily limit. Swiping never counts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al límite diario solo cuenta lo que eliminas de verdad en la papelera. Deslizar nunca cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul ce que vous retirez vraiment de la corbeille compte dans la limite quotidienne. Balayer ne compte jamais."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per il limite giornaliero conta solo ciò che rimuovi davvero dal cestino. Scorrere non conta mai."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1日の上限に数えるのは、ゴミ箱から実際に削除したものだけです。スワイプは数えません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하루 한도에는 휴지통에서 실제로 지운 것만 들어가요. 넘기기는 세지 않아요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor de daglimiet telt alleen wat je echt uit de prullenbak verwijdert. Vegen telt nooit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do dziennego limitu liczy się tylko to, co naprawdę usuniesz z kosza. Przesuwanie się nie liczy."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para o limite diário só conta o que remove de facto do lixo. Deslizar nunca conta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "La limita zilnică se pune doar ce elimini cu adevărat din coș. Glisarea nu contează niciodată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В дневной лимит входит только то, что вы действительно удаляете из корзины. Пролистывание не считается."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günlük sınıra yalnızca çöp kutusundan gerçekten kaldırdıkların sayılır. Kaydırmak asla sayılmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "До денного ліміту входить лише те, що ви справді видаляєте з кошика. Гортання не враховується."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有你在回收站里真正移除的内容才计入每日上限。滑动永远不计入。"
          }
        }
      }
    },
    "pro_details_dup": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النسخ هي ملفات متطابقة حتى آخر تفصيل. يقارنها PhotoMaid على جهازك وليس في السحابة. الصور المتشابهة فقط لا تُعد نسخًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopien sind Dateien, die bis ins letzte Detail gleich sind. PhotoMaid vergleicht sie auf deinem Gerät, nicht in der Cloud. Bilder, die sich nur ähneln, zählen nicht als Kopien."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copies are files that are identical down to the last detail. PhotoMaid compares them on your device, not in the cloud. Images that only look similar don’t count as copies."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las copias son archivos idénticos hasta el último detalle. PhotoMaid los compara en tu dispositivo, no en la nube. Las imágenes que solo se parecen no cuentan como copias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les copies sont des fichiers identiques jusque dans le moindre détail. PhotoMaid les compare sur votre appareil, pas dans le cloud. Les images qui se ressemblent seulement ne comptent pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le copie sono file identici fino all’ultimo dettaglio. PhotoMaid li confronta sul dispositivo, non nel cloud. Le immagini che si somigliano soltanto non contano come copie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピーとは細部まで完全に同じファイルのことです。PhotoMaid はクラウドではなく端末内で比べます。似ているだけの画像はコピーに含みません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복사본은 마지막 세부까지 똑같은 파일이에요. PhotoMaid는 클라우드가 아니라 기기에서 비교해요. 비슷하기만 한 이미지는 복사본으로 치지 않아요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopieën zijn bestanden die tot in het kleinste detail gelijk zijn. PhotoMaid vergelijkt ze op je apparaat, niet in de cloud. Beelden die alleen op elkaar lijken, tellen niet als kopie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopie to pliki identyczne co do najmniejszego szczegółu. PhotoMaid porównuje je na urządzeniu, nie w chmurze. Obrazy tylko podobne nie są liczone jako kopie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As cópias são ficheiros iguais até ao último pormenor. O PhotoMaid compara-os no dispositivo, não na nuvem. Imagens apenas parecidas não contam como cópias."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiile sunt fișiere identice până la ultimul detaliu. PhotoMaid le compară pe dispozitiv, nu în cloud. Imaginile doar asemănătoare nu contează drept copii."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копии – это файлы, совпадающие до мельчайших деталей. PhotoMaid сравнивает их на устройстве, а не в облаке. Просто похожие снимки копиями не считаются."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopyalar en ince ayrıntısına kadar aynı olan dosyalardır. PhotoMaid bunları bulutta değil cihazında karşılaştırır. Yalnızca benzeyen görseller kopya sayılmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Копії – це файли, що збігаються до найменших деталей. PhotoMaid порівнює їх на пристрої, а не в хмарі. Просто схожі знімки копіями не вважаються."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "副本是连最小细节都完全相同的文件。PhotoMaid 在设备上比较，而不是在云端。只是相似的图片不算副本。"
          }
        }
      }
    },
    "pro_details_rules": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعرض المجموعات المحتوى المطابق على جهازك. تفتحه وتراجعه بنفسك. لا تحذف شيئًا تلقائيًا ولا تنظّف في الخلفية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sammlungen zeigen passende Inhalte von deinem Gerät. Du öffnest und prüfst sie selbst. Sie löschen nichts automatisch und räumen nicht im Hintergrund auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Collections show matching content from your device. You open and review it yourself. They never delete automatically or clean up in the background."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las colecciones muestran contenido de tu dispositivo que coincide con un filtro. Tú lo abres y revisas. No borran nada automáticamente ni limpian en segundo plano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les collections affichent le contenu correspondant sur ton appareil. Tu les ouvres et fais le tri toi-même. Elles ne suppriment rien automatiquement et ne trient pas en arrière-plan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le raccolte mostrano i contenuti corrispondenti sul dispositivo. Li apri e controlli tu. Non eliminano nulla automaticamente e non riordinano in background."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コレクションは端末内で条件に合うものを表示します。自分で開いて確認する仕組みで、自動削除やバックグラウンドでの整理は行いません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모음은 기기에 있는 항목 중 조건에 맞는 것을 보여 줘요. 직접 열고 확인하는 방식이며, 자동 삭제나 백그라운드 정리는 하지 않아요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verzamelingen tonen passende inhoud op je apparaat. Je opent en bekijkt die zelf. Ze verwijderen niets automatisch en ruimen niet op de achtergrond op."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolekcje pokazują pasujące treści z urządzenia. Otwierasz i przeglądasz je samodzielnie. Niczego nie usuwają automatycznie ani nie sprzątają w tle."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As coleções mostram conteúdo correspondente no teu dispositivo. Tu abres e revês esse conteúdo. Não eliminam nada automaticamente nem limpam em segundo plano."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Colecțiile arată conținut potrivit de pe dispozitiv. Îl deschizi și îl verifici tu. Nu șterg nimic automat și nu fac curățenie în fundal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подборки показывают подходящее содержимое с устройства. Ты открываешь и просматриваешь его сам. Они ничего не удаляют автоматически и не убирают в фоне."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koleksiyonlar cihazındaki eşleşen içerikleri gösterir. Bunları kendin açıp incelersin. Otomatik silmez veya arka planda temizlik yapmazlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Добірки показують відповідний вміст із пристрою. Ти відкриваєш і переглядаєш його самостійно. Вони нічого не видаляють автоматично й не прибирають у фоні."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合集会显示设备上符合条件的内容，由你打开并逐项查看。不会自动删除，也不会在后台清理。"
          }
        }
      }
    },
