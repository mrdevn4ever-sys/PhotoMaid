        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복구 키가 설정되지 않았습니다. 암호(또는 Face ID) 없이는 금고를 열 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is geen herstelsleutel ingesteld. Zonder de code (of Face ID) kan de kluis niet worden geopend."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie skonfigurowano klucza odzyskiwania. Bez kodu (lub Face ID) nie można otworzyć sejfu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi configurada nenhuma chave de recuperação. Sem o código (ou Face ID), não é possível abrir o cofre."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu a fost configurată nicio cheie de recuperare. Fără cod (sau Face ID), seiful nu poate fi deschis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ восстановления не настроен. Без кода (или Face ID) сейф нельзя открыть."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurtarma anahtarı ayarlanmadı. Kod (veya Face ID) olmadan kasa açılamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ відновлення не налаштовано. Без коду (або Face ID) сейф не відкрити."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未设置恢复密钥。没有密码（或 Face ID）就无法打开保险箱。"
          }
        }
      }
    },
