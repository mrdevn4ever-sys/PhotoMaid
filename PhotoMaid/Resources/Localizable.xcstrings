    "vault_settings_row_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مكان مخفي ومحمي برمز للصور ومقاطع الفيديو. تختفي من تطبيق الصور."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versteckter, mit Code geschützter Ort für Fotos und Videos. Sie verschwinden aus der Fotos-App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidden, code-protected place for photos and videos. They disappear from the Photos app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lugar oculto y protegido con código para fotos y vídeos. Desaparecen de la app Fotos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Endroit caché et protégé par code pour les photos et vidéos. Elles disparaissent de l’app Photos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spazio nascosto e protetto da codice per foto e video. Spariscono dall’app Foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真とビデオのための、コードで保護された隠し場所です。写真アプリからは消えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진과 비디오를 위한, 암호로 보호된 숨겨진 공간입니다. 사진 앱에서는 사라집니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verborgen, met een code beveiligde plek voor foto’s en video’s. Ze verdwijnen uit de Foto’s-app."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukryte, chronione kodem miejsce na zdjęcia i filmy. Znikają z aplikacji Zdjęcia."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Local oculto e protegido por código para fotografias e vídeos. Desaparecem da app Fotografias."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Loc ascuns, protejat cu cod, pentru poze și videoclipuri. Dispar din aplicația Poze."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрытое, защищённое кодом место для фото и видео. Они исчезают из «Фото»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraflar ve videolar için gizli, kodla korunan bir yer. Fotoğraflar uygulamasından kaybolurlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Приховане, захищене кодом місце для фото й відео. Вони зникають із «Фото»."
          }
        },
        "zh-Hans": {
