    "ret_red_eye_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على عين حمراء. للوجوه الصغيرة كبّر أولًا بإصبعين. يتغيّر الأحمر في العين فقط."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি লাল চোখে ট্যাপ করুন। ছোট মুখের জন্য আগে দুই আঙুলে জুম করুন। শুধু চোখের লাল রং বদলায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un ull vermell. En cares petites, primer amplia amb dos dits. Només canvia el vermell de l’ull."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepněte na červené oko. U malých obličejů nejdřív přibližte dvěma prsty. Mění se jen červená v oku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på et rødt øje. Ved små ansigter zoomer du først ind med to fingre. Kun det røde i øjet ændres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf ein rotes Auge. Bei kleinen Gesichtern vorher mit zwei Fingern heranzoomen. Es ändert sich nur das Rot im Auge."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάτησε ένα κόκκινο μάτι. Σε μικρά πρόσωπα κάνε πρώτα ζουμ με δύο δάχτυλα. Αλλάζει μόνο το κόκκινο του ματιού."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a red eye. For small faces, zoom in with two fingers first. Only the red in the eye changes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un ojo rojo. Con caras pequeñas, amplía antes con dos dedos. Solo cambia el rojo del ojo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta punaista silmää. Pienissä kasvoissa zoomaa ensin kahdella sormella. Vain silmän punainen väri muuttuu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez un œil rouge. Pour les petits visages, zoomez d’abord avec deux doigts. Seul le rouge de l’œil change."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "લાલ આંખ પર ટૅપ કરો. નાના ચહેરા માટે પહેલાં બે આંગળીથી ઝૂમ કરો. ફક્ત આંખનો લાલ રંગ બદલાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "להקיש על עין אדומה. בפנים קטנות כדאי להגדיל קודם בשתי אצבעות. רק האדום בעין משתנה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी लाल आँख पर टैप करें। छोटे चेहरों के लिए पहले दो उँगलियों से ज़ूम करें। सिर्फ़ आँख का लाल रंग बदलता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirni crveno oko. Kod malih lica najprije zumiraj dvama prstima. Mijenja se samo crvena boja u oku."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints egy vörös szemre. Kis arcoknál előbb nagyíts két ujjal. Csak a szem vörös színe változik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk mata yang merah. Untuk wajah kecil, perbesar dulu dengan dua jari. Hanya warna merah di mata yang berubah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca un occhio rosso. Per i volti piccoli, ingrandisci prima con due dita. Cambia solo il rosso nell’occhio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "赤い目をタップします。小さな顔は先に2本指で拡大してください。変わるのは目の赤い部分だけです。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕೆಂಪು ಕಣ್ಣನ್ನು ಟ್ಯಾಪ್ ಮಾಡಿ. ಚಿಕ್ಕ ಮುಖಗಳಿಗೆ ಮೊದಲು ಎರಡು ಬೆರಳುಗಳಿಂದ ಜೂಮ್ ಮಾಡಿ. ಕಣ್ಣಿನ ಕೆಂಪು ಮಾತ್ರ ಬದಲಾಗುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빨간 눈을 탭하세요. 작은 얼굴은 먼저 두 손가락으로 확대하세요. 눈의 빨간색만 바뀌어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരു ചുവന്ന കണ്ണിൽ ടാപ്പ് ചെയ്യുക. ചെറിയ മുഖങ്ങൾക്ക് ആദ്യം രണ്ട് വിരലുകൾ കൊണ്ട് സൂം ചെയ്യുക. കണ്ണിലെ ചുവപ്പ് മാത്രം മാറും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "लाल डोळ्यावर टॅप करा. लहान चेहऱ्यांसाठी आधी दोन बोटांनी झूम करा. फक्त डोळ्यातील लाल रंग बदलतो."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik mata merah. Untuk wajah kecil, zum masuk dengan dua jari dahulu. Hanya warna merah pada mata berubah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på et rødt øye. Ved små ansikter zoomer du først inn med to fingre. Bare det røde i øyet endres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op een rood oog. Zoom bij kleine gezichten eerst in met twee vingers. Alleen het rood in het oog verandert."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏକ ଲାଲ ଆଖିରେ ଟାପ୍ କରନ୍ତୁ। ଛୋଟ ମୁହଁ ପାଇଁ ପ୍ରଥମେ ଦୁଇ ଆଙ୍ଗୁଠିରେ ଜୁମ୍ କରନ୍ତୁ। କେବଳ ଆଖିର ଲାଲ ରଙ୍ଗ ବଦଳେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕਿਸੇ ਲਾਲ ਅੱਖ ਉੱਤੇ ਟੈਪ ਕਰੋ। ਛੋਟੇ ਚਿਹਰਿਆਂ ਲਈ ਪਹਿਲਾਂ ਦੋ ਉਂਗਲਾਂ ਨਾਲ ਜ਼ੂਮ ਕਰੋ। ਸਿਰਫ਼ ਅੱਖ ਦਾ ਲਾਲ ਰੰਗ ਬਦਲਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotknij czerwonego oka. Przy małych twarzach najpierw przybliż dwoma palcami. Zmienia się tylko czerwień w oku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque num olho vermelho. Em rostos pequenos, amplie antes com dois dedos. Só o vermelho do olho muda."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque num olho vermelho. Em rostos pequenos, amplie primeiro com dois dedos. Só muda o vermelho do olho."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge un ochi roșu. La fețe mici, mărește mai întâi cu două degete. Se schimbă doar roșul din ochi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь красного глаза. Для маленьких лиц сначала увеличьте двумя пальцами. Меняется только красный цвет в глазу."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnite na červené oko. Pri malých tvárach najprv priblížte dvoma prstami. Mení sa len červená v oku."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapni rdeče oko. Pri majhnih obrazih najprej povečaj z dvema prstoma. Spremeni se samo rdeča barva v očesu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på ett rött öga. Vid små ansikten zoomar du först in med två fingrar. Bara det röda i ögat ändras."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு சிவப்புக் கண்ணைத் தட்டுங்கள். சிறிய முகங்களுக்கு முதலில் இரண்டு விரல்களால் பெரிதாக்குங்கள். கண்ணின் சிவப்பு மட்டுமே மாறும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఎర్ర కన్నును ట్యాప్ చేయండి. చిన్న ముఖాల కోసం ముందుగా రెండు వేళ్లతో జూమ్ చేయండి. కంటిలోని ఎరుపు మాత్రమే మారుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะตาที่แดง สำหรับใบหน้าขนาดเล็ก ให้ซูมเข้าด้วยสองนิ้วก่อน เปลี่ยนเฉพาะสีแดงในตา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kırmızı bir göze dokun. Küçük yüzlerde önce iki parmakla yakınlaştır. Yalnızca gözdeki kırmızı değişir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться червоного ока. Для маленьких облич спершу збільште двома пальцями. Змінюється лише червоне в оці."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کسی سرخ آنکھ پر ٹیپ کریں۔ چھوٹے چہروں کے لیے پہلے دو انگلیوں سے زوم کریں۔ صرف آنکھ کا سرخ رنگ بدلتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm vào mắt bị đỏ. Với khuôn mặt nhỏ, hãy phóng to bằng hai ngón trước. Chỉ màu đỏ trong mắt thay đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按红眼。脸部较小时，请先用两根手指放大。只会改变眼睛中的红色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下紅眼。臉部較小時，請先用兩指放大。只會更改眼睛中的紅色。"
          }
        }
      }
    },
