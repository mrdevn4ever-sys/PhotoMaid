    "tools_fmt_png_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بلا فقدان في الجودة، لكن الملفات أكبر بكثير"
          }
        },
