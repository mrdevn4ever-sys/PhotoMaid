    "tour_feed_basket_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُظهر العدد ما اخترت إزالته. اضغط عليه لمراجعة اختيارك وإفراغ سلة المهملات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zahl zeigt, wie viel du aussortiert hast. Tippe darauf, um die Auswahl anzusehen und den Papierkorb zu leeren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The number shows how much you’ve set aside. Tap it to review your selection and empty the trash."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El número indica cuántos elementos has apartado. Tócalo para revisar la selección y vaciar la papelera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nombre indique combien d’éléments tu as mis de côté. Touche-le pour revoir ta sélection et vider la corbeille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il numero indica quanti elementi hai scelto di rimuovere. Toccalo per controllare la selezione e svuotare il cestino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "数字は削除用に選んだ件数です。タップして内容を確認し、ゴミ箱を空にできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "숫자는 삭제하려고 고른 항목 수예요. 누르면 선택 내용을 확인하고 휴지통을 비울 수 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het getal toont hoeveel je hebt geselecteerd. Tik erop om je selectie te bekijken en de prullenbak te legen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Liczba pokazuje, ile elementów zostało wybranych. Dotknij jej, aby przejrzeć wybór i opróżnić kosz."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O número mostra quantos itens separaste. Toca nele para rever a seleção e esvaziar o lixo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Numărul arată câte elemente ai selectat. Atinge-l pentru a verifica selecția și a goli coșul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Число показывает, сколько элементов выбрано. Нажми на него, чтобы проверить выбор и очистить корзину."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayı, kaç öğe ayırdığını gösterir. Seçimini incelemek ve çöp kutusunu boşaltmak için dokun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Число показує кількість вибраних елементів. Натисни на нього, щоб переглянути вибір і очистити кошик."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数字表示你选出的待移除数量。点击可查看所选内容并清空回收站。"
          }
        }
      }
    },
