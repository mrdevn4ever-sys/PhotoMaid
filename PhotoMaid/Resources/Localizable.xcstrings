    "ana2_stage_cooling": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بانتظار أن يبرد الـ iPhone – سيتابع تلقائيًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wartet, bis das iPhone abgekühlt ist – geht dann von selbst weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for the iPhone to cool down – it continues on its own."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando a que el iPhone se enfríe; continuará solo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente que l’iPhone refroidisse – reprend tout seul."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In attesa che l’iPhone si raffreddi: riprende da solo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneが冷えるまで待機中 – その後、自動で続行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone이 식을 때까지 기다리는 중 – 이후 자동으로 계속돼요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wacht tot de iPhone is afgekoeld – gaat daarna vanzelf verder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czekam, aż iPhone ostygnie – potem działa dalej samo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "À espera que o iPhone arrefeça – depois continua sozinho."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se așteaptă răcirea iPhone-ului – apoi continuă singur."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ждём, пока iPhone остынет, – затем продолжится само."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone’un soğuması bekleniyor – sonra kendiliğinden devam eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чекаємо, поки iPhone охолоне, – потім продовжиться саме."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待 iPhone 降温，之后会自动继续。"
          }
        }
      }
    },
