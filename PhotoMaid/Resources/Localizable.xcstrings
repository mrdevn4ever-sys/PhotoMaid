    "vault2_conflict": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّرت الملاحظة المحفوظة ولم تُستبدل بمسودتك. احفظ المسودة كملاحظة جديدة أو تجاهل التغييرات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সংরক্ষিত নোটটি বদলেছে। আপনার খসড়া এটি ওভাররাইট করেনি। খসড়াটি নতুন নোট হিসেবে সংরক্ষণ করুন বা অসংরক্ষিত পরিবর্তন বাদ দিন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La nota desada ha canviat. L’esborrany no l’ha sobreescrit. Desa l’esborrany com a nota nova o descarta els canvis no desats."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uložená poznámka se změnila. Váš koncept ji nepřepsal. Uložte koncept jako novou poznámku, nebo zahoďte neuložené změny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den gemte note er ændret. Din kladde overskrev den ikke. Gem kladden som en ny note, eller kassér ændringer, der ikke er gemt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gespeicherte Notiz hat sich geändert. Dein Entwurf wurde nicht darübergeschrieben. Speichere ihn als neue Notiz oder verwirf die ungespeicherten Änderungen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αποθηκευμένη σημείωση άλλαξε. Το πρόχειρό σου δεν την αντικατέστησε. Αποθήκευσε το πρόχειρο ως νέα σημείωση ή απόρριψε τις μη αποθηκευμένες αλλαγές."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved note changed. Your draft did not overwrite it. Save your draft as a new note or discard unsaved changes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La nota guardada cambió. Tu borrador no la sobrescribió. Guárdalo como nota nueva o descarta los cambios."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallennettu muistiinpano muuttui. Luonnoksesi ei korvannut sitä. Tallenna luonnos uutena muistiinpanona tai hylkää tallentamattomat muutokset."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La note enregistrée a changé. Votre brouillon ne l’a pas écrasée. Enregistrez-le comme nouvelle note ou abandonnez les modifications."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સાચવેલી નોંધ બદલાઈ છે. તમારા ડ્રાફ્ટે તેને ઓવરરાઇટ કરી નથી. ડ્રાફ્ટને નવી નોંધ તરીકે સાચવો કે ન સાચવેલા ફેરફારો રદ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההערה השמורה השתנתה. הטיוטה שלך לא דרסה אותה. אפשר לשמור את הטיוטה כהערה חדשה או לבטל את השינויים שלא נשמרו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहेजा गया नोट बदल गया है। आपके ड्राफ़्ट ने उसे ओवरराइट नहीं किया। ड्राफ़्ट को नए नोट के रूप में सहेजें या बिना सहेजे बदलाव छोड़ें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spremljena bilješka se promijenila. Tvoja skica je nije prebrisala. Spremi skicu kao novu bilješku ili odbaci nespremljene promjene."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A mentett jegyzet megváltozott. A piszkozatod nem írta felül. Mentsd a piszkozatot új jegyzetként, vagy vesd el a nem mentett módosításokat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Catatan yang tersimpan berubah. Drafmu tidak menimpanya. Simpan drafmu sebagai catatan baru atau buang perubahan yang belum disimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La nota salvata è cambiata. La bozza non l’ha sovrascritta. Salvala come nuova nota o scarta le modifiche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みメモが変更されました。下書きは上書きしていません。新しいメモとして保存するか、未保存の変更を破棄してください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಉಳಿಸಿದ ಟಿಪ್ಪಣಿ ಬದಲಾಗಿದೆ. ನಿಮ್ಮ ಡ್ರಾಫ್ಟ್ ಅದನ್ನು ಮೇಲ್ಬರಹ ಮಾಡಲಿಲ್ಲ. ನಿಮ್ಮ ಡ್ರಾಫ್ಟ್ ಅನ್ನು ಹೊಸ ಟಿಪ್ಪಣಿಯಾಗಿ ಉಳಿಸಿ ಅಥವಾ ಉಳಿಸದ ಬದಲಾವಣೆಗಳನ್ನು ತ್ಯಜಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 메모가 변경되어 초안으로 덮어쓰지 않았습니다. 새 메모로 저장하거나 변경 사항을 버리세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സംരക്ഷിച്ച കുറിപ്പ് മാറി. നിങ്ങളുടെ ഡ്രാഫ്റ്റ് അതിനെ മാറ്റിയെഴുതിയില്ല. ഡ്രാഫ്റ്റ് പുതിയ കുറിപ്പായി സംരക്ഷിക്കുക അല്ലെങ്കിൽ സംരക്ഷിക്കാത്ത മാറ്റങ്ങൾ ഉപേക്ഷിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "जतन केलेली नोंद बदलली आहे. तुमच्या मसुद्याने ती ओव्हरराइट केली नाही. मसुदा नवीन नोंद म्हणून जतन करा किंवा जतन न केलेले बदल टाकून द्या."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nota yang disimpan telah berubah. Draf anda tidak menulis gantinya. Simpan draf anda sebagai nota baharu atau buang perubahan yang belum disimpan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det lagrede notatet er endret. Utkastet ditt overskrev det ikke. Lagre utkastet som et nytt notat eller forkast endringer som ikke er lagret."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De opgeslagen notitie is gewijzigd en niet overschreven. Sla je concept als nieuwe notitie op of gooi de wijzigingen weg."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସେଭ୍ ହୋଇଥିବା ନୋଟ୍ ବଦଳିଛି। ଆପଣଙ୍କ ଡ୍ରାଫ୍ଟ ଏହାକୁ ଓଭରରାଇଟ୍ କରିନାହିଁ। ଡ୍ରାଫ୍ଟକୁ ନୂଆ ନୋଟ୍ ଭାବେ ସେଭ୍ କରନ୍ତୁ କିମ୍ବା ସେଭ୍ ହୋଇନଥିବା ପରିବର୍ତ୍ତନ ବାତିଲ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸੰਭਾਲਿਆ ਨੋਟ ਬਦਲ ਗਿਆ। ਤੁਹਾਡੇ ਡਰਾਫ਼ਟ ਨੇ ਇਸ ਨੂੰ ਓਵਰਰਾਈਟ ਨਹੀਂ ਕੀਤਾ। ਆਪਣਾ ਡਰਾਫ਼ਟ ਨਵੇਂ ਨੋਟ ਵਜੋਂ ਸੰਭਾਲੋ ਜਾਂ ਨਾ ਸੰਭਾਲੇ ਬਦਲਾਅ ਰੱਦ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisana notatka się zmieniła. Szkic jej nie nadpisał. Zapisz go jako nową notatkę lub odrzuć zmiany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A nota salva foi alterada. Seu rascunho não a substituiu. Salve o rascunho como nova nota ou descarte as alterações não salvas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A nota guardada mudou. O rascunho não a substituiu. Guarda-o como nova nota ou descarta as alterações."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Notița salvată s-a schimbat. Ciorna nu a suprascris-o. Salvează ciorna ca notiță nouă sau renunță la modificări."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранённая заметка изменилась. Черновик её не перезаписал. Сохраните его новой заметкой или отмените изменения."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Uložená poznámka sa zmenila. Váš koncept ju neprepísal. Uložte koncept ako novú poznámku alebo zahoďte neuložené zmeny."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Shranjeni zapisek se je spremenil. Tvoj osnutek ga ni prepisal. Shrani osnutek kot nov zapisek ali zavrzi neshranjene spremembe."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den sparade anteckningen har ändrats. Ditt utkast skrev inte över den. Spara utkastet som en ny anteckning eller släng osparade ändringar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சேமித்த குறிப்பு மாறியுள்ளது. உங்கள் வரைவு அதை மேலெழுதவில்லை. வரைவைப் புதிய குறிப்பாகச் சேமியுங்கள் அல்லது சேமிக்காத மாற்றங்களை நிராகரியுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సేవ్ చేసిన నోట్ మారింది. మీ డ్రాఫ్ట్ దాన్ని ఓవర్‌రైట్ చేయలేదు. డ్రాఫ్ట్‌ను కొత్త నోట్‌గా సేవ్ చేయండి లేదా సేవ్ చేయని మార్పులను విస్మరించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โน้ตที่บันทึกไว้เปลี่ยนไป ฉบับร่างของคุณไม่ได้เขียนทับ บันทึกฉบับร่างเป็นโน้ตใหม่หรือละทิ้งการเปลี่ยนแปลงที่ยังไม่บันทึก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlı not değişti. Taslağın üzerine yazılmadı. Taslağı yeni not olarak kaydet veya değişiklikleri sil."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збережена нотатка змінилася. Чернетка її не перезаписала. Збережіть її як нову нотатку або скасуйте зміни."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "محفوظ نوٹ بدل گیا ہے۔ آپ کے ڈرافٹ نے اسے اوور رائٹ نہیں کیا۔ ڈرافٹ کو نئے نوٹ کے طور پر محفوظ کریں یا غیر محفوظ تبدیلیاں رد کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi chú đã lưu đã thay đổi. Bản nháp của bạn không ghi đè lên nó. Hãy lưu bản nháp thành ghi chú mới hoặc bỏ các thay đổi chưa lưu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存的笔记发生了变化，草稿未将其覆盖。请另存为新笔记或放弃未保存的更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已儲存的備忘錄已更改。你的草稿沒有覆蓋它。請將草稿儲存為新備忘錄，或捨棄未儲存的更改。"
          }
        }
      }
    },
