    "vault_progress_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُرجى إبقاء PhotoMaid مفتوحًا. مغادرة التطبيق توقف العملية، ولا يُحذف أي شيء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte PhotoMaid geöffnet lassen. Beim Verlassen wird abgebrochen; dabei wird nichts gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please keep PhotoMaid open. Leaving the app stops the process; nothing is deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén PhotoMaid abierto. Si sales de la app, el proceso se detiene; no se elimina nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde PhotoMaid ouvert. Quitter l’app interrompt l’opération ; rien n’est supprimé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni aperto PhotoMaid. Uscire dall’app interrompe l’operazione; non viene eliminato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaidを開いたままにしてください。アプリを離れると処理が中止されますが、何も削除されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid를 열어 두세요. 앱을 나가면 작업이 중단되며, 아무것도 삭제되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd PhotoMaid open. Als je de app verlaat, stopt het proces; er wordt niets verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie zamykaj PhotoMaid. Opuszczenie aplikacji przerywa proces; nic nie zostanie usunięte."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém o PhotoMaid aberto. Sair da app interrompe o processo; nada é apagado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ține PhotoMaid deschis. Dacă ieși din aplicație, procesul se oprește; nu se șterge nimic."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не закрывай PhotoMaid. При выходе из приложения процесс прервётся; ничего не удалится."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lütfen PhotoMaid’i açık tut. Uygulamadan çıkarsan işlem durur; hiçbir şey silinmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не закривай PhotoMaid. Якщо вийти з програми, процес зупиниться; нічого не буде видалено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请保持 PhotoMaid 打开。离开 App 会中止此过程，但不会删除任何内容。"
          }
        }
      }
    },
