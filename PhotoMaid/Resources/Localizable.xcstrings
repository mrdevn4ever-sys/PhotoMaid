      }
    },
    "backup_privacy": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتوي الملف على أسماء الملفات والوسوم والملاحظات. احفظه فقط حيث تريد – على ذاكرة USB مثلًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফাইলটিতে ফাইলের নাম, ট্যাগ ও নোট থাকে। শুধু যেখানে চান সেখানেই সংরক্ষণ করুন – যেমন USB ড্রাইভে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El fitxer conté noms de fitxers, etiquetes i notes. Desa’l només on vulguis, per exemple en un llapis USB."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Soubor obsahuje názvy souborů, štítky a poznámky. Uložte ho jen tam, kde chcete – například na USB disk."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen indeholder filnavne, tags og noter. Gem den kun, hvor du vil – f.eks. på en USB-nøgle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei enthält Dateinamen, Schlagwörter und Notizen. Speichere sie nur dort, wo du sie haben willst – zum Beispiel auf einem USB-Stick."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το αρχείο περιέχει ονόματα αρχείων, ετικέτες και σημειώσεις. Αποθήκευσέ το μόνο όπου θέλεις – π.χ. σε στικάκι USB."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file contains file names, tags and notes. Save it only where you want it – on a USB drive, for example."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo contiene nombres de archivo, etiquetas y notas. Guárdalo solo donde quieras, por ejemplo en una memoria USB."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiedosto sisältää tiedostonimiä, tunnisteita ja muistiinpanoja. Tallenna se vain sinne, minne haluat – esimerkiksi USB-tikulle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier contient des noms de fichiers, des mots-clés et des notes. Enregistrez-le seulement là où vous le souhaitez, par exemple sur une clé USB."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ ફાઇલમાં ફાઇલનાં નામ, ટૅગ અને નોંધો છે. તેને ફક્ત તમે ઇચ્છો ત્યાં જ સાચવો – દા.ત. USB ડ્રાઇવ પર."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקובץ מכיל שמות קבצים, תגיות והערות. כדאי לשמור אותו רק במקום שבו רוצים – למשל בדיסק און קי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस फ़ाइल में फ़ाइल नाम, टैग और नोट हैं। इसे सिर्फ़ वहीं सहेजें जहाँ आप चाहें – जैसे USB ड्राइव पर।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Datoteka sadrži nazive datoteka, oznake i bilješke. Spremi je samo tamo gdje želiš – npr. na USB stick."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fájl fájlneveket, címkéket és jegyzeteket tartalmaz. Csak oda mentsd, ahová szeretnéd – például pendrive-ra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File ini berisi nama file, tag, dan catatan. Simpan hanya di tempat yang kamu inginkan – misalnya di flashdisk USB."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file contiene nomi di file, tag e note. Salvalo solo dove vuoi, ad esempio su una chiavetta USB."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルにはファイル名、タグ、メモが含まれます。保存先は自分で決めた場所だけに（例：USBメモリ）。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಫೈಲ್‌ನಲ್ಲಿ ಫೈಲ್ ಹೆಸರುಗಳು, ಟ್ಯಾಗ್‌ಗಳು ಮತ್ತು ಟಿಪ್ಪಣಿಗಳಿರುತ್ತವೆ. ನೀವು ಬಯಸುವಲ್ಲಿ ಮಾತ್ರ ಉಳಿಸಿ – ಉದಾಹರಣೆಗೆ USB ಡ್ರೈವ್‌ನಲ್ಲಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일에는 파일 이름, 태그, 메모가 들어 있어요. 원하는 곳에만 저장하세요(예: USB)."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഫയലിൽ ഫയൽ പേരുകൾ, ടാഗുകൾ, കുറിപ്പുകൾ എന്നിവയുണ്ട്. നിങ്ങൾ ആഗ്രഹിക്കുന്നിടത്ത് മാത്രം സംരക്ഷിക്കുക – ഉദാഹരണത്തിന് USB ഡ്രൈവിൽ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या फाइलमध्ये फाइलची नावे, टॅग आणि नोंदी आहेत. ती फक्त तुम्हाला हवी तिथेच जतन करा – उदा. USB ड्राइव्हवर."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Fail ini mengandungi nama fail, tag dan nota. Simpan hanya di tempat yang anda mahu – contohnya pada pemacu USB."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen inneholder filnavn, etiketter og notater. Lagre den bare der du vil – for eksempel på en minnepinne."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het bestand bevat bestandsnamen, labels en notities. Sla het alleen op waar jij het wilt – bijvoorbeeld op een USB-stick."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଫାଇଲ୍‌ରେ ଫାଇଲ୍ ନାମ, ଟ୍ୟାଗ୍ ଓ ନୋଟ୍ ଅଛି। କେବଳ ଯେଉଁଠି ଚାହାଁନ୍ତି ସେଠାରେ ସେଭ୍ କରନ୍ତୁ – ଯେପରି USB ଡ୍ରାଇଭ୍‌ରେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਫ਼ਾਈਲ ਵਿੱਚ ਫ਼ਾਈਲਾਂ ਦੇ ਨਾਮ, ਟੈਗ ਅਤੇ ਨੋਟ ਹਨ। ਇਸਨੂੰ ਸਿਰਫ਼ ਉੱਥੇ ਹੀ ਸੰਭਾਲੋ ਜਿੱਥੇ ਤੁਸੀਂ ਚਾਹੋ – ਜਿਵੇਂ USB ਡਰਾਈਵ ਉੱਤੇ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plik zawiera nazwy plików, tagi i notatki. Zapisz go tylko tam, gdzie chcesz – na przykład na pendrivie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo contém nomes de arquivos, etiquetas e notas. Salve-o só onde você quiser – num pendrive, por exemplo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O ficheiro contém nomes de ficheiros, etiquetas e notas. Guarde-o apenas onde quiser – por exemplo, numa pen USB."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fișierul conține nume de fișiere, etichete și note. Salvează-l doar unde vrei – de exemplu pe un stick USB."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл содержит имена файлов, метки и заметки. Сохраняйте его только там, где хотите, — например, на USB-накопителе."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Súbor obsahuje názvy súborov, štítky a poznámky. Uložte ho len tam, kde chcete – napríklad na USB kľúč."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Datoteka vsebuje imena datotek, oznake in zapiske. Shrani jo le tja, kamor želiš – na primer na ključek USB."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen innehåller filnamn, taggar och anteckningar. Spara den bara där du vill – på ett USB-minne, till exempel."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கோப்பில் கோப்புப் பெயர்கள், குறிச்சொற்கள், குறிப்புகள் உள்ளன. நீங்கள் விரும்பும் இடத்தில் மட்டும் சேமியுங்கள் – எ.கா. USB டிரைவில்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫైల్‌లో ఫైల్ పేర్లు, ట్యాగ్‌లు, నోట్‌లు ఉంటాయి. మీకు కావలసిన చోట మాత్రమే సేవ్ చేయండి – ఉదాహరణకు USB డ్రైవ్‌లో."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์นี้มีชื่อไฟล์ แท็ก และโน้ต บันทึกไว้เฉพาะที่ที่คุณต้องการ – เช่น ในแฟลชไดรฟ์ USB"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyada dosya adları, etiketler ve notlar bulunur. Yalnızca istediğin yere kaydet – örneğin bir USB belleğe."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл містить назви файлів, мітки й нотатки. Зберігайте його лише там, де хочете, — наприклад, на USB-накопичувачі."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس فائل میں فائلوں کے نام، ٹیگز اور نوٹس ہیں۔ اسے صرف وہیں محفوظ کریں جہاں آپ چاہیں – مثلاً USB ڈرائیو پر۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp chứa tên tệp, thẻ và ghi chú. Chỉ lưu ở nơi bạn muốn – ví dụ trên USB."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该文件包含文件名、标签和备注。只保存在你想要的位置，例如 U 盘。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案包含檔名、標籤和備註。只存放在你想要的地方 – 例如 USB 隨身碟。"
          }
        }
      }
    },
