          "stringUnit": {
            "state": "translated",
            "value": "Rellena el nuevo formato; se recortan los bordes sobrantes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Täyttää uuden muodon; ulkopuolelle jäävät reunat rajataan pois."
