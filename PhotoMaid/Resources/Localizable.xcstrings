    "files_none_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر مجلدًا لمراجعة ملفاته في PhotoMaid."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Ordner aus, um seine Dateien in PhotoMaid durchzusehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a folder to review its files in PhotoMaid."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una carpeta para revisar sus archivos en PhotoMaid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis un dossier pour passer ses fichiers en revue dans PhotoMaid."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una cartella per controllarne i file in PhotoMaid."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダを選ぶと、中のファイルをPhotoMaidで確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더를 선택하면 PhotoMaid에서 그 안의 파일을 확인할 수 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een map om de bestanden in PhotoMaid te bekijken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz folder, aby przejrzeć jego pliki w PhotoMaid."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe uma pasta para reveres os respetivos ficheiros no PhotoMaid."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege un dosar pentru a-i verifica fișierele în PhotoMaid."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбери папку, чтобы просмотреть её файлы в PhotoMaid."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyalarını PhotoMaid içinde incelemek için bir klasör seç."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибери папку, щоб переглянути її файли в PhotoMaid."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一个文件夹，即可在 PhotoMaid 中查看里面的文件。"
          }
        }
      }
    },
    "files_none_tip": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن اختيار مجلد التنزيلات نفسه هنا. اختر مجلدًا فرعيًا داخله بدلًا منه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Download-Ordner lässt sich hier nicht auswählen. Wähle stattdessen einen Unterordner darin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Downloads folder can’t be selected here. Choose a subfolder inside it instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No puedes seleccionar la carpeta Descargas aquí. Elige una subcarpeta dentro de ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier Téléchargements ne peut pas être sélectionné ici. Choisis plutôt un sous-dossier à l’intérieur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui non puoi selezionare la cartella Download. Scegli invece una sottocartella al suo interno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここではダウンロードフォルダ自体を選べません。その中のサブフォルダを選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기서는 다운로드 폴더 자체를 선택할 수 없어요. 그 안의 하위 폴더를 선택해 주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De map Downloads kan hier niet worden gekozen. Kies in plaats daarvan een submap daarin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można tu wybrać folderu Pobrane. Wybierz podfolder w jego wnętrzu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não podes selecionar a pasta Transferências aqui. Escolhe uma subpasta dentro dela."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosarul Descărcări nu poate fi selectat aici. Alege un subdosar din interiorul lui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Папку Загрузки здесь выбрать нельзя. Выбери вложенную папку в ней."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İndirilenler klasörü burada seçilemez. Bunun yerine içindeki bir alt klasörü seç."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Папку Завантаження не можна вибрати тут. Вибери вкладену папку в ній."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里不能直接选择“下载”文件夹。请选择其中的子文件夹。"
          }
        }
      }
