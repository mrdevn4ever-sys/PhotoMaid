    "archive_reason_write": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفضت الوجهة الحفظ (ممتلئة أو محمية من الكتابة أو الملف كبير جدًا لهذا الوسيط)"
