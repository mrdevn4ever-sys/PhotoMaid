            "value": "ବହୁତ ସମାନ ଦେଖାଯାଉଥିବା ଫଟୋ, ପାଖାପାଖି"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਬਹੁਤ ਮਿਲਦੀਆਂ-ਜੁਲਦੀਆਂ ਫ਼ੋਟੋਆਂ, ਨਾਲ-ਨਾਲ"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bardzo podobne zdjęcia obok siebie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos muito semelhantes, lado a lado"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografias muito parecidas, lado a lado"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografii foarte asemănătoare, una lângă alta"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очень похожие фото рядом"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotky, ktoré vyzerajú veľmi podobne, vedľa seba"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografije, ki so si zelo podobne, druga ob drugi"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilder som ser väldigt lika ut, sida vid sida"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மிகவும் ஒத்த புகைப்படங்கள், அருகருகே"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చాలా ఒకేలా కనిపించే ఫోటోలు, పక్కపక్కనే"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปที่ดูคล้ายกันมาก วางเทียบกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birbirine çok benzeyen fotoğraflar yan yana"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дуже схожі фото поруч"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بہت ملتی جلتی تصاویر، ساتھ ساتھ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những ảnh trông rất giống nhau, đặt cạnh nhau"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "非常相似的照片并排比较"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "非常相像的照片，並排顯示"
          }
        }
      }
    },
