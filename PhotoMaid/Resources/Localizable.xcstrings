    "pro2_active_sub": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم الشراء مرة واحدة: بلا إعلانات، بلا حد يومي، ومجلدات الخزنة بلا إعلانات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একবার কেনা: কোনো বিজ্ঞাপন নেই, দৈনিক সীমা নেই এবং বিজ্ঞাপন ছাড়া ভল্ট ফোল্ডার।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprat un sol cop: sense anuncis, sense límit diari i carpetes de la caixa forta sense anuncis."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakoupeno jednorázově: bez reklam, bez denního limitu a složky trezoru bez reklam."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Købt én gang: ingen reklamer, ingen daglig grænse og boksmapper uden reklamer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmal gekauft: ohne Werbung, ohne Tageslimit und Tresor-Ordner ohne Werbung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αγορά μία φορά: χωρίς διαφημίσεις, χωρίς ημερήσιο όριο και φάκελοι θησαυροφυλακίου χωρίς διαφημίσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Purchased once: no ads, no daily limit and vault folders without ads."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprado una vez: sin anuncios, sin límite diario y carpetas de la caja fuerte sin anuncios."
          }
