        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ട്രാഷിലേക്ക് – ഒന്നും ഇല്ലാതാക്കില്ല. പിന്നീട് അവിടെ നിങ്ങൾ തീരുമാനിക്കും."
          }
