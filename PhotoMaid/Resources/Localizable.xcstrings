    "privacy_purchases": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتم المشتريات عبر App Store من Apple. لا يرسل PhotoMaid صورك أو أسماءها أو بياناتها الوصفية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Käufe laufen über Apples App Store. PhotoMaid überträgt dafür nie Fotos, Namen oder Metadaten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Purchases use Apple’s App Store. PhotoMaid never sends your photos, names or metadata for this."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las compras usan el App Store de Apple. PhotoMaid nunca envía tus fotos, nombres ni metadatos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les achats passent par l’App Store d’Apple. PhotoMaid n’envoie jamais vos photos, noms ou métadonnées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli acquisti usano l’App Store di Apple. PhotoMaid non invia mai foto, nomi o metadati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入にはAppleのApp Storeを使用します。PhotoMaidが写真、名前、メタデータを送信することはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매는 Apple App Store를 사용합니다. PhotoMaid는 사진, 이름 또는 메타데이터를 전송하지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aankopen lopen via Apples App Store. PhotoMaid verstuurt hiervoor nooit foto’s, namen of metadata."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakupy odbywają się przez App Store Apple. PhotoMaid nigdy nie wysyła zdjęć, nazw ani metadanych."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As compras usam a App Store da Apple. O PhotoMaid nunca envia fotografias, nomes ou metadados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Achizițiile folosesc App Store Apple. PhotoMaid nu trimite niciodată poze, nume sau metadate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покупки проходят через App Store Apple. PhotoMaid никогда не отправляет фотографии, имена или метаданные."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satın alımlar Apple App Store üzerinden yapılır. PhotoMaid fotoğraf, ad veya meta veri göndermez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Покупки здійснюються через App Store Apple. PhotoMaid ніколи не надсилає фото, назви чи метадані."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "购买通过 Apple App Store 完成。PhotoMaid 绝不会为此发送照片、名称或元数据。"
          }
        }
      }
    },
    "privacy_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يطّلع PhotoMaid على صورك ومقاطع الفيديو والملفات المسموح بها على جهازك فقط. لا تحتاج إلى حساب، ولا يوجد خادم لـ PhotoMaid. من المفيد أن تعرف: مع الخدمات السحابية مثل صور Google قد يختفي ما تحذفه من أجهزتك الأخرى أيضًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid sieht sich deine Fotos, Videos und freigegebenen Dateien nur auf deinem Gerät an. Du brauchst kein Konto, und es gibt keinen PhotoMaid-Server. Gut zu wissen: Bei Cloud-Diensten wie Google Fotos kann Gelöschtes auch auf deinen anderen Geräten verschwinden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid looks at your photos, videos and allowed files only on your device. You don’t need an account, and there’s no PhotoMaid server. Good to know: with cloud services like Google Photos, things you delete may also disappear on your other devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid mira tus fotos, vídeos y archivos permitidos solo en tu dispositivo. No necesitas cuenta y no hay servidor de PhotoMaid. Ten en cuenta que con servicios en la nube como Google Fotos lo que borres puede desaparecer también en tus otros dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid consulte vos photos, vidéos et fichiers autorisés uniquement sur votre appareil. Pas besoin de compte, et il n’y a pas de serveur PhotoMaid. Bon à savoir : avec des services cloud comme Google Photos, ce que vous supprimez peut aussi disparaître de vos autres appareils."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid guarda foto, video e file consentiti solo sul tuo dispositivo. Non serve un account e non esiste un server PhotoMaid. Buono a sapersi: con servizi cloud come Google Foto ciò che elimini può sparire anche sugli altri dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid は写真・動画・許可したファイルを端末の中だけで扱います。アカウントは不要で、PhotoMaid のサーバーもありません。なお、Google フォトなどのクラウドでは、削除したものがほかの端末からも消えることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid는 사진, 동영상, 허용한 파일을 기기 안에서만 봐요. 계정이 필요 없고 PhotoMaid 서버도 없어요. 참고: Google 포토 같은 클라우드에서는 지운 것이 다른 기기에서도 사라질 수 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid bekijkt je foto’s, video’s en toegestane bestanden alleen op je apparaat. Je hebt geen account nodig en er is geen PhotoMaid-server. Goed om te weten: bij clouddiensten zoals Google Foto kan wat je verwijdert ook op je andere apparaten verdwijnen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid przegląda zdjęcia, filmy i dozwolone pliki tylko na Twoim urządzeniu. Nie potrzebujesz konta i nie ma serwera PhotoMaid. Warto wiedzieć: w usługach chmurowych, takich jak Zdjęcia Google, usunięte rzeczy mogą zniknąć też z innych urządzeń."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O PhotoMaid vê as suas fotos, vídeos e ficheiros permitidos apenas no seu dispositivo. Não precisa de conta e não existe servidor PhotoMaid. É bom saber: em serviços na nuvem como o Google Fotos, o que eliminar pode desaparecer também nos outros dispositivos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid se uită la fotografiile, videoclipurile și fișierele permise doar pe dispozitivul tău. Nu ai nevoie de cont și nu există server PhotoMaid. Bine de știut: la servicii cloud precum Google Foto, ce ștergi poate dispărea și de pe celelalte dispozitive."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid просматривает ваши фото, видео и разрешённые файлы только на устройстве. Аккаунт не нужен, и сервера PhotoMaid нет. Полезно знать: в облачных сервисах вроде Google Фото удалённое может исчезнуть и на других устройствах."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid fotoğraflarına, videolarına ve izin verdiğin dosyalara yalnızca cihazında bakar. Hesap gerekmez ve PhotoMaid sunucusu yoktur. Bilmekte fayda var: Google Fotoğraflar gibi bulut hizmetlerinde sildiklerin diğer cihazlarından da kaybolabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid переглядає ваші фото, відео й дозволені файли лише на пристрої. Обліковий запис не потрібен, і сервера PhotoMaid немає. Варто знати: у хмарних сервісах, як-от Google Фото, видалене може зникнути й на інших пристроях."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid 只在你的设备上查看照片、视频和你允许的文件。无需账户，也没有 PhotoMaid 服务器。请注意：在 Google 相册等云服务中，你删除的内容也可能从其他设备上消失。"
          }
        }
      }
    },
