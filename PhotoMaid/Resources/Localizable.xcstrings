    "tools_fmt_heic_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملفات أصغر، لكن لا تفتحها كل الأجهزة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleinere Dateien, aber nicht jedes Gerät kann sie öffnen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Smaller files, but not every device can open them"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivos más pequeños, pero no todos los dispositivos los abren"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichiers plus légers, mais tous les appareils ne les ouvrent pas"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "File più piccoli, ma non tutti i dispositivi li aprono"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルは小さいですが、開けない機器もあります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일이 작지만 일부 기기에서는 열리지 않아요"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleinere bestanden, maar niet elk apparaat opent ze"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mniejsze pliki, ale nie każde urządzenie je otworzy"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ficheiros mais pequenos, mas nem todos os dispositivos os abrem"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fișiere mai mici, dar nu orice dispozitiv le deschide"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлы меньше, но открываются не на всех устройствах"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha küçük dosyalar, ancak her cihaz açamaz"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Менші файли, але відкриваються не на всіх пристроях"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件更小，但并非所有设备都能打开"
          }
        }
      }
    },
    "tools_fmt_jpeg_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُفتح على كل جهاز وفي كل تطبيق"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet jedes Gerät und jede App"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens on every device and in every app"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se abre en cualquier dispositivo y app"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’ouvre sur tous les appareils et dans toutes les apps"
          }
        },
        "it": {
          "stringUnit": {
