    "privacy_ads": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعرض النسخة المجانية إعلانات من Google. يمكنك تغيير موافقتك في الإعدادات. لا تصل صورك أو أسماؤها أو مجلداتها أو أي بيانات مستخلصة منها إلى المعلنين أبدًا. لا إعلانات مع Pro."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিনামূল্যের সংস্করণ Google-এর বিজ্ঞাপন দেখায়। সেটিংসে আপনার সম্মতি বদলাতে পারেন। আপনার ফটো, তাদের নাম, ফোল্ডার বা সেগুলো থেকে পাওয়া কিছুই কখনো বিজ্ঞাপনদাতাদের কাছে যায় না। Pro-তে কোনো বিজ্ঞাপন নেই।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La versió gratuïta mostra anuncis de Google. Pots canviar el consentiment a la configuració. Les teves fotos, els seus noms, carpetes o qualsevol cosa que se’n derivi mai no van als proveïdors d’anuncis. Pro no té anuncis."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezplatná verze zobrazuje reklamy od Googlu. Souhlas můžete změnit v nastavení. Vaše fotky, jejich názvy, složky ani nic z nich odvozeného se nikdy nedostanou k poskytovatelům reklam. Pro je bez reklam."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratisversionen viser reklamer fra Google. Du kan ændre dit samtykke i indstillingerne. Dine fotos, deres navne, mapper eller noget afledt af dem går aldrig til reklameudbydere. Pro har ingen reklamer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der kostenlosen Version gibt es Werbung von Google. Deine Einwilligung dazu kannst du in den Einstellungen ändern. Deine Fotos, ihre Namen, Ordner oder Angaben daraus gehen nie an Werbeanbieter. Mit Pro gibt es keine Werbung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η δωρεάν έκδοση εμφανίζει διαφημίσεις της Google. Μπορείς να αλλάξεις τη συγκατάθεσή σου στις ρυθμίσεις. Οι φωτογραφίες σου, τα ονόματά τους, οι φάκελοι ή οτιδήποτε προκύπτει από αυτά δεν πηγαίνουν ποτέ σε παρόχους διαφημίσεων. Το Pro δεν έχει διαφημίσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The free version shows ads from Google. You can change your consent in settings. Your photos, their names, folders or anything derived from them never go to ad providers. Pro has no ads."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La versión gratuita muestra anuncios de Google. Puedes cambiar tu consentimiento en Ajustes. Tus fotos, sus nombres, carpetas o lo que se obtenga de ellas nunca llegan a los anunciantes. Con Pro no hay anuncios."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmaisversio näyttää Googlen mainoksia. Voit muuttaa suostumustasi asetuksissa. Kuvasi, niiden nimet, kansiot tai mikään niistä johdettu ei koskaan päädy mainostajille. Prossa ei ole mainoksia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La version gratuite affiche des publicités Google. Vous pouvez modifier votre consentement dans les paramètres. Vos photos, leurs noms, dossiers ou toute information qui en est tirée ne vont jamais aux régies publicitaires. Avec Pro, pas de publicité."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "મફત વર્ઝન Google ની જાહેરાતો બતાવે છે. તમે સેટિંગ્સમાં તમારી સંમતિ બદલી શકો છો. તમારા ફોટા, તેમનાં નામ, ફોલ્ડર કે તેમાંથી મળેલું કંઈ પણ ક્યારેય જાહેરાત પ્રદાતાઓને જતું નથી. Pro માં જાહેરાતો નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגרסה החינמית מציגה פרסומות של Google. אפשר לשנות את ההסכמה בהגדרות. התמונות שלך, השמות שלהן, התיקיות או כל דבר שנגזר מהן אף פעם לא עוברים לספקי פרסום. ב-Pro אין פרסומות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मुफ़्त वर्शन Google के विज्ञापन दिखाता है। आप सेटिंग्ज़ में अपनी सहमति बदल सकते हैं। आपकी फ़ोटो, उनके नाम, फ़ोल्डर या उनसे निकली कोई जानकारी कभी विज्ञापन प्रदाताओं को नहीं जाती। Pro में विज्ञापन नहीं हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Besplatna verzija prikazuje Googleove oglase. Privolu možeš promijeniti u postavkama. Tvoje fotografije, njihovi nazivi, mape ili bilo što izvedeno iz njih nikad ne idu pružateljima oglasa. Pro nema oglasa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az ingyenes verzió a Google hirdetéseit jeleníti meg. A hozzájárulásodat a beállításokban módosíthatod. A fotóid, a nevük, a mappák vagy bármi, ami belőlük származik, sosem jut el a hirdetési szolgáltatókhoz. A Pro hirdetésmentes."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Versi gratis menampilkan iklan dari Google. Kamu bisa mengubah persetujuanmu di pengaturan. Fotomu, namanya, folder, atau apa pun yang berasal darinya tidak pernah dikirim ke penyedia iklan. Pro tanpa iklan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La versione gratuita mostra pubblicità di Google. Puoi cambiare il consenso nelle impostazioni. Le tue foto, i loro nomi, le cartelle o dati ricavati da esse non arrivano mai agli inserzionisti. Con Pro niente pubblicità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料版では Google の広告が表示されます。同意は設定で変更できます。写真、その名前やフォルダ、写真から得た情報が広告会社に渡ることはありません。Pro では広告は表示されません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಉಚಿತ ಆವೃತ್ತಿ Google ನ ಜಾಹೀರಾತುಗಳನ್ನು ತೋರಿಸುತ್ತದೆ. ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ನಿಮ್ಮ ಸಮ್ಮತಿಯನ್ನು ಬದಲಾಯಿಸಬಹುದು. ನಿಮ್ಮ ಫೋಟೋಗಳು, ಅವುಗಳ ಹೆಸರುಗಳು, ಫೋಲ್ಡರ್‌ಗಳು ಅಥವಾ ಅವುಗಳಿಂದ ಪಡೆದ ಯಾವುದೂ ಎಂದಿಗೂ ಜಾಹೀರಾತು ಪೂರೈಕೆದಾರರಿಗೆ ಹೋಗುವುದಿಲ್ಲ. Pro ನಲ್ಲಿ ಜಾಹೀರಾತುಗಳಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 버전에는 Google 광고가 나와요. 동의는 설정에서 바꿀 수 있어요. 사진, 사진 이름, 폴더나 사진에서 얻은 정보는 광고 업체에 절대 가지 않아요. Pro에는 광고가 없어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സൗജന്യ പതിപ്പ് Google-ന്റെ പരസ്യങ്ങൾ കാണിക്കുന്നു. ക്രമീകരണങ്ങളിൽ നിങ്ങളുടെ സമ്മതം മാറ്റാം. നിങ്ങളുടെ ഫോട്ടോകൾ, അവയുടെ പേരുകൾ, ഫോൾഡറുകൾ അല്ലെങ്കിൽ അവയിൽ നിന്ന് ലഭിക്കുന്ന ഒന്നും ഒരിക്കലും പരസ്യ ദാതാക്കളിലേക്ക് പോകില്ല. Pro-യിൽ പരസ്യങ്ങളില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "विनामूल्य आवृत्ती Google च्या जाहिराती दाखवते. सेटिंग्जमध्ये तुम्ही तुमची संमती बदलू शकता. तुमचे फोटो, त्यांची नावे, फोल्डर किंवा त्यातून मिळालेली कोणतीही माहिती कधीही जाहिरात पुरवठादारांकडे जात नाही. Pro मध्ये जाहिराती नाहीत."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Versi percuma memaparkan iklan daripada Google. Anda boleh menukar persetujuan anda dalam seting. Foto anda, namanya, folder atau apa-apa yang diperoleh daripadanya tidak pernah dihantar kepada penyedia iklan. Pro tiada iklan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratisversjonen viser annonser fra Google. Du kan endre samtykket ditt i innstillingene. Bildene dine, navnene på dem, mapper eller noe som er avledet fra dem, går aldri til annonseleverandører. Pro har ingen annonser."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De gratis versie toont advertenties van Google. Je toestemming kun je in de instellingen wijzigen. Je foto’s, hun namen, mappen of iets wat eruit is afgeleid, gaan nooit naar adverteerders. Met Pro zijn er geen advertenties."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ମାଗଣା ସଂସ୍କରଣ Googleର ବିଜ୍ଞାପନ ଦେଖାଏ। ସେଟିଂସରେ ଆପଣଙ୍କ ସମ୍ମତି ବଦଳାଇପାରିବେ। ଆପଣଙ୍କ ଫଟୋ, ସେଗୁଡ଼ିକର ନାମ, ଫୋଲ୍ଡର କିମ୍ବା ସେଥିରୁ ମିଳୁଥିବା କିଛି ବି କେବେ ବିଜ୍ଞାପନ ପ୍ରଦାତାଙ୍କ ପାଖକୁ ଯାଏ ନାହିଁ। Proରେ କୌଣସି ବିଜ୍ଞାପନ ନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮੁਫ਼ਤ ਵਰਜ਼ਨ Google ਦੇ ਇਸ਼ਤਿਹਾਰ ਦਿਖਾਉਂਦਾ ਹੈ। ਤੁਸੀਂ ਆਪਣੀ ਸਹਿਮਤੀ ਸੈਟਿੰਗਾਂ ਵਿੱਚ ਬਦਲ ਸਕਦੇ ਹੋ। ਤੁਹਾਡੀਆਂ ਫ਼ੋਟੋਆਂ, ਉਨ੍ਹਾਂ ਦੇ ਨਾਂ, ਫ਼ੋਲਡਰ ਜਾਂ ਉਨ੍ਹਾਂ ਤੋਂ ਕੱਢੀ ਕੋਈ ਵੀ ਚੀਜ਼ ਕਦੇ ਇਸ਼ਤਿਹਾਰ ਪ੍ਰਦਾਤਾਵਾਂ ਕੋਲ ਨਹੀਂ ਜਾਂਦੀ। Pro ਵਿੱਚ ਕੋਈ ਇਸ਼ਤਿਹਾਰ ਨਹੀਂ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wersja bezpłatna wyświetla reklamy Google. Zgodę możesz zmienić w ustawieniach. Twoje zdjęcia, ich nazwy, foldery ani nic z nich wyliczonego nigdy nie trafiają do reklamodawców. W Pro nie ma reklam."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A versão grátis mostra anúncios do Google. Você pode alterar seu consentimento nos ajustes. Suas fotos, os nomes delas, pastas ou qualquer coisa derivada delas nunca vão para provedores de anúncios. O Pro não tem anúncios."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A versão gratuita mostra anúncios do Google. Pode alterar o consentimento nas definições. As suas fotos, os nomes, pastas ou dados obtidos a partir delas nunca vão para anunciantes. Com Pro não há anúncios."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Versiunea gratuită afișează reclame Google. Îți poți schimba acordul în setări. Fotografiile tale, numele lor, dosarele sau ceva derivat din ele nu ajung niciodată la furnizorii de reclame. Cu Pro nu ai reclame."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В бесплатной версии показывается реклама Google. Согласие можно изменить в настройках. Ваши фото, их названия, папки и любые данные из них никогда не попадают к рекламодателям. В Pro рекламы нет."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezplatná verzia zobrazuje reklamy od Googlu. Súhlas môžete zmeniť v nastaveniach. Vaše fotky, ich názvy, priečinky ani nič z nich odvodené sa nikdy nedostanú k poskytovateľom reklám. Pro je bez reklám."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brezplačna različica prikazuje Googlove oglase. Privolitev lahko spremeniš v nastavitvah. Tvoje fotografije, njihova imena, mape ali karkoli, izpeljano iz njih, nikoli ne gredo ponudnikom oglasov. Pro je brez oglasov."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratisversionen visar annonser från Google. Du kan ändra ditt samtycke i inställningarna. Dina bilder, deras namn, mappar eller något som härleds från dem går aldrig till annonsleverantörer. Pro har inga annonser."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இலவசப் பதிப்பு Google-இன் விளம்பரங்களைக் காட்டுகிறது. அமைப்புகளில் உங்கள் ஒப்புதலை மாற்றலாம். உங்கள் புகைப்படங்கள், அவற்றின் பெயர்கள், கோப்புறைகள் அல்லது அவற்றிலிருந்து பெறப்பட்ட எதுவும் ஒருபோதும் விளம்பர வழங்குநர்களிடம் செல்லாது. Pro-வில் விளம்பரங்கள் இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఉచిత వెర్షన్ Google ప్రకటనలను చూపిస్తుంది. సెట్టింగ్‌లలో మీ సమ్మతిని మార్చవచ్చు. మీ ఫోటోలు, వాటి పేర్లు, ఫోల్డర్‌లు లేదా వాటి నుండి వచ్చిన ఏదీ ఎప్పుడూ ప్రకటన ప్రొవైడర్‌లకు వెళ్లదు. Proలో ప్రకటనలు లేవు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวอร์ชันฟรีแสดงโฆษณาจาก Google คุณเปลี่ยนความยินยอมได้ในการตั้งค่า รูปภาพ ชื่อรูป โฟลเดอร์ หรือสิ่งใดที่ได้มาจากสิ่งเหล่านี้จะไม่ถูกส่งไปยังผู้ให้บริการโฆษณา Pro ไม่มีโฆษณา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ücretsiz sürümde Google reklamları gösterilir. Onayını ayarlardan değiştirebilirsin. Fotoğrafların, adları, klasörleri veya onlardan elde edilen hiçbir bilgi reklamcılara gitmez. Pro’da reklam yoktur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У безкоштовній версії показується реклама Google. Згоду можна змінити в налаштуваннях. Ваші фото, їхні назви, папки чи будь-які дані з них ніколи не потрапляють до рекламодавців. У Pro реклами немає."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مفت ورژن Google کے اشتہارات دکھاتا ہے۔ آپ ترتیبات میں اپنی رضامندی بدل سکتے ہیں۔ آپ کی تصاویر، ان کے نام، فولڈرز یا ان سے اخذ کردہ کوئی چیز کبھی اشتہار فراہم کنندگان کو نہیں جاتی۔ Pro میں اشتہارات نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên bản miễn phí hiển thị quảng cáo từ Google. Bạn có thể thay đổi sự đồng ý trong cài đặt. Ảnh của bạn, tên ảnh, thư mục hay bất cứ thứ gì suy ra từ chúng không bao giờ được gửi cho bên quảng cáo. Pro không có quảng cáo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免费版会显示 Google 广告。你可以在设置中更改同意。你的照片、照片名称、文件夹或由其得出的任何信息都不会发给广告商。Pro 版没有广告。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "免費版會顯示 Google 的廣告。你可以在設定中更改同意選項。你的照片、照片名稱、檔案夾或從中衍生的任何內容都不會提供給廣告商。Pro 沒有廣告。"
          }
        }
      }
    },
