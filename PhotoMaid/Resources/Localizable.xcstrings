          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie przeniesiono: %1$lld. Limit sejfu w Free: %2$lld, w Pro bez limitu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não movidos: %1$lld. A versão grátis permite %2$lld itens no cofre; com o Pro é ilimitado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
