    "files_none_title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم توصيل أي مجلد بعد"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনো কোনো ফোল্ডার সংযুক্ত নয়"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Encara no hi ha cap carpeta connectada"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím není připojená žádná složka"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen mappe forbundet endnu"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch kein Ordner verbunden"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν έχει συνδεθεί φάκελος ακόμη"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No folder connected yet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay carpetas conectadas"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kansiota ei ole vielä yhdistetty"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun dossier connecté"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હજી કોઈ ફોલ્ડર જોડ્યું નથી"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עדיין לא חוברה תיקייה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कोई फ़ोल्डर नहीं जुड़ा"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Još nije povezana nijedna mapa"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még nincs csatlakoztatott mappa"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada folder tersambung"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna cartella collegata"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダはまだ接続されていません"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇನ್ನೂ ಯಾವುದೇ ಫೋಲ್ಡರ್ ಸಂಪರ್ಕಿಸಿಲ್ಲ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결한 폴더가 아직 없어요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇതുവരെ ഫോൾഡർ കണക്റ്റ് ചെയ്തിട്ടില്ല"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अजून कोणताही फोल्डर जोडलेला नाही"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada folder disambungkan"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen mappe tilkoblet ennå"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen map gekoppeld"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏପର୍ଯ୍ୟନ୍ତ କୌଣସି ଫୋଲ୍ଡର ସଂଯୁକ୍ତ ନାହିଁ"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹਾਲੇ ਕੋਈ ਫ਼ੋਲਡਰ ਕਨੈਕਟ ਨਹੀਂ"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie połączono jeszcze folderu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma pasta conectada ainda"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há pastas ligadas"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Niciun dosar conectat încă"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Папки ещё не подключены"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatiaľ nie je pripojený žiadny priečinok"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Še ni povezane mape"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen mapp ansluten ännu"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இன்னும் கோப்புறை இணைக்கப்படவில்லை"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇంకా ఫోల్డర్ కనెక్ట్ చేయలేదు"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ได้เชื่อมต่อโฟลเดอร์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz bağlı klasör yok"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ще немає підключених папок"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ابھی کوئی فولڈر منسلک نہیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa kết nối thư mục nào"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未连接文件夹"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未連接檔案夾"
          }
        }
