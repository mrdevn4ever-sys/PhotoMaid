    "tour_months_row_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر على شهر لمراجعة صوره وفيديوهاته غير المراجَعة فقط."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো মাসের শুধু বাকি ফটো ও ভিডিও পর্যালোচনা করতে সেই মাসে ট্যাপ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un mes per revisar només les fotos i els vídeos pendents."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na měsíc projdete jen jeho neprošlé fotky a videa."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på en måned for kun at gennemgå dens fotos og videoer, der endnu ikke er gennemgået."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf einen Monat, um nur dessen offene Fotos und Videos durchzusehen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάτησε έναν μήνα για να ελέγξεις μόνο τις μη ελεγμένες φωτογραφίες και βίντεό του."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a month to review only its open photos and videos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un mes para revisar solo sus fotos y vídeos pendientes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta kuukautta käydäksesi läpi vain sen läpikäymättömät kuvat ja videot."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche un mois pour ne passer en revue que ses photos et vidéos en attente."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "મહિનાના ફક્ત ન જોયેલા ફોટા અને વીડિયો જોવા તેના પર ટૅપ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקשה על חודש מאפשרת לסקור רק את התמונות והסרטונים שטרם נסקרו בו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी महीने की सिर्फ़ बिना देखी फ़ोटो और वीडियो देखने के लिए उस पर टैप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirni mjesec da pregledaš samo njegove nepregledane fotografije i videozapise."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints egy hónapra, hogy csak a még át nem nézett fotóit és videóit nézd át."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk bulan untuk meninjau hanya foto dan video yang belum ditinjau di bulan itu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca un mese per rivedere solo le sue foto e i video in sospeso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "月をタップすると、その月の未確認の写真と動画だけを見直せます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಒಂದು ತಿಂಗಳ ಬಾಕಿ ಫೋಟೋಗಳು ಮತ್ತು ವೀಡಿಯೊಗಳನ್ನು ಮಾತ್ರ ಪರಿಶೀಲಿಸಲು ಆ ತಿಂಗಳನ್ನು ಟ್ಯಾಪ್ ಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "월을 탭하면 그 달의 남은 사진과 동영상만 볼 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരു മാസത്തിലെ ബാക്കിയുള്ള ഫോട്ടോകളും വീഡിയോകളും മാത്രം പരിശോധിക്കാൻ ആ മാസം ടാപ്പ് ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "महिन्याचे फक्त न पाहिलेले फोटो आणि व्हिडिओ पाहण्यासाठी त्यावर टॅप करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik bulan untuk menyemak hanya foto dan video yang belum disemak dalamnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på en måned for å gå gjennom bare månedens bilder og videoer som du ennå ikke har gått gjennom."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op een maand om alleen de openstaande foto’s en video’s te bekijken."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "କେବଳ ଏକ ମାସର ବାକି ଫଟୋ ଓ ଭିଡିଓ ସମୀକ୍ଷା କରିବାକୁ ସେହି ମାସରେ ଟାପ୍ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕਿਸੇ ਮਹੀਨੇ ਦੀਆਂ ਸਿਰਫ਼ ਬਾਕੀ ਫ਼ੋਟੋਆਂ ਅਤੇ ਵੀਡੀਓ ਦੀ ਸਮੀਖਿਆ ਲਈ ਉਸ ਉੱਤੇ ਟੈਪ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotknij miesiąca, aby przejrzeć tylko jego nieprzejrzane zdjęcia i filmy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque num mês para revisar só as fotos e vídeos em aberto dele."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca num mês para rever só as fotos e vídeos pendentes."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge o lună ca să revizuiești doar fotografiile și videoclipurile rămase."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажми на месяц, чтобы просмотреть только его непросмотренные фото и видео."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na mesiac prezriete len jeho neprezreté fotky a videá."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapni mesec, da pregledaš le njegove nepregledane fotografije in videoposnetke."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på en månad för att bara gå igenom dess bilder och videor som du inte har gått igenom än."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு மாதத்தின் மீதமுள்ள புகைப்படங்களையும் வீடியோக்களையும் மட்டும் பார்வையிட அந்த மாதத்தைத் தட்டுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఒక నెలలోని మిగిలిన ఫోటోలు, వీడియోలను మాత్రమే సమీక్షించడానికి ఆ నెలను ట్యాప్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะเดือนเพื่อตรวจดูเฉพาะรูปภาพและวิดีโอที่ยังค้างของเดือนนั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca o ayın bekleyen fotoğraf ve videolarını gözden geçirmek için bir aya dokun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкнись місяця, щоб переглянути лише його непереглянуті фото й відео."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کسی مہینے کی صرف غیر جائزہ شدہ تصاویر اور ویڈیوز دیکھنے کے لیے اس پر ٹیپ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm vào một tháng để chỉ xem những ảnh và video của tháng đó mà bạn chưa xem lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按月份，只查看该月未查看的照片和视频。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下月份，只整理該月份尚未整理的照片和影片。"
          }
        }
      }
    },
    "tour_months_row_title": {
