    "dup_footer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حجم النسخ المحددة: حتى %1$@. قد لا يساوي ذلك المساحة التي تتحرر. راجع المفضلة والألبومات والتعديلات قبل إزالة النسخ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgewählte Kopien: bis zu %1$@. Das ist nicht unbedingt der Speicher, der frei wird. Prüfe auch Favoriten, Alben und Bearbeitungen, bevor du Kopien entfernst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected copies: up to %1$@. This may not equal the space freed. Check favorites, albums and edits before removing copies."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copias seleccionadas: hasta %1$@. Puede no coincidir con el espacio que se libera. Revisa también favoritos, álbumes y ediciones antes de quitar copias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copies sélectionnées : jusqu’à %1$@. L’espace libéré peut être différent. Vérifie aussi les favoris, albums et retouches avant de retirer des copies."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie selezionate: fino a %1$@. Lo spazio liberato potrebbe essere diverso. Controlla anche preferiti, album e modifiche prima di rimuovere le copie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選んだコピー：最大%1$@。実際に空く容量とは異なる場合があります。削除する前に、お気に入り、アルバム、編集内容を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 사본: 최대 %1$@. 실제로 확보되는 공간은 다를 수 있어요. 사본을 삭제하기 전에 즐겨찾기, 앨범, 편집 내용을 확인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geselecteerde kopieën: maximaal %1$@. De vrijgekomen ruimte kan hiervan afwijken. Controleer ook favorieten, albums en bewerkingen voordat je kopieën verwijdert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybrane kopie: do %1$@. Zwolnione miejsce może mieć inną wielkość. Przed usunięciem kopii sprawdź też ulubione, albumy i edycje."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cópias selecionadas: até %1$@. O espaço libertado pode ser diferente. Verifica também favoritos, álbuns e edições antes de remover cópias."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Copii selectate: până la %1$@. Spațiul eliberat poate fi diferit. Verifică și favoritele, albumele și editările înainte de a elimina copii."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбранные копии: до %1$@. Объём свободного места может увеличиться на другую величину. Перед удалением копий проверь также избранное, альбомы и правки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen kopyalar: en fazla %1$@. Açılacak alan bundan farklı olabilir. Kopyaları kaldırmadan önce favorileri, albümleri ve düzenlemeleri de kontrol et."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибрані копії: до %1$@. Звільнене місце може мати інший обсяг. Перед видаленням копій перевір також обране, альбоми й редагування."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已选副本最多 %1$@，不一定等于实际释放的空间。移除副本前，请检查收藏、相册和编辑内容。"
          }
        }
      }
    },
