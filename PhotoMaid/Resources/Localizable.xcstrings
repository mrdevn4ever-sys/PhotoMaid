    "vault_ad_folder_dismissed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُغلق الإعلان مبكرًا. لم يُنشأ أي مجلد – يمكنك المحاولة مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিজ্ঞাপনটি আগেই বন্ধ হয়ে গেছে। কোনো ফোল্ডার তৈরি হয়নি – আবার চেষ্টা করতে পারেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’anunci s’ha tancat abans d’hora. No s’ha creat cap carpeta; ho pots tornar a provar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Reklama byla zavřena předčasně. Složka nebyla vytvořena – můžete to zkusit znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Reklamen blev lukket for tidligt. Der blev ikke oprettet nogen mappe – du kan prøve igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Werbung wurde vorzeitig geschlossen. Es wurde kein Ordner angelegt – du kannst es erneut versuchen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η διαφήμιση έκλεισε νωρίς. Δεν δημιουργήθηκε φάκελος – μπορείς να ξαναδοκιμάσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The ad was closed early. No folder was created – you can try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El anuncio se cerró antes de tiempo. No se creó ninguna carpeta; puedes intentarlo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mainos suljettiin liian aikaisin. Kansiota ei luotu – voit yrittää uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La publicité a été fermée trop tôt. Aucun dossier n’a été créé – tu peux réessayer."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જાહેરાત વહેલી બંધ થઈ. કોઈ ફોલ્ડર બન્યું નથી – તમે ફરી પ્રયાસ કરી શકો છો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפרסומת נסגרה מוקדם מדי. לא נוצרה תיקייה – אפשר לנסות שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विज्ञापन जल्दी बंद हो गया। कोई फ़ोल्डर नहीं बना – आप फिर कोशिश कर सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oglas je zatvoren prerano. Nije izrađena mapa – možeš pokušati ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hirdetést túl korán bezártad. Nem jött létre mappa – próbáld újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Iklan ditutup lebih awal. Tidak ada folder yang dibuat – kamu bisa mencoba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La pubblicità è stata chiusa in anticipo. Nessuna cartella creata: puoi riprovare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "広告が途中で閉じられました。フォルダは作成されていません。もう一度お試しください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಜಾಹೀರಾತು ಬೇಗ ಮುಚ್ಚಲಾಗಿದೆ. ಯಾವುದೇ ಫೋಲ್ಡರ್ ರಚನೆಯಾಗಿಲ್ಲ – ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಬಹುದು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "광고가 일찍 닫혔어요. 폴더가 만들어지지 않았어요. 다시 시도할 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പരസ്യം നേരത്തെ അടച്ചു. ഫോൾഡർ സൃഷ്‌ടിച്ചില്ല – വീണ്ടും ശ്രമിക്കാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "जाहिरात लवकर बंद झाली. फोल्डर तयार झाला नाही – तुम्ही पुन्हा प्रयत्न करू शकता."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Iklan ditutup terlalu awal. Tiada folder dicipta – anda boleh cuba lagi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Annonsen ble lukket for tidlig. Ingen mappe ble opprettet – du kan prøve igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De advertentie is te vroeg gesloten. Er is geen map gemaakt – je kunt het opnieuw proberen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ବିଜ୍ଞାପନ ଶୀଘ୍ର ବନ୍ଦ ହୋଇଗଲା। କୌଣସି ଫୋଲ୍ଡର ତିଆରି ହେଲା ନାହିଁ – ଆପଣ ପୁଣି ଚେଷ୍ଟା କରିପାରିବେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ਼ਤਿਹਾਰ ਜਲਦੀ ਬੰਦ ਹੋ ਗਿਆ। ਕੋਈ ਫ਼ੋਲਡਰ ਨਹੀਂ ਬਣਿਆ – ਤੁਸੀਂ ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰ ਸਕਦੇ ਹੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Reklama została zamknięta zbyt wcześnie. Nie utworzono folderu – możesz spróbować ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O anúncio foi fechado antes do fim. Nenhuma pasta foi criada – você pode tentar de novo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O anúncio foi fechado antes do tempo. Não foi criada nenhuma pasta – podes tentar novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Reclama a fost închisă prea devreme. Nu s-a creat niciun dosar – poți încerca din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Реклама была закрыта раньше времени. Папка не создана – можно попробовать снова."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Reklama bola zatvorená predčasne. Priečinok nebol vytvorený – môžete to skúsiť znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oglas je bil zaprt prezgodaj. Mapa ni bila ustvarjena – lahko poskusiš znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Annonsen stängdes i förtid. Ingen mapp skapades – du kan försöka igen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "விளம்பரம் முன்கூட்டியே மூடப்பட்டது. கோப்புறை உருவாக்கப்படவில்லை – மீண்டும் முயலலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రకటన త్వరగా మూసివేయబడింది. ఫోల్డర్ సృష్టించబడలేదు – మళ్లీ ప్రయత్నించవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โฆษณาถูกปิดก่อนจบ ไม่มีการสร้างโฟลเดอร์ – คุณลองอีกครั้งได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reklam erken kapatıldı. Klasör oluşturulmadı – tekrar deneyebilirsin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рекламу закрито передчасно. Теку не створено – можна спробувати ще раз."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اشتہار جلدی بند ہو گیا۔ کوئی فولڈر نہیں بنا – آپ دوبارہ کوشش کر سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quảng cáo bị đóng sớm. Chưa tạo thư mục nào – bạn có thể thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "广告被提前关闭，未新建文件夹——你可以再试一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "廣告提早關閉。沒有建立檔案夾 – 你可以再試一次。"
          }
        }
      }
    },
    "vault_ad_folder_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في النسخة المجانية يحتاج كل مجلد جديد إلى فيديو إعلاني قصير. مع Pro تنشئ المجلدات بلا إعلانات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিনামূল্যের সংস্করণে প্রতিটি নতুন ফোল্ডারের জন্য একটি ছোট বিজ্ঞাপন ভিডিও লাগে। Pro-তে ফোল্ডার বিজ্ঞাপন ছাড়াই তৈরি হয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "A la versió gratuïta, cada carpeta nova necessita un vídeo publicitari curt. Amb Pro, les carpetes es creen sense anuncis."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V bezplatné verzi potřebuje každá nová složka krátké reklamní video. S Pro se složky vytvářejí bez reklam."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "I gratisversionen kræver hver ny mappe en kort reklamevideo. Med Pro oprettes mapper uden reklamer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der Gratis-Version braucht jeder neue Ordner ein kurzes Werbevideo. Mit Pro legst du Ordner ohne Werbung an."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στη δωρεάν έκδοση, κάθε νέος φάκελος χρειάζεται ένα σύντομο διαφημιστικό βίντεο. Με το Pro οι φάκελοι δημιουργούνται χωρίς διαφημίσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the free version, each new folder needs a short ad video. With Pro, folders are created without ads."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la versión gratuita, cada carpeta nueva requiere un breve vídeo publicitario. Con Pro creas carpetas sin anuncios."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmaisversiossa jokainen uusi kansio vaatii lyhyen mainosvideon. Pron kanssa kansiot luodaan ilman mainoksia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
