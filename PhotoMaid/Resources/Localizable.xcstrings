    "movie_failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر إنشاء الفيديو. لم يُحفظ شيء وتبقى الأصول دون تغيير."
          }
        },
        "da": {
          "stringUnit": {
