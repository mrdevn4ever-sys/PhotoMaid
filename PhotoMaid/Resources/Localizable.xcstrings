    "onb_safe_local": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى صورك على جهازك. بلا حساب GaleriQ أو رفع للصور."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine fotos bliver på din enhed. Ingen GaleriQ-konto, ingen upload af fotos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Fotos bleiben auf deinem Gerät. Kein GaleriQ-Konto, kein Foto-Upload."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your photos stay on your device. No GaleriQ account, no photo uploads."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus fotos se quedan en tu dispositivo. Sin cuenta de GaleriQ ni subidas de fotos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes photos restent sur ton appareil. Sans compte GaleriQ ni envoi de photos."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotomu tetap di perangkatmu. Tanpa akun GaleriQ, tanpa unggah foto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue foto restano sul dispositivo. Nessun account GaleriQ, nessun caricamento di foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真は端末内に残ります。GaleriQアカウントも写真のアップロードも不要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진은 기기에 남아요. GaleriQ 계정도 사진 업로드도 필요 없어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildene dine blir på enheten din. Ingen GaleriQ-konto, ingen opplasting av bilder."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je foto’s blijven op je apparaat. Geen GaleriQ-account en geen foto-uploads."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdjęcia pozostają na urządzeniu. Bez konta GaleriQ i wysyłania zdjęć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas fotos ficam no seu aparelho. Sem conta do GaleriQ, sem envio de fotos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As tuas fotos ficam no teu dispositivo. Sem conta GaleriQ nem envio de fotos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografiile rămân pe dispozitivul tău. Fără cont GaleriQ și fără încărcarea fotografiilor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото остаются на твоём устройстве. Без аккаунта GaleriQ и загрузки фото на сервер."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina bilder stannar på din enhet. Inget GaleriQ-konto, ingen bilduppladdning."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปภาพของคุณอยู่บนอุปกรณ์ของคุณ ไม่มีบัญชี GaleriQ ไม่มีการอัปโหลดรูป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğrafların cihazında kalır. GaleriQ hesabı ve fotoğraf yüklemesi yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото залишаються на твоєму пристрої. Без облікового запису GaleriQ і завантаження фото на сервер."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh của bạn ở lại trên thiết bị. Không có tài khoản GaleriQ, không tải ảnh lên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片留在设备上，无需 GaleriQ 账号，也不上传照片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的照片留在你的裝置上。沒有 GaleriQ 帳號，不會上傳照片。"
          }
        }
      }
    },
