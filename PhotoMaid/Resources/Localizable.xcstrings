        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Schlagwörter. Vergib eigene Begriffe wie „Rechnung“ oder „Ferien“ – PhotoMaid kennt nur, was du selbst einträgst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No tags yet. Add your own words like “Invoice” or “Holiday” – PhotoMaid only knows what you enter yourself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay etiquetas. Añade tus propias palabras, como «Factura» o «Vacaciones»: PhotoMaid solo sabe lo que tú escribes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore de mot-clé. Ajoute tes propres mots comme « Facture » ou « Vacances » – PhotoMaid ne connaît que ce que tu saisis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessun tag. Aggiungi parole tue come «Fattura» o «Vacanze»: PhotoMaid conosce solo ciò che inserisci tu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タグはまだありません。「請求書」「旅行」など自分の言葉を追加できます。PhotoMaidが知るのはあなたが入力した内容だけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 태그가 없어요. ‘영수증’, ‘여행’ 같은 단어를 직접 추가하세요. PhotoMaid는 직접 입력한 내용만 알아요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen labels. Voeg eigen woorden toe zoals ‘Factuur’ of ‘Vakantie’ – PhotoMaid weet alleen wat je zelf invult."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak tagów. Dodaj własne słowa, np. „Faktura” lub „Wakacje” – PhotoMaid zna tylko to, co sam wpiszesz."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há etiquetas. Adiciona palavras tuas, como «Fatura» ou «Férias» – o PhotoMaid só sabe o que tu escreves."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încă nu există etichete. Adaugă propriile cuvinte, de pildă „Factură” sau „Vacanță” – PhotoMaid știe doar ce introduci tu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меток пока нет. Добавь свои слова, например «Счёт» или «Отпуск», – PhotoMaid знает только то, что ты вводишь сам."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz etiket yok. “Fatura” veya “Tatil” gibi kendi kelimelerini ekle – PhotoMaid yalnızca senin girdiklerini bilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Міток ще немає. Додай власні слова, наприклад «Рахунок» або «Відпустка», – PhotoMaid знає лише те, що ти вводиш сам."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有标签。添加你自己的词，例如“发票”或“假期”——PhotoMaid 只知道你自己输入的内容。"
          }
        }
      }
    },
