    "wf_name_base_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مثل إعلان ← إعلان_001 (فارغ = الاسم الأصلي)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "z. B. Kleinanzeige → Kleinanzeige_001 (leer = Originalname)"
          }
