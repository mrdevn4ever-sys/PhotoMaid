    "org_basket_empty_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في „الصور“ حدّد وسائط واضغط ⋯ › إضافة إلى سلة التحديد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "“ফটো”-তে কিছু বেছে নিয়ে ⋯ › নির্বাচন ঝুড়িতে যোগ করুন-এ ট্যাপ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "A «Fotos», selecciona alguna cosa i toca ⋯ › Afegir a la cistella de selecció."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve „Fotkách“ něco vyberte a klepněte na ⋯ › Přidat do výběrového košíku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg noget i “Fotos”, og tryk på ⋯ › Læg i udvalgskurven."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle in „Fotos“ etwas aus und tippe auf ⋯ › In den Auswahlkorb."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στις «Φωτογραφίες», επίλεξε κάτι και πάτησε ⋯ › Προσθήκη στο καλάθι επιλογής."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In “Photos”, select something and tap ⋯ › Add to selection basket."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En «Fotos», selecciona contenido y toca ⋯ › Añadir a la cesta de selección."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse jotain kohdassa ”Kuvat” ja napauta ⋯ › Lisää valintakoriin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans « Photos », sélectionne des médias puis touche ⋯ › Ajouter au panier de sélection."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "“ફોટા” માં કંઈક પસંદ કરો અને ⋯ › પસંદગીની ટોપલીમાં ઉમેરો પર ટૅપ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ב„תמונות” יש לבחור משהו ולהקיש על ⋯ › הוספה לסל הבחירה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“फ़ोटो” में कुछ चुनें और ⋯ › चयन टोकरी में जोड़ें पर टैप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "U „Fotografijama” odaberi nešto i dodirni ⋯ › Dodaj u košaricu odabira."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A „Fotók” alatt jelölj ki valamit, és koppints a ⋯ › Hozzáadás a válogatókosárhoz lehetőségre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di “Foto”, pilih sesuatu lalu ketuk ⋯ › Tambahkan ke keranjang pilihan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In «Foto» seleziona dei contenuti e tocca ⋯ › Aggiungi al cestino di selezione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「写真」でメディアを選び、⋯ › 選択かごに入れる をタップします。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "“ಫೋಟೋಗಳು” ನಲ್ಲಿ ಏನನ್ನಾದರೂ ಆಯ್ಕೆಮಾಡಿ ⋯ › ಆಯ್ಕೆ ಬುಟ್ಟಿಗೆ ಸೇರಿಸಿ ಟ್ಯಾಪ್ ಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘사진’에서 미디어를 선택하고 ⋯ › 선택 바구니에 담기를 탭하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "“ഫോട്ടോകൾ” എന്നതിൽ എന്തെങ്കിലും തിരഞ്ഞെടുത്ത് ⋯ › തിരഞ്ഞെടുപ്പ് കൊട്ടയിലേക്ക് ചേർക്കുക ടാപ്പ് ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "“फोटो” मध्ये काहीतरी निवडा आणि ⋯ › निवड टोपलीत जोडा वर टॅप करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dalam “Foto”, pilih sesuatu dan ketik ⋯ › Tambah ke bakul pilihan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "I «Bilder» velger du noe og trykker på ⋯ › Legg i utvalgskurven."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecteer in ‘Foto’s’ media en tik op ⋯ › In de selectiemand."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "“ଫଟୋ”ରେ କିଛି ବାଛି ⋯ › ଚୟନ ଟୋକେଇରେ ଯୋଗ କରନ୍ତୁରେ ଟାପ୍ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "“ਫ਼ੋਟੋਆਂ” ਵਿੱਚ ਕੁਝ ਚੁਣੋ ਅਤੇ ⋯ › ਚੋਣ ਟੋਕਰੀ ਵਿੱਚ ਜੋੜੋ ਉੱਤੇ ਟੈਪ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W „Zdjęciach” zaznacz multimedia i dotknij ⋯ › Dodaj do koszyka wyboru."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em “Fotos”, selecione algo e toque em ⋯ › Adicionar à cesta de seleção."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Em «Fotos», seleciona conteúdos e toca em ⋯ › Adicionar ao cesto de seleção."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În „Fotografii”, selectează conținut și atinge ⋯ › Adaugă în coșul de selecție."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В разделе «Фото» выбери медиа и нажми ⋯ › В корзину выбора."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vo „Fotkách“ niečo vyberte a klepnite na ⋯ › Pridať do výberového košíka."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "V »Fotografijah« nekaj izberi in tapni ⋯ › Dodaj v košarico izbora."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "I ”Bilder” markerar du något och trycker på ⋯ › Lägg i urvalskorgen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "“புகைப்படங்கள்” பகுதியில் எதையாவது தேர்ந்தெடுத்து ⋯ › தேர்வுக் கூடையில் சேர் என்பதைத் தட்டுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "“ఫోటోలు”లో ఏదైనా ఎంచుకుని ⋯ › ఎంపిక బుట్టకు జోడించండి ట్యాప్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใน “รูปภาพ” เลือกบางอย่างแล้วแตะ ⋯ › เพิ่มลงตะกร้ารายการที่เลือก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Fotoğraflar”da medya seç ve ⋯ › Seçim sepetine ekle’ye dokun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У розділі «Фото» вибери медіа й торкнися ⋯ › До кошика вибору."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "”تصاویر“ میں کچھ منتخب کریں اور ⋯ › انتخاب کی ٹوکری میں شامل کریں پر ٹیپ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong “Ảnh”, chọn nội dung rồi chạm ⋯ › Thêm vào giỏ chọn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“照片”中选择媒体，然后轻点 ⋯ › 加入选择篮。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「照片」中選取內容，然後點一下 ⋯ › 加入選擇籃。"
          }
        }
      }
    },
