    "vault_import_recently_deleted": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نصيحة: أفرِغ «المحذوفة مؤخرًا» في تطبيق الصور إذا أردت أن تختفي من هناك أيضًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "টিপ: এগুলো সেখান থেকেও উধাও করতে চাইলে ফটো অ্যাপে “সম্প্রতি মুছে ফেলা” খালি করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Consell: buida «Eliminat recentment» a l’app Fotos si també han de desaparèixer d’allà."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: vyprázdněte „Nedávno smazané“ v aplikaci Fotky, pokud mají zmizet i tam."
          }
        },
        "da": {
