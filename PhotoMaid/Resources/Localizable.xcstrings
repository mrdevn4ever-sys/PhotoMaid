        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hide “%1$@” in GaleriQ?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要在 GaleriQ 中隐藏“%1$@”吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hide “%1$@” in GaleriQ?"
          }
        }
