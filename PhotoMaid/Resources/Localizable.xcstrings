    "movie_fit_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تُشوَّه المقاطع أبدًا: إما تظهر الصورة كاملة (بحواف سوداء) أو تملأ الإطار وتُقص الحواف."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্লিপ কখনো টেনে লম্বা করা হয় না: হয় পুরো ছবি দেখা যায় (কালো কিনারাসহ), নয়তো এটি ফ্রেম পূরণ করে এবং কিনারা কেটে যায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els clips mai no s’estiren: o es mostra tota la imatge (amb vores negres) o omple el quadre i se’n retallen les vores."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klipy se nikdy neroztahují: buď se zobrazí celý obraz (s černými okraji), nebo vyplní snímek a okraje se oříznou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Klip strækkes aldrig: enten vises hele billedet (med sorte kanter), eller det udfylder rammen, og kanterne skæres af."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Clips werden nie verzerrt: Entweder das ganze Bild ist zu sehen (mit schwarzen Rändern) oder es füllt den Rahmen und die Ränder werden abgeschnitten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα κλιπ δεν τεντώνονται ποτέ: είτε εμφανίζεται ολόκληρη η εικόνα (με μαύρα περιθώρια) είτε γεμίζει το κάδρο και κόβονται οι άκρες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clips are never stretched: either the whole picture is shown (with black edges) or it fills the frame and the edges are cut off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los clips nunca se deforman: o se ve la imagen entera (con bordes negros) o llena el encuadre y se recortan los bordes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Leikkeitä ei koskaan venytetä: joko koko kuva näytetään (mustin reunoin) tai se täyttää kuva-alan ja reunat rajataan pois."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les clips ne sont jamais déformés : soit l’image entière est visible (bords noirs), soit elle remplit le cadre et les bords sont coupés."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ક્લિપ ક્યારેય ખેંચાતી નથી: કાં તો આખું ચિત્ર દેખાય છે (કાળી કિનારીઓ સાથે) કાં તો તે ફ્રેમ ભરે છે અને કિનારીઓ કપાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קליפים אף פעם לא נמתחים: או שכל התמונה מוצגת (עם שוליים שחורים) או שהיא ממלאת את המסגרת והשוליים נחתכים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्लिप कभी खींची नहीं जातीं: या तो पूरी तस्वीर दिखती है (काले किनारों के साथ) या वह फ़्रेम भरती है और किनारे कट जाते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Isječci se nikad ne rastežu: ili se prikazuje cijela slika (s crnim rubovima) ili ispunjava kadar, a rubovi se odrežu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A klipeket sosem nyújtjuk: vagy a teljes kép látszik (fekete szélekkel), vagy kitölti a képkockát, és a szélek levágódnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Klip tidak pernah diregangkan: gambar ditampilkan utuh (dengan tepi hitam) atau mengisi bingkai dan tepinya terpotong."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le clip non vengono mai deformate: o si vede l’immagine intera (con bordi neri) o riempie il riquadro e i bordi vengono tagliati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップが引き伸ばされることはありません。全体を表示（黒い余白あり）するか、枠いっぱいにして端を切り取ります。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕ್ಲಿಪ್‌ಗಳನ್ನು ಎಂದಿಗೂ ಹಿಗ್ಗಿಸಲಾಗುವುದಿಲ್ಲ: ಸಂಪೂರ್ಣ ಚಿತ್ರ ತೋರಿಸಲಾಗುತ್ತದೆ (ಕಪ್ಪು ಅಂಚುಗಳೊಂದಿಗೆ) ಅಥವಾ ಅದು ಫ್ರೇಮ್ ತುಂಬಿಸಿ ಅಂಚುಗಳು ಕತ್ತರಿಸಲ್ಪಡುತ್ತವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립은 절대 늘어나지 않습니다. 전체를 보여 주거나(검은 여백) 화면을 채우고 가장자리를 자릅니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ക്ലിപ്പുകൾ ഒരിക്കലും വലിച്ചുനീട്ടില്ല: ഒന്നുകിൽ മുഴുവൻ ചിത്രം കാണിക്കും (കറുത്ത അരികുകളോടെ) അല്ലെങ്കിൽ അത് ഫ്രെയിം നിറച്ച് അരികുകൾ മുറിയും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "क्लिप कधीही ताणल्या जात नाहीत: एकतर संपूर्ण चित्र दिसते (काळ्या कडांसह) किंवा ते फ्रेम भरते आणि कडा कापल्या जातात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Klip tidak pernah diregangkan: sama ada keseluruhan gambar ditunjukkan (dengan tepi hitam) atau ia mengisi bingkai dan tepinya dipotong."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Klipp strekkes aldri: enten vises hele bildet (med svarte kanter), eller det fyller rammen og kantene beskjæres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Clips worden nooit vervormd: of het hele beeld is te zien (met zwarte randen) of het vult het kader en de randen vallen weg."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "କ୍ଲିପ୍ କେବେ ଟାଣି ଲମ୍ବା କରାଯାଏ ନାହିଁ: କିମ୍ବା ସମ୍ପୂର୍ଣ୍ଣ ଛବି ଦେଖାଯାଏ (କଳା ଧାର ସହ) କିମ୍ବା ଏହା ଫ୍ରେମ୍ ପୂର୍ଣ୍ଣ କରେ ଏବଂ ଧାର କଟିଯାଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕਲਿੱਪਾਂ ਕਦੇ ਖਿੱਚੀਆਂ ਨਹੀਂ ਜਾਂਦੀਆਂ: ਜਾਂ ਤਾਂ ਪੂਰੀ ਤਸਵੀਰ ਦਿਸਦੀ ਹੈ (ਕਾਲੇ ਕਿਨਾਰਿਆਂ ਨਾਲ) ਜਾਂ ਇਹ ਫ਼ਰੇਮ ਭਰਦੀ ਹੈ ਅਤੇ ਕਿਨਾਰੇ ਕੱਟੇ ਜਾਂਦੇ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klipy nigdy nie są zniekształcane: albo widać cały obraz (z czarnymi krawędziami), albo wypełnia kadr, a krawędzie są przycinane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os clipes nunca são esticados: ou a imagem inteira é mostrada (com bordas pretas), ou ela preenche o quadro e as bordas são cortadas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os clipes nunca são deformados: ou se vê a imagem inteira (com margens pretas) ou preenche o enquadramento e as margens são cortadas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Clipurile nu sunt deformate niciodată: fie se vede imaginea întreagă (cu margini negre), fie umple cadrul și marginile se taie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клипы никогда не растягиваются: либо видно всё изображение (с чёрными полями), либо оно заполняет кадр, а края обрезаются."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Klipy sa nikdy nenaťahujú: buď sa zobrazí celý obraz (s čiernymi okrajmi), alebo vyplní záber a okraje sa orežú."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Posnetki se nikoli ne raztegnejo: prikaže se cela slika (s črnimi robovi) ali pa zapolni kader in se robovi odrežejo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klipp sträcks aldrig ut: antingen visas hela bilden (med svarta kanter) eller så fyller den bildrutan och kanterna beskärs."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கிளிப்கள் ஒருபோதும் இழுக்கப்படாது: முழுப் படமும் காட்டப்படும் (கருப்பு ஓரங்களுடன்) அல்லது அது சட்டகத்தை நிரப்பி ஓரங்கள் வெட்டப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "క్లిప్‌లను ఎప్పుడూ సాగదీయరు: పూర్తి చిత్రం చూపబడుతుంది (నల్ల అంచులతో) లేదా అది ఫ్రేమ్‌ను నింపి అంచులు కత్తిరించబడతాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คลิปจะไม่ถูกยืด: แสดงภาพทั้งหมด (มีขอบดำ) หรือเต็มเฟรมโดยตัดขอบออก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klipler asla esnetilmez: ya görüntünün tamamı görünür (siyah kenarlarla) ya da kareyi doldurur ve kenarlar kırpılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кліпи ніколи не розтягуються: або видно все зображення (з чорними полями), або воно заповнює кадр, а краї обрізаються."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کلپس کبھی کھینچے نہیں جاتے: یا پوری تصویر دکھتی ہے (سیاہ کناروں کے ساتھ) یا وہ فریم بھرتی ہے اور کنارے کٹ جاتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các đoạn không bao giờ bị kéo giãn: hoặc hiện toàn bộ hình (có viền đen), hoặc lấp đầy khung và cắt bớt phần viền."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "片段绝不会被拉伸：要么完整显示（带黑边），要么填满画面并裁掉边缘。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "片段永遠不會被拉伸：要嘛顯示完整畫面（加上黑邊），要嘛填滿畫面並裁掉邊緣。"
          }
        }
      }
    },
