    "collage_hint_crop": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب لتحريك الصورة داخل خانتها، وكبّر أو صغّر بإصبعين."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঘরের মধ্যে ফটো সরাতে টানুন, জুম করতে পিঞ্চ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrossega per moure la foto dins la cel·la, pessiga per fer zoom."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tažením posunete fotku v buňce, sevřením prstů ji přiblížíte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træk for at flytte fotoet i feltet, knib for at zoome."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe, um das Foto im Feld zu verschieben, und zoome mit zwei Fingern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σύρε για να μετακινήσεις τη φωτογραφία στο κελί, τσίμπησε για ζουμ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to move the photo in its cell, pinch to zoom."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra para mover la foto en su celda y pellizca para hacer zoom."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedä siirtääksesi kuvaa solussa, nipistä zoomataksesi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser pour déplacer la photo dans sa case, pincez pour zoomer."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કોષમાં ફોટો ખસેડવા ખેંચો, ઝૂમ માટે ચપટી ભરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גרירה מזיזה את התמונה בתא, צביטה מגדילה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेल में फ़ोटो हिलाने के लिए खींचें, ज़ूम के लिए पिंच करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Povuci za pomicanje fotografije u ćeliji, stisni prstima za zumiranje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzd a fotót a cellán belüli mozgatáshoz, csippentéssel nagyíthatsz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret untuk memindah foto di selnya, cubit untuk zoom."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina per spostare la foto nella cella, pizzica per lo zoom."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグで枠内の写真を移動、ピンチでズームします。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕೋಶದಲ್ಲಿ ಫೋಟೋ ಸರಿಸಲು ಎಳೆಯಿರಿ, ಜೂಮ್ ಮಾಡಲು ಪಿಂಚ್ ಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드래그하여 칸 안에서 사진을 옮기고, 두 손가락으로 확대/축소하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കളത്തിൽ ഫോട്ടോ നീക്കാൻ വലിക്കുക, സൂം ചെയ്യാൻ പിഞ്ച് ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सेलमधील फोटो हलवण्यासाठी ओढा, झूमसाठी चिमटा घ्या."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret untuk menggerakkan foto dalam selnya, cubit untuk zum."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra for å flytte bildet i ruten, knip for å zoome."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep om de foto in het vak te verschuiven, knijp om te zoomen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଘର ଭିତରେ ଫଟୋ ଘୁଞ୍ଚାଇବାକୁ ଟାଣନ୍ତୁ, ଜୁମ୍ କରିବାକୁ ପିଞ୍ଚ୍ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਖ਼ਾਨੇ ਵਿੱਚ ਫ਼ੋਟੋ ਹਿਲਾਉਣ ਲਈ ਖਿੱਚੋ, ਜ਼ੂਮ ਲਈ ਚੂੰਢੀ ਭਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij, aby przesunąć zdjęcie w polu; zsuń lub rozsuń palce, aby powiększyć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste para mover a foto na célula, faça pinça para ampliar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste para mover a fotografia na célula e junte ou afaste os dedos para ampliar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trage ca să muți poza în casetă, ciupește pentru zoom."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите, чтобы сдвинуть фото в ячейке; сведите или разведите пальцы для масштаба."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Potiahnutím posuniete fotku v bunke, stiahnutím prstov ju priblížite."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Povleci, da premakneš fotografijo v celici, uščipni za povečavo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra för att flytta bilden i rutan, nyp för att zooma."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கட்டத்தில் புகைப்படத்தை நகர்த்த இழுங்கள், பெரிதாக்கப் பிஞ்ச் செய்யுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "గడిలో ఫోటోను కదపడానికి లాగండి, జూమ్ చేయడానికి పించ్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลากเพื่อเลื่อนรูปในช่อง บีบเพื่อซูม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğrafı hücresinde kaydırmak için sürükle, yakınlaştırmak için iki parmağını kullan."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягніть, щоб зсунути фото в клітинці; зведіть або розведіть пальці для масштабу."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "خانے میں تصویر ہلانے کے لیے کھینچیں، زوم کے لیے چٹکی لیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kéo để di chuyển ảnh trong ô, chụm để thu phóng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动可在格子内移动照片，双指捏合可缩放。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移以在格子內移動照片，用兩指縮放。"
          }
        }
      }
    },
    "collage_hint_free": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب الصور لتحريكها. استخدم إصبعين لتغيير الحجم والتدوير."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফটো সরাতে টানুন। দুই আঙুলে আকার বদলান ও ঘোরান।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrossega les fotos per moure-les. Amb dos dits en canvies la mida i les gires."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tažením fotky posunete. Dvěma prsty měníte velikost a otáčíte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træk fotos for at flytte dem. To fingre ændrer størrelse og roterer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe Fotos, um sie zu verschieben. Mit zwei Fingern änderst du Größe und Drehung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σύρε τις φωτογραφίες για να τις μετακινήσεις. Με δύο δάχτυλα αλλάζεις μέγεθος και περιστρέφεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag photos to move them. Two fingers resize and rotate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra las fotos para moverlas. Con dos dedos cambias el tamaño y el giro."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedä kuvia siirtääksesi niitä. Kahdella sormella muutat kokoa ja kierrät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser les photos pour les déplacer. Deux doigts changent la taille et la rotation."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફોટા ખસેડવા ખેંચો. બે આંગળીથી કદ બદલો અને ફેરવો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גרירה מזיזה את התמונות. בשתי אצבעות משנים גודל ומסובבים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोटो हिलाने के लिए खींचें। दो उँगलियों से साइज़ बदलें और घुमाएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Povuci fotografije da ih pomakneš. Dvama prstima mijenjaš veličinu i okrećeš."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzd a fotókat a mozgatáshoz. Két ujjal méretezel és forgatsz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret foto untuk memindahkannya. Dua jari mengubah ukuran dan memutar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina le foto per spostarle. Con due dita ne cambi dimensione e rotazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真をドラッグして移動。2本指でサイズと回転を変更します。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಫೋಟೋಗಳನ್ನು ಸರಿಸಲು ಎಳೆಯಿರಿ. ಎರಡು ಬೆರಳುಗಳಿಂದ ಗಾತ್ರ ಬದಲಿಸಿ ಮತ್ತು ತಿರುಗಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진을 드래그해 옮기세요. 두 손가락으로 크기와 회전을 바꿀 수 있습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഫോട്ടോകൾ നീക്കാൻ വലിക്കുക. രണ്ട് വിരലുകൾ കൊണ്ട് വലുപ്പം മാറ്റുകയും തിരിക്കുകയും ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फोटो हलवण्यासाठी ओढा. दोन बोटांनी आकार बदला आणि फिरवा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret foto untuk menggerakkannya. Dua jari mengubah saiz dan memutar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra bilder for å flytte dem. To fingre endrer størrelse og roterer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep foto’s om ze te verplaatsen. Met twee vingers wijzig je grootte en draaiing."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଫଟୋ ଘୁଞ୍ଚାଇବାକୁ ଟାଣନ୍ତୁ। ଦୁଇ ଆଙ୍ଗୁଠିରେ ଆକାର ବଦଳାନ୍ତୁ ଓ ଘୁରାନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਫ਼ੋਟੋਆਂ ਹਿਲਾਉਣ ਲਈ ਖਿੱਚੋ। ਦੋ ਉਂਗਲਾਂ ਨਾਲ ਆਕਾਰ ਬਦਲੋ ਅਤੇ ਘੁਮਾਓ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągaj zdjęcia, aby je przesuwać. Dwoma palcami zmienisz rozmiar i obrót."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste as fotos para movê-las. Dois dedos redimensionam e giram."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste as fotografias para as mover. Com dois dedos altera o tamanho e a rotação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trage pozele ca să le muți. Cu două degete schimbi mărimea și rotația."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетаскивайте фото, чтобы двигать их. Двумя пальцами меняйте размер и поворот."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Potiahnutím fotky posuniete. Dvoma prstami meníte veľkosť a otáčate."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Povleci fotografije, da jih premakneš. Z dvema prstoma spreminjaš velikost in vrtiš."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra bilderna för att flytta dem. Två fingrar ändrar storlek och roterar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "புகைப்படங்களை நகர்த்த இழுங்கள். இரண்டு விரல்களால் அளவு மாற்றிச் சுழற்றுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫోటోలను కదపడానికి లాగండి. రెండు వేళ్లతో పరిమాణం మార్చి తిప్పండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลากรูปเพื่อย้าย สองนิ้วเพื่อปรับขนาดและหมุน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğrafları taşımak için sürükle. İki parmakla boyutu ve dönüşü değiştir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягуйте фото, щоб переміщувати їх. Двома пальцями змінюйте розмір і поворот."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تصاویر ہلانے کے لیے کھینچیں۔ دو انگلیوں سے سائز بدلیں اور گھمائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kéo ảnh để di chuyển. Hai ngón để đổi kích thước và xoay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动照片可移动位置，双指可调整大小和旋转。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移照片來移動。兩指可調整大小和旋轉。"
          }
        }
      }
    },
