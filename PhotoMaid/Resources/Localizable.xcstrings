    "onb_access_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض GaleriQ صورك وفيديوهاتك على جهازك مباشرةً لتنظيفها. بلا حساب أو خادم GaleriQ."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ আপনার ফটো ও ভিডিও সরাসরি আপনার ডিভাইসে দেখায় যাতে আপনি পরিষ্কার করতে পারেন। কোনো GaleriQ অ্যাকাউন্ট বা সার্ভার নেই।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ mostra les teves fotos i vídeos directament al dispositiu perquè puguis endreçar. Sense compte de GaleriQ ni servidor."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ zobrazuje vaše fotky a videa přímo v zařízení, abyste mohli uklízet. Bez účtu GaleriQ a bez serveru."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ viser dine fotos og videoer direkte på din enhed, så du kan rydde op. Ingen GaleriQ-konto eller server."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit du aufräumen kannst, zeigt GaleriQ deine Fotos und Videos direkt auf deinem Gerät. Ohne GaleriQ-Konto und ohne GaleriQ-Server."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το GaleriQ δείχνει τις φωτογραφίες και τα βίντεό σου απευθείας στη συσκευή σου για να τακτοποιείς. Χωρίς λογαριασμό GaleriQ ή διακομιστή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ shows your photos and videos directly on your device so you can clean up. No GaleriQ account or server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ muestra tus fotos y vídeos en tu dispositivo para que puedas hacer limpieza. Sin cuenta ni servidor de GaleriQ."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ näyttää kuvasi ja videosi suoraan laitteellasi, jotta voit siivota. Ei GaleriQ-tiliä eikä palvelinta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ affiche tes photos et vidéos directement sur ton appareil pour que tu puisses faire le tri. Sans compte ni serveur GaleriQ."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ તમારા ફોટા અને વીડિયો સીધા તમારા ઉપકરણ પર બતાવે છે જેથી તમે સાફસફાઈ કરી શકો. કોઈ GaleriQ એકાઉન્ટ કે સર્વર નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ מציגה את התמונות והסרטונים שלך ישירות במכשיר כדי שאפשר יהיה לסדר. בלי חשבון GaleriQ ובלי שרת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ आपकी फ़ोटो और वीडियो सीधे आपके डिवाइस पर दिखाता है ताकि आप सफ़ाई कर सकें। कोई GaleriQ खाता या सर्वर नहीं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ prikazuje tvoje fotografije i videozapise izravno na uređaju kako bi mogao raščistiti. Bez GaleriQ računa i bez poslužitelja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A GaleriQ közvetlenül az eszközödön mutatja a fotóidat és videóidat, hogy rendet rakhass. Nincs GaleriQ-fiók és nincs szerver."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ menampilkan foto dan videomu langsung di perangkatmu agar kamu bisa merapikannya. Tanpa akun atau server GaleriQ."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ mostra foto e video direttamente sul dispositivo per aiutarti a riordinare. Nessun account o server GaleriQ."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQは端末内の写真や動画をそのまま表示して、整理を手伝います。GaleriQのアカウントやサーバーはありません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ನಿಮ್ಮ ಫೋಟೋಗಳು ಮತ್ತು ವೀಡಿಯೊಗಳನ್ನು ನೇರವಾಗಿ ನಿಮ್ಮ ಸಾಧನದಲ್ಲಿ ತೋರಿಸುತ್ತದೆ, ಇದರಿಂದ ನೀವು ಸ್ವಚ್ಛಗೊಳಿಸಬಹುದು. GaleriQ ಖಾತೆ ಅಥವಾ ಸರ್ವರ್ ಇಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ는 기기에 있는 사진과 동영상을 직접 보여 주고 정리를 도와요. GaleriQ 계정이나 서버는 없어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വൃത്തിയാക്കാൻ കഴിയുന്ന വിധം GaleriQ നിങ്ങളുടെ ഫോട്ടോകളും വീഡിയോകളും നേരിട്ട് നിങ്ങളുടെ ഉപകരണത്തിൽ കാണിക്കുന്നു. GaleriQ അക്കൗണ്ടോ സെർവറോ ഇല്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ तुमचे फोटो आणि व्हिडिओ थेट तुमच्या डिव्हाइसवर दाखवते, जेणेकरून तुम्ही साफसफाई करू शकता. GaleriQ खाते किंवा सर्व्हर नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ menunjukkan foto dan video anda terus pada peranti anda supaya anda boleh mengemas. Tiada akaun atau pelayan GaleriQ."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ viser bildene og videoene dine direkte på enheten slik at du kan rydde. Ingen GaleriQ-konto eller server."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ toont je foto’s en video’s op je apparaat, zodat je kunt opruimen. Zonder GaleriQ-account of -server."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ଆପଣଙ୍କ ଫଟୋ ଓ ଭିଡିଓ ସିଧାସଳଖ ଆପଣଙ୍କ ଡିଭାଇସ୍‌ରେ ଦେଖାଏ ଯାହାଦ୍ୱାରା ଆପଣ ସଫା କରିପାରିବେ। କୌଣସି GaleriQ ଆକାଉଣ୍ଟ କିମ୍ବା ସର୍ଭର ନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ਤੁਹਾਡੀਆਂ ਫ਼ੋਟੋਆਂ ਅਤੇ ਵੀਡੀਓ ਸਿੱਧੇ ਤੁਹਾਡੇ ਡਿਵਾਈਸ ਉੱਤੇ ਦਿਖਾਉਂਦਾ ਹੈ ਤਾਂ ਜੋ ਤੁਸੀਂ ਸਫ਼ਾਈ ਕਰ ਸਕੋ। ਕੋਈ GaleriQ ਖਾਤਾ ਜਾਂ ਸਰਵਰ ਨਹੀਂ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ pokazuje zdjęcia i filmy na urządzeniu, aby można było je uporządkować. Bez konta i serwera GaleriQ."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O GaleriQ mostra suas fotos e vídeos diretamente no seu aparelho para você organizar. Sem conta nem servidor do GaleriQ."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O GaleriQ mostra as fotos e os vídeos no teu dispositivo para os poderes organizar. Sem conta nem servidor GaleriQ."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ arată fotografiile și videoclipurile direct pe dispozitiv, ca să le poți organiza. Fără cont sau server GaleriQ."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ показывает фото и видео на устройстве, чтобы ты мог навести порядок. Без аккаунта и сервера GaleriQ."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ zobrazuje vaše fotky a videá priamo v zariadení, aby ste mohli upratovať. Bez účtu GaleriQ a bez servera."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ prikazuje tvoje fotografije in videoposnetke neposredno v napravi, da lahko čistiš. Brez računa GaleriQ in brez strežnika."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ visar dina bilder och videor direkt på enheten så att du kan rensa. Inget GaleriQ-konto eller server."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் சுத்தம் செய்ய GaleriQ உங்கள் புகைப்படங்களையும் வீடியோக்களையும் நேரடியாக உங்கள் சாதனத்தில் காட்டுகிறது. GaleriQ கணக்கோ சேவையகமோ இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు శుభ్రం చేయగలిగేలా GaleriQ మీ ఫోటోలు, వీడియోలను నేరుగా మీ పరికరంలో చూపిస్తుంది. GaleriQ ఖాతా లేదా సర్వర్ లేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ แสดงรูปภาพและวิดีโอของคุณบนอุปกรณ์โดยตรงเพื่อให้คุณจัดระเบียบ ไม่มีบัญชีหรือเซิร์ฟเวอร์ของ GaleriQ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ, düzenleyebilmen için fotoğraf ve videolarını cihazında gösterir. GaleriQ hesabı veya sunucusu yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ показує фото й відео на пристрої, щоб ти міг навести лад. Без облікового запису й сервера GaleriQ."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ آپ کی تصاویر اور ویڈیوز براہ راست آپ کی ڈیوائس پر دکھاتا ہے تاکہ آپ صفائی کر سکیں۔ کوئی GaleriQ اکاؤنٹ یا سرور نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ hiển thị ảnh và video ngay trên thiết bị của bạn để bạn dọn dẹp. Không có tài khoản hay máy chủ GaleriQ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ 直接显示设备上的照片和视频，方便你清理。无需 GaleriQ 账号，也没有 GaleriQ 服务器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ 直接在你的裝置上顯示照片和影片，方便你整理。沒有 GaleriQ 帳號或伺服器。"
          }
        }
