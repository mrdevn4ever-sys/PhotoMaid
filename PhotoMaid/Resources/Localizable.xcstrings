    "files_none_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر مجلدًا لمراجعة ملفاته في GaleriQ."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ-এ কোনো ফোল্ডারের ফাইল পর্যালোচনা করতে সেটি বেছে নিন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tria una carpeta per revisar-ne els fitxers a GaleriQ."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte složku a projděte její soubory v GaleriQ."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg en mappe for at gennemgå dens filer i GaleriQ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Ordner aus, um seine Dateien in GaleriQ durchzusehen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επίλεξε φάκελο για να ελέγξεις τα αρχεία του στο GaleriQ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a folder to review its files in GaleriQ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una carpeta para revisar sus archivos en GaleriQ."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse kansio käydäksesi sen tiedostot läpi GaleriQ:ssa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis un dossier pour passer ses fichiers en revue dans GaleriQ."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ માં ફોલ્ડરની ફાઇલો જોવા તેને પસંદ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לבחור תיקייה כדי לסקור את הקבצים שלה ב-GaleriQ."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ में किसी फ़ोल्डर की फ़ाइलें देखने के लिए उसे चुनें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberi mapu da pregledaš njezine datoteke u GaleriQ-u."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válassz egy mappát, hogy a fájljait a GaleriQ-ban nézd át."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih folder untuk meninjau file-nya di GaleriQ."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una cartella per controllarne i file in GaleriQ."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダを選ぶと、中のファイルをGaleriQで確認できます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ನಲ್ಲಿ ಫೋಲ್ಡರ್‌ನ ಫೈಲ್‌ಗಳನ್ನು ಪರಿಶೀಲಿಸಲು ಅದನ್ನು ಆಯ್ಕೆಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더를 선택하면 GaleriQ에서 그 안의 파일을 확인할 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ-ൽ ഒരു ഫോൾഡറിലെ ഫയലുകൾ പരിശോധിക്കാൻ അത് തിരഞ്ഞെടുക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ मध्ये फोल्डरच्या फाइल्स पाहण्यासाठी तो निवडा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih folder untuk menyemak failnya dalam GaleriQ."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg en mappe for å gå gjennom filene i den i GaleriQ."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een map om de bestanden in GaleriQ te bekijken."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQରେ ଏକ ଫୋଲ୍ଡରର ଫାଇଲ୍ ସମୀକ୍ଷା କରିବାକୁ ତାହା ବାଛନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ਵਿੱਚ ਕਿਸੇ ਫ਼ੋਲਡਰ ਦੀਆਂ ਫ਼ਾਈਲਾਂ ਦੀ ਸਮੀਖਿਆ ਕਰਨ ਲਈ ਉਸ ਨੂੰ ਚੁਣੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz folder, aby przejrzeć jego pliki w GaleriQ."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma pasta para revisar os arquivos dela no GaleriQ."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe uma pasta para reveres os respetivos ficheiros no GaleriQ."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege un dosar pentru a-i verifica fișierele în GaleriQ."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбери папку, чтобы просмотреть её файлы в GaleriQ."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte priečinok a prezrite jeho súbory v GaleriQ."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izberi mapo, da pregledaš njene datoteke v GaleriQ."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj en mapp för att gå igenom dess filer i GaleriQ."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ-இல் ஒரு கோப்புறையின் கோப்புகளைப் பார்வையிட அதைத் தேர்ந்தெடுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQలో ఒక ఫోల్డర్ ఫైళ్లను సమీక్షించడానికి దాన్ని ఎంచుకోండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกโฟลเดอร์เพื่อตรวจดูไฟล์ใน GaleriQ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyalarını GaleriQ içinde incelemek için bir klasör seç."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибери папку, щоб переглянути її файли в GaleriQ."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ میں کسی فولڈر کی فائلوں کا جائزہ لینے کے لیے اسے منتخب کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn một thư mục để xem lại các tệp trong GaleriQ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一个文件夹，即可在 GaleriQ 中查看里面的文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇一個檔案夾，在 GaleriQ 中整理其中的檔案。"
          }
        }
      }
    },
