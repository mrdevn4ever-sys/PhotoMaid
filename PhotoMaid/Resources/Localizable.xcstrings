    "ana_footer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل التحليل على هذا الـ iPhone فقط (Apple Vision). النتائج اقتراحات – والقرار لك في الموجز. لا يُرفع أي شيء ولا يُحذف تلقائيًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিশ্লেষণ শুধু এই iPhone-এ চলে (Apple Vision)। ফলাফল কেবল প্রস্তাব – সিদ্ধান্ত আপনি ফিডে নেন। কিছুই আপলোড বা স্বয়ংক্রিয়ভাবে মুছে ফেলা হয় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’anàlisi només es fa en aquest iPhone (Apple Vision). Els resultats són suggeriments: tu decideixes al feed. No es penja ni s’esborra res automàticament."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Analýza probíhá jen v tomto iPhonu (Apple Vision). Výsledky jsou návrhy – rozhodujete vy ve feedu. Nic se automaticky nenahrává ani nemaže."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Analysen kører kun på denne iPhone (Apple Vision). Resultaterne er forslag – du bestemmer i feedet. Intet uploades eller slettes automatisk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Analyse läuft nur auf diesem iPhone (Apple Vision). Ergebnisse sind Vorschläge – entscheiden tust du im Feed. Nichts wird hochgeladen oder automatisch gelöscht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ανάλυση γίνεται μόνο σε αυτό το iPhone (Apple Vision). Τα αποτελέσματα είναι προτάσεις – εσύ αποφασίζεις στη ροή. Τίποτα δεν ανεβαίνει ούτε διαγράφεται αυτόματα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Analysis runs only on this iPhone (Apple Vision). Results are suggestions – you decide in the feed. Nothing is uploaded or deleted automatically."
