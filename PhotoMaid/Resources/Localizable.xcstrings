    "picker_no_date": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأجيل بلا موعد"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Læg til side uden dato"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Termin beiseitelegen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set aside without a date"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apartar sin fecha"
          }
        },
        "fr": {
          "stringUnit": {
