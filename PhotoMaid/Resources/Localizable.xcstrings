    "tour_months_more_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح النظرة العامة كشبكة أو راجع شهرًا مكتملًا مجددًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সংক্ষিপ্ত দৃশ্যটি গ্রিড হিসেবে খুলুন বা শেষ হওয়া কোনো মাস আবার পর্যালোচনা করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Obre la visió general en quadrícula o torna a revisar un mes acabat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevřete přehled jako mřížku nebo znovu projděte dokončený měsíc."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn oversigten som gitter, eller gennemgå en færdig måned igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne die Übersicht als Raster oder sieh einen fertigen Monat erneut durch."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άνοιξε την επισκόπηση ως πλέγμα ή έλεγξε ξανά έναν ολοκληρωμένο μήνα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the overview as a grid or review a finished month again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la vista general como cuadrícula o revisa de nuevo un mes terminado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa yleiskatsaus ruudukkona tai käy valmis kuukausi läpi uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre la vue d’ensemble en grille ou revois un mois terminé."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઝાંખી ગ્રિડ તરીકે ખોલો અથવા પૂર્ણ થયેલો મહિનો ફરી જુઓ."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר לפתוח את הסקירה הכללית כרשת או לסקור שוב חודש שהושלם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ओवरव्यू को ग्रिड के रूप में खोलें या पूरा हुआ महीना फिर से देखें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvori pregled kao mrežu ili ponovno pregledaj završeni mjesec."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyisd meg az áttekintést rácsként, vagy nézz át újra egy kész hónapot."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka ringkasan sebagai kisi atau tinjau lagi bulan yang sudah selesai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri la panoramica a griglia o rivedi un mese completato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一覧をグリッドで開いたり、終わった月をもう一度見直したりできます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅವಲೋಕನವನ್ನು ಗ್ರಿಡ್ ಆಗಿ ತೆರೆಯಿರಿ ಅಥವಾ ಮುಗಿದ ತಿಂಗಳನ್ನು ಮತ್ತೆ ಪರಿಶೀಲಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한눈에 보기를 격자로 열거나 끝낸 달을 다시 볼 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അവലോകനം ഗ്രിഡായി തുറക്കുക അല്ലെങ്കിൽ പൂർത്തിയായ ഒരു മാസം വീണ്ടും പരിശോധിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "विहंगावलोकन ग्रिड म्हणून उघडा किंवा पूर्ण झालेला महिना पुन्हा पहा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka gambaran keseluruhan sebagai grid atau semak semula bulan yang telah selesai."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne oversikten som rutenett eller gå gjennom en ferdig måned igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open het overzicht als raster of bekijk een afgeronde maand opnieuw."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସମୀକ୍ଷା ଦୃଶ୍ୟକୁ ଗ୍ରିଡ୍ ଭାବେ ଖୋଲନ୍ତୁ କିମ୍ବା ଶେଷ ହୋଇଥିବା ମାସକୁ ପୁଣି ସମୀକ୍ଷା କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਝਾਤ ਨੂੰ ਗ੍ਰਿੱਡ ਵਜੋਂ ਖੋਲ੍ਹੋ ਜਾਂ ਕਿਸੇ ਪੂਰੇ ਹੋਏ ਮਹੀਨੇ ਦੀ ਦੁਬਾਰਾ ਸਮੀਖਿਆ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz przegląd jako siatkę albo przejrzyj ukończony miesiąc ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra a visão geral em grade ou revise de novo um mês concluído."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre a vista geral em grelha ou revê um mês concluído."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschide prezentarea ca grilă sau revizuiește din nou o lună terminată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открой обзор сеткой или пересмотри завершённый месяц."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorte prehľad ako mriežku alebo znova prezrite dokončený mesiac."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpri pregled kot mrežo ali znova preglej končan mesec."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna översikten som rutnät eller gå igenom en färdig månad igen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மேலோட்டத்தைக் கட்டமாகத் திறங்கள் அல்லது முடிந்த மாதத்தை மீண்டும் பார்வையிடுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అవలోకనాన్ని గ్రిడ్‌గా తెరవండి లేదా పూర్తయిన నెలను మళ్లీ సమీక్షించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดภาพรวมเป็นตาราง หรือตรวจดูเดือนที่เสร็จแล้วอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Genel bakışı ızgara olarak aç veya biten bir ayı yeniden gözden geçir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрий огляд сіткою або переглянь завершений місяць знову."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جائزے کو گرڈ کے طور پر کھولیں یا مکمل مہینے کا دوبارہ جائزہ لیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở tổng quan dạng lưới hoặc xem lại một tháng đã xong."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以网格打开概览，或重新查看已完成的月份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以格狀打開總覽，或重新整理已完成的月份。"
          }
        }
      }
    },
