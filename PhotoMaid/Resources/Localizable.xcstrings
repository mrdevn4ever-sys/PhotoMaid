    "basket_preview_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العرض لا يغيّر اختيارك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দেখলে আপনার নির্বাচন বদলায় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mirar-ho no canvia la selecció."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prohlížení nemění váš výběr."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At se ændrer ikke dit valg."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ansehen ändert nichts an deiner Auswahl."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η προβολή δεν αλλάζει την επιλογή σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Viewing doesn’t change your selection."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlo no cambia tu selección."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Katsominen ei muuta valintaasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’affichage ne change pas ta sélection."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જોવાથી તમારી પસંદગી બદલાતી નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הצפייה לא משנה את הבחירה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "देखने से आपका चयन नहीं बदलता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregledavanje ne mijenja odabir."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A megtekintés nem módosítja a kijelölést."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Melihat tidak mengubah pilihanmu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Visualizzare l’elemento non cambia la selezione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見るだけでは選択は変わりません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ವೀಕ್ಷಿಸುವುದರಿಂದ ನಿಮ್ಮ ಆಯ್ಕೆ ಬದಲಾಗುವುದಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보기만 해서는 선택이 바뀌지 않아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കാണുന്നത് നിങ്ങളുടെ തിരഞ്ഞെടുപ്പ് മാറ്റില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पाहिल्याने तुमची निवड बदलत नाही."
          }
        },
        "ms": {
