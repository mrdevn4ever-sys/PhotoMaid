    "vid_export_info_fast": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قصصت البداية والنهاية فقط. هذا سريع وتبقى جودة الصورة كما في الأصل. إن لم يسمح هذا الفيديو بذلك، يعيد GaleriQ إنشاءه بالكامل – ويستغرق ذلك وقتًا أطول قليلًا. المدة الكلية %1$@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har kun klippet begyndelsen og slutningen. Det går hurtigt, og billedkvaliteten forbliver som i originalen. Hvis videoen ikke tillader det, genopbygger GaleriQ den helt – det tager lidt længere tid. Samlet længde %1$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast nur Anfang und Ende gekürzt. Das geht schnell und die Bildqualität bleibt wie im Original. Klappt das bei diesem Video nicht, berechnet GaleriQ es ganz neu – das dauert dann etwas länger. Gesamtlänge %1$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You only trimmed the start and end. That’s quick and the picture quality stays as in the original. If this video doesn’t allow it, GaleriQ rebuilds it completely – which takes a little longer. Total length %1$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo has recortado el inicio y el final. Es rápido y la calidad se mantiene como en el original. Si este vídeo no lo permite, GaleriQ lo genera de nuevo por completo y tarda un poco más. Duración total %1$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez seulement coupé le début et la fin. C’est rapide et la qualité reste celle de l’original. Si cette vidéo ne le permet pas, GaleriQ la recalcule entièrement – cela prend un peu plus de temps. Durée totale %1$@."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu hanya memangkas awal dan akhir. Itu cepat dan kualitas gambar tetap seperti aslinya. Jika video ini tidak mengizinkannya, GaleriQ membangunnya ulang sepenuhnya – itu sedikit lebih lama. Durasi total %1$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai tagliato solo inizio e fine. È veloce e la qualità resta come nell’originale. Se questo video non lo consente, GaleriQ lo ricrea per intero e ci vuole un po’ di più. Durata totale %1$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "始まりと終わりだけをカットしました。すばやく保存でき、画質も元のままです。この動画で難しい場合は、GaleriQ が全体を作り直すため少し時間がかかります。全体の長さ %1$@。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작과 끝만 잘랐어요. 빠르게 저장되고 화질은 원본 그대로예요. 이 동영상에서 안 되면 GaleriQ가 전체를 다시 만들어서 조금 더 걸려요. 전체 길이 %1$@."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har bare klippet begynnelsen og slutten. Det går raskt, og bildekvaliteten forblir som i originalen. Hvis videoen ikke tillater det, bygger GaleriQ den opp helt på nytt – det tar litt lengre tid. Total lengde %1$@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt alleen begin en einde ingekort. Dat gaat snel en de beeldkwaliteit blijft als in het origineel. Lukt dat bij deze video niet, dan maakt GaleriQ hem helemaal opnieuw – dat duurt iets langer. Totale lengte %1$@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przycięto tylko początek i koniec. To szybkie, a jakość obrazu zostaje jak w oryginale. Jeśli ten film na to nie pozwala, GaleriQ utworzy go od nowa – potrwa to trochę dłużej. Łączna długość %1$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você só cortou o início e o fim. Isso é rápido e a qualidade da imagem fica como no original. Se este vídeo não permitir, o GaleriQ o refaz por completo – o que leva um pouco mais. Duração total %1$@."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cortou apenas o início e o fim. É rápido e a qualidade fica como no original. Se este vídeo não o permitir, o GaleriQ recria-o por completo – demora um pouco mais. Duração total %1$@."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai tăiat doar începutul și sfârșitul. Merge repede, iar calitatea rămâne ca în original. Dacă videoclipul nu permite asta, GaleriQ îl reface complet – durează puțin mai mult. Durată totală %1$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы обрезали только начало и конец. Это быстро, и качество остаётся как в оригинале. Если это видео так не позволяет, GaleriQ пересоздаст его целиком – это займёт чуть больше времени. Общая длина %1$@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har bara klippt början och slutet. Det går snabbt och bildkvaliteten förblir som i originalet. Om videon inte tillåter det bygger GaleriQ om den helt – det tar lite längre tid. Total längd %1$@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณตัดเฉพาะตอนต้นและตอนท้าย ซึ่งรวดเร็วและคุณภาพภาพเหมือนต้นฉบับ หากวิดีโอนี้ทำแบบนั้นไม่ได้ GaleriQ จะสร้างใหม่ทั้งหมด – ซึ่งใช้เวลานานขึ้นเล็กน้อย ความยาวรวม %1$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca başı ve sonu kestin. Bu hızlıdır ve görüntü kalitesi orijinaldeki gibi kalır. Bu video buna izin vermezse GaleriQ onu baştan oluşturur – biraz daha uzun sürer. Toplam süre %1$@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви обрізали лише початок і кінець. Це швидко, а якість лишається як в оригіналі. Якщо це відео так не дозволяє, GaleriQ створить його заново – це трохи довше. Загальна довжина %1$@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn chỉ cắt phần đầu và cuối. Việc này nhanh và chất lượng hình giữ như bản gốc. Nếu video này không cho phép, GaleriQ sẽ dựng lại toàn bộ – lâu hơn một chút. Tổng thời lượng %1$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你只修剪了开头和结尾。这样很快，画质也与原视频一样。如果这个视频无法这样处理，GaleriQ 会完整重新生成，需要稍长时间。总时长 %1$@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你只剪輯了開頭和結尾。這很快，畫質也與原始檔相同。如果這段影片不支援，GaleriQ 會完整重建 – 需要稍久一點。總長度 %1$@。"
          }
        }
      }
    },
    "vid_export_info_reencode": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بسبب تغييراتك الأخرى يعيد GaleriQ إنشاء الفيديو كاملًا عند الحفظ. قد يستغرق ذلك لحظة. المدة الكلية %1$@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "På grund af dine andre ændringer genopbygger GaleriQ hele videoen, når du gemmer. Det kan tage et øjeblik. Samlet længde %1$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wegen deiner anderen Änderungen berechnet GaleriQ das ganze Video beim Speichern neu. Das kann einen Moment dauern. Gesamtlänge %1$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Because of your other changes, GaleriQ rebuilds the whole video when you save. This can take a moment. Total length %1$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por tus otros cambios, GaleriQ vuelve a generar todo el vídeo al guardar. Puede tardar un momento. Duración total %1$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À cause de vos autres modifications, GaleriQ recalcule toute la vidéo à l’enregistrement. Cela peut prendre un moment. Durée totale %1$@."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Karena perubahan lainnya, GaleriQ membangun ulang seluruh video saat disimpan. Ini bisa butuh sebentar. Durasi total %1$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per le altre modifiche, GaleriQ ricrea l’intero video al salvataggio. Può volerci un momento. Durata totale %1$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかの変更があるため、保存時に GaleriQ が動画全体を作り直します。少し時間がかかることがあります。全体の長さ %1$@。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 변경 사항 때문에 저장할 때 GaleriQ가 동영상 전체를 다시 만들어요. 잠시 걸릴 수 있어요. 전체 길이 %1$@."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "På grunn av de andre endringene dine bygger GaleriQ opp hele videoen på nytt når du lagrer. Det kan ta litt tid. Total lengde %1$@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Door je andere wijzigingen maakt GaleriQ bij het opslaan de hele video opnieuw. Dat kan even duren. Totale lengte %1$@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Z powodu innych zmian GaleriQ przy zapisie utworzy cały film od nowa. To może chwilę potrwać. Łączna długość %1$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por causa das suas outras alterações, o GaleriQ refaz o vídeo inteiro ao salvar. Isso pode levar um momento. Duração total %1$@."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Devido às outras alterações, o GaleriQ recria o vídeo inteiro ao guardar. Pode demorar um momento. Duração total %1$@."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Din cauza celorlalte modificări, GaleriQ reface întregul videoclip la salvare. Poate dura un moment. Durată totală %1$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Из-за других изменений GaleriQ пересоздаёт всё видео при сохранении. Это может занять немного времени. Общая длина %1$@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "På grund av dina andra ändringar bygger GaleriQ om hela videon när du sparar. Det kan ta en stund. Total längd %1$@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เนื่องจากการเปลี่ยนแปลงอื่นๆ ของคุณ GaleriQ จะสร้างวิดีโอใหม่ทั้งหมดเมื่อบันทึก อาจใช้เวลาสักครู่ ความยาวรวม %1$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer değişikliklerin nedeniyle GaleriQ kaydederken videonun tamamını yeniden oluşturur. Bu biraz sürebilir. Toplam süre %1$@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Через інші зміни GaleriQ створює все відео заново під час збереження. Це може трохи зайняти. Загальна довжина %1$@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Do các thay đổi khác của bạn, GaleriQ sẽ dựng lại toàn bộ video khi lưu. Việc này có thể mất một lúc. Tổng thời lượng %1$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于你的其他更改，GaleriQ 会在保存时重新生成整个视频，可能需要一点时间。总时长 %1$@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由於你的其他更改，GaleriQ 在儲存時會重建整段影片。這可能需要一點時間。總長度 %1$@。"
          }
        }
      }
    },
