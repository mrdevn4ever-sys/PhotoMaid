    "wf_empty": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد مسارات عمل خاصة بعد. استخدم قالبًا أو أنشئ سير عمل جديدًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনো আপনার নিজের কোনো ওয়ার্কফ্লো নেই। একটি টেমপ্লেট ব্যবহার করুন বা নতুন ওয়ার্কফ্লো তৈরি করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Encara no tens fluxos de treball propis. Fes servir una plantilla o crea’n un de nou."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím žádné vlastní postupy. Použijte šablonu nebo vytvořte nový postup."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen egne arbejdsgange endnu. Brug en skabelon, eller opret en ny arbejdsgang."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine eigenen Abläufe. Übernimm eine Vorlage oder lege einen neuen Ablauf an."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Καμία δική σου ροή εργασιών ακόμη. Χρησιμοποίησε ένα πρότυπο ή δημιούργησε νέα ροή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No workflows of your own yet. Use a template or create a new workflow."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no tienes flujos propios. Usa una plantilla o crea uno nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei vielä omia työnkulkuja. Käytä mallia tai luo uusi työnkulku."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore de flux personnel. Utilise un modèle ou crée un nouveau flux."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હજી તમારા પોતાના કોઈ વર્કફ્લો નથી. ટેમ્પ્લેટ વાપરો કે નવો વર્કફ્લો બનાવો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עדיין אין תהליכי עבודה משלך. אפשר להשתמש בתבנית או ליצור תהליך עבודה חדש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी आपके अपने कोई वर्कफ़्लो नहीं। कोई टेम्पलेट इस्तेमाल करें या नया वर्कफ़्लो बनाएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Još nema vlastitih tijekova rada. Upotrijebi predložak ili izradi novi tijek rada."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még nincs saját munkafolyamatod. Használj sablont, vagy hozz létre újat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada alur kerja milikmu. Pakai templat atau buat alur kerja baru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessun flusso personale. Usa un modello o creane uno nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分のワークフローはまだありません。テンプレートを使うか新しく作成してください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇನ್ನೂ ನಿಮ್ಮ ಸ್ವಂತ ವರ್ಕ್‌ಫ್ಲೋಗಳಿಲ್ಲ. ಟೆಂಪ್ಲೇಟ್ ಬಳಸಿ ಅಥವಾ ಹೊಸ ವರ್ಕ್‌ಫ್ಲೋ ರಚಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 나만의 작업 흐름이 없어요. 템플릿을 사용하거나 새로 만드세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇതുവരെ സ്വന്തം വർക്ക്‌ഫ്ലോകളില്ല. ഒരു ടെംപ്ലേറ്റ് ഉപയോഗിക്കുക അല്ലെങ്കിൽ പുതിയ വർക്ക്‌ഫ്ലോ സൃഷ്‌ടിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अजून तुमचे स्वतःचे वर्कफ्लो नाहीत. टेम्पलेट वापरा किंवा नवीन वर्कफ्लो तयार करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada aliran kerja anda sendiri. Gunakan templat atau cipta aliran kerja baharu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen egne arbeidsflyter ennå. Bruk en mal eller lag en ny arbeidsflyt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen eigen werkstromen. Gebruik een sjabloon of maak een nieuwe."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏପର୍ଯ୍ୟନ୍ତ ଆପଣଙ୍କ ନିଜ କୌଣସି ୱାର୍କଫ୍ଲୋ ନାହିଁ। ଏକ ଟେମ୍ପଲେଟ୍ ବ୍ୟବହାର କରନ୍ତୁ କିମ୍ବା ନୂଆ ୱାର୍କଫ୍ଲୋ ତିଆରି କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹਾਲੇ ਤੁਹਾਡਾ ਆਪਣਾ ਕੋਈ ਵਰਕਫ਼ਲੋ ਨਹੀਂ। ਕੋਈ ਟੈਂਪਲੇਟ ਵਰਤੋ ਜਾਂ ਨਵਾਂ ਵਰਕਫ਼ਲੋ ਬਣਾਓ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak własnych przepływów. Użyj szablonu lub utwórz nowy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há fluxos seus. Use um modelo ou crie um novo fluxo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não tens fluxos próprios. Usa um modelo ou cria um novo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încă nu ai fluxuri proprii. Folosește un șablon sau creează unul nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Своих сценариев пока нет. Используйте шаблон или создайте новый."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatiaľ žiadne vlastné postupy. Použite šablónu alebo vytvorte nový postup."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Še nimaš lastnih potekov dela. Uporabi predlogo ali ustvari nov potek dela."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga egna arbetsflöden ännu. Använd en mall eller skapa ett nytt arbetsflöde."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இன்னும் உங்கள் சொந்தப் பணிப்பாய்வுகள் இல்லை. ஒரு வார்ப்புருவைப் பயன்படுத்துங்கள் அல்லது புதிய பணிப்பாய்வை உருவாக்குங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇంకా మీ సొంత వర్క్‌ఫ్లోలు లేవు. ఒక టెంప్లేట్ వాడండి లేదా కొత్త వర్క్‌ఫ్లో సృష్టించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีเวิร์กโฟลว์ของคุณเอง ใช้เทมเพลตหรือสร้างเวิร์กโฟลว์ใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz kendi iş akışın yok. Bir şablon kullan veya yeni bir akış oluştur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Власних сценаріїв ще немає. Використайте шаблон або створіть новий."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ابھی آپ کے اپنے کوئی ورک فلو نہیں۔ کوئی ٹیمپلیٹ استعمال کریں یا نیا ورک فلو بنائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có quy trình của riêng bạn. Hãy dùng mẫu hoặc tạo quy trình mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有自己的工作流程。使用模板或新建一个。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有你自己的工作流程。使用範本或建立新的工作流程。"
          }
        }
      }
    },
