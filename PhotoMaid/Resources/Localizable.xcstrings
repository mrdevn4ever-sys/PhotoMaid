    "basket_files_footer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستُحذف هذه الملفات نهائيًا. لا يمكنك التراجع عن ذلك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ফাইলগুলো স্থায়ীভাবে মুছে ফেলা হবে। এটি পূর্বাবস্থায় ফেরানো যায় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquests fitxers s’esborraran definitivament. No es pot desfer."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tyto soubory budou trvale smazány. Tuto akci nelze vrátit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Disse filer slettes permanent. Det kan ikke fortrydes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Dateien werden endgültig gelöscht. Du kannst das nicht rückgängig machen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτά τα αρχεία θα διαγραφούν οριστικά. Δεν αναιρείται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These files will be permanently deleted. You can’t undo this."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos archivos se borrarán definitivamente. No podrás deshacerlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nämä tiedostot poistetaan pysyvästi. Tätä ei voi kumota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces fichiers seront supprimés définitivement. Tu ne pourras pas annuler cette action."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ ફાઇલો કાયમ માટે ડિલીટ થશે. આ પૂર્વવત્ કરી શકાતું નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקבצים האלה יימחקו לצמיתות. אי אפשר לבטל את זה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ये फ़ाइलें स्थायी रूप से डिलीट होंगी। इसे पहले जैसा नहीं किया जा सकता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ove će se datoteke trajno izbrisati. To se ne može poništiti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezek a fájlok véglegesen törlődnek. Ez nem vonható vissza."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File ini akan dihapus secara permanen. Ini tidak dapat diurungkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questi file verranno eliminati definitivamente. Non potrai annullare l’azione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのファイルは完全に削除されます。元に戻すことはできません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಫೈಲ್‌ಗಳನ್ನು ಶಾಶ್ವತವಾಗಿ ಅಳಿಸಲಾಗುತ್ತದೆ. ಇದನ್ನು ರದ್ದುಗೊಳಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일들은 영구 삭제돼요. 되돌릴 수 없어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ഫയലുകൾ ശാശ്വതമായി ഇല്ലാതാക്കും. ഇത് പഴയപടിയാക്കാനാകില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या फाइल्स कायमच्या डिलीट होतील. हे पूर्ववत करता येणार नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Fail ini akan dipadam secara kekal. Anda tidak boleh membuat asal."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Disse filene slettes permanent. Det kan ikke angres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze bestanden worden definitief verwijderd. Je kunt dit niet ongedaan maken."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହି ଫାଇଲ୍‌ଗୁଡ଼ିକ ସ୍ଥାୟୀ ଭାବେ ଡିଲିଟ୍ ହେବ। ଏହାକୁ ପୂର୍ବାବସ୍ଥାକୁ ଫେରାଯାଇପାରିବ ନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਫ਼ਾਈਲਾਂ ਪੱਕੇ ਤੌਰ ’ਤੇ ਮਿਟਾਈਆਂ ਜਾਣਗੀਆਂ। ਇਸਨੂੰ ਵਾਪਸ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te pliki zostaną trwale usunięte. Nie możesz tego cofnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estes arquivos serão apagados permanentemente. Não é possível desfazer."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Estes ficheiros serão eliminados definitivamente. Não poderás anular esta ação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceste fișiere vor fi șterse definitiv. Nu vei putea anula acțiunea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти файлы будут удалены навсегда. Отменить это нельзя."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieto súbory budú natrvalo vymazané. Táto akcia sa nedá vrátiť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te datoteke bodo trajno izbrisane. Tega ni mogoče razveljaviti."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Filerna raderas permanent. Det går inte att ångra."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தக் கோப்புகள் நிரந்தரமாக நீக்கப்படும். இதைச் செயல்தவிர்க்க முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ ఫైళ్లు శాశ్వతంగా తొలగించబడతాయి. దీన్ని రద్దు చేయడం సాధ్యం కాదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์เหล่านี้จะถูกลบถาวร ไม่สามารถเลิกทำได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dosyalar kalıcı olarak silinecek. Bu işlemi geri alamazsın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ці файли буде видалено назавжди. Скасувати це не можна."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ فائلیں مستقل طور پر حذف ہوں گی۔ اسے واپس نہیں کیا جا سکتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các tệp này sẽ bị xóa vĩnh viễn. Bạn không thể hoàn tác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些文件将被永久删除，无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些檔案將被永久刪除。此動作無法還原。"
          }
        }
      }
    },
