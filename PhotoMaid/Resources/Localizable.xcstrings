    "vault_recovery_missing": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدون مفتاح استرداد، يضيع المحتوى إذا نسيت رمزك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Notfallschlüssel ist der Inhalt verloren, wenn du den Code vergisst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without a recovery key, the content is lost if you forget your code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin clave de recuperación, el contenido se pierde si olvidas tu código."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans clé de secours, le contenu est perdu si tu oublies ton code."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza chiave di recupero, il contenuto va perso se dimentichi il codice."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復旧キーがないと、コードを忘れた場合に中身が失われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복구 키가 없으면 암호를 잊었을 때 콘텐츠를 잃게 됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonder herstelsleutel ben je de inhoud kwijt als je je code vergeet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez klucza odzyskiwania zawartość przepadnie, jeśli zapomnisz kodu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem chave de recuperação, o conteúdo perde-se se te esqueceres do código."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fără cheie de recuperare, conținutul se pierde dacă uiți codul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без ключа восстановления содержимое будет потеряно, если ты забудешь код."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurtarma anahtarı olmadan, kodunu unutursan içerik kaybolur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Без ключа відновлення вміст буде втрачено, якщо ти забудеш код."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果没有恢复密钥，忘记密码后内容将会丢失。"
          }
        }
      }
    },
    "vault_recovery_present": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إعداد مفتاح استرداد. إنشاء مفتاح جديد يُبطل المفتاح القديم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Notfallschlüssel ist eingerichtet. Ein neuer macht den alten ungültig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A recovery key is set up. Creating a new one makes the old one invalid."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay una clave de recuperación configurada. Si creas una nueva, la anterior deja de ser válida."
