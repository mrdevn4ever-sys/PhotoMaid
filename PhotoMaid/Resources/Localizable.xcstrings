    "edit_mk_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على عنصر أضفته لتحريكه. إصبعان لتغيير الحجم والتدوير."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যোগ করা কিছু সরাতে তাতে ট্যাপ করুন। দুই আঙুলে আকার বদলান ও ঘোরান।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un element afegit per moure’l. Amb dos dits en canvies la mida i el gires."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na přidaný prvek ho posunete. Dvěma prsty měníte velikost a otáčíte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på noget, du har tilføjet, for at flytte det. To fingre ændrer størrelse og roterer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf etwas Hinzugefügtes, um es zu verschieben. Zwei Finger ändern Größe und Drehung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάτησε κάτι που πρόσθεσες για να το μετακινήσεις. Με δύο δάχτυλα αλλάζεις μέγεθος και περιστρέφεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap something you added to move it. Two fingers resize and rotate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca algo que hayas añadido para moverlo. Con dos dedos cambias tamaño y giro."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta lisäämääsi kohdetta siirtääksesi sitä. Kahdella sormella muutat kokoa ja kierrät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche un élément ajouté pour le déplacer. Deux doigts pour la taille et la rotation."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઉમેરેલી વસ્તુ ખસેડવા તેના પર ટૅપ કરો. બે આંગળીથી કદ બદલો અને ફેરવો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקשה על פריט שהוספת מאפשרת להזיז אותו. בשתי אצבעות משנים גודל ומסובבים."
