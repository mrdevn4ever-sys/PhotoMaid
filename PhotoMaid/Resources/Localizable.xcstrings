        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "యాప్‌లు మార్చినా రన్ అవుతూనే ఉంటుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำงานต่อแม้คุณสลับแอพ"
