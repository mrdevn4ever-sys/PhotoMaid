    "pro_also": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اشترِ مرة واحدة ونظّف بلا إعلانات. بلا اشتراك أو حساب PhotoMaid."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmal kaufen, ohne Werbung aufräumen. Kein Abo und kein PhotoMaid-Konto."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Buy once, clean up without ads. No subscription or PhotoMaid account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compra una vez y limpia sin anuncios. Sin suscripción ni cuenta de PhotoMaid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seul achat pour faire le tri sans pub. Sans abonnement ni compte PhotoMaid."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Acquista una volta e riordina senza pubblicità. Senza abbonamento né account PhotoMaid."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度の購入で広告なし。サブスクもPhotoMaidアカウントも不要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번 구매하고 광고 없이 정리하세요. 구독도 PhotoMaid 계정도 필요 없어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén keer kopen en opruimen zonder advertenties. Geen abonnement of PhotoMaid-account."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kup raz i porządkuj bez reklam. Bez abonamentu i konta PhotoMaid."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Compra uma vez e limpa sem anúncios. Sem subscrição nem conta PhotoMaid."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cumperi o dată și faci curățenie fără reclame. Fără abonament sau cont PhotoMaid."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Купи один раз и убирай без рекламы. Без подписки и аккаунта PhotoMaid."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kez satın al, reklamsız temizle. Abonelik ve PhotoMaid hesabı yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Купи один раз і прибирай без реклами. Без передплати й облікового запису PhotoMaid."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次购买，清理无广告。无需订阅或 PhotoMaid 账号。"
          }
        }
      }
    },
