    "vid_cut_draft": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إزالة %1$@ – %2$@؟ اسحب المقابض الحمراء."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ – %2$@ সরাবেন? লাল হ্যান্ডেল টানুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar %1$@ – %2$@? Arrossega les nanses vermelles."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstranit %1$@ – %2$@? Přetáhněte červené úchyty."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjern %1$@ – %2$@? Træk i de røde håndtag."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ – %2$@ entfernen? Rote Griffe ziehen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αφαίρεση %1$@ – %2$@; Σύρε τις κόκκινες λαβές."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove %1$@ – %2$@? Drag the red handles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Quitar %1$@ – %2$@? Arrastra los tiradores rojos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poistetaanko %1$@ – %2$@? Vedä punaisia kahvoja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer %1$@ – %2$@ ? Fais glisser les poignées rouges."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ – %2$@ દૂર કરવું છે? લાલ હૅન્ડલ ખેંચો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "להסיר %1$@ – %2$@? יש לגרור את הידיות האדומות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ – %2$@ हटाएँ? लाल हैंडल खींचें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukloniti %1$@ – %2$@? Povuci crvene ručke."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Eltávolítod: %1$@ – %2$@? Húzd a piros fogantyúkat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus %1$@ – %2$@? Seret pegangan merah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuovere %1$@ – %2$@? Trascina le maniglie rosse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ – %2$@ を削除しますか？赤いハンドルをドラッグ。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ – %2$@ ತೆಗೆದುಹಾಕಬೇಕೇ? ಕೆಂಪು ಹ್ಯಾಂಡಲ್‌ಗಳನ್ನು ಎಳೆಯಿರಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ – %2$@를 제거할까요? 빨간 핸들을 끌어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ – %2$@ നീക്കം ചെയ്യണോ? ചുവന്ന ഹാൻഡിലുകൾ വലിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ – %2$@ काढायचे? लाल हँडल ओढा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buang %1$@ – %2$@? Seret pemegang merah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjerne %1$@ – %2$@? Dra i de røde håndtakene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ – %2$@ verwijderen? Sleep de rode grepen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ – %2$@ ହଟାଇବେ? ଲାଲ ହ୍ୟାଣ୍ଡେଲ୍ ଟାଣନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੀ %1$@ – %2$@ ਹਟਾਉਣਾ ਹੈ? ਲਾਲ ਹੈਂਡਲ ਖਿੱਚੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunąć %1$@ – %2$@? Przeciągnij czerwone uchwyty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remover %1$@ – %2$@? Arraste as alças vermelhas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Remover %1$@ – %2$@? Arrasta as pegas vermelhas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimini %1$@ – %2$@? Trage de mânerele roșii."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить %1$@ – %2$@? Перетащи красные маркеры."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstrániť %1$@ – %2$@? Potiahnite červené úchyty."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstranim %1$@ – %2$@? Povleci rdeči ročici."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta bort %1$@ – %2$@? Dra i de röda handtagen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ – %2$@ அகற்றவா? சிவப்புக் கைப்பிடிகளை இழுங்கள்."
          }
