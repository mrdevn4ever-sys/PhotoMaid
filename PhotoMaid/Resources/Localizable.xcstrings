    "lib_order_added_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأحدث إضافةً أولًا – بترتيب تطبيق الصور."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সম্প্রতি যোগ করা আগে – ফটো অ্যাপের ক্রমে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Afegits recentment primer, en l’ordre de l’app Fotos."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Naposledy přidané nahoře – v pořadí aplikace Fotky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Senest tilføjet først – i samme rækkefølge som appen Fotos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuletzt hinzugefügt zuerst – in der Reihenfolge der Fotos-App."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πρόσφατες προσθήκες πρώτα – με τη σειρά της εφαρμογής Φωτογραφίες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recently added first – in the order of the Photos app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadidos recientemente primero, en el orden de la app Fotos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viimeksi lisätyt ensin – Kuvat-apin järjestyksessä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouts récents en premier – dans l’ordre de l’app Photos."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તાજેતરમાં ઉમેરેલા પહેલાં – ફોટો ઍપના ક્રમમાં."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שנוספו לאחרונה קודם – בסדר של היישום ״תמונות״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हाल में जोड़े गए पहले – तस्वीरें ऐप के क्रम में।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nedavno dodano prvo – redoslijedom aplikacije Fotografije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A nemrég hozzáadottak elöl – a Fotók app sorrendjében."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Baru ditambahkan di atas – sesuai urutan app Foto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunti di recente per primi, nell’ordine dell’app Foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近追加した項目が先頭 –「写真」アプリの順序です。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇತ್ತೀಚೆಗೆ ಸೇರಿಸಿದವು ಮೊದಲು – ಫೋಟೋಗಳು ಆ್ಯಪ್‌ನ ಕ್ರಮದಲ್ಲಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 추가한 항목 먼저 – 사진 앱의 순서예요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അടുത്തിടെ ചേർത്തവ ആദ്യം – ഫോട്ടോസ് ആപ്പിലെ ക്രമത്തിൽ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अलीकडे जोडलेले आधी – फोटो अ‍ॅपच्या क्रमाने."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditambah baru-baru ini dahulu – mengikut susunan app Foto."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nylig lagt til først – i samme rekkefølge som Bilder-appen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Recent toegevoegd eerst – in de volgorde van de Foto’s-app."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ନିକଟରେ ଯୋଗ ହୋଇଥିବା ପ୍ରଥମେ – ଫଟୋ ଆପ୍‌ର କ୍ରମରେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹਾਲ ਹੀ ਵਿੱਚ ਜੋੜੀਆਂ ਪਹਿਲਾਂ – ਫ਼ੋਟੋਆਂ ਐਪ ਵਾਲੇ ਕ੍ਰਮ ਵਿੱਚ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostatnio dodane najpierw – w kolejności aplikacji Zdjęcia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicionadas recentemente primeiro – na ordem do app Fotos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicionados recentemente primeiro – pela ordem da app Fotografias."
          }
