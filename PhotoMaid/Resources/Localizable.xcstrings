          "stringUnit": {
            "state": "translated",
            "value": "‘%1$@’은(는) 이제 정리할 때 나타나지 않아요"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» vises ikke lenger når du rydder"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%1$@’ verschijnt niet meer tijdens het opruimen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@” nie będzie już pokazywany podczas porządkowania"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” não aparecerá mais durante a limpeza"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” deixa de aparecer ao arrumar"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@” nu mai apare la ordonare"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» больше не будет показываться при наведении порядка"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”%1$@” visas inte längre när du rensar"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” จะไม่ปรากฏขณะจัดระเบียบอีก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” artık düzenlerken gösterilmeyecek"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» більше не показуватиметься під час упорядкування"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” sẽ không còn xuất hiện khi dọn dẹp"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "整理时将不再显示“%1$@”"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "整理時將不再顯示「%1$@」"
          }
        }
      }
    },
