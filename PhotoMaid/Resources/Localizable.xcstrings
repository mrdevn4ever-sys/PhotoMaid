    "onb_try_done": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هكذا تعمل. حان دور صورك الآن."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So geht’s. Jetzt sind deine Fotos dran."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That’s how it works. Now for your photos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Así funciona. Ahora les toca a tus fotos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu connais les gestes. Place à tes photos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ecco come funziona. Ora tocca alle tue foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使い方はこれだけ。次は自分の写真で。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방법은 이게 전부예요. 이제 내 사진을 정리해요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zo werkt het. Nu zijn je foto’s aan de beurt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tak to działa. Teraz czas na Twoje zdjęcia."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "É assim que funciona. Agora é a vez das tuas fotos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Așa funcționează. Acum urmează fotografiile tale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вот как это работает. Теперь очередь твоих фото."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşte bu kadar. Şimdi sıra fotoğraflarında."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ось як це працює. Тепер черга твоїх фото."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "就是这样，现在轮到你的照片了。"
          }
        }
      }
    },
    "onb_try_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعلى: احتفاظ. يسار: سلة المهملات. يمين: لاحقًا. جرّب هنا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach oben: behalten. Nach links: Papierkorb. Nach rechts: später. Probiere es hier aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Up: keep. Left: trash. Right: later. Try it here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arriba: conservar. Izquierda: papelera. Derecha: después. Pruébalo aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En haut : garder. À gauche : corbeille. À droite : plus tard. Essaie ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su: conserva. Sinistra: cestino. Destra: più tardi. Prova qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上で残す、左でゴミ箱、右であとで。ここで試してみましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위: 보관. 왼쪽: 휴지통. 오른쪽: 나중에. 여기서 연습해 보세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omhoog: bewaren. Links: prullenbak. Rechts: later. Probeer het hier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W górę: zachowaj. W lewo: kosz. W prawo: później. Wypróbuj tutaj."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cima: manter. Esquerda: lixo. Direita: mais tarde. Experimenta aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus: păstrează. Stânga: coș. Dreapta: mai târziu. Încearcă aici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вверх: оставить. Влево: корзина. Вправо: позже. Попробуй здесь."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yukarı: sakla. Sola: çöp kutusu. Sağa: sonra. Burada dene."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Угору: залишити. Ліворуч: кошик. Праворуч: пізніше. Спробуй тут."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向上保留，向左放入回收站，向右稍后再看。在这里试试吧。"
          }
        }
      }
    },
