        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Video bewerken hoort bij Pro. Je kunt alles uitproberen; om te bewaren heb je Pro nodig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Edycja filmów należy do Pro. Możesz wszystko wypróbować; do zapisania potrzebujesz Pro."
