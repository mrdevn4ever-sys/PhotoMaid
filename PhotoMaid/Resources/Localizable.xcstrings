    "large_none_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يتجاوز أي ملف متاح ومعروف الحجم %1$lld ميغابايت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter den zugänglichen Dateien mit bekannter Größe ist keine größer als %1$lld MB."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "None of the accessible files with a known size is larger than %1$lld MB."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún archivo accesible de tamaño conocido supera los %1$lld MB."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parmi les fichiers accessibles de taille connue, aucun ne dépasse %1$lld Mo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tra i file accessibili di dimensione nota, nessuno supera %1$lld MB."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセス可能でサイズがわかるファイルに、%1$lld MBを超えるものはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "접근 가능하고 크기를 알 수 있는 파일 중 %1$lld MB보다 큰 파일은 없어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Van de toegankelijke bestanden met een bekende grootte is er geen groter dan %1$lld MB."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żaden dostępny plik o znanym rozmiarze nie przekracza %1$lld MB."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum dos ficheiros acessíveis de tamanho conhecido tem mais de %1$lld MB."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Niciun fișier accesibil cu dimensiune cunoscută nu depășește %1$lld MB."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Среди доступных файлов с известным размером нет файлов больше %1$lld МБ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişilebilen ve boyutu bilinen dosyaların hiçbiri %1$lld MB boyutunu aşmıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Серед доступних файлів із відомим розміром жоден не перевищує %1$lld МБ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可访问且大小已知的文件中，没有超过 %1$lld MB 的文件。"
          }
        }
      }
    },
    "large_unknown_footer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حجم هذه الملفات غير متاح. لا نقدّره ولا نضيفه إلى الإجمالي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diese Dateien ist keine Größe verfügbar. Ihre Größen werden nicht geschätzt oder mitgezählt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These files have no available size. Their sizes aren’t estimated or included in the total."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tamaño de estos archivos no está disponible. No se estima ni se incluye en el total."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La taille de ces fichiers est indisponible. Elle n’est ni estimée ni incluse dans le total."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La dimensione di questi file non è disponibile. Non viene stimata né inclusa nel totale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのファイルはサイズを取得できません。推定せず、合計にも含めません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일들의 크기는 알 수 없어요. 크기를 추정하거나 합계에 넣지 않아요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor deze bestanden is geen grootte beschikbaar. Hun grootte wordt niet geschat of meegeteld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozmiar tych plików jest niedostępny. Nie jest szacowany ani wliczany do sumy."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O tamanho destes ficheiros não está disponível. Não é estimado nem incluído no total."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimensiunea acestor fișiere nu este disponibilă. Nu este estimată și nu este inclusă în total."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Размер этих файлов недоступен. Он не оценивается и не включается в сумму."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dosyaların boyutu alınamıyor. Boyutları tahmin edilmez ve toplama katılmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розмір цих файлів недоступний. Він не оцінюється й не враховується в сумі."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法获取这些文件的大小。不会估算，也不计入总大小。"
          }
        }
      }
    },
