        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Čeka – kreće sama čim „%1$@” završi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Várakozik – magától indul, amint a(z) „%1$@” kész."
