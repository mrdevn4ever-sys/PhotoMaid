    "tour_today_status_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هنا تجد ما اخترت إزالته أو حفظته لوقت لاحق. لا تتم الإزالة إلا بعد تأكيدك في سلة المهملات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সরানোর জন্য আলাদা রাখা বা পরের জন্য রাখা আইটেম এখানে খুঁজুন। ট্র্যাশে আপনি নিশ্চিত করার পরেই কেবল সরানো হয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí trobes el que has apartat per eliminar o desat per a més tard. Només s’elimina quan ho confirmes a la paperera."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tady najdete, co jste odložili k odstranění nebo uložili na později. K odstranění dojde až po potvrzení v koši."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Her finder du emner, der er lagt til side til fjernelse eller gemt til senere. Fjernelse sker først, når du bekræfter i papirkurven."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier findest du Aussortiertes und für später Gespeichertes. Entfernt wird erst nach deiner Bestätigung im Papierkorb."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εδώ βρίσκεις όσα έβαλες στην άκρη για αφαίρεση ή αποθήκευσες για αργότερα. Η αφαίρεση γίνεται μόνο αφού επιβεβαιώσεις στον κάδο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find items set aside for removal or saved for later here. Removal only happens after you confirm in the trash."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí encontrarás lo que has apartado o guardado para después. Solo se quita tras confirmarlo en la papelera."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Täältä löydät poistettavaksi syrjään siirretyt ja myöhemmäksi tallennetut. Poisto tapahtuu vasta, kun vahvistat sen roskakorissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu retrouves ici ce qui est destiné au retrait ou gardé pour plus tard. Le retrait a lieu uniquement après ta confirmation dans la corbeille."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "દૂર કરવા બાજુએ રાખેલી કે પછી માટે સાચવેલી આઇટમ અહીં મળે છે. ટ્રેશમાં પુષ્ટિ કર્યા પછી જ દૂર થાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כאן נמצאים פריטים שהועברו הצידה להסרה או נשמרו למאוחר יותר. ההסרה מתבצעת רק אחרי אישור בפח."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हटाने के लिए अलग रखे या बाद के लिए सहेजे आइटम यहाँ मिलते हैं। हटाना तभी होता है जब आप ट्रैश में पुष्टि करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovdje pronalaziš ono što si odvojio za uklanjanje ili spremio za kasnije. Uklanjanje se događa tek nakon potvrde u smeću."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Itt találod, amit eltávolításra félretettél vagy későbbre mentettél. Az eltávolítás csak a kukában adott megerősítésed után történik meg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Temukan di sini item yang disisihkan untuk dihapus atau disimpan untuk nanti. Penghapusan baru terjadi setelah kamu konfirmasi di sampah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui trovi ciò che hai scelto di rimuovere o salvato per più tardi. La rimozione avviene solo dopo la conferma nel cestino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除用に選んだものや、あとで見るものがここにあります。ゴミ箱で確認するまで削除されません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ತೆಗೆದುಹಾಕಲು ಪಕ್ಕಕ್ಕಿಟ್ಟ ಅಥವಾ ನಂತರಕ್ಕೆ ಇರಿಸಿದ ಐಟಂಗಳನ್ನು ಇಲ್ಲಿ ಹುಡುಕಿ. ಕಸದ ಬುಟ್ಟಿಯಲ್ಲಿ ನೀವು ದೃಢೀಕರಿಸಿದ ನಂತರವೇ ತೆಗೆದುಹಾಕಲಾಗುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제하려고 고르거나 나중에 보도록 저장한 항목이 여기에 있어요. 휴지통에서 확인해야 삭제돼요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നീക്കം ചെയ്യാൻ മാറ്റിവച്ചതോ പിന്നീടേക്ക് വച്ചതോ ആയ ഇനങ്ങൾ ഇവിടെ കണ്ടെത്തുക. ട്രാഷിൽ നിങ്ങൾ സ്ഥിരീകരിച്ച ശേഷം മാത്രമേ നീക്കം ചെയ്യൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "काढण्यासाठी बाजूला ठेवलेले किंवा नंतरसाठी जतन केलेले आयटम इथे सापडतात. ट्रॅशमध्ये पुष्टी केल्यानंतरच काढणे होते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cari item yang diketepikan untuk dibuang atau disimpan untuk nanti di sini. Pembuangan hanya berlaku selepas anda mengesahkan dalam sampah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Her finner du elementer som er lagt til side for fjerning eller lagret til senere. Fjerning skjer først når du bekrefter i papirkurven."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier vind je items die je wilt verwijderen of voor later hebt bewaard. Verwijderen gebeurt pas na je bevestiging in de prullenbak."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ହଟାଇବା ପାଇଁ ଅଲଗା ରଖାଯାଇଥିବା କିମ୍ବା ପରେ ପାଇଁ ରଖାଯାଇଥିବା ଆଇଟମ୍ ଏଠାରେ ଖୋଜନ୍ତୁ। ଟ୍ରାସରେ ଆପଣ ନିଶ୍ଚିତ କରିବା ପରେ ହିଁ ହଟାଯାଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹਟਾਉਣ ਲਈ ਵੱਖ ਰੱਖੀਆਂ ਜਾਂ ਬਾਅਦ ਲਈ ਰੱਖੀਆਂ ਆਈਟਮਾਂ ਇੱਥੇ ਲੱਭੋ। ਹਟਾਉਣਾ ਸਿਰਫ਼ ਰੱਦੀ ਵਿੱਚ ਤੁਹਾਡੀ ਪੁਸ਼ਟੀ ਤੋਂ ਬਾਅਦ ਹੁੰਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu znajdziesz to, co czeka na usunięcie lub zostało zapisane na później. Usuwanie następuje dopiero po potwierdzeniu w koszu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontre aqui os itens separados para remover ou guardados para depois. A remoção só acontece depois que você confirma na lixeira."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Aqui encontras o que separaste para remover ou guardaste para mais tarde. A remoção só acontece após confirmares no lixo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aici găsești ce ai ales să elimini sau ai salvat pentru mai târziu. Eliminarea are loc doar după confirmarea în coș."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь всё, что выбрано для удаления или сохранено на потом. Удаление происходит только после подтверждения в корзине."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu nájdete, čo ste odložili na odstránenie alebo uložili na neskôr. K odstráneniu dôjde až po potvrdení v koši."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tukaj najdeš, kar si odložil za odstranitev ali shranil za pozneje. Odstranitev se zgodi šele po potrditvi v košu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Här hittar du objekt som lagts undan för borttagning eller sparats till senare. Borttagning sker först när du bekräftar i papperskorgen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அகற்ற ஒதுக்கியவை அல்லது பிறகுக்கு வைத்தவற்றை இங்கே காணுங்கள். குப்பையில் நீங்கள் உறுதிப்படுத்திய பின்னரே அகற்றப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "తీసివేయడానికి పక్కన పెట్టినవి లేదా తర్వాతకు పెట్టినవి ఇక్కడ కనుగొనండి. ట్రాష్‌లో మీరు నిర్ధారించిన తర్వాతే తీసివేయబడతాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูรายการที่แยกไว้เพื่อนำออกหรือบันทึกไว้ทีหลังได้ที่นี่ การนำออกจะเกิดขึ้นหลังคุณยืนยันในถังขยะเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaldırmak için ayırdıkların ve sonra için sakladıkların burada. Kaldırma yalnızca çöp kutusunda onay verdikten sonra gerçekleşir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут є вибране для видалення та збережене на потім. Видалення відбувається лише після підтвердження в кошику."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہٹانے کے لیے الگ رکھے یا بعد کے لیے محفوظ آئٹمز یہاں ملتے ہیں۔ ہٹانا تب ہی ہوتا ہے جب آپ ردی میں تصدیق کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tìm ở đây các mục đã để riêng để xóa hoặc lưu để sau. Việc xóa chỉ xảy ra sau khi bạn xác nhận trong thùng rác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选出的待移除内容和稍后查看的内容都在这里。只有在回收站中确认后，才会移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在這裡找到擱置待移除或存為稍後的項目。只有在你在垃圾桶中確認後才會移除。"
          }
        }
      }
    },
