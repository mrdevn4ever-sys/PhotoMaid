    "vid_trim_hint_reencode": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب المقابض. المدة الكلية %1$@. بسبب تغييراتك الأخرى يُعاد إنشاء الفيديو عند الحفظ – وهذا يستغرق وقتًا أطول قليلًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieh an den Griffen. Gesamtlänge %1$@. Wegen deiner anderen Änderungen wird das Video beim Speichern neu berechnet – das dauert etwas."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag the handles. Total length %1$@. Because of your other changes, the video is rebuilt when you save – this takes a little longer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra los tiradores. Duración total %1$@. Por tus otros cambios, el vídeo se vuelve a generar al guardar y tarda un poco más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser les poignées. Durée totale %1$@. À cause de vos autres modifications, la vidéo est recalculée à l’enregistrement – cela prend un peu plus de temps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina le maniglie. Durata totale %1$@. Per le altre modifiche, il video viene ricreato al salvataggio e ci vuole un po’ di più."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハンドルをドラッグします。全体の長さ %1$@。ほかの変更があるため、保存時に動画を作り直します。少し時間がかかります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "핸들을 끌어 주세요. 전체 길이 %1$@. 다른 변경 사항 때문에 저장할 때 동영상을 다시 만들어요. 조금 더 걸려요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep aan de grepen. Totale lengte %1$@. Door je andere wijzigingen wordt de video bij het opslaan opnieuw gemaakt – dat duurt iets langer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij uchwyty. Łączna długość %1$@. Z powodu innych zmian film zostanie przy zapisie utworzony od nowa – to potrwa trochę dłużej."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste as pegas. Duração total %1$@. Devido às outras alterações, o vídeo é recriado ao guardar – demora um pouco mais."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trage de mânere. Durată totală %1$@. Din cauza celorlalte modificări, videoclipul este refăcut la salvare – durează puțin mai mult."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Потяните за ручки. Общая длина %1$@. Из-за других изменений видео пересоздаётся при сохранении – это займёт чуть больше времени."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutamaçları sürükle. Toplam süre %1$@. Diğer değişikliklerin nedeniyle video kaydederken yeniden oluşturulur – biraz daha uzun sürer."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Потягніть ручки. Загальна довжина %1$@. Через інші зміни відео створюється заново під час збереження – це трохи довше."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动手柄。总时长 %1$@。由于你的其他更改，保存时会重新生成视频，需要稍长一点时间。"
          }
        }
      }
    },
    "vid_trim_hint_short": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب المقابض لتحديد البداية والنهاية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe die Griffe, um Anfang und Ende festzulegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag the handles to set the start and end."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra los controles para fijar el inicio y el final."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais glisser les poignées pour définir le début et la fin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina le maniglie per impostare inizio e fine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハンドルをドラッグして開始と終了を決めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "핸들을 끌어 시작과 끝을 정하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep de grepen om begin en einde te bepalen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij uchwyty, aby ustawić początek i koniec."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrasta as pegas para definir o início e o fim."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trage de mânere pentru a stabili începutul și sfârșitul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащи ползунки, чтобы задать начало и конец."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlangıcı ve bitişi belirlemek için tutamaçları sürükle."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягни повзунки, щоб задати початок і кінець."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动手柄来设置开头和结尾。"
          }
        }
      }
    },
