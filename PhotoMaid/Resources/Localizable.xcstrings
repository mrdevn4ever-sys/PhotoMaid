          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完全に削除をオンにしますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영구 삭제를 켤까요?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Definitief verwijderen inschakelen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włączyć trwałe usuwanie?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativar a eliminação definitiva?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Activezi ștergerea definitivă?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включить удаление навсегда?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalıcı silme açılsın mı?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкнути видалення назавжди?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要开启永久删除吗？"
          }
        }
      }
    },
    "set_delete_permanently_detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إيقاف: عند الإفراغ ينتقل كل شيء أولًا إلى سلة مهملات Android ويمكن استعادته لفترة. تشغيل: يُحذف كل شيء نهائيًا فورًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus: Beim Leeren kommt alles erst in den Android-Papierkorb und lässt sich eine Zeit lang zurückholen. An: Alles wird sofort endgültig gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off: when you empty the trash, everything goes to the Android trash first and can be brought back for a while. On: everything is deleted for good right away."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado: al vaciar, todo pasa primero a la papelera de Android y se puede recuperar durante un tiempo. Activado: todo se borra definitivamente al momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé : en vidant, tout va d’abord dans la corbeille Android et peut être récupéré pendant un temps. Activé : tout est supprimé définitivement tout de suite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivato: svuotando, tutto va prima nel cestino di Android e si può recuperare per un po’. Attivato: tutto viene eliminato definitivamente subito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフ：空にすると、まず Android のゴミ箱に入り、しばらくは元に戻せます。オン：すぐに完全に削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끔: 비우면 모두 먼저 Android 휴지통으로 가고 한동안 되살릴 수 있어요. 켬: 바로 완전히 삭제돼요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uit: bij het legen gaat alles eerst naar de Android-prullenbak en kun je het een tijd terughalen. Aan: alles wordt meteen definitief verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyłączone: przy opróżnianiu wszystko trafia najpierw do kosza Androida i przez jakiś czas można to przywrócić. Włączone: wszystko jest od razu usuwane na stałe."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Desligado: ao esvaziar, tudo vai primeiro para o lixo do Android e pode ser recuperado durante algum tempo. Ligado: tudo é eliminado definitivamente de imediato."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dezactivat: la golire, totul ajunge întâi în coșul Android și poate fi recuperat o vreme. Activat: totul se șterge definitiv imediat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выкл.: при очистке всё сначала попадает в корзину Android, и какое-то время это можно вернуть. Вкл.: всё сразу удаляется навсегда."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapalı: Boşaltınca her şey önce Android çöp kutusuna gider ve bir süre geri alınabilir. Açık: Her şey hemen kalıcı olarak silinir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вимк.: під час очищення все спершу потрапляє в кошик Android, і деякий час це можна повернути. Увімк.: усе одразу видаляється назавжди."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭：清空时所有内容先进入 Android 回收站，一段时间内可以恢复。开启：所有内容会立即被永久删除。"
          }
        }
      }
    },
