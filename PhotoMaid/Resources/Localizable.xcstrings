    "edit_persp_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب الزوايا الأربع إلى حواف مستند أو مبنى. تصبح المنطقة داخلها مستطيلًا مستقيمًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe die vier Ecken auf die Kanten eines Dokuments oder Gebäudes. Der Bereich darin wird zum geraden Rechteck."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag the four corners onto the edges of a document or building. The area inside becomes a straight rectangle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra las cuatro esquinas a los bordes de un documento o edificio. El área interior se convierte en un rectángulo recto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais glisser les quatre coins sur les bords d’un document ou d’un bâtiment. La zone intérieure devient un rectangle droit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina i quattro angoli sui bordi di un documento o di un edificio. L’area interna diventa un rettangolo dritto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "4つの角を書類や建物の端に合わせてドラッグすると、内側がまっすぐな長方形になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네 모서리를 문서나 건물의 가장자리로 끌어 놓으세요. 안쪽 영역이 반듯한 사각형이 돼요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep de vier hoeken naar de randen van een document of gebouw. Het gebied erbinnen wordt een rechte rechthoek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij cztery rogi na krawędzie dokumentu lub budynku. Obszar wewnątrz stanie się prostym prostokątem."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrasta os quatro cantos para as margens de um documento ou edifício. A área interior torna-se um retângulo direito."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trage cele patru colțuri pe marginile unui document sau ale unei clădiri. Zona dinăuntru devine un dreptunghi drept."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащи четыре угла на края документа или здания. Область внутри станет ровным прямоугольником."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dört köşeyi bir belgenin veya binanın kenarlarına sürükle. İçteki alan düz bir dikdörtgen olur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягни чотири кути на краї документа чи будівлі. Область усередині стане рівним прямокутником."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将四个角拖到文档或建筑物的边缘，内部区域会变成端正的矩形。"
          }
        }
      }
    },
