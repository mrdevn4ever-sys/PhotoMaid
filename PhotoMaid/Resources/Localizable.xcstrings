    "ana2_background_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض iOS التقدّم وقد يوقف التحليل في أي وقت، ثم يتابع عند فتح GaleriQ في المرة التالية. لا يغادر أي شيء هذا الـ iPhone."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS shows the progress and may stop the analysis at any time. It then continues the next time you open GaleriQ. Nothing leaves this iPhone."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS shows the progress and may stop the analysis at any time. It then continues the next time you open GaleriQ. Nothing leaves this iPhone."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS shows the progress and may stop the analysis at any time. It then continues the next time you open GaleriQ. Nothing leaves this iPhone."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS shows the progress and may stop the analysis at any time. It then continues the next time you open GaleriQ. Nothing leaves this iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS zeigt den Fortschritt an und kann die Analyse jederzeit beenden. Sie geht dann beim nächsten Öffnen von GaleriQ weiter. Nichts verlässt dieses iPhone."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS shows the progress and may stop the analysis at any time. It then continues the next time you open GaleriQ. Nothing leaves this iPhone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS shows the progress and may stop the analysis at any time. It then continues the next time you open GaleriQ. Nothing leaves this iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS muestra el progreso y puede detener el análisis en cualquier momento. Continuará la próxima vez que abras GaleriQ. Nada sale de este iPhone."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS shows the progress and may stop the analysis at any time. It then continues the next time you open GaleriQ. Nothing leaves this iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS affiche la progression et peut arrêter l’analyse à tout moment. Elle reprend à la prochaine ouverture de GaleriQ. Rien ne quitte cet iPhone."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS shows the progress and may stop the analysis at any time. It then continues the next time you open GaleriQ. Nothing leaves this iPhone."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
