    "feed_skipped_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مخفية أثناء السحب حتى تعيد تحميلها هنا. تبقى النسخ الأصلية دون تغيير."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjult under swipe, indtil du indlæser dem igen her. Originalerne er uændrede."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Swipen ausgeblendet, bis du sie hier erneut lädst. Originale bleiben unverändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidden while swiping until you reload them here. Originals stay unchanged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultos al deslizar hasta que los recargues aquí. Los originales no cambian."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masqués pendant le tri jusqu’à leur rechargement ici. Les originaux restent inchangés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Disembunyikan saat menggeser sampai kamu memuatnya lagi di sini. Aslinya tidak berubah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nascosti durante lo scorrimento finché non li ricarichi qui. Gli originali restano invariati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここで再読み込みするまで、スワイプ中は表示されません。元の項目は変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기서 다시 불러올 때까지 스와이프 중에 숨겨집니다. 원본은 변경되지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjult under sveiping til du laster dem inn igjen her. Originalene er uendret."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verborgen bij het vegen tot je ze hier opnieuw laadt. Originelen blijven ongewijzigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukryte podczas przesuwania, dopóki nie wczytasz ich tutaj ponownie. Oryginały pozostają bez zmian."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultas ao deslizar até você recarregá-las aqui. Os originais não são alterados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultos ao deslizar até os recarregar aqui. Os originais não são alterados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ascunse la glisare până le reîncarci aici. Originalele rămân neschimbate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрыты при смахивании, пока вы не загрузите их снова здесь. Оригиналы не меняются."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dolda vid svep tills du läser in dem här igen. Originalen är oförändrade."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ซ่อนไว้ขณะปัดจนกว่าคุณจะโหลดใหม่ที่นี่ ต้นฉบับไม่เปลี่ยนแปลง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Buradan yeniden yükleyene kadar kaydırırken gizlenir. Orijinaller değişmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Приховані під час гортання, доки ви не завантажите їх тут знову. Оригінали не змінюються."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bị ẩn khi vuốt cho đến khi bạn tải lại ở đây. Bản gốc không thay đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此重新加载前，滑动时会隐藏这些媒体。原件保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "滑動時隱藏，直到你在這裡重新載入。原始檔保持不變。"
          }
        }
      }
    },
