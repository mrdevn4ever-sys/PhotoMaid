    "done_note_media": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصور ومقاطع الفيديو الآن في «المحذوفة مؤخرًا» في تطبيق الصور. لا تتحرّر المساحة إلا بعد حذفها نهائيًا هناك."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos og videoer ligger nu i “Senest slettet” i appen Fotos. Pladsen frigøres først, når de slettes permanent der."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos und Videos liegen jetzt in „Zuletzt gelöscht“ der Fotos-App. Speicher wird erst frei, wenn sie dort endgültig gelöscht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos and videos are now in “Recently Deleted” in the Photos app. Space is freed only once they’re permanently deleted there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos y los vídeos están ahora en «Eliminado» de la app Fotos. El espacio se libera cuando se borran definitivamente allí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos et vidéos sont maintenant dans « Suppressions récentes » de l’app Photos. L’espace n’est libéré qu’une fois qu’elles y sont définitivement supprimées."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto dan video sekarang ada di “Baru Dihapus” di app Foto. Ruang baru kosong setelah dihapus permanen di sana."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto e video ora sono in «Eliminati di recente» nell’app Foto. Lo spazio si libera solo quando vengono eliminati definitivamente da lì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真とビデオは写真アプリの「最近削除した項目」にあります。そこで完全に削除されたときに容量が空きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진과 비디오는 이제 사진 앱의 '최근 삭제된 항목'에 있습니다. 그곳에서 영구 삭제되어야 공간이 확보됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildene og videoene ligger nå i «Nylig slettet» i Bilder-appen. Plassen frigjøres først når de slettes permanent der."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto’s en video’s staan nu in ‘Recent verwijderd’ in de Foto’s-app. Er komt pas ruimte vrij als ze daar definitief zijn verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdjęcia i filmy są teraz w „Ostatnio usunięte” w aplikacji Zdjęcia. Miejsce zwolni się dopiero po ich trwałym usunięciu stamtąd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As fotos e vídeos agora estão em “Apagados” no app Fotos. O espaço só é liberado quando forem apagados permanentemente lá."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As fotografias e vídeos estão agora em «Apagados recentemente» na app Fotografias. O espaço só é libertado quando forem apagados definitivamente aí."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozele și videoclipurile sunt acum în „Șterse recent” din aplicația Poze. Spațiul se eliberează abia când sunt șterse definitiv de acolo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото и видео теперь в «Недавно удаленных» приложения «Фото». Место освободится, только когда они будут окончательно удалены оттуда."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilderna och videorna ligger nu i ”Nyligen raderade” i appen Bilder. Utrymmet frigörs först när de raderas permanent där."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปภาพและวิดีโอตอนนี้อยู่ใน “ที่ลบล่าสุด” ในแอพรูปภาพ พื้นที่จะว่างเมื่อลบถาวรที่นั่นแล้วเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraflar ve videolar artık Fotoğraflar uygulamasındaki \"Son Silinenler\"de. Alan ancak oradan kalıcı olarak silindiklerinde boşalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото й відео тепер у «Нещодавно видалених» програми «Фото». Місце звільниться лише після остаточного видалення звідти."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh và video giờ nằm trong “Đã xóa gần đây” trong ứng dụng Ảnh. Dung lượng chỉ được giải phóng khi chúng bị xóa vĩnh viễn ở đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片和视频现在位于“照片”App 的“最近删除”中。只有在那里永久删除后才会释放空间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "照片和影片現在位於「照片」App 的「最近刪除」中。只有在那裡永久刪除後才會釋放空間。"
          }
        }
      }
    },
