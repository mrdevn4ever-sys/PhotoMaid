    "ret_hint_brush": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ارسم فوق الموضع بإصبع واحد. إصبعان للتكبير."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এক আঙুলে জায়গাটির ওপর রং বুলিয়ে দিন। দুই আঙুলে জুম করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinta sobre la zona amb un dit. Amb dos dits fas zoom."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedním prstem přetřete místo. Dvěma prsty přibližujete."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mal over stedet med én finger. To fingre zoomer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Male mit einem Finger über die Stelle. Zwei Finger zoomen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βάψε πάνω από το σημείο με ένα δάχτυλο. Με δύο κάνεις ζουμ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paint over the spot with one finger. Two fingers zoom."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinta sobre la zona con un dedo. Con dos dedos haces zoom."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Maalaa kohdan päälle yhdellä sormella. Kahdella sormella zoomaat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Peins la zone d’un doigt. Deux doigts pour zoomer."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "એક આંગળીથી તે જગ્યા પર રંગો. બે આંગળીથી ઝૂમ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לצבוע על המקום באצבע אחת. בשתי אצבעות מגדילים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक उँगली से जगह पर पेंट करें। दो उँगलियों से ज़ूम करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jednim prstom oboji preko mjesta. Dvama prstima zumiraš."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy ujjal fesd át a helyet. Két ujjal nagyítasz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Warnai bagian itu dengan satu jari. Dua jari untuk zoom."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipingi sulla zona con un dito. Con due dita ingrandisci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1本指でなぞって塗ります。2本指で拡大。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಒಂದು ಬೆರಳಿನಿಂದ ಆ ಜಾಗದ ಮೇಲೆ ಬಣ್ಣ ಹಚ್ಚಿ. ಎರಡು ಬೆರಳುಗಳಿಂದ ಜೂಮ್ ಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 손가락으로 칠하세요. 두 손가락으로 확대해요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരു വിരൽ കൊണ്ട് ആ ഭാഗത്ത് വരയ്ക്കുക. രണ്ട് വിരലുകൾ സൂം ചെയ്യുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "एका बोटाने त्या जागेवर रंगवा. दोन बोटांनी झूम करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cat di atas tempat itu dengan satu jari. Dua jari untuk zum."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mal over stedet med én finger. To fingre zoomer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schilder met één vinger over de plek. Met twee vingers zoom je."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଗୋଟିଏ ଆଙ୍ଗୁଠିରେ ସେହି ସ୍ଥାନ ଉପରେ ରଙ୍ଗ ବୁଲାନ୍ତୁ। ଦୁଇ ଆଙ୍ଗୁଠିରେ ଜୁମ୍ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇੱਕ ਉਂਗਲ ਨਾਲ ਉਸ ਥਾਂ ਉੱਤੇ ਰੰਗ ਫੇਰੋ। ਦੋ ਉਂਗਲਾਂ ਨਾਲ ਜ਼ੂਮ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamaluj miejsce jednym palcem. Dwoma palcami powiększasz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinte sobre o ponto com um dedo. Dois dedos ampliam."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinta por cima com um dedo. Com dois dedos fazes zoom."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pictează peste zonă cu un deget. Cu două degete mărești."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрась место одним пальцем. Двумя пальцами — масштаб."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedným prstom pretrite miesto. Dvoma prstami približujete."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Z enim prstom pobarvaj mesto. Z dvema prstoma povečaš."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Måla över stället med ett finger. Två fingrar zoomar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு விரலால் அந்த இடத்தின் மேல் வண்ணம் தீட்டுங்கள். இரண்டு விரல்கள் பெரிதாக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఒక వేలితో ఆ ప్రదేశంపై రంగు వేయండి. రెండు వేళ్లు జూమ్ చేస్తాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระบายทับจุดนั้นด้วยนิ้วเดียว สองนิ้วเพื่อซูม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek parmakla bölgenin üzerini boya. İki parmakla yakınlaştır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зафарбуй місце одним пальцем. Двома пальцями — масштаб."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک انگلی سے جگہ پر پینٹ کریں۔ دو انگلیوں سے زوم کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tô lên chỗ đó bằng một ngón. Hai ngón để thu phóng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用一根手指涂抹该区域，双指可缩放。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用一指塗抹該位置。兩指可縮放。"
          }
        }
      }
    },
    "ret_hint_tap": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط في الصورة حيث يجب أن تكون المنطقة، ثم فتّحها أو عتّمها أو غيّر لونها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফটোর যেখানে এলাকা হওয়া উচিত সেখানে ট্যাপ করুন। তারপর এটি উজ্জ্বল, গাঢ় করুন বা এর রং বদলান।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca la foto on ha d’anar l’àrea. Després aclareix-la, enfosqueix-la o canvia’n el color."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepněte na fotku tam, kde má být oblast. Pak ji zesvětlete, ztmavte nebo změňte její barvu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på fotoet, hvor området skal være. Gør det derefter lysere, mørkere, eller skift dets farve."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe ins Foto, wo der Bereich liegen soll. Dann aufhellen, abdunkeln oder Farbe ändern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάτησε στη φωτογραφία εκεί που πρέπει να είναι η περιοχή. Μετά φώτισέ την, σκούρυνέ την ή άλλαξε το χρώμα της."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the photo where the area should be. Then brighten, darken or change its colour."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca la foto donde debe ir la zona. Luego aclárala, oscurécela o cambia su color."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta kuvaa kohdasta, johon alue tulee. Vaalenna, tummenna tai vaihda sen väriä sen jälkeen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche la photo à l’endroit voulu. Ensuite, éclaircis, assombris ou change la couleur."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફોટા પર જ્યાં વિસ્તાર હોવો જોઈએ ત્યાં ટૅપ કરો. પછી તેને ઉજળો, ઘેરો કરો કે તેનો રંગ બદલો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "להקיש על התמונה במקום שבו האזור צריך להיות. אחר כך להבהיר, להכהות או לשנות את הצבע שלו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोटो पर वहाँ टैप करें जहाँ क्षेत्र होना चाहिए। फिर उसे चमकीला, गहरा करें या उसका रंग बदलें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirni fotografiju gdje treba biti područje. Zatim ga posvijetli, potamni ili mu promijeni boju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints a fotón oda, ahol a terület legyen. Utána világosítsd, sötétítsd vagy változtasd meg a színét."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk foto di tempat area itu seharusnya. Lalu cerahkan, gelapkan, atau ubah warnanya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca la foto dove deve trovarsi l’area. Poi schiariscila, scuriscila o cambiane il colore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "範囲を置きたい場所をタップします。その後、明るく・暗く・色を変えられます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪ್ರದೇಶ ಇರಬೇಕಾದಲ್ಲಿ ಫೋಟೋವನ್ನು ಟ್ಯಾಪ್ ಮಾಡಿ. ನಂತರ ಅದನ್ನು ಪ್ರಕಾಶಮಾನಗೊಳಿಸಿ, ಗಾಢಗೊಳಿಸಿ ಅಥವಾ ಅದರ ಬಣ್ಣ ಬದಲಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영역을 둘 곳을 사진에서 탭하세요. 그다음 밝게, 어둡게 하거나 색을 바꿔요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഭാഗം വേണ്ട ഇടത്ത് ഫോട്ടോയിൽ ടാപ്പ് ചെയ്യുക. തുടർന്ന് അത് തെളിച്ചമുള്ളതോ ഇരുണ്ടതോ ആക്കുക അല്ലെങ്കിൽ നിറം മാറ്റുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फोटोवर जिथे क्षेत्र हवे तिथे टॅप करा. मग ते उजळ, गडद करा किंवा त्याचा रंग बदला."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik foto di tempat kawasan itu sepatutnya. Kemudian cerahkan, gelapkan atau tukar warnanya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på bildet der området skal være. Gjør det så lysere, mørkere eller endre fargen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op de foto waar het gebied moet komen. Maak het daarna lichter, donkerder of verander de kleur."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଫଟୋରେ ଯେଉଁଠି କ୍ଷେତ୍ର ହେବା ଉଚିତ ସେଠାରେ ଟାପ୍ କରନ୍ତୁ। ତାପରେ ଏହାକୁ ଉଜ୍ଜ୍ୱଳ, ଗାଢ଼ କରନ୍ତୁ କିମ୍ବା ଏହାର ରଙ୍ଗ ବଦଳାନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਫ਼ੋਟੋ ਉੱਤੇ ਉੱਥੇ ਟੈਪ ਕਰੋ ਜਿੱਥੇ ਖੇਤਰ ਹੋਣਾ ਚਾਹੀਦਾ ਹੈ। ਫਿਰ ਇਸ ਨੂੰ ਚਮਕਦਾਰ, ਗੂੜ੍ਹਾ ਕਰੋ ਜਾਂ ਇਸ ਦਾ ਰੰਗ ਬਦਲੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotknij zdjęcia w miejscu obszaru. Potem rozjaśnij go, przyciemnij lub zmień kolor."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque na foto onde a área deve ficar. Depois clareie, escureça ou mude a cor dela."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca na foto onde a área deve ficar. Depois clareia, escurece ou muda a cor."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge fotografia acolo unde vrei zona. Apoi luminează, întunecă sau schimbă culoarea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажми на фото там, где нужна область. Затем осветли, затемни или измени цвет."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnite na fotku tam, kde má byť oblasť. Potom ju zosvetlite, stmavte alebo zmeňte jej farbu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapni fotografijo, kjer naj bo območje. Nato ga posvetli, potemni ali mu spremeni barvo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på bilden där området ska vara. Gör det sedan ljusare, mörkare eller ändra färgen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பகுதி இருக்க வேண்டிய இடத்தில் புகைப்படத்தைத் தட்டுங்கள். பின்னர் அதை ஒளிர்வாக்குங்கள், இருட்டாக்குங்கள் அல்லது நிறத்தை மாற்றுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రాంతం ఉండాల్సిన చోట ఫోటోను ట్యాప్ చేయండి. ఆ తర్వాత దాన్ని ప్రకాశవంతం, ముదురు చేయండి లేదా రంగు మార్చండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะบนรูปตรงที่ต้องการให้เป็นพื้นที่ แล้วทำให้สว่างขึ้น มืดลง หรือเปลี่ยนสี"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alanın olacağı yere dokun. Sonra aydınlat, karart veya rengini değiştir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкнися фото там, де має бути область. Потім освітли, затемни чи зміни колір."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تصویر پر وہاں ٹیپ کریں جہاں علاقہ ہونا چاہیے۔ پھر اسے روشن، گہرا کریں یا اس کا رنگ بدلیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm vào ảnh tại vị trí cần chỉnh. Sau đó làm sáng, làm tối hoặc đổi màu vùng đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在照片上点按需要调整的位置，然后提亮、压暗或改变颜色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在照片上點一下要調整的位置。然後調亮、調暗或更改顏色。"
          }
        }
      }
    },
