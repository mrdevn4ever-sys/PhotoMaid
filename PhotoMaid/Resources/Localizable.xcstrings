    "vault_edit_private_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى في الخزنة فقط – لن تظهر في تطبيق الصور ولا في أي مكان آخر في GaleriQ."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bliver kun i boksen – vises ikke i appen Fotos eller andre steder i GaleriQ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bleibt nur im Tresor – erscheint weder in der Fotos-App noch sonst irgendwo in GaleriQ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stays in the vault only – it won’t show up in the Photos app or anywhere else in GaleriQ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se queda solo en la caja fuerte: no aparece en la app Fotos ni en ningún otro lugar de GaleriQ."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reste uniquement dans le coffre : n’apparaît ni dans l’app Photos ni ailleurs dans GaleriQ."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya tetap di brankas – tidak muncul di app Foto atau di tempat lain di GaleriQ."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Resta solo nella cassaforte: non compare nell’app Foto né altrove in GaleriQ."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保管庫の中だけに保存され、写真アプリやGaleriQのほかの場所には表示されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "금고에만 저장되며 사진 앱이나 GaleriQ의 다른 곳에는 나타나지 않아요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Blir bare i safen – vises ikke i Bilder-appen eller noe annet sted i GaleriQ."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blijft alleen in de kluis – verschijnt niet in de Foto’s-app of ergens anders in GaleriQ."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostaje tylko w sejfie – nie pojawi się w aplikacji Zdjęcia ani nigdzie indziej w GaleriQ."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fica só no cofre – não aparece no app Fotos nem em nenhum outro lugar do GaleriQ."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Fica apenas no cofre – não aparece na app Fotografias nem em mais nenhum lado no GaleriQ."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Rămâne doar în seif – nu apare în aplicația Poze și nici în altă parte în GaleriQ."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остаётся только в сейфе – не появится ни в «Фото», ни где-либо ещё в GaleriQ."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stannar bara i valvet – visas inte i appen Bilder eller någon annanstans i GaleriQ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อยู่ในตู้เซฟเท่านั้น – จะไม่ปรากฏในแอพรูปภาพหรือที่อื่นใน GaleriQ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca kasada kalır – Fotoğraflar uygulamasında ya da GaleriQ’in başka bir yerinde görünmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишається лише в сейфі – не з’явиться ні у «Фото», ні деінде в GaleriQ."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ ở trong két sắt – không hiện trong ứng dụng Ảnh hay bất kỳ đâu khác trong GaleriQ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅保存在保险箱中，不会出现在“照片”App 或 GaleriQ 的其他任何位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只留在保險箱中 – 不會出現在「照片」App 或 GaleriQ 的其他地方。"
          }
        }
      }
    },
