    "tour_today_tab_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الملفات الكبيرة والصور المكررة والأشهر الفردية والمجموعات الجاهزة: هنا ترتّب خطوة بخطوة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Store filer, dublerede fotos, enkelte måneder og færdige samlinger: her rydder du op trin for trin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Große Dateien, doppelte Fotos, einzelne Monate und fertige Sammlungen: Hier räumst du gezielt auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Large files, duplicate photos, single months and ready-made collections: this is where you tidy up step by step."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivos grandes, fotos duplicadas, meses sueltos y colecciones listas: aquí ordenas paso a paso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gros fichiers, photos en double, mois par mois et collections prêtes : c’est ici que vous faites le tri pas à pas."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File besar, foto duplikat, bulan tertentu, dan koleksi siap pakai: di sinilah kamu merapikan langkah demi langkah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "File grandi, foto doppie, singoli mesi e raccolte pronte: qui riordini passo dopo passo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大きなファイル、重複した写真、月ごと、用意されたコレクション。ここで少しずつ整理できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "큰 파일, 중복 사진, 월별 정리, 준비된 컬렉션까지. 여기서 차근차근 정리해요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Store filer, dupliserte bilder, enkeltmåneder og ferdige samlinger: her rydder du steg for steg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Grote bestanden, dubbele foto’s, losse maanden en kant-en-klare collecties: hier ruim je stap voor stap op."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Duże pliki, podwójne zdjęcia, pojedyncze miesiące i gotowe kolekcje: tu robisz porządki krok po kroku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivos grandes, fotos duplicadas, meses individuais e coleções prontas: aqui você arruma passo a passo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ficheiros grandes, fotos duplicadas, meses individuais e coleções prontas: é aqui que arruma passo a passo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fișiere mari, fotografii duplicate, luni separate și colecții gata făcute: aici faci curățenie pas cu pas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Большие файлы, повторяющиеся фото, отдельные месяцы и готовые подборки: здесь вы наводите порядок шаг за шагом."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stora filer, dubblettbilder, enskilda månader och färdiga samlingar: här städar du steg för steg."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์ขนาดใหญ่ รูปซ้ำ แต่ละเดือน และคอลเลกชันสำเร็จรูป: ที่นี่คุณจัดระเบียบทีละขั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Büyük dosyalar, aynı fotoğraflar, tek tek aylar ve hazır koleksiyonlar: Burada adım adım düzenlersin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Великі файли, однакові фото, окремі місяці й готові добірки: тут ви наводите лад крок за кроком."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp lớn, ảnh trùng lặp, từng tháng và bộ sưu tập có sẵn: đây là nơi bạn dọn dẹp từng bước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "大文件、重复照片、按月整理和现成的合集：在这里一步步整理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "大型檔案、重複照片、單一月份和現成精選集：在這裡一步步整理。"
          }
        }
      }
    },
