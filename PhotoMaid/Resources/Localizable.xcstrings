    "feed_skipped_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مخفية أثناء السحب حتى تعيد تحميلها هنا. تبقى النسخ الأصلية دون تغيير."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখানে আবার লোড না করা পর্যন্ত সোয়াইপের সময় লুকানো থাকে। মূল ফাইল অপরিবর্তিত থাকে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Amagats en lliscar fins que els tornis a carregar aquí. Els originals no canvien."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při přejíždění skryto, dokud je tady znovu nenačtete. Originály zůstávají beze změny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjult under swipe, indtil du indlæser dem igen her. Originalerne er uændrede."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Swipen ausgeblendet, bis du sie hier erneut lädst. Originale bleiben unverändert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κρυμμένα κατά τη σάρωση μέχρι να τα φορτώσεις ξανά εδώ. Τα πρωτότυπα μένουν αμετάβλητα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidden while swiping until you reload them here. Originals stay unchanged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultos al deslizar hasta que los recargues aquí. Los originales no cambian."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Piilotettu pyyhkäistessä, kunnes lataat ne täällä uudelleen. Alkuperäiset pysyvät ennallaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masqués pendant le tri jusqu’à leur rechargement ici. Les originaux restent inchangés."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે અહીં ફરી લોડ ન કરો ત્યાં સુધી સ્વાઇપ કરતી વખતે છુપાયેલા રહેશે. મૂળ બદલાતાં નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מוסתרים בזמן ההחלקה עד שטוענים אותם כאן שוב. המקוריים לא משתנים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्वाइप करते समय छिपे रहेंगे जब तक आप उन्हें यहाँ फिर लोड न करें। मूल नहीं बदलते।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriveno pri povlačenju dok ih ovdje ponovno ne učitaš. Originali ostaju nepromijenjeni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzáskor rejtve, amíg itt újra be nem töltöd őket. Az eredetik változatlanok."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Disembunyikan saat menggeser sampai kamu memuatnya lagi di sini. Aslinya tidak berubah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nascosti durante lo scorrimento finché non li ricarichi qui. Gli originali restano invariati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここで再読み込みするまで、スワイプ中は表示されません。元の項目は変更されません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇಲ್ಲಿ ಮತ್ತೆ ಲೋಡ್ ಮಾಡುವವರೆಗೆ ಸ್ವೈಪ್ ಮಾಡುವಾಗ ಮರೆಯಾಗಿರುತ್ತವೆ. ಮೂಲಗಳು ಬದಲಾಗದೆ ಉಳಿಯುತ್ತವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기서 다시 불러올 때까지 스와이프 중에 숨겨집니다. 원본은 변경되지 않습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇവിടെ വീണ്ടും ലോഡ് ചെയ്യുന്നതുവരെ സ്വൈപ്പ് ചെയ്യുമ്പോൾ മറഞ്ഞിരിക്കും. ഒറിജിനലുകൾക്ക് മാറ്റമില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही ते इथे पुन्हा लोड करेपर्यंत स्वाइप करताना लपवलेले राहतील. मूळ बदलत नाहीत."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Disembunyikan semasa meleret sehingga anda memuatkannya semula di sini. Yang asal kekal tidak berubah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjult under sveiping til du laster dem inn igjen her. Originalene er uendret."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verborgen bij het vegen tot je ze hier opnieuw laadt. Originelen blijven ongewijzigd."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏଠାରେ ପୁଣି ଲୋଡ୍ ନକରିବା ପର୍ଯ୍ୟନ୍ତ ସ୍ୱାଇପ୍ ସମୟରେ ଲୁଚି ରହେ। ମୂଳ ଫାଇଲ୍ ଅପରିବର୍ତ୍ତିତ ରହେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਵਾਈਪ ਕਰਦੇ ਸਮੇਂ ਲੁਕੇ ਰਹਿੰਦੇ ਹਨ ਜਦੋਂ ਤੱਕ ਤੁਸੀਂ ਇਨ੍ਹਾਂ ਨੂੰ ਇੱਥੇ ਦੁਬਾਰਾ ਲੋਡ ਨਹੀਂ ਕਰਦੇ। ਮੂਲ ਬਿਨਾਂ ਬਦਲੇ ਰਹਿੰਦੇ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukryte podczas przesuwania, dopóki nie wczytasz ich tutaj ponownie. Oryginały pozostają bez zmian."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultas ao deslizar até você recarregá-las aqui. Os originais não são alterados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultos ao deslizar até os recarregar aqui. Os originais não são alterados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ascunse la glisare până le reîncarci aici. Originalele rămân neschimbate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрыты при смахивании, пока вы не загрузите их снова здесь. Оригиналы не меняются."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pri potiahnutí skryté, kým ich tu znova nenačítate. Originály zostávajú bez zmeny."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrito med podrsanjem, dokler jih tukaj znova ne naložiš. Izvirniki ostanejo nespremenjeni."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dolda vid svep tills du läser in dem här igen. Originalen är oförändrade."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இங்கே மீண்டும் ஏற்றும் வரை ஸ்வைப் செய்யும்போது மறைந்திருக்கும். அசல்கள் மாறாமல் இருக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇక్కడ మళ్లీ లోడ్ చేసే వరకు స్వైప్ చేసేటప్పుడు దాచి ఉంటాయి. ఒరిజినల్‌లు మారవు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ซ่อนไว้ขณะปัดจนกว่าคุณจะโหลดใหม่ที่นี่ ต้นฉบับไม่เปลี่ยนแปลง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Buradan yeniden yükleyene kadar kaydırırken gizlenir. Orijinaller değişmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Приховані під час гортання, доки ви не завантажите їх тут знову. Оригінали не змінюються."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سوائپ کرتے وقت چھپے رہیں گے جب تک آپ انہیں یہاں دوبارہ لوڈ نہ کریں۔ اصل تبدیل نہیں ہوتے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bị ẩn khi vuốt cho đến khi bạn tải lại ở đây. Bản gốc không thay đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此重新加载前，滑动时会隐藏这些媒体。原件保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "滑動時隱藏，直到你在這裡重新載入。原始檔保持不變。"
          }
        }
      }
    },
