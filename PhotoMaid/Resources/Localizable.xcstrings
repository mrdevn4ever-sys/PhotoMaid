        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ממשיך לפעול גם כשעוברים ליישום אחר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप बदलने पर भी चलता रहता है।"
