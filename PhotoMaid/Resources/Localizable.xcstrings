    "excl_confirm_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن تظهر عناصر هذا الألبوم أثناء الترتيب بعد الآن. لا يُحذف أو يُنقل أي شيء. للتراجع: الإعدادات › الألبومات المستبعدة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পরিষ্কার করার সময় এই অ্যালবামের আইটেম আর দেখা যাবে না। কিছুই মুছে ফেলা বা সরানো হয় না। ফেরাতে: সেটিংস › বাদ দেওয়া অ্যালবাম।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els elements d’aquest àlbum deixaran d’aparèixer en endreçar. No s’esborra ni es mou res. Es pot desfer a Configuració › Àlbums exclosos."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Položky z tohoto alba se při úklidu přestanou zobrazovat. Nic se nemaže ani nepřesouvá. Vrátit lze v Nastavení › Vyloučená alba."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Emner i dette album vises ikke længere, når du rydder op. Intet slettes eller flyttes. Fortryd under Indstillinger › Udeladte albummer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos und Videos aus diesem Album erscheinen nicht mehr beim Aufräumen. Nichts wird gelöscht oder verschoben. Rückgängig in Einstellungen › Ausgenommene Alben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα στοιχεία αυτού του άλμπουμ δεν θα εμφανίζονται πια στο τακτοποίημα. Τίποτα δεν διαγράφεται ούτε μετακινείται. Αναίρεση στις Ρυθμίσεις › Εξαιρεμένα άλμπουμ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Items in this album will no longer appear while cleaning up. Nothing is deleted or moved. Undo in Settings › Excluded albums."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los elementos de este álbum ya no aparecerán al ordenar. No se borra ni se mueve nada. Puedes deshacerlo en Ajustes › Álbumes excluidos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämän albumin kohteet eivät enää näy siivotessa. Mitään ei poisteta eikä siirretä. Kumoa kohdassa Asetukset › Poissuljetut albumit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les éléments de cet album n’apparaîtront plus pendant le tri. Rien n’est supprimé ni déplacé. Annulable dans Réglages › Albums exclus."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સાફસફાઈ દરમિયાન આ આલ્બમની આઇટમ હવે દેખાશે નહીં. કંઈ ડિલીટ કે ખસેડાતું નથી. સેટિંગ્સ › બાકાત આલ્બમમાં પૂર્વવત્ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פריטים מהאלבום הזה לא יופיעו יותר בזמן הסידור. שום דבר לא נמחק או מועבר. אפשר לבטל בהגדרות › אלבומים מוחרגים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सफ़ाई करते समय इस एल्बम के आइटम अब नहीं दिखेंगे। कुछ भी डिलीट या हटाया नहीं जाता। सेटिंग्ज़ › बाहर रखे एल्बम में पूर्ववत करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stavke iz ovog albuma više se neće prikazivati pri raščišćavanju. Ništa se ne briše ni ne premješta. Poništavanje u Postavke › Izuzeti albumi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az album elemei nem jelennek meg többé rendrakáskor. Semmi sem törlődik és semmi sem mozdul. Visszavonás: Beállítások › Kizárt albumok."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Item di album ini tidak akan muncul lagi saat merapikan. Tidak ada yang dihapus atau dipindah. Urungkan di Pengaturan › Album yang dikecualikan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli elementi di questo album non compariranno più durante il riordino. Nulla viene eliminato o spostato. Annulla in Impostazioni › Album esclusi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアルバムの項目は整理中に表示されなくなります。削除も移動もされません。元に戻すには 設定 › 除外したアルバム。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ವಚ್ಛಗೊಳಿಸುವಾಗ ಈ ಆಲ್ಬಮ್‌ನ ಐಟಂಗಳು ಇನ್ನು ಕಾಣಿಸುವುದಿಲ್ಲ. ಏನನ್ನೂ ಅಳಿಸಲಾಗುವುದಿಲ್ಲ ಅಥವಾ ಸರಿಸಲಾಗುವುದಿಲ್ಲ. ರದ್ದುಗೊಳಿಸಲು: ಸೆಟ್ಟಿಂಗ್‌ಗಳು › ಹೊರಗಿಟ್ಟ ಆಲ್ಬಮ್‌ಗಳು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앨범의 항목은 더 이상 정리 중에 표시되지 않습니다. 삭제되거나 이동되는 것은 없습니다. 설정 › 제외된 앨범에서 되돌릴 수 있습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വൃത്തിയാക്കുമ്പോൾ ഈ ആൽബത്തിലെ ഇനങ്ങൾ ഇനി ദൃശ്യമാകില്ല. ഒന്നും ഇല്ലാതാക്കുകയോ നീക്കുകയോ ഇല്ല. പഴയപടിയാക്കാൻ: ക്രമീകരണം › ഒഴിവാക്കിയ ആൽബങ്ങൾ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "साफसफाई करताना या अल्बममधील आयटम आता दिसणार नाहीत. काहीही डिलीट किंवा हलवले जात नाही. सेटिंग्ज › वगळलेले अल्बम मध्ये पूर्ववत करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Item dalam album ini tidak akan dipaparkan lagi semasa mengemas. Tiada apa dipadam atau dialihkan. Buat asal dalam Seting › Album dikecualikan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Elementer i dette albumet vises ikke lenger når du rydder. Ingenting slettes eller flyttes. Angre under Innstillinger › Utelatte album."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Items uit dit album verschijnen niet meer tijdens het opruimen. Er wordt niets verwijderd of verplaatst. Terugdraaien via Instellingen › Uitgesloten albums."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସଫା କରିବା ସମୟରେ ଏହି ଆଲବମ୍‌ର ଆଇଟମ୍ ଆଉ ଦେଖାଯିବ ନାହିଁ। କିଛି ଡିଲିଟ୍ କିମ୍ବା ଘୁଞ୍ଚାଯାଏ ନାହିଁ। ଫେରାଇବାକୁ: ସେଟିଂସ › ବାଦ ଦିଆଯାଇଥିବା ଆଲବମ୍।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਫ਼ਾਈ ਕਰਦੇ ਸਮੇਂ ਇਸ ਐਲਬਮ ਦੀਆਂ ਆਈਟਮਾਂ ਹੁਣ ਨਹੀਂ ਦਿਸਣਗੀਆਂ। ਕੁਝ ਵੀ ਮਿਟਾਇਆ ਜਾਂ ਹਿਲਾਇਆ ਨਹੀਂ ਜਾਂਦਾ। ਵਾਪਸ ਲੈਣ ਲਈ: ਸੈਟਿੰਗਾਂ › ਬਾਹਰ ਰੱਖੀਆਂ ਐਲਬਮਾਂ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elementy z tego albumu nie będą już pojawiać się podczas porządkowania. Nic nie zostanie usunięte ani przeniesione. Cofniesz to w Ustawienia › Wykluczone albumy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os itens deste álbum não aparecerão mais durante a limpeza. Nada é apagado nem movido. Desfaça em Ajustes › Álbuns excluídos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os itens deste álbum deixam de aparecer ao arrumar. Nada é apagado nem movido. Anule em Definições › Álbuns excluídos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Elementele din acest album nu vor mai apărea la ordonare. Nimic nu este șters sau mutat. Anulezi din Configurări › Albume excluse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Объекты из этого альбома больше не будут появляться при уборке. Ничего не удаляется и не перемещается. Отменить: Настройки › Исключённые альбомы."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Položky z tohto albumu sa pri upratovaní prestanú zobrazovať. Nič sa nemaže ani nepresúva. Vrátiť možno v Nastavenia › Vylúčené albumy."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elementi iz tega albuma se pri čiščenju ne bodo več prikazovali. Nič se ne izbriše ali premakne. Razveljaviš v Nastavitve › Izključeni albumi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Objekt i det här albumet visas inte längre när du rensar. Inget raderas eller flyttas. Ångra i Inställningar › Undantagna album."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சுத்தம் செய்யும்போது இந்த ஆல்பத்தின் உருப்படிகள் இனி தோன்றாது. எதுவும் நீக்கப்படவோ நகர்த்தப்படவோ இல்லை. திரும்பப் பெற: அமைப்புகள் › விலக்கப்பட்ட ஆல்பங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "శుభ్రం చేసేటప్పుడు ఈ ఆల్బమ్‌లోని అంశాలు ఇక కనిపించవు. ఏదీ తొలగించబడదు, తరలించబడదు. రద్దు చేయడానికి: సెట్టింగ్‌లు › మినహాయించిన ఆల్బమ్‌లు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการในอัลบั้มนี้จะไม่ปรากฏขณะจัดระเบียบอีก ไม่มีอะไรถูกลบหรือย้าย เลิกทำได้ในการตั้งค่า › อัลบั้มที่ยกเว้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu albümdeki öğeler temizlik sırasında artık görünmez. Hiçbir şey silinmez veya taşınmaz. Geri almak için Ayarlar › Hariç tutulan albümler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Об’єкти з цього альбому більше не з’являтимуться під час прибирання. Нічого не видаляється й не переміщується. Скасувати: Налаштування › Виключені альбоми."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صفائی کے دوران اس البم کے آئٹمز اب نہیں دکھیں گے۔ کچھ بھی حذف یا منتقل نہیں ہوتا۔ ترتیبات › خارج البمز میں کالعدم کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các mục trong album này sẽ không còn xuất hiện khi dọn dẹp. Không có gì bị xóa hoặc di chuyển. Hoàn tác trong Cài đặt › Album bị loại trừ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此相簿中的项目将不再在整理时出现。不会删除或移动任何内容。可在“设置 › 已排除的相簿”中撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "整理時將不再顯示這個相簿中的項目。不會刪除或移動任何內容。可在「設定 › 排除的相簿」中還原。"
          }
        }
      }
    },
