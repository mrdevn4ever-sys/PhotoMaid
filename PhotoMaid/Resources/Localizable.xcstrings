        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنے کلیکشنز Pro کے ساتھ دستیاب ہیں۔ تیار کلیکشنز مفت ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bộ sưu tập tùy chỉnh có trong Pro. Bộ sưu tập có sẵn thì miễn phí."
          }
        },
        "zh-Hans": {
