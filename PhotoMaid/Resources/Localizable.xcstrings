          "stringUnit": {
            "state": "translated",
            "value": "ಉಳಿದ ಎಲ್ಲವೂ – ಎಡಿಟಿಂಗ್, ವಿಶ್ಲೇಷಣೆ, ನಕಲುಗಳು, ಸಂಗ್ರಹಗಳು, ಸ್ಟುಡಿಯೋ – ಎಲ್ಲರಿಗೂ ಉಚಿತ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 밖의 모든 기능(편집, 분석, 중복, 컬렉션, 스튜디오)은 누구나 무료예요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മറ്റെല്ലാം – എഡിറ്റിംഗ്, വിശകലനം, ഡ്യൂപ്ലിക്കേറ്റുകൾ, ശേഖരങ്ങൾ, സ്റ്റുഡിയോ – എല്ലാവർക്കും സൗജന്യമാണ്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "बाकी सर्व – संपादन, विश्लेषण, डुप्लिकेट, संग्रह, स्टुडिओ – सर्वांसाठी विनामूल्य आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Selebihnya – suntingan, analisis, pendua, koleksi, Studio – percuma untuk semua."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt annet – redigering, analyse, duplikater, samlinger, Studio – er gratis for alle."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Al het andere – bewerken, analyse, duplicaten, verzamelingen, Studio – is voor iedereen gratis."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ବାକି ସବୁକିଛି – ଏଡିଟିଂ, ବିଶ୍ଳେଷଣ, ଡୁପ୍ଲିକେଟ୍, ସଂଗ୍ରହ, ଷ୍ଟୁଡିଓ – ସମସ୍ତଙ୍କ ପାଇଁ ମାଗଣା।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਬਾਕੀ ਸਭ ਕੁਝ – ਸੋਧਣਾ, ਵਿਸ਼ਲੇਸ਼ਣ, ਡੁਪਲੀਕੇਟ, ਸੰਗ੍ਰਹਿ, ਸਟੂਡੀਓ – ਸਭ ਲਈ ਮੁਫ਼ਤ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko inne – edycja, analiza, duplikaty, kolekcje, Studio – jest bezpłatne dla wszystkich."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo o resto – edição, análise, duplicatas, coleções, Estúdio – é grátis para todos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o resto – edição, análise, duplicados, coleções, Estúdio – é gratuito para todos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tot restul – editare, analiză, duplicate, colecții, Studio – este gratuit pentru toți."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё остальное – редактирование, анализ, дубликаты, подборки, Студия – бесплатно для всех."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Všetko ostatné – úpravy, analýza, duplicity, kolekcie, Štúdio – je zadarmo pre všetkých."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vse drugo – urejanje, analiza, dvojniki, zbirke, Studio – je brezplačno za vse."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Allt annat – redigering, analys, dubbletter, samlingar, Studio – är gratis för alla."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மற்ற அனைத்தும் – திருத்துதல், பகுப்பாய்வு, நகல்கள், தொகுப்புகள், ஸ்டுடியோ – அனைவருக்கும் இலவசம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మిగతావన్నీ – ఎడిటింగ్, విశ్లేషణ, నకళ్లు, కలెక్షన్‌లు, స్టూడియో – అందరికీ ఉచితం."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกอย่างที่เหลือ – การแก้ไข การวิเคราะห์ รายการซ้ำ คอลเลกชัน สตูดิโอ – ใช้ได้ฟรีสำหรับทุกคน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer her şey – düzenleme, analiz, kopyalar, koleksiyonlar, Stüdyo – herkes için ücretsiz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе інше – редагування, аналіз, дублікати, добірки, Студія – безкоштовно для всіх."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "باقی سب – ترمیم، تجزیہ، ڈپلیکیٹس، کلیکشنز، اسٹوڈیو – سب کے لیے مفت ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi thứ khác – chỉnh sửa, phân tích, trùng lặp, bộ sưu tập, Studio – đều miễn phí cho mọi người."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他一切（编辑、分析、重复项、合集、工作室）对所有人免费。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其他所有功能 – 編輯、分析、重複項目、精選集、工作室 – 都對所有人免費。"
          }
        }
      }
    },
    "pro2_privacy": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُفحص صورك وملفاتك وتُرتب على جهازك فقط. للشراء يُرسل الضروري فقط إلى Apple، وللإعلانات في النسخة المجانية إلى Google – ولا تُرسل صورك أو أسماؤها أو أي بيانات منها أبدًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ফটো ও ফাইল শুধু আপনার ডিভাইসে যাচাই ও সাজানো হয়। কেনার জন্য শুধু প্রয়োজনীয় তথ্য Apple-এর কাছে যায়, এবং বিনামূল্যের সংস্করণে বিজ্ঞাপনের জন্য Google-এর কাছে – কখনো আপনার ফটো, তাদের নাম বা সেগুলোর বিবরণ নয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les teves fotos i fitxers es revisen i s’ordenen només al dispositiu. Per a la compra només va a Apple el necessari, i per als anuncis de la versió gratuïta, a Google: mai les teves fotos, els seus noms ni dades que se’n derivin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše fotky a soubory se kontrolují a třídí jen ve vašem zařízení. Při nákupu jde Applu jen to nezbytné a kvůli reklamám v bezplatné verzi Googlu – nikdy vaše fotky, jejich názvy ani údaje z nich."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine fotos og filer kontrolleres og sorteres kun på din enhed. Ved købet går kun det nødvendige til Apple og, for reklamer i gratisversionen, til Google – aldrig dine fotos, deres navne eller detaljer fra dem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Fotos und Dateien werden nur auf deinem Gerät geprüft und sortiert. Für den Kauf geht nur das Nötigste an Apple, für Werbung in der Gratis-Version an Google – nie deine Fotos, ihre Namen oder Angaben daraus."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι φωτογραφίες και τα αρχεία σου ελέγχονται και ταξινομούνται μόνο στη συσκευή σου. Για την αγορά πηγαίνει μόνο το απαραίτητο στην Apple και για τις διαφημίσεις της δωρεάν έκδοσης στη Google – ποτέ οι φωτογραφίες σου, τα ονόματά τους ή στοιχεία από αυτές."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your photos and files are checked and sorted only on your device. For the purchase only what is necessary goes to Apple, and for ads in the free version to Google – never your photos, their names or details from them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus fotos y archivos se revisan y ordenan solo en tu dispositivo. Para la compra solo se envía lo necesario a Apple y, para los anuncios de la versión gratuita, a Google; nunca tus fotos, sus nombres ni datos de ellas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvasi ja tiedostosi tarkistetaan ja lajitellaan vain laitteellasi. Ostoa varten Applelle menee vain välttämätön ja ilmaisversion mainoksia varten Googlelle – ei koskaan kuviasi, niiden nimiä tai niistä saatuja tietoja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes photos et fichiers sont vérifiés et triés uniquement sur ton appareil. Pour l’achat, seul le strict nécessaire est envoyé à Apple, et pour la publicité de la version gratuite à Google – jamais tes photos, leurs noms ni leurs informations."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારા ફોટા અને ફાઇલો ફક્ત તમારા ઉપકરણ પર ચકાસાય અને ગોઠવાય છે. ખરીદી માટે ફક્ત જરૂરી જ Apple ને જાય છે, અને મફત વર્ઝનની જાહેરાતો માટે Google ને – તમારા ફોટા, તેમનાં નામ કે તેમની વિગતો ક્યારેય નહીં."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התמונות והקבצים שלך נבדקים וממוינים רק במכשיר שלך. לרכישה עובר ל-Apple רק מה שנחוץ, ולפרסומות בגרסה החינמית – ל-Google; אף פעם לא התמונות שלך, השמות שלהן או פרטים מהן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी फ़ोटो और फ़ाइलें सिर्फ़ आपके डिवाइस पर जाँची और छाँटी जाती हैं। खरीदारी के लिए सिर्फ़ ज़रूरी जानकारी Apple को जाती है, और मुफ़्त वर्शन के विज्ञापनों के लिए Google को – आपकी फ़ोटो, उनके नाम या उनकी जानकारी कभी नहीं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje se fotografije i datoteke provjeravaju i razvrstavaju samo na tvom uređaju. Za kupnju Appleu ide samo ono nužno, a za oglase u besplatnoj verziji Googleu – nikad tvoje fotografije, njihovi nazivi ni podaci iz njih."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fotóidat és fájljaidat csak az eszközödön ellenőrzi és rendezi. A vásárláshoz csak a szükséges adat kerül az Apple-hez, az ingyenes verzió hirdetéseihez pedig a Google-hoz – a fotóid, a nevük vagy a belőlük származó adatok sosem."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto dan file-mu hanya diperiksa dan diurutkan di perangkatmu. Untuk pembelian, hanya yang diperlukan dikirim ke Apple, dan untuk iklan di versi gratis ke Google – tidak pernah fotomu, namanya, atau detail darinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto e file vengono controllati e ordinati solo sul tuo dispositivo. Per l’acquisto va ad Apple solo il necessario, per la pubblicità nella versione gratuita a Google – mai le tue foto, i loro nomi o dati da esse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真とファイルはデバイス上でのみ確認・整理されます。購入のためにAppleへ、無料版の広告のためにGoogleへ送られるのは必要最小限だけで、写真やその名前・情報が送られることはありません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಫೋಟೋಗಳು ಮತ್ತು ಫೈಲ್‌ಗಳನ್ನು ನಿಮ್ಮ ಸಾಧನದಲ್ಲಿ ಮಾತ್ರ ಪರಿಶೀಲಿಸಿ ವಿಂಗಡಿಸಲಾಗುತ್ತದೆ. ಖರೀದಿಗೆ ಅಗತ್ಯವಾದದ್ದು ಮಾತ್ರ Apple ಗೆ ಹೋಗುತ್ತದೆ, ಮತ್ತು ಉಚಿತ ಆವೃತ್ತಿಯಲ್ಲಿ ಜಾಹೀರಾತುಗಳಿಗಾಗಿ Google ಗೆ – ಎಂದಿಗೂ ನಿಮ್ಮ ಫೋಟೋಗಳು, ಅವುಗಳ ಹೆಸರುಗಳು ಅಥವಾ ಅವುಗಳ ವಿವರಗಳಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진과 파일은 기기에서만 확인하고 정리해요. 구매를 위해 Apple에, 무료 버전의 광고를 위해 Google에 꼭 필요한 정보만 보내며 사진, 사진 이름, 사진 정보는 절대 보내지 않아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ഫോട്ടോകളും ഫയലുകളും നിങ്ങളുടെ ഉപകരണത്തിൽ മാത്രം പരിശോധിക്കുകയും അടുക്കുകയും ചെയ്യുന്നു. വാങ്ങലിനായി ആവശ്യമുള്ളത് മാത്രം Apple-ലേക്ക് പോകുന്നു, സൗജന്യ പതിപ്പിൽ പരസ്യങ്ങൾക്കായി Google-ലേക്കും – ഒരിക്കലും നിങ്ങളുടെ ഫോട്ടോകളോ അവയുടെ പേരുകളോ വിശദാംശങ്ങളോ അല്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचे फोटो आणि फाइल्स फक्त तुमच्या डिव्हाइसवर तपासल्या आणि लावल्या जातात. खरेदीसाठी फक्त आवश्यक तेच Apple कडे जाते, आणि विनामूल्य आवृत्तीतील जाहिरातींसाठी Google कडे – तुमचे फोटो, त्यांची नावे किंवा त्यांचे तपशील कधीही नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto dan fail anda disemak dan diisih hanya pada peranti anda. Untuk pembelian, hanya yang perlu dihantar kepada Apple, dan untuk iklan dalam versi percuma kepada Google – tidak pernah foto anda, namanya atau butiran daripadanya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildene og filene dine kontrolleres og sorteres bare på enheten din. Ved kjøp går bare det nødvendige til Apple, og for annonser i gratisversjonen til Google – aldri bildene dine, navnene på dem eller detaljer fra dem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je foto’s en bestanden worden alleen op je apparaat gecontroleerd en gesorteerd. Voor de aankoop gaat alleen het nodige naar Apple, voor advertenties in de gratis versie naar Google – nooit je foto’s, hun namen of gegevens daaruit."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ ଫଟୋ ଓ ଫାଇଲ୍ କେବଳ ଆପଣଙ୍କ ଡିଭାଇସ୍‌ରେ ଯାଞ୍ଚ ଓ ସଜା ହୁଏ। କିଣିବା ପାଇଁ କେବଳ ଆବଶ୍ୟକ ତଥ୍ୟ Apple ପାଖକୁ ଯାଏ, ଏବଂ ମାଗଣା ସଂସ୍କରଣରେ ବିଜ୍ଞାପନ ପାଇଁ Google ପାଖକୁ – କେବେ ଆପଣଙ୍କ ଫଟୋ, ସେଗୁଡ଼ିକର ନାମ କିମ୍ବା ବିବରଣୀ ନୁହେଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੀਆਂ ਫ਼ੋਟੋਆਂ ਅਤੇ ਫ਼ਾਈਲਾਂ ਸਿਰਫ਼ ਤੁਹਾਡੇ ਡਿਵਾਈਸ ਉੱਤੇ ਜਾਂਚੀਆਂ ਅਤੇ ਛਾਂਟੀਆਂ ਜਾਂਦੀਆਂ ਹਨ। ਖ਼ਰੀਦ ਲਈ ਸਿਰਫ਼ ਲੋੜੀਂਦਾ ਡਾਟਾ Apple ਕੋਲ ਜਾਂਦਾ ਹੈ, ਅਤੇ ਮੁਫ਼ਤ ਵਰਜ਼ਨ ਵਿੱਚ ਇਸ਼ਤਿਹਾਰਾਂ ਲਈ Google ਕੋਲ – ਕਦੇ ਵੀ ਤੁਹਾਡੀਆਂ ਫ਼ੋਟੋਆਂ, ਉਨ੍ਹਾਂ ਦੇ ਨਾਂ ਜਾਂ ਉਨ੍ਹਾਂ ਦੇ ਵੇਰਵੇ ਨਹੀਂ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje zdjęcia i pliki są sprawdzane i porządkowane tylko na urządzeniu. Do zakupu trafia do Apple tylko to, co niezbędne, a do reklam w wersji bezpłatnej do Google – nigdy Twoje zdjęcia, ich nazwy ani dane z nich."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas fotos e arquivos são verificados e organizados só no seu aparelho. Na compra, só o necessário vai para a Apple e, para anúncios na versão grátis, para o Google – nunca suas fotos, os nomes delas ou detalhes delas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As tuas fotografias e ficheiros são verificados e organizados apenas no teu dispositivo. Para a compra só segue o necessário para a Apple e, para os anúncios da versão gratuita, para a Google – nunca as tuas fotografias, os seus nomes ou dados delas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozele și fișierele tale sunt verificate și sortate doar pe dispozitiv. Pentru cumpărare ajunge la Apple doar strictul necesar, iar pentru reclamele din versiunea gratuită la Google – niciodată pozele, numele lor sau date din ele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твои фото и файлы проверяются и сортируются только на устройстве. Для покупки в Apple уходит только необходимое, для рекламы в бесплатной версии – в Google, но никогда твои фото, их названия или данные из них."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše fotky a súbory sa kontrolujú a triedia len vo vašom zariadení. Pri nákupe ide Applu len to nevyhnutné a kvôli reklamám v bezplatnej verzii Googlu – nikdy vaše fotky, ich názvy ani údaje z nich."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje fotografije in datoteke se preverjajo in razvrščajo samo v tvoji napravi. Za nakup gre Applu le nujno potrebno, za oglase v brezplačni različici pa Googlu – nikoli tvoje fotografije, njihova imena ali podatki iz njih."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina bilder och filer kontrolleras och sorteras bara på din enhet. Vid köpet går bara det nödvändiga till Apple, och för annonser i gratisversionen till Google – aldrig dina bilder, deras namn eller detaljer från dem."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் புகைப்படங்களும் கோப்புகளும் உங்கள் சாதனத்தில் மட்டுமே சரிபார்க்கப்பட்டு வரிசைப்படுத்தப்படுகின்றன. வாங்குதலுக்குத் தேவையானது மட்டுமே Apple-க்குச் செல்லும், இலவசப் பதிப்பில் விளம்பரங்களுக்காக Google-க்கு – ஒருபோதும் உங்கள் புகைப்படங்களோ அவற்றின் பெயர்களோ விவரங்களோ அல்ல."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ ఫోటోలు, ఫైళ్లు మీ పరికరంలో మాత్రమే తనిఖీ చేసి అమర్చబడతాయి. కొనుగోలుకు అవసరమైనది మాత్రమే Appleకి వెళ్తుంది, ఉచిత వెర్షన్‌లో ప్రకటనల కోసం Googleకి – ఎప్పుడూ మీ ఫోటోలు, వాటి పేర్లు లేదా వాటి వివరాలు కాదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปภาพและไฟล์ของคุณถูกตรวจสอบและจัดเรียงบนอุปกรณ์ของคุณเท่านั้น สำหรับการซื้อ จะส่งเฉพาะที่จำเป็นไปยัง Apple และสำหรับโฆษณาในเวอร์ชันฟรีไปยัง Google – ไม่เคยส่งรูปภาพ ชื่อรูป หรือรายละเอียดจากรูป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğrafların ve dosyaların yalnızca cihazında kontrol edilir ve sıralanır. Satın alma için Apple’a, ücretsiz sürümdeki reklamlar için Google’a yalnızca gerekenler gider – fotoğrafların, adları veya onlardan bilgiler asla gitmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Твої фото й файли перевіряються та впорядковуються лише на пристрої. Для покупки до Apple надходить лише необхідне, для реклами в безкоштовній версії – до Google, але ніколи твої фото, їхні назви чи дані з них."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی تصاویر اور فائلیں صرف آپ کی ڈیوائس پر جانچی اور ترتیب دی جاتی ہیں۔ خریداری کے لیے صرف ضروری معلومات Apple کو جاتی ہیں، اور مفت ورژن کے اشتہارات کے لیے Google کو – آپ کی تصاویر، ان کے نام یا ان کی تفصیلات کبھی نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh và tệp của bạn chỉ được kiểm tra và sắp xếp trên thiết bị. Khi mua, chỉ những gì cần thiết được gửi cho Apple, và cho quảng cáo ở bản miễn phí là Google – không bao giờ là ảnh, tên ảnh hay chi tiết từ chúng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的照片和文件只在设备上检查和整理。购买时只向 Apple 发送必要信息，免费版的广告只向 Google 发送必要信息——绝不会发送你的照片、名称或其中的信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的照片和檔案只在你的裝置上檢查和整理。購買時只會向 Apple 傳送必要資訊，免費版的廣告則會向 Google 傳送 – 但絕不包含你的照片、照片名稱或其中的細節。"
          }
        }
      }
    },
