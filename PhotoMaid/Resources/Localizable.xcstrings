    "set_language_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم GaleriQ لغة iPhone. اضغط لاختيار لغة أخرى لـ GaleriQ فقط من «اللغة» في إعدادات iOS."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ আপনার iPhone-এর ভাষা ব্যবহার করে। শুধু GaleriQ-এর জন্য অন্য ভাষা বেছে নিতে ট্যাপ করুন – iOS সেটিংসে “ভাষা”-র অধীনে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ fa servir l’idioma de l’iPhone. Toca per triar un altre idioma només per a GaleriQ a «Idioma», a la configuració de l’iOS."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ používá jazyk vašeho iPhonu. Klepnutím vyberete jiný jazyk jen pro GaleriQ v části „Jazyk“ v nastavení iOS."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ bruger din iPhones sprog. Tryk for at vælge et andet sprog kun til GaleriQ under “Sprog” i iOS-indstillingerne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ nutzt die Sprache deines iPhones. Tippe hier, um in den iOS-Einstellungen unter „Sprache“ eine andere Sprache nur für GaleriQ zu wählen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το GaleriQ χρησιμοποιεί τη γλώσσα του iPhone σου. Πάτησε για να επιλέξεις άλλη γλώσσα μόνο για το GaleriQ στη «Γλώσσα» των Ρυθμίσεων iOS."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ uses your iPhone’s language. Tap to choose a different language just for GaleriQ under “Language” in iOS Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ usa el idioma de tu iPhone. Toca para elegir otro idioma solo para GaleriQ en «Idioma» de los Ajustes de iOS."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ käyttää iPhonesi kieltä. Napauta valitaksesi toisen kielen vain GaleriQ:lle iOS:n asetusten kohdassa ”Kieli”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ utilise la langue de ton iPhone. Touche ici pour choisir une autre langue rien que pour GaleriQ sous « Langue » dans les réglages iOS."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ તમારા iPhone ની ભાષા વાપરે છે. ફક્ત GaleriQ માટે બીજી ભાષા પસંદ કરવા ટૅપ કરો, iOS સેટિંગ્સમાં “ભાષા” હેઠળ."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ משתמשת בשפת ה-iPhone. הקשה כאן מאפשרת לבחור שפה אחרת רק עבור GaleriQ תחת „שפה” בהגדרות של iOS."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ आपके iPhone की भाषा इस्तेमाल करता है। सिर्फ़ GaleriQ के लिए दूसरी भाषा चुनने के लिए टैप करें, iOS सेटिंग्ज़ में “भाषा” के अंतर्गत।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ koristi jezik tvog iPhonea. Dodirni da odabereš drugi jezik samo za GaleriQ pod „Jezik” u postavkama iOS-a."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A GaleriQ az iPhone nyelvét használja. Koppints, ha csak a GaleriQ-hoz szeretnél más nyelvet választani az iOS-beállítások „Nyelv” pontjában."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ memakai bahasa iPhone-mu. Ketuk untuk memilih bahasa lain khusus untuk GaleriQ di “Bahasa” pada Pengaturan iOS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ usa la lingua del tuo iPhone. Tocca per scegliere un’altra lingua solo per GaleriQ in «Lingua» nelle Impostazioni di iOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQはiPhoneの言語を使います。タップすると、iOSの設定の「言語」でGaleriQだけ別の言語を選べます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ನಿಮ್ಮ iPhone ನ ಭಾಷೆಯನ್ನು ಬಳಸುತ್ತದೆ. GaleriQ ಗೆ ಮಾತ್ರ ಬೇರೆ ಭಾಷೆ ಆಯ್ಕೆಮಾಡಲು ಟ್ಯಾಪ್ ಮಾಡಿ – iOS ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ “ಭಾಷೆ” ಅಡಿಯಲ್ಲಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ는 iPhone의 언어를 사용해요. 탭하면 iOS 설정의 ‘언어’에서 GaleriQ에만 다른 언어를 선택할 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ നിങ്ങളുടെ iPhone-ന്റെ ഭാഷ ഉപയോഗിക്കുന്നു. GaleriQ-ന് മാത്രം മറ്റൊരു ഭാഷ തിരഞ്ഞെടുക്കാൻ ടാപ്പ് ചെയ്യുക – iOS ക്രമീകരണങ്ങളിൽ “ഭാഷ” എന്നതിന് കീഴിൽ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ तुमच्या iPhone ची भाषा वापरते. फक्त GaleriQ साठी दुसरी भाषा निवडण्यासाठी टॅप करा, iOS सेटिंग्जमधील “भाषा” अंतर्गत."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ menggunakan bahasa iPhone anda. Ketik untuk memilih bahasa lain hanya untuk GaleriQ di bawah “Bahasa” dalam Seting iOS."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ bruker språket på iPhonen din. Trykk for å velge et annet språk bare for GaleriQ under «Språk» i iOS-innstillingene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ gebruikt de taal van je iPhone. Tik om bij ‘Taal’ in iOS-instellingen een andere taal alleen voor GaleriQ te kiezen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ଆପଣଙ୍କ iPhoneର ଭାଷା ବ୍ୟବହାର କରେ। କେବଳ GaleriQ ପାଇଁ ଅନ୍ୟ ଭାଷା ବାଛିବାକୁ ଟାପ୍ କରନ୍ତୁ – iOS ସେଟିଂସରେ “ଭାଷା” ଅଧୀନରେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ਤੁਹਾਡੇ iPhone ਦੀ ਭਾਸ਼ਾ ਵਰਤਦਾ ਹੈ। ਸਿਰਫ਼ GaleriQ ਲਈ ਵੱਖਰੀ ਭਾਸ਼ਾ ਚੁਣਨ ਲਈ ਟੈਪ ਕਰੋ – iOS ਸੈਟਿੰਗਾਂ ਵਿੱਚ “ਭਾਸ਼ਾ” ਹੇਠ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ używa języka iPhone’a. Stuknij, aby w ustawieniach iOS w sekcji „Język” wybrać inny język tylko dla GaleriQ."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O GaleriQ usa o idioma do seu iPhone. Toque para escolher outro idioma só para o GaleriQ em “Idioma” nos Ajustes do iOS."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O GaleriQ usa o idioma do teu iPhone. Toca para escolher outro idioma só para o GaleriQ em “Idioma” nas Definições do iOS."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ folosește limba iPhone-ului. Atinge pentru a alege altă limbă doar pentru GaleriQ la „Limbă” în configurările iOS."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ использует язык iPhone. Нажми, чтобы выбрать другой язык только для GaleriQ в разделе «Язык» в настройках iOS."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ používa jazyk vášho iPhonu. Klepnutím vyberiete iný jazyk len pre GaleriQ v časti „Jazyk“ v nastaveniach iOS."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ uporablja jezik tvojega iPhona. Tapni, da izbereš drug jezik samo za GaleriQ pod »Jezik« v nastavitvah iOS."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ använder din iPhones språk. Tryck för att välja ett annat språk bara för GaleriQ under ”Språk” i iOS-inställningarna."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ உங்கள் iPhone-இன் மொழியைப் பயன்படுத்துகிறது. GaleriQ-க்கு மட்டும் வேறு மொழியைத் தேர்ந்தெடுக்கத் தட்டுங்கள் – iOS அமைப்புகளில் “மொழி” என்பதன் கீழ்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ మీ iPhone భాషను వాడుతుంది. GaleriQకి మాత్రమే వేరే భాష ఎంచుకోవడానికి ట్యాప్ చేయండి – iOS సెట్టింగ్‌లలో “భాష” కింద."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ใช้ภาษาของ iPhone แตะเพื่อเลือกภาษาอื่นสำหรับ GaleriQ เท่านั้นได้ที่ “ภาษา” ในการตั้งค่า iOS"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ iPhone’unun dilini kullanır. Yalnızca GaleriQ için başka bir dil seçmek üzere iOS Ayarları’nda “Dil”e gitmek için dokun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ використовує мову iPhone. Торкнись, щоб у параметрах iOS у розділі «Мова» вибрати іншу мову лише для GaleriQ."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ آپ کے iPhone کی زبان استعمال کرتا ہے۔ صرف GaleriQ کے لیے دوسری زبان منتخب کرنے کے لیے ٹیپ کریں، iOS ترتیبات میں ”زبان“ کے تحت۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ dùng ngôn ngữ của iPhone. Chạm để chọn ngôn ngữ khác chỉ cho GaleriQ trong “Ngôn ngữ” ở Cài đặt iOS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ 使用 iPhone 的语言。轻点后可在 iOS 设置的“语言”中只为 GaleriQ 选择其他语言。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ 使用 iPhone 的語言。點一下即可在 iOS「設定」的「語言」中，只為 GaleriQ 選擇其他語言。"
          }
        }
      }
    },
