          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "30 minutes au maximum au total. Raccourcissez ou retirez des clips."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Maksimal total 30 menit. Persingkat atau hapus beberapa klip."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al massimo 30 minuti in tutto. Accorcia o togli delle clip."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "合計30分までです。クリップを短くするか減らしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 최대 30분입니다. 클립을 줄이거나 빼세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Maks 30 minutter totalt. Kort ned klipp eller fjern noen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximaal 30 minuten in totaal. Kort clips in of haal er een paar weg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Łącznie maksymalnie 30 minut. Skróć lub usuń klipy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No máximo 30 minutos no total. Encurte ou remova alguns clipes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "No máximo 30 minutos no total. Encurte ou retire clipes."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cel mult 30 de minute în total. Scurtează sau elimină clipuri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всего не более 30 минут. Сократите или уберите клипы."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Högst 30 minuter totalt. Korta klippen eller ta bort några."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รวมได้สูงสุด 30 นาที ตัดให้สั้นลงหรือนำบางคลิปออก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toplam en fazla 30 dakika. Klipleri kısalt veya çıkar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Загалом не більше 30 хвилин. Скоротіть або приберіть кліпи."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tổng cộng tối đa 30 phút. Hãy rút ngắn hoặc xóa bớt đoạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "总时长最多 30 分钟。请缩短或移除部分片段。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "總長最多 30 分鐘。請縮短或移除部分片段。"
          }
        }
      }
    },
