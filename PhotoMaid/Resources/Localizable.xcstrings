    "snake_intro": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اجمع الصور وأطل شريطك. اسحب أو استخدم أزرار الاتجاه."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Collect pictures and grow your photo strip. Swipe or use the direction buttons."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sammle Bilder und verlängere deinen Fotostreifen. Wische oder nutze die Richtungstasten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Collect pictures and grow your photo strip. Swipe or use the direction buttons."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recoge imágenes y alarga tu tira de fotos. Desliza o usa los botones de dirección."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collectez des images pour allonger votre bande photo. Balayez ou utilisez les boutons de direction."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Collect pictures and grow your photo strip. Swipe or use the direction buttons."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Raccogli immagini e allunga la tua striscia di foto. Scorri o usa i pulsanti direzionali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真を集めてフォトストリップを伸ばしましょう。スワイプか方向ボタンで操作します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진을 모아 사진 띠를 늘려보세요. 스와이프하거나 방향 버튼을 사용하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Collect pictures and grow your photo strip. Swipe or use the direction buttons."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verzamel afbeeldingen en verleng je fotostrip. Veeg of gebruik de richtingsknoppen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbieraj obrazki i wydłużaj pasek zdjęć. Przesuwaj palcem lub używaj przycisków kierunku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Collect pictures and grow your photo strip. Swipe or use the direction buttons."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Recolha imagens e alongue a sua tira de fotos. Deslize ou use os botões de direção."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adună imagini și prelungește banda foto. Glisează sau folosește butoanele de direcție."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Собирайте картинки и удлиняйте фотоленту. Управляйте свайпами или кнопками направлений."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Collect pictures and grow your photo strip. Swipe or use the direction buttons."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Collect pictures and grow your photo strip. Swipe or use the direction buttons."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Resimleri topla ve fotoğraf şeridini uzat. Kaydır veya yön düğmelerini kullan."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збирай зображення та подовжуй фотострічку. Керуй свайпами або кнопками напрямку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
