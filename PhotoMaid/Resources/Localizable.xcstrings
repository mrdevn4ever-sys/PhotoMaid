    "vid_hdr_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لهذا الفيديو ألوان شديدة السطوع (HDR). مع تغييرات الألوان يُحفظ بألوان عادية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Video hat besonders leuchtende Farben (HDR). Mit deinen Farbänderungen wird es mit normalen Farben gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This video has extra-bright colours (HDR). With your colour changes it’s saved with normal colours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este vídeo tiene colores muy intensos (HDR). Con tus cambios de color se guarda con colores normales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette vidéo a des couleurs très lumineuses (HDR). Avec vos changements de couleur, elle est enregistrée en couleurs normales."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo video ha colori molto brillanti (HDR). Con le modifiche al colore viene salvato con colori normali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この動画は特に明るい色（HDR）です。色を変更したため、通常の色で保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 동영상은 아주 밝은 색(HDR)이에요. 색을 바꿨기 때문에 일반 색으로 저장돼요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze video heeft extra stralende kleuren (HDR). Met je kleurwijzigingen wordt hij met normale kleuren opgeslagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten film ma szczególnie jasne kolory (HDR). Po zmianie kolorów zostanie zapisany w zwykłych kolorach."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este vídeo tem cores muito intensas (HDR). Com as suas alterações de cor, é guardado com cores normais."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest videoclip are culori foarte strălucitoare (HDR). Cu modificările de culoare, se salvează cu culori obișnuite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У этого видео особенно яркие цвета (HDR). С вашими изменениями цвета оно сохранится в обычных цветах."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu videonun renkleri çok parlak (HDR). Renk değişikliklerinle normal renklerle kaydedilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У цього відео особливо яскраві кольори (HDR). Зі змінами кольору воно збережеться у звичайних кольорах."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个视频的色彩特别明亮（HDR）。由于你调整了颜色，将以普通色彩保存。"
          }
        }
      }
    },
    "vid_hdr_hint_ios": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتوي هذا الفيديو على ألوان ساطعة بشكل خاص (HDR). عند إعادة حسابه يُحفظ بألوان عادية. إذا قصصته فقط، يبقى HDR."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Video hat besonders leuchtende Farben (HDR). Beim Neuberechnen wird es mit normalen Farben gespeichert. Nur gekürzt bleibt HDR erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This video has especially bright colours (HDR). When it’s recalculated, it’s saved with normal colours. If you only trim it, HDR is kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este vídeo tiene colores especialmente intensos (HDR). Al recalcularlo se guarda con colores normales. Si solo lo recortas, se mantiene el HDR."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette vidéo a des couleurs particulièrement lumineuses (HDR). Recalculée, elle est enregistrée avec des couleurs normales. Si vous la raccourcissez seulement, le HDR est conservé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo video ha colori particolarmente luminosi (HDR). Quando viene ricalcolato, si salva con colori normali. Se lo accorci soltanto, l’HDR resta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このビデオは特に明るい色（HDR）です。再計算すると通常の色で保存されます。トリミングだけならHDRのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 비디오는 특히 밝은 색상(HDR)입니다. 다시 계산하면 일반 색상으로 저장됩니다. 다듬기만 하면 HDR이 유지됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze video heeft extra heldere kleuren (HDR). Bij opnieuw berekenen wordt hij met normale kleuren bewaard. Alleen inkorten houdt HDR."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten film ma wyjątkowo jaskrawe kolory (HDR). Po ponownym przeliczeniu zostanie zapisany w zwykłych kolorach. Samo przycięcie zachowuje HDR."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este vídeo tem cores especialmente vivas (HDR). Ao ser recalculado, é guardado com cores normais. Se apenas o cortar, o HDR mantém-se."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest videoclip are culori deosebit de luminoase (HDR). La recalculare se salvează cu culori normale. Dacă doar îl scurtezi, HDR rămâne."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У этого видео особенно яркие цвета (HDR). При пересчёте оно сохранится с обычными цветами. Если только обрезать, HDR сохранится."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu videonun renkleri özellikle parlak (HDR). Yeniden hesaplanınca normal renklerle kaydedilir. Yalnızca kırparsan HDR korunur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це відео має особливо яскраві кольори (HDR). Після перерахунку воно збережеться зі звичайними кольорами. Якщо лише обрізати, HDR залишиться."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此视频的色彩特别明亮（HDR）。重新计算后将以普通色彩存储。只修剪则保留 HDR。"
          }
        }
      }
    },
