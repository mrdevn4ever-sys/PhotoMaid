    "privacy_ads": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعرض النسخة المجانية إعلانات من Google. يمكنك تغيير موافقتك في الإعدادات. لا تصل صورك أو أسماؤها أو مجلداتها أو أي بيانات مستخلصة منها إلى المعلنين أبدًا. لا إعلانات مع Pro."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratisversionen viser reklamer fra Google. Du kan ændre dit samtykke i indstillingerne. Dine fotos, deres navne, mapper eller noget afledt af dem går aldrig til reklameudbydere. Pro har ingen reklamer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der kostenlosen Version gibt es Werbung von Google. Deine Einwilligung dazu kannst du in den Einstellungen ändern. Deine Fotos, ihre Namen, Ordner oder Angaben daraus gehen nie an Werbeanbieter. Mit Pro gibt es keine Werbung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The free version shows ads from Google. You can change your consent in settings. Your photos, their names, folders or anything derived from them never go to ad providers. Pro has no ads."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La versión gratuita muestra anuncios de Google. Puedes cambiar tu consentimiento en Ajustes. Tus fotos, sus nombres, carpetas o lo que se obtenga de ellas nunca llegan a los anunciantes. Con Pro no hay anuncios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La version gratuite affiche des publicités Google. Vous pouvez modifier votre consentement dans les paramètres. Vos photos, leurs noms, dossiers ou toute information qui en est tirée ne vont jamais aux régies publicitaires. Avec Pro, pas de publicité."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Versi gratis menampilkan iklan dari Google. Kamu bisa mengubah persetujuanmu di pengaturan. Fotomu, namanya, folder, atau apa pun yang berasal darinya tidak pernah dikirim ke penyedia iklan. Pro tanpa iklan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La versione gratuita mostra pubblicità di Google. Puoi cambiare il consenso nelle impostazioni. Le tue foto, i loro nomi, le cartelle o dati ricavati da esse non arrivano mai agli inserzionisti. Con Pro niente pubblicità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料版では Google の広告が表示されます。同意は設定で変更できます。写真、その名前やフォルダ、写真から得た情報が広告会社に渡ることはありません。Pro では広告は表示されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 버전에는 Google 광고가 나와요. 동의는 설정에서 바꿀 수 있어요. 사진, 사진 이름, 폴더나 사진에서 얻은 정보는 광고 업체에 절대 가지 않아요. Pro에는 광고가 없어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratisversjonen viser annonser fra Google. Du kan endre samtykket ditt i innstillingene. Bildene dine, navnene på dem, mapper eller noe som er avledet fra dem, går aldri til annonseleverandører. Pro har ingen annonser."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De gratis versie toont advertenties van Google. Je toestemming kun je in de instellingen wijzigen. Je foto’s, hun namen, mappen of iets wat eruit is afgeleid, gaan nooit naar adverteerders. Met Pro zijn er geen advertenties."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wersja bezpłatna wyświetla reklamy Google. Zgodę możesz zmienić w ustawieniach. Twoje zdjęcia, ich nazwy, foldery ani nic z nich wyliczonego nigdy nie trafiają do reklamodawców. W Pro nie ma reklam."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A versão grátis mostra anúncios do Google. Você pode alterar seu consentimento nos ajustes. Suas fotos, os nomes delas, pastas ou qualquer coisa derivada delas nunca vão para provedores de anúncios. O Pro não tem anúncios."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A versão gratuita mostra anúncios do Google. Pode alterar o consentimento nas definições. As suas fotos, os nomes, pastas ou dados obtidos a partir delas nunca vão para anunciantes. Com Pro não há anúncios."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Versiunea gratuită afișează reclame Google. Îți poți schimba acordul în setări. Fotografiile tale, numele lor, dosarele sau ceva derivat din ele nu ajung niciodată la furnizorii de reclame. Cu Pro nu ai reclame."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В бесплатной версии показывается реклама Google. Согласие можно изменить в настройках. Ваши фото, их названия, папки и любые данные из них никогда не попадают к рекламодателям. В Pro рекламы нет."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratisversionen visar annonser från Google. Du kan ändra ditt samtycke i inställningarna. Dina bilder, deras namn, mappar eller något som härleds från dem går aldrig till annonsleverantörer. Pro har inga annonser."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวอร์ชันฟรีแสดงโฆษณาจาก Google คุณเปลี่ยนความยินยอมได้ในการตั้งค่า รูปภาพ ชื่อรูป โฟลเดอร์ หรือสิ่งใดที่ได้มาจากสิ่งเหล่านี้จะไม่ถูกส่งไปยังผู้ให้บริการโฆษณา Pro ไม่มีโฆษณา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ücretsiz sürümde Google reklamları gösterilir. Onayını ayarlardan değiştirebilirsin. Fotoğrafların, adları, klasörleri veya onlardan elde edilen hiçbir bilgi reklamcılara gitmez. Pro’da reklam yoktur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У безкоштовній версії показується реклама Google. Згоду можна змінити в налаштуваннях. Ваші фото, їхні назви, папки чи будь-які дані з них ніколи не потрапляють до рекламодавців. У Pro реклами немає."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên bản miễn phí hiển thị quảng cáo từ Google. Bạn có thể thay đổi sự đồng ý trong cài đặt. Ảnh của bạn, tên ảnh, thư mục hay bất cứ thứ gì suy ra từ chúng không bao giờ được gửi cho bên quảng cáo. Pro không có quảng cáo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免费版会显示 Google 广告。你可以在设置中更改同意。你的照片、照片名称、文件夹或由其得出的任何信息都不会发给广告商。Pro 版没有广告。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "免費版會顯示 Google 的廣告。你可以在設定中更改同意選項。你的照片、照片名稱、檔案夾或從中衍生的任何內容都不會提供給廣告商。Pro 沒有廣告。"
          }
        }
      }
    },
