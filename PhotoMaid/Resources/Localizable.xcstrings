    "edit_mk_redact_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مع «تنقيط» و«تمويه» قد تظهر الحدود. للنص الذي يجب ألا يُقرأ أبدًا اختر «معتم»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei „Verpixeln“ und „Unschärfe“ kann man Umrisse noch erahnen. Für Text, der sicher unlesbar sein soll, nimm lieber „Deckend“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With “Pixelate” and “Blur” outlines may still show. For text that must stay unreadable, choose “Solid”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con «Pixelar» y «Desenfocar» aún se intuyen las formas. Para texto que no deba leerse, elige «Opaco»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec « Pixelliser » et « Flou », on devine encore les contours. Pour un texte qui doit rester illisible, choisissez « Opaque »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con «Pixel» e «Sfocatura» si intuiscono ancora i contorni. Per un testo che deve restare illeggibile, scegli «Coprente»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「モザイク」や「ぼかし」では輪郭がわかることがあります。読めないようにしたい文字には「塗りつぶし」を使ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘모자이크’와 ‘흐림’은 윤곽이 보일 수 있어요. 꼭 읽히면 안 되는 글자에는 ‘불투명’을 쓰세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij ‘Pixeleren’ en ‘Vervagen’ zie je contouren soms nog. Voor tekst die echt onleesbaar moet zijn, kies je ‘Dekkend’."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przy „Pikselizuj” i „Rozmycie” kontury mogą być nadal widoczne. Dla tekstu, który ma być nieczytelny, wybierz „Kryjące”."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Com «Pixelizar» e «Desfocar» ainda se adivinham os contornos. Para texto que não deve ser lido, escolha «Opaco»."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "La „Pixelare” și „Estompare” se mai pot ghici contururile. Pentru text care trebuie să rămână ilizibil, alege „Opac”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При «Пикселизации» и «Размытии» контуры ещё можно угадать. Для текста, который нельзя прочитать, выберите «Сплошная заливка»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Pikselleştir” ve “Bulanıklaştır” ile hatlar hâlâ seçilebilir. Okunmaması gereken yazılar için “Opak”ı seç."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "При «Пікселізації» та «Розмитті» контури ще можна вгадати. Для тексту, який не мають прочитати, оберіть «Суцільна заливка»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用“像素化”和“模糊”时仍可能看出轮廓。对于必须无法辨认的文字，请选择“不透明”。"
          }
        }
      }
    },
    "edit_mk_redact_solid_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "موصى به للتفاصيل الخاصة: ما تغطيه يختفي فعلًا من الملف المحفوظ أو المشارَك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Empfohlen für Persönliches: Was du abdeckst, ist in der gespeicherten oder geteilten Datei wirklich weg."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recommended for private details: whatever you cover is really gone in the saved or shared file."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recomendado para datos personales: lo que tapes desaparece de verdad en el archivo guardado o compartido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recommandé pour les infos personnelles : ce que vous masquez disparaît vraiment du fichier enregistré ou partagé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consigliato per i dati personali: ciò che copri sparisce davvero dal file salvato o condiviso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "個人的な情報に最適：隠した部分は、保存・共有したファイルから本当に消えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개인 정보에 추천해요: 가린 부분은 저장하거나 공유한 파일에서 정말로 사라져요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aanbevolen voor persoonlijke details: wat je afdekt, is in het opgeslagen of gedeelde bestand echt weg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zalecane dla danych osobistych: to, co zakryjesz, naprawdę znika z zapisanego lub udostępnionego pliku."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Recomendado para dados pessoais: o que tapar desaparece mesmo do ficheiro guardado ou partilhado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Recomandat pentru date personale: ce acoperi dispare cu adevărat din fișierul salvat sau partajat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рекомендуется для личного: то, что вы закрыли, действительно исчезает из сохранённого или отправленного файла."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kişisel bilgiler için önerilir: Kapattığın şey kaydedilen veya paylaşılan dosyadan gerçekten silinir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рекомендовано для особистого: те, що ви закрили, справді зникає зі збереженого чи надісланого файлу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "推荐用于个人信息：你遮盖的内容在保存或分享的文件中会真正消失。"
          }
        }
      }
    },
