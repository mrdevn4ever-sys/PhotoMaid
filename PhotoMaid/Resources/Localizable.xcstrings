            "value": "Vyplní nový formát; okraje mimo se oříznou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Udfylder det nye format; kanter udenfor skæres af."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füllt das neue Format; Ränder außerhalb werden abgeschnitten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Γεμίζει τη νέα μορφή· οι άκρες έξω κόβονται."
