    "tour_series_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عدة صور التُقطت بسرعة متتالية؟ قارنها جنبًا إلى جنب واختر ما يبقى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দ্রুত পরপর কয়েকটি ফটো তুলেছেন? সেগুলো পাশাপাশি তুলনা করে বেছে নিন কী থাকবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Diverses fotos fetes una rere l’altra? Compara-les una al costat de l’altra i tria què es queda."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Několik fotek pořízených rychle po sobě? Porovnejte je vedle sebe a vyberte, co zůstane."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flere fotos taget hurtigt efter hinanden? Sammenlign dem side om side, og vælg, hvad der bliver."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mehrere Fotos kurz hintereinander? Vergleiche sie nebeneinander und wähle selbst, was bleibt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πολλές φωτογραφίες σε γρήγορη διαδοχή; Σύγκρινέ τες δίπλα-δίπλα και διάλεξε τι μένει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Several photos taken in quick succession? Compare them side by side and choose what stays."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Varias fotos seguidas? Compáralas una junto a otra y elige cuáles se quedan."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Useita kuvia nopeasti peräkkäin? Vertaa niitä rinnakkain ja valitse, mitä jää."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plusieurs photos prises coup sur coup ? Compare-les côte à côte et choisis ce qui reste."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઝડપથી એક પછી એક લીધેલા ઘણા ફોટા? બાજુ-બાજુમાં સરખાવો અને શું રહેશે તે પસંદ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כמה תמונות שצולמו ברצף מהיר? אפשר להשוות אותן זו לצד זו ולבחור מה נשאר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जल्दी-जल्दी ली गई कई फ़ोटो? साथ-साथ तुलना करें और चुनें कि क्या रहेगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Više fotografija snimljenih u brzom slijedu? Usporedi ih jednu uz drugu i odaberi što ostaje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Több fotó gyors egymásutánban? Hasonlítsd össze őket egymás mellett, és válaszd ki, mi marad."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beberapa foto diambil berturut-turut cepat? Bandingkan berdampingan dan pilih mana yang tetap."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Più foto scattate di seguito? Confrontale affiancate e scegli cosa resta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "連続して撮った写真がありますか？並べて比較し、残すものを選べます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ವೇಗವಾಗಿ ಒಂದರ ನಂತರ ಒಂದು ಹಲವು ಫೋಟೋಗಳನ್ನು ತೆಗೆದಿದ್ದೀರಾ? ಅವುಗಳನ್ನು ಅಕ್ಕಪಕ್ಕದಲ್ಲಿ ಹೋಲಿಸಿ ಏನು ಉಳಿಯಬೇಕು ಎಂದು ಆಯ್ಕೆಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연속으로 찍은 사진이 있나요? 나란히 비교하고 남길 사진을 골라요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വേഗത്തിൽ തുടർച്ചയായി നിരവധി ഫോട്ടോകൾ എടുത്തോ? അവ അടുത്തടുത്ത് താരതമ്യം ചെയ്ത് എന്ത് നിലനിർത്തണമെന്ന് തിരഞ്ഞെടുക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पटापट काढलेले अनेक फोटो? शेजारी शेजारी तुलना करा आणि काय राहील ते निवडा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Beberapa foto diambil berturut-turut dengan pantas? Bandingkan secara bersebelahan dan pilih apa yang kekal."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flere bilder tatt raskt etter hverandre? Sammenlign dem side om side og velg hva som blir."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meerdere foto’s kort na elkaar? Vergelijk ze naast elkaar en kies wat blijft."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଶୀଘ୍ର ପରପର ଅନେକ ଫଟୋ ଉଠାଇଛନ୍ତି? ସେଗୁଡ଼ିକୁ ପାଖାପାଖି ତୁଳନା କରି ବାଛନ୍ତୁ କ’ଣ ରହିବ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਲਦੀ-ਜਲਦੀ ਕਈ ਫ਼ੋਟੋਆਂ ਖਿੱਚੀਆਂ? ਉਨ੍ਹਾਂ ਦੀ ਨਾਲ-ਨਾਲ ਤੁਲਨਾ ਕਰੋ ਅਤੇ ਚੁਣੋ ਕਿ ਕੀ ਰਹੇਗਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilka zdjęć zrobionych jedno po drugim? Porównaj je obok siebie i wybierz, co zostaje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Várias fotos tiradas em sequência rápida? Compare-as lado a lado e escolha o que fica."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Várias fotos tiradas seguidas? Compara-as lado a lado e escolhe o que fica."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mai multe fotografii făcute una după alta? Compară-le alăturat și alege ce rămâne."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Несколько фото подряд? Сравни их рядом и выбери, что оставить."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Niekoľko fotiek nasnímaných rýchlo po sebe? Porovnajte ich vedľa seba a vyberte, čo zostane."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Več fotografij, posnetih v hitrem zaporedju? Primerjaj jih drugo ob drugi in izberi, kaj ostane."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flera bilder tagna i snabb följd? Jämför dem sida vid sida och välj vad som blir kvar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "விரைவாக அடுத்தடுத்து பல புகைப்படங்கள் எடுத்தீர்களா? அவற்றை அருகருகே ஒப்பிட்டு எது இருக்கும் எனத் தேர்ந்தெடுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వేగంగా వరుసగా చాలా ఫోటోలు తీశారా? వాటిని పక్కపక్కనే పోల్చి ఏది ఉండాలో ఎంచుకోండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ่ายหลายรูปติดๆ กัน? เปรียบเทียบเคียงข้างกันแล้วเลือกว่าจะเก็บอะไร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Art arda çekilmiş birkaç fotoğraf mı var? Yan yana karşılaştır ve neyin kalacağını seç."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кілька фото поспіль? Порівняй їх поруч і вибери, що залишити."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جلدی جلدی لی گئی کئی تصاویر؟ ساتھ ساتھ موازنہ کریں اور منتخب کریں کہ کیا رہے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chụp nhiều ảnh liên tiếp nhanh? So sánh chúng cạnh nhau và chọn ảnh giữ lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有几张连续拍摄的照片？并排比较，自己选择保留哪些。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "快速連拍了好幾張照片？並排比較，選出要保留的。"
          }
        }
      }
    },
