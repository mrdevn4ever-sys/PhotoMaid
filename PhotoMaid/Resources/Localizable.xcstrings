    "series_footer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يُحذف أي شيء. السلة تابعة لـ GaleriQ ولا تُفرغ إلا بعد تأكيدك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কিছুই মুছে ফেলা হয় না। ট্র্যাশটি GaleriQ-এর এবং আপনি নিশ্চিত করলেই কেবল খালি হয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s’esborra res. La paperera és de GaleriQ i només es buida quan ho confirmes."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic se nemaže. Koš patří GaleriQ a vyprázdní se jen po vašem potvrzení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet slettes. Papirkurven tilhører GaleriQ og tømmes kun, når du bekræfter det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts wird gelöscht. Der Papierkorb gehört zu GaleriQ und wird erst geleert, wenn du es bestätigst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τίποτα δεν διαγράφεται. Ο κάδος ανήκει στο GaleriQ και αδειάζει μόνο με την επιβεβαίωσή σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is deleted. The trash belongs to GaleriQ and is only emptied when you confirm it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se elimina nada. La papelera es de GaleriQ y solo se vacía cuando lo confirmas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitään ei poisteta. Roskakori kuuluu GaleriQ:lle ja tyhjennetään vain, kun vahvistat sen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’est supprimé. La corbeille appartient à GaleriQ et n’est vidée que lorsque tu le confirmes."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કંઈ ડિલીટ થતું નથી. ટ્રેશ GaleriQ નું છે અને ફક્ત તમારી પુષ્ટિથી ખાલી થાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שום דבר לא נמחק. הפח שייך ל-GaleriQ ומתרוקן רק באישור שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ भी डिलीट नहीं होता। ट्रैश GaleriQ का है और आपकी पुष्टि पर ही खाली होता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ništa se ne briše. Smeće pripada GaleriQ-u i prazni se samo kad to potvrdiš."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Semmi sem törlődik. A kuka a GaleriQ-é, és csak a megerősítésedre ürül."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada yang dihapus. Sampah ini milik GaleriQ dan hanya dikosongkan saat kamu konfirmasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nulla viene eliminato. Il cestino è di GaleriQ e si svuota solo quando lo confermi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何も削除されません。ゴミ箱はGaleriQ内のもので、確認したときだけ空になります。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಏನನ್ನೂ ಅಳಿಸಲಾಗುವುದಿಲ್ಲ. ಕಸದ ಬುಟ್ಟಿ GaleriQ ಗೆ ಸೇರಿದ್ದು, ನೀವು ದೃಢೀಕರಿಸಿದಾಗ ಮಾತ್ರ ಖಾಲಿಯಾಗುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아무것도 삭제되지 않아요. 휴지통은 GaleriQ 안에 있고 확인할 때만 비워져요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒന്നും ഇല്ലാതാക്കില്ല. ട്രാഷ് GaleriQ-ന്റേതാണ്, നിങ്ങൾ സ്ഥിരീകരിക്കുമ്പോൾ മാത്രമേ ശൂന്യമാകൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "काहीही डिलीट होत नाही. ट्रॅश GaleriQ चा आहे आणि तुमच्या पुष्टीनेच रिकामा होतो."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada apa dipadam. Sampah ini milik GaleriQ dan hanya dikosongkan apabila anda mengesahkannya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting slettes. Papirkurven tilhører GaleriQ og tømmes bare når du bekrefter det."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wordt niets verwijderd. De prullenbak is van GaleriQ en wordt pas geleegd als je dat bevestigt."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "କିଛି ଡିଲିଟ୍ ହୁଏ ନାହିଁ। ଟ୍ରାସ GaleriQର ଏବଂ ଆପଣ ନିଶ୍ଚିତ କଲେ ହିଁ ଖାଲି ହୁଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੁਝ ਵੀ ਨਹੀਂ ਮਿਟਦਾ। ਰੱਦੀ GaleriQ ਦੀ ਹੈ ਅਤੇ ਸਿਰਫ਼ ਤੁਹਾਡੀ ਪੁਸ਼ਟੀ ’ਤੇ ਹੀ ਖਾਲੀ ਹੁੰਦੀ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie zostanie usunięte. Kosz należy do GaleriQ i opróżnia się dopiero po potwierdzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada é apagado. A lixeira é do GaleriQ e só é esvaziada quando você confirma."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada é eliminado. O lixo pertence ao GaleriQ e só é esvaziado quando confirmas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimic nu se șterge. Coșul aparține GaleriQ și se golește doar când confirmi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего не удаляется. Корзина находится в GaleriQ и очищается только после твоего подтверждения."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nič sa nemaže. Kôš patrí GaleriQ a vyprázdni sa len po vašom potvrdení."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nič se ne izbriše. Koš pripada GaleriQ in se izprazni le, ko to potrdiš."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget raderas. Papperskorgen tillhör GaleriQ och töms bara när du bekräftar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எதுவும் நீக்கப்படாது. குப்பை GaleriQ-க்குச் சொந்தமானது, நீங்கள் உறுதிப்படுத்தும்போது மட்டுமே காலியாகும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఏదీ తొలగించబడదు. ట్రాష్ GaleriQకి చెందినది, మీరు నిర్ధారించినప్పుడు మాత్రమే ఖాళీ అవుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีอะไรถูกลบ ถังขยะเป็นของ GaleriQ และจะล้างเมื่อคุณยืนยันเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir şey silinmez. Çöp kutusu GaleriQ’e aittir ve yalnızca onayladığında boşalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нічого не видаляється. Кошик належить GaleriQ і очищується лише після твого підтвердження."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کچھ حذف نہیں ہوتا۔ ردی GaleriQ کی ہے اور صرف آپ کی تصدیق پر خالی ہوتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có gì bị xóa. Thùng rác thuộc về GaleriQ và chỉ được dọn khi bạn xác nhận."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不会删除任何内容。回收站属于 GaleriQ，只有在你确认后才会清空。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不會刪除任何內容。垃圾桶屬於 GaleriQ，只有在你確認後才會清空。"
          }
        }
      }
    },
    "series_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر على صورة لمقارنتها بالأسفل. علامة الاختيار تحدد ما يبقى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নিচে তুলনা করতে কোনো ফটোতে ট্যাপ করুন। টিক চিহ্ন ঠিক করে কী থাকবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca una foto per comparar-la a sota. La marca decideix què es queda."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na fotku ji porovnáte dole. Zaškrtnutí rozhoduje, co zůstane."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på et foto for at sammenligne det nedenfor. Fluebenet bestemmer, hvad der bliver."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf ein Bild, um es unten zu vergleichen. Der Haken entscheidet, was bleibt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάτησε μια φωτογραφία για να τη συγκρίνεις παρακάτω. Το τσεκ αποφασίζει τι μένει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a photo to compare it below. The check mark decides what stays."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca una foto para compararla abajo. La marca decide qué se queda."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta kuvaa verrataksesi sitä alla. Valintamerkki ratkaisee, mitä jää."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche une photo pour la comparer en bas. La coche décide de ce qui reste."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "નીચે સરખામણી માટે ફોટા પર ટૅપ કરો. ખરાની નિશાની નક્કી કરે છે કે શું રહેશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקשה על תמונה משווה אותה למטה. סימן הווי קובע מה נשאר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नीचे तुलना के लिए किसी फ़ोटो पर टैप करें। सही का निशान तय करता है कि क्या रहेगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirni fotografiju da je usporediš dolje. Kvačica određuje što ostaje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints egy fotóra, hogy lent összehasonlítsd. A pipa dönti el, mi marad."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk foto untuk membandingkannya di bawah. Tanda centang menentukan apa yang tetap."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca una foto per confrontarla sotto. La spunta decide cosa resta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真をタップすると下で比較できます。チェックで残すものを決めます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕೆಳಗೆ ಹೋಲಿಸಲು ಫೋಟೋವನ್ನು ಟ್ಯಾಪ್ ಮಾಡಿ. ಟಿಕ್ ಗುರುತು ಯಾವುದು ಉಳಿಯಬೇಕು ಎಂದು ನಿರ್ಧರಿಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진을 탭하면 아래에서 비교해요. 체크 표시로 남길 사진을 정해요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "താഴെ താരതമ്യം ചെയ്യാൻ ഒരു ഫോട്ടോ ടാപ്പ് ചെയ്യുക. ടിക്ക് അടയാളം എന്ത് നിലനിൽക്കണമെന്ന് തീരുമാനിക്കുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "खाली तुलना करण्यासाठी फोटोवर टॅप करा. बरोबरची खूण काय राहील ते ठरवते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik foto untuk membandingkannya di bawah. Tanda semak menentukan apa yang kekal."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på et bilde for å sammenligne det nedenfor. Haken bestemmer hva som blir."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op een foto om hem onderaan te vergelijken. Het vinkje bepaalt wat blijft."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ତଳେ ତୁଳନା କରିବାକୁ ଏକ ଫଟୋରେ ଟାପ୍ କରନ୍ତୁ। ଟିକ୍ ଚିହ୍ନ ସ୍ଥିର କରେ କ’ଣ ରହିବ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹੇਠਾਂ ਤੁਲਨਾ ਕਰਨ ਲਈ ਕਿਸੇ ਫ਼ੋਟੋ ਉੱਤੇ ਟੈਪ ਕਰੋ। ਸਹੀ ਦਾ ਨਿਸ਼ਾਨ ਤੈਅ ਕਰਦਾ ਹੈ ਕਿ ਕੀ ਰਹੇਗਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotknij zdjęcia, aby porównać je poniżej. Znacznik decyduje, co zostaje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque numa foto para compará-la abaixo. A marca de seleção decide o que fica."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca numa foto para a comparar em baixo. O visto decide o que fica."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge o fotografie ca s-o compari jos. Bifa decide ce rămâne."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажми на фото, чтобы сравнить его ниже. Галочка решает, что останется."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na fotku ju porovnáte dole. Zaškrtnutie rozhoduje, čo zostane."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapni fotografijo, da jo primerjaš spodaj. Kljukica odloči, kaj ostane."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på en bild för att jämföra den nedan. Bocken avgör vad som blir kvar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கீழே ஒப்பிட ஒரு புகைப்படத்தைத் தட்டுங்கள். எது இருக்கும் என்பதைச் சரிக்குறி தீர்மானிக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కింద పోల్చడానికి ఫోటోను ట్యాప్ చేయండి. టిక్ గుర్తు ఏది ఉండాలో నిర్ణయిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะรูปเพื่อเปรียบเทียบด้านล่าง เครื่องหมายถูกเป็นตัวกำหนดว่าจะเก็บอะไร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aşağıda karşılaştırmak için bir fotoğrafa dokun. Onay işareti neyin kalacağını belirler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкнись фото, щоб порівняти його нижче. Позначка вирішує, що залишиться."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نیچے موازنے کے لیے کسی تصویر پر ٹیپ کریں۔ درست کا نشان طے کرتا ہے کہ کیا رہے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm vào một ảnh để so sánh bên dưới. Dấu tích quyết định ảnh nào được giữ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按照片可在下方比较。勾选决定保留哪些。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下照片即可在下方比較。勾號決定保留哪些。"
          }
        }
      }
    },
