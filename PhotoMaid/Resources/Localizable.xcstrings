    "movie_saved": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم الحفظ كفيديو جديد في مكتبتك. تبقى الملفات الأصلية دون تغيير."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার লাইব্রেরিতে নতুন ভিডিও হিসেবে সংরক্ষিত। মূল ফাইল অপরিবর্তিত থাকে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Desat com a vídeo nou a la fototeca. Els originals no canvien."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uloženo jako nové video v knihovně. Originály zůstávají beze změny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemt som ny video i dit bibliotek. Originalerne forbliver uændrede."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als neues Video in der Mediathek gespeichert. Die Originale bleiben unverändert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αποθηκεύτηκε ως νέο βίντεο στη βιβλιοθήκη σου. Τα πρωτότυπα μένουν αμετάβλητα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved as a new video in your library. The originals stay unchanged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardado como vídeo nuevo en tu fototeca. Los originales no cambian."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallennettu uutena videona kirjastoon. Alkuperäiset pysyvät ennallaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrée comme nouvelle vidéo dans votre photothèque. Les originaux restent inchangés."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારી લાઇબ્રેરીમાં નવા વીડિયો તરીકે સાચવ્યો. મૂળ બદલાતાં નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נשמר כסרטון חדש בספרייה. המקוריים לא משתנים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी लाइब्रेरी में नए वीडियो के रूप में सहेजा गया। मूल नहीं बदलते।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spremljeno kao novi videozapis u medijateci. Originali ostaju nepromijenjeni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Új videóként mentve a könyvtáradba. Az eredetik változatlanok maradnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Disimpan sebagai video baru di pustakamu. Aslinya tidak berubah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvato come nuovo video nella libreria. Gli originali restano invariati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいビデオとしてライブラリに保存しました。元のファイルはそのままです。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಲೈಬ್ರರಿಯಲ್ಲಿ ಹೊಸ ವೀಡಿಯೊವಾಗಿ ಉಳಿಸಲಾಗಿದೆ. ಮೂಲಗಳು ಬದಲಾಗದೆ ಉಳಿಯುತ್ತವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관함에 새 비디오로 저장했습니다. 원본은 그대로입니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ലൈബ്രറിയിൽ പുതിയ വീഡിയോയായി സംരക്ഷിച്ചു. ഒറിജിനലുകൾക്ക് മാറ്റമുണ്ടാകില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या लायब्ररीत नवीन व्हिडिओ म्हणून जतन केले. मूळ बदलत नाहीत."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Disimpan sebagai video baharu dalam pustaka anda. Fail asal kekal tidak berubah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagret som ny video i biblioteket ditt. Originalene forblir uendret."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaard als nieuwe video in je bibliotheek. De originelen blijven ongewijzigd."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ ଲାଇବ୍ରେରୀରେ ନୂଆ ଭିଡିଓ ଭାବେ ସେଭ୍ ହେଲା। ମୂଳ ଅପରିବର୍ତ୍ତିତ ରହେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੀ ਲਾਇਬ੍ਰੇਰੀ ਵਿੱਚ ਨਵੀਂ ਵੀਡੀਓ ਵਜੋਂ ਸੰਭਾਲੀ ਗਈ। ਮੂਲ ਬਿਨਾਂ ਬਦਲੇ ਰਹਿੰਦੇ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisano jako nowy film w bibliotece. Oryginały pozostają bez zmian."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvo como novo vídeo na sua biblioteca. Os originais não são alterados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardado como novo vídeo na fototeca. Os originais ficam inalterados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvat ca videoclip nou în bibliotecă. Originalele rămân neschimbate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранено как новое видео в медиатеке. Оригиналы не изменены."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Uložené ako nové video v knižnici. Originály zostávajú bez zmeny."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Shranjeno kot nov video v knjižnici. Izvirniki ostanejo nespremenjeni."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparad som ny video i ditt bibliotek. Originalen förblir oförändrade."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் நூலகத்தில் புதிய வீடியோவாகச் சேமிக்கப்பட்டது. அசல்கள் மாறாமல் இருக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ లైబ్రరీలో కొత్త వీడియోగా సేవ్ అయింది. ఒరిజినల్‌లు మారవు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกเป็นวิดีโอใหม่ในคลังแล้ว ต้นฉบับไม่เปลี่ยนแปลง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arşivine yeni bir video olarak kaydedildi. Orijinaller değişmeden kalır."
          }
        },
        "uk": {
