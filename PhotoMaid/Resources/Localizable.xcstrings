    "error_cloud_folder": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر مجلدًا محفوظًا على هذا الـ iPhone. المجلدات الموجودة في السحابة فقط غير مدعومة هنا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg en mappe, der ligger på denne iPhone. Mapper, der kun findes i skyen, understøttes ikke her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Ordner, der auf diesem iPhone gespeichert ist. Ordner, die nur in der Cloud liegen, werden hier nicht unterstützt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a folder stored on this iPhone. Folders that are only in the cloud aren’t supported here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una carpeta guardada en este iPhone. Aquí no se admiten carpetas que solo estén en la nube."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un dossier stocké sur cet iPhone. Les dossiers uniquement dans le cloud ne sont pas pris en charge ici."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih folder yang tersimpan di iPhone ini. Folder yang hanya ada di cloud tidak didukung di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una cartella salvata su questo iPhone. Le cartelle presenti solo nel cloud non sono supportate qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPhoneに保存されているフォルダを選んでください。クラウドにしかないフォルダはここでは使えません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone에 저장된 폴더를 선택하세요. 클라우드에만 있는 폴더는 여기서 지원되지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg en mappe som ligger på denne iPhonen. Mapper som bare finnes i skyen, støttes ikke her."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een map die op deze iPhone staat. Mappen die alleen in de cloud staan, worden hier niet ondersteund."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz folder zapisany na tym iPhonie. Foldery tylko w chmurze nie są tu obsługiwane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma pasta armazenada neste iPhone. Pastas que estão só na nuvem não são compatíveis aqui."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma pasta guardada neste iPhone. Pastas que estão apenas na nuvem não são suportadas aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege un dosar salvat pe acest iPhone. Dosarele aflate doar în cloud nu sunt acceptate aici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите папку, сохранённую на этом iPhone. Папки только в облаке здесь не поддерживаются."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj en mapp som finns på den här iPhonen. Mappar som bara finns i molnet stöds inte här."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกโฟลเดอร์ที่จัดเก็บบน iPhone เครื่องนี้ โฟลเดอร์ที่อยู่บนคลาวด์เท่านั้นไม่รองรับที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu iPhone’da saklanan bir klasör seç. Yalnızca bulutta olan klasörler burada desteklenmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть папку, збережену на цьому iPhone. Папки лише в хмарі тут не підтримуються."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn thư mục được lưu trên iPhone này. Thư mục chỉ có trên đám mây không được hỗ trợ ở đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择存储在此 iPhone 上的文件夹。此处不支持仅存在于云端的文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請選擇儲存在這部 iPhone 上的檔案夾。這裡不支援只存在雲端的檔案夾。"
          }
        }
      }
