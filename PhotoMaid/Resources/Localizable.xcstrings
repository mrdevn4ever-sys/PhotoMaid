    "months_empty_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر الأشهر هنا عندما يكون للصور أو الفيديوهات تاريخ التقاط."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Måneder vises her, når fotos eller videoer har en optagelsesdato."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobald Fotos oder Videos ein Aufnahmedatum haben, erscheinen hier die Monate."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Months appear here once photos or videos have a capture date."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los meses aparecen aquí cuando las fotos o vídeos tienen fecha de captura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mois apparaissent ici dès que les photos ou vidéos ont une date de prise de vue."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bulan muncul di sini setelah foto atau video punya tanggal pengambilan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I mesi compaiono qui quando foto o video hanno una data di scatto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真や動画に撮影日があると、ここに月が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진이나 동영상에 촬영 날짜가 있으면 여기에 월이 표시돼요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Måneder vises her når bilder eller videoer har en opptaksdato."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maanden verschijnen hier zodra foto’s of video’s een opnamedatum hebben."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Miesiące pojawią się tu, gdy zdjęcia lub filmy będą miały datę wykonania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os meses aparecem aqui quando fotos ou vídeos tiverem data de captura."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os meses aparecem aqui quando as fotos ou vídeos têm data de captura."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lunile apar aici când fotografiile sau videoclipurile au o dată de captură."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Месяцы появятся здесь, когда у фото или видео будет дата съёмки."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Månader visas här när bilder eller videor har ett tagningsdatum."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เดือนจะปรากฏที่นี่เมื่อรูปภาพหรือวิดีโอมีวันที่ถ่าย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraf veya videoların çekim tarihi olduğunda aylar burada görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Місяці з’являться тут, коли фото чи відео матимуть дату зйомки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các tháng sẽ hiện ở đây khi ảnh hoặc video có ngày chụp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片或视频有拍摄日期后，月份会显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "照片或影片有拍攝日期後，月份就會顯示在這裡。"
          }
        }
      }
    },
    "months_empty_title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد أشهر بعد"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen måneder endnu"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Monate"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No months yet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay meses"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore de mois"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada bulan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessun mese"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ月がありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 월이 없어요"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen måneder ennå"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen maanden"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak miesięcy"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda sem meses"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há meses"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încă nu există luni"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Месяцев пока нет"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga månader ännu"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีเดือน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz ay yok"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Місяців поки немає"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có tháng nào"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有月份"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚無月份"
          }
        }
      }
    },
    "months_intro": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مدى تقدمك في كل شهر. العناصر المؤجلة لوقت لاحق تُحسب كمراجعة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor langt du er i hver måned. Emner, der er lagt til side til senere, tæller som gennemgået."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So weit bist du in jedem Monat. Was du auf später gelegt hast, zählt als durchgesehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How far you are in each month. Items set aside for later count as reviewed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que llevas de cada mes. Lo dejado para después cuenta como revisado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Où tu en es pour chaque mois. Ce qui est remis à plus tard compte comme passé en revue."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sejauh mana kamu di setiap bulan. Item yang disisihkan untuk nanti dihitung sudah ditinjau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A che punto sei in ogni mese. Ciò che è rimandato conta come rivisto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各月の進み具合です。「あとで」にしたものは見直し済みとして数えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "월별 진행 상황이에요. ‘나중에’로 미룬 항목은 확인한 것으로 세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor langt du har kommet i hver måned. Elementer lagt til side til senere teller som gått gjennom."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zo ver ben je per maand. Wat voor later is bewaard, telt als bekeken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Postęp w każdym miesiącu. Odłożone na później liczą się jako przejrzane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto você já avançou em cada mês. Itens deixados para depois contam como revisados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O teu progresso em cada mês. O que ficou para mais tarde conta como revisto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cât ai avansat în fiecare lună. Ce ai amânat contează ca revizuit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твой прогресс по месяцам. Отложенное на потом считается просмотренным."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hur långt du har kommit i varje månad. Objekt som lagts undan till senare räknas som genomgångna."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความคืบหน้าของคุณในแต่ละเดือน รายการที่แยกไว้ทีหลังนับว่าตรวจดูแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her ayda ne kadar ilerlediğin. Sonraya bırakılanlar gözden geçirilmiş sayılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Твій прогрес за місяцями. Відкладене на потім вважається переглянутим."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã đi được bao xa trong mỗi tháng. Các mục để sau được tính là đã xem lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个月的进度。设为稍后的内容计为已查看。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你在每個月份的進度。存為稍後的項目也算已整理。"
          }
        }
      }
    },
    "months_title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حسب الشهر"
          }
        },
        "da": {
          "stringUnit": {
