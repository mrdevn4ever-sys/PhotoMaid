      }
    },
    "lib_hide_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن يعرضها PhotoMaid بعد الآن – لا في «الصور» ولا أثناء التنظيف. تبقى الملفات كما هي وتظل مرئية في التطبيقات الأخرى. هذه ليست خزنة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid zeigt sie nicht mehr – weder unter „Fotos“ noch beim Aufräumen. Die Dateien bleiben unverändert und in anderen Apps sichtbar. Das ist kein Tresor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid will no longer show them – not under Photos and not during cleanup. The files stay unchanged and remain visible in other apps. This is not a safe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid dejará de mostrarlos, ni en Fotos ni al limpiar. Los archivos no cambian y siguen visibles en otras apps. No es una caja fuerte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid ne les affichera plus, ni dans Photos ni pendant le nettoyage. Les fichiers restent inchangés et visibles dans les autres apps. Ce n’est pas un coffre-fort."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid non li mostrerà più, né in Foto né durante la pulizia. I file restano invariati e visibili nelle altre app. Non è una cassaforte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid では「写真」にも整理中にも表示されなくなります。ファイルはそのままで、他のアプリでは表示されます。金庫ではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid에서 더 이상 사진 탭과 정리 중에 표시되지 않습니다. 파일은 그대로이며 다른 앱에서는 계속 보입니다. 금고가 아닙니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid toont ze niet meer – niet bij Foto’s en niet bij opruimen. De bestanden blijven ongewijzigd en zichtbaar in andere apps. Dit is geen kluis."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid przestanie je pokazywać – ani w Zdjęciach, ani podczas porządków. Pliki pozostają bez zmian i są widoczne w innych aplikacjach. To nie jest sejf."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O PhotoMaid deixa de os mostrar – nem em Fotos nem na limpeza. Os ficheiros ficam inalterados e visíveis noutras apps. Isto não é um cofre."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid nu le va mai afișa – nici la Fotografii, nici la curățare. Fișierele rămân neschimbate și vizibile în alte aplicații. Nu este un seif."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid перестанет их показывать – ни в «Фото», ни при уборке. Файлы не меняются и видны в других приложениях. Это не сейф."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid bunları artık göstermez – ne Fotoğraflar’da ne de temizlikte. Dosyalar değişmez ve diğer uygulamalarda görünür kalır. Bu bir kasa değildir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid більше не показуватиме їх – ні у «Фото», ні під час прибирання. Файли не змінюються й видимі в інших застосунках. Це не сейф."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid 将不再显示它们——无论在“照片”中还是整理时。文件保持不变，在其他应用中仍可见。这不是保险箱。"
          }
        }
      }
    },
