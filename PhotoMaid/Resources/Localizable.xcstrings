    "lib_trash_fav_protected": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا عنصر مفضل. „حماية المفضلة“ مفعّل، لذا لن يُنقل إلى السلة. يمكنك تغيير ذلك في الإعدادات."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette er en favorit. “Beskyt favoritter” er slået til, så den holdes ude af papirkurven. Du kan ændre det i Indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist ein Favorit. „Favoriten schützen“ ist an, deshalb kommt er nicht in den Papierkorb. Ändern kannst du das in den Einstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a favourite. “Protect favourites” is on, so it stays out of the trash. You can change this in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es un favorito. «Proteger favoritos» está activado, así que no va a la papelera. Puedes cambiarlo en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est un favori. « Protéger les favoris » est activé, il ne va donc pas à la corbeille. Tu peux le modifier dans les réglages."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini favorit. “Lindungi favorit” aktif, jadi item ini tidak masuk ke sampah. Kamu bisa mengubahnya di Pengaturan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È un preferito. «Proteggi preferiti» è attivo, quindi non va nel cestino. Puoi cambiarlo nelle impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これはお気に入りです。「お気に入りを保護」がオンのため、ゴミ箱には入りません。設定で変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "즐겨찾기 항목이에요. '즐겨찾기 보호'가 켜져 있어 휴지통에 넣지 않아요. 설정에서 바꿀 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette er en favoritt. «Beskytt favoritter» er på, så den holdes utenfor papirkurven. Du kan endre dette i Innstillinger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is een favoriet. ‘Favorieten beschermen’ staat aan, dus hij gaat niet naar de prullenbak. Je kunt dit wijzigen in Instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To ulubione. „Chroń ulubione” jest włączone, więc nie trafi do kosza. Możesz to zmienić w ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este item está nos Favoritos. “Proteger favoritos” está ativado, então ele fica fora da lixeira. Você pode mudar isso em Ajustes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "É um favorito. «Proteger favoritos» está ativo, por isso não vai para o lixo. Podes mudar isto nas definições."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Este un favorit. „Protejează favoritele” e activ, așa că nu ajunge în coș. Poți schimba asta în setări."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это избранное. Включено «Защищать избранное», поэтому оно не попадёт в корзину. Это можно изменить в настройках."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här är en favorit. ”Skydda favoriter” är på, så den hålls utanför papperskorgen. Du kan ändra det i Inställningar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นี่คือรายการโปรด “ปกป้องรายการโปรด” เปิดอยู่ จึงไม่ไปถังขยะ คุณเปลี่ยนได้ในการตั้งค่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bir favori. „Favorileri koru” açık olduğu için çöp kutusuna gitmez. Bunu ayarlardan değiştirebilirsin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це обране. Увімкнено «Захищати обране», тому воно не потрапить у кошик. Змінити це можна в налаштуваннях."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây là mục ưa thích. “Bảo vệ mục ưa thích” đang bật nên nó không vào thùng rác. Bạn có thể đổi điều này trong Cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是收藏项。已开启“保护收藏”，因此不会移到回收站。可在设置中更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是個人收藏。「保護個人收藏」已開啟，所以不會放入垃圾桶。你可以在「設定」中更改。"
          }
        }
      }
    },
    "lib_trash_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إلى سلة GaleriQ – لا يُحذف شيء. تقرر لاحقًا هناك."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "I GaleriQ-papirkurven – intet slettes. Du bestemmer der senere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In den GaleriQ-Papierkorb – es wird nichts gelöscht. Du entscheidest dort später."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Into the GaleriQ trash – nothing is deleted. You decide there later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A la papelera de GaleriQ; no se borra nada. Decides allí más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans la corbeille GaleriQ – rien n’est supprimé. Tu décides plus tard."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ke sampah GaleriQ – tidak ada yang dihapus. Kamu memutuskannya nanti di sana."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nel cestino di GaleriQ: non viene eliminato nulla. Decidi lì più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQのゴミ箱へ。何も削除されません。あとでそこで決めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ 휴지통으로 – 아무것도 삭제되지 않아요. 나중에 거기서 결정해요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "I GaleriQ-papirkurven – ingenting slettes. Du bestemmer der senere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naar de GaleriQ-prullenbak – er wordt niets verwijderd. Je beslist daar later."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do kosza GaleriQ – nic nie zostanie usunięte. Zdecydujesz tam później."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para a lixeira do GaleriQ – nada é apagado. Você decide lá depois."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para o lixo do GaleriQ – nada é eliminado. Decides lá mais tarde."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În coșul GaleriQ – nu se șterge nimic. Decizi acolo mai târziu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В корзину GaleriQ — ничего не удаляется. Решишь там позже."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Till GaleriQ-papperskorgen – inget raderas. Du bestämmer där senare."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไปที่ถังขยะ GaleriQ – ไม่มีอะไรถูกลบ คุณตัดสินใจที่นั่นภายหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ çöp kutusuna – hiçbir şey silinmez. Sonra orada karar verirsin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У кошик GaleriQ — нічого не видаляється. Вирішиш там пізніше."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vào thùng rác GaleriQ – không có gì bị xóa. Bạn quyết định sau ở đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移到 GaleriQ 回收站——不会删除任何内容，稍后在那里决定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "放入 GaleriQ 垃圾桶 – 不會刪除任何內容。你之後在那裡決定。"
          }
        }
      }
    },
    "lib_trash_text_fav": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إلى سلة GaleriQ – لا يُحذف شيء. تبقى المفضلة („حماية المفضلة“ مفعّل)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "I GaleriQ-papirkurven – intet slettes. Favoritter bliver (“Beskyt favoritter” er slået til)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In den GaleriQ-Papierkorb – es wird nichts gelöscht. Favoriten bleiben („Favoriten schützen“ ist an)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Into the GaleriQ trash – nothing is deleted. Favourites stay (“Protect favourites” is on)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A la papelera de GaleriQ; no se borra nada. Los favoritos se quedan («Proteger favoritos» está activado)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans la corbeille GaleriQ – rien n’est supprimé. Les favoris restent (« Protéger les favoris » est activé)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ke sampah GaleriQ – tidak ada yang dihapus. Favorit tetap (“Lindungi favorit” aktif)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nel cestino di GaleriQ: non viene eliminato nulla. I preferiti restano («Proteggi preferiti» è attivo)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQのゴミ箱へ。何も削除されません。お気に入りは残ります（「お気に入りを保護」がオン）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ 휴지통으로 – 아무것도 삭제되지 않아요. 즐겨찾기는 남아요('즐겨찾기 보호' 켜짐)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "I GaleriQ-papirkurven – ingenting slettes. Favoritter blir («Beskytt favoritter» er på)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naar de GaleriQ-prullenbak – er wordt niets verwijderd. Favorieten blijven (‘Favorieten beschermen’ staat aan)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do kosza GaleriQ – nic nie zostanie usunięte. Ulubione zostają (włączone „Chroń ulubione”)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para a lixeira do GaleriQ – nada é apagado. Os favoritos ficam (“Proteger favoritos” está ativado)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para o lixo do GaleriQ – nada é eliminado. Os favoritos ficam («Proteger favoritos» está ativo)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În coșul GaleriQ – nu se șterge nimic. Favoritele rămân („Protejează favoritele” e activ)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В корзину GaleriQ — ничего не удаляется. Избранное остаётся (включено «Защищать избранное»)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Till GaleriQ-papperskorgen – inget raderas. Favoriter stannar (”Skydda favoriter” är på)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไปที่ถังขยะ GaleriQ – ไม่มีอะไรถูกลบ รายการโปรดยังอยู่ (“ปกป้องรายการโปรด” เปิดอยู่)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ çöp kutusuna – hiçbir şey silinmez. Favoriler kalır („Favorileri koru” açık)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У кошик GaleriQ — нічого не видаляється. Обране залишається (увімкнено «Захищати обране»)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vào thùng rác GaleriQ – không có gì bị xóa. Mục ưa thích được giữ lại (“Bảo vệ mục ưa thích” đang bật)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移到 GaleriQ 回收站——不会删除任何内容。收藏会保留（已开启“保护收藏”）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "放入 GaleriQ 垃圾桶 – 不會刪除任何內容。個人收藏會保留（「保護個人收藏」已開啟）。"
          }
        }
      }
    },
