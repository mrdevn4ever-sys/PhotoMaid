    "ana_blurry_sub": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مهتزة أو غير واضحة – مرتبة حسب الوضوح"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কাঁপা বা ফোকাসের বাইরে – স্পষ্টতা অনুযায়ী সাজানো"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mogudes o desenfocades, ordenades per nitidesa"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozhýbané nebo neostré – seřazené podle ostrosti"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Rystede eller ude af fokus – sorteret efter skarphed"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwackelt oder unscharf – nach Schärfe sortiert"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κουνημένες ή εκτός εστίασης – ταξινομημένες κατά ευκρίνεια"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shaky or out of focus – sorted by sharpness"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Movidas o desenfocadas, ordenadas por nitidez"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tärähtäneet tai epätarkat – terävyyden mukaan"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bougées ou floues – triées par netteté"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હલેલા કે ફોકસ બહાર – સ્પષ્ટતા મુજબ"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רועדות או לא בפוקוס – ממוינות לפי חדות"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हिली हुई या फ़ोकस से बाहर – शार्पनेस के हिसाब से"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamućene ili izvan fokusa – poredano po oštrini"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bemozdult vagy életlen – élesség szerint rendezve"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Goyang atau tidak fokus – diurutkan menurut ketajaman"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mosse o sfocate, ordinate per nitidezza"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手ぶれやピンぼけ（シャープさ順）"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅಲುಗಾಡಿದ ಅಥವಾ ಫೋಕಸ್ ತಪ್ಪಿದ – ಸ್ಪಷ್ಟತೆಯ ಪ್ರಕಾರ ವಿಂಗಡಿಸಲಾಗಿದೆ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "흔들리거나 초점이 안 맞은 사진 – 선명도순"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇളകിയതോ ഫോക്കസ് തെറ്റിയതോ – വ്യക്തത അനുസരിച്ച് അടുക്കിയത്"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हललेले किंवा फोकसबाहेर – स्पष्टतेनुसार"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Goyang atau tidak fokus – diisih mengikut ketajaman"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rystet eller ute av fokus – sortert etter skarphet"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewogen of onscherp – gesorteerd op scherpte"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ହଲିଯାଇଥିବା କିମ୍ବା ଫୋକସ୍ ବାହାରେ – ସ୍ପଷ୍ଟତା ଅନୁସାରେ ସଜା"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹਿੱਲੀਆਂ ਜਾਂ ਫੋਕਸ ਤੋਂ ਬਾਹਰ – ਸਪਸ਼ਟਤਾ ਅਨੁਸਾਰ"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poruszone lub nieostre – według ostrości"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tremidas ou fora de foco – ordenadas por nitidez"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tremidas ou desfocadas – ordenadas por nitidez"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mișcate sau neclare – sortate după claritate"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смазанные или нечёткие — по резкости"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Roztrasené alebo neostré – zoradené podľa ostrosti"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tresoče ali neostre – razvrščene po ostrini"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skakiga eller ur fokus – sorterade efter skärpa"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அசைந்தவை அல்லது ஃபோகஸ் இல்லாதவை – தெளிவின்படி வரிசைப்படுத்தப்பட்டவை"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కదిలినవి లేదా ఫోకస్ లేనివి – స్పష్టత ప్రకారం అమర్చబడ్డాయి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สั่นหรือไม่ชัด – เรียงตามความคมชัด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Titrek veya odak dışı – netliğe göre"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Змазані чи нечіткі — за різкістю"
