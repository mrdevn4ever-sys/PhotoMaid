            "value": "முழு நூலகமும் பார்வையிடப்பட்டது"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మొత్తం లైబ్రరీ సమీక్షించారు"
          }
        },
        "th": {
