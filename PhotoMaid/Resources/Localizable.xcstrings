    "tools_stitch_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يدمج لقطات الشاشة من الأعلى إلى الأسفل في صورة طويلة واحدة، بترتيب التقاطها. تأخذ كلها عرض أضيق صورة – لا شيء يُمطّ أو يُكبَّر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্ক্রিনশটগুলো উপর থেকে নিচে একটি লম্বা ছবিতে জোড়ে, তোলার ক্রমে। সবগুলো সবচেয়ে সরু ছবির প্রস্থ পায় – কিছুই টেনে লম্বা বা বড় করা হয় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Uneix captures de pantalla de dalt a baix en una sola imatge llarga, en l’ordre en què es van fer. Totes prenen l’amplada de la imatge més estreta: no s’estira ni s’amplia res."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Spojí snímky obrazovky shora dolů do jednoho dlouhého obrázku, v pořadí pořízení. Všechny dostanou šířku nejužšího obrázku – nic se neroztahuje ani nezvětšuje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sætter skærmbilleder sammen oppefra og ned til ét langt billede i den rækkefølge, de blev taget. Alle får det smalleste billedes bredde – intet strækkes eller forstørres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt Screenshots von oben nach unten zu einem langen Bild zusammen – in der Reihenfolge der Aufnahme. Alle bekommen die Breite des schmalsten Bildes, nichts wird verzerrt oder vergrößert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενώνει στιγμιότυπα οθόνης από πάνω προς τα κάτω σε μία μακριά εικόνα, με τη σειρά λήψης. Όλα παίρνουν το πλάτος της πιο στενής εικόνας – τίποτα δεν τεντώνεται ή μεγεθύνεται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Joins screenshots top to bottom into one long image, in the order they were taken. All get the width of the narrowest image – nothing is stretched or enlarged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Une capturas de pantalla de arriba abajo en una imagen larga, en el orden en que se hicieron. Todas toman el ancho de la más estrecha: nada se deforma ni se amplía."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhdistää kuvakaappaukset ylhäältä alas yhdeksi pitkäksi kuvaksi kuvausjärjestyksessä. Kaikki saavat kapeimman kuvan leveyden – mitään ei venytetä eikä suurenneta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assemble les captures d’écran de haut en bas en une longue image, dans l’ordre de prise. Toutes prennent la largeur de la plus étroite – rien n’est déformé ni agrandi."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સ્ક્રીનશૉટને ઉપરથી નીચે એક લાંબી છબીમાં જોડે છે, લીધેલા ક્રમમાં. બધાને સૌથી સાંકડી છબીની પહોળાઈ મળે છે – કંઈ ખેંચાતું કે મોટું થતું નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מחבר צילומי מסך מלמעלה למטה לתמונה ארוכה אחת, לפי סדר הצילום. כולם מקבלים את רוחב התמונה הצרה ביותר – שום דבר לא נמתח או מוגדל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्क्रीनशॉट को ऊपर से नीचे एक लंबी इमेज में जोड़ता है, लेने के क्रम में। सबको सबसे पतली इमेज की चौड़ाई मिलती है – कुछ भी खींचा या बड़ा नहीं होता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spaja snimke zaslona odozgo prema dolje u jednu dugu sliku, redoslijedom snimanja. Sve dobivaju širinu najuže slike – ništa se ne rasteže ni povećava."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A képernyőképeket fentről lefelé egyetlen hosszú képpé fűzi a készítés sorrendjében. Mindegyik a legkeskenyebb kép szélességét kapja – semmi sem nyúlik meg és nem nagyítódik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menggabungkan tangkapan layar dari atas ke bawah menjadi satu gambar panjang, sesuai urutan pengambilan. Semua mengikuti lebar gambar tersempit – tidak ada yang diregangkan atau diperbesar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Unisce gli screenshot dall’alto in basso in un’unica immagine lunga, nell’ordine in cui sono stati fatti. Tutti prendono la larghezza del più stretto: niente viene deformato o ingrandito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクリーンショットを撮影順に上から下へつなげ、1枚の長い画像にします。すべて最も幅の狭い画像に合わせ、引き伸ばしや拡大はしません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ಕ್ರೀನ್‌ಶಾಟ್‌ಗಳನ್ನು ಮೇಲಿನಿಂದ ಕೆಳಗೆ ಒಂದು ಉದ್ದದ ಚಿತ್ರವಾಗಿ ಜೋಡಿಸುತ್ತದೆ, ತೆಗೆದ ಕ್ರಮದಲ್ಲಿ. ಎಲ್ಲವೂ ಅತಿ ಕಿರಿದಾದ ಚಿತ್ರದ ಅಗಲ ಪಡೆಯುತ್ತವೆ – ಏನನ್ನೂ ಹಿಗ್ಗಿಸಲಾಗುವುದಿಲ್ಲ ಅಥವಾ ದೊಡ್ಡದಾಗಿಸಲಾಗುವುದಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크린샷을 촬영 순서대로 위에서 아래로 이어 긴 이미지 하나로 만들어요. 모두 가장 좁은 이미지의 너비에 맞추며 늘이거나 확대하지 않아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്ക്രീൻഷോട്ടുകളെ മുകളിൽ നിന്ന് താഴേക്ക് ഒരു നീണ്ട ചിത്രമായി യോജിപ്പിക്കുന്നു, എടുത്ത ക്രമത്തിൽ. എല്ലാറ്റിനും ഏറ്റവും ഇടുങ്ങിയ ചിത്രത്തിന്റെ വീതി ലഭിക്കും – ഒന്നും വലിച്ചുനീട്ടുകയോ വലുതാക്കുകയോ ഇല്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "स्क्रीनशॉट वरून खाली एका लांब प्रतिमेत जोडते, काढलेल्या क्रमाने. सर्वांना सर्वात अरुंद प्रतिमेची रुंदी मिळते – काहीही ताणले किंवा मोठे केले जात नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mencantumkan syot layar dari atas ke bawah menjadi satu imej panjang, mengikut susunan ia diambil. Semua mendapat lebar imej yang paling sempit – tiada apa diregangkan atau dibesarkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Setter sammen skjermbilder ovenfra og ned til ett langt bilde, i den rekkefølgen de ble tatt. Alle får bredden til det smaleste bildet – ingenting strekkes eller forstørres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voegt schermafbeeldingen van boven naar beneden samen tot één lange afbeelding, in de volgorde waarin ze zijn gemaakt. Alle krijgen de breedte van de smalste – niets wordt vervormd of vergroot."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସ୍କ୍ରିନସଟ୍‌ଗୁଡ଼ିକୁ ଉପରୁ ତଳକୁ ଏକ ଲମ୍ବା ଛବିରେ ଯୋଡ଼େ, ଉଠାଯାଇଥିବା କ୍ରମରେ। ସବୁ ସବୁଠାରୁ ସଂକୀର୍ଣ୍ଣ ଛବିର ପ୍ରସ୍ଥ ପାଆନ୍ତି – କିଛି ଟାଣି ଲମ୍ବା କିମ୍ବା ବଡ଼ କରାଯାଏ ନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਕ੍ਰੀਨਸ਼ਾਟਾਂ ਨੂੰ ਉੱਪਰ ਤੋਂ ਹੇਠਾਂ ਇੱਕ ਲੰਬੀ ਤਸਵੀਰ ਵਿੱਚ ਜੋੜਦਾ ਹੈ, ਖਿੱਚੇ ਜਾਣ ਦੇ ਕ੍ਰਮ ਵਿੱਚ। ਸਾਰੀਆਂ ਨੂੰ ਸਭ ਤੋਂ ਤੰਗ ਤਸਵੀਰ ਦੀ ਚੌੜਾਈ ਮਿਲਦੀ ਹੈ – ਕੁਝ ਵੀ ਖਿੱਚਿਆ ਜਾਂ ਵੱਡਾ ਨਹੀਂ ਕੀਤਾ ਜਾਂਦਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Łączy zrzuty ekranu od góry do dołu w jeden długi obraz, w kolejności wykonania. Wszystkie dostają szerokość najwęższego – nic nie jest rozciągane ani powiększane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Junta capturas de tela de cima para baixo numa imagem longa, na ordem em que foram feitas. Todas ficam com a largura da imagem mais estreita – nada é esticado nem ampliado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Junta capturas de ecrã de cima para baixo numa imagem longa, pela ordem em que foram tiradas. Todas ficam com a largura da mais estreita – nada é deformado nem ampliado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Unește capturile de ecran de sus în jos într-o singură imagine lungă, în ordinea în care au fost făcute. Toate primesc lățimea celei mai înguste – nimic nu este deformat sau mărit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Склеивает скриншоты сверху вниз в одно длинное изображение в порядке съёмки. Все получают ширину самого узкого – ничего не растягивается и не увеличивается."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Spojí snímky obrazovky zhora nadol do jedného dlhého obrázka, v poradí nasnímania. Všetky dostanú šírku najužšieho obrázka – nič sa nenaťahuje ani nezväčšuje."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Združi zaslonske slike od zgoraj navzdol v eno dolgo sliko, v vrstnem redu posnetkov. Vse dobijo širino najožje slike – nič se ne raztegne ali poveča."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sätter ihop skärmavbilder uppifrån och ned till en lång bild, i den ordning de togs. Alla får samma bredd som den smalaste bilden – inget sträcks eller förstoras."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஸ்கிரீன்ஷாட்களை மேலிருந்து கீழாக ஒரு நீண்ட படமாக இணைக்கிறது, எடுக்கப்பட்ட வரிசையில். அனைத்தும் மிகக் குறுகிய படத்தின் அகலத்தைப் பெறும் – எதுவும் இழுக்கப்படவோ பெரிதாக்கப்படவோ இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "స్క్రీన్‌షాట్‌లను పై నుండి కిందికి ఒక పొడవైన చిత్రంగా కలుపుతుంది, తీసిన క్రమంలో. అన్నీ అతి ఇరుకైన చిత్రం వెడల్పును పొందుతాయి – ఏదీ సాగదీయబడదు, పెద్దది చేయబడదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต่อภาพหน้าจอจากบนลงล่างเป็นรูปยาวรูปเดียว ตามลำดับที่ถ่าย ทุกรูปจะมีความกว้างเท่ากับรูปที่แคบที่สุด – ไม่มีอะไรถูกยืดหรือขยาย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran görüntülerini çekilme sırasına göre yukarıdan aşağıya tek uzun bir görüntüde birleştirir. Hepsi en dar görüntünün genişliğini alır; hiçbir şey esnetilmez veya büyütülmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Склеює знімки екрана згори донизу в одне довге зображення в порядку зйомки. Усі отримують ширину найвужчого – нічого не розтягується й не збільшується."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اسکرین شاٹس کو اوپر سے نیچے ایک لمبی تصویر میں جوڑتا ہے، لینے کی ترتیب میں۔ سب کو سب سے تنگ تصویر کی چوڑائی ملتی ہے – کچھ بھی کھینچا یا بڑا نہیں ہوتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghép ảnh chụp màn hình từ trên xuống dưới thành một ảnh dài, theo thứ tự chụp. Tất cả có chiều rộng của ảnh hẹp nhất – không có gì bị kéo giãn hay phóng to."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按拍摄顺序将截屏从上到下拼成一张长图。所有图片都采用最窄图片的宽度，不会拉伸或放大。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將截圖由上到下依拍攝順序拼接成一張長圖。所有圖片都會配合最窄圖片的寬度 – 不會拉伸或放大。"
          }
        }
      }
    },
