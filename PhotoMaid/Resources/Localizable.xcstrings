    "tour_lib_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هنا كل صورك ومقاطع الفيديو – حسب اليوم أو الشهر أو السنة، في الألبومات والمفضلة. المشاهدة لا تغيّر شيئًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier findest du alle Fotos und Videos – nach Tagen, Monaten oder Jahren, in Alben und Favoriten. Ansehen ändert nichts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Here are all your photos and videos – by day, month or year, in albums and favourites. Just looking never changes anything."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí están todas tus fotos y vídeos: por día, mes o año, en álbumes y favoritos. Mirar no cambia nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retrouvez ici toutes vos photos et vidéos – par jour, mois ou année, dans les albums et favoris. Regarder ne modifie rien."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui trovi tutte le foto e i video, per giorno, mese o anno, negli album e nei preferiti. Guardare non cambia nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての写真とビデオを日・月・年別に、アルバムやお気に入りで見られます。見るだけでは何も変わりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 사진과 비디오를 일, 월, 연도별로, 앨범과 즐겨찾기에서 볼 수 있습니다. 보기만 해서는 아무것도 바뀌지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier vind je al je foto’s en video’s – per dag, maand of jaar, in albums en favorieten. Kijken verandert niets."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu znajdziesz wszystkie zdjęcia i filmy – według dni, miesięcy lub lat, w albumach i ulubionych. Przeglądanie niczego nie zmienia."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Aqui estão todas as fotografias e vídeos – por dia, mês ou ano, em álbuns e favoritos. Ver não altera nada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aici găsești toate pozele și videoclipurile – pe zile, luni sau ani, în albume și favorite. Vizualizarea nu schimbă nimic."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь все ваши фото и видео — по дням, месяцам или годам, в альбомах и избранном. Просмотр ничего не меняет."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm fotoğrafların ve videoların burada – güne, aya veya yıla göre, albümlerde ve favorilerde. Bakmak hiçbir şeyi değiştirmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут усі ваші фото й відео — за днями, місяцями чи роками, в альбомах і вибраному. Перегляд нічого не змінює."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里有你所有的照片和视频——按日、月或年，以及相簿和个人收藏。仅查看不会改变任何内容。"
          }
        }
      }
    },
