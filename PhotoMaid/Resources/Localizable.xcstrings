    "movie_music_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملفك الخاص، يُشغَّل من البداية ويتكرر عند الحاجة. لا يتضمن GaleriQ موسيقى. انتبه للحقوق عند المشاركة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার নিজের ফাইল, শুরু থেকে বাজে এবং প্রয়োজনে পুনরাবৃত্তি হয়। GaleriQ-এ কোনো সংগীত নেই। শেয়ার করার সময় স্বত্বাধিকারের দিকে খেয়াল রাখুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El teu propi fitxer, reproduït des del principi i repetit si cal. GaleriQ no inclou música. Tingues en compte els drets quan comparteixis."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš vlastní soubor, přehrávaný od začátku a podle potřeby opakovaný. GaleriQ neobsahuje žádnou hudbu. Při sdílení dbejte na práva."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din egen fil, afspillet fra begyndelsen og gentaget efter behov. GaleriQ indeholder ingen musik. Husk rettighederne, når du deler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eigene Datei, von Anfang an und bei Bedarf wiederholt. GaleriQ liefert keine Musik mit. Beim Teilen auf die Rechte achten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δικό σου αρχείο, παίζεται από την αρχή και επαναλαμβάνεται αν χρειαστεί. Το GaleriQ δεν περιέχει μουσική. Πρόσεξε τα δικαιώματα όταν το μοιράζεσαι."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your own file, played from the start and repeated if needed. GaleriQ includes no music. Mind the rights when sharing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu propio archivo, desde el inicio y repetido si hace falta. GaleriQ no incluye música. Ten en cuenta los derechos al compartir."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oma tiedostosi, toistetaan alusta ja tarvittaessa uudelleen. GaleriQ ei sisällä musiikkia. Huomioi oikeudet jakaessasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre propre fichier, depuis le début et répété si besoin. GaleriQ ne fournit pas de musique. Attention aux droits en cas de partage."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારી પોતાની ફાઇલ, શરૂઆતથી વાગે છે અને જરૂર પડે તો ફરી વાગે છે. GaleriQ માં સંગીત સામેલ નથી. શેર કરતી વખતે અધિકારોનું ધ્યાન રાખો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קובץ משלך, מתנגן מההתחלה וחוזר לפי הצורך. GaleriQ לא כוללת מוזיקה. כדאי לשים לב לזכויות בעת שיתוף."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी अपनी फ़ाइल, शुरू से चलती है और ज़रूरत हो तो दोहराई जाती है। GaleriQ में कोई संगीत शामिल नहीं है। शेयर करते समय अधिकारों का ध्यान रखें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoja vlastita datoteka, reproducirana od početka i ponavljana po potrebi. GaleriQ ne sadrži glazbu. Pri dijeljenju pazi na prava."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A saját fájlod, az elejétől lejátszva és szükség esetén ismételve. A GaleriQ nem tartalmaz zenét. Megosztáskor ügyelj a jogokra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File milikmu sendiri, diputar dari awal dan diulang bila perlu. GaleriQ tidak menyertakan musik. Perhatikan hak cipta saat membagikan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tuo file, dall’inizio e ripetuto se serve. GaleriQ non include musica. Attenzione ai diritti quando condividi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分のファイルを先頭から再生し、必要なら繰り返します。GaleriQに音楽は含まれません。共有時は権利に注意してください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಸ್ವಂತ ಫೈಲ್, ಆರಂಭದಿಂದ ಪ್ಲೇ ಆಗುತ್ತದೆ ಮತ್ತು ಅಗತ್ಯವಿದ್ದರೆ ಪುನರಾವರ್ತನೆಯಾಗುತ್ತದೆ. GaleriQ ನಲ್ಲಿ ಸಂಗೀತ ಇಲ್ಲ. ಹಂಚಿಕೊಳ್ಳುವಾಗ ಹಕ್ಕುಗಳ ಬಗ್ಗೆ ಗಮನವಿರಲಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 고른 파일이 처음부터 재생되며 필요하면 반복됩니다. GaleriQ는 음악을 제공하지 않습니다. 공유할 때 권리에 유의하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ സ്വന്തം ഫയൽ, തുടക്കം മുതൽ പ്ലേ ചെയ്യുകയും ആവശ്യമെങ്കിൽ ആവർത്തിക്കുകയും ചെയ്യും. GaleriQ-ൽ സംഗീതം ഉൾപ്പെടുന്നില്ല. പങ്കിടുമ്പോൾ അവകാശങ്ങൾ ശ്രദ്ധിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमची स्वतःची फाइल, सुरुवातीपासून वाजते आणि गरजेनुसार पुन्हा वाजते. GaleriQ मध्ये संगीत समाविष्ट नाही. शेअर करताना हक्कांची काळजी घ्या."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Fail anda sendiri, dimainkan dari awal dan diulang jika perlu. GaleriQ tidak menyertakan muzik. Ambil perhatian tentang hak semasa berkongsi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Din egen fil, spilles fra begynnelsen og gjentas ved behov. GaleriQ inneholder ingen musikk. Husk rettighetene når du deler."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je eigen bestand, vanaf het begin en zo nodig herhaald. GaleriQ levert geen muziek. Let bij delen op de rechten."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ ନିଜ ଫାଇଲ୍, ଆରମ୍ଭରୁ ବାଜେ ଏବଂ ଆବଶ୍ୟକ ହେଲେ ପୁନରାବୃତ୍ତି ହୁଏ। GaleriQରେ କୌଣସି ସଙ୍ଗୀତ ନାହିଁ। ସେୟାର୍ କରିବା ସମୟରେ ଅଧିକାର ପ୍ରତି ଧ୍ୟାନ ଦିଅନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੀ ਆਪਣੀ ਫ਼ਾਈਲ, ਸ਼ੁਰੂ ਤੋਂ ਚੱਲਦੀ ਹੈ ਅਤੇ ਲੋੜ ਹੋਵੇ ਤਾਂ ਦੁਹਰਾਈ ਜਾਂਦੀ ਹੈ। GaleriQ ਵਿੱਚ ਕੋਈ ਸੰਗੀਤ ਸ਼ਾਮਲ ਨਹੀਂ। ਸਾਂਝਾ ਕਰਦੇ ਸਮੇਂ ਅਧਿਕਾਰਾਂ ਦਾ ਧਿਆਨ ਰੱਖੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Własny plik, od początku i w razie potrzeby powtarzany. GaleriQ nie zawiera muzyki. Przy udostępnianiu pamiętaj o prawach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu próprio arquivo, tocado do início e repetido se necessário. O GaleriQ não inclui músicas. Atenção aos direitos ao compartilhar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O seu próprio ficheiro, desde o início e repetido se necessário. O GaleriQ não inclui música. Atenção aos direitos ao partilhar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fișierul tău, de la început și repetat la nevoie. GaleriQ nu include muzică. Ai grijă la drepturi când distribui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш файл, с начала и с повтором при необходимости. В GaleriQ нет встроенной музыки. При публикации учитывайте права."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš vlastný súbor, prehrávaný od začiatku a podľa potreby opakovaný. GaleriQ neobsahuje žiadnu hudbu. Pri zdieľaní dbajte na práva."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoja lastna datoteka, predvajana od začetka in po potrebi ponovljena. GaleriQ ne vsebuje glasbe. Pri deljenju upoštevaj pravice."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din egen fil, spelas från början och upprepas vid behov. GaleriQ innehåller ingen musik. Tänk på rättigheterna när du delar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் சொந்தக் கோப்பு, தொடக்கத்திலிருந்து இயங்கும், தேவைப்பட்டால் மீண்டும் இயங்கும். GaleriQ-இல் இசை எதுவும் இல்லை. பகிரும்போது உரிமைகளைக் கவனியுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ సొంత ఫైల్, మొదటి నుండి ప్లే అవుతుంది, అవసరమైతే పునరావృతమవుతుంది. GaleriQలో సంగీతం ఉండదు. షేర్ చేసేటప్పుడు హక్కులను గమనించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์ของคุณเอง เล่นตั้งแต่ต้นและเล่นซ้ำหากจำเป็น GaleriQ ไม่มีเพลงให้ โปรดคำนึงถึงลิขสิทธิ์เมื่อแชร์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendi dosyan, baştan çalar ve gerekirse tekrarlanır. GaleriQ müzik içermez. Paylaşırken haklara dikkat et."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш файл, з початку й з повтором за потреби. У GaleriQ немає вбудованої музики. Під час поширення зважайте на права."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی اپنی فائل، شروع سے چلتی ہے اور ضرورت ہو تو دہرائی جاتی ہے۔ GaleriQ میں کوئی موسیقی شامل نہیں۔ شیئر کرتے وقت حقوق کا خیال رکھیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp của riêng bạn, phát từ đầu và lặp lại nếu cần. GaleriQ không kèm nhạc. Hãy lưu ý bản quyền khi chia sẻ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用你自己的文件，从头播放，必要时循环。GaleriQ 不附带音乐。分享时请注意版权。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你自己的檔案，從頭播放，必要時重複。GaleriQ 不提供音樂。分享時請注意版權。"
          }
        }
      }
    },
