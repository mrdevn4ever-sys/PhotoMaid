    "large_footnote": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر فقط الملفات المعروفة الحجم، من %1$lld ميغابايت فأكثر. قد يختلف حجمها عن المساحة التي تتحرر عند حذفها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Dateien mit bekannter Größe ab %1$lld MB. Ihre Größe entspricht nicht unbedingt dem Speicher, der beim Löschen frei wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only files with a known size of at least %1$lld MB. Their size may differ from the space freed when you delete them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo archivos de tamaño conocido a partir de %1$lld MB. Su tamaño no siempre coincide con el espacio que se libera al borrarlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seulement les fichiers de taille connue à partir de %1$lld Mo. Leur taille ne correspond pas forcément à l’espace libéré après suppression."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo file di dimensione nota a partire da %1$lld MB. La loro dimensione potrebbe non coincidere con lo spazio liberato eliminandoli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイズがわかる%1$lld MB以上のファイルのみ表示します。ファイルサイズと、削除で空く容量は一致しないことがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "크기를 알 수 있는 %1$lld MB 이상의 파일만 표시해요. 파일 크기와 실제로 확보되는 공간은 다를 수 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen bestanden met een bekende grootte vanaf %1$lld MB. Hun grootte is niet altijd gelijk aan de ruimte die vrijkomt na verwijderen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko pliki o znanym rozmiarze od %1$lld MB. Ich rozmiar nie musi odpowiadać miejscu zwolnionemu po usunięciu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas ficheiros de tamanho conhecido a partir de %1$lld MB. O tamanho pode não corresponder ao espaço libertado ao eliminá-los."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar fișiere cu dimensiune cunoscută, de la %1$lld MB. Dimensiunea lor poate diferi de spațiul eliberat după ștergere."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только файлы с известным размером от %1$lld МБ. Их размер может отличаться от объёма места, которое освободится после удаления."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca boyutu bilinen, en az %1$lld MB olan dosyalar. Boyutları, silinince açılacak alanla aynı olmayabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише файли з відомим розміром від %1$lld МБ. Їхній розмір може не збігатися з обсягом звільненого місця після видалення."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅显示大小已知且至少为 %1$lld MB 的文件。文件大小不一定等于删除后释放的空间。"
          }
        }
      }
    },
    "large_icloud_footer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مع «تحسين تخزين الـ iPhone» تكون هذه الأصول في iCloud فقط. لا يكشف iOS حجمها الدقيق دون تنزيلها، لذا يقدّره PhotoMaid من صورك وفيديوهاتك المقاسة ويعرضه بعبارة «حوالي»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit „iPhone-Speicher optimieren“ liegen diese Originale nur in iCloud. iOS nennt ihre genaue Größe nicht, ohne sie herunterzuladen – PhotoMaid schätzt sie deshalb aus deinen gemessenen Fotos und Videos und zeigt sie als „ca.“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With “Optimize iPhone Storage”, these originals are only in iCloud. iOS doesn’t reveal their exact size without downloading them, so PhotoMaid estimates it from your measured photos and videos and shows it as “approx.”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con «Optimizar almacenamiento del iPhone», estos originales solo están en iCloud. iOS no indica su tamaño exacto sin descargarlos, así que PhotoMaid lo estima a partir de tus fotos y vídeos medidos y lo muestra como «aprox.»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec « Optimiser le stockage de l’iPhone », ces originaux sont uniquement dans iCloud. iOS n’indique pas leur taille exacte sans les télécharger : PhotoMaid l’estime donc d’après tes photos et vidéos mesurées et l’affiche avec « env. »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con «Ottimizza spazio su iPhone» questi originali sono solo in iCloud. iOS non ne indica la dimensione esatta senza scaricarli, quindi PhotoMaid la stima dalle tue foto e dai tuoi video misurati e la mostra come «circa»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「iPhoneのストレージを最適化」が有効な場合、これらのオリジナルはiCloudにのみあります。iOSはダウンロードしないと正確なサイズを教えないため、PhotoMaidは計測済みの写真や動画から推定し、「約」として表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘iPhone 저장 공간 최적화’를 사용하면 이 원본은 iCloud에만 있어요. iOS는 다운로드하지 않으면 정확한 크기를 알려 주지 않으므로 PhotoMaid가 측정한 사진과 동영상을 바탕으로 추정해 ‘약’으로 표시해요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met ‘Optimaliseer iPhone-opslag’ staan deze originelen alleen in iCloud. iOS geeft hun exacte grootte niet zonder ze te downloaden, dus schat PhotoMaid die op basis van je gemeten foto’s en video’s en toont ze als ‘ca.’."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przy „Optymalizuj pamięć iPhone’a” te oryginały są tylko w iCloud. iOS nie podaje ich dokładnego rozmiaru bez pobierania, więc PhotoMaid szacuje go na podstawie zmierzonych zdjęć i filmów i pokazuje jako „ok.”."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Com «Otimizar armazenamento do iPhone», estes originais estão apenas no iCloud. O iOS não indica o tamanho exato sem os descarregar, por isso o PhotoMaid estima-o a partir das tuas fotografias e vídeos medidos e mostra-o como «aprox.»."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cu „Optimizează spațiul iPhone-ului”, aceste originale sunt doar în iCloud. iOS nu le arată dimensiunea exactă fără descărcare, așa că PhotoMaid o estimează din fotografiile și videoclipurile tale măsurate și o afișează cu „cca.”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При «Оптимизации хранилища iPhone» эти оригиналы есть только в iCloud. iOS не сообщает их точный размер без загрузки, поэтому PhotoMaid оценивает его по измеренным фото и видео и показывает со знаком «≈»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“iPhone Saklama Alanını Optimize Et” açıkken bu orijinaller yalnızca iCloud’dadır. iOS tam boyutlarını indirmeden göstermez; bu yüzden PhotoMaid boyutu ölçülmüş fotoğraf ve videolarından tahmin eder ve “yaklaşık” olarak gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "З «Оптимізацією сховища iPhone» ці оригінали є лише в iCloud. iOS не повідомляє їхній точний розмір без завантаження, тому PhotoMaid оцінює його за виміряними фото й відео та показує зі знаком «≈»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启“优化 iPhone 储存空间”后，这些原件只在 iCloud 中。iOS 不下载就不会提供其确切大小，因此 PhotoMaid 会根据你已测量的照片和视频进行估算，并显示为“约”。"
          }
        }
      }
    },
