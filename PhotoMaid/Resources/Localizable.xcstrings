    "fav_protected_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أزل علامة المفضلة أولًا لنقله إلى سلة المهملات. يمكنك أيضًا إيقاف حماية المفضلة في الإعدادات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ট্র্যাশে রাখতে আগে পছন্দের চিহ্ন সরান। সেটিংসে পছন্দের সুরক্ষা বন্ধও করতে পারেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Primer treu la marca de preferit per posar-la a la paperera. També pots desactivar la protecció de preferits a la configuració."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Abyste ji mohli dát do koše, nejdřív odeberte označení oblíbené. Ochranu oblíbených můžete také vypnout v nastavení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjern først favoritmarkeringen for at lægge det i papirkurven. Du kan også slå favoritbeskyttelse fra i indstillingerne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entferne zuerst die Favoritenmarkierung, um es in den Papierkorb zu legen. Du kannst den Favoritenschutz auch in den Einstellungen ausschalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αφαίρεσε πρώτα τη σήμανση αγαπημένου για να τη βάλεις στον κάδο. Μπορείς επίσης να απενεργοποιήσεις την προστασία αγαπημένων στις ρυθμίσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove the favorite mark first to put it in the trash. You can also turn off favorite protection in settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quita primero la marca de favorito para enviarlo a la papelera. También puedes desactivar la protección de favoritos en los ajustes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poista ensin suosikkimerkintä siirtääksesi sen roskakoriin. Voit myös poistaa suosikkien suojauksen asetuksista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retire d’abord le statut de favori pour mettre cet élément à la corbeille. Tu peux aussi désactiver la protection des favoris dans les paramètres."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તેને ટ્રેશમાં મૂકવા પહેલાં મનપસંદનું ચિહ્ન દૂર કરો. તમે સેટિંગ્સમાં મનપસંદ સુરક્ષા બંધ પણ કરી શકો છો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להסיר קודם את סימון המועדף כדי להעביר אותה לפח. אפשר גם לכבות את הגנת המועדפים בהגדרות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे ट्रैश में डालने के लिए पहले पसंदीदा का निशान हटाएँ। आप सेटिंग्ज़ में पसंदीदा सुरक्षा बंद भी कर सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Najprije ukloni oznaku omiljenog da je staviš u smeće. Zaštitu omiljenih možeš i isključiti u postavkama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Előbb vedd le a kedvenc jelölést, hogy a kukába tehesd. A kedvencek védelmét a beállításokban ki is kapcsolhatod."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus tanda favorit dulu untuk memasukkannya ke sampah. Kamu juga bisa mematikan perlindungan favorit di pengaturan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Togli prima il contrassegno di preferito per mettere l’elemento nel cestino. Puoi anche disattivare la protezione dei preferiti nelle impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴミ箱に入れるには、まずお気に入りから外してください。設定でお気に入りの保護をオフにすることもできます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕಸದ ಬುಟ್ಟಿಗೆ ಹಾಕಲು ಮೊದಲು ಮೆಚ್ಚಿನ ಗುರುತು ತೆಗೆದುಹಾಕಿ. ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಮೆಚ್ಚಿನ ರಕ್ಷಣೆಯನ್ನು ಆಫ್ ಮಾಡಲೂಬಹುದು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통에 넣으려면 먼저 즐겨찾기를 해제하세요. 설정에서 즐겨찾기 보호를 끌 수도 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ട്രാഷിലേക്ക് ഇടാൻ ആദ്യം പ്രിയപ്പെട്ട അടയാളം നീക്കുക. ക്രമീകരണങ്ങളിൽ പ്രിയപ്പെട്ടവ സംരക്ഷണം ഓഫാക്കാനും കഴിയും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तो ट्रॅशमध्ये टाकण्यासाठी आधी आवडतेची खूण काढा. सेटिंग्जमध्ये आवडते संरक्षण बंदही करू शकता."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buang tanda kegemaran dahulu untuk memasukkannya ke sampah. Anda juga boleh mematikan perlindungan kegemaran dalam seting."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjern først favorittmerket for å legge det i papirkurven. Du kan også slå av favorittbeskyttelse i innstillingene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijder eerst de favorietmarkering om dit item in de prullenbak te zetten. Je kunt favorietbescherming ook uitzetten in de instellingen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଟ୍ରାସରେ ରଖିବାକୁ ପ୍ରଥମେ ପସନ୍ଦର ଚିହ୍ନ ହଟାନ୍ତୁ। ସେଟିଂସରେ ପସନ୍ଦର ସୁରକ୍ଷା ବନ୍ଦ ମଧ୍ୟ କରିପାରିବେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਨੂੰ ਰੱਦੀ ਵਿੱਚ ਪਾਉਣ ਲਈ ਪਹਿਲਾਂ ਮਨਪਸੰਦ ਦਾ ਨਿਸ਼ਾਨ ਹਟਾਓ। ਤੁਸੀਂ ਸੈਟਿੰਗਾਂ ਵਿੱਚ ਮਨਪਸੰਦ ਸੁਰੱਖਿਆ ਬੰਦ ਵੀ ਕਰ ਸਕਦੇ ਹੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw usuń oznaczenie ulubionego, aby przenieść element do kosza. Możesz też wyłączyć ochronę ulubionych w ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remova primeiro a marca de favorito para colocar o item na lixeira. Você também pode desativar a proteção de favoritos nos ajustes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove primeiro a marca de favorito para o colocar no lixo. Também podes desligar a proteção de favoritos nas definições."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Scoate mai întâi marcajul de favorit pentru a-l muta în coș. Poți și să oprești protejarea favoritelor din setări."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала убери отметку избранного, чтобы переместить элемент в корзину. Также можно отключить защиту избранного в настройках."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak ju chcete dať do koša, najprv odstráňte označenie obľúbenej. Ochranu obľúbených môžete aj vypnúť v nastaveniach."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Da jo daš v koš, najprej odstrani oznako priljubljene. Zaščito priljubljenih lahko tudi izklopiš v nastavitvah."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta först bort favoritmarkeringen för att lägga den i papperskorgen. Du kan också stänga av favoritskyddet i inställningarna."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "குப்பையில் போட முதலில் பிடித்த குறியை அகற்றுங்கள். அமைப்புகளில் பிடித்தவை பாதுகாப்பை முடக்கவும் செய்யலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ట్రాష్‌లో వేయడానికి ముందుగా ఇష్టమైన గుర్తును తీసివేయండి. సెట్టింగ్‌లలో ఇష్టమైనవి రక్షణను ఆఫ్ కూడా చేయవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นำเครื่องหมายรายการโปรดออกก่อนจึงจะใส่ถังขยะได้ คุณยังปิดการปกป้องรายการโปรดได้ในการตั้งค่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
