    "ach_equal_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احتفاظ وسلة المهملات ولاحقًا تُحتسب بالتساوي."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রাখুন, ট্র্যাশ ও পরে – সব সমানভাবে গোনা হয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservar, Paperera i Més tard compten igual."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponechat, Koš a Později se počítají stejně."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Behold, Papirkurv og Senere tæller lige meget."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behalten, Papierkorb und Später zählen gleich."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η Διατήρηση, ο Κάδος και το Αργότερα μετράνε το ίδιο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep, Trash and Later count equally."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservar, Papelera y Después cuentan igual."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Säilytä, Roskakori ja Myöhemmin lasketaan samanarvoisina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garder, Corbeille et Plus tard comptent pareil."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "રાખો, ટ્રેશ અને પછી – ત્રણેય સરખા ગણાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שמירה, פח ומאוחר יותר נחשבים באותה מידה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रखें, ट्रैश और बाद में – तीनों बराबर गिने जाते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadrži, Smeće i Kasnije broje se jednako."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Megtartás, a Kuka és a Később egyformán számít."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan, Sampah, dan Nanti dihitung sama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva, Cestino e Più tardi contano allo stesso modo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「残す」「ゴミ箱」「あとで」は同じように数えます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇರಿಸಿ, ಕಸದ ಬುಟ್ಟಿ ಮತ್ತು ನಂತರ – ಎಲ್ಲವೂ ಸಮಾನವಾಗಿ ಎಣಿಕೆಯಾಗುತ್ತವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관, 휴지통, 나중에는 똑같이 집계돼요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സൂക്ഷിക്കുക, ട്രാഷ്, പിന്നീട് – എല്ലാം ഒരുപോലെ എണ്ണപ്പെടും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ठेवा, ट्रॅश आणि नंतर – तिन्ही सारखेच मोजले जातात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan, Sampah dan Nanti dikira sama."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Behold, Papirkurv og Senere teller likt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaren, Prullenbak en Later tellen even zwaar."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ରଖନ୍ତୁ, ଟ୍ରାସ ଓ ପରେ – ସବୁ ସମାନ ଭାବେ ଗଣାଯାଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਰੱਖੋ, ਰੱਦੀ ਅਤੇ ਬਾਅਦ ਵਿੱਚ – ਤਿੰਨੇ ਬਰਾਬਰ ਗਿਣੇ ਜਾਂਦੇ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowaj, Kosz i Później liczą się tak samo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Manter, Lixeira e Depois contam igualmente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Manter, Lixo e Mais tarde contam da mesma forma."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Păstrează, Coș și Mai târziu contează la fel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Оставить», «Корзина» и «Позже» считаются одинаково."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponechať, Kôš a Neskôr sa počítajú rovnako."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obdrži, Koš in Pozneje štejejo enako."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Behåll, Papperskorg och Senare räknas lika."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வைத்திருத்தல், குப்பை, பிறகு – அனைத்தும் சமமாகக் கணக்கிடப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఉంచడం, ట్రాష్, తర్వాత – అన్నీ సమానంగా లెక్కించబడతాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เก็บไว้ ถังขยะ และไว้ทีหลัง นับเท่ากัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sakla, Çöp kutusu ve Sonra eşit sayılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Залишити», «Кошик» і «Пізніше» рахуються однаково."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "رکھیں، ردی اور بعد میں – تینوں برابر گنے جاتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ, Thùng rác và Để sau đều được tính như nhau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留、回收站和稍后同样计入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保留、垃圾桶和稍後都同樣計算。"
          }
        }
      }
    },
