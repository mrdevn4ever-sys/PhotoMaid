    "org_album_delete_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحذف الألبوم فقط. تبقى الصور ومقاطع الفيديو دون تغيير في مكتبتك."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Only the album is deleted. The photos and videos stay unchanged in your library."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur die Zusammenstellung wird gelöscht. Die Fotos und Videos bleiben unverändert in deiner Mediathek."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the album is deleted. The photos and videos stay unchanged in your library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se elimina el álbum. Las fotos y los vídeos siguen igual en tu biblioteca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul l’album est supprimé. Les photos et vidéos restent inchangées dans ta photothèque."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Only the album is deleted. The photos and videos stay unchanged in your library."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Viene eliminato solo l’album. Foto e video restano invariati nella tua libreria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除されるのはアルバムだけです。写真と動画はライブラリにそのまま残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앨범만 삭제돼요. 사진과 동영상은 보관함에 그대로 남아요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Only the album is deleted. The photos and videos stay unchanged in your library."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen het album wordt verwijderd. De foto’s en video’s blijven ongewijzigd in je bibliotheek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuwany jest tylko album. Zdjęcia i filmy pozostają bez zmian w bibliotece."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Only the album is deleted. The photos and videos stay unchanged in your library."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Só o álbum é eliminado. As fotos e os vídeos ficam inalterados na tua biblioteca."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se șterge doar albumul. Fotografiile și videoclipurile rămân neschimbate în bibliotecă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляется только альбом. Фото и видео остаются в медиатеке без изменений."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Only the album is deleted. The photos and videos stay unchanged in your library."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Only the album is deleted. The photos and videos stay unchanged in your library."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca albüm silinir. Fotoğraflar ve videolar kitaplığında değişmeden kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видаляється лише альбом. Фото й відео залишаються в медіатеці без змін."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Only the album is deleted. The photos and videos stay unchanged in your library."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只删除相册。照片和视频在图库中保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Only the album is deleted. The photos and videos stay unchanged in your library."
          }
        }
      }
    },
