    "studio_draft_delete_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستُزال المسودة. تبقى صورك كما هي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Entwurf wird entfernt. Deine Fotos bleiben unverändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The draft is removed. Your photos stay untouched."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se quitará el borrador. Tus fotos no cambian."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le brouillon sera supprimé. Tes photos restent intactes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La bozza verrà rimossa. Le tue foto restano invariate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下書きを削除します。写真はそのまま残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "임시 저장이 삭제돼요. 사진은 그대로예요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het concept wordt verwijderd. Je foto’s blijven ongewijzigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wersja robocza zostanie usunięta. Zdjęcia pozostaną bez zmian."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O rascunho é removido. As tuas fotos ficam intactas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciorna va fi eliminată. Fotografiile rămân neschimbate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Черновик будет удалён. Фото останутся без изменений."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taslak kaldırılır. Fotoğrafların değişmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чернетку буде видалено. Фото залишаться без змін."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "草稿将被删除，照片保持不变。"
          }
        }
      }
    },
