    "vault_forgot_none": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم إعداد مفتاح استرداد. لا يمكن فتح الخزنة دون الرمز (أو Face ID)."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো রিকভারি কী সেট আপ করা হয়নি। কোড (বা Face ID) ছাড়া ভল্ট খোলা যায় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s’ha configurat cap clau de recuperació. Sense el codi (o Face ID), la caixa forta no es pot obrir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nebyl nastaven žádný klíč pro obnovení. Bez kódu (nebo Face ID) trezor nelze otevřít."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er ikke oprettet nogen gendannelsesnøgle. Uden koden (eller Face ID) kan boksen ikke åbnes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurde kein Notfallschlüssel eingerichtet. Ohne Code (oder Face ID) lässt sich der Tresor nicht öffnen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ορίστηκε κλειδί ανάκτησης. Χωρίς τον κωδικό (ή το Face ID) το θησαυροφυλάκιο δεν ανοίγει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No recovery key was set up. Without the code (or Face ID), the vault can’t be opened."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha configurado ninguna clave de recuperación. Sin el código (o Face ID), la caja fuerte no se puede abrir."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palautusavainta ei ole asetettu. Ilman koodia (tai Face ID:tä) holvia ei voi avata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune clé de secours n’a été configurée. Sans le code (ou Face ID), le coffre-fort ne peut pas être ouvert."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કોઈ પુનઃપ્રાપ્તિ ચાવી સેટ નથી. કોડ (કે Face ID) વિના વૉલ્ટ ખોલી શકાતું નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא הוגדר מפתח שחזור. בלי הקוד (או Face ID), אי אפשר לפתוח את הכספת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई रिकवरी कुंजी सेट नहीं है। कोड (या Face ID) के बिना तिजोरी नहीं खुल सकती।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ključ za oporavak nije postavljen. Bez kôda (ili Face ID-ja) trezor se ne može otvoriti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs beállítva helyreállítási kulcs. A kód (vagy a Face ID) nélkül a széf nem nyitható meg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci pemulihan belum diatur. Tanpa kode (atau Face ID), brankas tidak dapat dibuka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stata configurata alcuna chiave di recupero. Senza il codice (o Face ID) la cassaforte non può essere aperta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復旧キーが設定されていません。コード（またはFace ID）がないと保管庫を開けません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಯಾವುದೇ ಮರುಪಡೆಯುವಿಕೆ ಕೀಲಿ ಹೊಂದಿಸಿಲ್ಲ. ಕೋಡ್ (ಅಥವಾ Face ID) ಇಲ್ಲದೆ ವಾಲ್ಟ್ ತೆರೆಯಲು ಸಾಧ್ಯವಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복구 키가 설정되지 않았습니다. 암호(또는 Face ID) 없이는 금고를 열 수 없습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "റിക്കവറി കീ സജ്ജമാക്കിയിട്ടില്ല. കോഡ് (അല്ലെങ്കിൽ Face ID) ഇല്ലാതെ വോൾട്ട് തുറക്കാനാകില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पुनर्प्राप्ती किल्ली सेट केलेली नाही. कोड (किंवा Face ID) शिवाय व्हॉल्ट उघडता येत नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada kunci pemulihan disediakan. Tanpa kod (atau Face ID), peti besi tidak dapat dibuka."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen gjenopprettingsnøkkel er satt opp. Uten koden (eller Face ID) kan safen ikke åpnes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is geen herstelsleutel ingesteld. Zonder de code (of Face ID) kan de kluis niet worden geopend."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "କୌଣସି ରିକଭରି କି ସେଟ୍ ଅପ୍ ହୋଇନାହିଁ। କୋଡ୍ (କିମ୍ବା Face ID) ବିନା ଭଲ୍ଟ ଖୋଲାଯାଇପାରିବ ନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੋਈ ਰਿਕਵਰੀ ਕੁੰਜੀ ਸੈੱਟ ਨਹੀਂ ਕੀਤੀ ਗਈ। ਕੋਡ (ਜਾਂ Face ID) ਤੋਂ ਬਿਨਾਂ ਵੌਲਟ ਖੋਲ੍ਹਿਆ ਨਹੀਂ ਜਾ ਸਕਦਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie skonfigurowano klucza odzyskiwania. Bez kodu (lub Face ID) nie można otworzyć sejfu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma chave de recuperação foi configurada. Sem o código (ou Face ID), o cofre não pode ser aberto."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi configurada nenhuma chave de recuperação. Sem o código (ou Face ID), não é possível abrir o cofre."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu a fost configurată nicio cheie de recuperare. Fără cod (sau Face ID), seiful nu poate fi deschis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ восстановления не настроен. Без кода (или Face ID) сейф нельзя открыть."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nebol nastavený žiadny kľúč na obnovenie. Bez kódu (alebo Face ID) trezor nemožno otvoriť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obnovitveni ključ ni nastavljen. Brez kode (ali Face ID) sefa ni mogoče odpreti."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen återställningsnyckel har ställts in. Utan koden (eller Face ID) kan valvet inte öppnas."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மீட்புச் சாவி அமைக்கப்படவில்லை. குறியீடு (அல்லது Face ID) இல்லாமல் லாக்கரைத் திறக்க முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రికవరీ కీ సెటప్ చేయలేదు. కోడ్ (లేదా Face ID) లేకుండా వాల్ట్‌ను తెరవలేము."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ได้ตั้งค่ากุญแจกู้คืน หากไม่มีรหัส (หรือ Face ID) จะเปิดตู้เซฟไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurtarma anahtarı ayarlanmadı. Kod (veya Face ID) olmadan kasa açılamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ відновлення не налаштовано. Без коду (або Face ID) сейф не відкрити."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی ریکوری کلید سیٹ نہیں۔ کوڈ (یا Face ID) کے بغیر والٹ نہیں کھل سکتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa thiết lập khóa khôi phục. Không có mã (hoặc Face ID), két sắt không thể mở."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未设置恢复密钥。没有密码（或 Face ID）就无法打开保险箱。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未設定復原金鑰。沒有密碼（或 Face ID）就無法打開保險箱。"
          }
        }
      }
    },
