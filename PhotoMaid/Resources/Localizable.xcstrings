        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहुँच वाली ज्ञात साइज़ की कोई फ़ाइल %1$lld MB से बड़ी नहीं है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nijedna dostupna datoteka poznate veličine nije veća od %1$lld MB."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egyik elérhető, ismert méretű fájl sem nagyobb %1$lld MB-nál."
