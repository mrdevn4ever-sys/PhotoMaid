    "edit_save_original_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يطلب iOS الإذن أولًا. يُحفظ التعديل كتعديل في تطبيق الصور، ويمكنك التراجع عنه هناك في أي وقت عبر «الرجوع إلى الأصل»."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS আগে জিজ্ঞেস করে। সম্পাদনাটি ফটো অ্যাপের সম্পাদনার মতো সংরক্ষিত হয় – সেখানে “মূলে ফিরুন” দিয়ে যেকোনো সময় ফেরাতে পারেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’iOS pregunta primer. L’edició es desa com una edició de l’app Fotos: la pots desfer allà quan vulguis amb «Revertir»."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS se nejdřív zeptá. Úprava se uloží jako úprava v aplikaci Fotky – můžete ji tam kdykoli vrátit pomocí „Vrátit“."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS spørger først. Redigeringen gemmes som en redigering i appen Fotos – du kan altid fortryde den der med “Tilbagestil”."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS fragt vorher nach. Die Bearbeitung wird wie in der Fotos-App gespeichert – dort jederzeit mit „Original wiederherstellen“ rückgängig."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το iOS ρωτά πρώτα. Η επεξεργασία αποθηκεύεται όπως μια επεξεργασία στις Φωτογραφίες – μπορείς να την αναιρέσεις εκεί οποτεδήποτε με «Επαναφορά»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS asks first. The edit is saved like an edit in the Photos app – you can undo it there anytime with “Revert”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS pregunta antes. La edición se guarda como en la app Fotos y puedes deshacerla allí cuando quieras con «Original»."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS kysyy ensin. Muokkaus tallennetaan kuten Kuvat-apin muokkaus – voit kumota sen siellä milloin tahansa valinnalla ”Palauta alkuperäinen”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS demande d’abord. La modification est enregistrée comme dans l’app Photos – annulable à tout moment avec « Revenir à l’original »."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS પહેલાં પૂછે છે. ફેરફાર ફોટો ઍપના ફેરફાર જેમ સચવાય છે – ત્યાં તમે ગમે ત્યારે “મૂળ પર પાછા જાઓ” થી તેને દૂર કરી શકો છો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS שואלת קודם. העריכה נשמרת כמו עריכה ביישום ״תמונות״ – אפשר לבטל אותה שם בכל עת עם „החזר למקור”."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS पहले पूछता है। एडिट तस्वीरें ऐप के एडिट की तरह सहेजा जाता है – आप वहाँ कभी भी “मूल पर वापस जाएँ” से उसे हटा सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS najprije pita. Izmjena se sprema kao izmjena u aplikaciji Fotografije – ondje je u svakom trenutku možeš poništiti s „Vrati”."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az iOS előbb rákérdez. A szerkesztés a Fotók app szerkesztéseihez hasonlóan mentődik – ott bármikor visszavonhatod a „Visszaállítás” gombbal."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS bertanya dulu. Hasil edit disimpan seperti edit di app Foto – kamu bisa membatalkannya di sana kapan saja dengan “Kembalikan”."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS chiede prima. La modifica viene salvata come nell’app Foto e puoi annullarla lì in qualsiasi momento con «Ripristina»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先にiOSが確認します。編集は写真アプリの編集と同じように保存され、そこでいつでも「元に戻す」で取り消せます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ಮೊದಲು ಕೇಳುತ್ತದೆ. ಎಡಿಟ್ ಫೋಟೋಗಳು ಆ್ಯಪ್‌ನ ಎಡಿಟ್‌ನಂತೆಯೇ ಉಳಿಯುತ್ತದೆ – ಅಲ್ಲಿ “ಹಿಂತಿರುಗಿಸಿ” ಮೂಲಕ ಯಾವಾಗ ಬೇಕಾದರೂ ರದ್ದುಗೊಳಿಸಬಹುದು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS가 먼저 묻습니다. 편집은 사진 앱의 편집처럼 저장되며, 그곳에서 언제든 '원본으로 복귀'로 되돌릴 수 있습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ആദ്യം ചോദിക്കും. എഡിറ്റ് ഫോട്ടോസ് ആപ്പിലെ എഡിറ്റ് പോലെ സംരക്ഷിക്കപ്പെടും – അവിടെ “മടക്കുക” ഉപയോഗിച്ച് എപ്പോൾ വേണമെങ്കിലും പഴയപടിയാക്കാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS आधी विचारते. संपादन फोटो अ‍ॅपमधील संपादनासारखे जतन होते – तिथे तुम्ही कधीही “मूळवर परत” ने ते पूर्ववत करू शकता."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS bertanya dahulu. Suntingan disimpan seperti suntingan dalam app Foto – anda boleh membuat asal di sana bila-bila masa dengan “Kembalikan”."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS spør først. Redigeringen lagres som en redigering i Bilder-appen – du kan når som helst angre den der med «Tilbakestill»."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS vraagt eerst toestemming. De bewerking wordt opgeslagen zoals in de Foto’s-app – daar altijd terug te draaien met ‘Origineel’."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ପ୍ରଥମେ ପଚାରେ। ଏଡିଟ୍ ଫଟୋ ଆପ୍‌ର ଏଡିଟ୍ ଭଳି ସେଭ୍ ହୁଏ – ସେଠାରେ “ମୂଳକୁ ଫେରନ୍ତୁ” ଦ୍ୱାରା ଯେକୌଣସି ସମୟରେ ଫେରାଇପାରିବେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ਪਹਿਲਾਂ ਪੁੱਛਦਾ ਹੈ। ਸੋਧ ਫ਼ੋਟੋਆਂ ਐਪ ਵਿੱਚ ਕੀਤੀ ਸੋਧ ਵਾਂਗ ਸੰਭਾਲੀ ਜਾਂਦੀ ਹੈ – ਤੁਸੀਂ ਇਸ ਨੂੰ ਉੱਥੇ ਕਦੇ ਵੀ “ਵਾਪਸ ਮੂਲ ’ਤੇ” ਨਾਲ ਵਾਪਸ ਲੈ ਸਕਦੇ ਹੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS najpierw zapyta. Edycja zostanie zapisana jak w aplikacji Zdjęcia – możesz ją tam w każdej chwili cofnąć opcją „Przywróć oryginał”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iOS pergunta antes. A edição é salva como uma edição no app Fotos – você pode desfazê-la lá a qualquer momento com “Reverter”."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O iOS pergunta primeiro. A edição é guardada como na app Fotografias – pode anulá-la aí a qualquer momento com «Reverter»."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS întreabă mai întâi. Editarea se salvează ca în aplicația Poze – o poți anula oricând acolo cu „Revino la original”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала iOS спросит разрешение. Правка сохранится как в приложении «Фото» – там её всегда можно отменить через «Вернуть оригинал»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS sa najprv opýta. Úprava sa uloží ako úprava v aplikácii Fotky – môžete ju tam kedykoľvek vrátiť pomocou „Vrátiť“."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS najprej vpraša. Urejanje se shrani kot urejanje v aplikaciji Fotografije – tam ga lahko kadar koli razveljaviš s »Povrni«."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS frågar först. Redigeringen sparas som en redigering i appen Bilder – du kan när som helst ångra den där med ”Återgå”."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS முதலில் கேட்கும். திருத்தம் Photos ஆப்பில் செய்த திருத்தம் போலவே சேமிக்கப்படும் – அங்கே “அசலுக்குத் திரும்பு” மூலம் எப்போது வேண்டுமானாலும் திரும்பப் பெறலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ముందుగా అడుగుతుంది. ఎడిట్ Photos యాప్‌లో చేసిన ఎడిట్‌లాగే సేవ్ అవుతుంది – అక్కడ “ఒరిజినల్‌కి తిరిగి” తో ఎప్పుడైనా వెనక్కి మార్చవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS จะถามก่อน การแก้ไขจะถูกบันทึกเหมือนการแก้ไขในแอพรูปภาพ – คุณสามารถเลิกทำได้ที่นั่นทุกเมื่อด้วย “แปลงกลับ”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS önce sorar. Düzenleme Fotoğraflar uygulamasındaki gibi kaydedilir; orada istediğin zaman \"Orijinale Döndür\" ile geri alabilirsin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спершу iOS запитає дозвіл. Редагування збережеться як у програмі «Фото» – там його завжди можна скасувати через «Повернути оригінал»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS پہلے پوچھتا ہے۔ ترمیم تصاویر ایپ کی ترمیم کی طرح محفوظ ہوتی ہے – آپ وہاں کسی بھی وقت ”اصل پر واپس جائیں“ سے اسے ہٹا سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS sẽ hỏi trước. Chỉnh sửa được lưu như chỉnh sửa trong ứng dụng Ảnh – bạn có thể hoàn tác ở đó bất cứ lúc nào bằng “Hoàn nguyên”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 会先征求你的同意。编辑会像在“照片”App 中一样存储，可随时在那里通过“复原”撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 會先詢問。編輯會像在「照片」App 中編輯一樣儲存 – 你隨時可以在那裡用「回復」還原。"
          }
        }
      }
    },
