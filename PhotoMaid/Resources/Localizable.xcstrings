          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Android vraagt één keer of het origineel naar de Android-prullenbak mag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Android raz zapyta, czy przenieść oryginał do kosza Androida."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Android asks once to confirm moving the original to the Android trash."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Android pede uma vez para confirmar a passagem do original para o lixo do Android."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Android cere o dată confirmarea mutării originalului în coșul Android."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Android один раз спросит, можно ли переместить оригинал в корзину Android."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Android asks once to confirm moving the original to the Android trash."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Android asks once to confirm moving the original to the Android trash."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android, orijinalin Android çöp kutusuna taşınması için bir kez onay ister."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Android один раз запитає, чи можна перемістити оригінал у кошик Android."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
