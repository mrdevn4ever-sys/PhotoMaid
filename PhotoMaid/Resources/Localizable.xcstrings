    "org_basket_empty_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في „الصور“ حدّد وسائط واضغط ⋯ › إضافة إلى سلة التحديد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle in „Fotos“ etwas aus und tippe auf ⋯ › In den Auswahlkorb."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In “Photos”, select something and tap ⋯ › Add to selection basket."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En «Fotos», selecciona contenido y toca ⋯ › Añadir a la cesta de selección."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans « Photos », sélectionne des médias puis touche ⋯ › Ajouter au panier de sélection."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In «Foto» seleziona dei contenuti e tocca ⋯ › Aggiungi al cestino di selezione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「写真」でメディアを選び、⋯ › 選択かごに入れる をタップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘사진’에서 미디어를 선택하고 ⋯ › 선택 바구니에 담기를 탭하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecteer in ‘Foto’s’ media en tik op ⋯ › In de selectiemand."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W „Zdjęciach” zaznacz multimedia i dotknij ⋯ › Dodaj do koszyka wyboru."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Em «Fotos», seleciona conteúdos e toca em ⋯ › Adicionar ao cesto de seleção."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În „Fotografii”, selectează conținut și atinge ⋯ › Adaugă în coșul de selecție."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В разделе «Фото» выбери медиа и нажми ⋯ › В корзину выбора."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Fotoğraflar”da medya seç ve ⋯ › Seçim sepetine ekle’ye dokun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У розділі «Фото» вибери медіа й торкнися ⋯ › До кошика вибору."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“照片”中选择媒体，然后轻点 ⋯ › 加入选择篮。"
          }
        }
      }
    },
