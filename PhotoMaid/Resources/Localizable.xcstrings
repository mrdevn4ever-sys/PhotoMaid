    "vault_backup_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الخزنة مشفّرة ومضمّنة في نسخة iPhone الاحتياطية. إذا حذفت PhotoMaid، تُحذف الخزنة أيضًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Tresor ist verschlüsselt und in deinem iPhone-Backup enthalten. Löschst du PhotoMaid, ist auch der Tresor weg."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The vault is encrypted and included in your iPhone backup. If you delete PhotoMaid, the vault is deleted too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La caja fuerte está cifrada y se incluye en la copia de seguridad de tu iPhone. Si eliminas PhotoMaid, la caja fuerte también se elimina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le coffre-fort est chiffré et inclus dans la sauvegarde de ton iPhone. Si tu supprimes PhotoMaid, le coffre-fort est supprimé aussi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cassaforte è crittografata e inclusa nel backup del tuo iPhone. Se elimini PhotoMaid, viene eliminata anche la cassaforte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保管庫は暗号化され、iPhoneのバックアップに含まれます。PhotoMaidを削除すると、保管庫も削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "금고는 암호화되어 iPhone 백업에 포함됩니다. PhotoMaid를 삭제하면 금고도 삭제됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De kluis is versleuteld en zit in je iPhone-reservekopie. Als je PhotoMaid verwijdert, wordt de kluis ook verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sejf jest zaszyfrowany i znajduje się w kopii zapasowej Twojego iPhone’a. Jeśli usuniesz PhotoMaid, sejf też zostanie usunięty."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O cofre está encriptado e incluído na cópia de segurança do teu iPhone. Se apagares o PhotoMaid, o cofre também é apagado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Seiful este criptat și inclus în backupul iPhone-ului tău. Dacă ștergi PhotoMaid, se șterge și seiful."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейф зашифрован и входит в резервную копию iPhone. Если удалишь PhotoMaid, сейф тоже удалится."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasa şifrelidir ve iPhone yedeğine dahildir. PhotoMaid’i silersen kasa da silinir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейф зашифровано, і він входить до резервної копії iPhone. Якщо видалиш PhotoMaid, сейф теж буде видалено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保险箱已加密，并包含在你的 iPhone 备份中。如果删除 PhotoMaid，保险箱也会被删除。"
          }
        }
      }
    },
