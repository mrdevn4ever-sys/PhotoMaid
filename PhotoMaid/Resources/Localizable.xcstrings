    "studio_err_memory": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تتوفر ذاكرة كافية لهذا الحجم. جرّب „قياسي“ أو صورًا أقل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই আকারের জন্য যথেষ্ট মেমরি নেই। “স্ট্যান্ডার্ড” বা কম ফটো চেষ্টা করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No hi ha prou memòria per a aquesta mida. Prova «Estàndard» o menys fotos."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro tuto velikost není dost paměti. Zkuste „Standardní“ nebo méně fotek."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke nok hukommelse til denne størrelse. Prøv “Standard” eller færre fotos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht genug Arbeitsspeicher für diese Größe. Versuche „Standard“ oder weniger Fotos."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχει αρκετή μνήμη για αυτό το μέγεθος. Δοκίμασε «Τυπική» ή λιγότερες φωτογραφίες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough memory for this size. Try “Standard” or fewer photos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay memoria suficiente para este tamaño. Prueba «Estándar» o menos fotos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muisti ei riitä tähän kokoon. Kokeile ”Vakio” tai vähemmän kuvia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mémoire insuffisante pour cette taille. Essaie « Standard » ou moins de photos."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ કદ માટે પૂરતી મેમરી નથી. “માનક” અથવા ઓછા ફોટા અજમાવો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין מספיק זיכרון לגודל הזה. כדאי לנסות „רגילה” או פחות תמונות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस साइज़ के लिए पर्याप्त मेमोरी नहीं है। “स्टैंडर्ड” या कम फ़ोटो आज़माएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nema dovoljno memorije za ovu veličinu. Pokušaj „Standardna” ili manje fotografija."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs elég memória ehhez a mérethez. Próbáld a „Normál” beállítást vagy kevesebb fotót."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memori tidak cukup untuk ukuran ini. Coba “Standar” atau lebih sedikit foto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Memoria insufficiente per questa dimensione. Prova «Standard» o meno foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサイズにはメモリが足りません。「標準」にするか写真を減らしてください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಗಾತ್ರಕ್ಕೆ ಸಾಕಷ್ಟು ಮೆಮೊರಿ ಇಲ್ಲ. “ಸ್ಟ್ಯಾಂಡರ್ಡ್” ಅಥವಾ ಕಡಿಮೆ ಫೋಟೋಗಳನ್ನು ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 크기에는 메모리가 부족해요. '표준'을 선택하거나 사진 수를 줄여 보세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ വലുപ്പത്തിന് മതിയായ മെമ്മറിയില്ല. “സ്റ്റാൻഡേർഡ്” അല്ലെങ്കിൽ കുറച്ച് ഫോട്ടോകൾ പരീക്ഷിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या आकारासाठी पुरेशी मेमरी नाही. “मानक” किंवा कमी फोटो वापरून पहा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Memori tidak mencukupi untuk saiz ini. Cuba “Standard” atau kurangkan foto."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke nok minne til denne størrelsen. Prøv «Standard» eller færre bilder."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet genoeg geheugen voor dit formaat. Probeer ‘Standaard’ of minder foto’s."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହି ଆକାର ପାଇଁ ଯଥେଷ୍ଟ ମେମୋରୀ ନାହିଁ। “ଷ୍ଟାଣ୍ଡାର୍ଡ” କିମ୍ବା କମ୍ ଫଟୋ ଚେଷ୍ଟା କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਆਕਾਰ ਲਈ ਲੋੜੀਂਦੀ ਮੈਮਰੀ ਨਹੀਂ। “ਮਿਆਰੀ” ਜਾਂ ਘੱਟ ਫ਼ੋਟੋਆਂ ਅਜ਼ਮਾਓ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za mało pamięci na ten rozmiar. Wybierz „Standard” lub mniej zdjęć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Memória insuficiente para este tamanho. Tente “Padrão” ou menos fotos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Memória insuficiente para este tamanho. Experimenta «Padrão» ou menos fotos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Memorie insuficientă pentru această mărime. Încearcă „Standard” sau mai puține fotografii."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Недостаточно памяти для этого размера. Попробуй «Стандарт» или меньше фото."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pre túto veľkosť nie je dosť pamäte. Skúste „Štandardná“ alebo menej fotiek."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za to velikost ni dovolj pomnilnika. Poskusi »Standardna« ali manj fotografij."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inte tillräckligt med minne för den här storleken. Prova ”Standard” eller färre bilder."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த அளவுக்குப் போதிய நினைவகம் இல்லை. “நிலையானது” அல்லது குறைவான புகைப்படங்களை முயலுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ పరిమాణానికి సరిపడా మెమరీ లేదు. “ప్రామాణికం” లేదా తక్కువ ఫోటోలు ప్రయత్నించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หน่วยความจำไม่พอสำหรับขนาดนี้ ลอง “มาตรฐาน” หรือใช้รูปน้อยลง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu boyut için yeterli bellek yok. „Standart” seç veya daha az fotoğraf kullan."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Недостатньо пам’яті для цього розміру. Спробуй «Стандарт» або менше фото."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس سائز کے لیے کافی میموری نہیں۔ ”معیاری“ یا کم تصاویر آزمائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không đủ bộ nhớ cho kích thước này. Hãy thử “Tiêu chuẩn” hoặc ít ảnh hơn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内存不足，无法生成此尺寸。请选择“标准”或减少照片数量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記憶體不足以產生此尺寸。請試試「標準」或減少照片。"
          }
        }
      }
    },
