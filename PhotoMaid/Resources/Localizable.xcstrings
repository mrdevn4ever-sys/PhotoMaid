    "rec_sub": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرقامك القياسية. تبقى على هذا الـ iPhone."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার রেকর্ড। এগুলো এই iPhone-এই থাকে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els teus rècords. Es queden en aquest iPhone."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše rekordy. Zůstávají v tomto iPhonu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine rekorder. De bliver på denne iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Rekorde. Bleiben auf diesem iPhone."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα ρεκόρ σου. Μένουν σε αυτό το iPhone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your records. They stay on this iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus récords. Se quedan en este iPhone."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ennätyksesi. Ne pysyvät tässä iPhonessa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes records. Ils restent sur cet iPhone."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારા રેકોર્ડ. તે આ જ iPhone પર રહે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השיאים שלך. הם נשארים ב-iPhone הזה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके रिकॉर्ड। ये इसी iPhone पर रहते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoji rekordi. Ostaju na ovom iPhoneu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A rekordjaid. Ezen az iPhone-on maradnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekormu. Semuanya tetap di iPhone ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi record. Restano su questo iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの記録。このiPhoneだけに保存。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ದಾಖಲೆಗಳು. ಅವು ಈ iPhone ನಲ್ಲೇ ಉಳಿಯುತ್ತವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 기록. 이 iPhone에만 남아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ റെക്കോർഡുകൾ. അവ ഈ iPhone-ൽ തന്നെ തുടരും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचे विक्रम. ते याच iPhone वर राहतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekod anda. Ia kekal pada iPhone ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekordene dine. De blir på denne iPhonen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je records. Ze blijven op deze iPhone."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ ରେକର୍ଡ। ଏଗୁଡ଼ିକ ଏହି iPhoneରେ ହିଁ ରହେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੇ ਰਿਕਾਰਡ। ਇਹ ਇਸੇ iPhone ਉੱਤੇ ਰਹਿੰਦੇ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje rekordy. Zostają na tym iPhonie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus recordes. Eles ficam neste iPhone."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os teus recordes. Ficam neste iPhone."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Recordurile tale. Rămân pe acest iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твои рекорды. Остаются на этом iPhone."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše rekordy. Zostávajú v tomto iPhone."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoji rekordi. Ostanejo v tem iPhonu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina rekord. De stannar på den här iPhonen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் சாதனைகள். அவை இந்த iPhone-இலேயே இருக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ రికార్డ్‌లు. అవి ఈ iPhoneలోనే ఉంటాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สถิติของคุณ อยู่บน iPhone เครื่องนี้"
          }
        },
        "tr": {
          "stringUnit": {
