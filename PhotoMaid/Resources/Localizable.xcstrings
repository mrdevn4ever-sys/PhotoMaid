    "vault2_conflict": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّرت الملاحظة المحفوظة ولم تُستبدل بمسودتك. احفظ المسودة كملاحظة جديدة أو تجاهل التغييرات."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den gemte note er ændret. Din kladde overskrev den ikke. Gem kladden som en ny note, eller kassér ændringer, der ikke er gemt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gespeicherte Notiz hat sich geändert. Dein Entwurf wurde nicht darübergeschrieben. Speichere ihn als neue Notiz oder verwirf die ungespeicherten Änderungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved note changed. Your draft did not overwrite it. Save your draft as a new note or discard unsaved changes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La nota guardada cambió. Tu borrador no la sobrescribió. Guárdalo como nota nueva o descarta los cambios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La note enregistrée a changé. Votre brouillon ne l’a pas écrasée. Enregistrez-le comme nouvelle note ou abandonnez les modifications."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Catatan yang tersimpan berubah. Drafmu tidak menimpanya. Simpan drafmu sebagai catatan baru atau buang perubahan yang belum disimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La nota salvata è cambiata. La bozza non l’ha sovrascritta. Salvala come nuova nota o scarta le modifiche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みメモが変更されました。下書きは上書きしていません。新しいメモとして保存するか、未保存の変更を破棄してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 메모가 변경되어 초안으로 덮어쓰지 않았습니다. 새 메모로 저장하거나 변경 사항을 버리세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det lagrede notatet er endret. Utkastet ditt overskrev det ikke. Lagre utkastet som et nytt notat eller forkast endringer som ikke er lagret."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De opgeslagen notitie is gewijzigd en niet overschreven. Sla je concept als nieuwe notitie op of gooi de wijzigingen weg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisana notatka się zmieniła. Szkic jej nie nadpisał. Zapisz go jako nową notatkę lub odrzuć zmiany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A nota salva foi alterada. Seu rascunho não a substituiu. Salve o rascunho como nova nota ou descarte as alterações não salvas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A nota guardada mudou. O rascunho não a substituiu. Guarda-o como nova nota ou descarta as alterações."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Notița salvată s-a schimbat. Ciorna nu a suprascris-o. Salvează ciorna ca notiță nouă sau renunță la modificări."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранённая заметка изменилась. Черновик её не перезаписал. Сохраните его новой заметкой или отмените изменения."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den sparade anteckningen har ändrats. Ditt utkast skrev inte över den. Spara utkastet som en ny anteckning eller släng osparade ändringar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โน้ตที่บันทึกไว้เปลี่ยนไป ฉบับร่างของคุณไม่ได้เขียนทับ บันทึกฉบับร่างเป็นโน้ตใหม่หรือละทิ้งการเปลี่ยนแปลงที่ยังไม่บันทึก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlı not değişti. Taslağın üzerine yazılmadı. Taslağı yeni not olarak kaydet veya değişiklikleri sil."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збережена нотатка змінилася. Чернетка її не перезаписала. Збережіть її як нову нотатку або скасуйте зміни."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi chú đã lưu đã thay đổi. Bản nháp của bạn không ghi đè lên nó. Hãy lưu bản nháp thành ghi chú mới hoặc bỏ các thay đổi chưa lưu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存的笔记发生了变化，草稿未将其覆盖。请另存为新笔记或放弃未保存的更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已儲存的備忘錄已更改。你的草稿沒有覆蓋它。請將草稿儲存為新備忘錄，或捨棄未儲存的更改。"
          }
        }
      }
    },
