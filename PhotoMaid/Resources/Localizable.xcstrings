        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Raz dziennie. Bonus jest ważny tylko dzisiaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma vez por dia. O bônus vale só hoje."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma vez por dia. O bónus só é válido hoje."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O dată pe zi. Bonusul este valabil doar azi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Раз в день. Бонус действует только сегодня."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En gång per dag. Bonusen gäller bara i dag."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันละครั้ง โบนัสใช้ได้วันนี้เท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
