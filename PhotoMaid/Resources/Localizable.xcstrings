            "state": "translated",
            "value": "%1$lld פריטים הוסתרו ב-GaleriQ"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld elementa skrita v GaleriQ"
          }
        }
      }
    },
    "lib_hidden_done#zero": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إخفاء %1$lld عنصر في GaleriQ"
          }
        }
      }
    },
    "lib_hidden_intro": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يعرض GaleriQ هذه العناصر في أي مكان. الملفات لم تتغير وتعرضها التطبيقات الأخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ এগুলো কোথাও দেখায় না। ফাইলগুলো অপরিবর্তিত এবং অন্য অ্যাপ এখনো এগুলো দেখায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ no els mostra enlloc. Els fitxers no canvien i les altres apps els continuen mostrant."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ je nikde nezobrazuje. Soubory jsou beze změny a jiné aplikace je dál zobrazují."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ viser dem ingen steder. Filerne er uændrede, og andre apps viser dem stadig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ zeigt das hier nirgends. Die Dateien sind unverändert, andere Apps zeigen sie weiter."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το GaleriQ δεν τα εμφανίζει πουθενά. Τα αρχεία δεν αλλάζουν και άλλες εφαρμογές εξακολουθούν να τα δείχνουν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ doesn’t show these anywhere. The files are unchanged and other apps still show them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ no muestra esto en ningún sitio. Los archivos no cambian y otras apps los siguen mostrando."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ei näytä niitä missään. Tiedostot ovat ennallaan, ja muut apit näyttävät ne edelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ne les affiche nulle part. Les fichiers sont inchangés et les autres apps les affichent toujours."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ તેમને ક્યાંય બતાવતું નથી. ફાઇલો બદલાતી નથી અને બીજી ઍપ હજી તેમને બતાવે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ לא מציגה אותם בשום מקום. הקבצים לא השתנו ויישומים אחרים עדיין מציגים אותם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ इन्हें कहीं नहीं दिखाता। फ़ाइलें नहीं बदलतीं और दूसरे ऐप इन्हें अब भी दिखाते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ih nigdje ne prikazuje. Datoteke su nepromijenjene i druge ih aplikacije i dalje prikazuju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A GaleriQ sehol sem jeleníti meg őket. A fájlok változatlanok, és más appok továbbra is mutatják őket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ tidak menampilkannya di mana pun. File-nya tidak berubah dan app lain tetap menampilkannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ non li mostra da nessuna parte. I file sono invariati e le altre app li mostrano ancora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらは GaleriQ のどこにも表示されません。ファイルは変更されず、他のアプリでは表示されます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ಇವುಗಳನ್ನು ಎಲ್ಲಿಯೂ ತೋರಿಸುವುದಿಲ್ಲ. ಫೈಲ್‌ಗಳು ಬದಲಾಗಿಲ್ಲ ಮತ್ತು ಇತರ ಆ್ಯಪ್‌ಗಳು ಇನ್ನೂ ಅವುಗಳನ್ನು ತೋರಿಸುತ್ತವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ는 이 항목을 어디에도 표시하지 않습니다. 파일은 그대로이며 다른 앱에서는 계속 보입니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ഇവ എവിടെയും കാണിക്കുന്നില്ല. ഫയലുകൾക്ക് മാറ്റമില്ല, മറ്റ് ആപ്പുകൾ ഇപ്പോഴും അവ കാണിക്കുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ते कुठेही दाखवत नाही. फाइल्स बदलत नाहीत आणि इतर अ‍ॅप्स त्या अजूनही दाखवतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ tidak menunjukkannya di mana-mana. Fail tidak berubah dan app lain masih menunjukkannya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ viser dem ingen steder. Filene er uendret, og andre apper viser dem fortsatt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ toont dit nergens. De bestanden zijn ongewijzigd en andere apps tonen ze nog."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ଏଗୁଡ଼ିକୁ କେଉଁଠି ଦେଖାଏ ନାହିଁ। ଫାଇଲ୍ ଅପରିବର୍ତ୍ତିତ ଏବଂ ଅନ୍ୟ ଆପ୍ ଏବେ ବି ଏଗୁଡ଼ିକୁ ଦେଖାଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ਇਨ੍ਹਾਂ ਨੂੰ ਕਿਤੇ ਵੀ ਨਹੀਂ ਦਿਖਾਉਂਦਾ। ਫ਼ਾਈਲਾਂ ਬਿਨਾਂ ਬਦਲੇ ਹਨ ਅਤੇ ਹੋਰ ਐਪਾਂ ਇਨ੍ਹਾਂ ਨੂੰ ਹਾਲੇ ਵੀ ਦਿਖਾਉਂਦੀਆਂ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ nigdzie tego nie pokazuje. Pliki są bez zmian, a inne aplikacje nadal je pokazują."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O GaleriQ não os mostra em lugar nenhum. Os arquivos não são alterados e outros apps ainda os mostram."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O GaleriQ não mostra isto em lado nenhum. Os ficheiros estão inalterados e outras apps continuam a mostrá-los."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ nu le afișează nicăieri. Fișierele sunt neschimbate, iar alte aplicații le afișează în continuare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ нигде это не показывает. Файлы не изменены, другие приложения их показывают."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ich nikde nezobrazuje. Súbory sú bez zmeny a iné aplikácie ich naďalej zobrazujú."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ jih nikjer ne prikazuje. Datoteke so nespremenjene in druge aplikacije jih še vedno prikazujejo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ visar dem ingenstans. Filerna är oförändrade och andra appar visar dem fortfarande."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ இவற்றை எங்கும் காட்டாது. கோப்புகள் மாறவில்லை, மற்ற ஆப்கள் இன்னும் அவற்றைக் காட்டுகின்றன."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ వీటిని ఎక్కడా చూపించదు. ఫైళ్లు మారలేదు, ఇతర యాప్‌లు ఇంకా వాటిని చూపిస్తాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ จะไม่แสดงรายการเหล่านี้ที่ใดเลย ไฟล์ไม่เปลี่ยนแปลงและแอพอื่นยังแสดงอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ bunları hiçbir yerde göstermez. Dosyalar değişmedi, diğer uygulamalar göstermeye devam eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ніде цього не показує. Файли не змінено, інші застосунки їх показують."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ انہیں کہیں نہیں دکھاتا۔ فائلیں تبدیل نہیں ہوتیں اور دوسری ایپس انہیں اب بھی دکھاتی ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ không hiển thị chúng ở bất kỳ đâu. Tệp không thay đổi và các ứng dụng khác vẫn hiển thị chúng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ 不会在任何地方显示这些内容。文件未改变，其他应用仍会显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ 不會在任何地方顯示它們。檔案保持不變，其他 App 仍會顯示它們。"
          }
        }
      }
    },
