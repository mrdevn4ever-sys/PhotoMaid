    "limit_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المحدد: %2$lld. من دون Pro يمكنك إزالة ما يصل إلى %1$lld يوميًا. يبقى الباقي في سلة مهملات GaleriQ."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নির্বাচিত: %2$lld। Pro ছাড়া দিনে সর্বোচ্চ %1$lld সরাতে পারেন। বাকি সব GaleriQ ট্র্যাশে থাকে।"
          }
        },
        "ca": {
          "stringUnit": {
