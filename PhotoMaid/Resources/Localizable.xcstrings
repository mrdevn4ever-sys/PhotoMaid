    "org_album_empty": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الألبوم فارغ. في „الصور“ حدّد وسائط واضغط ⋯ › إضافة إلى ألبوم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Album ist leer. Wähle in „Fotos“ etwas aus und tippe auf ⋯ › Zu Album hinzufügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This album is empty. In “Photos”, select something and tap ⋯ › Add to album."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este álbum está vacío. En «Fotos», selecciona contenido y toca ⋯ › Añadir a un álbum."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet album est vide. Dans « Photos », sélectionne des médias puis touche ⋯ › Ajouter à un album."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo album è vuoto. In «Foto» seleziona dei contenuti e tocca ⋯ › Aggiungi a un album."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアルバムは空です。「写真」でメディアを選び、⋯ › アルバムに追加 をタップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앨범이 비어 있어요. ‘사진’에서 미디어를 선택하고 ⋯ › 앨범에 추가를 탭하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit album is leeg. Selecteer in ‘Foto’s’ media en tik op ⋯ › Aan album toevoegen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten album jest pusty. W „Zdjęciach” zaznacz multimedia i dotknij ⋯ › Dodaj do albumu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este álbum está vazio. Em «Fotos», seleciona conteúdos e toca em ⋯ › Adicionar a um álbum."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Albumul este gol. În „Fotografii”, selectează conținut și atinge ⋯ › Adaugă la album."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Альбом пуст. В разделе «Фото» выбери медиа и нажми ⋯ › Добавить в альбом."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu albüm boş. “Fotoğraflar”da medya seç ve ⋯ › Albüme ekle’ye dokun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Альбом порожній. У розділі «Фото» вибери медіа й торкнися ⋯ › Додати до альбому."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此相册为空。在“照片”中选择媒体，然后轻点 ⋯ › 添加到相册。"
          }
        }
      }
    },
