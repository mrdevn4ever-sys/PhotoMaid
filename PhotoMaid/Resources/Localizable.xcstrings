    "col_custom_pro": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المجموعات المخصصة متاحة مع Pro. المجموعات الجاهزة مجانية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নিজস্ব সংগ্রহ Pro-তে পাওয়া যায়। তৈরি সংগ্রহগুলো বিনামূল্যে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les col·leccions personalitzades estan disponibles amb Pro. Les col·leccions preparades són gratuïtes."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vlastní kolekce jsou k dispozici s Pro. Připravené kolekce jsou zdarma."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Egne samlinger fås med Pro. Færdige samlinger er gratis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eigene Sammlungen gibt es mit Pro. Die vorbereiteten Sammlungen sind kostenlos."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι προσαρμοσμένες συλλογές είναι διαθέσιμες με το Pro. Οι έτοιμες συλλογές είναι δωρεάν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Custom collections are available with Pro. Ready-made collections are free."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las colecciones propias están disponibles con Pro. Las colecciones preparadas son gratuitas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Omat kokoelmat ovat saatavilla Pron kanssa. Valmiit kokoelmat ovat ilmaisia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les collections personnalisées sont disponibles avec Pro. Les collections préparées sont gratuites."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પોતાના સંગ્રહ Pro સાથે ઉપલબ્ધ છે. તૈયાર સંગ્રહ મફત છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אוספים מותאמים אישית זמינים עם Pro. אוספים מוכנים הם בחינם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने कलेक्शन Pro के साथ उपलब्ध हैं। तैयार कलेक्शन मुफ़्त हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vlastite zbirke dostupne su uz Pro. Gotove zbirke su besplatne."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Saját gyűjtemények a Próval érhetők el. A kész gyűjtemények ingyenesek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Koleksi kustom tersedia dengan Pro. Koleksi siap pakai gratis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le raccolte personalizzate sono disponibili con Pro. Quelle già pronte sono gratuite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分だけのコレクションはProで作れます。用意されたコレクションは無料です。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕಸ್ಟಮ್ ಸಂಗ್ರಹಗಳು Pro ನಲ್ಲಿ ಲಭ್ಯ. ಸಿದ್ಧ ಸಂಗ್ರಹಗಳು ಉಚಿತ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나만의 모음은 Pro에서 만들 수 있어요. 기본 모음은 무료예요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇഷ്ടാനുസൃത ശേഖരങ്ങൾ Pro-യിൽ ലഭ്യമാണ്. തയ്യാറാക്കിയ ശേഖരങ്ങൾ സൗജന്യമാണ്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "स्वतःचे संग्रह Pro सह उपलब्ध आहेत. तयार संग्रह विनामूल्य आहेत."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Koleksi tersuai tersedia dengan Pro. Koleksi sedia ada adalah percuma."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Egne samlinger er tilgjengelige med Pro. Ferdige samlinger er gratis."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eigen verzamelingen zijn beschikbaar met Pro. Vooraf gemaakte verzamelingen zijn gratis."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ନିଜସ୍ୱ ସଂଗ୍ରହ Proରେ ଉପଲବ୍ଧ। ପ୍ରସ୍ତୁତ ସଂଗ୍ରହ ମାଗଣା।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਆਪਣੇ ਸੰਗ੍ਰਹਿ Pro ਨਾਲ ਉਪਲਬਧ ਹਨ। ਤਿਆਰ ਸੰਗ੍ਰਹਿ ਮੁਫ਼ਤ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Własne kolekcje są dostępne z Pro. Gotowe kolekcje są bezpłatne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coleções personalizadas estão disponíveis com o Pro. Coleções prontas são gratuitas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As coleções personalizadas estão disponíveis com Pro. As coleções preparadas são gratuitas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Colecțiile proprii sunt disponibile cu Pro. Colecțiile pregătite sunt gratuite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Свои подборки доступны с Pro. Готовые подборки бесплатны."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vlastné kolekcie sú dostupné s Pro. Pripravené kolekcie sú zadarmo."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lastne zbirke so na voljo s Pro. Pripravljene zbirke so brezplačne."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Egna samlingar finns med Pro. Färdiga samlingar är gratis."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தனிப்பயன் தொகுப்புகள் Pro-வில் கிடைக்கும். தயாரான தொகுப்புகள் இலவசம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అనుకూల కలెక్షన్‌లు Proలో అందుబాటులో ఉన్నాయి. సిద్ధంగా ఉన్న కలెక్షన్‌లు ఉచితం."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คอลเลกชันที่กำหนดเองใช้ได้กับ Pro คอลเลกชันสำเร็จรูปใช้ได้ฟรี"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendi koleksiyonlarını Pro ile oluşturabilirsin. Hazır koleksiyonlar ücretsizdir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Власні добірки доступні з Pro. Підготовлені добірки — безкоштовні."
