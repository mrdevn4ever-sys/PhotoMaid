            "state": "translated",
            "value": "Kasaya taşı: %1$lld"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перемістити до сейфа: %1$lld"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "والٹ میں بھیجیں: %1$lld"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển vào két sắt: %1$lld"
