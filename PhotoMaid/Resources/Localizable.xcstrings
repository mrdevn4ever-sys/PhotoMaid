    "limit_bonus_dismissed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُغلق الإعلان مبكرًا. لم يتم تفعيل أي ميزة. يمكنك المحاولة مرة أخرى اليوم."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Reklamen blev lukket for tidligt. Intet blev låst op. Du kan prøve igen i dag."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Werbung wurde vorzeitig geschlossen. Du hast keine Freischaltung erhalten und kannst es heute erneut versuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The ad was closed early. Nothing was unlocked. You can try again today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El anuncio se ha cerrado antes de terminar. No se ha desbloqueado nada. Puedes volver a intentarlo hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La publicité a été fermée trop tôt. Rien n’a été débloqué. Tu peux réessayer aujourd’hui."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Iklan ditutup lebih awal. Tidak ada yang dibuka. Kamu bisa mencoba lagi hari ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La pubblicità è stata chiusa prima della fine. Non è stato sbloccato nulla. Puoi riprovare oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "広告を途中で閉じたため、特典は適用されていません。今日もう一度試せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "광고를 일찍 닫아 혜택이 적용되지 않았어요. 오늘 다시 시도할 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Annonsen ble lukket for tidlig. Ingenting ble låst opp. Du kan prøve igjen i dag."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De advertentie is te vroeg gesloten. Er is niets ontgrendeld. Je kunt het vandaag opnieuw proberen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Reklama została zamknięta przed końcem. Nic nie odblokowano. Możesz spróbować jeszcze raz dzisiaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O anúncio foi fechado antes do fim. Nada foi desbloqueado. Você pode tentar de novo hoje."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O anúncio foi fechado antes de terminar. Nada foi desbloqueado. Podes tentar novamente hoje."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Reclama a fost închisă înainte de final. Nu s-a deblocat nimic. Poți încerca din nou azi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Реклама закрыта до завершения. Ничего не открыто. Сегодня можно попробовать ещё раз."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Annonsen stängdes i förtid. Inget låstes upp. Du kan försöka igen i dag."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โฆษณาถูกปิดก่อนจบ ไม่มีอะไรถูกปลดล็อก คุณลองอีกครั้งได้วันนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reklam erken kapatıldı. Hiçbir şey açılmadı. Bugün yeniden deneyebilirsin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рекламу закрито до завершення. Нічого не відкрито. Сьогодні можна спробувати ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quảng cáo bị đóng sớm. Chưa mở khóa gì. Bạn có thể thử lại hôm nay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "广告提前关闭，未解锁任何权益。今天仍可重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "廣告提早關閉，沒有解鎖任何內容。今天可以再試一次。"
          }
        }
      }
    },
    "limit_bonus_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرة يوميًا. المكافأة صالحة اليوم فقط."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Én gang om dagen. Bonussen gælder kun i dag."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmal täglich. Der Bonus gilt nur heute."
          }
        },
