    "col_save_where": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحفظ كصورة جديدة في „Pictures/PhotoMaid“. تبقى صورك كما هي."
          }
        },
        "de": {
          "stringUnit": {
