    "excl_add_footer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تظهر المجلدات المستبعدة ومجلداتها الفرعية في أي موجز أو عدد أو نظرة شهرية. تبقى القرارات التي اتخذتها محفوظة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgenommene Ordner und ihre Unterordner erscheinen in keinem Feed, keiner Zahl und keiner Monatsübersicht. Bereits getroffene Entscheidungen bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluded folders and their subfolders don’t appear in any feed, count or month overview. Decisions you already made are kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las carpetas excluidas y sus subcarpetas no aparecen en ningún feed, recuento ni resumen mensual. Las decisiones ya tomadas se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dossiers exclus et leurs sous-dossiers n’apparaissent dans aucun fil, aucun total ni aucun aperçu mensuel. Les décisions déjà prises sont conservées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le cartelle escluse e le loro sottocartelle non compaiono in nessun feed, conteggio o riepilogo mensile. Le decisioni già prese restano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "除外したフォルダとそのサブフォルダは、フィード、件数、月別の一覧に表示されません。すでに選んだ内容は保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제외한 폴더와 하위 폴더는 피드, 개수, 월별 보기에 나타나지 않아요. 이미 내린 선택은 유지돼요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uitgesloten mappen en hun submappen verschijnen in geen enkele feed, telling of maandoverzicht. Al gemaakte keuzes blijven bewaard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wykluczone foldery i ich podfoldery nie pojawiają się w żadnym przeglądzie, liczniku ani podsumowaniu miesięcy. Podjęte decyzje zostają zachowane."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As pastas excluídas e as suas subpastas não aparecem em nenhum feed, contagem ou resumo mensal. As decisões já tomadas mantêm-se."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosarele excluse și subdosarele lor nu apar în niciun flux, număr sau rezumat lunar. Deciziile deja luate rămân."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исключённые папки и их подпапки не появляются ни в ленте, ни в счётчиках, ни в обзоре по месяцам. Уже принятые решения сохраняются."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hariç tutulan klasörler ve alt klasörleri hiçbir akışta, sayıda veya aylık özette görünmez. Verdiğin kararlar korunur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виключені папки та їхні підпапки не з’являються ні в стрічці, ні в лічильниках, ні в огляді за місяцями. Уже ухвалені рішення зберігаються."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "被排除的文件夹及其子文件夹不会出现在任何浏览、数量或按月概览中。已做出的选择会保留。"
          }
        }
      }
    },
