    "pro2_active_sub": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم الشراء مرة واحدة: بلا إعلانات، بلا حد يومي، ومجلدات الخزنة بلا إعلانات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmal gekauft: ohne Werbung, ohne Tageslimit und Tresor-Ordner ohne Werbung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Purchased once: no ads, no daily limit and vault folders without ads."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprado una vez: sin anuncios, sin límite diario y carpetas de la caja fuerte sin anuncios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Acheté une fois : sans publicité, sans limite quotidienne et dossiers du coffre sans publicité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Acquistato una volta: senza pubblicità, senza limite giornaliero e cartelle della cassaforte senza pubblicità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度の購入で：広告なし、1日の上限なし、保管庫フォルダも広告なし。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번 구매: 광고 없음, 일일 한도 없음, 보관함 폴더도 광고 없이."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eenmalig gekocht: zonder advertenties, zonder daglimiet en kluismappen zonder advertenties."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kupione raz: bez reklam, bez dziennego limitu i foldery sejfu bez reklam."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprado uma vez: sem anúncios, sem limite diário e pastas do cofre sem anúncios."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cumpărat o dată: fără reclame, fără limită zilnică și dosare în seif fără reclame."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Куплено один раз: без рекламы, без дневного лимита и папки сейфа без рекламы."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kez satın alındı: reklamsız, günlük sınır yok ve kasa klasörleri reklamsız."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Куплено один раз: без реклами, без денного ліміту й теки сейфа без реклами."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次性购买：无广告、无每日上限，保险箱文件夹也无需看广告。"
          }
        }
      }
    },
    "pro2_f1d": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا إعلان عند فتح التطبيق ولا بطاقات إعلانية بين صورك ومقاطع الفيديو."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Werbung beim Öffnen der App und keine Werbekarten zwischen deinen Fotos und Videos."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No ad when you open the app and no ad cards between your photos and videos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin anuncio al abrir la app y sin tarjetas de anuncios entre tus fotos y vídeos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune publicité à l’ouverture de l’app ni carte publicitaire entre tes photos et vidéos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna pubblicità all’apertura dell’app e nessuna scheda pubblicitaria tra foto e video."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリ起動時の広告も、写真やビデオの間の広告カードもありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱을 열 때 광고가 없고 사진과 동영상 사이에 광고 카드도 없어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen advertentie bij het openen van de app en geen advertentiekaarten tussen je foto’s en video’s."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez reklamy przy otwieraniu aplikacji i bez kart reklamowych między zdjęciami i filmami."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem anúncio ao abrir a app e sem cartões de anúncio entre as tuas fotografias e vídeos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fără reclamă la deschiderea aplicației și fără carduri publicitare între poze și videoclipuri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без рекламы при запуске и без рекламных карточек между фото и видео."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamayı açarken reklam yok, fotoğraf ve videoların arasında reklam kartı yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Без реклами під час запуску й без рекламних карток між фото та відео."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 App 时没有广告，照片和视频之间也没有广告卡片。"
          }
        }
      }
    },
