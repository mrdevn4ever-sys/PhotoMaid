    "vault2_background_lock": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُقفل الخزنة دائمًا في الخلفية. تُحجب المعاينات عند تبديل التطبيقات."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Boksen låses altid i baggrunden. Eksempler skjules, når du skifter app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Wechsel in den Hintergrund wird der Tresor immer gesperrt. Vorschauen werden beim App-Wechsel verdeckt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The vault always locks in the background. Previews are covered when switching apps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La caja fuerte siempre se bloquea en segundo plano. Las vistas previas se ocultan al cambiar de app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le coffre se verrouille toujours en arrière-plan. Les aperçus sont masqués lors du changement d’app."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Brankas selalu terkunci di latar belakang. Pratinjau ditutupi saat berpindah app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cassaforte si blocca sempre in background. Le anteprime vengono coperte quando cambi app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックグラウンドでは必ずロックします。アプリ切り替え時のプレビューは覆われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백그라운드에서는 항상 잠깁니다. 앱 전환 시 미리보기가 가려집니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Safen låses alltid i bakgrunnen. Forhåndsvisninger skjules når du bytter app."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De kluis vergrendelt altijd op de achtergrond. Voorbeelden worden afgedekt bij het wisselen van app."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sejf zawsze blokuje się w tle. Podglądy są zasłaniane podczas przełączania aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cofre sempre se bloqueia em segundo plano. As prévias ficam cobertas ao trocar de app."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O cofre bloqueia sempre em segundo plano. As pré-visualizações ficam ocultas ao mudar de app."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Seiful se blochează întotdeauna în fundal. Previzualizările sunt acoperite când schimbi aplicația."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В фоне сейф всегда блокируется. При переключении приложений предпросмотр скрывается."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Valvet låses alltid i bakgrunden. Förhandsvisningar döljs när du byter app."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตู้เซฟจะล็อกเสมอเมื่ออยู่ในเบื้องหลัง ภาพตัวอย่างจะถูกปิดเมื่อสลับแอพ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasa arka planda her zaman kilitlenir. Uygulama değiştirirken önizlemeler gizlenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У фоні сховище завжди блокується. Під час перемикання програм попередній перегляд приховується."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Két sắt luôn khóa khi ở chế độ nền. Bản xem trước được che khi chuyển ứng dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保险库在后台始终锁定，切换应用时会遮盖预览。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保險箱在背景時一律鎖定。切換 App 時預覽會被遮蓋。"
          }
        }
      }
    },
