    "onb_safe_local": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى صورك على جهازك. بلا حساب PhotoMaid أو رفع للصور."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Fotos bleiben auf deinem Gerät. Kein PhotoMaid-Konto, kein Foto-Upload."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your photos stay on your device. No PhotoMaid account, no photo uploads."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus fotos se quedan en tu dispositivo. Sin cuenta de PhotoMaid ni subidas de fotos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes photos restent sur ton appareil. Sans compte PhotoMaid ni envoi de photos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue foto restano sul dispositivo. Nessun account PhotoMaid, nessun caricamento di foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真は端末内に残ります。PhotoMaidアカウントも写真のアップロードも不要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진은 기기에 남아요. PhotoMaid 계정도 사진 업로드도 필요 없어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je foto’s blijven op je apparaat. Geen PhotoMaid-account en geen foto-uploads."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdjęcia pozostają na urządzeniu. Bez konta PhotoMaid i wysyłania zdjęć."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As tuas fotos ficam no teu dispositivo. Sem conta PhotoMaid nem envio de fotos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografiile rămân pe dispozitivul tău. Fără cont PhotoMaid și fără încărcarea fotografiilor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото остаются на твоём устройстве. Без аккаунта PhotoMaid и загрузки фото на сервер."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğrafların cihazında kalır. PhotoMaid hesabı ve fotoğraf yüklemesi yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото залишаються на твоєму пристрої. Без облікового запису PhotoMaid і завантаження фото на сервер."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片留在设备上，无需 PhotoMaid 账号，也不上传照片。"
          }
        }
      }
    },
