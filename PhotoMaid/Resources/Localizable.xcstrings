          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans la corbeille Android, pas encore libéré : quand Android la videra, les fichiers occuperont %1$@ de moins."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "In the Android trash, not freed yet: once Android empties it, these files take up %1$@ less."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nel cestino di Android, non ancora liberato: quando Android lo svuota, i file occuperanno %1$@ in meno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Androidのゴミ箱にあり、まだ空いていません。Androidがゴミ箱を空にすると、ファイルの使用量が%1$@減ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 휴지통에 있으며 아직 확보되지 않았어요. Android가 휴지통을 비우면 파일이 %1$@ 덜 차지해요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "In the Android trash, not freed yet: once Android empties it, these files take up %1$@ less."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In de Android-prullenbak, nog niet vrij: zodra Android die leegt, nemen de bestanden %1$@ minder in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W koszu Androida, jeszcze nie zwolnione: gdy Android opróżni kosz, pliki zajmą o %1$@ mniej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "In the Android trash, not freed yet: once Android empties it, these files take up %1$@ less."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "No lixo do Android, ainda não libertado: quando o Android o esvaziar, os ficheiros ocupam menos %1$@."
