        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier Téléchargements ne peut pas être sélectionné ici. Choisis plutôt un sous-dossier à l’intérieur."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
