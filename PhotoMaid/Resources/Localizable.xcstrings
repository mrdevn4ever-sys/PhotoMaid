    "dup_how": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقارن GaleriQ محتوى الملفات على جهازك مباشرةً. الصور المتشابهة في الشكل ليست نسخًا متطابقة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ sammenligner filindholdet direkte på din enhed. Billeder, der ligner hinanden, tæller ikke som identiske kopier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ vergleicht die Dateiinhalte direkt auf deinem Gerät. Ähnlich aussehende Bilder zählen nicht als identische Kopien."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ compares file contents directly on your device. Similar-looking images don’t count as identical copies."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ compara el contenido de los archivos en tu dispositivo. Las imágenes parecidas no cuentan como copias idénticas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ compare le contenu des fichiers directement sur ton appareil. Les images qui se ressemblent ne comptent pas comme des copies identiques."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ membandingkan isi file langsung di perangkatmu. Gambar yang terlihat mirip tidak dihitung sebagai salinan identik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ confronta i contenuti dei file sul tuo dispositivo. Le immagini che si assomigliano non contano come copie identiche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQは端末内でファイルの内容を比較します。見た目が似ているだけの画像は、同じコピーとはみなしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ는 기기에서 파일 내용을 직접 비교해요. 비슷하게 보이기만 하는 이미지는 같은 사본으로 보지 않아요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ sammenligner filinnholdet direkte på enheten din. Bilder som ser like ut, regnes ikke som identiske kopier."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ vergelijkt bestandsinhoud op je apparaat. Afbeeldingen die op elkaar lijken, tellen niet als identieke kopieën."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ porównuje zawartość plików na urządzeniu. Podobnie wyglądające zdjęcia nie są uznawane za identyczne kopie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O GaleriQ compara o conteúdo dos arquivos diretamente no seu aparelho. Imagens parecidas não contam como cópias idênticas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O GaleriQ compara o conteúdo dos ficheiros no teu dispositivo. Imagens parecidas não contam como cópias idênticas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ compară conținutul fișierelor pe dispozitiv. Imaginile care seamănă nu sunt considerate copii identice."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ сравнивает содержимое файлов на устройстве. Похожие изображения не считаются одинаковыми копиями."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ jämför filinnehållet direkt på din enhet. Bilder som ser likadana ut räknas inte som identiska kopior."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ เปรียบเทียบเนื้อหาไฟล์บนอุปกรณ์ของคุณโดยตรง รูปที่ดูคล้ายกันไม่นับเป็นสำเนาที่เหมือนกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ dosya içeriklerini cihazında karşılaştırır. Benzer görünen resimler birebir aynı kopya sayılmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ порівнює вміст файлів на твоєму пристрої. Схожі зображення не вважаються ідентичними копіями."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ so sánh nội dung tệp ngay trên thiết bị của bạn. Ảnh trông giống nhau không được tính là bản sao giống hệt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ 直接在设备上比较文件内容。只是看起来相似的图片不算相同副本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ 直接在你的裝置上比較檔案內容。看起來相似的圖片不算相同的副本。"
          }
        }
      }
    },
    "dup_icloud_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحمّل النسخ الأصلية غير الموجودة عبر Wi-Fi. قد تستغرق المكتبات الكبيرة وقتًا وتستهلك بيانات كثيرة. يبحث في الوسائط المسموح بها والمجلدات المتصلة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Henter manglende originaler via Wi-Fi. Store biblioteker kan tage tid og bruge meget data. Søger i tilladte medier og forbundne mapper."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lädt fehlende Originale über WLAN. Große Mediatheken können viel Zeit und Daten benötigen. Durchsucht freigegebene Medien und verbundene Ordner."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads missing originals over Wi-Fi. Large libraries can take time and use a lot of data. Searches permitted media and connected folders."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarga los originales que faltan por Wi-Fi. Las bibliotecas grandes pueden tardar y consumir muchos datos. Busca en los medios autorizados y las carpetas conectadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Télécharge les originaux manquants par Wi-Fi. Les grandes photothèques peuvent prendre du temps et consommer beaucoup de données. Recherche dans les médias autorisés et les dossiers connectés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengunduh asli yang belum ada lewat Wi-Fi. Pustaka besar bisa butuh waktu dan banyak data. Mencari di media yang diizinkan dan folder tersambung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarica gli originali mancanti tramite Wi-Fi. Le librerie grandi possono richiedere tempo e molti dati. Cerca nei contenuti autorizzati e nelle cartelle collegate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "不足しているオリジナルをWi-Fiでダウンロードします。大きなライブラリでは時間と大量のデータ通信が必要になる場合があります。アクセスを許可したメディアと接続したフォルダを検索します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기에 없는 원본을 Wi-Fi로 다운로드합니다. 보관함이 크면 시간과 데이터가 많이 필요할 수 있습니다. 접근이 허용된 미디어와 연결된 폴더를 검색합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Laster ned manglende originaler via Wi-Fi. Store biblioteker kan ta tid og bruke mye data. Søker i tillatte medier og tilkoblede mapper."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloadt ontbrekende originelen via wifi. Grote bibliotheken kunnen veel tijd en data kosten. Doorzoekt toegestane media en gekoppelde mappen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobiera brakujące oryginały przez Wi-Fi. Duże biblioteki mogą wymagać czasu i wielu danych. Przeszukuje udostępnione multimedia i połączone foldery."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixa originais ausentes via Wi-Fi. Bibliotecas grandes podem demorar e usar muitos dados. Busca nas mídias permitidas e nas pastas conectadas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarrega os originais em falta por Wi-Fi. Bibliotecas grandes podem demorar e consumir muitos dados. Pesquisa conteúdos autorizados e pastas ligadas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarcă originalele lipsă prin Wi-Fi. Bibliotecile mari pot necesita timp și multe date. Caută în conținutul permis și în dosarele conectate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загружает недостающие оригиналы по Wi-Fi. Для большой медиатеки может потребоваться много времени и трафика. Поиск выполняется в разрешённых медиафайлах и подключённых папках."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hämtar saknade original via wifi. Stora bibliotek kan ta tid och använda mycket data. Söker i tillåtna medier och anslutna mappar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดาวน์โหลดต้นฉบับที่ขาดหายผ่าน Wi-Fi คลังขนาดใหญ่อาจใช้เวลาและข้อมูลมาก ค้นหาในสื่อที่อนุญาตและโฟลเดอร์ที่เชื่อมต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksik özgünleri Wi-Fi üzerinden indirir. Büyük arşivler zaman ve çok miktarda veri gerektirebilir. İzin verilen ortamları ve bağlı klasörleri arar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завантажує відсутні оригінали через Wi-Fi. Великі медіатеки можуть потребувати багато часу й трафіку. Шукає в дозволених медіафайлах і підключених папках."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tải bản gốc còn thiếu qua Wi-Fi. Thư viện lớn có thể mất thời gian và tốn nhiều dữ liệu. Tìm trong phương tiện được phép và thư mục đã kết nối."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过无线局域网下载缺失的原片。大型图库可能需要较长时间并消耗大量流量。搜索已授权的媒体和已连接的文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過 Wi-Fi 下載缺少的原始檔。大型圖庫可能需要一些時間並使用大量數據。會搜尋允許的媒體和已連接的檔案夾。"
          }
        }
      }
    },
