    "tools_convert_intro": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحفظ الصور بصيغة ملف أخرى، مثل HEIC بصيغة JPEG للأجهزة التي لا تفتح HEIC."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফটো অন্য ফাইল ফরম্যাটে সংরক্ষণ করে, যেমন HEIC-কে JPEG হিসেবে, যেসব ডিভাইস HEIC খুলতে পারে না তাদের জন্য।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Desa fotos en un altre format de fitxer, p. ex. HEIC com a JPEG per a dispositius que no obren HEIC."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uloží fotky v jiném formátu souboru, např. HEIC jako JPEG pro zařízení, která HEIC neotevřou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemmer fotos i et andet filformat, f.eks. HEIC som JPEG til enheder, der ikke kan åbne HEIC."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichert Fotos in einem anderen Dateiformat, z. B. HEIC als JPEG für Geräte, die HEIC nicht öffnen können."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αποθηκεύει φωτογραφίες σε άλλη μορφή αρχείου, π.χ. HEIC ως JPEG για συσκευές που δεν ανοίγουν HEIC."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves photos in another file format, e.g. HEIC as JPEG for devices that can’t open HEIC."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda las fotos en otro formato de archivo, p. ej. HEIC como JPEG para dispositivos que no abren HEIC."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallentaa kuvat toisessa tiedostomuodossa, esim. HEIC JPEG:nä laitteille, jotka eivät avaa HEIC-tiedostoja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre les photos dans un autre format de fichier, p. ex. HEIC en JPEG pour les appareils qui n’ouvrent pas le HEIC."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફોટાને બીજા ફાઇલ ફૉર્મેટમાં સાચવે છે, દા.ત. HEIC ન ખોલી શકે તેવાં ઉપકરણો માટે HEIC ને JPEG તરીકે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שומר תמונות בתבנית קובץ אחרת, למשל HEIC כ-JPEG למכשירים שלא פותחים HEIC."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोटो को दूसरे फ़ाइल फ़ॉर्मेट में सहेजता है, जैसे HEIC न खोल पाने वाले डिवाइस के लिए HEIC को JPEG के रूप में।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprema fotografije u drugom formatu datoteke, npr. HEIC kao JPEG za uređaje koji ne mogu otvoriti HEIC."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Más fájlformátumban menti a fotókat, pl. HEIC-et JPEG-ként a HEIC-et megnyitni nem tudó eszközökhöz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyimpan foto dalam format file lain, misalnya HEIC sebagai JPEG untuk perangkat yang tidak bisa membuka HEIC."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva le foto in un altro formato di file, ad es. HEIC come JPEG per i dispositivi che non aprono HEIC."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真を別のファイル形式で保存します。例：HEICを開けない機器向けにHEICをJPEGに。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಫೋಟೋಗಳನ್ನು ಬೇರೆ ಫೈಲ್ ಸ್ವರೂಪದಲ್ಲಿ ಉಳಿಸುತ್ತದೆ, ಉದಾ. HEIC ತೆರೆಯಲಾಗದ ಸಾಧನಗಳಿಗಾಗಿ HEIC ಅನ್ನು JPEG ಆಗಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진을 다른 파일 형식으로 저장해요. 예: HEIC를 열 수 없는 기기를 위해 JPEG로."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഫോട്ടോകൾ മറ്റൊരു ഫയൽ ഫോർമാറ്റിൽ സംരക്ഷിക്കുന്നു, ഉദാ. HEIC തുറക്കാനാകാത്ത ഉപകരണങ്ങൾക്കായി HEIC-നെ JPEG ആയി."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फोटो दुसऱ्या फाइल फॉरमॅटमध्ये जतन करते, उदा. HEIC उघडू न शकणाऱ्या डिव्हाइससाठी HEIC ला JPEG म्हणून."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyimpan foto dalam format fail lain, cth. HEIC sebagai JPEG untuk peranti yang tidak dapat membuka HEIC."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagrer bilder i et annet filformat, f.eks. HEIC som JPEG for enheter som ikke kan åpne HEIC."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaart foto’s in een ander bestandsformaat, bijv. HEIC als JPEG voor apparaten die HEIC niet openen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଫଟୋକୁ ଅନ୍ୟ ଫାଇଲ୍ ଫର୍ମାଟ୍‌ରେ ସେଭ୍ କରେ, ଯେପରି HEIC ଖୋଲିପାରୁନଥିବା ଡିଭାଇସ୍ ପାଇଁ HEICକୁ JPEG ଭାବେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਫ਼ੋਟੋਆਂ ਨੂੰ ਕਿਸੇ ਹੋਰ ਫ਼ਾਈਲ ਫ਼ਾਰਮੈਟ ਵਿੱਚ ਸੰਭਾਲਦਾ ਹੈ, ਜਿਵੇਂ HEIC ਨੂੰ JPEG ਵਜੋਂ, ਉਨ੍ਹਾਂ ਡਿਵਾਈਸਾਂ ਲਈ ਜੋ HEIC ਨਹੀਂ ਖੋਲ੍ਹ ਸਕਦੇ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisuje zdjęcia w innym formacie pliku, np. HEIC jako JPEG dla urządzeń, które nie otwierają HEIC."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva fotos em outro formato de arquivo, por exemplo HEIC como JPEG para aparelhos que não abrem HEIC."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda as fotografias noutro formato de ficheiro, p. ex. HEIC como JPEG para dispositivos que não abrem HEIC."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvează fotografiile în alt format de fișier, de ex. HEIC ca JPEG pentru dispozitivele care nu deschid HEIC."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняет фото в другом формате, например HEIC как JPEG для устройств, которые не открывают HEIC."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Uloží fotky v inom formáte súboru, napr. HEIC ako JPEG pre zariadenia, ktoré HEIC neotvoria."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Shrani fotografije v drugi obliki datoteke, npr. HEIC kot JPEG za naprave, ki ne odprejo HEIC."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparar bilder i ett annat filformat, t.ex. HEIC som JPEG för enheter som inte kan öppna HEIC."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "புகைப்படங்களை வேறொரு கோப்பு வடிவத்தில் சேமிக்கிறது, எ.கா. HEIC-ஐத் திறக்க முடியாத சாதனங்களுக்காக HEIC-ஐ JPEG ஆக."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫోటోలను వేరే ఫైల్ ఫార్మాట్‌లో సేవ్ చేస్తుంది, ఉదా. HEIC తెరవలేని పరికరాల కోసం HEICను JPEGగా."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกรูปในรูปแบบไฟล์อื่น เช่น HEIC เป็น JPEG สำหรับอุปกรณ์ที่เปิด HEIC ไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğrafları başka bir dosya biçiminde kaydeder; örneğin HEIC açamayan cihazlar için HEIC’i JPEG olarak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберігає фото в іншому форматі, наприклад HEIC як JPEG для пристроїв, які не відкривають HEIC."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تصاویر کو دوسرے فائل فارمیٹ میں محفوظ کرتا ہے، مثلاً HEIC نہ کھولنے والی ڈیوائسز کے لیے HEIC کو JPEG کے طور پر۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu ảnh ở định dạng tệp khác, ví dụ HEIC thành JPEG cho thiết bị không mở được HEIC."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将照片存储为其他文件格式，例如为无法打开 HEIC 的设备将 HEIC 转为 JPEG。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將照片儲存為其他檔案格式，例如將 HEIC 轉成 JPEG，供無法打開 HEIC 的裝置使用。"
          }
        }
      }
    },
    "tools_convert_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل الأجهزة تفتح JPEG. يحتفظ PNG بكل التفاصيل لكن الملفات تصبح أكبر. تُتخطّى الصور التي بهذا التنسيق أصلًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটি ডিভাইস JPEG খোলে। PNG প্রতিটি খুঁটিনাটি রাখে, কিন্তু ফাইল বড় হয়। যে ফটো আগে থেকেই এই ফরম্যাটে আছে সেগুলো বাদ যায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tots els dispositius obren JPEG. PNG conserva tots els detalls, però els fitxers són més grans. Les fotos que ja tenen aquest format s’ometen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "JPEG otevře každé zařízení. PNG zachová každý detail, ale soubory jsou větší. Fotky, které už jsou v tomto formátu, se přeskočí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle enheder kan åbne JPEG. PNG bevarer alle detaljer, men filerne bliver større. Fotos, der allerede har dette format, springes over."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JPEG öffnet jedes Gerät. PNG verliert keine Details, die Dateien werden aber größer. Fotos, die schon dieses Format haben, werden übersprungen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε συσκευή ανοίγει JPEG. Το PNG κρατά κάθε λεπτομέρεια, αλλά τα αρχεία μεγαλώνουν. Φωτογραφίες που είναι ήδη σε αυτή τη μορφή παραλείπονται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every device opens JPEG. PNG keeps every detail, but files get bigger. Photos already in this format are skipped."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquier dispositivo abre JPEG. PNG conserva todos los detalles, pero los archivos son más grandes. Las fotos que ya tienen este formato se omiten."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokainen laite avaa JPEG:n. PNG säilyttää kaikki yksityiskohdat, mutta tiedostot ovat suurempia. Jo tässä muodossa olevat kuvat ohitetaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les appareils ouvrent le JPEG. Le PNG garde tous les détails, mais les fichiers sont plus gros. Les photos déjà dans ce format sont ignorées."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "દરેક ઉપકરણ JPEG ખોલે છે. PNG દરેક વિગત રાખે છે, પણ ફાઇલો મોટી થાય છે. પહેલેથી આ ફૉર્મેટવાળા ફોટા છોડી દેવાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל מכשיר פותח JPEG. ‏PNG שומר כל פרט, אבל הקבצים גדלים. תמונות שכבר בתבנית הזו מדולגות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर डिवाइस JPEG खोलता है। PNG हर बारीकी रखता है, लेकिन फ़ाइलें बड़ी होती हैं। पहले से इस फ़ॉर्मेट वाली फ़ोटो छोड़ दी जाती हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaki uređaj otvara JPEG. PNG čuva svaki detalj, ali datoteke su veće. Fotografije koje su već u ovom formatu preskaču se."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A JPEG-et minden eszköz megnyitja. A PNG minden részletet megőriz, de nagyobbak a fájlok. A már ilyen formátumú fotók kimaradnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua perangkat bisa membuka JPEG. PNG mempertahankan semua detail, tapi file jadi lebih besar. Foto yang sudah dalam format ini dilewati."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni dispositivo apre i JPEG. PNG conserva tutti i dettagli, ma i file diventano più grandi. Le foto già in questo formato vengono saltate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "JPEG はどの端末でも開けます。PNG は細部まで残りますが、ファイルが大きくなります。すでにこの形式の写真はスキップします。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪ್ರತಿ ಸಾಧನವೂ JPEG ತೆರೆಯುತ್ತದೆ. PNG ಪ್ರತಿ ವಿವರವನ್ನೂ ಇರಿಸುತ್ತದೆ, ಆದರೆ ಫೈಲ್‌ಗಳು ದೊಡ್ಡದಾಗುತ್ತವೆ. ಈಗಾಗಲೇ ಈ ಸ್ವರೂಪದಲ್ಲಿರುವ ಫೋಟೋಗಳನ್ನು ಬಿಡಲಾಗುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "JPEG는 어느 기기에서나 열려요. PNG는 세부까지 그대로지만 파일이 커져요. 이미 이 형식인 사진은 건너뛰어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എല്ലാ ഉപകരണങ്ങളും JPEG തുറക്കും. PNG ഓരോ വിശദാംശവും നിലനിർത്തുന്നു, പക്ഷേ ഫയലുകൾ വലുതാകും. ഇതിനകം ഈ ഫോർമാറ്റിലുള്ള ഫോട്ടോകൾ ഒഴിവാക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्येक डिव्हाइस JPEG उघडते. PNG प्रत्येक तपशील ठेवते, पण फाइल्स मोठ्या होतात. आधीच या फॉरमॅटमधील फोटो वगळले जातात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap peranti membuka JPEG. PNG mengekalkan setiap perincian, tetapi fail menjadi lebih besar. Foto yang sudah dalam format ini dilangkau."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle enheter kan åpne JPEG. PNG beholder alle detaljer, men filene blir større. Bilder som allerede har dette formatet, hoppes over."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elk apparaat opent JPEG. PNG behoudt alle details, maar bestanden worden groter. Foto’s die al dit formaat hebben, worden overgeslagen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପ୍ରତ୍ୟେକ ଡିଭାଇସ୍ JPEG ଖୋଲେ। PNG ପ୍ରତ୍ୟେକ ବିବରଣୀ ରଖେ, କିନ୍ତୁ ଫାଇଲ୍ ବଡ଼ ହୁଏ। ପୂର୍ବରୁ ଏହି ଫର୍ମାଟ୍‌ରେ ଥିବା ଫଟୋ ବାଦ ଦିଆଯାଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹਰ ਡਿਵਾਈਸ JPEG ਖੋਲ੍ਹਦਾ ਹੈ। PNG ਹਰ ਵੇਰਵਾ ਰੱਖਦਾ ਹੈ, ਪਰ ਫ਼ਾਈਲਾਂ ਵੱਡੀਆਂ ਹੋ ਜਾਂਦੀਆਂ ਹਨ। ਜੋ ਫ਼ੋਟੋਆਂ ਪਹਿਲਾਂ ਹੀ ਇਸ ਫ਼ਾਰਮੈਟ ਵਿੱਚ ਹਨ, ਉਹ ਛੱਡ ਦਿੱਤੀਆਂ ਜਾਂਦੀਆਂ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każde urządzenie otworzy JPEG. PNG zachowuje wszystkie szczegóły, ale pliki są większe. Zdjęcia już w tym formacie są pomijane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo aparelho abre JPEG. PNG mantém todos os detalhes, mas os arquivos ficam maiores. Fotos que já estão nesse formato são puladas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualquer dispositivo abre JPEG. PNG mantém todos os detalhes, mas os ficheiros ficam maiores. As fotos já neste formato são ignoradas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Orice dispozitiv deschide JPEG. PNG păstrează toate detaliile, dar fișierele sunt mai mari. Fotografiile care au deja acest format sunt omise."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "JPEG открывается на любом устройстве. PNG сохраняет все детали, но файлы больше. Фото, которые уже в этом формате, пропускаются."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "JPEG otvorí každé zariadenie. PNG zachová každý detail, ale súbory sú väčšie. Fotky, ktoré už sú v tomto formáte, sa preskočia."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "JPEG odpre vsaka naprava. PNG ohrani vsako podrobnost, a datoteke so večje. Fotografije, ki so že v tej obliki, se preskočijo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla enheter kan öppna JPEG. PNG behåller alla detaljer, men filerna blir större. Bilder som redan har det här formatet hoppas över."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எல்லாச் சாதனங்களும் JPEG-ஐத் திறக்கும். PNG ஒவ்வொரு விவரத்தையும் வைத்திருக்கும், ஆனால் கோப்புகள் பெரிதாகும். ஏற்கனவே இந்த வடிவத்தில் உள்ள புகைப்படங்கள் தவிர்க்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రతి పరికరం JPEG తెరుస్తుంది. PNG ప్రతి వివరాన్ని ఉంచుతుంది, కానీ ఫైళ్లు పెద్దవవుతాయి. ఇప్పటికే ఈ ఫార్మాట్‌లో ఉన్న ఫోటోలను వదిలేస్తారు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกอุปกรณ์เปิด JPEG ได้ PNG เก็บทุกรายละเอียดแต่ไฟล์ใหญ่ขึ้น รูปที่อยู่ในรูปแบบนี้แล้วจะถูกข้าม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "JPEG’i her cihaz açar. PNG tüm ayrıntıları korur ama dosyalar büyür. Zaten bu biçimde olan fotoğraflar atlanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "JPEG відкривається на будь-якому пристрої. PNG зберігає всі деталі, але файли більші. Фото, які вже в цьому форматі, пропускаються."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر ڈیوائس JPEG کھولتی ہے۔ PNG ہر تفصیل رکھتا ہے، لیکن فائلیں بڑی ہوتی ہیں۔ پہلے سے اس فارمیٹ والی تصاویر چھوڑ دی جاتی ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi thiết bị đều mở được JPEG. PNG giữ mọi chi tiết nhưng tệp lớn hơn. Ảnh đã ở định dạng này sẽ bị bỏ qua."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有设备都能打开 JPEG。PNG 保留所有细节，但文件更大。已是该格式的照片会被跳过。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有裝置都能打開 JPEG。PNG 保留所有細節，但檔案較大。已經是此格式的照片會略過。"
          }
        }
      }
    },
