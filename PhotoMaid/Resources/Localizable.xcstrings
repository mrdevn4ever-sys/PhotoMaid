    "tour_grid_select_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر على الصور لتحديدها. اضغط مطولًا واسحب لتحديد نطاق كامل."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tap photos to select them. Long-press and drag to select a whole range."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf Bilder, um sie auszuwählen. Lange drücken und ziehen wählt einen ganzen Bereich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap photos to select them. Long-press and drag to select a whole range."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca fotos para seleccionarlas. Mantén pulsado y arrastra para elegir un rango."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche des photos pour les sélectionner. Appuie longuement et fais glisser pour choisir toute une plage."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tap photos to select them. Long-press and drag to select a whole range."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca le foto per selezionarle. Tieni premuto e trascina per scegliere un intervallo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真をタップして選択。長押ししてドラッグすると範囲を選択できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진을 탭해 선택해요. 길게 누른 채 드래그하면 범위를 선택해요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
