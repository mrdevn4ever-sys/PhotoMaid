    "tools_resize_intro": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يصغّر الصور بالبكسل وحجم الملف. مفيد للإرسال أو الرفع."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফটো ছোট করে – পিক্সেলে ও ফাইলের আকারে। পাঠানো বা আপলোডের জন্য সুবিধাজনক।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fa les fotos més petites, en píxels i en mida de fitxer. Pràctic per enviar o penjar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmenší fotky – v pixelech i velikosti souboru. Praktické pro odesílání nebo nahrávání."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gør fotos mindre – i pixels og filstørrelse. Praktisk til at sende eller uploade."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Macht Fotos kleiner – in Pixeln und Dateigröße. Praktisch zum Verschicken oder Hochladen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μικραίνει τις φωτογραφίες – σε pixel και μέγεθος αρχείου. Χρήσιμο για αποστολή ή ανέβασμα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Makes photos smaller – in pixels and file size. Handy for sending or uploading."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduce las fotos en píxeles y tamaño de archivo. Útil para enviarlas o subirlas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pienentää kuvia – pikseleissä ja tiedostokoossa. Kätevä lähettämiseen tai lataamiseen verkkoon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réduit les photos en pixels et en taille de fichier. Pratique pour les envoyer ou les mettre en ligne."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફોટા નાના કરે છે – પિક્સેલ અને ફાઇલ કદ બંનેમાં. મોકલવા કે અપલોડ કરવા ઉપયોગી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מקטין תמונות – בפיקסלים ובגודל הקובץ. שימושי לשליחה או להעלאה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोटो छोटी करता है – पिक्सेल और फ़ाइल साइज़ दोनों में। भेजने या अपलोड करने के लिए उपयोगी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Smanjuje fotografije – u pikselima i veličini datoteke. Praktično za slanje ili prijenos."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kicsinyíti a fotókat – pixelben és fájlméretben. Küldéshez vagy feltöltéshez praktikus."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memperkecil foto – dalam piksel dan ukuran file. Praktis untuk dikirim atau diunggah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riduce le foto in pixel e dimensione del file. Utile per inviarle o caricarle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真をピクセル数とファイルサイズの両方で小さくします。送信やアップロードに便利です。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಫೋಟೋಗಳನ್ನು ಚಿಕ್ಕದಾಗಿಸುತ್ತದೆ – ಪಿಕ್ಸೆಲ್‌ಗಳಲ್ಲಿ ಮತ್ತು ಫೈಲ್ ಗಾತ್ರದಲ್ಲಿ. ಕಳುಹಿಸಲು ಅಥವಾ ಅಪ್‌ಲೋಡ್ ಮಾಡಲು ಅನುಕೂಲಕರ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진의 픽셀 수와 파일 크기를 줄여요. 보내거나 업로드할 때 유용해요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഫോട്ടോകൾ ചെറുതാക്കുന്നു – പിക്സലുകളിലും ഫയൽ വലുപ്പത്തിലും. അയയ്ക്കാനോ അപ്‌ലോഡ് ചെയ്യാനോ സൗകര്യപ്രദം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फोटो लहान करते – पिक्सेल आणि फाइल आकार दोन्हीमध्ये. पाठवण्यासाठी किंवा अपलोड करण्यासाठी उपयुक्त."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengecilkan foto – dalam piksel dan saiz fail. Berguna untuk dihantar atau dimuat naik."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjør bilder mindre – i piksler og filstørrelse. Praktisk for sending eller opplasting."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maakt foto’s kleiner – in pixels en bestandsgrootte. Handig om te versturen of te uploaden."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଫଟୋକୁ ଛୋଟ କରେ – ପିକ୍ସେଲ୍ ଓ ଫାଇଲ୍ ଆକାରରେ। ପଠାଇବା କିମ୍ବା ଅପଲୋଡ୍ ପାଇଁ ସୁବିଧାଜନକ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਫ਼ੋਟੋਆਂ ਨੂੰ ਛੋਟਾ ਕਰਦਾ ਹੈ – ਪਿਕਸਲਾਂ ਅਤੇ ਫ਼ਾਈਲ ਆਕਾਰ ਵਿੱਚ। ਭੇਜਣ ਜਾਂ ਅੱਪਲੋਡ ਕਰਨ ਲਈ ਸੌਖਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmniejsza zdjęcia – w pikselach i rozmiarze pliku. Przydatne do wysyłania i przesyłania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduz fotos – em pixels e em tamanho de arquivo. Prático para enviar ou fazer upload."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduz as fotografias em píxeis e tamanho de ficheiro. Útil para enviar ou carregar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Micșorează fotografiile – în pixeli și dimensiunea fișierului. Util pentru trimis sau încărcat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уменьшает фото по пикселям и размеру файла. Удобно для отправки или загрузки."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmenší fotky – v pixeloch aj veľkosti súboru. Praktické na odosielanie alebo nahrávanie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomanjša fotografije – v slikovnih pikah in velikosti datoteke. Priročno za pošiljanje ali nalaganje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gör bilder mindre – i pixlar och filstorlek. Praktiskt för att skicka eller ladda upp."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "புகைப்படங்களைச் சிறிதாக்குகிறது – பிக்சல்களிலும் கோப்பு அளவிலும். அனுப்ப அல்லது பதிவேற்ற வசதியானது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫోటోలను చిన్నవి చేస్తుంది – పిక్సెల్‌లలో, ఫైల్ పరిమాణంలో. పంపడానికి లేదా అప్‌లోడ్ చేయడానికి సౌకర్యంగా ఉంటుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ย่อรูปให้เล็กลง – ทั้งพิกเซลและขนาดไฟล์ สะดวกสำหรับส่งหรืออัปโหลด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğrafları piksel ve dosya boyutu olarak küçültür. Göndermek veya yüklemek için kullanışlıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зменшує фото за пікселями й розміром файлу. Зручно для надсилання чи завантаження."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تصاویر چھوٹی کرتا ہے – پکسلز اور فائل سائز دونوں میں۔ بھیجنے یا اپ لوڈ کرنے کے لیے مفید۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thu nhỏ ảnh – cả số điểm ảnh lẫn kích thước tệp. Tiện để gửi hoặc tải lên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缩小照片的像素和文件大小，便于发送或上传。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "縮小照片 – 像素和檔案大小都變小。方便傳送或上傳。"
          }
        }
      }
    },
    "tools_resize_sub": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صور كثيرة دفعة واحدة، كنسخ جديدة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একসাথে অনেক ফটো, নতুন কপি হিসেবে"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Moltes fotos alhora, com a còpies noves"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mnoho fotek najednou, jako nové kopie"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mange fotos på én gang, som nye kopier"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Viele Fotos auf einmal, als neue Kopien"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πολλές φωτογραφίες μαζί, ως νέα αντίγραφα"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Many photos at once, as new copies"
          }
        },
