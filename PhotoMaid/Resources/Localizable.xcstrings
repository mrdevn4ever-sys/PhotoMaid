        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuă pentru scurt timp în fundal"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ненадолго продолжать в фоне"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Krátko pokračovať na pozadí"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kratko nadaljuj v ozadju"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsätt en kort stund i bakgrunden"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சிறிது நேரம் பின்னணியில் தொடருங்கள்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కొంతసేపు బ్యాక్‌గ్రౌండ్‌లో కొనసాగించండి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำงานต่อในเบื้องหลังสักครู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arka planda kısa süre devam et"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ненадовго продовжувати у фоні"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پس منظر میں تھوڑی دیر جاری رکھیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiếp tục một lúc trong nền"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在后台短暂继续"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在背景短暫繼續"
          }
        }
      }
    },
    "ana2_background_silent_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم GaleriQ وقت الخلفية الذي يسمح به iOS دون بطاقة نشاط للنظام. عند انتهاء الوقت يُحفظ التقدم ويستأنف التحليل عند فتح التطبيق."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ সিস্টেম অ্যাক্টিভিটি কার্ড ছাড়াই iOS-এর অনুমোদিত ব্যাকগ্রাউন্ড সময় ব্যবহার করে। সময় শেষ হলে অগ্রগতি সংরক্ষিত থাকে এবং অ্যাপ আবার খুললে বিশ্লেষণ চলতে থাকে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ fa servir el temps en segon pla que permet l’iOS, sense cap targeta d’activitat del sistema. Si s’acaba el temps, el progrés queda desat i l’anàlisi continua quan tornes a obrir l’app."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ využívá čas na pozadí, který iOS povoluje, bez systémové karty aktivity. Pokud čas vyprší, postup zůstane uložen a analýza pokračuje, až aplikaci znovu otevřete."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ bruger den baggrundstid, iOS tillader, uden et systemaktivitetskort. Hvis tiden løber ud, gemmes forløbet, og analysen fortsætter, når du åbner appen igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ nutzt die von iOS erlaubte Hintergrundzeit ohne Systemanzeige. Läuft die Zeit ab, bleibt der Fortschritt gespeichert. Beim Öffnen der App geht es automatisch weiter."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το GaleriQ χρησιμοποιεί τον χρόνο παρασκηνίου που επιτρέπει το iOS, χωρίς κάρτα δραστηριότητας συστήματος. Αν τελειώσει ο χρόνος, η πρόοδος αποθηκεύεται και η ανάλυση συνεχίζεται όταν ανοίξεις ξανά την εφαρμογή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ uses the background time allowed by iOS without a system activity card. If time runs out, progress stays saved and analysis resumes when you reopen the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ usa el tiempo en segundo plano permitido por iOS sin una tarjeta del sistema. Al agotarse, se guarda el progreso y el análisis continúa al abrir la app."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ käyttää iOS:n sallimaa taustaaikaa ilman järjestelmän toimintakorttia. Jos aika loppuu, edistyminen tallentuu ja analyysi jatkuu, kun avaat apin uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ utilise le temps d’arrière-plan accordé par iOS sans carte système. À son expiration, la progression est conservée et l’analyse reprend à la réouverture."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ સિસ્ટમ પ્રવૃત્તિ કાર્ડ વિના iOS એ મંજૂર કરેલો પૃષ્ઠભૂમિ સમય વાપરે છે. સમય પૂરો થાય તો પ્રગતિ સાચવેલી રહે છે, અને ઍપ ફરી ખોલતાં વિશ્લેષણ ચાલુ રહે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ משתמשת בזמן הרקע ש-iOS מאפשר, בלי כרטיס פעילות של המערכת. אם הזמן נגמר, ההתקדמות נשמרת והניתוח ממשיך כשפותחים שוב את היישום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ सिस्टम गतिविधि कार्ड के बिना iOS द्वारा अनुमत बैकग्राउंड समय का उपयोग करता है। समय खत्म होने पर प्रगति सहेजी रहती है, और ऐप दोबारा खोलने पर विश्लेषण आगे चलता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ koristi vrijeme u pozadini koje dopušta iOS, bez kartice aktivnosti sustava. Ako vrijeme istekne, napredak ostaje spremljen, a analiza se nastavlja kad ponovno otvoriš aplikaciju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A GaleriQ az iOS által engedélyezett háttéridőt használja, rendszerszintű tevékenységkártya nélkül. Ha lejár az idő, a haladás mentve marad, és az elemzés az app újbóli megnyitásakor folytatódik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ memakai waktu latar belakang yang diizinkan iOS tanpa kartu aktivitas sistem. Jika waktunya habis, kemajuan tetap tersimpan dan analisis berlanjut saat kamu membuka app lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ usa il tempo in background consentito da iOS senza schede di sistema. Alla scadenza, i progressi restano salvati e l’analisi riprende riaprendo l’app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOSが許可するバックグラウンド時間を使用し、システムのアクティビティは表示しません。時間切れでも進捗は保存され、アプリを開くと解析が再開します。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ಸಿಸ್ಟಮ್ ಚಟುವಟಿಕೆ ಕಾರ್ಡ್ ಇಲ್ಲದೆ iOS ಅನುಮತಿಸುವ ಹಿನ್ನೆಲೆ ಸಮಯವನ್ನು ಬಳಸುತ್ತದೆ. ಸಮಯ ಮುಗಿದರೆ ಪ್ರಗತಿ ಉಳಿದಿರುತ್ತದೆ ಮತ್ತು ಆ್ಯಪ್ ಮತ್ತೆ ತೆರೆದಾಗ ವಿಶ್ಲೇಷಣೆ ಮುಂದುವರಿಯುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 활동 카드 없이 iOS가 허용하는 백그라운드 시간을 사용합니다. 시간이 끝나면 진행 상황을 저장하고 앱을 다시 열 때 분석을 재개합니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സിസ്റ്റം ആക്റ്റിവിറ്റി കാർഡില്ലാതെ iOS അനുവദിക്കുന്ന പശ്ചാത്തല സമയം GaleriQ ഉപയോഗിക്കുന്നു. സമയം തീർന്നാൽ പുരോഗതി സംരക്ഷിക്കപ്പെടും, ആപ്പ് വീണ്ടും തുറക്കുമ്പോൾ വിശകലനം തുടരും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ सिस्टम ॲक्टिव्हिटी कार्डशिवाय iOS ने परवानगी दिलेला पार्श्वभूमी वेळ वापरते. वेळ संपल्यास प्रगती जतन राहते आणि अ‍ॅप पुन्हा उघडल्यावर विश्लेषण सुरू राहते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ menggunakan masa latar belakang yang dibenarkan oleh iOS tanpa kad aktiviti sistem. Jika masa tamat, kemajuan kekal disimpan dan analisis diteruskan apabila anda membuka semula app."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ bruker bakgrunnstiden iOS tillater, uten et aktivitetskort fra systemet. Hvis tiden går ut, lagres fremdriften, og analysen fortsetter når du åpner appen igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ gebruikt de door iOS toegestane achtergrondtijd zonder systeemkaart. Als de tijd op is, blijft de voortgang bewaard en gaat de analyse verder als je de app opent."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ସିଷ୍ଟମ୍ କାର୍ଯ୍ୟକଳାପ କାର୍ଡ ବିନା iOS ଅନୁମତି ଦେଉଥିବା ପୃଷ୍ଠଭୂମି ସମୟ ବ୍ୟବହାର କରେ। ସମୟ ସରିଗଲେ ପ୍ରଗତି ସେଭ୍ ରହେ ଏବଂ ଆପ୍ ପୁଣି ଖୋଲିଲେ ବିଶ୍ଳେଷଣ ଜାରି ରହେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ਸਿਸਟਮ ਸਰਗਰਮੀ ਕਾਰਡ ਤੋਂ ਬਿਨਾਂ iOS ਵੱਲੋਂ ਮਨਜ਼ੂਰ ਬੈਕਗ੍ਰਾਊਂਡ ਸਮਾਂ ਵਰਤਦਾ ਹੈ। ਸਮਾਂ ਖ਼ਤਮ ਹੋਣ ਉੱਤੇ ਤਰੱਕੀ ਸੰਭਾਲੀ ਰਹਿੰਦੀ ਹੈ, ਅਤੇ ਐਪ ਦੁਬਾਰਾ ਖੋਲ੍ਹਣ ਉੱਤੇ ਵਿਸ਼ਲੇਸ਼ਣ ਜਾਰੀ ਰਹਿੰਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ korzysta z czasu w tle przyznanego przez iOS bez karty systemowej. Po jego upływie postęp jest zapisany, a analiza wznawia się po otwarciu aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O GaleriQ usa o tempo em segundo plano permitido pelo iOS, sem um cartão de atividade do sistema. Se o tempo acabar, o progresso fica salvo e a análise continua quando você reabrir o app."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O GaleriQ usa o tempo em segundo plano permitido pelo iOS sem um cartão do sistema. Quando termina, o progresso fica guardado e a análise retoma ao abrir a app."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ folosește timpul în fundal permis de iOS fără card de sistem. Când expiră, progresul rămâne salvat și analiza se reia la redeschiderea aplicației."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ использует разрешённое iOS время в фоне без системной карточки. По его истечении прогресс сохраняется, а анализ продолжается при открытии приложения."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ využíva čas na pozadí, ktorý iOS povoľuje, bez systémovej karty aktivity. Ak čas vyprší, postup zostane uložený a analýza pokračuje, keď aplikáciu znova otvoríte."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ uporablja čas v ozadju, ki ga dovoli iOS, brez sistemske kartice dejavnosti. Če čas poteče, napredek ostane shranjen, analiza pa se nadaljuje, ko znova odpreš aplikacijo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ använder den bakgrundstid som iOS tillåter, utan systemets aktivitetskort. Om tiden tar slut sparas förloppet och analysen fortsätter när du öppnar appen igen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ சிஸ்டம் செயல்பாட்டு அட்டை இல்லாமல் iOS அனுமதிக்கும் பின்னணி நேரத்தைப் பயன்படுத்துகிறது. நேரம் முடிந்தால் முன்னேற்றம் சேமிக்கப்பட்டிருக்கும், ஆப்பை மீண்டும் திறக்கும்போது பகுப்பாய்வு தொடரும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ సిస్టమ్ యాక్టివిటీ కార్డ్ లేకుండా iOS అనుమతించే బ్యాక్‌గ్రౌండ్ సమయాన్ని వాడుతుంది. సమయం అయిపోతే ప్రోగ్రెస్ సేవ్ అయి ఉంటుంది, యాప్ మళ్లీ తెరిచినప్పుడు విశ్లేషణ కొనసాగుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ใช้เวลาเบื้องหลังที่ iOS อนุญาต โดยไม่มีการ์ดกิจกรรมของระบบ หากหมดเวลา ความคืบหน้าจะถูกบันทึกไว้และการวิเคราะห์จะทำต่อเมื่อคุณเปิดแอพอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ, sistem etkinlik kartı göstermeden iOS’un izin verdiği arka plan süresini kullanır. Süre bittiğinde ilerleme kaydedilir ve uygulamayı açınca analiz sürer."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ використовує дозволений iOS час у фоні без системної картки. Коли час спливає, прогрес зберігається, а аналіз продовжується після відкриття застосунку."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ سسٹم سرگرمی کارڈ کے بغیر iOS کی اجازت والا پس منظر وقت استعمال کرتا ہے۔ وقت ختم ہو جائے تو پیش رفت محفوظ رہتی ہے، اور ایپ دوبارہ کھولنے پر تجزیہ جاری رہتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ dùng thời gian chạy nền mà iOS cho phép, không có thẻ hoạt động hệ thống. Nếu hết thời gian, tiến trình vẫn được lưu và việc phân tích tiếp tục khi bạn mở lại ứng dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ 使用 iOS 允许的后台时间，不显示系统活动卡片。时间用尽后会保存进度，重新打开 App 时自动继续分析。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ 使用 iOS 允許的背景時間，不顯示系統活動卡片。若時間用完，進度會保留，下次打開 App 時分析會繼續。"
          }
        }
      }
    },
