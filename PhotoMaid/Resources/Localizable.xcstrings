    "dock_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح سلة المهملات. لا يُحذف شيء دون تأكيدك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ট্র্যাশ খোলে। আপনার নিশ্চিতকরণ ছাড়া কিছুই মুছে ফেলা হয় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Obre la paperera. No s’esborra res sense la teva confirmació."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevře koš. Bez vašeho potvrzení se nic nesmaže."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbner papirkurven. Intet slettes uden din bekræftelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet den Papierkorb. Gelöscht wird erst nach deiner Bestätigung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίγει τον κάδο. Τίποτα δεν διαγράφεται χωρίς την επιβεβαίωσή σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens the trash. Nothing is deleted without your confirmation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la papelera. No se borra nada sin tu confirmación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa roskakorin. Mitään ei poisteta ilman vahvistustasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre la corbeille. Rien n’est supprimé sans ta confirmation."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ટ્રેશ ખોલે છે. તમારી પુષ્ટિ વિના કંઈ ડિલીટ થતું નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פותח את הפח. שום דבר לא נמחק בלי אישור שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्रैश खोलता है। आपकी पुष्टि के बिना कुछ भी डिलीट नहीं होता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvara smeće. Ništa se ne briše bez tvoje potvrde."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megnyitja a kukát. A megerősítésed nélkül semmi sem törlődik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka sampah. Tidak ada yang dihapus tanpa konfirmasimu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre il cestino. Nulla viene eliminato senza la tua conferma."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴミ箱を開きます。確認なしで削除されることはありません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕಸದ ಬುಟ್ಟಿ ತೆರೆಯುತ್ತದೆ. ನಿಮ್ಮ ದೃಢೀಕರಣವಿಲ್ಲದೆ ಏನನ್ನೂ ಅಳಿಸಲಾಗುವುದಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통을 열어요. 확인 없이 삭제하지 않아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ട്രാഷ് തുറക്കുന്നു. നിങ്ങളുടെ സ്ഥിരീകരണമില്ലാതെ ഒന്നും ഇല്ലാതാക്കില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्रॅश उघडते. तुमच्या पुष्टीशिवाय काहीही डिलीट होत नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka sampah. Tiada apa dipadam tanpa pengesahan anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpner papirkurven. Ingenting slettes uten at du bekrefter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent de prullenbak. Er wordt niets verwijderd zonder je bevestiging."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଟ୍ରାସ ଖୋଲେ। ଆପଣଙ୍କ ନିଶ୍ଚିତକରଣ ବିନା କିଛି ଡିଲିଟ୍ ହୁଏ ନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਰੱਦੀ ਖੋਲ੍ਹਦਾ ਹੈ। ਤੁਹਾਡੀ ਪੁਸ਼ਟੀ ਤੋਂ ਬਿਨਾਂ ਕੁਝ ਨਹੀਂ ਮਿਟਦਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwiera kosz. Nic nie zostanie usunięte bez Twojej zgody."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre a lixeira. Nada é apagado sem a sua confirmação."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o lixo. Nada é eliminado sem a tua confirmação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschide coșul. Nimic nu este șters fără confirmarea ta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает корзину. Ничего не удаляется без твоего подтверждения."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorí kôš. Bez vášho potvrdenia sa nič nevymaže."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpre koš. Brez tvoje potrditve se nič ne izbriše."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppnar papperskorgen. Inget raderas utan din bekräftelse."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "குப்பையைத் திறக்கும். உங்கள் உறுதிப்படுத்தல் இல்லாமல் எதுவும் நீக்கப்படாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ట్రాష్‌ను తెరుస్తుంది. మీ నిర్ధారణ లేకుండా ఏదీ తొలగించబడదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดถังขยะ ไม่มีอะไรถูกลบโดยไม่มีการยืนยันจากคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çöp kutusunu açar. Onayın olmadan hiçbir şey silinmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкриває кошик. Нічого не видаляється без твого підтвердження."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ردی کھولتا ہے۔ آپ کی تصدیق کے بغیر کچھ بھی حذف نہیں ہوتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở thùng rác. Không có gì bị xóa khi chưa có xác nhận của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开回收站。未经确认，不会删除任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開垃圾桶。未經你確認，不會刪除任何內容。"
          }
        }
      }
    },
