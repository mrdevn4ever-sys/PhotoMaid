    "ana_documents_sub": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقطات شاشة وإيصالات ومستندات – قابلة للبحث بالنص المكتشف"
          }
        },
        "de": {
          "stringUnit": {
