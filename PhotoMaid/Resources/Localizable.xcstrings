    "offer_fine": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بلا اشتراك أو تجديد تلقائي. اشترِ Pro مرة واحدة عبر Google Play."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Abo und keine automatische Verlängerung. Pro kaufst du einmal über Google Play."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No subscription or automatic renewal. Buy Pro once through Google Play."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin suscripción ni renovación automática. Compra Pro una sola vez a través de Google Play."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans abonnement ni renouvellement automatique. Achète Pro une seule fois via Google Play."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun abbonamento o rinnovo automatico. Acquista Pro una sola volta tramite Google Play."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブスクも自動更新もありません。ProはGoogle Playで一度だけ購入します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구독이나 자동 갱신이 없어요. Google Play에서 Pro를 한 번만 구매하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen abonnement of automatische verlenging. Koop Pro één keer via Google Play."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez abonamentu i automatycznego odnowienia. Kup Pro raz przez Google Play."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem subscrição nem renovação automática. Compra o Pro uma única vez através do Google Play."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fără abonament sau reînnoire automată. Cumperi Pro o singură dată prin Google Play."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без подписки и автоматического продления. Купи Pro один раз через Google Play."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonelik ve otomatik yenileme yok. Pro’yu Google Play üzerinden bir kez satın al."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Без передплати й автоматичного подовження. Купи Pro один раз через Google Play."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需订阅，也不会自动续费。通过 Google Play 一次购买 Pro。"
          }
        }
      }
    },
    "offer_free_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب ورتّب بلا حدود، طالما تشاء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unbegrenzt wischen und sortieren – so lange du willst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe and organize without limits, for as long as you like."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza y organiza sin límite, todo el tiempo que quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais défiler et organise sans limite, aussi longtemps que tu veux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri e organizza senza limiti, per tutto il tempo che vuoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スワイプも整理も、期間の制限なく無料で使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기간 제한 없이 원하는 만큼 넘기고 정리하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Veeg en orden zonder limieten, zolang je wilt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeglądaj i porządkuj bez limitu, tak długo, jak chcesz."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza e organiza sem limites, durante o tempo que quiseres."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Glisează și organizează fără limite, cât timp dorești."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Листай и упорядочивай без ограничений, сколько угодно."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İstediğin kadar kaydır ve düzenle, süre sınırı olmadan."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гортай і впорядковуй без обмежень, скільки завгодно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随时滑动和整理，没有次数或使用期限限制。"
          }
        }
      }
    },
