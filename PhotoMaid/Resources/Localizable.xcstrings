    "wf_step_target": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ كحد أقصى لكل صورة – تُعدَّل الجودة وعند الحاجة الحجم، وتُقاس النتيجة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতি ফটো সর্বোচ্চ %1$@ – মান ও প্রয়োজনে আকার মানিয়ে নেওয়া হয় এবং ফলাফল মাপা হয়"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Com a màxim %1$@ per foto: s’ajusten la qualitat i, si cal, la mida, i es mesura el resultat"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejvýše %1$@ na fotku – upraví se kvalita a podle potřeby velikost a výsledek se změří"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Højst %1$@ pr. foto – kvaliteten og om nødvendigt størrelsen justeres, og resultatet måles"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Höchstens %1$@ je Foto – Qualität und notfalls Größe werden angepasst, das Ergebnis wird gemessen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έως %1$@ ανά φωτογραφία – προσαρμόζεται η ποιότητα και, αν χρειαστεί, το μέγεθος, και το αποτέλεσμα μετριέται"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At most %1$@ per photo – quality and, if needed, size are adjusted and the result is measured"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Como máximo %1$@ por foto: se ajustan la calidad y, si hace falta, el tamaño, y se mide el resultado"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Enintään %1$@ kuvaa kohti – laatua ja tarvittaessa kokoa säädetään ja tulos mitataan"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ max. par photo – la qualité et si besoin la taille sont ajustées, le résultat est mesuré"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "દરેક ફોટો વધુમાં વધુ %1$@ – ગુણવત્તા અને જરૂર પડે તો કદ ગોઠવાય છે અને પરિણામ માપવામાં આવે છે"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עד %1$@ לכל תמונה – האיכות ולפי הצורך הגודל מותאמים, והתוצאה נמדדת"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर फ़ोटो ज़्यादा से ज़्यादा %1$@ – क्वालिटी और ज़रूरत हो तो साइज़ बदला जाता है और नतीजा नापा जाता है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Najviše %1$@ po fotografiji – prilagođava se kvaliteta i po potrebi veličina, a rezultat se mjeri"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Legfeljebb %1$@ fotónként – a minőség és szükség esetén a méret igazodik, az eredmény mérve"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Maksimal %1$@ per foto – kualitas dan, bila perlu, ukuran disesuaikan dan hasilnya diukur"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al massimo %1$@ per foto: si regolano qualità ed eventualmente dimensioni, e il risultato viene misurato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1枚あたり最大%1$@ – 画質と必要ならサイズを調整し、結果を測定"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪ್ರತಿ ಫೋಟೋಗೆ ಗರಿಷ್ಠ %1$@ – ಗುಣಮಟ್ಟ ಮತ್ತು ಅಗತ್ಯವಿದ್ದರೆ ಗಾತ್ರವನ್ನು ಹೊಂದಿಸಲಾಗುತ್ತದೆ ಮತ್ತು ಫಲಿತಾಂಶವನ್ನು ಅಳೆಯಲಾಗುತ್ತದೆ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진당 최대 %1$@ – 화질과 필요하면 크기를 조정하고 결과를 측정"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഓരോ ഫോട്ടോയ്ക്കും പരമാവധി %1$@ – നിലവാരവും ആവശ്യമെങ്കിൽ വലുപ്പവും ക്രമീകരിക്കുകയും ഫലം അളക്കുകയും ചെയ്യും"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रति फोटो जास्तीत जास्त %1$@ – गुणवत्ता आणि गरज असल्यास आकार समायोजित केला जातो आणि निकाल मोजला जातो"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Paling banyak %1$@ setiap foto – kualiti dan, jika perlu, saiz dilaraskan dan hasilnya diukur"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Maks %1$@ per bilde – kvaliteten og ved behov størrelsen justeres, og resultatet måles"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoogstens %1$@ per foto – kwaliteit en zo nodig formaat worden aangepast, het resultaat wordt gemeten"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପ୍ରତି ଫଟୋ ସର୍ବାଧିକ %1$@ – ଗୁଣବତ୍ତା ଓ ଆବଶ୍ୟକ ହେଲେ ଆକାର ସଜାଡ଼ାଯାଏ ଏବଂ ଫଳାଫଳ ମପାଯାଏ"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹਰ ਫ਼ੋਟੋ ਵੱਧ ਤੋਂ ਵੱਧ %1$@ – ਗੁਣਵੱਤਾ ਅਤੇ, ਲੋੜ ਹੋਵੇ ਤਾਂ, ਆਕਾਰ ਨੂੰ ਢਾਲਿਆ ਜਾਂਦਾ ਹੈ ਅਤੇ ਨਤੀਜਾ ਮਾਪਿਆ ਜਾਂਦਾ ਹੈ"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maks. %1$@ na zdjęcie – jakość i w razie potrzeby rozmiar są dopasowywane, wynik jest mierzony"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No máximo %1$@ por foto – a qualidade e, se preciso, o tamanho são ajustados e o resultado é medido"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Até %1$@ por foto – a qualidade e, se preciso, o tamanho são ajustados e o resultado é medido"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cel mult %1$@ per fotografie – se ajustează calitatea și, la nevoie, dimensiunea, iar rezultatul se măsoară"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не больше %1$@ на фото – подбираются качество и при необходимости размер, результат измеряется"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Najviac %1$@ na fotku – upraví sa kvalita a podľa potreby veľkosť a výsledok sa zmeria"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Največ %1$@ na fotografijo – prilagodi se kakovost in po potrebi velikost, rezultat pa se izmeri"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Högst %1$@ per bild – kvaliteten och vid behov storleken justeras och resultatet mäts"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு புகைப்படத்திற்கு அதிகபட்சம் %1$@ – தரமும் தேவைப்பட்டால் அளவும் சரிசெய்யப்பட்டு முடிவு அளவிடப்படும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఒక్కో ఫోటోకు గరిష్ఠంగా %1$@ – నాణ్యత, అవసరమైతే పరిమాణం సర్దుబాటు చేసి ఫలితాన్ని కొలుస్తారు"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่เกิน %1$@ ต่อรูป – ปรับคุณภาพและขนาดหากจำเป็น และวัดผลลัพธ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraf başına en fazla %1$@ – kalite ve gerekirse boyut ayarlanır, sonuç ölçülür"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не більше %1$@ на фото – підбираються якість і за потреби розмір, результат вимірюється"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
