    "systrash_intro": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل ما يحتفظ به Android في سلة المهملات – من GaleriQ وتطبيقات أخرى. عند انتهاء المدة يحذفه Android بنفسه."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Everything Android keeps in its trash – from GaleriQ and other apps. Android deletes items itself when the time runs out."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles, was Android im Papierkorb aufbewahrt – aus GaleriQ und anderen Apps. Nach Ablauf löscht Android es selbst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything Android keeps in its trash – from GaleriQ and other apps. Android deletes items itself when the time runs out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que Android guarda en su papelera, de GaleriQ y de otras apps. Cuando vence el plazo, Android lo elimina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce qu’Android garde dans sa corbeille – de GaleriQ et d’autres apps. À l’échéance, Android le supprime lui-même."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Everything Android keeps in its trash – from GaleriQ and other apps. Android deletes items itself when the time runs out."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto ciò che Android conserva nel cestino, da GaleriQ e da altre app. Alla scadenza Android lo elimina da solo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Androidがゴミ箱に保管しているもの（GaleriQや他のアプリから）すべて。期限が来るとAndroidが自動で削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ와 다른 앱에서 Android 휴지통에 보관 중인 모든 항목입니다. 기간이 지나면 Android가 직접 삭제합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Everything Android keeps in its trash – from GaleriQ and other apps. Android deletes items itself when the time runs out."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles wat Android in de prullenbak bewaart – uit GaleriQ en andere apps. Na afloop verwijdert Android het zelf."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko, co Android trzyma w koszu – z GaleriQ i innych aplikacji. Po upływie czasu Android sam to usuwa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Everything Android keeps in its trash – from GaleriQ and other apps. Android deletes items itself when the time runs out."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que o Android guarda no lixo – do GaleriQ e de outras apps. Quando o prazo termina, o Android elimina-o."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tot ce păstrează Android în coș – din GaleriQ și alte aplicații. La expirare, Android le șterge singur."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё, что Android хранит в корзине, – из GaleriQ и других приложений. По истечении срока Android удаляет это сам."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Everything Android keeps in its trash – from GaleriQ and other apps. Android deletes items itself when the time runs out."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Everything Android keeps in its trash – from GaleriQ and other apps. Android deletes items itself when the time runs out."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android’in çöp kutusunda tuttuğu her şey – GaleriQ’den ve diğer uygulamalardan. Süre dolunca Android kendisi siler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе, що Android зберігає в кошику, – з GaleriQ та інших застосунків. Після закінчення строку Android видаляє це сам."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Everything Android keeps in its trash – from GaleriQ and other apps. Android deletes items itself when the time runs out."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 回收站中的所有内容（来自 GaleriQ 和其他应用）。到期后 Android 会自行删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Everything Android keeps in its trash – from GaleriQ and other apps. Android deletes items itself when the time runs out."
          }
        }
      }
    },
