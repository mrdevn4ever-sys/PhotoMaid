    "tour_games_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عندما تحتاج إلى استراحة من الترتيب: العب أزواج أو ثعبان الصور أو Foto Blocks بصورك الخاصة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "গোছানো থেকে একটু বিরতি চাইলে: আপনার নিজের ফটো দিয়ে জোড়া মেলাও, ফটো স্নেক বা Foto Blocks খেলুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Quan necessitis un descans d’endreçar: juga a Parelles, Serp de fotos o Foto Blocks amb les teves pròpies fotos."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když si potřebujete odpočinout od úklidu: zahrajte si Dvojice, Foto hada nebo Foto Blocks s vlastními fotkami."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du trænger til en pause fra oprydningen: spil Par, Fotoslange eller Foto Blocks med dine egne fotos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du eine Pause vom Aufräumen brauchst: Spiel Paare, Foto-Snake oder Foto Blocks mit deinen eigenen Fotos."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν χρειάζεσαι ένα διάλειμμα από το τακτοποίημα: παίξε Ζευγάρια, Φιδάκι φωτογραφιών ή Foto Blocks με τις δικές σου φωτογραφίες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you need a break from tidying up: play Pairs, Photo Snake or Foto Blocks with your own photos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando necesites descansar de ordenar: juega a Parejas, Serpiente de fotos o Foto Blocks con tus propias fotos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun tarvitset taukoa siivoamisesta: pelaa Pareja, Kuvakäärmettä tai Foto Blocksia omilla kuvillasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand vous avez besoin d’une pause dans le tri : jouez à Paires, Serpent photo ou Foto Blocks avec vos propres photos."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સાફસફાઈમાંથી વિરામ જોઈએ ત્યારે: તમારા પોતાના ફોટાથી જોડી, ફોટો સ્નેક કે Foto Blocks રમો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כשצריך הפסקה מהסידור: לשחק בזוגות, בנחש תמונות או ב-Foto Blocks עם התמונות שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब सफ़ाई से ब्रेक चाहिए: अपनी फ़ोटो से जोड़ियाँ, फ़ोटो स्नेक या Foto Blocks खेलें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad ti treba predah od raščišćavanja: igraj Parove, Foto-zmiju ili Foto Blocks sa svojim fotografijama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha szünet kell a rendrakásból: játssz Párokat, Fotókígyót vagy Foto Blockst a saját fotóiddal."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat butuh jeda dari merapikan: main Pasangan, Ular Foto, atau Foto Blocks dengan fotomu sendiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando ti serve una pausa dal riordino: gioca a Coppie, Snake fotografico o Foto Blocks con le tue foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "整理の合間にひと休みしたいときは、自分の写真でペア、フォトスネーク、Foto Blocksを遊べます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ವಚ್ಛಗೊಳಿಸುವಿಕೆಯಿಂದ ವಿರಾಮ ಬೇಕಾದಾಗ: ನಿಮ್ಮ ಸ್ವಂತ ಫೋಟೋಗಳೊಂದಿಗೆ ಜೋಡಿಗಳು, ಫೋಟೋ ಸ್ನೇಕ್ ಅಥವಾ Foto Blocks ಆಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정리하다 쉬고 싶을 때는 내 사진으로 짝맞추기, 포토 스네이크, Foto Blocks를 즐겨 보세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വൃത്തിയാക്കലിൽ നിന്ന് ഇടവേള വേണമെങ്കിൽ: നിങ്ങളുടെ സ്വന്തം ഫോട്ടോകളുമായി ജോഡികൾ, ഫോട്ടോ സ്നേക്ക് അല്ലെങ്കിൽ Foto Blocks കളിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "साफसफाईतून ब्रेक हवा असेल तर: तुमच्या स्वतःच्या फोटोंनी जोड्या, फोटो स्नेक किंवा Foto Blocks खेळा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apabila anda perlukan rehat daripada mengemas: main Pasangan, Ular Foto atau Foto Blocks dengan foto anda sendiri."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du trenger en pause fra ryddingen: spill Par, Bildeslange eller Foto Blocks med dine egne bilder."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je even pauze nodig hebt van het opruimen: speel Paren, Foto-Snake of Foto Blocks met je eigen foto’s."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସଫା କରିବାରୁ ଟିକେ ବିରତି ଦରକାର ହେଲେ: ଆପଣଙ୍କ ନିଜ ଫଟୋ ସହ ଯୋଡ଼ି, ଫଟୋ ସ୍ନେକ କିମ୍ବା Foto Blocks ଖେଳନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਦੋਂ ਸਫ਼ਾਈ ਤੋਂ ਥੋੜ੍ਹਾ ਆਰਾਮ ਚਾਹੀਦਾ ਹੋਵੇ: ਆਪਣੀਆਂ ਫ਼ੋਟੋਆਂ ਨਾਲ ਜੋੜੀਆਂ, ਫ਼ੋਟੋ ਸਨੇਕ ਜਾਂ Foto Blocks ਖੇਡੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy potrzebujesz przerwy od porządków: zagraj w Pary, Foto-Snake lub Foto Blocks ze swoimi zdjęciami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando precisar de uma pausa da arrumação: jogue Pares, Cobrinha de fotos ou Foto Blocks com suas próprias fotos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando precisar de uma pausa da arrumação: jogue Pares, Serpente de fotos ou Foto Blocks com as suas fotografias."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Când ai nevoie de o pauză de la ordonat: joacă Perechi, Șarpele foto sau Foto Blocks cu pozele tale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда захочется отдохнуть от уборки, играйте в Пары, Фото-змейку или Foto Blocks со своими фото."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Keď si potrebujete oddýchnuť od upratovania: zahrajte si Dvojice, Foto hada alebo Foto Blocks s vlastnými fotkami."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko potrebuješ odmor od pospravljanja: igraj Pare, Foto kačo ali Foto Blocks s svojimi fotografijami."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När du behöver en paus från rensandet: spela Par, Bildorm eller Foto Blocks med dina egna bilder."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒழுங்குபடுத்துவதிலிருந்து இடைவேளை வேண்டுமா: உங்கள் சொந்தப் புகைப்படங்களுடன் ஜோடிகள், போட்டோ ஸ்நேக் அல்லது Foto Blocks விளையாடுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సర్దడం నుండి విరామం కావాలంటే: మీ సొంత ఫోటోలతో జతలు, ఫోటో స్నేక్ లేదా Foto Blocks ఆడండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อต้องการพักจากการจัดระเบียบ: เล่นจับคู่ งูรูปภาพ หรือ Foto Blocks ด้วยรูปภาพของคุณเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temizliğe ara vermek istediğinde kendi fotoğraflarınla Çiftler, Fotoğraf yılanı veya Foto Blocks oyna."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли захочеться відпочити від прибирання, грайте в Пари, Фото-змійку чи Foto Blocks зі своїми фото."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب صفائی سے وقفہ چاہیے: اپنی تصاویر سے جوڑیاں، فوٹو اسنیک یا Foto Blocks کھیلیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi cần nghỉ tay khỏi việc dọn dẹp: chơi Ghép cặp, Rắn ảnh hoặc Foto Blocks với ảnh của chính bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "想从整理中歇口气时，可以用自己的照片玩配对、照片贪吃蛇或 Foto Blocks。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "整理累了想休息一下：用你自己的照片玩配對、照片貪食蛇或 Foto Blocks。"
          }
        }
      }
    },
