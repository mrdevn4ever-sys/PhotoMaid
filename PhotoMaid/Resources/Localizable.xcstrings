    "game_setup_pairs_intro": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعثر على جميع أزواج الصور على راحتك."
          }
        },
        "da": {
          "stringUnit": {
