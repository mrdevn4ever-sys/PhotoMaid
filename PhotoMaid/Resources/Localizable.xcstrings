    "export_busy": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هناك تصدير آخر قيد التشغيل. انتظر حتى ينتهي."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En anden eksport kører allerede. Vent, til den er færdig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerade läuft schon ein Export. Warte bitte, bis er fertig ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another export is already running. Please wait until it’s finished."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya hay otra exportación en curso. Espera a que termine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un autre export est déjà en cours. Attendez qu’il soit terminé."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekspor lain sedang berjalan. Tunggu sampai selesai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È già in corso un’altra esportazione. Attendi che finisca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の書き出しを実行中です。終わるまでお待ちください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 내보내기가 이미 진행 중입니다. 끝날 때까지 기다려 주세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En annen eksport pågår allerede. Vent til den er ferdig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er loopt al een andere export. Wacht tot die klaar is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trwa już inny eksport. Poczekaj, aż się zakończy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outra exportação já está em andamento. Espere até ela terminar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Já está a decorrer outra exportação. Aguarde até terminar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Rulează deja un alt export. Așteaptă să se termine."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уже идёт другой экспорт. Дождитесь его завершения."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En annan export pågår redan. Vänta tills den är klar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีการส่งออกอื่นกำลังทำงานอยู่ โปรดรอจนเสร็จ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaten başka bir dışa aktarma sürüyor. Bitmesini bekle."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Уже триває інший експорт. Зачекайте, доки він завершиться."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một lần xuất khác đang chạy. Vui lòng đợi đến khi xong."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已有另一个导出正在进行。请等待其完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已有另一個輸出正在進行。請等它完成。"
          }
        }
      }
    },
    "export_cancelled": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
