    "export_bg_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستمر حتى إذا انتقلت إلى تطبيق آخر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাপ বদলালেও চলতে থাকে।"
