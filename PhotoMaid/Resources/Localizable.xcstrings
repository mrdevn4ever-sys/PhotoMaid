    "pro_store_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تحميل Pro من App Store حاليًا. تحقّق من اتصالك بالإنترنت وحاول مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই মুহূর্তে App Store থেকে Pro লোড করা যাচ্ছে না। আপনার ইন্টারনেট সংযোগ দেখে আবার চেষ্টা করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ara no es pot carregar Pro des de l’App Store. Comprova la connexió a internet i torna-ho a provar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro teď nelze načíst z App Storu. Zkontrolujte připojení k internetu a zkuste to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro kan ikke indlæses fra App Store lige nu. Tjek din internetforbindelse, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro lässt sich gerade nicht aus dem App Store laden. Prüfe die Internetverbindung und versuche es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Pro δεν μπορεί να φορτωθεί από το App Store αυτή τη στιγμή. Έλεγξε τη σύνδεση στο διαδίκτυο και δοκίμασε ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro can’t be loaded from the App Store right now. Check your internet connection and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora no se puede cargar Pro desde el App Store. Comprueba tu conexión a internet e inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Prota ei voi nyt ladata App Storesta. Tarkista internetyhteys ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger Pro depuis l’App Store pour le moment. Vérifie ta connexion Internet et réessaie."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અત્યારે App Store માંથી Pro લોડ થઈ શકતું નથી. ઇન્ટરનેટ કનેક્શન તપાસો અને ફરી પ્રયાસ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אי אפשר לטעון כרגע את Pro מה-App Store. כדאי לבדוק את החיבור לאינטרנט ולנסות שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी App Store से Pro लोड नहीं हो सकता। इंटरनेट कनेक्शन जाँचें और फिर कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro se trenutačno ne može učitati iz App Storea. Provjeri internetsku vezu i pokušaj ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Pro most nem tölthető be az App Store-ból. Ellenőrizd az internetkapcsolatot, és próbáld újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro tidak dapat dimuat dari App Store saat ini. Periksa koneksi internetmu dan coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al momento non è possibile caricare Pro dall’App Store. Controlla la connessione a Internet e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在App StoreからProを読み込めません。インターネット接続を確認して、もう一度お試しください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈಗ App Store ನಿಂದ Pro ಲೋಡ್ ಮಾಡಲು ಸಾಧ್ಯವಿಲ್ಲ. ನಿಮ್ಮ ಇಂಟರ್ನೆಟ್ ಸಂಪರ್ಕ ಪರಿಶೀಲಿಸಿ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 App Store에서 Pro를 불러올 수 없어요. 인터넷 연결을 확인하고 다시 시도하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇപ്പോൾ App Store-ൽ നിന്ന് Pro ലോഡ് ചെയ്യാനാകില്ല. ഇന്റർനെറ്റ് കണക്ഷൻ പരിശോധിച്ച് വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आत्ता App Store मधून Pro लोड करता येत नाही. इंटरनेट कनेक्शन तपासा आणि पुन्हा प्रयत्न करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro tidak dapat dimuatkan dari App Store sekarang. Semak sambungan internet anda dan cuba lagi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro kan ikke lastes inn fra App Store akkurat nå. Sjekk internettforbindelsen og prøv igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro kan nu niet uit de App Store worden geladen. Controleer je internetverbinding en probeer het opnieuw."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ବର୍ତ୍ତମାନ App Storeରୁ Pro ଲୋଡ୍ ହୋଇପାରୁନାହିଁ। ଆପଣଙ୍କ ଇଣ୍ଟରନେଟ୍ ସଂଯୋଗ ଯାଞ୍ଚ କରି ପୁଣି ଚେଷ୍ଟା କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro ਇਸ ਵੇਲੇ App Store ਤੋਂ ਲੋਡ ਨਹੀਂ ਹੋ ਸਕਦਾ। ਆਪਣਾ ਇੰਟਰਨੈੱਟ ਕਨੈਕਸ਼ਨ ਜਾਂਚੋ ਅਤੇ ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można teraz wczytać Pro z App Store. Sprawdź połączenie z internetem i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar o Pro da App Store agora. Verifique sua conexão com a internet e tente de novo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível carregar o Pro da App Store neste momento. Verifica a ligação à internet e tenta novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro nu poate fi încărcat acum din App Store. Verifică conexiunea la internet și încearcă din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас не удаётся загрузить Pro из App Store. Проверь подключение к интернету и попробуй ещё раз."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro teraz nemožno načítať z App Storu. Skontrolujte pripojenie na internet a skúste to znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro trenutno ni mogoče naložiti iz trgovine App Store. Preveri internetno povezavo in poskusi znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro kan inte läsas in från App Store just nu. Kontrollera internetanslutningen och försök igen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இப்போது App Store-இலிருந்து Pro-வை ஏற்ற முடியவில்லை. உங்கள் இணைய இணைப்பைச் சரிபார்த்து மீண்டும் முயலுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రస్తుతం App Store నుండి Pro లోడ్ చేయడం సాధ్యం కాదు. మీ ఇంటర్నెట్ కనెక్షన్ తనిఖీ చేసి మళ్లీ ప్రయత్నించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถโหลด Pro จาก App Store ได้ในขณะนี้ ตรวจสอบการเชื่อมต่ออินเทอร์เน็ตแล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro şu anda App Store’dan yüklenemiyor. İnternet bağlantını kontrol edip tekrar dene."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зараз не вдається завантажити Pro з App Store. Перевір з’єднання з інтернетом і спробуй ще раз."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ابھی App Store سے Pro لوڈ نہیں ہو سکتا۔ انٹرنیٹ کنکشن چیک کریں اور دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện không thể tải Pro từ App Store. Hãy kiểm tra kết nối Internet và thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前无法从 App Store 载入 Pro。请检查网络连接后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前無法從 App Store 載入 Pro。請檢查網路連線後再試一次。"
          }
        }
      }
    },
    "pro_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اشترِ مرة واحدة. بلا اشتراك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একবার কিনুন। কোনো সাবস্ক্রিপশন নেই।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Un sol pagament. Sense subscripció."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kupte jednou. Bez předplatného."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Køb én gang. Intet abonnement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmal kaufen. Ohne Abo."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αγορά μία φορά. Χωρίς συνδρομή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Buy once. No subscription."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sola compra. Sin suscripción."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Osta kerran. Ei tilausta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seul achat. Sans abonnement."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "એક વાર ખરીદો. કોઈ સબ્સ્ક્રિપ્શન નહીં."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קונים פעם אחת. בלי מינוי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक बार खरीदें। कोई सब्सक्रिप्शन नहीं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kupi jednom. Bez pretplate."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egyszeri vásárlás. Nincs előfizetés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekali beli. Tanpa langganan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un solo acquisto. Nessun abbonamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度の購入で利用できます。サブスクなし。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಒಮ್ಮೆ ಖರೀದಿಸಿ. ಚಂದಾದಾರಿಕೆ ಇಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번만 구매하세요. 구독은 없어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരിക്കൽ വാങ്ങുക. സബ്‌സ്ക്രിപ്ഷനില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "एकदाच खरेदी करा. सदस्यता नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Beli sekali. Tiada langganan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjøp én gang. Ingen abonnement."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén keer kopen. Geen abonnement."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଥରେ କିଣନ୍ତୁ। କୌଣସି ସବସ୍କ୍ରିପସନ୍ ନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇੱਕ ਵਾਰ ਖ਼ਰੀਦੋ। ਕੋਈ ਸਬਸਕ੍ਰਿਪਸ਼ਨ ਨਹੀਂ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden zakup. Bez abonamentu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compre uma vez. Sem assinatura."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Compra uma vez. Sem subscrição."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cumperi o singură dată. Fără abonament."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одна покупка. Без подписки."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kúpte raz. Bez predplatného."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kupi enkrat. Brez naročnine."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Köp en gång. Ingen prenumeration."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒருமுறை வாங்குங்கள். சந்தா இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఒకసారి కొనండి. సబ్‌స్క్రిప్షన్ లేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ซื้อครั้งเดียว ไม่ต้องสมัครสมาชิก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kez satın al. Abonelik yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одна покупка. Без передплати."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک بار خریدیں۔ کوئی سبسکرپشن نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mua một lần. Không đăng ký."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次购买，无需订阅。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一次購買，無需訂閱。"
          }
        }
      }
    },
