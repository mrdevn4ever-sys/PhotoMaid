    "archive_cleanup_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توجد الآن نسخة تم التحقق منها من هذه الصور والفيديوهات على «%1$@». ستنتقل فقط إلى سلة مهملات PhotoMaid. لن يُحذف شيء حتى تفرغها ويسألك Android مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von diesen Fotos und Videos gibt es jetzt eine geprüfte Kopie auf „%1$@“. Sie kommen nur in den PhotoMaid-Papierkorb. Gelöscht wird erst, wenn du ihn leerst und Android noch einmal nachfragt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is now a checked copy of these photos and videos on “%1$@”. They only go to the PhotoMaid trash. Nothing is deleted until you empty it and Android asks once more."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora hay una copia comprobada de estas fotos y vídeos en «%1$@». Solo van a la papelera de PhotoMaid. No se borra nada hasta que la vacíes y Android vuelva a preguntar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il existe maintenant une copie vérifiée de ces photos et vidéos sur « %1$@ ». Elles vont seulement dans la corbeille PhotoMaid. Rien n’est supprimé tant que vous ne la videz pas et qu’Android ne redemande pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ora c’è una copia controllata di queste foto e video su «%1$@». Finiscono solo nel cestino di PhotoMaid. Non si elimina nulla finché non lo svuoti e Android lo chiede di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの写真と動画には、「%1$@」に確認済みのコピーがあります。移動先はPhotoMaidのゴミ箱だけです。ゴミ箱を空にし、Androidがもう一度確認するまで何も削除されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사진과 동영상은 이제 ‘%1$@’에 확인된 사본이 있어요. PhotoMaid 휴지통으로만 옮겨요. 휴지통을 비우고 Android가 한 번 더 물어볼 때까지 아무것도 삭제되지 않아요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Van deze foto’s en video’s staat nu een gecontroleerde kopie op ‘%1$@’. Ze gaan alleen naar de PhotoMaid-prullenbak. Er wordt pas iets verwijderd als je die leegt en Android nog een keer vraagt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te zdjęcia i filmy mają teraz sprawdzoną kopię na „%1$@”. Trafią tylko do kosza PhotoMaid. Nic nie zostanie usunięte, dopóki go nie opróżnisz, a Android nie zapyta jeszcze raz."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas fotos e vídeos têm agora uma cópia verificada em “%1$@”. Só vão para o lixo do PhotoMaid. Nada é eliminado até o esvaziar e o Android perguntar mais uma vez."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceste fotografii și videoclipuri au acum o copie verificată pe „%1$@”. Ajung doar în coșul PhotoMaid. Nu se șterge nimic până nu golești coșul și Android întreabă încă o dată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У этих фото и видео теперь есть проверенная копия на «%1$@». Они попадут только в корзину PhotoMaid. Ничего не удалится, пока вы её не очистите и Android не спросит ещё раз."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu fotoğraf ve videoların artık “%1$@” üzerinde kontrol edilmiş bir kopyası var. Yalnızca PhotoMaid çöp kutusuna taşınırlar. Sen onu boşaltıp Android bir kez daha sorana kadar hiçbir şey silinmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ці фото й відео тепер мають перевірену копію на «%1$@». Вони потраплять лише в кошик PhotoMaid. Нічого не видалиться, доки ви його не очистите й Android не перепитає."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些照片和视频现在在“%1$@”上有经过检查的副本。它们只会进入 PhotoMaid 回收站。在你清空回收站且 Android 再次确认之前，不会删除任何内容。"
          }
        }
      }
    },
