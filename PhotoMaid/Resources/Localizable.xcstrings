    "tour_today_tab_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الملفات الكبيرة والصور المكررة والأشهر الفردية والمجموعات الجاهزة: هنا ترتّب خطوة بخطوة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বড় ফাইল, ডুপ্লিকেট ফটো, আলাদা আলাদা মাস ও তৈরি সংগ্রহ: এখানে আপনি ধাপে ধাপে গোছান।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fitxers grans, fotos duplicades, mesos concrets i col·leccions preparades: aquí endreces pas a pas."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Velké soubory, duplicitní fotky, jednotlivé měsíce a připravené kolekce: tady uklízíte krok za krokem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Store filer, dublerede fotos, enkelte måneder og færdige samlinger: her rydder du op trin for trin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Große Dateien, doppelte Fotos, einzelne Monate und fertige Sammlungen: Hier räumst du gezielt auf."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μεγάλα αρχεία, διπλές φωτογραφίες, μεμονωμένοι μήνες και έτοιμες συλλογές: εδώ τακτοποιείς βήμα βήμα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Large files, duplicate photos, single months and ready-made collections: this is where you tidy up step by step."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivos grandes, fotos duplicadas, meses sueltos y colecciones listas: aquí ordenas paso a paso."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suuret tiedostot, kaksoiskuvat, yksittäiset kuukaudet ja valmiit kokoelmat: täällä siivoat vaihe vaiheelta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gros fichiers, photos en double, mois par mois et collections prêtes : c’est ici que vous faites le tri pas à pas."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "મોટી ફાઇલો, ડુપ્લિકેટ ફોટા, અલગ મહિના અને તૈયાર સંગ્રહ: અહીં તમે પગલું-દર-પગલું સાફસફાઈ કરો છો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קבצים גדולים, תמונות כפולות, חודשים בודדים ואוספים מוכנים: כאן מסדרים צעד אחר צעד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बड़ी फ़ाइलें, डुप्लिकेट फ़ोटो, अलग-अलग महीने और तैयार कलेक्शन: यहाँ आप कदम-दर-कदम सफ़ाई करते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Velike datoteke, duplicirane fotografije, pojedinačni mjeseci i gotove zbirke: ovdje raščišćavaš korak po korak."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagy fájlok, ismétlődő fotók, egyes hónapok és kész gyűjtemények: itt lépésről lépésre rakhatsz rendet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File besar, foto duplikat, bulan tertentu, dan koleksi siap pakai: di sinilah kamu merapikan langkah demi langkah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "File grandi, foto doppie, singoli mesi e raccolte pronte: qui riordini passo dopo passo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大きなファイル、重複した写真、月ごと、用意されたコレクション。ここで少しずつ整理できます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ದೊಡ್ಡ ಫೈಲ್‌ಗಳು, ನಕಲಿ ಫೋಟೋಗಳು, ಪ್ರತ್ಯೇಕ ತಿಂಗಳುಗಳು ಮತ್ತು ಸಿದ್ಧ ಸಂಗ್ರಹಗಳು: ಇಲ್ಲಿ ನೀವು ಹಂತ ಹಂತವಾಗಿ ವ್ಯವಸ್ಥಿತಗೊಳಿಸುತ್ತೀರಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "큰 파일, 중복 사진, 월별 정리, 준비된 컬렉션까지. 여기서 차근차근 정리해요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വലിയ ഫയലുകൾ, ഡ്യൂപ്ലിക്കേറ്റ് ഫോട്ടോകൾ, ഓരോ മാസങ്ങളും തയ്യാറാക്കിയ ശേഖരങ്ങളും: ഇവിടെ നിങ്ങൾ ഘട്ടം ഘട്ടമായി ചിട്ടപ്പെടുത്തുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मोठ्या फाइल्स, डुप्लिकेट फोटो, स्वतंत्र महिने आणि तयार संग्रह: इथे तुम्ही टप्प्याटप्प्याने साफसफाई करता."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Fail besar, foto pendua, bulan tertentu dan koleksi sedia ada: di sinilah anda mengemas langkah demi langkah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Store filer, dupliserte bilder, enkeltmåneder og ferdige samlinger: her rydder du steg for steg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Grote bestanden, dubbele foto’s, losse maanden en kant-en-klare collecties: hier ruim je stap voor stap op."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ବଡ଼ ଫାଇଲ୍, ଡୁପ୍ଲିକେଟ୍ ଫଟୋ, ଅଲଗା ଅଲଗା ମାସ ଓ ପ୍ରସ୍ତୁତ ସଂଗ୍ରହ: ଏଠାରେ ଆପଣ ଧାପେ ଧାପେ ସଜାନ୍ତି।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਵੱਡੀਆਂ ਫ਼ਾਈਲਾਂ, ਡੁਪਲੀਕੇਟ ਫ਼ੋਟੋਆਂ, ਇਕੱਲੇ ਮਹੀਨੇ ਅਤੇ ਤਿਆਰ ਸੰਗ੍ਰਹਿ: ਇੱਥੇ ਤੁਸੀਂ ਕਦਮ-ਦਰ-ਕਦਮ ਸਫ਼ਾਈ ਕਰਦੇ ਹੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Duże pliki, podwójne zdjęcia, pojedyncze miesiące i gotowe kolekcje: tu robisz porządki krok po kroku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivos grandes, fotos duplicadas, meses individuais e coleções prontas: aqui você arruma passo a passo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ficheiros grandes, fotos duplicadas, meses individuais e coleções prontas: é aqui que arruma passo a passo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fișiere mari, fotografii duplicate, luni separate și colecții gata făcute: aici faci curățenie pas cu pas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Большие файлы, повторяющиеся фото, отдельные месяцы и готовые подборки: здесь вы наводите порядок шаг за шагом."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Veľké súbory, duplicitné fotky, jednotlivé mesiace a pripravené kolekcie: tu upratujete krok za krokom."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Velike datoteke, podvojene fotografije, posamezni meseci in pripravljene zbirke: tukaj čistiš korak za korakom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stora filer, dubblettbilder, enskilda månader och färdiga samlingar: här städar du steg för steg."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பெரிய கோப்புகள், நகல் புகைப்படங்கள், தனித்தனி மாதங்கள், தயாரான தொகுப்புகள்: இங்கே படிப்படியாக ஒழுங்குபடுத்துகிறீர்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పెద్ద ఫైళ్లు, నకిలీ ఫోటోలు, విడివిడి నెలలు, సిద్ధమైన కలెక్షన్‌లు: ఇక్కడ మీరు దశలవారీగా సర్దుకుంటారు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์ขนาดใหญ่ รูปซ้ำ แต่ละเดือน และคอลเลกชันสำเร็จรูป: ที่นี่คุณจัดระเบียบทีละขั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Büyük dosyalar, aynı fotoğraflar, tek tek aylar ve hazır koleksiyonlar: Burada adım adım düzenlersin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Великі файли, однакові фото, окремі місяці й готові добірки: тут ви наводите лад крок за кроком."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بڑی فائلیں، ڈپلیکیٹ تصاویر، الگ الگ مہینے اور تیار کلیکشنز: یہاں آپ قدم بہ قدم صفائی کرتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp lớn, ảnh trùng lặp, từng tháng và bộ sưu tập có sẵn: đây là nơi bạn dọn dẹp từng bước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "大文件、重复照片、按月整理和现成的合集：在这里一步步整理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "大型檔案、重複照片、單一月份和現成精選集：在這裡一步步整理。"
          }
        }
      }
    },
