    "lib_trash_fav_protected": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا عنصر مفضل. „حماية المفضلة“ مفعّل، لذا لن يُنقل إلى السلة. يمكنك تغيير ذلك في الإعدادات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি পছন্দের। “পছন্দের সুরক্ষা” চালু আছে, তাই এটি ট্র্যাশের বাইরে থাকে। সেটিংসে এটি বদলাতে পারেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "És un preferit. «Protegir els preferits» està activat, així que no va a la paperera. Ho pots canviar a Configuració."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto je oblíbená položka. „Chránit oblíbené“ je zapnuté, takže nepůjde do koše. Můžete to změnit v Nastavení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette er en favorit. “Beskyt favoritter” er slået til, så den holdes ude af papirkurven. Du kan ændre det i Indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist ein Favorit. „Favoriten schützen“ ist an, deshalb kommt er nicht in den Papierkorb. Ändern kannst du das in den Einstellungen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είναι αγαπημένο. Η «Προστασία αγαπημένων» είναι ενεργή, οπότε μένει εκτός κάδου. Μπορείς να το αλλάξεις στις Ρυθμίσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a favourite. “Protect favourites” is on, so it stays out of the trash. You can change this in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es un favorito. «Proteger favoritos» está activado, así que no va a la papelera. Puedes cambiarlo en Ajustes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä on suosikki. ”Suojaa suosikit” on päällä, joten se ei mene roskakoriin. Voit muuttaa tätä Asetuksissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est un favori. « Protéger les favoris » est activé, il ne va donc pas à la corbeille. Tu peux le modifier dans les réglages."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ મનપસંદ છે. “મનપસંદ સુરક્ષિત રાખો” ચાલુ છે, તેથી તે ટ્રેશમાં જતું નથી. તમે આ સેટિંગ્સમાં બદલી શકો છો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זה מועדף. „הגנה על מועדפים” מופעלת, לכן הוא לא עובר לפח. אפשר לשנות זאת בהגדרות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह पसंदीदा है। “पसंदीदा सुरक्षित रखें” चालू है, इसलिए यह ट्रैश में नहीं जाता। आप इसे सेटिंग्ज़ में बदल सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo je omiljena stavka. „Zaštiti omiljene” je uključeno pa ne ide u smeće. To možeš promijeniti u Postavkama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez egy kedvenc. A „Kedvencek védelme” be van kapcsolva, így nem kerül a kukába. Ezt a Beállításokban módosíthatod."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini favorit. “Lindungi favorit” aktif, jadi item ini tidak masuk ke sampah. Kamu bisa mengubahnya di Pengaturan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È un preferito. «Proteggi preferiti» è attivo, quindi non va nel cestino. Puoi cambiarlo nelle impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これはお気に入りです。「お気に入りを保護」がオンのため、ゴミ箱には入りません。設定で変更できます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇದು ಮೆಚ್ಚಿನದು. “ಮೆಚ್ಚಿನವುಗಳನ್ನು ರಕ್ಷಿಸಿ” ಆನ್ ಆಗಿದೆ, ಆದ್ದರಿಂದ ಇದು ಕಸದ ಬುಟ್ಟಿಯಿಂದ ಹೊರಗಿರುತ್ತದೆ. ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಇದನ್ನು ಬದಲಾಯಿಸಬಹುದು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "즐겨찾기 항목이에요. '즐겨찾기 보호'가 켜져 있어 휴지통에 넣지 않아요. 설정에서 바꿀 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇത് പ്രിയപ്പെട്ടതാണ്. “പ്രിയപ്പെട്ടവ സംരക്ഷിക്കുക” ഓണാണ്, അതിനാൽ ഇത് ട്രാഷിന് പുറത്ത് തുടരും. ക്രമീകരണങ്ങളിൽ ഇത് മാറ്റാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हे आवडते आहे. “आवडते संरक्षित करा” चालू आहे, म्हणून ते ट्रॅशमध्ये जात नाही. हे तुम्ही सेटिंग्जमध्ये बदलू शकता."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini kegemaran. “Lindungi kegemaran” dihidupkan, jadi ia tidak masuk ke sampah. Anda boleh menukar ini dalam Seting."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette er en favoritt. «Beskytt favoritter» er på, så den holdes utenfor papirkurven. Du kan endre dette i Innstillinger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is een favoriet. ‘Favorieten beschermen’ staat aan, dus hij gaat niet naar de prullenbak. Je kunt dit wijzigen in Instellingen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହା ପସନ୍ଦର। “ପସନ୍ଦର ସୁରକ୍ଷା” ଚାଲୁ ଅଛି, ତେଣୁ ଏହା ଟ୍ରାସ ବାହାରେ ରହେ। ସେଟିଂସରେ ଏହା ବଦଳାଇପାରିବେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਮਨਪਸੰਦ ਹੈ। “ਮਨਪਸੰਦ ਸੁਰੱਖਿਅਤ ਕਰੋ” ਚਾਲੂ ਹੈ, ਇਸ ਲਈ ਇਹ ਰੱਦੀ ਤੋਂ ਬਾਹਰ ਰਹਿੰਦੀ ਹੈ। ਤੁਸੀਂ ਇਸ ਨੂੰ ਸੈਟਿੰਗਾਂ ਵਿੱਚ ਬਦਲ ਸਕਦੇ ਹੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To ulubione. „Chroń ulubione” jest włączone, więc nie trafi do kosza. Możesz to zmienić w ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este item está nos Favoritos. “Proteger favoritos” está ativado, então ele fica fora da lixeira. Você pode mudar isso em Ajustes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "É um favorito. «Proteger favoritos» está ativo, por isso não vai para o lixo. Podes mudar isto nas definições."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Este un favorit. „Protejează favoritele” e activ, așa că nu ajunge în coș. Poți schimba asta în setări."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это избранное. Включено «Защищать избранное», поэтому оно не попадёт в корзину. Это можно изменить в настройках."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto je obľúbená položka. „Chrániť obľúbené“ je zapnuté, takže nepôjde do koša. Môžete to zmeniť v Nastaveniach."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "To je priljubljeno. »Zaščiti priljubljene« je vklopljeno, zato ne gre v koš. To lahko spremeniš v Nastavitvah."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här är en favorit. ”Skydda favoriter” är på, så den hålls utanför papperskorgen. Du kan ändra det i Inställningar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இது பிடித்தது. “பிடித்தவைகளைப் பாதுகா” இயக்கத்தில் உள்ளது, எனவே இது குப்பைக்கு வெளியே இருக்கும். அமைப்புகளில் இதை மாற்றலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇది ఇష్టమైనది. “ఇష్టమైనవి రక్షించు” ఆన్‌లో ఉంది, కాబట్టి ఇది ట్రాష్ బయటే ఉంటుంది. సెట్టింగ్‌లలో దీన్ని మార్చవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นี่คือรายการโปรด “ปกป้องรายการโปรด” เปิดอยู่ จึงไม่ไปถังขยะ คุณเปลี่ยนได้ในการตั้งค่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bir favori. „Favorileri koru” açık olduğu için çöp kutusuna gitmez. Bunu ayarlardan değiştirebilirsin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це обране. Увімкнено «Захищати обране», тому воно не потрапить у кошик. Змінити це можна в налаштуваннях."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ پسندیدہ ہے۔ ”پسندیدہ کا تحفظ“ آن ہے، اس لیے یہ ردی میں نہیں جاتا۔ آپ اسے ترتیبات میں بدل سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây là mục ưa thích. “Bảo vệ mục ưa thích” đang bật nên nó không vào thùng rác. Bạn có thể đổi điều này trong Cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是收藏项。已开启“保护收藏”，因此不会移到回收站。可在设置中更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是個人收藏。「保護個人收藏」已開啟，所以不會放入垃圾桶。你可以在「設定」中更改。"
          }
        }
      }
    },
    "lib_trash_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إلى سلة GaleriQ – لا يُحذف شيء. تقرر لاحقًا هناك."
