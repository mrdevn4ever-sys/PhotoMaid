        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಆ್ಯಪ್ ಬದಲಾಯಿಸಿದರೂ ಮುಂದುವರಿಯುತ್ತದೆ."
