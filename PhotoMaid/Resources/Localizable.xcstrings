    "notif_due_body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حان اليوم وقت مراجعة شيء في «لاحقًا»."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Noget i “Senere” er klar til gennemgang i dag."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heute ist etwas aus „Später“ wieder dran."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something in “Later” is ready to review today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy toca revisar algo de «Después»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un élément de « Plus tard » est à revoir aujourd’hui."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ada sesuatu di “Nanti” yang siap ditinjau hari ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oggi è il momento di rivedere qualcosa in «Più tardi»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「あとで」にあるものを、今日はもう一度確認しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 ‘나중에’에 있는 항목을 다시 볼 차례예요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Noe i «Senere» er klart til gjennomgang i dag."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is vandaag iets uit ‘Later’ weer aan de beurt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dziś czas wrócić do czegoś z „Później”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo em “Depois” está pronto para revisar hoje."
          }
