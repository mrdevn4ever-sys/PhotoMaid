        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une clé de secours est configurée. En créer une nouvelle rend l’ancienne invalide."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È configurata una chiave di recupero. Crearne una nuova rende non valida quella vecchia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復旧キーは設定済みです。新しいキーを作成すると、古いキーは無効になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복구 키가 설정되어 있습니다. 새로 만들면 이전 키는 무효가 됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is een herstelsleutel ingesteld. Een nieuwe maakt de oude ongeldig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klucz odzyskiwania jest skonfigurowany. Utworzenie nowego unieważni stary."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Há uma chave de recuperação configurada. Criar uma nova invalida a antiga."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Este configurată o cheie de recuperare. Crearea uneia noi o invalidează pe cea veche."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ восстановления настроен. При создании нового старый станет недействительным."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kurtarma anahtarı ayarlı. Yenisini oluşturmak eskisini geçersiz kılar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ відновлення налаштовано. Після створення нового старий стане недійсним."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已设置恢复密钥。创建新密钥会使旧密钥失效。"
          }
        }
      }
    },
