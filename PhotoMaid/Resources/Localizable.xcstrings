    "archive_target_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صِل ذاكرة USB أو قرصًا خارجيًا واختر مجلدًا عليه. يمكن أيضًا استخدام iCloud Drive ومواقع أخرى في تطبيق الملفات."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilslut en USB-nøgle eller et eksternt drev, og vælg en mappe på det. iCloud Drive og andre steder i appen Arkiver virker også."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließe einen USB-Stick oder eine externe Festplatte an und wähle dort einen Ordner. iCloud Drive und andere Orte der Dateien-App gehen auch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect a USB stick or external drive and choose a folder on it. iCloud Drive and other locations in the Files app work too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta una memoria USB o un disco externo y elige una carpeta en él. También sirven iCloud Drive y otras ubicaciones de la app Archivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Branchez une clé USB ou un disque externe et choisissez-y un dossier. iCloud Drive et les autres emplacements de l’app Fichiers fonctionnent aussi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sambungkan flashdisk USB atau drive eksternal dan pilih folder di dalamnya. iCloud Drive dan lokasi lain di app File juga bisa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collega una chiavetta USB o un disco esterno e scegli una cartella. Vanno bene anche iCloud Drive e altre posizioni dell’app File."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "USBメモリや外付けドライブを接続し、その中のフォルダを選んでください。iCloud Driveや「ファイル」アプリのほかの場所も使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "USB 메모리나 외장 드라이브를 연결하고 그 안의 폴더를 선택하세요. iCloud Drive와 파일 앱의 다른 위치도 사용할 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Koble til en minnepinne eller en ekstern disk og velg en mappe på den. iCloud Drive og andre steder i Filer-appen fungerer også."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sluit een usb-stick of externe schijf aan en kies daar een map. iCloud Drive en andere locaties in de Bestanden-app werken ook."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podłącz pendrive lub dysk zewnętrzny i wybierz na nim folder. Działa też iCloud Drive i inne miejsca w aplikacji Pliki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte um pendrive ou disco externo e escolha uma pasta nele. O iCloud Drive e outros locais do app Arquivos também funcionam."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ligue uma pen USB ou um disco externo e escolha lá uma pasta. O iCloud Drive e outras localizações da app Ficheiros também funcionam."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectează un stick USB sau un hard disk extern și alege un dosar de pe el. Merg și iCloud Drive și alte locații din aplicația Fișiere."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключите USB-флешку или внешний диск и выберите на нём папку. Подойдут также iCloud Drive и другие места в приложении «Файлы»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anslut ett USB-minne eller en extern disk och välj en mapp på den. iCloud Drive och andra platser i appen Filer fungerar också."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อแฟลชไดรฟ์ USB หรือฮาร์ดดิสก์ภายนอกแล้วเลือกโฟลเดอร์ในนั้น iCloud Drive และตำแหน่งอื่นในแอพไฟล์ก็ใช้ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir USB bellek veya harici disk tak ve üzerinde bir klasör seç. iCloud Drive ve Dosyalar uygulamasındaki diğer konumlar da olur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під’єднайте USB-флешку або зовнішній диск і виберіть на ньому папку. Також підійдуть iCloud Drive та інші місця в програмі «Файли»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cắm USB hoặc ổ cứng ngoài và chọn một thư mục trên đó. iCloud Drive và các vị trí khác trong ứng dụng Tệp cũng dùng được."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接 U 盘或外置硬盘并在其中选择一个文件夹。也可以使用 iCloud Drive 和“文件”App 中的其他位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連接 USB 隨身碟或外接硬碟，並選擇其中的檔案夾。iCloud 雲碟和「檔案」App 中的其他位置也可以。"
          }
        }
      }
    },
