    "backup_too_new": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه النسخة الاحتياطية من إصدار أحدث من GaleriQ. حدّث GaleriQ أولًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne sikkerhedskopi stammer fra en nyere version af GaleriQ. Opdater GaleriQ først."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Sicherung stammt aus einer neueren GaleriQ-Version. Bitte aktualisiere GaleriQ zuerst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This backup comes from a newer version of GaleriQ. Please update GaleriQ first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta copia de seguridad es de una versión más reciente de GaleriQ. Actualiza GaleriQ primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette sauvegarde provient d’une version plus récente de GaleriQ. Mettez d’abord GaleriQ à jour."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cadangan ini berasal dari versi GaleriQ yang lebih baru. Perbarui GaleriQ dulu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo backup proviene da una versione più recente di GaleriQ. Aggiorna prima GaleriQ."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバックアップは新しいバージョンのGaleriQで作られました。先にGaleriQを更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 백업은 더 새로운 GaleriQ 버전에서 만들어졌어요. 먼저 GaleriQ를 업데이트하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne sikkerhetskopien kommer fra en nyere versjon av GaleriQ. Oppdater GaleriQ først."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze back-up komt uit een nieuwere versie van GaleriQ. Werk GaleriQ eerst bij."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta kopia zapasowa pochodzi z nowszej wersji GaleriQ. Najpierw zaktualizuj GaleriQ."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este backup vem de uma versão mais nova do GaleriQ. Atualize o GaleriQ primeiro."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cópia de segurança vem de uma versão mais recente do GaleriQ. Atualize primeiro o GaleriQ."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest backup provine dintr-o versiune mai nouă de GaleriQ. Actualizează mai întâi GaleriQ."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта резервная копия создана в более новой версии GaleriQ. Сначала обновите GaleriQ."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här säkerhetskopian kommer från en nyare version av GaleriQ. Uppdatera GaleriQ först."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูลสำรองนี้มาจาก GaleriQ เวอร์ชันที่ใหม่กว่า โปรดอัปเดต GaleriQ ก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yedek GaleriQ’in daha yeni bir sürümünden. Lütfen önce GaleriQ’i güncelle."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цю резервну копію створено в новішій версії GaleriQ. Спершу оновіть GaleriQ."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản sao lưu này đến từ phiên bản GaleriQ mới hơn. Vui lòng cập nhật GaleriQ trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此备份来自更新版本的 GaleriQ。请先更新 GaleriQ。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這份備份來自較新版本的 GaleriQ。請先更新 GaleriQ。"
          }
        }
      }
