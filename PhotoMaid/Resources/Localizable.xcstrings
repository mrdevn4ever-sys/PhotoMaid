    "privacy_purchases": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتم المشتريات عبر App Store من Apple. لا يرسل GaleriQ صورك أو أسماءها أو بياناتها الوصفية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কেনাকাটা Apple-এর App Store ব্যবহার করে। এর জন্য GaleriQ কখনো আপনার ফটো, নাম বা মেটাডেটা পাঠায় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les compres fan servir l’App Store d’Apple. GaleriQ mai no envia per a això les teves fotos, noms ni metadades."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nákupy probíhají přes App Store od Applu. GaleriQ k tomu nikdy neposílá vaše fotky, názvy ani metadata."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Køb sker via Apples App Store. GaleriQ sender aldrig dine fotos, navne eller metadata i den forbindelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Käufe laufen über Apples App Store. GaleriQ überträgt dafür nie Fotos, Namen oder Metadaten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι αγορές γίνονται μέσω του App Store της Apple. Το GaleriQ δεν στέλνει ποτέ για αυτό τις φωτογραφίες, τα ονόματα ή τα μεταδεδομένα σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Purchases use Apple’s App Store. GaleriQ never sends your photos, names or metadata for this."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las compras usan el App Store de Apple. GaleriQ nunca envía tus fotos, nombres ni metadatos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostot tehdään Applen App Storen kautta. GaleriQ ei koskaan lähetä tätä varten kuviasi, nimiä tai metatietoja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les achats passent par l’App Store d’Apple. GaleriQ n’envoie jamais vos photos, noms ou métadonnées."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ખરીદી Apple ના App Store દ્વારા થાય છે. GaleriQ આ માટે ક્યારેય તમારા ફોટા, નામ કે મેટાડેટા મોકલતું નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הרכישות מתבצעות דרך App Store של Apple. ‏GaleriQ אף פעם לא שולחת לשם כך את התמונות, השמות או המטא־נתונים שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खरीदारी Apple के App Store से होती है। GaleriQ इसके लिए कभी आपकी फ़ोटो, नाम या मेटाडेटा नहीं भेजता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kupnje idu preko Appleova App Storea. GaleriQ za to nikad ne šalje tvoje fotografije, nazive ni metapodatke."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A vásárlások az Apple App Store-ján keresztül történnek. A GaleriQ ehhez sosem küldi el a fotóidat, neveket vagy metaadatokat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembelian memakai App Store milik Apple. GaleriQ tidak pernah mengirim foto, nama, atau metadata untuk ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli acquisti usano l’App Store di Apple. GaleriQ non invia mai foto, nomi o metadati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入にはAppleのApp Storeを使用します。GaleriQが写真、名前、メタデータを送信することはありません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಖರೀದಿಗಳು Apple ನ App Store ಬಳಸುತ್ತವೆ. ಇದಕ್ಕಾಗಿ GaleriQ ಎಂದಿಗೂ ನಿಮ್ಮ ಫೋಟೋಗಳು, ಹೆಸರುಗಳು ಅಥವಾ ಮೆಟಾಡೇಟಾ ಕಳುಹಿಸುವುದಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매는 Apple App Store를 사용합니다. GaleriQ는 사진, 이름 또는 메타데이터를 전송하지 않습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വാങ്ങലുകൾ Apple-ന്റെ App Store ഉപയോഗിക്കുന്നു. ഇതിനായി GaleriQ ഒരിക്കലും നിങ്ങളുടെ ഫോട്ടോകളോ പേരുകളോ മെറ്റാഡാറ്റയോ അയയ്ക്കില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "खरेदी Apple च्या App Store द्वारे होते. GaleriQ यासाठी कधीही तुमचे फोटो, नावे किंवा मेटाडेटा पाठवत नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembelian menggunakan App Store Apple. GaleriQ tidak pernah menghantar foto, nama atau metadata anda untuk ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjøp skjer via Apples App Store. GaleriQ sender aldri bildene, navnene eller metadataene dine i den forbindelse."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aankopen lopen via Apples App Store. GaleriQ verstuurt hiervoor nooit foto’s, namen of metadata."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "କିଣାକିଣି Appleର App Store ବ୍ୟବହାର କରେ। ଏଥିପାଇଁ GaleriQ କେବେ ଆପଣଙ୍କ ଫଟୋ, ନାମ କିମ୍ବା ମେଟାଡାଟା ପଠାଏ ନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਖ਼ਰੀਦਦਾਰੀ Apple ਦਾ App Store ਵਰਤਦੀ ਹੈ। GaleriQ ਇਸ ਲਈ ਕਦੇ ਵੀ ਤੁਹਾਡੀਆਂ ਫ਼ੋਟੋਆਂ, ਨਾਂ ਜਾਂ ਮੈਟਾਡਾਟਾ ਨਹੀਂ ਭੇਜਦਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakupy odbywają się przez App Store Apple. GaleriQ nigdy nie wysyła zdjęć, nazw ani metadanych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As compras usam a App Store da Apple. O GaleriQ nunca envia suas fotos, nomes ou metadados para isso."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As compras usam a App Store da Apple. O GaleriQ nunca envia fotografias, nomes ou metadados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Achizițiile folosesc App Store Apple. GaleriQ nu trimite niciodată poze, nume sau metadate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покупки проходят через App Store Apple. GaleriQ никогда не отправляет фотографии, имена или метаданные."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nákupy prebiehajú cez App Store od Applu. GaleriQ na to nikdy neposiela vaše fotky, názvy ani metadáta."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakupi potekajo prek Applove trgovine App Store. GaleriQ za to nikoli ne pošilja tvojih fotografij, imen ali metapodatkov."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Köp sker via Apples App Store. GaleriQ skickar aldrig dina bilder, namn eller metadata för detta."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வாங்குதல்கள் Apple-இன் App Store-ஐப் பயன்படுத்துகின்றன. இதற்காக GaleriQ ஒருபோதும் உங்கள் புகைப்படங்கள், பெயர்கள் அல்லது மெட்டாடேட்டாவை அனுப்பாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కొనుగోళ్లు Apple App Storeను వాడతాయి. దీని కోసం GaleriQ ఎప్పుడూ మీ ఫోటోలు, పేర్లు లేదా మెటాడేటాను పంపదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การซื้อใช้ App Store ของ Apple GaleriQ ไม่เคยส่งรูปภาพ ชื่อ หรือข้อมูลเมตาของคุณเพื่อการนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satın alımlar Apple App Store üzerinden yapılır. GaleriQ fotoğraf, ad veya meta veri göndermez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Покупки здійснюються через App Store Apple. GaleriQ ніколи не надсилає фото, назви чи метадані."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "خریداری Apple کے App Store سے ہوتی ہے۔ GaleriQ اس کے لیے کبھی آپ کی تصاویر، نام یا میٹا ڈیٹا نہیں بھیجتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc mua dùng App Store của Apple. GaleriQ không bao giờ gửi ảnh, tên hay siêu dữ liệu của bạn cho việc này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "购买通过 Apple App Store 完成。GaleriQ 绝不会为此发送照片、名称或元数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "購買透過 Apple 的 App Store 進行。GaleriQ 從不會為此傳送你的照片、名稱或後設資料。"
          }
        }
      }
    },
    "privacy_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يطّلع GaleriQ على صورك ومقاطع الفيديو والملفات المسموح بها على جهازك فقط. لا تحتاج إلى حساب، ولا يوجد خادم لـ GaleriQ. من المفيد أن تعرف: مع الخدمات السحابية مثل صور Google قد يختفي ما تحذفه من أجهزتك الأخرى أيضًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ আপনার ফটো, ভিডিও ও অনুমোদিত ফাইল শুধু আপনার ডিভাইসে দেখে। আপনার কোনো অ্যাকাউন্ট লাগে না, এবং কোনো GaleriQ সার্ভার নেই। জেনে রাখা ভালো: Google Photos-এর মতো ক্লাউড সেবায় আপনি যা মুছবেন তা আপনার অন্য ডিভাইস থেকেও মুছে যেতে পারে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ mira les teves fotos, vídeos i fitxers permesos només al dispositiu. No et cal cap compte i no hi ha cap servidor de GaleriQ. Bo de saber: amb serveis al núvol com Google Fotos, el que esborres també pot desaparèixer dels teus altres dispositius."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ prohlíží vaše fotky, videa a povolené soubory jen ve vašem zařízení. Nepotřebujete účet a žádný server GaleriQ neexistuje. Dobré vědět: u cloudových služeb jako Fotky Google může to, co smažete, zmizet i na vašich dalších zařízeních."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ser kun på dine fotos, videoer og tilladte filer på din enhed. Du behøver ingen konto, og der er ingen GaleriQ-server. Godt at vide: med skytjenester som Google Fotos kan det, du sletter, også forsvinde på dine andre enheder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ sieht sich deine Fotos, Videos und freigegebenen Dateien nur auf deinem Gerät an. Du brauchst kein Konto, und es gibt keinen GaleriQ-Server. Gut zu wissen: Bei Cloud-Diensten wie Google Fotos kann Gelöschtes auch auf deinen anderen Geräten verschwinden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το GaleriQ βλέπει τις φωτογραφίες, τα βίντεο και τα επιτρεπόμενα αρχεία σου μόνο στη συσκευή σου. Δεν χρειάζεσαι λογαριασμό και δεν υπάρχει διακομιστής GaleriQ. Καλό να ξέρεις: με υπηρεσίες cloud όπως το Google Photos, ό,τι διαγράφεις μπορεί να χαθεί και από τις άλλες συσκευές σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ looks at your photos, videos and allowed files only on your device. You don’t need an account, and there’s no GaleriQ server. Good to know: with cloud services like Google Photos, things you delete may also disappear on your other devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ mira tus fotos, vídeos y archivos permitidos solo en tu dispositivo. No necesitas cuenta y no hay servidor de GaleriQ. Ten en cuenta que con servicios en la nube como Google Fotos lo que borres puede desaparecer también en tus otros dispositivos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ katsoo kuviasi, videoitasi ja sallittuja tiedostoja vain laitteellasi. Et tarvitse tiliä, eikä GaleriQ-palvelinta ole. Hyvä tietää: pilvipalveluissa, kuten Google Kuvissa, poistamasi voi kadota myös muilta laitteiltasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ consulte vos photos, vidéos et fichiers autorisés uniquement sur votre appareil. Pas besoin de compte, et il n’y a pas de serveur GaleriQ. Bon à savoir : avec des services cloud comme Google Photos, ce que vous supprimez peut aussi disparaître de vos autres appareils."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ તમારા ફોટા, વીડિયો અને મંજૂર ફાઇલો ફક્ત તમારા ઉપકરણ પર જુએ છે. તમારે એકાઉન્ટની જરૂર નથી, અને કોઈ GaleriQ સર્વર નથી. જાણવા જેવું: Google Photos જેવી ક્લાઉડ સેવાઓમાં તમે જે ડિલીટ કરો તે તમારાં બીજાં ઉપકરણોમાંથી પણ ગાયબ થઈ શકે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ צופה בתמונות, בסרטונים ובקבצים המותרים רק במכשיר שלך. לא צריך חשבון, ואין שרת של GaleriQ. כדאי לדעת: בשירותי ענן כמו Google Photos, מה שנמחק עלול להיעלם גם במכשירים האחרים שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ आपकी फ़ोटो, वीडियो और अनुमत फ़ाइलें सिर्फ़ आपके डिवाइस पर देखता है। आपको खाते की ज़रूरत नहीं, और कोई GaleriQ सर्वर नहीं है। ध्यान दें: Google Photos जैसी क्लाउड सेवाओं में जो आप डिलीट करते हैं, वह आपके दूसरे डिवाइस से भी गायब हो सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ pregledava tvoje fotografije, videozapise i dopuštene datoteke samo na tvom uređaju. Ne trebaš račun i ne postoji GaleriQ poslužitelj. Dobro je znati: kod usluga u oblaku poput Google fotografija ono što izbrišeš može nestati i na tvojim drugim uređajima."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A GaleriQ csak az eszközödön nézi a fotóidat, videóidat és engedélyezett fájljaidat. Nem kell fiók, és nincs GaleriQ-szerver. Jó tudni: felhőszolgáltatásoknál, például a Google Fotóknál, amit törölsz, a többi eszközödről is eltűnhet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ melihat foto, video, dan file yang diizinkan hanya di perangkatmu. Kamu tidak perlu akun, dan tidak ada server GaleriQ. Perlu diketahui: dengan layanan cloud seperti Google Foto, yang kamu hapus mungkin juga hilang di perangkatmu yang lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ guarda foto, video e file consentiti solo sul tuo dispositivo. Non serve un account e non esiste un server GaleriQ. Buono a sapersi: con servizi cloud come Google Foto ciò che elimini può sparire anche sugli altri dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ は写真・動画・許可したファイルを端末の中だけで扱います。アカウントは不要で、GaleriQ のサーバーもありません。なお、Google フォトなどのクラウドでは、削除したものがほかの端末からも消えることがあります。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ನಿಮ್ಮ ಫೋಟೋಗಳು, ವೀಡಿಯೊಗಳು ಮತ್ತು ಅನುಮತಿಸಿದ ಫೈಲ್‌ಗಳನ್ನು ನಿಮ್ಮ ಸಾಧನದಲ್ಲಿ ಮಾತ್ರ ನೋಡುತ್ತದೆ. ನಿಮಗೆ ಖಾತೆ ಬೇಕಿಲ್ಲ, ಮತ್ತು GaleriQ ಸರ್ವರ್ ಇಲ್ಲ. ತಿಳಿದಿರಲಿ: Google Photos ನಂತಹ ಕ್ಲೌಡ್ ಸೇವೆಗಳಲ್ಲಿ, ನೀವು ಅಳಿಸುವುದು ನಿಮ್ಮ ಇತರ ಸಾಧನಗಳಿಂದಲೂ ಮಾಯವಾಗಬಹುದು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ는 사진, 동영상, 허용한 파일을 기기 안에서만 봐요. 계정이 필요 없고 GaleriQ 서버도 없어요. 참고: Google 포토 같은 클라우드에서는 지운 것이 다른 기기에서도 사라질 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ നിങ്ങളുടെ ഫോട്ടോകളും വീഡിയോകളും അനുവദിച്ച ഫയലുകളും നിങ്ങളുടെ ഉപകരണത്തിൽ മാത്രം നോക്കുന്നു. നിങ്ങൾക്ക് അക്കൗണ്ട് ആവശ്യമില്ല, GaleriQ സെർവറും ഇല്ല. അറിഞ്ഞിരിക്കുക: Google Photos പോലുള്ള ക്ലൗഡ് സേവനങ്ങളിൽ, നിങ്ങൾ ഇല്ലാതാക്കുന്നവ നിങ്ങളുടെ മറ്റ് ഉപകരണങ്ങളിൽ നിന്നും അപ്രത്യക്ഷമായേക്കാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ तुमचे फोटो, व्हिडिओ आणि परवानगी असलेल्या फाइल्स फक्त तुमच्या डिव्हाइसवर पाहते. तुम्हाला खात्याची गरज नाही आणि GaleriQ सर्व्हर नाही. लक्षात ठेवा: Google Photos सारख्या क्लाउड सेवांमध्ये तुम्ही जे डिलीट करता ते तुमच्या इतर डिव्हाइसवरूनही गायब होऊ शकते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ melihat foto, video dan fail yang dibenarkan hanya pada peranti anda. Anda tidak memerlukan akaun, dan tiada pelayan GaleriQ. Untuk makluman: dengan perkhidmatan awan seperti Google Photos, perkara yang anda padam mungkin turut hilang pada peranti anda yang lain."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ser på bildene, videoene og de tillatte filene dine bare på enheten din. Du trenger ingen konto, og det finnes ingen GaleriQ-server. Greit å vite: med skytjenester som Google Foto kan det du sletter, også forsvinne på de andre enhetene dine."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ bekijkt je foto’s, video’s en toegestane bestanden alleen op je apparaat. Je hebt geen account nodig en er is geen GaleriQ-server. Goed om te weten: bij clouddiensten zoals Google Foto kan wat je verwijdert ook op je andere apparaten verdwijnen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ଆପଣଙ୍କ ଫଟୋ, ଭିଡିଓ ଓ ଅନୁମୋଦିତ ଫାଇଲ୍ କେବଳ ଆପଣଙ୍କ ଡିଭାଇସ୍‌ରେ ଦେଖେ। ଆପଣଙ୍କୁ ଆକାଉଣ୍ଟ ଦରକାର ନାହିଁ, ଏବଂ କୌଣସି GaleriQ ସର୍ଭର ନାହିଁ। ଜାଣିବା ଭଲ: Google Photos ଭଳି କ୍ଲାଉଡ୍ ସେବାରେ ଆପଣ ଯାହା ଡିଲିଟ୍ କରନ୍ତି ତାହା ଆପଣଙ୍କ ଅନ୍ୟ ଡିଭାଇସ୍‌ରୁ ମଧ୍ୟ ଚାଲିଯାଇପାରେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ਤੁਹਾਡੀਆਂ ਫ਼ੋਟੋਆਂ, ਵੀਡੀਓ ਅਤੇ ਇਜਾਜ਼ਤ ਦਿੱਤੀਆਂ ਫ਼ਾਈਲਾਂ ਸਿਰਫ਼ ਤੁਹਾਡੇ ਡਿਵਾਈਸ ਉੱਤੇ ਦੇਖਦਾ ਹੈ। ਤੁਹਾਨੂੰ ਖਾਤੇ ਦੀ ਲੋੜ ਨਹੀਂ, ਅਤੇ ਕੋਈ GaleriQ ਸਰਵਰ ਨਹੀਂ। ਜਾਣਨਾ ਚੰਗਾ ਹੈ: Google Photos ਵਰਗੀਆਂ ਕਲਾਊਡ ਸੇਵਾਵਾਂ ਨਾਲ, ਤੁਹਾਡੀਆਂ ਮਿਟਾਈਆਂ ਚੀਜ਼ਾਂ ਤੁਹਾਡੇ ਹੋਰ ਡਿਵਾਈਸਾਂ ਤੋਂ ਵੀ ਗ਼ਾਇਬ ਹੋ ਸਕਦੀਆਂ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ przegląda zdjęcia, filmy i dozwolone pliki tylko na Twoim urządzeniu. Nie potrzebujesz konta i nie ma serwera GaleriQ. Warto wiedzieć: w usługach chmurowych, takich jak Zdjęcia Google, usunięte rzeczy mogą zniknąć też z innych urządzeń."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O GaleriQ analisa suas fotos, vídeos e arquivos permitidos só no seu aparelho. Você não precisa de conta e não há servidor do GaleriQ. Bom saber: com serviços de nuvem como o Google Fotos, o que você apagar também pode sumir nos seus outros aparelhos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O GaleriQ vê as suas fotos, vídeos e ficheiros permitidos apenas no seu dispositivo. Não precisa de conta e não existe servidor GaleriQ. É bom saber: em serviços na nuvem como o Google Fotos, o que eliminar pode desaparecer também nos outros dispositivos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ se uită la fotografiile, videoclipurile și fișierele permise doar pe dispozitivul tău. Nu ai nevoie de cont și nu există server GaleriQ. Bine de știut: la servicii cloud precum Google Foto, ce ștergi poate dispărea și de pe celelalte dispozitive."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ просматривает ваши фото, видео и разрешённые файлы только на устройстве. Аккаунт не нужен, и сервера GaleriQ нет. Полезно знать: в облачных сервисах вроде Google Фото удалённое может исчезнуть и на других устройствах."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ prezerá vaše fotky, videá a povolené súbory len vo vašom zariadení. Nepotrebujete účet a žiadny server GaleriQ neexistuje. Dobré vedieť: pri cloudových službách ako Fotky Google môže to, čo vymažete, zmiznúť aj na vašich ďalších zariadeniach."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ pregleduje tvoje fotografije, videoposnetke in dovoljene datoteke samo v tvoji napravi. Računa ne potrebuješ in strežnika GaleriQ ni. Dobro je vedeti: pri storitvah v oblaku, kot je Google Foto, lahko kar izbrišeš izgine tudi v tvojih drugih napravah."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ tittar på dina bilder, videor och tillåtna filer bara på din enhet. Du behöver inget konto och det finns ingen GaleriQ-server. Bra att veta: med molntjänster som Google Foto kan det du raderar försvinna även på dina andra enheter."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ உங்கள் புகைப்படங்கள், வீடியோக்கள், அனுமதித்த கோப்புகளை உங்கள் சாதனத்தில் மட்டுமே பார்க்கிறது. உங்களுக்குக் கணக்கு தேவையில்லை, GaleriQ சேவையகமும் இல்லை. தெரிந்துகொள்ளுங்கள்: Google Photos போன்ற மேகக்கணிச் சேவைகளில், நீங்கள் நீக்குபவை உங்கள் மற்ற சாதனங்களிலிருந்தும் மறையக்கூடும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ మీ ఫోటోలు, వీడియోలు, అనుమతించిన ఫైళ్లను మీ పరికరంలో మాత్రమే చూస్తుంది. మీకు ఖాతా అవసరం లేదు, GaleriQ సర్వర్ లేదు. తెలుసుకోండి: Google Photos వంటి క్లౌడ్ సేవల్లో, మీరు తొలగించినవి మీ ఇతర పరికరాల నుండి కూడా మాయమవ్వవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ดูรูปภาพ วิดีโอ และไฟล์ที่อนุญาตบนอุปกรณ์ของคุณเท่านั้น คุณไม่ต้องมีบัญชี และไม่มีเซิร์ฟเวอร์ของ GaleriQ ควรรู้: กับบริการคลาวด์อย่าง Google Photos สิ่งที่คุณลบอาจหายไปจากอุปกรณ์อื่นด้วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ fotoğraflarına, videolarına ve izin verdiğin dosyalara yalnızca cihazında bakar. Hesap gerekmez ve GaleriQ sunucusu yoktur. Bilmekte fayda var: Google Fotoğraflar gibi bulut hizmetlerinde sildiklerin diğer cihazlarından da kaybolabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ переглядає ваші фото, відео й дозволені файли лише на пристрої. Обліковий запис не потрібен, і сервера GaleriQ немає. Варто знати: у хмарних сервісах, як-от Google Фото, видалене може зникнути й на інших пристроях."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ آپ کی تصاویر، ویڈیوز اور اجازت یافتہ فائلیں صرف آپ کی ڈیوائس پر دیکھتا ہے۔ آپ کو اکاؤنٹ کی ضرورت نہیں، اور کوئی GaleriQ سرور نہیں۔ جاننا اچھا ہے: Google Photos جیسی کلاؤڈ سروسز میں جو آپ حذف کرتے ہیں، وہ آپ کی دوسری ڈیوائسز سے بھی غائب ہو سکتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ chỉ xem ảnh, video và tệp được phép trên thiết bị của bạn. Bạn không cần tài khoản và không có máy chủ GaleriQ. Lưu ý: với dịch vụ đám mây như Google Photos, những gì bạn xóa cũng có thể biến mất trên các thiết bị khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ 只在你的设备上查看照片、视频和你允许的文件。无需账户，也没有 GaleriQ 服务器。请注意：在 Google 相册等云服务中，你删除的内容也可能从其他设备上消失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ 只在你的裝置上查看你的照片、影片和允許的檔案。你不需要帳號，也沒有 GaleriQ 伺服器。小提醒：使用 Google 相簿等雲端服務時，你刪除的內容也可能從其他裝置上消失。"
          }
        }
      }
    },
