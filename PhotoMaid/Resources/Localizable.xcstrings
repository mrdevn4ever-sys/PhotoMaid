    "edit_mk_redact_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مع «تنقيط» و«تمويه» قد تظهر الحدود. للنص الذي يجب ألا يُقرأ أبدًا اختر «معتم»."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "“পিক্সেলেট” ও “ঝাপসা”-তে রেখা তবুও দেখা যেতে পারে। যে লেখা একেবারে পড়া যাওয়া উচিত নয়, তার জন্য “নিরেট” বেছে নিন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Amb «Pixelar» i «Desenfocar» encara es poden veure contorns. Per a text que ha de ser il·legible, tria «Opac»."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "U „Pixelovat“ a „Rozmazat“ mohou být obrysy stále vidět. Pro text, který musí zůstat nečitelný, zvolte „Plné“."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Med “Pixelér” og “Slør” kan konturer stadig ses. Til tekst, der skal forblive ulæselig, vælger du “Heldækkende”."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei „Verpixeln“ und „Unschärfe“ kann man Umrisse noch erahnen. Für Text, der sicher unlesbar sein soll, nimm lieber „Deckend“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Με «Pixel» και «Θόλωμα» μπορεί να φαίνονται ακόμη περιγράμματα. Για κείμενο που πρέπει να μείνει δυσανάγνωστο, επίλεξε «Συμπαγές»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With “Pixelate” and “Blur” outlines may still show. For text that must stay unreadable, choose “Solid”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con «Pixelar» y «Desenfocar» aún se intuyen las formas. Para texto que no deba leerse, elige «Opaco»."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "”Pikselöi”- ja ”Sumenna”-tehosteilla ääriviivat voivat yhä näkyä. Valitse ”Peittävä” tekstille, jonka on pysyttävä lukukelvottomana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec « Pixelliser » et « Flou », on devine encore les contours. Pour un texte qui doit rester illisible, choisissez « Opaque »."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "“પિક્સેલેટ” અને “ઝાંખું” માં રૂપરેખા હજી દેખાઈ શકે છે. જે ટેક્સ્ટ વાંચી ન શકાય તેવું રહેવું જોઈએ તેના માટે “નક્કર” પસંદ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עם „פיקסלציה” ו„טשטוש” ייתכן שקווי מתאר עדיין ייראו. לטקסט שחייב להישאר בלתי קריא, יש לבחור „מלא”."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“पिक्सलेट” और “धुँधला” में रूपरेखा अभी भी दिख सकती है। जो टेक्स्ट बिल्कुल न पढ़ा जाए, उसके लिए “ठोस” चुनें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uz „Pikseliziraj” i „Zamuti” obrisi se i dalje mogu vidjeti. Za tekst koji mora ostati nečitljiv odaberi „Puno”."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A „Pixelezés” és az „Elmosás” esetén a körvonalak még látszhatnak. Az olvashatatlannak szánt szöveghez válaszd a „Teli” lehetőséget."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengan “Piksel” dan “Buram”, garis bentuk mungkin masih terlihat. Untuk teks yang harus tetap tak terbaca, pilih “Solid”."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con «Pixel» e «Sfocatura» si intuiscono ancora i contorni. Per un testo che deve restare illeggibile, scegli «Coprente»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「モザイク」や「ぼかし」では輪郭がわかることがあります。読めないようにしたい文字には「塗りつぶし」を使ってください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "“ಪಿಕ್ಸಲೇಟ್” ಮತ್ತು “ಮಸುಕು” ನಲ್ಲಿ ರೂಪರೇಖೆಗಳು ಇನ್ನೂ ಕಾಣಿಸಬಹುದು. ಓದಲೇಬಾರದ ಪಠ್ಯಕ್ಕೆ “ಘನ” ಆಯ್ಕೆಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘모자이크’와 ‘흐림’은 윤곽이 보일 수 있어요. 꼭 읽히면 안 되는 글자에는 ‘불투명’을 쓰세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "“പിക്സലേറ്റ്”, “മങ്ങിക്കുക” എന്നിവയിൽ രൂപരേഖകൾ ഇപ്പോഴും കാണാം. ഒട്ടും വായിക്കാനാകരുതാത്ത എഴുത്തിന് “ഖരം” തിരഞ്ഞെടുക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "“पिक्सेलेट” आणि “धूसर” मध्ये बाह्यरेषा अजूनही दिसू शकतात. जो मजकूर वाचता येऊ नये त्यासाठी “भरीव” निवडा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengan “Piksel” dan “Kabur”, garis luar mungkin masih kelihatan. Untuk teks yang mesti kekal tidak boleh dibaca, pilih “Pejal”."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Med «Piksler» og «Gjør uskarp» kan konturer fortsatt synes. For tekst som må forbli uleselig, velg «Heldekkende»."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij ‘Pixeleren’ en ‘Vervagen’ zie je contouren soms nog. Voor tekst die echt onleesbaar moet zijn, kies je ‘Dekkend’."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "“ପିକ୍ସେଲେଟ୍” ଓ “ଅସ୍ପଷ୍ଟ”ରେ ରୂପରେଖା ତଥାପି ଦେଖାଯାଇପାରେ। ଯେଉଁ ଲେଖା ଆଦୌ ପଢ଼ାଯିବା ଉଚିତ ନୁହେଁ, ସେଥିପାଇଁ “ଠୋସ୍” ବାଛନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "“ਪਿਕਸਲੇਟ” ਅਤੇ “ਧੁੰਦਲਾ” ਨਾਲ ਰੂਪ-ਰੇਖਾ ਹਾਲੇ ਵੀ ਦਿਸ ਸਕਦੀ ਹੈ। ਜੋ ਟੈਕਸਟ ਬਿਲਕੁਲ ਪੜ੍ਹਿਆ ਨਹੀਂ ਜਾਣਾ ਚਾਹੀਦਾ, ਉਸ ਲਈ “ਠੋਸ” ਚੁਣੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przy „Pikselizuj” i „Rozmycie” kontury mogą być nadal widoczne. Dla tekstu, który ma być nieczytelny, wybierz „Kryjące”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com “Pixelar” e “Desfocar”, os contornos ainda podem aparecer. Para texto que deve ficar ilegível, escolha “Sólido”."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Com «Pixelizar» e «Desfocar» ainda se adivinham os contornos. Para texto que não deve ser lido, escolha «Opaco»."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "La „Pixelare” și „Estompare” se mai pot ghici contururile. Pentru text care trebuie să rămână ilizibil, alege „Opac”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При «Пикселизации» и «Размытии» контуры ещё можно угадать. Для текста, который нельзя прочитать, выберите «Сплошная заливка»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pri „Pixelovať“ a „Rozmazať“ môžu byť obrysy stále viditeľné. Pre text, ktorý musí zostať nečitateľný, zvoľte „Plné“."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pri »Pikseliziraj« in »Zamegli« so obrisi morda še vidni. Za besedilo, ki mora ostati neberljivo, izberi »Polno«."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Med ”Pixla” och ”Oskärpa” kan konturer fortfarande synas. För text som måste bli oläslig väljer du ”Heltäckande”."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "“பிக்சலேட்” மற்றும் “மங்கலாக்கு” மூலம் வடிவக்கோடுகள் இன்னும் தெரியலாம். படிக்கவே முடியாமல் இருக்க வேண்டிய உரைக்கு “திடம்” என்பதைத் தேர்ந்தெடுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "“పిక్సలేట్”, “మసక” తో రూపరేఖలు ఇంకా కనిపించవచ్చు. అస్సలు చదవకూడని టెక్స్ట్ కోసం “ఘనం” ఎంచుకోండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ด้วย “พิกเซล” และ “เบลอ” โครงร่างอาจยังมองเห็นได้ สำหรับข้อความที่ต้องอ่านไม่ออกจริงๆ ให้เลือก “ทึบ”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Pikselleştir” ve “Bulanıklaştır” ile hatlar hâlâ seçilebilir. Okunmaması gereken yazılar için “Opak”ı seç."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "При «Пікселізації» та «Розмитті» контури ще можна вгадати. Для тексту, який не мають прочитати, оберіть «Суцільна заливка»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "”پکسلیٹ“ اور ”دھندلا“ میں خاکہ اب بھی دکھ سکتا ہے۔ جو متن بالکل نہ پڑھا جائے، اس کے لیے ”ٹھوس“ منتخب کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Với “Làm mờ ô vuông” và “Làm mờ”, đường nét vẫn có thể lộ ra. Với chữ cần phải không đọc được, hãy chọn “Đặc”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用“像素化”和“模糊”时仍可能看出轮廓。对于必须无法辨认的文字，请选择“不透明”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用「馬賽克」和「模糊」時，輪廓仍可能看得出來。若文字必須無法辨識，請選擇「實心」。"
          }
        }
      }
    },
    "edit_mk_redact_solid_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "موصى به للتفاصيل الخاصة: ما تغطيه يختفي فعلًا من الملف المحفوظ أو المشارَك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ব্যক্তিগত তথ্যের জন্য প্রস্তাবিত: আপনি যা ঢাকেন তা সংরক্ষিত বা শেয়ার করা ফাইল থেকে সত্যিই মুছে যায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Recomanat per a dades privades: el que tapes desapareix de debò al fitxer desat o compartit."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Doporučeno pro soukromé údaje: co zakryjete, v uloženém nebo sdíleném souboru opravdu zmizí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Anbefales til private detaljer: det, du dækker til, er virkelig væk i den gemte eller delte fil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Empfohlen für Persönliches: Was du abdeckst, ist in der gespeicherten oder geteilten Datei wirklich weg."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προτείνεται για ιδιωτικά στοιχεία: ό,τι καλύπτεις χάνεται πραγματικά στο αποθηκευμένο ή κοινόχρηστο αρχείο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recommended for private details: whatever you cover is really gone in the saved or shared file."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recomendado para datos personales: lo que tapes desaparece de verdad en el archivo guardado o compartido."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suositeltu yksityisille tiedoille: peittämäsi kohta katoaa oikeasti tallennetusta tai jaetusta tiedostosta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recommandé pour les infos personnelles : ce que vous masquez disparaît vraiment du fichier enregistré ou partagé."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ખાનગી વિગતો માટે ભલામણ: તમે જે ઢાંકો તે સાચવેલી કે શેર કરેલી ફાઇલમાંથી ખરેખર ગાયબ થાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מומלץ לפרטים פרטיים: מה שמכסים באמת נעלם בקובץ שנשמר או שותף."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निजी जानकारी के लिए सुझाया गया: जो आप ढकते हैं, वह सहेजी या शेयर की गई फ़ाइल से सच में गायब हो जाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Preporučeno za privatne podatke: ono što prekriješ stvarno nestaje u spremljenoj ili podijeljenoj datoteci."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Személyes adatokhoz ajánlott: amit letakarsz, az a mentett vagy megosztott fájlból valóban eltűnik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Disarankan untuk detail pribadi: apa yang kamu tutupi benar-benar hilang di file yang disimpan atau dibagikan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consigliato per i dati personali: ciò che copri sparisce davvero dal file salvato o condiviso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "個人的な情報に最適：隠した部分は、保存・共有したファイルから本当に消えます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಖಾಸಗಿ ವಿವರಗಳಿಗೆ ಶಿಫಾರಸು: ನೀವು ಮರೆಮಾಚುವುದು ಉಳಿಸಿದ ಅಥವಾ ಹಂಚಿಕೊಂಡ ಫೈಲ್‌ನಿಂದ ನಿಜವಾಗಿಯೂ ಹೋಗುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개인 정보에 추천해요: 가린 부분은 저장하거나 공유한 파일에서 정말로 사라져요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്വകാര്യ വിവരങ്ങൾക്ക് ശുപാർശ: നിങ്ങൾ മറയ്ക്കുന്നത് സംരക്ഷിച്ചതോ പങ്കിട്ടതോ ആയ ഫയലിൽ നിന്ന് ശരിക്കും ഇല്ലാതാകും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "खाजगी तपशिलांसाठी शिफारस: तुम्ही जे झाकता ते जतन केलेल्या किंवा शेअर केलेल्या फाइलमधून खरोखर नाहीसे होते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Disyorkan untuk butiran peribadi: apa yang anda tutup benar-benar hilang dalam fail yang disimpan atau dikongsi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Anbefales for private detaljer: det du dekker til, er virkelig borte i den lagrede eller delte filen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aanbevolen voor persoonlijke details: wat je afdekt, is in het opgeslagen of gedeelde bestand echt weg."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ବ୍ୟକ୍ତିଗତ ବିବରଣୀ ପାଇଁ ସୁପାରିଶ: ଆପଣ ଯାହା ଢାଙ୍କନ୍ତି ତାହା ସେଭ୍ କିମ୍ବା ସେୟାର୍ ହୋଇଥିବା ଫାଇଲ୍‌ରୁ ସତରେ ଚାଲିଯାଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਨਿੱਜੀ ਵੇਰਵਿਆਂ ਲਈ ਸਿਫ਼ਾਰਸ਼ੀ: ਜੋ ਵੀ ਤੁਸੀਂ ਢਕਦੇ ਹੋ, ਉਹ ਸੰਭਾਲੀ ਜਾਂ ਸਾਂਝੀ ਕੀਤੀ ਫ਼ਾਈਲ ਵਿੱਚੋਂ ਸੱਚਮੁੱਚ ਹਟ ਜਾਂਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zalecane dla danych osobistych: to, co zakryjesz, naprawdę znika z zapisanego lub udostępnionego pliku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Recomendado para detalhes privados: o que você cobre some de verdade no arquivo salvo ou compartilhado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Recomendado para dados pessoais: o que tapar desaparece mesmo do ficheiro guardado ou partilhado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Recomandat pentru date personale: ce acoperi dispare cu adevărat din fișierul salvat sau partajat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рекомендуется для личного: то, что вы закрыли, действительно исчезает из сохранённого или отправленного файла."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odporúčané pre súkromné údaje: čo zakryjete, v uloženom alebo zdieľanom súbore naozaj zmizne."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Priporočeno za zasebne podatke: kar prekriješ, v shranjeni ali deljeni datoteki res izgine."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekommenderas för privata detaljer: det du täcker är verkligen borta i den sparade eller delade filen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தனிப்பட்ட விவரங்களுக்குப் பரிந்துரைக்கப்படுகிறது: நீங்கள் மறைப்பது சேமித்த அல்லது பகிர்ந்த கோப்பிலிருந்து உண்மையில் நீங்கிவிடும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వ్యక్తిగత వివరాలకు సిఫార్సు: మీరు కప్పినది సేవ్ చేసిన లేదా షేర్ చేసిన ఫైల్ నుండి నిజంగా పోతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แนะนำสำหรับรายละเอียดส่วนตัว: สิ่งที่คุณปิดทับจะหายไปจริงในไฟล์ที่บันทึกหรือแชร์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kişisel bilgiler için önerilir: Kapattığın şey kaydedilen veya paylaşılan dosyadan gerçekten silinir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рекомендовано для особистого: те, що ви закрили, справді зникає зі збереженого чи надісланого файлу."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نجی تفصیلات کے لیے تجویز کردہ: جو آپ ڈھانپتے ہیں، وہ محفوظ یا شیئر کی گئی فائل سے واقعی غائب ہو جاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khuyên dùng cho chi tiết riêng tư: những gì bạn che sẽ thật sự biến mất trong tệp được lưu hoặc chia sẻ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "推荐用于个人信息：你遮盖的内容在保存或分享的文件中会真正消失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "建議用於私人細節：你遮蓋的內容會在儲存或分享的檔案中真正消失。"
          }
        }
      }
    },
