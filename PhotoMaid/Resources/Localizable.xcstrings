    "ana2_waiting_after": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في الانتظار – يبدأ تلقائيًا بمجرد انتهاء «%1$@»."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Venter – starter af sig selv, så snart “%1$@” er færdig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wartet – startet von selbst, sobald „%1$@“ fertig ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting – starts by itself as soon as “%1$@” is done."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En espera: empieza sola en cuanto termine «%1$@»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente – démarre d’elle-même dès que « %1$@ » est terminée."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menunggu – mulai sendiri begitu “%1$@” selesai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In attesa: parte da sola appena «%1$@» è finita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "待機中 –「%1$@」が終わりしだい自動で始まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대기 중 – ‘%1$@’이(가) 끝나면 자동으로 시작돼요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Venter – starter av seg selv så snart «%1$@» er ferdig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wacht – start vanzelf zodra ‘%1$@’ klaar is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czeka – uruchomi się sama, gdy „%1$@” się zakończy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguardando – começa sozinha assim que “%1$@” terminar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Em espera – começa sozinha assim que «%1$@» terminar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În așteptare – pornește singură imediat ce „%1$@” s-a terminat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ожидает – начнётся сам, как только «%1$@» завершится."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Väntar – startar av sig själv så snart ”%1$@” är klar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำลังรอ – จะเริ่มเองทันทีที่ “%1$@” เสร็จ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekliyor – “%1$@” biter bitmez kendiliğinden başlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Очікує – почнеться сам, щойно «%1$@» завершиться."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang chờ – tự bắt đầu ngay khi “%1$@” xong."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待中 –“%1$@”完成后会自动开始。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等待中 – 「%1$@」完成後會自動開始。"
          }
        }
      }
    },
