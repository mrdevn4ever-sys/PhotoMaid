            "state": "translated",
            "value": "保管庫とその中身をすべて削除しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "금고와 그 안의 모든 항목을 삭제할까요?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slette safen og alt i den?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kluis en alles erin verwijderen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunąć sejf i całą jego zawartość?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagar o cofre e tudo o que há nele?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagar o cofre e tudo o que contém?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ștergi seiful și tot ce conține?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить сейф и всё его содержимое?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Radera valvet och allt i det?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบตู้เซฟและทุกอย่างในนั้นใช่ไหม?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasa ve içindeki her şey silinsin mi?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видалити сейф і весь його вміст?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa két sắt và mọi thứ bên trong?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要删除保险箱及其中的所有内容吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要刪除保險箱及其中所有內容嗎？"
          }
