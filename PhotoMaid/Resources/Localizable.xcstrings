    "wf_reason_unreachable": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أصغر نسخة مقيسة: %1$@ – فوق الهدف، لذا لم يُنشأ ملف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleinste gemessene Fassung: %1$@ – über dem Ziel, daher wurde keine Datei erstellt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Smallest measured version: %1$@ – above the target, so no file was created."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Versión más pequeña medida: %1$@; supera el objetivo, por eso no se ha creado ningún archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus petite version mesurée : %1$@ – au-dessus de l’objectif, aucun fichier créé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Versione più piccola misurata: %1$@, sopra l’obiettivo, quindi nessun file creato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "測定した最小の版: %1$@ – 目標を超えるためファイルは作成されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "측정한 가장 작은 버전: %1$@ – 목표를 넘어 파일을 만들지 않았어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleinste gemeten versie: %1$@ – boven het doel, dus er is geen bestand gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najmniejsza zmierzona wersja: %1$@ – powyżej celu, więc nie utworzono pliku."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Versão mais pequena medida: %1$@ – acima do objetivo, por isso não foi criado nenhum ficheiro."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cea mai mică versiune măsurată: %1$@ – peste țintă, deci nu s-a creat niciun fișier."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наименьшая измеренная версия: %1$@ – выше цели, поэтому файл не создан."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ölçülen en küçük sürüm: %1$@ – hedefin üzerinde, bu yüzden dosya oluşturulmadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Найменша виміряна версія: %1$@ – вище мети, тому файл не створено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测得的最小版本：%1$@——超过目标，因此未创建文件。"
          }
        }
      }
