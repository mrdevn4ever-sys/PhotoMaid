    "tour_history_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هنا ترى ما احتفظت به أو استبعدته أو أجّلته. يمكنك تغيير أي قرار من هنا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দেখুন কী রেখেছেন, আলাদা রেখেছেন বা পরের জন্য রেখেছেন। এখানে এখনো যেকোনো সিদ্ধান্ত বদলাতে পারেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira què has conservat, apartat o desat per a més tard. Aquí encara pots canviar qualsevol decisió."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podívejte se, co jste ponechali, odložili nebo uložili na později. Každé rozhodnutí tu ještě můžete změnit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Se, hvad du har beholdt, lagt til side eller gemt til senere. Du kan stadig ændre enhver beslutning her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier siehst du, was du behalten, aussortiert oder auf später gelegt hast. Jede Entscheidung kannst du hier noch ändern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δες τι κράτησες, έβαλες στην άκρη ή αποθήκευσες για αργότερα. Εδώ μπορείς ακόμη να αλλάξεις κάθε απόφαση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See what you kept, set aside or saved for later. You can still change any decision here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí ves lo que has conservado, apartado o dejado para después. Puedes cambiar cualquier decisión."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Katso, mitä säilytit, siirsit syrjään tai tallensit myöhemmäksi. Voit vielä muuttaa minkä tahansa päätöksen täällä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyez ce que vous avez gardé, écarté ou remis à plus tard. Vous pouvez encore changer chaque décision ici."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે શું રાખ્યું, બાજુએ રાખ્યું કે પછી માટે સાચવ્યું તે જુઓ. અહીં તમે હજી કોઈ પણ નિર્ણય બદલી શકો છો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כאן רואים מה נשמר, הועבר הצידה או נשמר למאוחר יותר. עדיין אפשר לשנות כאן כל החלטה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "देखें कि आपने क्या रखा, अलग रखा या बाद के लिए सहेजा। यहाँ आप अब भी कोई भी फ़ैसला बदल सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pogledaj što si zadržao, odvojio ili spremio za kasnije. Ovdje još možeš promijeniti svaku odluku."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nézd meg, mit tartottál meg, tettél félre vagy mentettél későbbre. Itt még bármelyik döntést módosíthatod."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihat apa yang kamu simpan, sisihkan, atau tunda untuk nanti. Kamu masih bisa mengubah keputusan apa pun di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui vedi cosa hai tenuto, scartato o rimandato. Puoi ancora cambiare ogni decisione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残したもの、外したもの、あとで見るものを確認できます。どの判断もここで変更できます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಏನನ್ನು ಇರಿಸಿದ್ದೀರಿ, ಪಕ್ಕಕ್ಕಿಟ್ಟಿದ್ದೀರಿ ಅಥವಾ ನಂತರಕ್ಕೆ ಇರಿಸಿದ್ದೀರಿ ಎಂದು ನೋಡಿ. ಇಲ್ಲಿ ಇನ್ನೂ ಯಾವುದೇ ನಿರ್ಧಾರ ಬದಲಾಯಿಸಬಹುದು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관한 것, 골라낸 것, 나중에 볼 것을 확인할 수 있어요. 여기서 모든 결정을 바꿀 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ എന്ത് സൂക്ഷിച്ചു, മാറ്റിവച്ചു, പിന്നീടേക്ക് വച്ചു എന്ന് കാണുക. ഇവിടെ ഇനിയും ഏത് തീരുമാനവും മാറ്റാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही काय ठेवले, बाजूला ठेवले किंवा नंतरसाठी जतन केले ते पहा. इथे तुम्ही अजूनही कोणताही निर्णय बदलू शकता."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihat apa yang anda simpan, ketepikan atau simpan untuk nanti. Anda masih boleh menukar sebarang keputusan di sini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Se hva du har beholdt, lagt til side eller lagret til senere. Du kan fortsatt endre alle beslutninger her."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zie wat je hebt bewaard, apart gezet of voor later bewaard. Elke keuze kun je hier nog aanpassen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଦେଖନ୍ତୁ ଆପଣ କ’ଣ ରଖିଛନ୍ତି, ଅଲଗା ରଖିଛନ୍ତି କିମ୍ବା ପରେ ପାଇଁ ରଖିଛନ୍ତି। ଏଠାରେ ଆପଣ ଏବେ ବି ଯେକୌଣସି ନିଷ୍ପତ୍ତି ବଦଳାଇପାରିବେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਦੇਖੋ ਕਿ ਤੁਸੀਂ ਕੀ ਰੱਖਿਆ, ਵੱਖ ਰੱਖਿਆ ਜਾਂ ਬਾਅਦ ਲਈ ਰੱਖਿਆ। ਤੁਸੀਂ ਇੱਥੇ ਹਾਲੇ ਵੀ ਕੋਈ ਵੀ ਫ਼ੈਸਲਾ ਬਦਲ ਸਕਦੇ ਹੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobacz, co zachowujesz, odkładasz lub zostawiasz na później. Każdą decyzję możesz tu jeszcze zmienić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja o que você manteve, separou ou guardou para depois. Você ainda pode mudar qualquer decisão aqui."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja o que manteve, pôs de lado ou deixou para mais tarde. Pode ainda alterar qualquer decisão aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vezi ce ai păstrat, ai pus deoparte sau ai lăsat pe mai târziu. Poți schimba aici orice decizie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь видно, что вы оставили, отложили в сторону или на потом. Любое решение можно изменить."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozrite sa, čo ste ponechali, odložili alebo uložili na neskôr. Každé rozhodnutie tu ešte môžete zmeniť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poglej, kaj si obdržal, odložil ali shranil za pozneje. Tukaj lahko še spremeniš vsako odločitev."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Se vad du har behållit, lagt undan eller sparat till senare. Du kan fortfarande ändra alla beslut här."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் எதை வைத்தீர்கள், ஒதுக்கினீர்கள், பிறகுக்கு வைத்தீர்கள் என்பதைப் பாருங்கள். இங்கே இன்னும் எந்த முடிவையும் மாற்றலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఏమి ఉంచారో, పక్కన పెట్టారో, తర్వాతకు పెట్టారో చూడండి. ఇక్కడ ఇంకా ఏ నిర్ణయాన్నైనా మార్చవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูสิ่งที่คุณเก็บไว้ แยกไว้ หรือบันทึกไว้ทีหลัง คุณยังเปลี่ยนการตัดสินใจใดก็ได้ที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neyi tuttuğunu, ayırdığını veya sonraya bıraktığını burada görürsün. Her kararı burada değiştirebilirsin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут видно, що ви залишили, відклали вбік чи на потім. Будь-яке рішення можна змінити."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دیکھیں کہ آپ نے کیا رکھا، الگ رکھا یا بعد کے لیے محفوظ کیا۔ یہاں آپ اب بھی کوئی بھی فیصلہ بدل سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem những gì bạn đã giữ, để riêng hoặc để sau. Bạn vẫn có thể thay đổi mọi quyết định ở đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这里查看你保留、挑出或留到稍后的内容。任何决定都可以在这里更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "查看你保留、擱置或存為稍後的內容。你仍可以在這裡更改任何決定。"
          }
        }
      }
    },
