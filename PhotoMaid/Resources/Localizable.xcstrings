        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taşınmadı: %1$lld. Free kasada %2$lld öğeye izin verir; Pro sınırsızdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не переміщено: %1$lld. Ліміт сейфа у Free: %2$lld, у Pro — без обмежень."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa chuyển: %1$lld. Bản miễn phí cho phép %2$lld mục trong két sắt; Pro không giới hạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未移入：%1$lld。Free 版保险箱最多 %2$lld 项，Pro 版不限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未移動：%1$lld。免費版保險箱可存放 %2$lld 個項目；Pro 無限制。"
          }
        }
      }
    },
    "vault_import_recently_deleted": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نصيحة: أفرِغ «المحذوفة مؤخرًا» في تطبيق الصور إذا أردت أن تختفي من هناك أيضًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: tøm “Senest slettet” i appen Fotos, hvis de også skal forsvinde der."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipp: Leere „Zuletzt gelöscht“ in der Fotos-App, wenn sie auch dort verschwinden sollen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: empty “Recently Deleted” in the Photos app if they should disappear there too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consejo: vacía «Eliminado» en la app Fotos si quieres que desaparezcan también de allí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Astuce : vide « Suppressions récentes » dans l’app Photos s’ils doivent aussi disparaître de là."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tips: kosongkan “Baru Dihapus” di app Foto jika item itu juga harus hilang dari sana."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggerimento: svuota «Eliminati di recente» nell’app Foto se vuoi che spariscano anche da lì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヒント：写真アプリからも消したい場合は、「最近削除した項目」を空にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팁: 사진 앱에서도 없애려면 ‘최근 삭제된 항목’을 비우세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tips: tøm «Nylig slettet» i Bilder-appen hvis de også skal forsvinne der."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: leeg ‘Recent verwijderd’ in de Foto’s-app als ze daar ook moeten verdwijnen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wskazówka: opróżnij „Ostatnio usunięte” w aplikacji Zdjęcia, jeśli mają zniknąć także stamtąd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dica: esvazie “Apagados” no app Fotos se eles também devem sumir de lá."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Dica: esvazia «Apagados recentemente» na app Fotografias se quiseres que desapareçam também de lá."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sfat: golește „Șterse recent” în aplicația Poze dacă vrei să dispară și de acolo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Совет: очисти «Недавно удаленные» в «Фото», если они должны исчезнуть и оттуда."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tips: töm ”Nyligen raderade” i appen Bilder om de ska försvinna även där."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เคล็ดลับ: ล้าง “ที่ลบล่าสุด” ในแอพรูปภาพ หากต้องการให้หายไปจากที่นั่นด้วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İpucu: Oradan da kaybolmalarını istiyorsan Fotoğraflar uygulamasındaki “Son Silinenler”i boşalt."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Порада: очисти «Нещодавно видалені» у «Фото», якщо вони мають зникнути й звідти."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mẹo: dọn “Đã xóa gần đây” trong ứng dụng Ảnh nếu muốn chúng biến mất cả ở đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提示：如果也想让它们从“照片”App 中消失，请清空“最近删除”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提示：若也要從那裡消失，請清空「照片」App 中的「最近刪除」。"
          }
        }
      }
    },
