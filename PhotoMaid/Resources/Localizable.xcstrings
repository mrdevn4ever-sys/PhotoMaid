      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت قراءة %1$lld صور – تبقى مساحاتها فارغة."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się odczytać %1$lld zdjęć – ich pola pozostają puste."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld fotografii nu au putut fi citite – spațiile rămân goale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать %1$lld фото – их места останутся пустыми."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося прочитати %1$lld фото – їхні місця залишаться порожніми."
          }
        }
      }
    },
