    "org_tag_delete_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يختفي الوسم من كل الوسائط. تبقى الملفات دون تغيير."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagget forsvinder overalt. Selve fotos og videoer forbliver uændrede."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Schlagwort verschwindet überall. Die Fotos und Videos selbst bleiben unverändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The tag disappears everywhere. The photos and videos themselves stay unchanged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La etiqueta desaparece de todo el contenido. Los archivos no cambian."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mot-clé disparaît de tous les médias. Les fichiers restent inchangés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tag hilang di mana-mana. Foto dan videonya sendiri tidak berubah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tag scompare da tutti i contenuti. I file restano invariati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タグはすべてのメディアから消えます。ファイルは変わりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 미디어에서 태그가 사라져요. 파일은 그대로예요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Etiketten forsvinner overalt. Selve bildene og videoene forblir uendret."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het label verdwijnt van alle media. De bestanden blijven ongewijzigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tag zniknie ze wszystkich multimediów. Pliki pozostają bez zmian."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A etiqueta some de todos os lugares. As fotos e vídeos em si não são alterados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A etiqueta desaparece de todos os conteúdos. Os ficheiros ficam inalterados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Eticheta dispare de pe tot conținutul. Fișierele rămân neschimbate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Метка исчезнет со всех медиа. Файлы не изменятся."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Taggen försvinner överallt. Själva bilderna och videorna förblir oförändrade."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แท็กจะหายไปทุกที่ รูปภาพและวิดีโอเองไม่เปลี่ยนแปลง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etiket tüm medyadan kalkar. Dosyalar değişmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мітка зникне з усіх медіа. Файли не зміняться."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thẻ biến mất ở mọi nơi. Bản thân ảnh và video không thay đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该标签将从所有媒体中消失。文件保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標籤會從所有地方消失。照片和影片本身保持不變。"
          }
        }
      }
    },
    "org_tag_delete_title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
