    "basket_intro": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُحذف شيء بعد. اضغط على صورة مصغّرة لتكبيرها. أفرغ سلة المهملات فقط عندما تتأكد من اختيارك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনো কিছুই মুছে ফেলা হয়নি। বড় করে দেখতে থাম্বনেইলে ট্যাপ করুন। প্রস্তুত হলেই কেবল ট্র্যাশ খালি করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Encara no s’ha esborrat res. Toca una miniatura per veure-la més gran. Buida la paperera només quan estiguis a punt."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím nic nebylo smazáno. Klepnutím na miniaturu ji zvětšíte. Koš vyprázdněte, až budete připraveni."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet er slettet endnu. Tryk på et miniaturebillede for en større visning. Tøm først papirkurven, når du er klar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch ist nichts gelöscht. Tippe auf ein Vorschaubild, um es groß anzusehen. Leere den Papierkorb erst, wenn alles passt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τίποτα δεν έχει διαγραφεί ακόμη. Πάτησε μια μικρογραφία για μεγαλύτερη προβολή. Άδειασε τον κάδο μόνο όταν είσαι έτοιμος."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing has been deleted yet. Tap a thumbnail for a larger view. Empty the trash only when you’re ready."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no se ha borrado nada. Toca una vista previa para ampliarla. Vacía la papelera solo cuando todo esté bien."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitään ei ole vielä poistettu. Napauta pikkukuvaa nähdäksesi sen isompana. Tyhjennä roskakori vasta, kun olet valmis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’est encore supprimé. Touche un aperçu pour l’agrandir. Vide la corbeille seulement quand tout te convient."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હજી કંઈ ડિલીટ થયું નથી. મોટું જોવા થંબનેલ પર ટૅપ કરો. તૈયાર હો ત્યારે જ ટ્રેશ ખાલી કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עדיין לא נמחק דבר. הקשה על תמונה ממוזערת מגדילה אותה. כדאי לרוקן את הפח רק כשמוכנים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कुछ भी डिलीट नहीं हुआ। बड़ा देखने के लिए थंबनेल पर टैप करें। ट्रैश तभी खाली करें जब आप तैयार हों।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Još ništa nije izbrisano. Dodirni minijaturu za veći prikaz. Isprazni smeće tek kad budeš spreman."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még semmi sem törlődött. Koppints egy bélyegképre a nagyobb nézethez. Csak akkor ürítsd a kukát, ha készen állsz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada yang dihapus. Ketuk gambar mini untuk tampilan lebih besar. Kosongkan sampah hanya jika kamu sudah siap."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato ancora eliminato nulla. Tocca un’anteprima per ingrandirla. Svuota il cestino solo quando è tutto a posto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ何も削除されていません。サムネイルをタップすると大きく表示できます。内容を確認してからゴミ箱を空にしてください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇನ್ನೂ ಏನನ್ನೂ ಅಳಿಸಲಾಗಿಲ್ಲ. ದೊಡ್ಡದಾಗಿ ನೋಡಲು ಥಂಬ್‌ನೇಲ್ ಟ್ಯಾಪ್ ಮಾಡಿ. ನೀವು ಸಿದ್ಧರಾದಾಗ ಮಾತ್ರ ಕಸದ ಬುಟ್ಟಿಯನ್ನು ಖಾಲಿ ಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 아무것도 삭제되지 않았어요. 미리보기를 누르면 크게 볼 수 있어요. 내용을 확인한 뒤 휴지통을 비워 주세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇതുവരെ ഒന്നും ഇല്ലാതാക്കിയിട്ടില്ല. വലുതായി കാണാൻ ഒരു തംബ്‌നെയിൽ ടാപ്പ് ചെയ്യുക. തയ്യാറാകുമ്പോൾ മാത്രം ട്രാഷ് ശൂന്യമാക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अजून काहीही डिलीट झालेले नाही. मोठे पाहण्यासाठी थंबनेलवर टॅप करा. तयार असाल तेव्हाच ट्रॅश रिकामा करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada apa dipadam. Ketik gambar kecil untuk paparan lebih besar. Kosongkan sampah hanya apabila anda sudah bersedia."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting er slettet ennå. Trykk på et miniatyrbilde for større visning. Tøm papirkurven først når du er klar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is nog niets verwijderd. Tik op een voorbeeld om het groter te bekijken. Leeg de prullenbak pas als alles klopt."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏପର୍ଯ୍ୟନ୍ତ କିଛି ଡିଲିଟ୍ ହୋଇନାହିଁ। ବଡ଼ କରି ଦେଖିବାକୁ ଥମ୍ବନେଲ୍‌ରେ ଟାପ୍ କରନ୍ତୁ। ପ୍ରସ୍ତୁତ ହେଲେ ହିଁ ଟ୍ରାସ ଖାଲି କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹਾਲੇ ਕੁਝ ਵੀ ਮਿਟਾਇਆ ਨਹੀਂ ਗਿਆ। ਵੱਡਾ ਦੇਖਣ ਲਈ ਥੰਬਨੇਲ ਉੱਤੇ ਟੈਪ ਕਰੋ। ਰੱਦੀ ਤਾਂ ਹੀ ਖਾਲੀ ਕਰੋ ਜਦੋਂ ਤੁਸੀਂ ਤਿਆਰ ਹੋਵੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie zostało jeszcze usunięte. Dotknij podglądu, aby go powiększyć. Opróżnij kosz dopiero wtedy, gdy wszystko się zgadza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada foi apagado ainda. Toque numa miniatura para ver maior. Esvazie a lixeira só quando estiver pronto."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não foi eliminado nada. Toca numa pré-visualização para a ampliar. Esvazia o lixo só quando estiver tudo como queres."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu s-a șters încă nimic. Atinge o previzualizare pentru a o mări. Golește coșul doar când totul este în regulă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ещё ничего не удалено. Нажми на миниатюру, чтобы увеличить её. Очищай корзину только после проверки."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatiaľ nebolo nič vymazané. Klepnutím na miniatúru ju zväčšíte. Kôš vyprázdnite, až keď budete pripravení."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Še nič ni izbrisano. Tapni sličico za večji prikaz. Koš izprazni šele, ko boš pripravljen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget har raderats ännu. Tryck på en miniatyr för en större vy. Töm papperskorgen först när du är redo."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இதுவரை எதுவும் நீக்கப்படவில்லை. பெரிதாகப் பார்க்க ஒரு சிறுபடத்தைத் தட்டுங்கள். தயாரானதும் மட்டுமே குப்பையைக் காலி செய்யுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇంకా ఏదీ తొలగించలేదు. పెద్దగా చూడడానికి థంబ్‌నెయిల్‌ను ట్యాప్ చేయండి. సిద్ధంగా ఉన్నప్పుడు మాత్రమే ట్రాష్‌ను ఖాళీ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีอะไรถูกลบ แตะภาพย่อเพื่อดูขนาดใหญ่ขึ้น ล้างถังขยะเมื่อคุณพร้อมเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz hiçbir şey silinmedi. Büyütmek için önizlemeye dokun. Çöp kutusunu ancak her şey doğruysa boşalt."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ще нічого не видалено. Торкнися мініатюри, щоб збільшити її. Очищай кошик лише тоді, коли все перевірено."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ابھی کچھ بھی حذف نہیں ہوا۔ بڑا دیکھنے کے لیے تھمب نیل پر ٹیپ کریں۔ ردی تب ہی خالی کریں جب آپ تیار ہوں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có gì bị xóa. Chạm vào ảnh thu nhỏ để xem lớn hơn. Chỉ dọn thùng rác khi bạn đã sẵn sàng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有删除任何内容。点击预览图可放大查看，确认无误后再清空回收站。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前還沒有刪除任何內容。點一下縮圖即可放大檢視。準備好時再清空垃圾桶。"
          }
        }
      }
    },
