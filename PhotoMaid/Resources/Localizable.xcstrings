        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "畫質"
          }
        }
      }
    },
    "tools_quality_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جودة أقل تعني ملفات أصغر – وفي «متوازنة» نادرًا ما يظهر فرق."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কম মান মানে ছোট ফাইল – “সুষম”-এ আপনি কদাচিৎ পার্থক্য দেখবেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Menys qualitat vol dir fitxers més petits: amb «Equilibrada» rarament hi veuràs diferència."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nižší kvalita znamená menší soubory – u „Vyvážené“ rozdíl uvidíte jen zřídka."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lavere kvalitet giver mindre filer – ved “Balanceret” ser du sjældent en forskel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weniger Qualität ergibt kleinere Dateien – bei „Ausgewogen“ sieht man meist keinen Unterschied."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χαμηλότερη ποιότητα σημαίνει μικρότερα αρχεία – στην «Ισορροπημένη» σπάνια θα δεις διαφορά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower quality means smaller files – at “Balanced” you’ll rarely see a difference."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Menos calidad significa archivos más pequeños; con «Equilibrada» apenas se nota la diferencia."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pienempi laatu tarkoittaa pienempiä tiedostoja – tasolla ”Tasapainoinen” eron huomaa harvoin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Moins de qualité donne des fichiers plus légers – avec « Équilibrée », la différence se voit rarement."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઓછી ગુણવત્તા એટલે નાની ફાઇલો – “સંતુલિત” પર ભાગ્યે જ ફરક દેખાશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "איכות נמוכה יותר פירושה קבצים קטנים יותר – ב„מאוזנת” רק לעיתים רחוקות רואים הבדל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कम क्वालिटी यानी छोटी फ़ाइलें – “संतुलित” पर आपको शायद ही फ़र्क दिखे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Niža kvaliteta znači manje datoteke – kod „Uravnoteženo” rijetko ćeš vidjeti razliku."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Alacsonyabb minőség kisebb fájlokat jelent – a „Kiegyensúlyozott” szinten ritkán látsz különbséget."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kualitas lebih rendah berarti file lebih kecil – di “Seimbang” jarang terlihat bedanya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Meno qualità significa file più piccoli: con «Bilanciata» raramente si nota la differenza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画質を下げるとファイルが小さくなります。「標準」ではほとんど違いは分かりません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕಡಿಮೆ ಗುಣಮಟ್ಟ ಎಂದರೆ ಚಿಕ್ಕ ಫೈಲ್‌ಗಳು – “ಸಮತೋಲಿತ” ದಲ್ಲಿ ನೀವು ವ್ಯತ್ಯಾಸ ಅಪರೂಪವಾಗಿ ಕಾಣುತ್ತೀರಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화질을 낮추면 파일이 작아져요. ‘균형’에서는 차이가 거의 보이지 않아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കുറഞ്ഞ നിലവാരം എന്നാൽ ചെറിയ ഫയലുകൾ – “സന്തുലിതം” എന്നതിൽ വ്യത്യാസം അപൂർവ്വമായേ കാണൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कमी गुणवत्ता म्हणजे लहान फाइल्स – “संतुलित” वर फरक क्वचितच दिसेल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kualiti lebih rendah bermakna fail lebih kecil – pada “Seimbang” anda jarang nampak perbezaannya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lavere kvalitet gir mindre filer – med «Balansert» ser du sjelden noen forskjell."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagere kwaliteit geeft kleinere bestanden – bij ‘Gebalanceerd’ zie je zelden verschil."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "କମ୍ ଗୁଣବତ୍ତା ଅର୍ଥ ଛୋଟ ଫାଇଲ୍ – “ସନ୍ତୁଳିତ”ରେ ଆପଣ କ୍ୱଚିତ୍ ପାର୍ଥକ୍ୟ ଦେଖିବେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਘੱਟ ਗੁਣਵੱਤਾ ਦਾ ਮਤਲਬ ਛੋਟੀਆਂ ਫ਼ਾਈਲਾਂ – “ਸੰਤੁਲਿਤ” ਉੱਤੇ ਤੁਹਾਨੂੰ ਘੱਟ ਹੀ ਕੋਈ ਫ਼ਰਕ ਦਿਸੇਗਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niższa jakość to mniejsze pliki – przy „Zrównoważona” różnica jest rzadko widoczna."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualidade menor significa arquivos menores – em “Equilibrada” você raramente verá diferença."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Menos qualidade significa ficheiros mais pequenos – com «Equilibrada» raramente se nota diferença."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Calitate mai mică înseamnă fișiere mai mici – la „Echilibrată” diferența se vede rar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чем ниже качество, тем меньше файл – при «Сбалансированное» разница почти не заметна."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nižšia kvalita znamená menšie súbory – pri „Vyváženej“ rozdiel uvidíte len zriedka."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nižja kakovost pomeni manjše datoteke – pri »Uravnoteženo« razliko redko opaziš."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägre kvalitet ger mindre filer – vid ”Balanserad” ser du sällan någon skillnad."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "குறைந்த தரம் என்றால் சிறிய கோப்புகள் – “சமநிலை”யில் வேறுபாட்டை அரிதாகவே காண்பீர்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "తక్కువ నాణ్యత అంటే చిన్న ఫైళ్లు – “సమతుల్యం”లో తేడా అరుదుగా కనిపిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณภาพต่ำลงหมายถึงไฟล์เล็กลง – ที่ “สมดุล” แทบจะไม่เห็นความต่าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düşük kalite daha küçük dosya demektir; “Dengeli” ayarında fark nadiren görülür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нижча якість – менші файли; на «Збалансована» різниця майже непомітна."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کم کوالٹی یعنی چھوٹی فائلیں – ”متوازن“ پر آپ کو شاذ و نادر ہی فرق دکھے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chất lượng thấp hơn nghĩa là tệp nhỏ hơn – ở mức “Cân bằng” hiếm khi thấy khác biệt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "画质越低，文件越小；选择“均衡”时几乎看不出差别。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "畫質越低，檔案越小 –「平衡」很少看得出差別。"
          }
        }
      }
    },
