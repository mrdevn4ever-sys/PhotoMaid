    "movie_too_long": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "30 دقيقة كحد أقصى إجمالًا. قصّر المقاطع أو أزل بعضها."
          }
        },
        "da": {
