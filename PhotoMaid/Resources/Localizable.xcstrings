            "value": "صرف شیئر کریں (کوئی کاپی نہیں)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ chia sẻ (không có bản sao)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅分享（不保存副本）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只分享（不儲存副本）"
          }
        }
      }
    },
    "edit_share_only_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يشارك النسخة المعدلة دون حفظها في المعرض. تتم إزالة الموقع."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সম্পাদিত সংস্করণটি আপনার গ্যালারিতে সংরক্ষণ না করেই শেয়ার করে। লোকেশন সরিয়ে দেওয়া হয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparteix la versió editada sense desar-la a la galeria. S’elimina la ubicació."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sdílí upravenou verzi bez uložení do galerie. Poloha se odstraní."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Deler den redigerede version uden at gemme den i dit galleri. Lokaliteten fjernes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teilt die bearbeitete Fassung, ohne sie in der Galerie zu speichern. Der Standort wird entfernt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μοιράζεται την επεξεργασμένη έκδοση χωρίς αποθήκευση στη συλλογή σου. Η τοποθεσία αφαιρείται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shares the edited version without saving it to your gallery. Location is removed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte la versión editada sin guardarla en la galería. Se quita la ubicación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jakaa muokatun version tallentamatta sitä galleriaan. Sijainti poistetaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partage la version modifiée sans l’enregistrer dans la galerie. La position est retirée."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફેરફાર કરેલું વર્ઝન તમારી ગૅલરીમાં સાચવ્યા વિના શેર કરે છે. સ્થાન દૂર કરાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משתף את הגרסה הערוכה בלי לשמור אותה בגלריה. המיקום מוסר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एडिट किया वर्शन आपकी गैलरी में सहेजे बिना शेयर करता है। लोकेशन हटा दी जाती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dijeli uređenu verziju bez spremanja u galeriju. Lokacija se uklanja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megosztja a szerkesztett változatot anélkül, hogy a galériába mentené. A hely eltávolításra kerül."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membagikan versi hasil edit tanpa menyimpannya ke galerimu. Lokasi dihapus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Condivide la versione modificata senza salvarla in galleria. La posizione viene rimossa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "編集版をギャラリーに保存せずに共有します。位置情報は削除されます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಎಡಿಟ್ ಮಾಡಿದ ಆವೃತ್ತಿಯನ್ನು ನಿಮ್ಮ ಗ್ಯಾಲರಿಯಲ್ಲಿ ಉಳಿಸದೆ ಹಂಚಿಕೊಳ್ಳುತ್ತದೆ. ಸ್ಥಳವನ್ನು ತೆಗೆದುಹಾಕಲಾಗುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편집본을 갤러리에 저장하지 않고 공유해요. 위치 정보는 삭제돼요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എഡിറ്റ് ചെയ്ത പതിപ്പ് നിങ്ങളുടെ ഗാലറിയിൽ സംരക്ഷിക്കാതെ പങ്കിടുന്നു. ലൊക്കേഷൻ നീക്കം ചെയ്യും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "संपादित आवृत्ती तुमच्या गॅलरीत जतन न करता शेअर करते. स्थान काढले जाते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengongsi versi yang disunting tanpa menyimpannya ke galeri anda. Lokasi dibuang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Deler den redigerte versjonen uten å lagre den i galleriet ditt. Stedet fjernes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deelt de bewerkte versie zonder haar in je galerij op te slaan. De locatie wordt verwijderd."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏଡିଟ୍ ହୋଇଥିବା ସଂସ୍କରଣ ଆପଣଙ୍କ ଗ୍ୟାଲେରୀରେ ସେଭ୍ ନକରି ସେୟାର୍ କରେ। ଲୋକେସନ୍ ହଟାଯାଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸੋਧਿਆ ਰੂਪ ਤੁਹਾਡੀ ਗੈਲਰੀ ਵਿੱਚ ਸੰਭਾਲੇ ਬਿਨਾਂ ਸਾਂਝਾ ਕਰਦਾ ਹੈ। ਟਿਕਾਣਾ ਹਟਾ ਦਿੱਤਾ ਜਾਂਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Udostępnia edytowaną wersję bez zapisywania jej w galerii. Lokalizacja zostaje usunięta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartilha a versão editada sem salvá-la na sua galeria. A localização é removida."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Partilha a versão editada sem a guardar na galeria. A localização é removida."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Distribuie versiunea editată fără a o salva în galerie. Locația este eliminată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправляет изменённую версию, не сохраняя её в галерее. Геоданные удаляются."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdieľa upravenú verziu bez uloženia do galérie. Poloha sa odstráni."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deli urejeno različico brez shranjevanja v galerijo. Lokacija se odstrani."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Delar den redigerade versionen utan att spara den i ditt galleri. Platsen tas bort."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "திருத்திய பதிப்பை உங்கள் கேலரியில் சேமிக்காமல் பகிர்கிறது. இருப்பிடம் அகற்றப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఎడిట్ చేసిన వెర్షన్‌ను మీ గ్యాలరీలో సేవ్ చేయకుండా షేర్ చేస్తుంది. లొకేషన్ తీసివేయబడుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แชร์เวอร์ชันที่แก้ไขโดยไม่บันทึกลงคลังภาพ ตำแหน่งจะถูกลบออก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düzenlenmiş sürümü galeriye kaydetmeden paylaşır. Konum kaldırılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надсилає змінену версію, не зберігаючи її в галереї. Геодані видаляються."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ترمیم شدہ ورژن آپ کی گیلری میں محفوظ کیے بغیر شیئر کرتا ہے۔ مقام ہٹا دیا جاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chia sẻ bản đã sửa mà không lưu vào thư viện. Vị trí sẽ bị xóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分享编辑后的版本而不保存到图库，位置信息会被移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分享編輯後的版本，但不儲存到你的圖庫。會移除位置資訊。"
          }
        }
      }
    },
