    "vault2_trash_explanation": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه السلة للخزنة فقط. يبقى المحتوى مشفّرًا حتى تستعيده أو تحذفه نهائيًا بقرار صريح. لا يوجد حذف تلقائي."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne papirkurv hører kun til boksen. Indholdet forbliver krypteret, indtil du gendanner det eller udtrykkeligt sletter det permanent. Intet slettes automatisk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Papierkorb gehört nur zum Tresor. Inhalte bleiben verschlüsselt, bis du sie wiederherstellst oder ausdrücklich endgültig löschst. Keine automatische Löschung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This trash belongs only to the vault. Content stays encrypted until you restore it or explicitly delete it permanently. Nothing is deleted automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta papelera es solo de la caja fuerte. El contenido sigue cifrado hasta restaurarlo o eliminarlo permanentemente. Nada se elimina automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette corbeille appartient au coffre. Le contenu reste chiffré jusqu’à sa restauration ou sa suppression définitive explicite. Aucune suppression automatique."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sampah ini hanya milik brankas. Konten tetap terenkripsi sampai kamu memulihkannya atau menghapusnya secara permanen dengan sengaja. Tidak ada yang dihapus otomatis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo cestino appartiene alla cassaforte. I contenuti restano crittografati fino al ripristino o all’eliminazione definitiva esplicita. Nessuna eliminazione automatica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このゴミ箱は保管庫専用です。内容は復元または明示的な完全削除まで暗号化されたままです。自動削除はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 휴지통은 보관함 전용입니다. 복원하거나 명시적으로 영구 삭제할 때까지 암호화됩니다. 자동 삭제되지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne papirkurven hører bare til safen. Innholdet forblir kryptert til du gjenoppretter det eller uttrykkelig sletter det permanent. Ingenting slettes automatisk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze prullenmand hoort alleen bij de kluis. Inhoud blijft versleuteld tot je die herstelt of definitief verwijdert. Niets wordt automatisch verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten kosz należy tylko do sejfu. Zawartość pozostaje zaszyfrowana do przywrócenia lub świadomego trwałego usunięcia. Nic nie jest usuwane automatycznie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta lixeira pertence só ao cofre. O conteúdo fica criptografado até você restaurá-lo ou apagá-lo permanentemente de forma explícita. Nada é apagado automaticamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este lixo pertence apenas ao cofre. O conteúdo continua cifrado até o restaurares ou apagares permanentemente. Nada é apagado automaticamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest coș aparține doar seifului. Conținutul rămâne criptat până îl restaurezi sau îl ștergi definitiv în mod explicit. Fără ștergere automată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта корзина относится только к сейфу. Данные остаются зашифрованными до восстановления или явного удаления навсегда. Автоматического удаления нет."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här papperskorgen tillhör bara valvet. Innehållet förblir krypterat tills du återställer det eller uttryckligen raderar det permanent. Inget raderas automatiskt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถังขยะนี้เป็นของตู้เซฟเท่านั้น เนื้อหายังคงเข้ารหัสจนกว่าคุณจะกู้คืนหรือสั่งลบถาวรเอง ไม่มีอะไรถูกลบโดยอัตโนมัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu çöp kutusu yalnızca kasaya aittir. İçerik geri yüklenene veya açıkça kalıcı silinene kadar şifreli kalır. Otomatik silme yapılmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей кошик належить лише сховищу. Дані залишаються зашифрованими до відновлення або явного видалення назавжди. Автоматичного видалення немає."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thùng rác này chỉ thuộc về két sắt. Nội dung vẫn được mã hóa cho đến khi bạn khôi phục hoặc chủ động xóa vĩnh viễn. Không có gì bị xóa tự động."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此废纸篓仅属于保险库。内容会保持加密，直到你恢复或明确永久删除。不会自动删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個垃圾桶只屬於保險箱。內容會保持加密，直到你還原它或明確地永久刪除。不會自動刪除任何內容。"
          }
        }
      }
    },
