          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ତାରିଖ ବିନା ଅଲଗା ରଖନ୍ତୁ"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਬਿਨਾਂ ਤਾਰੀਖ਼ ਵੱਖ ਰੱਖੋ"
          }
        },
        "pl": {
          "stringUnit": {
