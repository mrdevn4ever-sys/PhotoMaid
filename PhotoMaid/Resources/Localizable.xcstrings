    "vault2_operation_failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يكتمل الإجراء. تحقّق من المساحة والأذونات ثم أعد المحاولة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কাজটি সফলভাবে সম্পন্ন হয়নি। স্টোরেজের জায়গা ও অ্যাক্সেস দেখে আবার চেষ্টা করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’acció no s’ha completat correctament. Comprova l’espai i l’accés i torna-ho a provar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Akce nebyla úspěšně dokončena. Zkontrolujte úložiště a přístup a zkuste to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Handlingen blev ikke gennemført. Tjek lagerplads og adgang, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aktion wurde nicht erfolgreich abgeschlossen. Prüfe Speicherplatz und Zugriff und versuche es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ενέργεια δεν ολοκληρώθηκε. Έλεγξε τον χώρο αποθήκευσης και την πρόσβαση και δοκίμασε ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The action did not complete successfully. Check storage space and access, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La acción no se completó. Comprueba el espacio y los permisos y reinténtalo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toiminto ei onnistunut. Tarkista tallennustila ja käyttöoikeudet ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’action n’a pas abouti. Vérifiez l’espace disponible et les autorisations, puis réessayez."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ક્રિયા સફળતાથી પૂર્ણ થઈ નથી. સ્ટોરેજ અને ઍક્સેસ તપાસો, પછી ફરી પ્રયાસ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפעולה לא הושלמה בהצלחה. כדאי לבדוק את מקום האחסון ואת הגישה ולנסות שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्रिया सफलतापूर्वक पूरी नहीं हुई। स्टोरेज और एक्सेस जाँचें, फिर कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Radnja nije uspješno dovršena. Provjeri prostor za pohranu i pristup te pokušaj ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A művelet nem fejeződött be sikeresen. Ellenőrizd a tárhelyet és a hozzáférést, majd próbáld újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tindakan tidak berhasil diselesaikan. Periksa ruang penyimpanan dan akses, lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’azione non è riuscita. Controlla spazio e autorizzazioni, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "処理が完了しませんでした。空き容量とアクセス権を確認して再試行してください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕ್ರಿಯೆ ಯಶಸ್ವಿಯಾಗಿ ಪೂರ್ಣಗೊಂಡಿಲ್ಲ. ಸಂಗ್ರಹಣೆ ಸ್ಥಳ ಮತ್ತು ಪ್ರವೇಶ ಪರಿಶೀಲಿಸಿ, ನಂತರ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업을 완료하지 못했습니다. 저장 공간과 접근 권한을 확인한 뒤 다시 시도하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പ്രവർത്തനം വിജയകരമായി പൂർത്തിയായില്ല. സ്റ്റോറേജ് സ്ഥലവും ആക്‌സസും പരിശോധിച്ച് വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कृती यशस्वीपणे पूर्ण झाली नाही. स्टोरेज आणि ॲक्सेस तपासा, मग पुन्हा प्रयत्न करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tindakan tidak berjaya diselesaikan. Semak ruang storan dan akses, kemudian cuba lagi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Handlingen ble ikke fullført. Sjekk lagringsplass og tilgang, og prøv igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De actie is niet voltooid. Controleer opslagruimte en toegang en probeer opnieuw."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "କାର୍ଯ୍ୟ ସଫଳ ଭାବେ ସମ୍ପୂର୍ଣ୍ଣ ହେଲା ନାହିଁ। ଷ୍ଟୋରେଜ୍ ସ୍ଥାନ ଓ ଆକ୍ସେସ୍ ଯାଞ୍ଚ କରି ପୁଣି ଚେଷ୍ଟା କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕਾਰਵਾਈ ਸਫਲਤਾ ਨਾਲ ਪੂਰੀ ਨਹੀਂ ਹੋਈ। ਸਟੋਰੇਜ ਥਾਂ ਅਤੇ ਪਹੁੰਚ ਜਾਂਚੋ, ਫਿਰ ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ukończono operacji. Sprawdź wolne miejsce i dostęp, a potem spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A ação não foi concluída. Verifique o espaço de armazenamento e o acesso e tente de novo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A ação não foi concluída. Verifica o espaço e as permissões e tenta novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acțiunea nu s-a finalizat. Verifică spațiul și accesul, apoi încearcă din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Действие не завершено. Проверьте свободное место и доступ, затем повторите."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Akcia sa úspešne nedokončila. Skontrolujte úložisko a prístup a skúste to znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejanje ni bilo uspešno dokončano. Preveri prostor in dostop ter poskusi znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Åtgärden slutfördes inte. Kontrollera lagringsutrymme och åtkomst och försök igen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "செயல் வெற்றிகரமாக முடியவில்லை. சேமிப்பக இடத்தையும் அணுகலையும் சரிபார்த்து மீண்டும் முயலுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చర్య విజయవంతంగా పూర్తి కాలేదు. స్టోరేజ్ స్థలం, యాక్సెస్ తనిఖీ చేసి మళ్లీ ప్రయత్నించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การดำเนินการไม่สำเร็จ ตรวจสอบพื้นที่จัดเก็บและการเข้าถึง แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşlem tamamlanamadı. Depolama alanını ve erişimi kontrol edip tekrar dene."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дію не завершено. Перевірте вільне місце й доступ, потім повторіть."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "عمل کامیابی سے مکمل نہیں ہوا۔ اسٹوریج اور رسائی چیک کریں، پھر دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác chưa hoàn tất. Hãy kiểm tra dung lượng và quyền truy cập rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作未完成。请检查存储空间和访问权限后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "動作未成功完成。請檢查儲存空間和取用權限，然後再試一次。"
          }
        }
      }
    },
