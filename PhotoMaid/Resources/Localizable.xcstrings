    "offer_limit_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أزل حتى %1$lld يوميًا. شاهد إعلان فيديو لإزالة %2$lld إضافية اليوم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis zu %1$lld pro Tag entfernen. Mit einem Werbevideo sind heute %2$lld mehr möglich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove up to %1$lld per day. Watch a video ad to remove %2$lld more today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quita hasta %1$lld al día. Un anuncio en vídeo te permite quitar %2$lld más hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retire jusqu’à %1$lld par jour. Une vidéo publicitaire permet d’en retirer %2$lld de plus aujourd’hui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuovine fino a %1$lld al giorno. Con un video pubblicitario puoi rimuoverne %2$lld in più oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1日%1$lld件まで削除できます。動画広告を見ると、今日はさらに%2$lld件削除できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하루 최대 %1$lld개를 삭제하세요. 동영상 광고를 보면 오늘 %2$lld개 더 삭제할 수 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijder er maximaal %1$lld per dag. Met een videoadvertentie kun je er vandaag %2$lld extra verwijderen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuwaj do %1$lld dziennie. Reklama wideo pozwala dziś usunąć o %2$lld więcej."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove até %1$lld por dia. Um anúncio em vídeo permite remover mais %2$lld hoje."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimină până la %1$lld pe zi. O reclamă video îți permite să elimini cu %2$lld mai multe azi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляй до %1$lld в день. Видеореклама позволяет удалить ещё %2$lld сегодня."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günde en fazla %1$lld öğe kaldır. Bir video reklamla bugün %2$lld daha kaldırabilirsin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видаляй до %1$lld за день. Відеореклама дає змогу видалити ще %2$lld сьогодні."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每天最多移除 %1$lld 项。观看视频广告，今天可额外移除 %2$lld 项。"
          }
        }
      }
    },
