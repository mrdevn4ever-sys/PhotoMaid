    "tools_stitch_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يدمج لقطات الشاشة من الأعلى إلى الأسفل في صورة طويلة واحدة، بترتيب التقاطها. تأخذ كلها عرض أضيق صورة – لا شيء يُمطّ أو يُكبَّر."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sætter skærmbilleder sammen oppefra og ned til ét langt billede i den rækkefølge, de blev taget. Alle får det smalleste billedes bredde – intet strækkes eller forstørres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt Screenshots von oben nach unten zu einem langen Bild zusammen – in der Reihenfolge der Aufnahme. Alle bekommen die Breite des schmalsten Bildes, nichts wird verzerrt oder vergrößert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Joins screenshots top to bottom into one long image, in the order they were taken. All get the width of the narrowest image – nothing is stretched or enlarged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Une capturas de pantalla de arriba abajo en una imagen larga, en el orden en que se hicieron. Todas toman el ancho de la más estrecha: nada se deforma ni se amplía."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assemble les captures d’écran de haut en bas en une longue image, dans l’ordre de prise. Toutes prennent la largeur de la plus étroite – rien n’est déformé ni agrandi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menggabungkan tangkapan layar dari atas ke bawah menjadi satu gambar panjang, sesuai urutan pengambilan. Semua mengikuti lebar gambar tersempit – tidak ada yang diregangkan atau diperbesar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Unisce gli screenshot dall’alto in basso in un’unica immagine lunga, nell’ordine in cui sono stati fatti. Tutti prendono la larghezza del più stretto: niente viene deformato o ingrandito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクリーンショットを撮影順に上から下へつなげ、1枚の長い画像にします。すべて最も幅の狭い画像に合わせ、引き伸ばしや拡大はしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크린샷을 촬영 순서대로 위에서 아래로 이어 긴 이미지 하나로 만들어요. 모두 가장 좁은 이미지의 너비에 맞추며 늘이거나 확대하지 않아요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Setter sammen skjermbilder ovenfra og ned til ett langt bilde, i den rekkefølgen de ble tatt. Alle får bredden til det smaleste bildet – ingenting strekkes eller forstørres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voegt schermafbeeldingen van boven naar beneden samen tot één lange afbeelding, in de volgorde waarin ze zijn gemaakt. Alle krijgen de breedte van de smalste – niets wordt vervormd of vergroot."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Łączy zrzuty ekranu od góry do dołu w jeden długi obraz, w kolejności wykonania. Wszystkie dostają szerokość najwęższego – nic nie jest rozciągane ani powiększane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Junta capturas de tela de cima para baixo numa imagem longa, na ordem em que foram feitas. Todas ficam com a largura da imagem mais estreita – nada é esticado nem ampliado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Junta capturas de ecrã de cima para baixo numa imagem longa, pela ordem em que foram tiradas. Todas ficam com a largura da mais estreita – nada é deformado nem ampliado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Unește capturile de ecran de sus în jos într-o singură imagine lungă, în ordinea în care au fost făcute. Toate primesc lățimea celei mai înguste – nimic nu este deformat sau mărit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Склеивает скриншоты сверху вниз в одно длинное изображение в порядке съёмки. Все получают ширину самого узкого – ничего не растягивается и не увеличивается."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sätter ihop skärmavbilder uppifrån och ned till en lång bild, i den ordning de togs. Alla får samma bredd som den smalaste bilden – inget sträcks eller förstoras."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต่อภาพหน้าจอจากบนลงล่างเป็นรูปยาวรูปเดียว ตามลำดับที่ถ่าย ทุกรูปจะมีความกว้างเท่ากับรูปที่แคบที่สุด – ไม่มีอะไรถูกยืดหรือขยาย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran görüntülerini çekilme sırasına göre yukarıdan aşağıya tek uzun bir görüntüde birleştirir. Hepsi en dar görüntünün genişliğini alır; hiçbir şey esnetilmez veya büyütülmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Склеює знімки екрана згори донизу в одне довге зображення в порядку зйомки. Усі отримують ширину найвужчого – нічого не розтягується й не збільшується."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghép ảnh chụp màn hình từ trên xuống dưới thành một ảnh dài, theo thứ tự chụp. Tất cả có chiều rộng của ảnh hẹp nhất – không có gì bị kéo giãn hay phóng to."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按拍摄顺序将截屏从上到下拼成一张长图。所有图片都采用最窄图片的宽度，不会拉伸或放大。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將截圖由上到下依拍攝順序拼接成一張長圖。所有圖片都會配合最窄圖片的寬度 – 不會拉伸或放大。"
          }
        }
      }
    },
    "tools_stitch_saved": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حُفظت كصورة جديدة في مكتبتك. تبقى لقطات الشاشة دون تغيير."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemt som nyt billede i dit bibliotek. Skærmbillederne forbliver uændrede."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als neues Bild in deiner Mediathek gespeichert. Die Screenshots bleiben unverändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved as a new image in your library. The screenshots stay unchanged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardado como imagen nueva en tu fototeca. Las capturas no cambian."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrée comme nouvelle image dans votre photothèque. Les captures restent inchangées."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Disimpan sebagai gambar baru di pustakamu. Tangkapan layarnya tidak berubah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvata come nuova immagine nella libreria. Gli screenshot restano invariati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい画像としてライブラリに保存しました。スクリーンショットは変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 이미지로 보관함에 저장했어요. 스크린샷은 바뀌지 않아요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagret som nytt bilde i biblioteket ditt. Skjermbildene forblir uendret."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaard als nieuwe afbeelding in je bibliotheek. De schermafbeeldingen blijven ongewijzigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisano jako nowy obraz w bibliotece. Zrzuty ekranu pozostają bez zmian."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva como nova imagem na sua biblioteca. As capturas de tela não são alteradas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardada como nova imagem na fototeca. As capturas de ecrã ficam inalteradas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvată ca imagine nouă în fototecă. Capturile de ecran rămân neschimbate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранено как новое изображение в медиатеке. Скриншоты не изменены."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparad som ny bild i ditt bibliotek. Skärmavbilderna förblir oförändrade."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกเป็นรูปใหม่ในคลังของคุณแล้ว ภาพหน้าจอไม่เปลี่ยนแปลง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arşivine yeni bir görüntü olarak kaydedildi. Ekran görüntüleri değişmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збережено як нове зображення в медіатеці. Знімки екрана не змінено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã lưu thành ảnh mới trong thư viện. Ảnh chụp màn hình không thay đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已作为新图片存储到图库。截屏保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已作為新圖片儲存到你的圖庫。截圖保持不變。"
          }
        }
      }
    },
    "tools_stitch_sub": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "واحدة تحت الأخرى، كصورة طويلة واحدة"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Under hinanden, som ét langt billede"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Untereinander, als ein langes Bild"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One below the other, as one long image"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una debajo de otra, como una imagen larga"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les unes sous les autres, en une longue image"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu di bawah yang lain, sebagai satu gambar panjang"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sotto l’altra, come un’unica immagine lunga"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "縦に並べて1枚の長い画像に"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위아래로 이어 긴 이미지 하나로"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Under hverandre, som ett langt bilde"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Onder elkaar, als één lange afbeelding"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden pod drugim, jako jeden długi obraz"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma embaixo da outra, numa imagem longa"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Umas por baixo das outras, numa imagem longa"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sub alta, ca o singură imagine lungă"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Друг под другом, одним длинным изображением"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Under varandra, som en lång bild"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เรียงต่อกันจากบนลงล่าง เป็นรูปยาวรูปเดียว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt alta, tek uzun bir görsel olarak"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одне під одним, одним довгим зображенням"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xếp chồng từ trên xuống, thành một ảnh dài"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上下拼接为一张长图"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上下相接，拼成一張長圖"
          }
        }
      }
