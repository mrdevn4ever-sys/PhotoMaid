    "backup_save_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحفظ بيانات PhotoMaid في ملف صغير: القرارات والألبومات والوسوم والملاحظات وسلة التحديد والعناصر المخفية والإعدادات وسير العمل والإعدادات المسبقة. لا يتضمن الصور."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichert deine PhotoMaid-Daten in eine kleine Datei: Entscheidungen, Alben, Schlagwörter, Notizen, Auswahlkorb, Ausgeblendetes, Einstellungen, Abläufe und Vorlagen. Fotos sind nicht dabei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves your PhotoMaid data in a small file: decisions, albums, tags, notes, selection basket, hidden items, settings, workflows and presets. No photos are included."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda tus datos de PhotoMaid en un archivo pequeño: decisiones, álbumes, etiquetas, notas, cesta de selección, elementos ocultos, ajustes, flujos de trabajo y ajustes guardados. No incluye fotos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre vos données PhotoMaid dans un petit fichier : décisions, albums, mots-clés, notes, panier de sélection, éléments masqués, réglages, flux de travail et préréglages. Aucune photo n’est incluse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva i tuoi dati di PhotoMaid in un piccolo file: decisioni, album, tag, note, cestino di selezione, elementi nascosti, impostazioni, flussi di lavoro e preset. Le foto non sono incluse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaidのデータを小さなファイルに保存します：判断、アルバム、タグ、メモ、選択かご、非表示の項目、設定、ワークフロー、プリセット。写真は含まれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid 데이터를 작은 파일에 저장해요: 결정, 앨범, 태그, 메모, 선택 바구니, 숨긴 항목, 설정, 작업 흐름, 프리셋. 사진은 들어가지 않아요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Slaat je PhotoMaid-gegevens op in een klein bestand: beslissingen, albums, labels, notities, selectiemand, verborgen items, instellingen, werkstromen en voorinstellingen. Er zitten geen foto’s in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisuje dane PhotoMaid w małym pliku: decyzje, albumy, tagi, notatki, koszyk wyboru, ukryte elementy, ustawienia, przepływy pracy i ustawienia filtrów. Bez zdjęć."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda os seus dados do PhotoMaid num ficheiro pequeno: decisões, álbuns, etiquetas, notas, cesto de seleção, itens ocultos, definições, fluxos de trabalho e predefinições. Não inclui fotos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvează datele PhotoMaid într-un fișier mic: decizii, albume, etichete, note, coș de selecție, elemente ascunse, setări, fluxuri de lucru și presetări. Fotografiile nu sunt incluse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняет данные PhotoMaid в небольшой файл: решения, альбомы, метки, заметки, корзину выбора, скрытое, настройки, сценарии и пресеты. Фото в него не входят."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid verilerini küçük bir dosyaya kaydeder: kararlar, albümler, etiketler, notlar, seçim sepeti, gizlenen öğeler, ayarlar, iş akışları ve hazır ayarlar. Fotoğraflar dahil değildir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберігає дані PhotoMaid у невеликий файл: рішення, альбоми, мітки, нотатки, кошик вибору, приховане, налаштування, сценарії та пресети. Фото до нього не входять."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将你的 PhotoMaid 数据保存到一个小文件中：决定、相册、标签、备注、选择篮、隐藏项、设置、工作流程和预设。不包含照片。"
          }
        }
      }
    },
