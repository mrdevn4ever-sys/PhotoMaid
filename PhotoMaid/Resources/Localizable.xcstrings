    "edit_save_original_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يطلب iOS الإذن أولًا. يُحفظ التعديل كتعديل في تطبيق الصور، ويمكنك التراجع عنه هناك في أي وقت عبر «الرجوع إلى الأصل»."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS spørger først. Redigeringen gemmes som en redigering i appen Fotos – du kan altid fortryde den der med “Tilbagestil”."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS fragt vorher nach. Die Bearbeitung wird wie in der Fotos-App gespeichert – dort jederzeit mit „Original wiederherstellen“ rückgängig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS asks first. The edit is saved like an edit in the Photos app – you can undo it there anytime with “Revert”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS pregunta antes. La edición se guarda como en la app Fotos y puedes deshacerla allí cuando quieras con «Original»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS demande d’abord. La modification est enregistrée comme dans l’app Photos – annulable à tout moment avec « Revenir à l’original »."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS bertanya dulu. Hasil edit disimpan seperti edit di app Foto – kamu bisa membatalkannya di sana kapan saja dengan “Kembalikan”."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS chiede prima. La modifica viene salvata come nell’app Foto e puoi annullarla lì in qualsiasi momento con «Ripristina»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先にiOSが確認します。編集は写真アプリの編集と同じように保存され、そこでいつでも「元に戻す」で取り消せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS가 먼저 묻습니다. 편집은 사진 앱의 편집처럼 저장되며, 그곳에서 언제든 '원본으로 복귀'로 되돌릴 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS spør først. Redigeringen lagres som en redigering i Bilder-appen – du kan når som helst angre den der med «Tilbakestill»."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS vraagt eerst toestemming. De bewerking wordt opgeslagen zoals in de Foto’s-app – daar altijd terug te draaien met ‘Origineel’."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS najpierw zapyta. Edycja zostanie zapisana jak w aplikacji Zdjęcia – możesz ją tam w każdej chwili cofnąć opcją „Przywróć oryginał”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iOS pergunta antes. A edição é salva como uma edição no app Fotos – você pode desfazê-la lá a qualquer momento com “Reverter”."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O iOS pergunta primeiro. A edição é guardada como na app Fotografias – pode anulá-la aí a qualquer momento com «Reverter»."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS întreabă mai întâi. Editarea se salvează ca în aplicația Poze – o poți anula oricând acolo cu „Revino la original”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала iOS спросит разрешение. Правка сохранится как в приложении «Фото» – там её всегда можно отменить через «Вернуть оригинал»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS frågar först. Redigeringen sparas som en redigering i appen Bilder – du kan när som helst ångra den där med ”Återgå”."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS จะถามก่อน การแก้ไขจะถูกบันทึกเหมือนการแก้ไขในแอพรูปภาพ – คุณสามารถเลิกทำได้ที่นั่นทุกเมื่อด้วย “แปลงกลับ”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS önce sorar. Düzenleme Fotoğraflar uygulamasındaki gibi kaydedilir; orada istediğin zaman \"Orijinale Döndür\" ile geri alabilirsin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спершу iOS запитає дозвіл. Редагування збережеться як у програмі «Фото» – там його завжди можна скасувати через «Повернути оригінал»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS sẽ hỏi trước. Chỉnh sửa được lưu như chỉnh sửa trong ứng dụng Ảnh – bạn có thể hoàn tác ở đó bất cứ lúc nào bằng “Hoàn nguyên”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 会先征求你的同意。编辑会像在“照片”App 中一样存储，可随时在那里通过“复原”撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 會先詢問。編輯會像在「照片」App 中編輯一樣儲存 – 你隨時可以在那裡用「回復」還原。"
          }
        }
      }
    },
