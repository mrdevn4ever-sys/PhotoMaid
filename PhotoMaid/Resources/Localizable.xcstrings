    "startup_failed_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تحميل قراراتك المحفوظة. لم يتغيّر أو يُحذف أي شيء. أعد تشغيل PhotoMaid؛ وإن لم يُفد ذلك فشارك التشخيص."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine gespeicherten Entscheidungen konnten nicht geladen werden. Es wurde nichts verändert oder gelöscht. Starte PhotoMaid neu; hilft das nicht, teile die Diagnose."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your saved decisions couldn’t be loaded. Nothing was changed or deleted. Restart PhotoMaid; if that doesn’t help, share the diagnostics."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han podido cargar tus decisiones guardadas. No se ha cambiado ni borrado nada. Reinicia PhotoMaid; si no funciona, comparte el diagnóstico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos décisions enregistrées n’ont pas pu être chargées. Rien n’a été modifié ni supprimé. Redémarrez PhotoMaid ; si cela ne suffit pas, partagez le diagnostic."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile caricare le tue decisioni salvate. Nulla è stato modificato o eliminato. Riavvia PhotoMaid; se non basta, condividi la diagnostica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存した判断を読み込めませんでした。何も変更・削除されていません。PhotoMaidを再起動し、それでも直らない場合は診断を共有してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 결정을 불러올 수 없습니다. 변경되거나 삭제된 것은 없습니다. PhotoMaid를 다시 시작하고, 그래도 안 되면 진단을 공유하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je opgeslagen keuzes konden niet worden geladen. Er is niets gewijzigd of verwijderd. Start PhotoMaid opnieuw; helpt dat niet, deel dan de diagnose."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się wczytać zapisanych decyzji. Niczego nie zmieniono ani nie usunięto. Uruchom PhotoMaid ponownie; jeśli to nie pomoże, udostępnij diagnostykę."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar as suas decisões guardadas. Nada foi alterado nem apagado. Reinicie o PhotoMaid; se não resultar, partilhe o diagnóstico."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deciziile salvate nu au putut fi încărcate. Nimic nu a fost modificat sau șters. Repornește PhotoMaid; dacă nu ajută, partajează diagnosticul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить сохранённые решения. Ничего не изменено и не удалено. Перезапустите PhotoMaid; если не поможет, поделитесь диагностикой."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlı kararların yüklenemedi. Hiçbir şey değiştirilmedi veya silinmedi. PhotoMaid’i yeniden başlat; işe yaramazsa tanılamayı paylaş."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося завантажити збережені рішення. Нічого не змінено й не видалено. Перезапустіть PhotoMaid; якщо не допоможе, поділіться діагностикою."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法载入你保存的决定。没有任何内容被更改或删除。请重新启动 PhotoMaid；若仍无效，请共享诊断信息。"
          }
        }
      }
    },
