        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진이나 비디오를 탭하여 제어 버튼을 표시하거나 숨기세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på bildet eller videoen for å vise eller skjule kontrollene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op de foto of video om de bediening te tonen of te verbergen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij zdjęcie lub wideo, aby pokazać lub ukryć przyciski."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque na foto ou no vídeo para mostrar ou ocultar os controles."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque na fotografia ou no vídeo para mostrar ou ocultar os controlos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge fotografia sau videoclipul pentru a afișa sau ascunde comenzile."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь фото или видео, чтобы показать или скрыть элементы управления."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på bilden eller videon för att visa eller dölja reglagen."
