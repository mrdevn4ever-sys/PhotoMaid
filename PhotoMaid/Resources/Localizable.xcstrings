    "qa_remove_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُزال الاختصار فقط. تبقى ملفاتك واختياراتك محفوظة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
