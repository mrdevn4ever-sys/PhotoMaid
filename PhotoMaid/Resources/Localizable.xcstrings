            "value": "No favourites in this folder yet. Turn off “Favourites only” to see everything."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay favoritos en esta carpeta. Desactiva «Solo favoritos» para ver todo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun favori dans ce dossier pour l’instant. Désactivez « Favoris seulement » pour tout voir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessun preferito in questa cartella. Disattiva “Solo preferiti” per vedere tutto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフォルダにはまだお気に入りがありません。「お気に入りのみ」をオフにするとすべて表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 폴더에는 아직 즐겨찾기가 없습니다. ‘즐겨찾기만’을 끄면 모두 보입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen favorieten in deze map. Zet ‘Alleen favorieten’ uit om alles te zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W tym folderze nie ma jeszcze ulubionych. Wyłącz „Tylko ulubione”, aby zobaczyć wszystko."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há favoritos nesta pasta. Desative “Só favoritos” para ver tudo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încă nu există favorite în acest dosar. Dezactivează „Doar favorite” ca să vezi tot."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этой папке пока нет избранного. Выключите «Только избранное», чтобы увидеть всё."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu klasörde henüz favori yok. Hepsini görmek için “Yalnızca favoriler”i kapat."
