            "value": "تحتاج الجولة إلى %1$lld صورة قابلة للاستخدام على الأقل من المصدر المختار. اختر مصدرًا آخر أو مجموعة أصغر أو اسمح بالتنزيل من iCloud."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne runde kræver mindst %1$lld brugbare fotos fra den valgte kilde. Vælg en anden kilde, et mindre udvalg, eller tillad hentning fra iCloud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Runde benötigt mindestens %1$lld nutzbare Fotos aus der gewählten Quelle. Wähle eine andere Quelle, eine kleinere Auswahl oder erlaube iCloud-Downloads."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This round needs at least %1$lld usable photos from the chosen source. Choose another source, a smaller selection or allow iCloud downloads."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ronda necesita al menos %1$lld fotos utilizables del origen elegido. Elige otro origen, una selección menor o permite descargas de iCloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette partie nécessite au moins %1$lld photos utilisables de la source choisie. Changez de source, réduisez la sélection ou autorisez les téléchargements iCloud."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ronde ini butuh setidaknya %1$lld foto yang bisa dipakai dari sumber yang dipilih. Pilih sumber lain, pilihan yang lebih kecil, atau izinkan unduhan iCloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Servono almeno %1$lld foto utilizzabili dall’origine scelta. Cambia origine, riduci la selezione o consenti i download da iCloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択元に利用可能な写真が最低%1$lld枚必要です。選択元を変えるか、枚数を減らすか、iCloudからのダウンロードを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 출처에서 사용 가능한 사진이 최소 %1$lld장 필요합니다. 다른 출처나 더 적은 사진을 선택하거나 iCloud 다운로드를 허용하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne runden trenger minst %1$lld brukbare bilder fra den valgte kilden. Velg en annen kilde, et mindre utvalg eller tillat nedlasting fra iCloud."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze ronde heeft minstens %1$lld bruikbare foto's uit de gekozen bron nodig. Kies een andere bron, minder foto's of sta iCloud-downloads toe."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta runda wymaga co najmniej %1$lld dostępnych zdjęć z wybranego źródła. Wybierz inne źródło, mniej zdjęć lub zezwól na pobieranie z iCloud."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta rodada precisa de pelo menos %1$lld fotos utilizáveis da origem escolhida. Escolha outra origem, uma seleção menor ou permita downloads do iCloud."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta ronda precisa de pelo menos %1$lld fotos utilizáveis da origem escolhida. Escolha outra origem, menos fotos ou permita descargas do iCloud."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Runda necesită cel puțin %1$lld poze utilizabile din sursa aleasă. Alege altă sursă, mai puține poze sau permite descărcarea din iCloud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужно не менее %1$lld доступных фото из выбранного источника. Выберите другой источник, меньше фото или разрешите загрузку из iCloud."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här omgången behöver minst %1$lld användbara bilder från den valda källan. Välj en annan källa, ett mindre urval eller tillåt hämtning från iCloud."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รอบนี้ต้องใช้รูปที่ใช้ได้อย่างน้อย %1$lld รูปจากแหล่งที่เลือก เลือกแหล่งอื่น เลือกให้น้อยลง หรืออนุญาตให้ดาวน์โหลดจาก iCloud"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen kaynaktan en az %1$lld kullanılabilir fotoğraf gerekiyor. Başka bir kaynak, daha az fotoğraf seç veya iCloud indirmelerine izin ver."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Потрібно щонайменше %1$lld доступних фото з вибраного джерела. Вибери інше джерело, менше фото або дозволь завантаження з iCloud."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lượt này cần ít nhất %1$lld ảnh dùng được từ nguồn đã chọn. Hãy chọn nguồn khác, lựa chọn nhỏ hơn hoặc cho phép tải từ iCloud."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本局需要所选来源中至少 %1$lld 张可用照片。请选择其他来源、更少的照片，或允许从 iCloud 下载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這一回合至少需要所選來源中 %1$lld 張可用的照片。請選擇其他來源、較少的選擇，或允許從 iCloud 下載。"
          }
        }
      }
    },
