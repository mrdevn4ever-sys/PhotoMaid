            "value": "Exatamente 6 dígitos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Exact 6 cifre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ровно 6 цифр."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Exakt 6 siffror."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "6 หลักพอดี"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam 6 rakam."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рівно 6 цифр."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đúng 6 chữ số."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "必须为 6 位数字。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "剛好 6 位數。"
          }
        }
      }
    },
    "vault_code_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الرمز هو مفتاح الخزنة. اختر رمزًا لا يخمّنه الآخرون – ويُفضّل ألا يكون رمز دخول iPhone."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne kode er nøglen til boksen. Vælg en, som andre ikke gætter – helst ikke din iPhone-kode."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Code ist der Schlüssel zum Tresor. Wähle einen, den andere nicht erraten – am besten nicht deinen iPhone-Code."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This code is the key to the vault. Choose one that others won’t guess – ideally not your iPhone passcode."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este código es la llave de la caja fuerte. Elige uno que otros no adivinen; mejor que no sea el código de tu iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce code est la clé du coffre-fort. Choisis-en un que les autres ne devineront pas – idéalement pas le code de ton iPhone."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kode ini adalah kunci brankas. Pilih yang tidak mudah ditebak orang lain – sebaiknya bukan kode sandi iPhone-mu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo codice è la chiave della cassaforte. Scegline uno che gli altri non possano indovinare, possibilmente non il codice del tuo iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコードが保管庫の鍵になります。他人に推測されにくいものを選んでください。iPhoneのパスコードとは別のものがおすすめです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 암호가 금고의 열쇠입니다. 다른 사람이 추측하기 어려운 암호를 선택하세요. iPhone 암호와 다른 것이 좋습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne koden er nøkkelen til safen. Velg en som andre ikke gjetter – helst ikke iPhone-koden din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze code is de sleutel tot de kluis. Kies er een die anderen niet raden – liefst niet je iPhone-toegangscode."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten kod jest kluczem do sejfu. Wybierz taki, którego inni nie odgadną – najlepiej inny niż kod dostępu do iPhone’a."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este código é a chave do cofre. Escolha um que outras pessoas não adivinhem – de preferência diferente do código do seu iPhone."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este código é a chave do cofre. Escolhe um que os outros não adivinhem – de preferência, não o código do teu iPhone."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest cod este cheia seifului. Alege unul pe care alții nu-l pot ghici – ideal, nu codul de acces al iPhone-ului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот код — ключ к сейфу. Выбери такой, который другие не угадают, — лучше не код-пароль iPhone."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här koden är nyckeln till valvet. Välj en som andra inte gissar – helst inte din iPhone-lösenkod."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รหัสนี้คือกุญแจของตู้เซฟ เลือกรหัสที่คนอื่นเดาไม่ได้ – ควรไม่ใช่รหัสผ่าน iPhone ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kod kasanın anahtarıdır. Başkalarının tahmin edemeyeceği bir kod seç – tercihen iPhone parolan olmasın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей код — ключ до сейфа. Вибери такий, який інші не вгадають, — краще не код-пароль iPhone."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mã này là chìa khóa của két sắt. Hãy chọn mã người khác khó đoán – tốt nhất không trùng mật mã iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此密码是保险箱的钥匙。请选择别人猜不到的密码——最好不要与 iPhone 锁屏密码相同。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個密碼是保險箱的鑰匙。請選擇別人猜不到的密碼 – 最好不要和 iPhone 密碼相同。"
          }
        }
      }
    },
