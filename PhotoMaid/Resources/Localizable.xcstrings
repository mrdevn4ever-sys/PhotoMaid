    "ana2_stage_privacy": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التحليل غير ممكن حاليًا. يُرجى المحاولة لاحقًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই মুহূর্তে বিশ্লেষণ সম্ভব নয়। অনুগ্রহ করে পরে আবার চেষ্টা করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ara no es pot fer l’anàlisi. Torna-ho a provar més tard."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Analýza teď není možná. Zkuste to prosím později."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyse er ikke mulig lige nu. Prøv igen senere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyse gerade nicht möglich. Bitte später erneut versuchen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ανάλυση δεν είναι δυνατή αυτή τη στιγμή. Δοκίμασε ξανά αργότερα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Analysis isn’t possible right now. Please try again later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora no es posible analizar. Inténtalo más tarde."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyysi ei ole nyt mahdollinen. Yritä myöhemmin uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’analyse n’est pas possible pour le moment. Réessaie plus tard."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અત્યારે વિશ્લેષણ શક્ય નથી. કૃપા કરીને પછી ફરી પ્રયાસ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אי אפשר לבצע ניתוח כרגע. כדאי לנסות שוב מאוחר יותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी विश्लेषण संभव नहीं है। कृपया बाद में फिर कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiza trenutačno nije moguća. Pokušaj ponovno kasnije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az elemzés most nem lehetséges. Próbáld újra később."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Analisis tidak bisa dilakukan sekarang. Coba lagi nanti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al momento l’analisi non è possibile. Riprova più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在は分析できません。後でもう一度お試しください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈಗ ವಿಶ್ಲೇಷಣೆ ಸಾಧ್ಯವಿಲ್ಲ. ದಯವಿಟ್ಟು ನಂತರ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 분석할 수 없습니다. 나중에 다시 시도하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇപ്പോൾ വിശകലനം സാധ്യമല്ല. ദയവായി പിന്നീട് വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आत्ता विश्लेषण शक्य नाही. कृपया नंतर पुन्हा प्रयत्न करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Analisis tidak dapat dibuat sekarang. Sila cuba lagi nanti."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyse er ikke mulig akkurat nå. Prøv igjen senere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyse is nu niet mogelijk. Probeer het later opnieuw."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ବର୍ତ୍ତମାନ ବିଶ୍ଳେଷଣ ସମ୍ଭବ ନୁହେଁ। ଦୟାକରି ପରେ ପୁଣି ଚେଷ୍ଟା କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹੁਣੇ ਵਿਸ਼ਲੇਸ਼ਣ ਸੰਭਵ ਨਹੀਂ। ਕਿਰਪਾ ਕਰਕੇ ਬਾਅਦ ਵਿੱਚ ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiza nie jest teraz możliwa. Spróbuj później."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A análise não é possível agora. Tente novamente mais tarde."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "De momento não é possível analisar. Tenta mais tarde."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiza nu este posibilă acum. Încearcă din nou mai târziu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас анализ невозможен. Попробуй позже."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Analýza teraz nie je možná. Skúste to neskôr."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiza trenutno ni mogoča. Poskusi znova pozneje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Analys är inte möjlig just nu. Försök igen senare."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இப்போது பகுப்பாய்வு சாத்தியமில்லை. பிறகு மீண்டும் முயலுங்கள்."
