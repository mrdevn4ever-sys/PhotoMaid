    "edit_discard_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن يُحفظ تعديلك. يبقى الأصل كما هو."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din redigering gemmes ikke. Originalen forbliver, som den er."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Bearbeitung wird nicht gespeichert. Das Original bleibt, wie es ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your edit won’t be saved. The original stays as it is."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu edición no se guardará. El original queda como está."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta modification ne sera pas enregistrée. L’original reste tel quel."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasil editmu tidak akan disimpan. Aslinya tetap seperti semula."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La modifica non verrà salvata. L’originale resta com’è."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "編集内容は保存されません。元の写真はそのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편집 내용은 저장되지 않아요. 원본은 그대로예요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Redigeringen lagres ikke. Originalen forblir som den er."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bewerking wordt niet opgeslagen. Het origineel blijft zoals het is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Edycja nie zostanie zapisana. Oryginał pozostaje bez zmian."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua edição não será salva. O original fica como está."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A tua edição não será guardada. O original fica como está."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Editarea nu va fi salvată. Originalul rămâne așa cum este."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменения не сохранятся. Оригинал останется как есть."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din redigering sparas inte. Originalet förblir som det är."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแก้ไขของคุณจะไม่ถูกบันทึก ต้นฉบับยังคงเหมือนเดิม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düzenlemen kaydedilmez. Orijinal olduğu gibi kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зміни не збережуться. Оригінал залишиться як є."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉnh sửa của bạn sẽ không được lưu. Bản gốc vẫn giữ nguyên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的编辑不会保存，原图保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的編輯不會被儲存。原始檔保持原樣。"
          }
        }
      }
    },
