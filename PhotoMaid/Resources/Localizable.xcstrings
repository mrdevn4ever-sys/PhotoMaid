          "stringUnit": {
            "state": "translated",
            "value": "En pause. Les résultats obtenus sont conservés."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "થોભાવેલું. અત્યાર સુધીનાં પરિણામો સાચવેલાં છે."
