    "collage_err_save": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر حفظ الكولاج. صورك لم تتغير."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Collage konnte nicht gespeichert werden. Deine Fotos sind unverändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The collage couldn’t be saved. Your photos are unchanged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido guardar el collage. Tus fotos no han cambiado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer le collage. Vos photos sont inchangées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare il collage. Le tue foto sono invariate."
