    "vault2_export_warning": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النسخة المُصدّرة خارج حماية الخزنة. قد تصل إليها تطبيقات أو أشخاص آخرون حسب اختيار المشاركة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এক্সপোর্ট করা কপি ভল্টের সুরক্ষার বাইরে। আপনার শেয়ারের পছন্দ অনুযায়ী অন্য অ্যাপ বা মানুষ এতে অ্যাক্সেস পেতে পারে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La còpia exportada queda fora de la protecció de la caixa forta. Altres apps o persones hi poden accedir segons com la comparteixis."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportovaná kopie je mimo ochranu trezoru. Jiné aplikace nebo lidé k ní mohou mít přístup podle toho, jak ji sdílíte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den eksporterede kopi er uden for boksens beskyttelse. Andre apps eller personer kan få adgang til den afhængigt af, hvordan du deler den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ausgegebene Kopie liegt außerhalb des Tresorschutzes. Andere Apps oder Personen können entsprechend deiner Freigabe darauf zugreifen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το εξαγόμενο αντίγραφο βρίσκεται εκτός προστασίας του θησαυροφυλακίου. Άλλες εφαρμογές ή άτομα μπορεί να έχουν πρόσβαση ανάλογα με το πώς το μοιράζεσαι."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The exported copy is outside vault protection. Other apps or people may access it according to your sharing choice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia exportada queda fuera de la protección de la caja fuerte. Otras apps o personas podrán acceder según lo que compartas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viety kopio on holvin suojauksen ulkopuolella. Muut apit tai ihmiset voivat käyttää sitä sen mukaan, miten jaat sen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La copie exportée n’est plus protégée par le coffre. D’autres apps ou personnes pourront y accéder selon votre partage."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "એક્સપોર્ટ કરેલી નકલ વૉલ્ટની સુરક્ષાની બહાર છે. તમે કેવી રીતે શેર કરો છો તે મુજબ બીજી ઍપ કે લોકો તેને ઍક્સેસ કરી શકે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העותק המיוצא נמצא מחוץ להגנת הכספת. יישומים או אנשים אחרים עשויים לגשת אליו בהתאם לאופן השיתוף."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक्सपोर्ट की गई कॉपी तिजोरी की सुरक्षा से बाहर है। आप कैसे शेयर करते हैं, उसके अनुसार दूसरे ऐप या लोग उस तक पहुँच सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izvezena kopija nalazi se izvan zaštite trezora. Druge aplikacije ili osobe mogu joj pristupiti ovisno o tome kako je dijeliš."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az exportált másolat a széf védelmén kívül van. Más appok vagy személyek a megosztás módjától függően hozzáférhetnek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Salinan yang diekspor berada di luar perlindungan brankas. App atau orang lain mungkin bisa mengaksesnya sesuai pilihan berbagimu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia esportata è fuori dalla protezione della cassaforte. Altre app o persone potranno accedervi in base alla condivisione scelta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き出したコピーは保管庫の保護対象外です。共有方法によっては他のアプリや人がアクセスできます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಎಕ್ಸ್‌ಪೋರ್ಟ್ ಮಾಡಿದ ಪ್ರತಿ ವಾಲ್ಟ್ ರಕ್ಷಣೆಯ ಹೊರಗಿದೆ. ನಿಮ್ಮ ಹಂಚಿಕೆ ಆಯ್ಕೆಯ ಪ್ರಕಾರ ಇತರ ಆ್ಯಪ್‌ಗಳು ಅಥವಾ ಜನರು ಅದನ್ನು ಪ್ರವೇಶಿಸಬಹುದು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내보낸 사본은 보관함 보호 대상이 아닙니다. 공유 방식에 따라 다른 앱이나 사람이 접근할 수 있습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എക്‌സ്‌പോർട്ട് ചെയ്ത പകർപ്പ് വോൾട്ട് സംരക്ഷണത്തിന് പുറത്താണ്. നിങ്ങളുടെ പങ്കിടൽ തിരഞ്ഞെടുപ്പ് അനുസരിച്ച് മറ്റ് ആപ്പുകൾക്കോ ആളുകൾക്കോ അത് ആക്‌സസ് ചെയ്യാനായേക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "एक्सपोर्ट केलेली प्रत व्हॉल्टच्या संरक्षणाबाहेर आहे. तुम्ही कसे शेअर करता त्यानुसार इतर अ‍ॅप्स किंवा लोक ती पाहू शकतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Salinan yang dieksport berada di luar perlindungan peti besi. App atau orang lain mungkin dapat mengaksesnya bergantung pada cara anda berkongsi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den eksporterte kopien er utenfor safens beskyttelse. Andre apper eller personer kan få tilgang til den avhengig av hvordan du deler den."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De uitgegeven kopie valt buiten de kluisbescherming. Andere apps of personen kunnen toegang krijgen volgens je deelkeuze."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏକ୍ସପୋର୍ଟ ହୋଇଥିବା କପି ଭଲ୍ଟ ସୁରକ୍ଷା ବାହାରେ। ଆପଣଙ୍କ ସେୟାର୍ ଚୟନ ଅନୁସାରେ ଅନ୍ୟ ଆପ୍ କିମ୍ବା ଲୋକ ଏହାକୁ ଆକ୍ସେସ୍ କରିପାରନ୍ତି।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਐਕਸਪੋਰਟ ਕੀਤੀ ਕਾਪੀ ਵੌਲਟ ਦੀ ਸੁਰੱਖਿਆ ਤੋਂ ਬਾਹਰ ਹੈ। ਤੁਹਾਡੀ ਸਾਂਝਾ ਕਰਨ ਦੀ ਚੋਣ ਅਨੁਸਾਰ ਹੋਰ ਐਪਾਂ ਜਾਂ ਲੋਕ ਇਸ ਤੱਕ ਪਹੁੰਚ ਸਕਦੇ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyeksportowana kopia nie jest chroniona przez sejf. Inne aplikacje lub osoby mogą uzyskać dostęp zgodnie z wybranym udostępnieniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cópia exportada fica fora da proteção do cofre. Outros apps ou pessoas podem acessá-la conforme a sua escolha de compartilhamento."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A cópia exportada fica fora da proteção do cofre. Outras apps ou pessoas podem aceder conforme a tua partilha."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia exportată este în afara protecției seifului. Alte aplicații sau persoane o pot accesa conform partajării alese."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экспортированная копия не защищена сейфом. Другие приложения или люди могут получить к ней доступ согласно вашему выбору."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportovaná kópia je mimo ochrany trezoru. Iné aplikácie alebo ľudia k nej môžu mať prístup podľa toho, ako ju zdieľate."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izvožena kopija je zunaj zaščite sefa. Druge aplikacije ali osebe lahko dostopajo do nje glede na to, kako jo deliš."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den exporterade kopian ligger utanför valvets skydd. Andra appar eller personer kan komma åt den beroende på hur du delar den."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஏற்றுமதி செய்த நகல் லாக்கர் பாதுகாப்புக்கு வெளியே உள்ளது. உங்கள் பகிர்வுத் தேர்வின்படி மற்ற ஆப்களோ நபர்களோ அதை அணுகலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఎక్స్‌పోర్ట్ చేసిన కాపీ వాల్ట్ రక్షణ బయట ఉంటుంది. మీ షేరింగ్ ఎంపిక ప్రకారం ఇతర యాప్‌లు లేదా వ్యక్తులు దాన్ని యాక్సెస్ చేయవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สำเนาที่ส่งออกอยู่นอกการป้องกันของตู้เซฟ แอพหรือบุคคลอื่นอาจเข้าถึงได้ตามตัวเลือกการแชร์ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dışa aktarılan kopya kasa koruması dışındadır. Paylaşım seçimine göre diğer uygulama veya kişiler erişebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Експортована копія не захищена сховищем. Інші програми або люди можуть отримати доступ відповідно до вашого вибору."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایکسپورٹ کی گئی کاپی والٹ کے تحفظ سے باہر ہے۔ آپ کیسے شیئر کرتے ہیں، اس کے مطابق دوسری ایپس یا لوگ اس تک پہنچ سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản sao đã xuất nằm ngoài sự bảo vệ của két sắt. Ứng dụng hoặc người khác có thể truy cập tùy theo lựa chọn chia sẻ của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出的副本不受保险库保护。其他应用或人员可能根据你的分享选择访问它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸出的副本不受保險箱保護。其他 App 或人員可能會依你的分享選擇取用它。"
          }
        }
      }
    },
