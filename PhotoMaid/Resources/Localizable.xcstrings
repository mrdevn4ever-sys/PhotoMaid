    "archive_intro": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينسخ GaleriQ الصور والفيديوهات إلى مجلد تختاره – مثلًا على ذاكرة USB أو قرص خارجي أو في تطبيق الملفات. ثم تُقارن كل نسخة بالأصل بايتًا بايتًا. تبقى أصولك في تطبيق الصور، ولا يُحذف أي شيء."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ kopierer fotos og videoer til en mappe, du vælger – f.eks. på en USB-nøgle, et eksternt drev eller i appen Arkiver. Hver kopi sammenlignes derefter byte for byte med originalen. Dine originaler bliver i Fotos, og intet slettes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ kopiert Fotos und Videos in einen Ordner deiner Wahl – zum Beispiel auf einen USB-Stick, eine externe Festplatte oder in die Dateien-App. Danach wird jede Kopie Byte für Byte mit dem Original verglichen. Deine Originale bleiben in Fotos, gelöscht wird nichts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ copies photos and videos into a folder you choose – for example on a USB stick, an external drive or in the Files app. Each copy is then compared byte for byte with the original. Your originals stay in Photos, and nothing is deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ copia fotos y vídeos en una carpeta que elijas, por ejemplo en una memoria USB, un disco externo o en la app Archivos. Después compara cada copia byte a byte con el original. Tus originales se quedan en Fotos y no se borra nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ copie des photos et vidéos dans un dossier de votre choix – par exemple sur une clé USB, un disque externe ou dans l’app Fichiers. Chaque copie est ensuite comparée octet par octet à l’original. Vos originaux restent dans Photos et rien n’est supprimé."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ menyalin foto dan video ke folder pilihanmu – misalnya di flashdisk USB, drive eksternal, atau app File. Setiap salinan lalu dibandingkan byte demi byte dengan aslinya. Aslinya tetap di Foto, dan tidak ada yang dihapus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ copia foto e video in una cartella a tua scelta, ad esempio su una chiavetta USB, un disco esterno o nell’app File. Poi confronta ogni copia byte per byte con l’originale. I tuoi originali restano in Foto e non viene eliminato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQは写真やビデオを、選んだフォルダ（USBメモリ、外付けドライブ、「ファイル」アプリなど）にコピーします。その後、各コピーを元のファイルと1バイトずつ照合します。元の写真は「写真」に残り、何も削除されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ가 사진과 동영상을 선택한 폴더(예: USB 메모리, 외장 드라이브, 파일 앱)에 복사해요. 그런 다음 각 사본을 원본과 바이트 단위로 비교해요. 원본은 사진 앱에 그대로 있고 아무것도 삭제되지 않아요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ kopierer bilder og videoer til en mappe du velger – for eksempel på en minnepinne, en ekstern disk eller i Filer-appen. Hver kopi sammenlignes deretter byte for byte med originalen. Originalene dine blir i Bilder, og ingenting slettes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ kopieert foto’s en video’s naar een map naar keuze – bijvoorbeeld op een usb-stick, een externe schijf of in de Bestanden-app. Daarna wordt elke kopie byte voor byte met het origineel vergeleken. Je originelen blijven in Foto’s en er wordt niets verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ kopiuje zdjęcia i filmy do wybranego folderu – na przykład na pendrive, dysk zewnętrzny lub do aplikacji Pliki. Następnie każda kopia jest porównywana bajt po bajcie z oryginałem. Oryginały zostają w Zdjęciach i nic nie jest usuwane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O GaleriQ copia fotos e vídeos para uma pasta que você escolher – por exemplo, num pendrive, num disco externo ou no app Arquivos. Cada cópia é depois comparada byte a byte com o original. Seus originais ficam no Fotos e nada é apagado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O GaleriQ copia fotografias e vídeos para uma pasta à sua escolha – por exemplo, uma pen USB, um disco externo ou a app Ficheiros. Depois, cada cópia é comparada byte a byte com o original. Os originais ficam nas Fotografias e nada é apagado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ copiază fotografii și videoclipuri într-un dosar ales de tine – de exemplu pe un stick USB, un hard disk extern sau în aplicația Fișiere. Apoi fiecare copie este comparată octet cu octet cu originalul. Originalele rămân în Poze și nimic nu este șters."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ копирует фото и видео в выбранную вами папку – например, на USB-флешку, внешний диск или в приложение «Файлы». Затем каждая копия побайтно сверяется с оригиналом. Оригиналы остаются в «Фото», ничего не удаляется."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ kopierar bilder och videor till en mapp du väljer – till exempel på ett USB-minne, en extern disk eller i appen Filer. Varje kopia jämförs sedan byte för byte med originalet. Dina original stannar i Bilder och inget raderas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ คัดลอกรูปภาพและวิดีโอไปยังโฟลเดอร์ที่คุณเลือก – เช่น แฟลชไดรฟ์ USB ฮาร์ดดิสก์ภายนอก หรือในแอพไฟล์ จากนั้นแต่ละสำเนาจะถูกเปรียบเทียบกับต้นฉบับทีละไบต์ ต้นฉบับของคุณยังอยู่ในรูปภาพ และไม่มีอะไรถูกลบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ fotoğraf ve videoları seçtiğin bir klasöre kopyalar; örneğin bir USB belleğe, harici diske veya Dosyalar uygulamasına. Ardından her kopya orijinalle bayt bayt karşılaştırılır. Orijinallerin Fotoğraflar’da kalır, hiçbir şey silinmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ копіює фото й відео до вибраної вами папки – наприклад, на USB-флешку, зовнішній диск або в програму «Файли». Потім кожну копію побайтово звіряють з оригіналом. Оригінали залишаються у «Фото», нічого не видаляється."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ sao chép ảnh và video vào thư mục bạn chọn – ví dụ trên USB, ổ cứng ngoài hoặc trong ứng dụng Tệp. Sau đó mỗi bản sao được so sánh từng byte với bản gốc. Bản gốc của bạn vẫn ở trong Ảnh và không có gì bị xóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ 会将照片和视频复制到你选择的文件夹，例如 U 盘、外置硬盘或“文件”App。随后逐字节将每份副本与原件比对。原件仍保留在“照片”中，不会删除任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ 會把照片和影片複製到你選擇的檔案夾 – 例如 USB 隨身碟、外接硬碟或「檔案」App 中。每份副本都會與原始檔逐位元組比對。你的原始檔仍留在「照片」中，不會刪除任何內容。"
          }
        }
      }
    },
    "archive_intro_title": {
