    "dup_how": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقارن GaleriQ محتوى الملفات على جهازك مباشرةً. الصور المتشابهة في الشكل ليست نسخًا متطابقة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ফাইলের বিষয়বস্তু সরাসরি আপনার ডিভাইসে তুলনা করে। দেখতে একই রকম ছবি অভিন্ন কপি হিসেবে গণ্য হয় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ compara el contingut dels fitxers directament al dispositiu. Les imatges que s’assemblen no compten com a còpies idèntiques."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ porovnává obsah souborů přímo ve vašem zařízení. Obrázky, které jen vypadají podobně, se nepočítají jako identické kopie."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ sammenligner filindholdet direkte på din enhed. Billeder, der ligner hinanden, tæller ikke som identiske kopier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ vergleicht die Dateiinhalte direkt auf deinem Gerät. Ähnlich aussehende Bilder zählen nicht als identische Kopien."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το GaleriQ συγκρίνει το περιεχόμενο των αρχείων απευθείας στη συσκευή σου. Εικόνες που απλώς μοιάζουν δεν θεωρούνται πανομοιότυπα αντίγραφα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ compares file contents directly on your device. Similar-looking images don’t count as identical copies."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ compara el contenido de los archivos en tu dispositivo. Las imágenes parecidas no cuentan como copias idénticas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ vertaa tiedostojen sisältöä suoraan laitteellasi. Samannäköisiä kuvia ei lasketa identtisiksi kopioiksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ compare le contenu des fichiers directement sur ton appareil. Les images qui se ressemblent ne comptent pas comme des copies identiques."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ફાઇલોની સામગ્રીની સરખામણી સીધી તમારા ઉપકરણ પર કરે છે. ફક્ત સરખી દેખાતી છબીઓ સરખી નકલો ગણાતી નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ משווה את תוכן הקבצים ישירות במכשיר. תמונות שרק נראות דומות לא נחשבות לעותקים זהים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ फ़ाइलों की सामग्री की तुलना सीधे आपके डिवाइस पर करता है। सिर्फ़ मिलती-जुलती दिखने वाली तस्वीरें एक जैसी कॉपी नहीं मानी जातीं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ uspoređuje sadržaj datoteka izravno na tvom uređaju. Slike koje samo sliče ne računaju se kao identične kopije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A GaleriQ közvetlenül az eszközödön hasonlítja össze a fájlok tartalmát. A csak hasonló képek nem számítanak azonos másolatnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ membandingkan isi file langsung di perangkatmu. Gambar yang terlihat mirip tidak dihitung sebagai salinan identik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ confronta i contenuti dei file sul tuo dispositivo. Le immagini che si assomigliano non contano come copie identiche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQは端末内でファイルの内容を比較します。見た目が似ているだけの画像は、同じコピーとはみなしません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ಫೈಲ್ ವಿಷಯಗಳನ್ನು ನೇರವಾಗಿ ನಿಮ್ಮ ಸಾಧನದಲ್ಲಿ ಹೋಲಿಸುತ್ತದೆ. ಒಂದೇ ರೀತಿ ಕಾಣುವ ಚಿತ್ರಗಳನ್ನು ಒಂದೇ ಪ್ರತಿಗಳೆಂದು ಎಣಿಸಲಾಗುವುದಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ는 기기에서 파일 내용을 직접 비교해요. 비슷하게 보이기만 하는 이미지는 같은 사본으로 보지 않아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ഫയൽ ഉള്ളടക്കം നേരിട്ട് നിങ്ങളുടെ ഉപകരണത്തിൽ താരതമ്യം ചെയ്യുന്നു. ഒരുപോലെ തോന്നുന്ന ചിത്രങ്ങളെ ഒരുപോലെയുള്ള പകർപ്പുകളായി കണക്കാക്കില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ फाइल्सच्या मजकुराची तुलना थेट तुमच्या डिव्हाइसवर करते. फक्त सारख्या दिसणाऱ्या प्रतिमा एकसारख्या प्रती मानल्या जात नाहीत."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ membandingkan kandungan fail terus pada peranti anda. Imej yang kelihatan serupa tidak dikira sebagai salinan yang sama."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ sammenligner filinnholdet direkte på enheten din. Bilder som ser like ut, regnes ikke som identiske kopier."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ vergelijkt bestandsinhoud op je apparaat. Afbeeldingen die op elkaar lijken, tellen niet als identieke kopieën."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ଫାଇଲ୍ ବିଷୟବସ୍ତୁକୁ ସିଧାସଳଖ ଆପଣଙ୍କ ଡିଭାଇସ୍‌ରେ ତୁଳନା କରେ। ସମାନ ଦେଖାଯାଉଥିବା ଛବିକୁ ସମାନ କପି ଭାବେ ଗଣାଯାଏ ନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ਫ਼ਾਈਲਾਂ ਦੀ ਸਮੱਗਰੀ ਦੀ ਤੁਲਨਾ ਸਿੱਧੇ ਤੁਹਾਡੀ ਡਿਵਾਈਸ ਉੱਤੇ ਕਰਦਾ ਹੈ। ਸਿਰਫ਼ ਮਿਲਦੀਆਂ-ਜੁਲਦੀਆਂ ਦਿਸਣ ਵਾਲੀਆਂ ਤਸਵੀਰਾਂ ਇੱਕੋ ਜਿਹੀਆਂ ਕਾਪੀਆਂ ਨਹੀਂ ਮੰਨੀਆਂ ਜਾਂਦੀਆਂ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ porównuje zawartość plików na urządzeniu. Podobnie wyglądające zdjęcia nie są uznawane za identyczne kopie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O GaleriQ compara o conteúdo dos arquivos diretamente no seu aparelho. Imagens parecidas não contam como cópias idênticas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O GaleriQ compara o conteúdo dos ficheiros no teu dispositivo. Imagens parecidas não contam como cópias idênticas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ compară conținutul fișierelor pe dispozitiv. Imaginile care seamănă nu sunt considerate copii identice."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ сравнивает содержимое файлов на устройстве. Похожие изображения не считаются одинаковыми копиями."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ porovnáva obsah súborov priamo vo vašom zariadení. Obrázky, ktoré len vyzerajú podobne, sa nepočítajú ako identické kópie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ primerja vsebino datotek neposredno v tvoji napravi. Slike, ki so si le podobne, ne štejejo za enake kopije."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ jämför filinnehållet direkt på din enhet. Bilder som ser likadana ut räknas inte som identiska kopior."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ கோப்பு உள்ளடக்கத்தை நேரடியாக உங்கள் சாதனத்தில் ஒப்பிடுகிறது. ஒத்துத் தோன்றும் படங்கள் ஒரே நகல்களாகக் கணக்கிடப்படாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ఫైల్ కంటెంట్‌ను నేరుగా మీ పరికరంలో పోలుస్తుంది. ఒకేలా కనిపించే చిత్రాలు ఒకేలాంటి కాపీలుగా లెక్కించబడవు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ เปรียบเทียบเนื้อหาไฟล์บนอุปกรณ์ของคุณโดยตรง รูปที่ดูคล้ายกันไม่นับเป็นสำเนาที่เหมือนกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ dosya içeriklerini cihazında karşılaştırır. Benzer görünen resimler birebir aynı kopya sayılmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ порівнює вміст файлів на твоєму пристрої. Схожі зображення не вважаються ідентичними копіями."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ فائلوں کے مواد کا موازنہ براہ راست آپ کی ڈیوائس پر کرتا ہے۔ صرف ملتی جلتی نظر آنے والی تصویریں یکساں کاپیاں نہیں سمجھی جاتیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ so sánh nội dung tệp ngay trên thiết bị của bạn. Ảnh trông giống nhau không được tính là bản sao giống hệt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ 直接在设备上比较文件内容。只是看起来相似的图片不算相同副本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ 直接在你的裝置上比較檔案內容。看起來相似的圖片不算相同的副本。"
          }
        }
      }
    },
    "dup_icloud_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحمّل النسخ الأصلية غير الموجودة عبر Wi-Fi. قد تستغرق المكتبات الكبيرة وقتًا وتستهلك بيانات كثيرة. يبحث في الوسائط المسموح بها والمجلدات المتصلة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অনুপস্থিত মূল ফাইল Wi-Fi-তে ডাউনলোড করে। বড় লাইব্রেরিতে সময় লাগতে পারে এবং অনেক ডেটা খরচ হতে পারে। অনুমোদিত মিডিয়া ও সংযুক্ত ফোল্ডারে খোঁজে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixa els originals que falten per Wi-Fi. Les fototeques grans poden trigar i gastar moltes dades. Cerca als elements permesos i a les carpetes connectades."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stáhne chybějící originály přes Wi-Fi. Velké knihovny mohou trvat dlouho a spotřebovat hodně dat. Prohledává povolená média a připojené složky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Henter manglende originaler via Wi-Fi. Store biblioteker kan tage tid og bruge meget data. Søger i tilladte medier og forbundne mapper."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lädt fehlende Originale über WLAN. Große Mediatheken können viel Zeit und Daten benötigen. Durchsucht freigegebene Medien und verbundene Ordner."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Λαμβάνει τα πρωτότυπα που λείπουν μέσω Wi-Fi. Μεγάλες βιβλιοθήκες μπορεί να αργήσουν και να καταναλώσουν πολλά δεδομένα. Αναζητά σε επιτρεπόμενα πολυμέσα και συνδεδεμένους φακέλους."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads missing originals over Wi-Fi. Large libraries can take time and use a lot of data. Searches permitted media and connected folders."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarga los originales que faltan por Wi-Fi. Las bibliotecas grandes pueden tardar y consumir muchos datos. Busca en los medios autorizados y las carpetas conectadas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lataa puuttuvat alkuperäiset Wi-Fin kautta. Suuret kirjastot voivat viedä aikaa ja kuluttaa paljon dataa. Hakee sallituista medioista ja yhdistetyistä kansioista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Télécharge les originaux manquants par Wi-Fi. Les grandes photothèques peuvent prendre du temps et consommer beaucoup de données. Recherche dans les médias autorisés et les dossiers connectés."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ખૂટતી મૂળ ફાઇલો Wi-Fi પર ડાઉનલોડ કરે છે. મોટી લાઇબ્રેરીઓમાં સમય અને ઘણો ડેટા લાગી શકે છે. મંજૂર મીડિયા અને જોડેલાં ફોલ્ડરમાં શોધે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מוריד מקוריים חסרים דרך Wi-Fi. בספריות גדולות זה עשוי לקחת זמן ולצרוך הרבה נתונים. מחפש במדיה המותרת ובתיקיות המחוברות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गायब मूल फ़ाइलें Wi-Fi पर डाउनलोड करता है। बड़ी लाइब्रेरी में समय और काफ़ी डेटा लग सकता है। अनुमत मीडिया और जुड़े फ़ोल्डर में खोजता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Preuzima originale koji nedostaju preko Wi-Fija. Velike medijateke mogu potrajati i potrošiti puno podataka. Pretražuje dopuštene medije i povezane mape."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hiányzó eredetiket Wi-Fin tölti le. Nagy könyvtáraknál ez sokáig tarthat és sok adatot használhat. Az engedélyezett médiában és a csatlakoztatott mappákban keres."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengunduh asli yang belum ada lewat Wi-Fi. Pustaka besar bisa butuh waktu dan banyak data. Mencari di media yang diizinkan dan folder tersambung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarica gli originali mancanti tramite Wi-Fi. Le librerie grandi possono richiedere tempo e molti dati. Cerca nei contenuti autorizzati e nelle cartelle collegate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "不足しているオリジナルをWi-Fiでダウンロードします。大きなライブラリでは時間と大量のデータ通信が必要になる場合があります。アクセスを許可したメディアと接続したフォルダを検索します。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕಾಣೆಯಾದ ಮೂಲಗಳನ್ನು Wi-Fi ಮೂಲಕ ಡೌನ್‌ಲೋಡ್ ಮಾಡುತ್ತದೆ. ದೊಡ್ಡ ಲೈಬ್ರರಿಗಳಿಗೆ ಸಮಯ ಹಿಡಿಯಬಹುದು ಮತ್ತು ಹೆಚ್ಚು ಡೇಟಾ ಬಳಸಬಹುದು. ಅನುಮತಿಸಿದ ಮಾಧ್ಯಮ ಮತ್ತು ಸಂಪರ್ಕಿತ ಫೋಲ್ಡರ್‌ಗಳಲ್ಲಿ ಹುಡುಕುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기에 없는 원본을 Wi-Fi로 다운로드합니다. 보관함이 크면 시간과 데이터가 많이 필요할 수 있습니다. 접근이 허용된 미디어와 연결된 폴더를 검색합니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇല്ലാത്ത ഒറിജിനലുകൾ Wi-Fi വഴി ഡൗൺലോഡ് ചെയ്യുന്നു. വലിയ ലൈബ്രറികൾക്ക് സമയമെടുക്കാം, ധാരാളം ഡാറ്റ ഉപയോഗിക്കാം. അനുവദിച്ച മീഡിയയിലും കണക്റ്റ് ചെയ്ത ഫോൾഡറുകളിലും തിരയുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "गहाळ मूळ फाइल्स Wi-Fi वर डाउनलोड करते. मोठ्या लायब्ररींना वेळ आणि बराच डेटा लागू शकतो. परवानगी असलेल्या मीडिया आणि जोडलेल्या फोल्डरमध्ये शोधते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Memuat turun fail asal yang tiada melalui Wi-Fi. Pustaka besar boleh mengambil masa dan menggunakan banyak data. Mencari dalam media yang dibenarkan dan folder bersambung."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Laster ned manglende originaler via Wi-Fi. Store biblioteker kan ta tid og bruke mye data. Søker i tillatte medier og tilkoblede mapper."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloadt ontbrekende originelen via wifi. Grote bibliotheken kunnen veel tijd en data kosten. Doorzoekt toegestane media en gekoppelde mappen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ନଥିବା ମୂଳ ଫାଇଲ୍ Wi-Fiରେ ଡାଉନଲୋଡ୍ କରେ। ବଡ଼ ଲାଇବ୍ରେରୀରେ ସମୟ ଲାଗିପାରେ ଏବଂ ଅଧିକ ଡାଟା ଖର୍ଚ୍ଚ ହୋଇପାରେ। ଅନୁମୋଦିତ ମିଡିଆ ଓ ସଂଯୁକ୍ତ ଫୋଲ୍ଡରରେ ଖୋଜେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਗੁੰਮ ਮੂਲ ਫ਼ਾਈਲਾਂ Wi-Fi ਉੱਤੇ ਡਾਊਨਲੋਡ ਕਰਦਾ ਹੈ। ਵੱਡੀਆਂ ਲਾਇਬ੍ਰੇਰੀਆਂ ਵਿੱਚ ਸਮਾਂ ਅਤੇ ਕਾਫ਼ੀ ਡਾਟਾ ਲੱਗ ਸਕਦਾ ਹੈ। ਮਨਜ਼ੂਰ ਮੀਡੀਆ ਅਤੇ ਜੁੜੇ ਫ਼ੋਲਡਰਾਂ ਵਿੱਚ ਖੋਜਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobiera brakujące oryginały przez Wi-Fi. Duże biblioteki mogą wymagać czasu i wielu danych. Przeszukuje udostępnione multimedia i połączone foldery."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixa originais ausentes via Wi-Fi. Bibliotecas grandes podem demorar e usar muitos dados. Busca nas mídias permitidas e nas pastas conectadas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarrega os originais em falta por Wi-Fi. Bibliotecas grandes podem demorar e consumir muitos dados. Pesquisa conteúdos autorizados e pastas ligadas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarcă originalele lipsă prin Wi-Fi. Bibliotecile mari pot necesita timp și multe date. Caută în conținutul permis și în dosarele conectate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загружает недостающие оригиналы по Wi-Fi. Для большой медиатеки может потребоваться много времени и трафика. Поиск выполняется в разрешённых медиафайлах и подключённых папках."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Stiahne chýbajúce originály cez Wi-Fi. Veľké knižnice môžu trvať dlho a spotrebovať veľa dát. Prehľadáva povolené médiá a pripojené priečinky."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenese manjkajoče izvirnike prek Wi-Fi. Velike knjižnice lahko trajajo dolgo in porabijo veliko podatkov. Išče po dovoljenih medijih in povezanih mapah."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hämtar saknade original via wifi. Stora bibliotek kan ta tid och använda mycket data. Söker i tillåtna medier och anslutna mappar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இல்லாத அசல்களை Wi-Fi மூலம் பதிவிறக்குகிறது. பெரிய நூலகங்களுக்கு நேரம் ஆகலாம், அதிக தரவு செலவாகலாம். அனுமதித்த மீடியா மற்றும் இணைக்கப்பட்ட கோப்புறைகளில் தேடுகிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "లేని ఒరిజినల్‌లను Wi-Fi ద్వారా డౌన్‌లోడ్ చేస్తుంది. పెద్ద లైబ్రరీలకు సమయం పట్టవచ్చు, ఎక్కువ డేటా ఖర్చవ్వవచ్చు. అనుమతించిన మీడియా, కనెక్ట్ చేసిన ఫోల్డర్‌లలో వెతుకుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดาวน์โหลดต้นฉบับที่ขาดหายผ่าน Wi-Fi คลังขนาดใหญ่อาจใช้เวลาและข้อมูลมาก ค้นหาในสื่อที่อนุญาตและโฟลเดอร์ที่เชื่อมต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksik özgünleri Wi-Fi üzerinden indirir. Büyük arşivler zaman ve çok miktarda veri gerektirebilir. İzin verilen ortamları ve bağlı klasörleri arar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завантажує відсутні оригінали через Wi-Fi. Великі медіатеки можуть потребувати багато часу й трафіку. Шукає в дозволених медіафайлах і підключених папках."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "غائب اصل فائلیں Wi-Fi پر ڈاؤن لوڈ کرتا ہے۔ بڑی لائبریریوں میں وقت اور کافی ڈیٹا لگ سکتا ہے۔ اجازت یافتہ میڈیا اور منسلک فولڈرز میں تلاش کرتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tải bản gốc còn thiếu qua Wi-Fi. Thư viện lớn có thể mất thời gian và tốn nhiều dữ liệu. Tìm trong phương tiện được phép và thư mục đã kết nối."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过无线局域网下载缺失的原片。大型图库可能需要较长时间并消耗大量流量。搜索已授权的媒体和已连接的文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過 Wi-Fi 下載缺少的原始檔。大型圖庫可能需要一些時間並使用大量數據。會搜尋允許的媒體和已連接的檔案夾。"
          }
        }
      }
    },
