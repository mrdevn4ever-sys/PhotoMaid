    "tour_vault_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مطولًا على «GaleriQ» في الأعلى لمدة ثانيتين لفتح الخزنة – يدور القرص داخل حرف «Q». الإعداد والمزيد من الخيارات في الإعدادات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভল্ট খুলতে উপরের “GaleriQ” ২ সেকেন্ড চেপে ধরুন – “Q”-এর ভেতরের ডায়াল ঘোরে। সেটিংসে এটি সেট আপ করুন ও আরও বিকল্প খুঁজুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén premut «GaleriQ» a dalt durant 2 segons per obrir la caixa forta: la roda del «Q» gira. Configura-la i troba més opcions a Configuració."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podržte „GaleriQ“ nahoře 2 sekundy a otevře se trezor – kolečko v „Q“ se otočí. Nastavte ho a další možnosti najdete v Nastavení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold på “GaleriQ” øverst i 2 sekunder for at åbne boksen – drejeknappen i “Q” drejer. Konfigurer den, og find flere muligheder i Indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte oben „GaleriQ“ 2 Sekunden gedrückt, um den Tresor zu öffnen – das Rad im „Q“ dreht sich dabei. Einrichten und weitere Optionen findest du in den Einstellungen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κράτα πατημένο το «GaleriQ» στο επάνω μέρος για 2 δευτερόλεπτα για να ανοίξεις το θησαυροφυλάκιο – ο δίσκος στο «Q» γυρίζει. Ρύθμισέ το και βρες περισσότερες επιλογές στις Ρυθμίσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold “GaleriQ” at the top for 2 seconds to open the vault – the dial in the “Q” turns. Set it up and find more options in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado «GaleriQ» arriba durante 2 segundos para abrir la caja fuerte; el dial de la «Q» gira. Configúrala y encuentra más opciones en Ajustes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä ylhäällä olevaa ”GaleriQ”-tekstiä painettuna 2 sekuntia avataksesi holvin – ”Q”:n numerolukko pyörii. Ota se käyttöön ja löydä lisää valintoja Asetuksista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez « GaleriQ » en haut pendant 2 secondes pour ouvrir le coffre – le cadran du « Q » tourne. Configuration et autres options dans Paramètres."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "વૉલ્ટ ખોલવા ઉપરના “GaleriQ” ને 2 સેકન્ડ દબાવી રાખો – “Q” માંનું ડાયલ ફરે છે. તેને સેટ કરો અને સેટિંગ્સમાં વધુ વિકલ્પો શોધો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לחיצה ארוכה של 2 שניות על „GaleriQ” למעלה פותחת את הכספת – החוגה שב-„Q” מסתובבת. אפשר להגדיר אותה ולמצוא עוד אפשרויות בהגדרות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तिजोरी खोलने के लिए ऊपर “GaleriQ” को 2 सेकंड दबाए रखें – “Q” का डायल घूमता है। इसे सेट करें और सेटिंग्ज़ में और विकल्प पाएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Drži „GaleriQ” na vrhu 2 sekunde da otvoriš trezor – brojčanik u „Q” se okreće. Postavi ga i pronađi više opcija u Postavkama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tartsd lenyomva 2 másodpercig a fenti „GaleriQ” feliratot a széf megnyitásához – a „Q” számzára elfordul. Állítsd be, és további lehetőségeket a Beállításokban találsz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahan “GaleriQ” di bagian atas selama 2 detik untuk membuka brankas – cakram di “Q” berputar. Atur brankas dan temukan opsi lain di Pengaturan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto «GaleriQ» in alto per 2 secondi per aprire la cassaforte: la manopola nella «Q» gira. Configurazione e altre opzioni in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上部の「GaleriQ」を2秒間長押しすると保管庫が開き、「Q」のダイヤルが回ります。設定やその他のオプションは「設定」にあります。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ವಾಲ್ಟ್ ತೆರೆಯಲು ಮೇಲಿರುವ “GaleriQ” ಅನ್ನು 2 ಸೆಕೆಂಡ್ ಒತ್ತಿ ಹಿಡಿಯಿರಿ – “Q” ನಲ್ಲಿರುವ ಡಯಲ್ ತಿರುಗುತ್ತದೆ. ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಅದನ್ನು ಹೊಂದಿಸಿ ಮತ್ತು ಇನ್ನಷ್ಟು ಆಯ್ಕೆಗಳನ್ನು ಹುಡುಕಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위쪽의 ‘GaleriQ’를 2초 동안 길게 누르면 금고가 열리고 ‘Q’ 안의 다이얼이 돌아가요. 설정과 추가 옵션은 설정에 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വോൾട്ട് തുറക്കാൻ മുകളിലുള്ള “GaleriQ” 2 സെക്കൻഡ് അമർത്തിപ്പിടിക്കുക – “Q”-ലെ ഡയൽ കറങ്ങും. ക്രമീകരണങ്ങളിൽ ഇത് സജ്ജമാക്കുകയും കൂടുതൽ ഓപ്ഷനുകൾ കണ്ടെത്തുകയും ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "व्हॉल्ट उघडण्यासाठी वरचे “GaleriQ” 2 सेकंद दाबून ठेवा – “Q” मधील डायल फिरतो. तो सेट करा आणि सेटिंग्जमध्ये आणखी पर्याय शोधा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahan “GaleriQ” di bahagian atas selama 2 saat untuk membuka peti besi – dail dalam “Q” berputar. Sediakannya dan cari lebih banyak pilihan dalam Seting."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold på «GaleriQ» øverst i 2 sekunder for å åpne safen – hjulet i «Q» dreier. Sett den opp og finn flere valg i Innstillinger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd bovenaan ‘GaleriQ’ 2 seconden ingedrukt om de kluis te openen – de draaischijf in de ‘Q’ draait mee. Instellen en meer opties vind je in Instellingen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଭଲ୍ଟ ଖୋଲିବାକୁ ଉପରେ “GaleriQ”କୁ 2 ସେକେଣ୍ଡ ଦବାଇ ଧରନ୍ତୁ – “Q” ଭିତରର ଡାଏଲ୍ ଘୁରେ। ସେଟିଂସରେ ଏହାକୁ ସେଟ୍ ଅପ୍ କରନ୍ତୁ ଓ ଅଧିକ ବିକଳ୍ପ ଖୋଜନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਵੌਲਟ ਖੋਲ੍ਹਣ ਲਈ ਉੱਪਰ “GaleriQ” ਨੂੰ 2 ਸਕਿੰਟ ਦਬਾ ਕੇ ਰੱਖੋ – “Q” ਵਿਚਲਾ ਡਾਇਲ ਘੁੰਮਦਾ ਹੈ। ਇਸ ਨੂੰ ਸੈੱਟ ਕਰੋ ਅਤੇ ਸੈਟਿੰਗਾਂ ਵਿੱਚ ਹੋਰ ਵਿਕਲਪ ਲੱਭੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymaj „GaleriQ” u góry przez 2 sekundy, aby otworzyć sejf – pokrętło w „Q” się obraca. Konfiguracja i więcej opcji w Ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure “GaleriQ” no topo por 2 segundos para abrir o cofre – o disco no “Q” gira. Configure-o e encontre mais opções em Ajustes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha premido «GaleriQ» no topo durante 2 segundos para abrir o cofre – o marcador no «Q» roda. Configuração e mais opções em Definições."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ține apăsat „GaleriQ” sus timp de 2 secunde ca să deschizi seiful – discul din „Q” se rotește. Configurarea și alte opțiuni sunt în Setări."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте «GaleriQ» вверху 2 секунды, чтобы открыть сейф, — диск в букве «Q» повернётся. Настройка и другие параметры — в Настройках."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Podržte „GaleriQ“ hore 2 sekundy a otvorí sa trezor – koliesko v „Q“ sa otočí. Nastavte ho a ďalšie možnosti nájdete v Nastaveniach."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pridrži »GaleriQ« na vrhu 2 sekundi, da odpreš sef – številčnica v »Q« se zavrti. Nastavi ga in poišči več možnosti v Nastavitvah."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll på ”GaleriQ” högst upp i 2 sekunder för att öppna valvet – ratten i ”Q” vrids. Ställ in det och hitta fler alternativ i Inställningar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "லாக்கரைத் திறக்க மேலே உள்ள “GaleriQ”-ஐ 2 விநாடிகள் அழுத்திப் பிடியுங்கள் – “Q”-இல் உள்ள டயல் சுழலும். அமைப்புகளில் இதை அமைத்து மேலும் விருப்பங்களைக் காணுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వాల్ట్ తెరవడానికి పైన ఉన్న “GaleriQ”ను 2 సెకన్లు నొక్కి పట్టుకోండి – “Q”లోని డయల్ తిరుగుతుంది. సెట్టింగ్‌లలో దాన్ని సెటప్ చేసి మరిన్ని ఎంపికలు కనుగొనండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะค้างที่ “GaleriQ” ด้านบน 2 วินาทีเพื่อเปิดตู้เซฟ – แป้นหมุนใน “Q” จะหมุน ตั้งค่าและดูตัวเลือกเพิ่มเติมได้ในการตั้งค่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasayı açmak için üstteki “GaleriQ” yazısına 2 saniye basılı tut – “Q” harfindeki kadran döner. Kurulum ve diğer seçenekler Ayarlar’da."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Утримуйте «GaleriQ» угорі 2 секунди, щоб відкрити сейф, — диск у літері «Q» повернеться. Налаштування та інші параметри — у Налаштуваннях."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "والٹ کھولنے کے لیے اوپر ”GaleriQ“ کو 2 سیکنڈ دبائے رکھیں – ”Q“ کا ڈائل گھومتا ہے۔ اسے سیٹ کریں اور ترتیبات میں مزید اختیارات پائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ “GaleriQ” ở trên cùng trong 2 giây để mở két sắt – vòng xoay trong chữ “Q” sẽ quay. Thiết lập và tìm thêm tùy chọn trong Cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住顶部的“GaleriQ”2 秒即可打开保险箱，“Q”中的转盘会随之转动。设置及更多选项请前往“设置”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住頂端的「GaleriQ」2 秒即可打開保險箱 –「Q」中的轉盤會轉動。在「設定」中設定保險箱並找到更多選項。"
          }
        }
      }
    },
