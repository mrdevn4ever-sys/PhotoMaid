    "movie_kenburns_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقترب الصور ببطء حتى لا تبدو جامدة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফটো ধীরে ধীরে জুম হয় যাতে স্থির না লাগে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fotos s’amplien lentament perquè no semblin estàtiques."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotky se pomalu přibližují, aby nepůsobily staticky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos zoomer langsomt ind, så de ikke virker statiske."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos zoomen langsam heran, damit sie nicht starr wirken."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι φωτογραφίες μεγεθύνονται αργά για να μη φαίνονται στατικές."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos zoom in slowly so they don’t look static."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos se acercan despacio para que no parezcan estáticas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvat zoomautuvat hitaasti, jotta ne eivät näytä staattisilta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos zooment lentement pour ne pas paraître figées."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફોટા સ્થિર ન લાગે તે માટે ધીમે ધીમે ઝૂમ થાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התמונות מתקרבות לאט כדי שלא ייראו סטטיות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोटो धीरे-धीरे ज़ूम होती हैं ताकि स्थिर न लगें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografije se polako približavaju da ne izgledaju statično."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fotók lassan ráközelítenek, hogy ne hassanak statikusnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto perlahan diperbesar agar tidak terlihat diam."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le foto si avvicinano lentamente per non sembrare statiche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真がゆっくりズームし、止まって見えないようにします。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಫೋಟೋಗಳು ಸ್ಥಿರವಾಗಿ ಕಾಣದಂತೆ ನಿಧಾನವಾಗಿ ಜೂಮ್ ಆಗುತ್ತವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진이 천천히 확대되어 정지된 느낌이 덜해요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഫോട്ടോകൾ നിശ്ചലമായി തോന്നാതിരിക്കാൻ പതുക്കെ സൂം ചെയ്യുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फोटो स्थिर वाटू नयेत म्हणून हळूहळू झूम होतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto dizum masuk perlahan-lahan supaya tidak kelihatan statik."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildene zoomer sakte inn så de ikke virker statiske."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto’s zoomen langzaam in, zodat ze niet statisch ogen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଫଟୋ ଧୀରେ ଧୀରେ ଜୁମ୍ ହୁଏ ଯାହାଦ୍ୱାରା ସ୍ଥିର ଲାଗେ ନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਫ਼ੋਟੋਆਂ ਹੌਲੀ-ਹੌਲੀ ਜ਼ੂਮ ਹੁੰਦੀਆਂ ਹਨ ਤਾਂ ਜੋ ਉਹ ਸਥਿਰ ਨਾ ਲੱਗਣ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdjęcia powoli się przybliżają, żeby nie wyglądały statycznie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As fotos se aproximam devagar para não parecerem paradas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As fotografias aproximam-se lentamente para não parecerem estáticas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografiile se apropie lent, ca să nu pară statice."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото медленно приближаются и не выглядят застывшими."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotky sa pomaly približujú, aby nepôsobili staticky."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografije se počasi povečujejo, da ne delujejo statično."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilderna zoomar in långsamt så att de inte ser stillastående ut."
