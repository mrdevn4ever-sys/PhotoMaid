    "vault2_restore_explanation": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُضاف النسخة المُتحقّق منها إلى الخزنة المفتوحة دون استبدال المحتوى. تكرار الاستيراد ينشئ نسخًا إضافية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যাচাই করা ব্যাকআপটি খোলা ভল্টে একটি অতিরিক্ত কপি হিসেবে যোগ হয়। বিদ্যমান বিষয়বস্তু ওভাররাইট হয় না। বারবার ইমপোর্ট করলে অতিরিক্ত কপি তৈরি হয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La còpia verificada s’afegeix com a còpia addicional a la caixa forta oberta. El contingut existent no se sobreescriu. Les importacions repetides creen còpies addicionals."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ověřená záloha se přidá jako další kopie do otevřeného trezoru. Stávající obsah se nepřepíše. Opakované importy vytvářejí další kopie."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den kontrollerede sikkerhedskopi tilføjes som en ekstra kopi i den åbne boks. Eksisterende indhold overskrives ikke. Gentagne importer opretter flere kopier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das geprüfte Backup wird als zusätzliche Kopie in den geöffneten Tresor eingefügt. Vorhandene Inhalte werden nicht überschrieben. Wiederholtes Importieren erzeugt weitere Kopien."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το επαληθευμένο αντίγραφο προστίθεται ως επιπλέον αντίγραφο στο ανοιχτό θησαυροφυλάκιο. Το υπάρχον περιεχόμενο δεν αντικαθίσταται. Οι επαναλαμβανόμενες εισαγωγές δημιουργούν επιπλέον αντίγραφα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The verified backup is added as an extra copy to the open vault. Existing content is not overwritten. Repeated imports create additional copies."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia verificada se añade a la caja fuerte abierta. No se sobrescribe nada. Repetir la importación crea más copias."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarkistettu varmuuskopio lisätään lisäkopiona avoimeen holviin. Nykyistä sisältöä ei korvata. Toistuvat tuonnit luovat lisäkopioita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sauvegarde vérifiée est ajoutée au coffre ouvert. Rien n’est écrasé. Chaque nouvel import crée des copies supplémentaires."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ચકાસેલો બૅકઅપ ખુલ્લા વૉલ્ટમાં વધારાની નકલ તરીકે ઉમેરાય છે. હાલની સામગ્રી ઓવરરાઇટ થતી નથી. વારંવાર ઇમ્પોર્ટ કરવાથી વધારાની નકલો બને છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגיבוי המאומת נוסף כעותק נוסף לכספת הפתוחה. התוכן הקיים לא נדרס. ייבוא חוזר יוצר עותקים נוספים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जाँचा हुआ बैकअप खुली तिजोरी में एक अतिरिक्त कॉपी के रूप में जुड़ता है। मौजूदा सामग्री ओवरराइट नहीं होती। बार-बार इम्पोर्ट करने से अतिरिक्त कॉपी बनती हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Provjerena sigurnosna kopija dodaje se kao dodatna kopija u otvoreni trezor. Postojeći sadržaj ne prebrisuje se. Ponovljeni uvozi stvaraju dodatne kopije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az ellenőrzött mentés további másolatként kerül a megnyitott széfbe. A meglévő tartalom nem íródik felül. Az ismételt importálás további másolatokat hoz létre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cadangan yang sudah diperiksa ditambahkan sebagai salinan tambahan ke brankas yang terbuka. Konten yang ada tidak ditimpa. Impor berulang membuat salinan tambahan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il backup verificato viene aggiunto alla cassaforte aperta. Nulla viene sovrascritto. Importazioni ripetute creano altre copie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検証済みバックアップを開いている保管庫へ追加します。既存の内容は上書きしません。繰り返し読み込むとコピーが増えます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪರಿಶೀಲಿಸಿದ ಬ್ಯಾಕಪ್ ಅನ್ನು ತೆರೆದ ವಾಲ್ಟ್‌ಗೆ ಹೆಚ್ಚುವರಿ ಪ್ರತಿಯಾಗಿ ಸೇರಿಸಲಾಗುತ್ತದೆ. ಅಸ್ತಿತ್ವದಲ್ಲಿರುವ ವಿಷಯ ಮೇಲ್ಬರಹವಾಗುವುದಿಲ್ಲ. ಪುನರಾವರ್ತಿತ ಆಮದುಗಳು ಹೆಚ್ಚುವರಿ ಪ್ರತಿಗಳನ್ನು ರಚಿಸುತ್ತವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검증된 백업을 열린 보관함에 추가합니다. 기존 내용은 덮어쓰지 않습니다. 반복해서 가져오면 사본이 추가됩니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പരിശോധിച്ച ബാക്കപ്പ് തുറന്ന വോൾട്ടിലേക്ക് അധിക പകർപ്പായി ചേർക്കുന്നു. നിലവിലുള്ള ഉള്ളടക്കം മാറ്റിയെഴുതില്ല. ആവർത്തിച്ചുള്ള ഇമ്പോർട്ടുകൾ അധിക പകർപ്പുകൾ സൃഷ്‌ടിക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तपासलेला बॅकअप उघड्या व्हॉल्टमध्ये अतिरिक्त प्रत म्हणून जोडला जातो. सध्याचा मजकूर ओव्हरराइट होत नाही. वारंवार इम्पोर्ट केल्याने अतिरिक्त प्रती तयार होतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sandaran yang disahkan ditambah sebagai salinan tambahan ke peti besi yang terbuka. Kandungan sedia ada tidak ditulis ganti. Import berulang mencipta salinan tambahan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den kontrollerte sikkerhetskopien legges til som en ekstra kopi i den åpne safen. Eksisterende innhold overskrives ikke. Gjentatte importer lager flere kopier."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De gecontroleerde back-up wordt als extra kopie toegevoegd. Bestaande inhoud wordt niet overschreven. Opnieuw importeren maakt extra kopieën."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଯାଞ୍ଚ ହୋଇଥିବା ବ୍ୟାକଅପ୍ ଖୋଲା ଭଲ୍ଟରେ ଏକ ଅତିରିକ୍ତ କପି ଭାବେ ଯୋଗ ହୁଏ। ବିଦ୍ୟମାନ ବିଷୟବସ୍ତୁ ଓଭରରାଇଟ୍ ହୁଏ ନାହିଁ। ବାରମ୍ବାର ଇମ୍ପୋର୍ଟ କଲେ ଅତିରିକ୍ତ କପି ତିଆରି ହୁଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪੁਸ਼ਟੀ ਕੀਤਾ ਬੈਕਅੱਪ ਖੁੱਲ੍ਹੇ ਵੌਲਟ ਵਿੱਚ ਵਾਧੂ ਕਾਪੀ ਵਜੋਂ ਜੋੜਿਆ ਜਾਂਦਾ ਹੈ। ਮੌਜੂਦਾ ਸਮੱਗਰੀ ਓਵਰਰਾਈਟ ਨਹੀਂ ਹੁੰਦੀ। ਵਾਰ-ਵਾਰ ਇੰਪੋਰਟ ਕਰਨ ਨਾਲ ਵਾਧੂ ਕਾਪੀਆਂ ਬਣਦੀਆਂ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdzona kopia zostanie dodana do otwartego sejfu. Nic nie zostanie nadpisane. Ponowny import tworzy kolejne kopie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O backup verificado é adicionado como cópia extra ao cofre aberto. O conteúdo existente não é substituído. Importações repetidas criam cópias adicionais."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A cópia verificada é adicionada ao cofre aberto. Nada é substituído. Importações repetidas criam mais cópias."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia verificată este adăugată în seiful deschis. Nimic nu este suprascris. Importurile repetate creează copii suplimentare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверенная копия добавляется в открытый сейф без перезаписи. Повторный импорт создаёт дополнительные копии."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Overená záloha sa pridá ako ďalšia kópia do otvoreného trezoru. Existujúci obsah sa neprepíše. Opakované importy vytvárajú ďalšie kópie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Preverjena varnostna kopija se doda kot dodatna kopija v odprt sef. Obstoječa vsebina se ne prepiše. Ponovljeni uvozi ustvarijo dodatne kopije."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den kontrollerade säkerhetskopian läggs till som en extra kopia i det öppna valvet. Befintligt innehåll skrivs inte över. Upprepade importer skapar fler kopior."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சரிபார்க்கப்பட்ட காப்புப்பிரதி திறந்த லாக்கரில் கூடுதல் நகலாகச் சேர்க்கப்படும். ஏற்கனவே உள்ள உள்ளடக்கம் மேலெழுதப்படாது. மீண்டும் மீண்டும் இறக்குமதி செய்தால் கூடுதல் நகல்கள் உருவாகும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "తనిఖీ చేసిన బ్యాకప్ తెరిచిన వాల్ట్‌కి అదనపు కాపీగా జోడించబడుతుంది. ఇప్పటికే ఉన్న కంటెంట్ ఓవర్‌రైట్ కాదు. మళ్లీ మళ్లీ ఇంపోర్ట్ చేస్తే అదనపు కాపీలు సృష్టించబడతాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูลสำรองที่ตรวจสอบแล้วจะถูกเพิ่มเป็นสำเนาเพิ่มเติมในตู้เซฟที่เปิดอยู่ เนื้อหาที่มีอยู่จะไม่ถูกเขียนทับ การนำเข้าซ้ำจะสร้างสำเนาเพิ่ม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doğrulanmış yedek açık kasaya ek kopya olarak eklenir. Mevcut içerik üzerine yazılmaz. Tekrar içe aktarmak ek kopyalar oluşturur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевірена копія додається до відкритого сховища без перезапису. Повторний імпорт створює додаткові копії."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تصدیق شدہ بیک اپ کھلے والٹ میں ایک اضافی کاپی کے طور پر شامل ہوتا ہے۔ موجودہ مواد اوور رائٹ نہیں ہوتا۔ بار بار امپورٹ کرنے سے اضافی کاپیاں بنتی ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản sao lưu đã kiểm tra được thêm vào két sắt đang mở như một bản sao bổ sung. Nội dung hiện có không bị ghi đè. Nhập nhiều lần sẽ tạo thêm bản sao."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "验证后的备份将作为额外副本添加到已打开的保险库，不覆盖现有内容。重复导入会产生更多副本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "驗證過的備份會作為額外副本加入已打開的保險箱。現有內容不會被覆蓋。重複匯入會產生更多副本。"
          }
        }
      }
    },
