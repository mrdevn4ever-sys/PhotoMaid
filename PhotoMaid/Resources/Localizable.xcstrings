    "blocks_gestures": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اللوحة: اسحب جانبياً، انقر للتدوير، واسحب للأسفل ببطء أو بسرعة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Spillebræt: swipe til siden, tryk for at rotere, træk eller svirp nedad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spielfeld: seitlich wischen, zum Drehen tippen, nach unten ziehen oder schnell wischen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Board: swipe sideways, tap to rotate, drag or flick down."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tablero: desliza a los lados, toca para girar y arrastra o desliza rápido hacia abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plateau : glisse de côté, touche pour tourner, glisse lentement ou rapidement vers le bas."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Papan: geser ke samping, ketuk untuk memutar, seret atau sentak ke bawah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Campo: scorri di lato, tocca per ruotare, trascina o scorri velocemente in basso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "盤面：左右にスワイプ、タップで回転、下にドラッグまたは素早くスワイプ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보드: 좌우로 밀기, 탭하여 회전, 아래로 끌거나 빠르게 밀기."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Brett: sveip sidelengs, trykk for å rotere, dra eller sveip raskt ned."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Speelveld: veeg opzij, tik om te draaien, sleep of veeg snel omlaag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plansza: przesuń w bok, stuknij, aby obrócić, przeciągnij lub szybko przesuń w dół."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabuleiro: deslize para os lados, toque para girar, arraste ou deslize rapidamente para baixo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabuleiro: desliza para os lados, toca para rodar, arrasta ou desliza rapidamente para baixo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tablă: glisează lateral, atinge pentru rotire, trage sau glisează rapid în jos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поле: свайп вбок, касание для поворота, медленный или резкий свайп вниз."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spelplan: svep åt sidan, tryck för att rotera, dra eller snärta nedåt."
