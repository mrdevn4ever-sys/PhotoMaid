          "stringUnit": {
            "state": "translated",
            "value": "ستبقى آخر نسخة محفوظة فقط. ستُفقد التغييرات غير المحفوظة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur der zuletzt erfolgreich gespeicherte Stand bleibt erhalten. Die ungespeicherten Änderungen gehen verloren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the last successfully saved version will remain. Unsaved changes will be lost."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo quedará la última versión guardada. Se perderán los cambios sin guardar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seule la dernière version enregistrée sera conservée. Les modifications non enregistrées seront perdues."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Resterà solo l’ultima versione salvata. Le modifiche non salvate andranno perse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最後に保存できた状態だけが残ります。未保存の変更は失われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막으로 저장된 버전만 남습니다. 저장하지 않은 변경 사항은 사라집니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen de laatst opgeslagen versie blijft behouden. Niet-opgeslagen wijzigingen gaan verloren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozostanie tylko ostatnia zapisana wersja. Niezapisane zmiany zostaną utracone."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Só fica a última versão guardada. As alterações não guardadas serão perdidas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Va rămâne doar ultima versiune salvată. Modificările nesalvate se vor pierde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Останется только последняя сохранённая версия. Несохранённые изменения будут потеряны."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca son kaydedilen sürüm kalır. Kaydedilmemiş değişiklikler kaybolur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишиться лише остання збережена версія. Незбережені зміни буде втрачено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅保留最后成功保存的版本，未保存的更改将丢失。"
          }
        }
      }
    },
