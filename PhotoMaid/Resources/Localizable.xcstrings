    "tools_size_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُقاس على الضلع الأطول للصورة بالبكسل (px). لا تُكبَّر الصور ولا تُمطّ أبدًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ছবির লম্বা দিকে পিক্সেলে (px) মাপা। ছবি কখনো বড় বা টেনে লম্বা করা হয় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Es mesura pel costat més llarg de la imatge, en píxels (px). Les imatges mai no s’amplien ni s’estiren."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Měří se na delší straně obrázku, v pixelech (px). Obrázky se nikdy nezvětšují ani neroztahují."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Måles på billedets længste side i pixels (px). Billeder forstørres eller strækkes aldrig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemessen an der längeren Bildseite, in Pixeln (px). Bilder werden nie vergrößert oder verzerrt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μετριέται στη μεγαλύτερη πλευρά της εικόνας, σε pixel (px). Οι εικόνες δεν μεγεθύνονται ούτε τεντώνονται ποτέ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measured on the longer side of the image, in pixels (px). Images are never enlarged or stretched."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Medido en el lado más largo de la imagen, en píxeles (px). Las imágenes nunca se amplían ni se deforman."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitataan kuvan pidemmältä sivulta pikseleinä (px). Kuvia ei koskaan suurenneta eikä venytetä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesurée sur le plus grand côté de l’image, en pixels (px). Les images ne sont jamais agrandies ni déformées."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "છબીની લાંબી બાજુ પર, પિક્સેલ (px) માં માપવામાં આવે છે. છબીઓ ક્યારેય મોટી કે ખેંચાતી નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נמדד בצלע הארוכה של התמונה, בפיקסלים (px). תמונות אף פעם לא מוגדלות או נמתחות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इमेज की लंबी भुजा पर, पिक्सेल (px) में नापा जाता है। इमेज कभी बड़ी या खींची नहीं जातीं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mjeri se po duljoj stranici slike, u pikselima (px). Slike se nikad ne povećavaju ni rastežu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kép hosszabbik oldalán mérve, pixelben (px). A képek sosem nagyítódnak fel és nem torzulnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Diukur pada sisi gambar yang lebih panjang, dalam piksel (px). Gambar tidak pernah diperbesar atau diregangkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Misurata sul lato più lungo dell’immagine, in pixel (px). Le immagini non vengono mai ingrandite né deformate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像の長い辺のピクセル数（px）です。画像が拡大されたり引き伸ばされたりすることはありません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಚಿತ್ರದ ಉದ್ದದ ಬದಿಯಲ್ಲಿ ಪಿಕ್ಸೆಲ್‌ಗಳಲ್ಲಿ (px) ಅಳೆಯಲಾಗಿದೆ. ಚಿತ್ರಗಳನ್ನು ಎಂದಿಗೂ ದೊಡ್ಡದಾಗಿಸಲಾಗುವುದಿಲ್ಲ ಅಥವಾ ಹಿಗ್ಗಿಸಲಾಗುವುದಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지의 긴 쪽 기준 픽셀(px)이에요. 이미지를 확대하거나 늘이지 않아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ചിത്രത്തിന്റെ നീളമുള്ള വശത്ത് പിക്സലുകളിൽ (px) അളന്നത്. ചിത്രങ്ങൾ ഒരിക്കലും വലുതാക്കുകയോ വലിച്ചുനീട്ടുകയോ ഇല്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रतिमेच्या लांब बाजूवर, पिक्सेलमध्ये (px) मोजला जातो. प्रतिमा कधीही मोठ्या किंवा ताणल्या जात नाहीत."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Diukur pada sisi imej yang lebih panjang, dalam piksel (px). Imej tidak pernah dibesarkan atau diregangkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Måles på bildets lengste side, i piksler (px). Bilder blir aldri forstørret eller strukket."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemeten aan de langste zijde van de afbeelding, in pixels (px). Afbeeldingen worden nooit vergroot of vervormd."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଛବିର ଲମ୍ବା ପାର୍ଶ୍ୱରେ ପିକ୍ସେଲ୍ (px)ରେ ମପାଯାଇଛି। ଛବି କେବେ ବଡ଼ କିମ୍ବା ଟାଣି ଲମ୍ବା କରାଯାଏ ନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤਸਵੀਰ ਦੇ ਲੰਬੇ ਪਾਸੇ ਉੱਤੇ ਪਿਕਸਲਾਂ (px) ਵਿੱਚ ਮਾਪਿਆ ਗਿਆ। ਤਸਵੀਰਾਂ ਕਦੇ ਵੱਡੀਆਂ ਜਾਂ ਖਿੱਚੀਆਂ ਨਹੀਂ ਜਾਂਦੀਆਂ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mierzone na dłuższym boku obrazu, w pikselach (px). Obrazy nigdy nie są powiększane ani rozciągane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Medido no lado maior da imagem, em pixels (px). As imagens nunca são ampliadas nem esticadas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Medido no lado maior da imagem, em píxeis (px). As imagens nunca são ampliadas nem deformadas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Măsurat pe latura mai lungă a imaginii, în pixeli (px). Imaginile nu sunt niciodată mărite sau deformate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Измеряется по длинной стороне изображения в пикселях (px). Изображения никогда не увеличиваются и не растягиваются."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Meria sa na dlhšej strane obrázka, v pixeloch (px). Obrázky sa nikdy nezväčšujú ani nenaťahujú."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meri se daljša stranica slike, v slikovnih pikah (px). Slike se nikoli ne povečajo ali raztegnejo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mäts på bildens längre sida, i pixlar (px). Bilder förstoras eller sträcks aldrig."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "படத்தின் நீளமான பக்கத்தில் பிக்சல்களில் (px) அளவிடப்பட்டது. படங்கள் ஒருபோதும் பெரிதாக்கப்படவோ இழுக்கப்படவோ மாட்டாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చిత్రం పొడవైన వైపున పిక్సెల్‌లలో (px) కొలుస్తారు. చిత్రాలను ఎప్పుడూ పెద్దవి చేయరు, సాగదీయరు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วัดจากด้านที่ยาวกว่าของรูป เป็นพิกเซล (px) รูปจะไม่ถูกขยายหรือยืด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görüntünün uzun kenarına göre piksel (px) cinsinden ölçülür. Görüntüler asla büyütülmez veya esnetilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вимірюється за довшою стороною зображення в пікселях (px). Зображення ніколи не збільшуються й не розтягуються."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تصویر کے لمبے کنارے پر، پکسلز (px) میں ناپا جاتا ہے۔ تصاویر کبھی بڑی یا کھینچی نہیں جاتیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đo theo cạnh dài hơn của ảnh, tính bằng điểm ảnh (px). Ảnh không bao giờ bị phóng to hay kéo giãn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按图像较长边的像素 (px) 计算。图像绝不会被放大或拉伸。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以圖片較長的一邊計算，單位為像素（px）。圖片永遠不會被放大或拉伸。"
          }
        }
      }
    },
