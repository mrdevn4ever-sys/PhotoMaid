          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bewerking kon niet worden opgeslagen. Het origineel is ongewijzigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zapisać edycji. Oryginał jest bez zmian."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível guardar a edição. O original está inalterado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Editarea nu a putut fi salvată. Originalul este neschimbat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить изменения. Оригинал не изменён."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düzenleme kaydedilemedi. Orijinal değişmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
