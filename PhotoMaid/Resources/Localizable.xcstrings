    "col_custom_pro": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المجموعات المخصصة متاحة مع Pro. المجموعات الجاهزة مجانية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
