    "pro_f5d": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احفظ فلاترك، مثل «فيديوهات أكبر من 500 ميغابايت». ضغطة واحدة تعرض المحتوى المطابق."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Save your own filters, such as “Videos larger than 500 MB”. One tap opens matching content."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichere eigene Filter, zum Beispiel „Videos größer als 500 MB“. Ein Tipp öffnet die passenden Inhalte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
