          "stringUnit": {
            "state": "translated",
            "value": "Salvato come JPEG così funziona ovunque: questo dispositivo non salva i HEIC in modo affidabile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どこでも使えるよう JPEG で保存します。この端末では HEIC を確実に保存できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어디서나 열리도록 JPEG로 저장해요. 이 기기는 HEIC를 안정적으로 저장할 수 없어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Saved as JPEG so it works everywhere – this device can’t reliably save HEIC."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opgeslagen als JPEG zodat het overal werkt – dit apparaat kan HEIC niet betrouwbaar opslaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisano jako JPEG, by działało wszędzie – to urządzenie nie zapisuje niezawodnie plików HEIC."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Saved as JPEG so it works everywhere – this device can’t reliably save HEIC."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardado como JPEG para funcionar em todo o lado – este dispositivo não guarda HEIC de forma fiável."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se salvează ca JPEG ca să meargă peste tot – acest dispozitiv nu poate salva sigur HEIC."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняется в JPEG, чтобы открывалось везде, – это устройство не умеет надёжно сохранять HEIC."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Saved as JPEG so it works everywhere – this device can’t reliably save HEIC."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Saved as JPEG so it works everywhere – this device can’t reliably save HEIC."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her yerde açılsın diye JPEG olarak kaydedilir – bu cihaz HEIC’i güvenilir şekilde kaydedemiyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберігається як JPEG, щоб відкривалося всюди, – цей пристрій не може надійно зберігати HEIC."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Saved as JPEG so it works everywhere – this device can’t reliably save HEIC."
          }
        },
        "zh-Hans": {
          "stringUnit": {
