    "error_undo_conflict": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن التراجع عن ذلك الآن لأنك غيّرته في هذه الأثناء."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি আর পূর্বাবস্থায় ফেরানো যায় না, কারণ এর মধ্যে আপনি এটি বদলেছেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja no es pot desfer perquè ho has canviat mentrestant."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tohle už nejde vrátit, protože jste to mezitím změnili."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette kan ikke længere fortrydes, fordi du har ændret det i mellemtiden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das lässt sich nicht mehr rückgängig machen, weil du es inzwischen geändert hast."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό δεν αναιρείται πλέον, επειδή το άλλαξες στο μεταξύ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This can’t be undone any more because you changed it in the meantime."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya no se puede deshacer porque lo has cambiado mientras tanto."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tätä ei voi enää kumota, koska muutit sitä sillä välin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’annuler, car vous l’avez modifié entre-temps."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ હવે પૂર્વવત્ કરી શકાતું નથી, કારણ કે તમે આ દરમિયાન તેને બદલ્યું."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אי אפשר לבטל את זה יותר, כי שינית את זה בינתיים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे अब पूर्ववत नहीं किया जा सकता क्योंकि आपने इस बीच इसे बदल दिया।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo se više ne može poništiti jer si to u međuvremenu promijenio."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez már nem vonható vissza, mert közben módosítottad."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini tidak bisa diurungkan lagi karena kamu sudah mengubahnya sementara itu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non si può più annullare perché nel frattempo l’hai modificato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その後に変更したため、もう元に戻せません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಮಧ್ಯೆ ನೀವು ಇದನ್ನು ಬದಲಾಯಿಸಿದ್ದರಿಂದ ಇದನ್ನು ಇನ್ನು ರದ್ದುಗೊಳಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그사이 바꿨기 때문에 더 이상 되돌릴 수 없어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇതിനിടെ നിങ്ങൾ ഇത് മാറ്റിയതിനാൽ ഇനി പഴയപടിയാക്കാനാകില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हे आता पूर्ववत करता येणार नाही कारण तुम्ही दरम्यान ते बदलले."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini tidak boleh dibuat asal lagi kerana anda telah mengubahnya sementara itu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette kan ikke angres lenger fordi du har endret det i mellomtiden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit kan niet meer ongedaan worden gemaakt, omdat je het intussen hebt gewijzigd."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହି ମଧ୍ୟରେ ଆପଣ ଏହାକୁ ବଦଳାଇଥିବାରୁ ଏହାକୁ ଆଉ ଫେରାଯାଇପାରିବ ନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਨੂੰ ਹੁਣ ਵਾਪਸ ਨਹੀਂ ਲਿਆ ਜਾ ਸਕਦਾ ਕਿਉਂਕਿ ਤੁਸੀਂ ਇਸ ਦੌਰਾਨ ਇਸ ਨੂੰ ਬਦਲ ਦਿੱਤਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można już tego cofnąć, bo w międzyczasie to zmieniono."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso não pode mais ser desfeito porque você alterou o item enquanto isso."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Já não é possível anular, porque entretanto alterou isto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu mai poate fi anulat, pentru că l-ai modificat între timp."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это уже нельзя отменить – вы успели это изменить."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto sa už nedá vrátiť, pretože ste to medzitým zmenili."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tega ni več mogoče razveljaviti, ker si to medtem spremenil."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det går inte längre att ångra eftersom du har ändrat det under tiden."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இதற்கிடையில் நீங்கள் இதை மாற்றியதால் இனி செயல்தவிர்க்க முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈలోగా మీరు దీన్ని మార్చినందున ఇక రద్దు చేయడం సాధ్యం కాదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลิกทำไม่ได้แล้ว เพราะคุณเปลี่ยนไปแล้วในระหว่างนั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu artık geri alınamaz çünkü bu arada değiştirdin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це вже не можна скасувати – ви встигли це змінити."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اسے اب کالعدم نہیں کیا جا سکتا کیونکہ آپ نے اس دوران اسے بدل دیا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể hoàn tác nữa vì bạn đã thay đổi nó trong lúc đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法再撤销，因为你在此期间已更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由於你在此期間做了更改，已無法還原。"
          }
        }
      }
    },
