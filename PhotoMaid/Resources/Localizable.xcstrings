    "onb_try_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعلى: احتفاظ. يسار: سلة المهملات. يمين: لاحقًا. جرّب هنا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "উপরে: রাখুন। বাঁয়ে: ট্র্যাশ। ডানে: পরে। এখানে চেষ্টা করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Amunt: conservar. Esquerra: paperera. Dreta: més tard. Prova-ho aquí."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahoru: ponechat. Doleva: koš. Doprava: později. Vyzkoušejte si to tady."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Op: behold. Venstre: papirkurv. Højre: senere. Prøv det her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach oben: behalten. Nach links: Papierkorb. Nach rechts: später. Probiere es hier aus."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάνω: διατήρηση. Αριστερά: κάδος. Δεξιά: αργότερα. Δοκίμασέ το εδώ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Up: keep. Left: trash. Right: later. Try it here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arriba: conservar. Izquierda: papelera. Derecha: después. Pruébalo aquí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ylös: säilytä. Vasemmalle: roskakori. Oikealle: myöhemmin. Kokeile tässä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En haut : garder. À gauche : corbeille. À droite : plus tard. Essaie ici."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઉપર: રાખો. ડાબે: ટ્રેશ. જમણે: પછી. અહીં અજમાવો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "למעלה: שמירה. שמאלה: פח. ימינה: מאוחר יותר. אפשר לנסות כאן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऊपर: रखें। बाएँ: ट्रैश। दाएँ: बाद में। यहाँ आज़माएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gore: zadrži. Lijevo: smeće. Desno: kasnije. Isprobaj ovdje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Fel: megtartás. Balra: kuka. Jobbra: később. Próbáld ki itt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Atas: simpan. Kiri: sampah. Kanan: nanti. Coba di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su: conserva. Sinistra: cestino. Destra: più tardi. Prova qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上で残す、左でゴミ箱、右であとで。ここで試してみましょう。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮೇಲೆ: ಇರಿಸಿ. ಎಡ: ಕಸದ ಬುಟ್ಟಿ. ಬಲ: ನಂತರ. ಇಲ್ಲಿ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위: 보관. 왼쪽: 휴지통. 오른쪽: 나중에. 여기서 연습해 보세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മുകളിലേക്ക്: സൂക്ഷിക്കുക. ഇടത്തേക്ക്: ട്രാഷ്. വലത്തേക്ക്: പിന്നീട്. ഇവിടെ പരീക്ഷിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "वर: ठेवा. डावीकडे: ट्रॅश. उजवीकडे: नंतर. इथे करून पहा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Atas: simpan. Kiri: sampah. Kanan: nanti. Cuba di sini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opp: behold. Venstre: papirkurv. Høyre: senere. Prøv her."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omhoog: bewaren. Links: prullenbak. Rechts: later. Probeer het hier."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଉପରକୁ: ରଖନ୍ତୁ। ବାମକୁ: ଟ୍ରାସ। ଡାହାଣକୁ: ପରେ। ଏଠାରେ ଚେଷ୍ଟା କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਉੱਪਰ: ਰੱਖੋ। ਖੱਬੇ: ਰੱਦੀ। ਸੱਜੇ: ਬਾਅਦ ਵਿੱਚ। ਇੱਥੇ ਅਜ਼ਮਾਓ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W górę: zachowaj. W lewo: kosz. W prawo: później. Wypróbuj tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para cima: manter. Esquerda: lixeira. Direita: depois. Experimente aqui."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cima: manter. Esquerda: lixo. Direita: mais tarde. Experimenta aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus: păstrează. Stânga: coș. Dreapta: mai târziu. Încearcă aici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вверх: оставить. Влево: корзина. Вправо: позже. Попробуй здесь."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahor: ponechať. Doľava: kôš. Doprava: neskôr. Vyskúšajte si to tu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gor: obdrži. Levo: koš. Desno: pozneje. Preizkusi tukaj."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Upp: behåll. Vänster: papperskorg. Höger: senare. Prova här."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மேலே: வைத்திரு. இடது: குப்பை. வலது: பிறகு. இங்கே முயன்று பாருங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పైకి: ఉంచండి. ఎడమ: ట్రాష్. కుడి: తర్వాత. ఇక్కడ ప్రయత్నించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขึ้น: เก็บไว้ ซ้าย: ถังขยะ ขวา: ไว้ทีหลัง ลองที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yukarı: sakla. Sola: çöp kutusu. Sağa: sonra. Burada dene."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Угору: залишити. Ліворуч: кошик. Праворуч: пізніше. Спробуй тут."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اوپر: رکھیں۔ بائیں: ردی۔ دائیں: بعد میں۔ یہاں آزمائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lên: giữ. Trái: thùng rác. Phải: để sau. Thử ở đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向上保留，向左放入回收站，向右稍后再看。在这里试试吧。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上：保留。左：垃圾桶。右：稍後。在這裡試試看。"
          }
        }
      }
    },
