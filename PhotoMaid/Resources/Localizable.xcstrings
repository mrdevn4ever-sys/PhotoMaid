    "fc_reset_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لأعلى للاحتفاظ، ولليسار لسلة المهملات، ولليمين لاحقًا، ولأسفل للرجوع – مع الأزرار القياسية."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Op beholder, venstre til papirkurven, højre er senere, ned går tilbage – med standardknapperne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoch behält, links legt in den Papierkorb, rechts ist später, runter geht zurück – mit den Standard-Tasten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Up keeps, left moves to trash, right is later, down goes back – with the default buttons."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arriba conserva, izquierda a la papelera, derecha para después, abajo vuelve atrás, con los botones estándar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Haut garde, gauche va à la corbeille, droite pour plus tard, bas revient en arrière – avec les boutons standard."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ke atas menyimpan, ke kiri ke sampah, ke kanan nanti, ke bawah kembali – dengan tombol default."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su conserva, sinistra nel cestino, destra più tardi, giù torna indietro, con i pulsanti standard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上で残す、左でゴミ箱、右であとで、下で戻る – 標準のボタン付き。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위는 보관, 왼쪽은 휴지통, 오른쪽은 나중에, 아래는 뒤로 – 기본 버튼과 함께."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opp beholder, venstre til papirkurven, høyre er senere, ned går tilbake – med standardknappene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omhoog bewaart, links naar de prullenbak, rechts voor later, omlaag terug – met de standaardknoppen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W górę zachowuje, w lewo do kosza, w prawo na później, w dół wraca – ze standardowymi przyciskami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para cima mantém, para a esquerda vai para a lixeira, para a direita é depois, para baixo volta – com os botões padrão."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para cima mantém, esquerda para o lixo, direita para mais tarde, para baixo volta – com os botões padrão."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus păstrează, stânga în coș, dreapta mai târziu, jos înapoi – cu butoanele standard."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вверх — оставить, влево — в корзину, вправо — на потом, вниз — назад, со стандартными кнопками."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Upp behåller, vänster till papperskorgen, höger är senare, ned går tillbaka – med standardknapparna."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปัดขึ้นเก็บไว้ ซ้ายไปถังขยะ ขวาไว้ทีหลัง ลงย้อนกลับ – ด้วยปุ่มเริ่มต้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yukarı saklar, sol çöp kutusu, sağ sonra, aşağı geri – standart düğmelerle."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вгору — залишити, ліворуч — у кошик, праворуч — на потім, вниз — назад, зі стандартними кнопками."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lên để giữ, trái vào thùng rác, phải để sau, xuống để quay lại – với các nút mặc định."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向上保留，向左放入回收站，向右稍后，向下返回，并使用标准按钮。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用預設按鈕時：上滑保留，左滑移到垃圾桶，右滑稍後，下滑返回。"
          }
        }
      }
    },
