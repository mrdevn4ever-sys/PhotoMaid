    "tools_location_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبدو النسخ مثل الأصل تمامًا – يُزال فقط مكان التقاط الصورة. تُتخطّى الصور التي لا تحتوي على موقع."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopierne ser præcis ud som originalen – kun stedet, hvor fotoet blev taget, fjernes. Fotos uden lokalitet springes over."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kopien sehen genauso aus wie das Original – nur der Aufnahmeort wird entfernt. Fotos ohne Ort werden übersprungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The copies look exactly like the original – only the place where the photo was taken is removed. Photos without a location are skipped."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las copias son idénticas al original: solo se quita el lugar donde se hizo la foto. Las fotos sin ubicación se omiten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les copies sont identiques à l’original – seul le lieu de prise de vue est retiré. Les photos sans lieu sont ignorées."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Salinannya terlihat persis seperti aslinya – hanya tempat foto diambil yang dihapus. Foto tanpa lokasi dilewati."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le copie sono identiche all’originale: viene tolto solo il luogo dello scatto. Le foto senza posizione vengono saltate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピーは元の写真とまったく同じ見た目で、撮影場所だけが削除されます。場所のない写真はスキップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복사본은 원본과 똑같아 보여요. 촬영 장소만 지워져요. 장소 정보가 없는 사진은 건너뛰어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiene ser nøyaktig ut som originalen – bare stedet der bildet ble tatt, fjernes. Bilder uten sted hoppes over."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De kopieën zien er precies zo uit als het origineel – alleen de opnameplek wordt verwijderd. Foto’s zonder locatie worden overgeslagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopie wyglądają dokładnie jak oryginał – usuwane jest tylko miejsce zrobienia zdjęcia. Zdjęcia bez lokalizacji są pomijane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As cópias ficam idênticas ao original – só o lugar onde a foto foi tirada é removido. Fotos sem localização são puladas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As cópias ficam iguais ao original – só é removido o local onde a foto foi tirada. As fotos sem localização são ignoradas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiile arată exact ca originalul – se elimină doar locul în care a fost făcută fotografia. Fotografiile fără locație sunt omise."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копии выглядят точно как оригинал – удаляется только место съёмки. Фото без места пропускаются."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiorna ser exakt ut som originalet – bara platsen där bilden togs tas bort. Bilder utan plats hoppas över."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สำเนาดูเหมือนต้นฉบับทุกประการ – ลบเฉพาะสถานที่ถ่ายรูป รูปที่ไม่มีตำแหน่งจะถูกข้าม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopyalar orijinalle tamamen aynı görünür – yalnızca çekim yeri kaldırılır. Konumu olmayan fotoğraflar atlanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Копії виглядають точно як оригінал – видаляється лише місце зйомки. Фото без місця пропускаються."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản sao trông giống hệt bản gốc – chỉ nơi chụp ảnh bị xóa. Ảnh không có vị trí sẽ bị bỏ qua."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "副本与原照片看起来完全相同，只会去掉拍摄地点。没有位置信息的照片会被跳过。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
