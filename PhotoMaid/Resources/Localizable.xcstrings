    "archive_step_only_verified": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تُحتسب إلا النسخ التي تم التحقق منها. إذا اختلفت نسخة، تُزال فورًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur geprüfte Kopien zählen. Weicht eine ab, wird sie gleich wieder entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only checked copies count. If one differs, it is removed right away."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo cuentan las copias comprobadas. Si una no coincide, se elimina enseguida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les copies vérifiées comptent. Si l’une diffère, elle est aussitôt supprimée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Contano solo le copie controllate. Se una è diversa, viene subito rimossa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認済みのコピーだけが有効です。違いがあったコピーはすぐに削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인된 사본만 인정돼요. 다른 사본은 바로 지워요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen gecontroleerde kopieën tellen. Wijkt er een af, dan wordt die meteen weer verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Liczą się tylko sprawdzone kopie. Jeśli któraś się różni, zostaje od razu usunięta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Só contam as cópias verificadas. Se uma for diferente, é logo removida."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Contează doar copiile verificate. Dacă una diferă, este eliminată imediat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Учитываются только проверенные копии. Если копия отличается, она сразу удаляется."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca kontrol edilmiş kopyalar sayılır. Farklı çıkan kopya hemen kaldırılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зараховуються лише перевірені копії. Якщо копія відрізняється, її одразу видаляють."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有检查过的副本才算数。如有不一致，会立即删除该副本。"
          }
        }
      }
    },
    "archive_step_originals": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى ملفاتك الأصلية كما هي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Originale bleiben, wie sie sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your originals stay as they are."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus originales se quedan como están."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos originaux restent tels quels."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi originali restano come sono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元のファイルはそのまま残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본은 그대로 남아요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je originelen blijven zoals ze zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje oryginały pozostają bez zmian."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os seus originais ficam como estão."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Originalele tale rămân neschimbate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши оригиналы остаются без изменений."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Orijinallerin olduğu gibi kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші оригінали залишаються без змін."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的原件保持不变。"
          }
        }
      }
    },
    "archive_step_verify": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد ذلك تُقرأ كل نسخة من جديد وتُقارن بالأصل بايتًا ببايت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Kopie wird danach neu gelesen und Byte für Byte mit dem Original verglichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each copy is then read again and compared byte by byte with the original."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después, cada copia se vuelve a leer y se compara byte a byte con el original."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque copie est ensuite relue et comparée octet par octet à l’original."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Poi ogni copia viene riletta e confrontata byte per byte con l’originale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その後、各コピーを読み直し、元のファイルと1バイトずつ比べます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그다음 각 사본을 다시 읽어 원본과 바이트 단위로 비교해요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Daarna wordt elke kopie opnieuw gelezen en byte voor byte met het origineel vergeleken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potem każda kopia jest odczytywana ponownie i porównywana bajt po bajcie z oryginałem."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois, cada cópia é lida de novo e comparada byte a byte com o original."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apoi fiecare copie este citită din nou și comparată octet cu octet cu originalul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Затем каждая копия читается заново и побайтно сравнивается с оригиналом."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ardından her kopya yeniden okunur ve orijinalle bayt bayt karşılaştırılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Потім кожну копію читають знову й побайтово порівнюють з оригіналом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随后会重新读取每份副本，并与原件逐字节比对。"
          }
        }
      }
    },
    "archive_studio_sub": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النسخ إلى مجلد مختار والتحقق من كل نسخة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In einen gewählten Ordner kopieren und jede Kopie prüfen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy to a chosen folder and verify every copy"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiar a una carpeta elegida y verificar cada copia"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copier dans un dossier choisi et vérifier chaque copie"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia in una cartella scelta e verifica ogni copia"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したフォルダにコピーし、各コピーを検証"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 폴더에 복사하고 각 사본 확인"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naar een gekozen map kopiëren en elke kopie controleren"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skopiuj do wybranego folderu i sprawdź każdą kopię"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiar para uma pasta escolhida e verificar cada cópia"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiază într-un dosar ales și verifică fiecare copie"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скопировать в выбранную папку и проверить каждую копию"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen klasöre kopyala ve her kopyayı doğrula"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
