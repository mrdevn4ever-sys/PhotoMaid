    "history_empty": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر اختياراتك هنا عندما تبدأ التنظيف."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পরিষ্কার শুরু করলেই আপনার সিদ্ধান্তগুলো এখানে দেখা যাবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les teves decisions apareixeran aquí quan comencis a endreçar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše rozhodnutí se tu zobrazí, jakmile začnete uklízet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine valg vises her, når du begynder at rydde op."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier siehst du deine Entscheidungen, sobald du mit dem Aufräumen beginnst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι επιλογές σου εμφανίζονται εδώ μόλις ξεκινήσεις το τακτοποίημα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your choices appear here once you start cleaning up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus decisiones aparecen aquí cuando empiezas a limpiar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valintasi näkyvät täällä, kun alat siivota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes choix apparaissent ici dès que tu commences le tri."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે સાફસફાઈ શરૂ કરો કે તરત તમારી પસંદગીઓ અહીં દેખાશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההחלטות שלך יופיעו כאן ברגע שמתחילים לסדר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सफ़ाई शुरू करते ही आपके चुनाव यहाँ दिखेंगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje se odluke prikazuju ovdje čim počneš raščišćavati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A döntéseid itt jelennek meg, amint elkezdesz rendet rakni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilihanmu muncul di sini setelah kamu mulai merapikan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue scelte appaiono qui quando inizi a riordinare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "整理を始めると、選んだ操作がここに表示されます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಸ್ವಚ್ಛಗೊಳಿಸಲು ಪ್ರಾರಂಭಿಸಿದ ತಕ್ಷಣ ನಿಮ್ಮ ಆಯ್ಕೆಗಳು ಇಲ್ಲಿ ಕಾಣಿಸುತ್ತವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정리를 시작하면 선택한 내용이 여기에 표시돼요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വൃത്തിയാക്കാൻ തുടങ്ങിയാലുടൻ നിങ്ങളുടെ തിരഞ്ഞെടുപ്പുകൾ ഇവിടെ കാണാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही साफसफाई सुरू करताच तुमच्या निवडी इथे दिसतील."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilihan anda dipaparkan di sini sebaik sahaja anda mula mengemas."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgene dine vises her når du begynner å rydde."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je keuzes verschijnen hier zodra je begint met opruimen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସଫା କରିବା ଆରମ୍ଭ କରିବା ମାତ୍ରେ ଆପଣଙ୍କ ଚୟନ ଏଠାରେ ଦେଖାଯିବ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਫ਼ਾਈ ਸ਼ੁਰੂ ਕਰਦੇ ਹੀ ਤੁਹਾਡੀਆਂ ਚੋਣਾਂ ਇੱਥੇ ਦਿਸਦੀਆਂ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje wybory pojawią się tutaj, gdy zaczniesz porządki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas escolhas aparecem aqui quando você começar a limpar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As tuas escolhas aparecem aqui quando começares a limpar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alegerile tale apar aici după ce începi curățenia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твои решения появятся здесь, как только начнёшь уборку."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše rozhodnutia sa tu zobrazia, keď začnete upratovať."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje odločitve se prikažejo tukaj, ko začneš čistiti."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina val visas här när du börjar rensa."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சுத்தம் செய்யத் தொடங்கியதும் உங்கள் தேர்வுகள் இங்கே தோன்றும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "శుభ్రం చేయడం ప్రారంభించిన వెంటనే మీ ఎంపికలు ఇక్కడ కనిపిస్తాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเลือกของคุณจะปรากฏที่นี่เมื่อคุณเริ่มจัดระเบียบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temizliğe başladığında seçimlerin burada görünür."
          }
        },
        "uk": {
