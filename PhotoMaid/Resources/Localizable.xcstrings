    "edit_preset_save_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحفظ الإعدادات فقط (المنزلقات والفلتر والألوان) – وليس الصورة نفسها أبدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichert nur die Einstellungen (Regler, Filter, Farben) – nie das Foto selbst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves only the settings (sliders, filter, colours) – never the photo itself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda solo los ajustes (controles, filtro, colores), nunca la foto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre uniquement les réglages (curseurs, filtre, couleurs), jamais la photo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva solo le impostazioni (cursori, filtro, colori), mai la foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定（スライダー、フィルタ、色）だけを保存し、写真自体は保存しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정(슬라이더, 필터, 색상)만 저장하고 사진은 저장하지 않아요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Slaat alleen de instellingen op (schuifjes, filter, kleuren) – nooit de foto zelf."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisuje tylko ustawienia (suwaki, filtr, kolory) – nigdy samego zdjęcia."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda apenas as definições (controlos, filtro, cores) – nunca a própria foto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvează doar setările (glisoare, filtru, culori) – niciodată fotografia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняются только настройки (ползунки, фильтр, цвета) — не само фото."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca ayarları (kaydırıcılar, filtre, renkler) kaydeder, fotoğrafı asla kaydetmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберігаються лише налаштування (повзунки, фільтр, кольори) — не саме фото."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅保存设置（滑块、滤镜、颜色），不会保存照片本身。"
          }
        }
      }
    },
