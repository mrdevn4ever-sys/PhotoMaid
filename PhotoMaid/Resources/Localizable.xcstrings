        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的回收站"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的垃圾桶"
          }
        }
      }
    },
    "tour_feed_undo_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سحبت بالاتجاه الخطأ؟ اضغط هنا للتراجع عن آخر اختيار."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভুল দিকে সোয়াইপ হয়েছে? আপনার শেষ সিদ্ধান্ত ফেরাতে এখানে ট্যাপ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Has lliscat cap al costat equivocat? Toca aquí per desfer l’última decisió."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přejeli jste špatným směrem? Klepnutím sem vrátíte poslední rozhodnutí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipede du forkert? Tryk her for at fortryde dit seneste valg."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Falsch gewischt? Tippe hier, um deine letzte Entscheidung rückgängig zu machen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έσυρες προς τη λάθος πλευρά; Πάτησε εδώ για να αναιρέσεις την τελευταία επιλογή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swiped the wrong way? Tap here to undo your last choice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Has deslizado hacia el lado equivocado? Toca aquí para deshacer tu última decisión."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pyyhkäisitkö väärään suuntaan? Napauta tästä kumotaksesi viimeisimmän valinnan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un mauvais geste ? Touche ici pour annuler ton dernier choix."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ખોટી દિશામાં સ્વાઇપ થયું? તમારી છેલ્લી પસંદગી પૂર્વવત્ કરવા અહીં ટૅપ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החלקת לכיוון הלא נכון? הקשה כאן מבטלת את ההחלטה האחרונה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गलत दिशा में स्वाइप हो गया? अपना पिछला चुनाव पूर्ववत करने के लिए यहाँ टैप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Povukao si u krivi smjer? Dodirni ovdje da poništiš posljednju odluku."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Rossz irányba húztad? Koppints ide az utolsó döntésed visszavonásához."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Salah geser? Ketuk di sini untuk mengurungkan pilihan terakhirmu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai sbagliato gesto? Tocca qui per annullare l’ultima scelta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "違う方向にスワイプしましたか？ここをタップすると、最後の選択を取り消せます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ತಪ್ಪು ದಿಕ್ಕಿಗೆ ಸ್ವೈಪ್ ಆಯಿತೇ? ನಿಮ್ಮ ಕೊನೆಯ ಆಯ್ಕೆ ರದ್ದುಗೊಳಿಸಲು ಇಲ್ಲಿ ಟ್ಯಾಪ್ ಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잘못 밀었나요? 여기를 누르면 마지막 선택을 취소할 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "തെറ്റായ ദിശയിൽ സ്വൈപ്പ് ചെയ്തോ? നിങ്ങളുടെ അവസാന തിരഞ്ഞെടുപ്പ് പഴയപടിയാക്കാൻ ഇവിടെ ടാപ്പ് ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "चुकीच्या दिशेने स्वाइप झाले? तुमची मागील निवड पूर्ववत करण्यासाठी इथे टॅप करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tersalah arah leret? Ketik di sini untuk membuat asal pilihan terakhir anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sveipet du feil vei? Trykk her for å angre det siste valget ditt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verkeerd geveegd? Tik hier om je laatste keuze ongedaan te maken."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଭୁଲ ଦିଗରେ ସ୍ୱାଇପ୍ ହୋଇଗଲା? ଆପଣଙ୍କ ଶେଷ ଚୟନ ଫେରାଇବାକୁ ଏଠାରେ ଟାପ୍ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਗ਼ਲਤ ਪਾਸੇ ਸਵਾਈਪ ਹੋ ਗਿਆ? ਆਪਣੀ ਆਖ਼ਰੀ ਚੋਣ ਵਾਪਸ ਲੈਣ ਲਈ ਇੱਥੇ ਟੈਪ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesunięcie w złą stronę? Dotknij tutaj, aby cofnąć ostatni wybór."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslizou para o lado errado? Toque aqui para desfazer sua última escolha."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslizaste para o lado errado? Toca aqui para anular a última escolha."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai glisat în direcția greșită? Atinge aici ca să anulezi ultima alegere."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не тот жест? Нажми здесь, чтобы отменить последнее решение."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Potiahli ste zlým smerom? Klepnutím sem vrátite posledné rozhodnutie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podrsal v napačno smer? Tapni tukaj, da razveljaviš zadnjo odločitev."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Svepte du fel? Tryck här för att ångra ditt senaste val."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தவறான திசையில் ஸ்வைப் செய்தீர்களா? உங்கள் கடைசித் தேர்வைச் செயல்தவிர்க்க இங்கே தட்டுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "తప్పు దిశలో స్వైప్ చేశారా? మీ చివరి ఎంపికను రద్దు చేయడానికి ఇక్కడ ట్యాప్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปัดผิดทาง? แตะที่นี่เพื่อเลิกทำการเลือกล่าสุด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yanlış yöne mi kaydırdın? Son seçimini geri almak için buraya dokun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не той жест? Натисни тут, щоб скасувати останнє рішення."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "غلط سمت میں سوائپ ہو گیا؟ اپنا پچھلا انتخاب کالعدم کرنے کے لیے یہاں ٹیپ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuốt nhầm hướng? Chạm vào đây để hoàn tác lựa chọn cuối."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "滑错方向了？点这里撤销上一次选择。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "滑錯方向了嗎？點這裡即可還原上一個選擇。"
          }
        }
      }
    },
