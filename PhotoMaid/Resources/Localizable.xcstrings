    "onb_try_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعلى: احتفاظ. يسار: سلة المهملات. يمين: لاحقًا. جرّب هنا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Op: behold. Venstre: papirkurv. Højre: senere. Prøv det her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach oben: behalten. Nach links: Papierkorb. Nach rechts: später. Probiere es hier aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Up: keep. Left: trash. Right: later. Try it here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arriba: conservar. Izquierda: papelera. Derecha: después. Pruébalo aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En haut : garder. À gauche : corbeille. À droite : plus tard. Essaie ici."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Atas: simpan. Kiri: sampah. Kanan: nanti. Coba di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su: conserva. Sinistra: cestino. Destra: più tardi. Prova qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上で残す、左でゴミ箱、右であとで。ここで試してみましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위: 보관. 왼쪽: 휴지통. 오른쪽: 나중에. 여기서 연습해 보세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opp: behold. Venstre: papirkurv. Høyre: senere. Prøv her."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omhoog: bewaren. Links: prullenbak. Rechts: later. Probeer het hier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W górę: zachowaj. W lewo: kosz. W prawo: później. Wypróbuj tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para cima: manter. Esquerda: lixeira. Direita: depois. Experimente aqui."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cima: manter. Esquerda: lixo. Direita: mais tarde. Experimenta aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus: păstrează. Stânga: coș. Dreapta: mai târziu. Încearcă aici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вверх: оставить. Влево: корзина. Вправо: позже. Попробуй здесь."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Upp: behåll. Vänster: papperskorg. Höger: senare. Prova här."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขึ้น: เก็บไว้ ซ้าย: ถังขยะ ขวา: ไว้ทีหลัง ลองที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yukarı: sakla. Sola: çöp kutusu. Sağa: sonra. Burada dene."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Угору: залишити. Ліворуч: кошик. Праворуч: пізніше. Спробуй тут."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lên: giữ. Trái: thùng rác. Phải: để sau. Thử ở đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向上保留，向左放入回收站，向右稍后再看。在这里试试吧。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上：保留。左：垃圾桶。右：稍後。在這裡試試看。"
          }
        }
      }
    },
