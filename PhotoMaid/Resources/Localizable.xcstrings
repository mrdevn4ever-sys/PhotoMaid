    "blocks_photo_privacy": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُنزّل صور iCloud عند الحاجة. تبقى صور الخزنة والصور المخفية والمستبعدة محمية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ফটো প্রয়োজনে ডাউনলোড হয়। ভল্টের, লুকানো ও বাদ দেওয়া ফটো সুরক্ষিত থাকে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fotos d’iCloud es baixen quan cal. Les fotos de la caixa forta, les amagades i les excloses es mantenen protegides."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotky z iCloudu se stahují podle potřeby. Fotky v trezoru, skryté a vyloučené fotky zůstávají chráněné."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud-fotos hentes efter behov. Fotos i boksen samt skjulte og udelukkede fotos forbliver beskyttede."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud-Fotos laden bei Bedarf. Tresor und ausgeblendete oder ausgeschlossene Fotos bleiben geschützt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι φωτογραφίες iCloud λαμβάνονται όταν χρειάζεται. Οι φωτογραφίες του θησαυροφυλακίου, οι κρυφές και οι εξαιρεμένες μένουν προστατευμένες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud photos download when needed. Vault, hidden and excluded photos stay protected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos de iCloud se descargan cuando hace falta. Las fotos de la caja fuerte, ocultas y excluidas siguen protegidas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud-kuvat ladataan tarvittaessa. Holvin kuvat sekä piilotetut ja poissuljetut kuvat pysyvät suojattuina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos iCloud sont téléchargées au besoin. Les photos du coffre-fort, masquées et exclues restent protégées."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ફોટા જરૂર પડે ત્યારે ડાઉનલોડ થાય છે. વૉલ્ટના, છુપાયેલા અને બાકાત ફોટા સુરક્ષિત રહે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תמונות iCloud יורדות לפי הצורך. תמונות מהכספת, תמונות מוסתרות ותמונות שהוחרגו נשארות מוגנות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud फ़ोटो ज़रूरत पड़ने पर डाउनलोड होती हैं। तिजोरी की, छिपी और बाहर रखी फ़ोटो सुरक्षित रहती हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud fotografije preuzimaju se po potrebi. Fotografije iz trezora, skrivene i izuzete fotografije ostaju zaštićene."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az iCloud-fotók szükség esetén letöltődnek. A széfben lévő, a rejtett és a kizárt fotók védve maradnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto iCloud diunduh saat diperlukan. Foto di brankas, tersembunyi, dan dikecualikan tetap terlindungi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le foto iCloud vengono scaricate quando servono. Foto della cassaforte, nascoste ed escluse restano protette."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "必要に応じてiCloud写真を読み込みます。金庫・非表示・除外された写真は保護されます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ಫೋಟೋಗಳು ಅಗತ್ಯವಿದ್ದಾಗ ಡೌನ್‌ಲೋಡ್ ಆಗುತ್ತವೆ. ವಾಲ್ಟ್‌ನಲ್ಲಿರುವ, ಮರೆಮಾಡಿದ ಮತ್ತು ಹೊರಗಿಟ್ಟ ಫೋಟೋಗಳು ರಕ್ಷಿತವಾಗಿರುತ್ತವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "필요할 때 iCloud 사진을 다운로드합니다. 금고, 숨김 및 제외된 사진은 보호됩니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ഫോട്ടോകൾ ആവശ്യമുള്ളപ്പോൾ ഡൗൺലോഡ് ചെയ്യും. വോൾട്ടിലുള്ളതും മറച്ചതും ഒഴിവാക്കിയതുമായ ഫോട്ടോകൾ സുരക്ഷിതമായി തുടരും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud फोटो गरज असेल तेव्हा डाउनलोड होतात. व्हॉल्टमधील, लपवलेले आणि वगळलेले फोटो सुरक्षित राहतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto iCloud dimuat turun apabila perlu. Foto dalam peti besi, foto tersembunyi dan foto yang dikecualikan kekal dilindungi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud-bilder lastes ned ved behov. Bilder i safen samt skjulte og utelatte bilder forblir beskyttet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud-foto’s worden zo nodig gedownload. Kluisfoto’s en verborgen of uitgesloten foto’s blijven beschermd."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ଫଟୋ ଆବଶ୍ୟକ ହେଲେ ଡାଉନଲୋଡ୍ ହୁଏ। ଭଲ୍ଟରେ ଥିବା, ଲୁଚାଯାଇଥିବା ଓ ବାଦ ଦିଆଯାଇଥିବା ଫଟୋ ସୁରକ୍ଷିତ ରହେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ਫ਼ੋਟੋਆਂ ਲੋੜ ਪੈਣ ’ਤੇ ਡਾਊਨਲੋਡ ਹੁੰਦੀਆਂ ਹਨ। ਵੌਲਟ ਦੀਆਂ, ਲੁਕਾਈਆਂ ਅਤੇ ਬਾਹਰ ਰੱਖੀਆਂ ਫ਼ੋਟੋਆਂ ਸੁਰੱਖਿਅਤ ਰਹਿੰਦੀਆਂ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdjęcia iCloud są pobierane w razie potrzeby. Zdjęcia z sejfu, ukryte i wykluczone pozostają chronione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos do iCloud são baixadas quando necessário. Cofre, fotos ocultas e excluídas continuam protegidas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As fotografias do iCloud são transferidas quando necessário. Cofre, fotografias ocultas e excluídas continuam protegidos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografiile iCloud se descarcă la nevoie. Fotografiile din seif, ascunse și excluse rămân protejate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото iCloud загружаются при необходимости. Сейф, скрытые и исключённые фото остаются защищены."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotky z iCloudu sa sťahujú podľa potreby. Fotky v trezore, skryté a vylúčené fotky zostávajú chránené."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografije iCloud se prenesejo po potrebi. Fotografije v sefu ter skrite in izključene fotografije ostanejo zaščitene."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud-bilder hämtas vid behov. Bilder i valvet samt dolda och undantagna bilder förblir skyddade."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud புகைப்படங்கள் தேவைப்படும்போது பதிவிறக்கப்படும். லாக்கரில் உள்ள, மறைக்கப்பட்ட, விலக்கப்பட்ட புகைப்படங்கள் பாதுகாப்பாக இருக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ఫోటోలు అవసరమైనప్పుడు డౌన్‌లోడ్ అవుతాయి. వాల్ట్‌లోని, దాచిన, మినహాయించిన ఫోటోలు సురక్షితంగా ఉంటాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปภาพ iCloud จะดาวน์โหลดเมื่อจำเป็น รูปในตู้เซฟ รูปที่ซ่อน และรูปที่ยกเว้นยังได้รับการปกป้อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud fotoğrafları gerektiğinde indirilir. Kasa, gizli ve hariç tutulan fotoğraflar korunur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото iCloud завантажуються за потреби. Сховище, приховані та виключені фото залишаються захищеними."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud تصاویر ضرورت پر ڈاؤن لوڈ ہوتی ہیں۔ والٹ کی، چھپی ہوئی اور خارج کی گئی تصاویر محفوظ رہتی ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh iCloud được tải khi cần. Ảnh trong két sắt, ảnh ẩn và ảnh bị loại trừ vẫn được bảo vệ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要时自动下载 iCloud 照片。保险库、隐藏及排除的照片始终受到保护。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 照片會在需要時下載。保險箱、隱藏和排除的照片仍受保護。"
          }
        }
      }
    },
