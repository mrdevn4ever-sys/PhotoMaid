    "systrash_intro": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل ما يحتفظ به Android في سلة المهملات – من GaleriQ وتطبيقات أخرى. عند انتهاء المدة يحذفه Android بنفسه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Everything Android keeps in its trash – from GaleriQ and other apps. Android deletes items itself when the time runs out."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Everything Android keeps in its trash – from GaleriQ and other apps. Android deletes items itself when the time runs out."
