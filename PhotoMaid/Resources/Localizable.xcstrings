        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എഡിറ്റ് ചെയ്ത ഫോട്ടോ. ഒറിജിനൽ കാണാൻ സ്പർശിച്ച് പിടിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "संपादित फोटो. मूळ पाहण्यासाठी दाबून ठेवा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto disunting. Sentuh dan tahan untuk melihat yang asal."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Redigert bilde. Hold inne for å se originalen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewerkte foto. Houd vast om het origineel te zien."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏଡିଟ୍ ହୋଇଥିବା ଫଟୋ। ମୂଳ ଦେଖିବାକୁ ଛୁଇଁ ଧରି ରଖନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸੋਧੀ ਫ਼ੋਟੋ। ਮੂਲ ਦੇਖਣ ਲਈ ਦਬਾ ਕੇ ਰੱਖੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Edytowane zdjęcie. Przytrzymaj, aby zobaczyć oryginał."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto editada. Toque e segure para ver o original."
