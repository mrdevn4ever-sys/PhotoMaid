    "edit_hint_hdr": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لهذه الصورة إضاءة شديدة السطوع (HDR). بعد تغيير الألوان يقلّ سطوعها قليلًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Foto hat besonders helle Lichter (HDR). Nach Farbänderungen leuchtet es etwas weniger stark."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This photo has extra-bright highlights (HDR). After colour changes it shines a little less."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta foto tiene luces muy brillantes (HDR). Tras cambiar los colores brillará un poco menos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette photo a des hautes lumières très vives (HDR). Après des changements de couleur, elle brille un peu moins."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa foto ha luci molto brillanti (HDR). Dopo le modifiche al colore brillerà un po’ meno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この写真は特に明るい部分（HDR）があります。色を変更すると輝きが少し弱くなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사진은 아주 밝은 부분(HDR)이 있어요. 색을 바꾸면 조금 덜 빛나요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze foto heeft extra heldere lichten (HDR). Na kleurwijzigingen straalt hij iets minder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To zdjęcie ma szczególnie jasne światła (HDR). Po zmianie kolorów będzie świecić nieco słabiej."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta foto tem luzes muito intensas (HDR). Depois de alterar as cores, brilha um pouco menos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această fotografie are lumini foarte strălucitoare (HDR). După modificarea culorilor strălucește puțin mai slab."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом фото особенно яркие света (HDR). После изменения цвета оно будет сиять чуть слабее."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu fotoğrafın ışıkları çok parlak (HDR). Renk değişikliklerinden sonra biraz daha az parlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На цьому фото особливо яскраві світла (HDR). Після зміни кольорів воно сяятиме трохи слабше."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这张照片的高光特别明亮（HDR）。调整颜色后会稍微暗一些。"
          }
        }
      }
    },
    "edit_hint_heic": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحفظ بصيغة JPEG ليعمل في كل مكان – لا يستطيع هذا الجهاز حفظ HEIC بشكل موثوق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird als JPEG gespeichert, damit es überall funktioniert – HEIC kann dieses Gerät nicht zuverlässig speichern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved as JPEG so it works everywhere – this device can’t reliably save HEIC."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guarda como JPEG para que funcione en todas partes: este dispositivo no puede guardar HEIC de forma fiable."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistré en JPEG pour fonctionner partout – cet appareil ne sait pas enregistrer le HEIC de façon fiable."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvato come JPEG così funziona ovunque: questo dispositivo non salva i HEIC in modo affidabile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どこでも使えるよう JPEG で保存します。この端末では HEIC を確実に保存できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어디서나 열리도록 JPEG로 저장해요. 이 기기는 HEIC를 안정적으로 저장할 수 없어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opgeslagen als JPEG zodat het overal werkt – dit apparaat kan HEIC niet betrouwbaar opslaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisano jako JPEG, by działało wszędzie – to urządzenie nie zapisuje niezawodnie plików HEIC."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardado como JPEG para funcionar em todo o lado – este dispositivo não guarda HEIC de forma fiável."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se salvează ca JPEG ca să meargă peste tot – acest dispozitiv nu poate salva sigur HEIC."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняется в JPEG, чтобы открывалось везде, – это устройство не умеет надёжно сохранять HEIC."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her yerde açılsın diye JPEG olarak kaydedilir – bu cihaz HEIC’i güvenilir şekilde kaydedemiyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберігається як JPEG, щоб відкривалося всюди, – цей пристрій не може надійно зберігати HEIC."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存为 JPEG，以便在任何地方都能打开——此设备无法可靠保存 HEIC。"
          }
        }
      }
    },
    "edit_hint_lossless": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بلا فقد: يتغير الاتجاه فقط وتبقى جودة الصورة كما هي تمامًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlustfrei: Nur die Ausrichtung ändert sich, die Bildqualität bleibt exakt gleich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lossless: only the orientation changes, image quality stays exactly the same."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin pérdida: solo cambia la orientación; la calidad se mantiene exactamente igual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans perte : seule l’orientation change, la qualité reste exactement la même."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza perdita: cambia solo l’orientamento, la qualità resta identica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "劣化なし：向きだけが変わり、画質はまったく同じです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무손실: 방향만 바뀌고 화질은 그대로예요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verliesvrij: alleen de stand verandert, de beeldkwaliteit blijft precies gelijk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezstratnie: zmienia się tylko orientacja, jakość pozostaje dokładnie taka sama."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem perdas: só muda a orientação, a qualidade fica exatamente igual."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fără pierderi: se schimbă doar orientarea, calitatea rămâne identică."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без потерь: меняется только ориентация, качество остаётся прежним."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıpsız: Yalnızca yön değişir, görüntü kalitesi tamamen aynı kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Без втрат: змінюється лише орієнтація, якість лишається такою самою."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无损：只改变方向，画质完全不变。"
          }
        }
      }
    },
    "edit_hint_replace_confirm": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيطلب Android مرة واحدة تأكيد نقل الأصل إلى سلة مهملات Android."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Android fragt einmal nach, ob das Original in den Android-Papierkorb darf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Android asks once to confirm moving the original to the Android trash."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Android pedirá una vez confirmar que el original vaya a la papelera de Android."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android demande une fois de confirmer le déplacement de l’original dans la corbeille Android."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Android chiede una volta di confermare lo spostamento dell’originale nel cestino di Android."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元の写真をAndroidのゴミ箱に移動してよいか、Androidが一度確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android가 원본을 Android 휴지통으로 옮겨도 되는지 한 번 물어봐요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Android vraagt één keer of het origineel naar de Android-prullenbak mag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Android raz zapyta, czy przenieść oryginał do kosza Androida."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Android pede uma vez para confirmar a passagem do original para o lixo do Android."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Android cere o dată confirmarea mutării originalului în coșul Android."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Android один раз спросит, можно ли переместить оригинал в корзину Android."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android, orijinalin Android çöp kutusuna taşınması için bir kez onay ister."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Android один раз запитає, чи можна перемістити оригінал у кошик Android."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 会询问一次是否将原图移到 Android 回收站。"
          }
        }
      }
    },
