    "vault2_backup_explanation": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تشمل الوسائط والملاحظات والملفات والمجلدات وسلة الخزنة. استخدم كلمة مرور قوية ومنفصلة. لا يمكن الاستعادة بدونها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichert Medien, Notizen, Dateien, Ordner und den Tresor-Papierkorb. Verwende ein starkes, eigenes Backup-Passwort. Ohne dieses Passwort ist das Backup nicht wiederherstellbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Includes media, notes, files, folders and vault trash. Use a strong, separate backup password. Without it, the backup cannot be restored."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluye medios, notas, archivos, carpetas y papelera. Usa una contraseña segura y distinta. Sin ella no se puede restaurar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclut médias, notes, fichiers, dossiers et corbeille du coffre. Utilisez un mot de passe fort et distinct. Sans lui, la sauvegarde est irrécupérable."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Include media, note, file, cartelle e cestino. Usa una password forte e separata. Senza di essa il backup non è ripristinabile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メディア、メモ、ファイル、フォルダ、保管庫のゴミ箱を含みます。専用の強力なパスワードを使ってください。忘れると復元できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미디어, 메모, 파일, 폴더, 휴지통이 포함됩니다. 강력한 별도 비밀번호를 사용하세요. 비밀번호 없이는 복원할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevat media, notities, bestanden, mappen en kluisprullenmand. Gebruik een sterk, apart wachtwoord. Zonder dat wachtwoord is herstellen onmogelijk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obejmuje multimedia, notatki, pliki, foldery i kosz sejfu. Użyj silnego, osobnego hasła. Bez niego nie można przywrócić kopii."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclui multimédia, notas, ficheiros, pastas e lixo do cofre. Usa uma palavra-passe forte e própria. Sem ela, não é possível restaurar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Include media, notițe, fișiere, dosare și coșul seifului. Folosește o parolă puternică, separată. Fără ea, copia nu poate fi restaurată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включает медиа, заметки, файлы, папки и корзину сейфа. Используйте надёжный отдельный пароль. Без него копию нельзя восстановить."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Medya, notlar, dosyalar, klasörler ve kasa çöp kutusunu içerir. Güçlü ve ayrı bir parola kullan. Parola olmadan yedek geri yüklenemez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Містить медіа, нотатки, файли, папки й кошик сховища. Використовуйте надійний окремий пароль. Без нього копію неможливо відновити."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包含媒体、笔记、文件、文件夹和保险库废纸篓。请使用独立的强密码。没有此密码便无法恢复备份。"
          }
        }
      }
    },
    "vault2_backup_failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تُستعد النسخة: كلمة مرور خاطئة أو ملف تالف أو جلسة مقفلة أو مساحة غير كافية. المحتوى الحالي لم يتغير."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup nicht wiederhergestellt. Passwort falsch, Datei beschädigt, Sitzung gesperrt oder Speicherplatz unzureichend. Vorhandene Inhalte bleiben unverändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup not restored. The password may be wrong, the file damaged, the session locked or storage insufficient. Existing content is unchanged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se restauró: contraseña incorrecta, archivo dañado, sesión bloqueada o poco espacio. El contenido existente no cambia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauvegarde non restaurée : mot de passe incorrect, fichier endommagé, session verrouillée ou espace insuffisant. Le contenu existant reste inchangé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup non ripristinato: password errata, file danneggiato, sessione bloccata o spazio insufficiente. I contenuti esistenti restano invariati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復元できませんでした。パスワード、ファイル破損、ロック、空き容量を確認してください。既存の内容は変更されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복원하지 못했습니다. 잘못된 비밀번호, 파일 손상, 세션 잠금 또는 공간 부족일 수 있습니다. 기존 내용은 변경되지 않았습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet hersteld: onjuist wachtwoord, beschadigd bestand, vergrendelde sessie of onvoldoende ruimte. Bestaande inhoud blijft ongewijzigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie przywrócono: błędne hasło, uszkodzony plik, zablokowana sesja lub brak miejsca. Istniejąca zawartość pozostaje bez zmian."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi restaurado: palavra-passe errada, ficheiro danificado, sessão bloqueada ou espaço insuficiente. O conteúdo existente não muda."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia nu a fost restaurată: parolă greșită, fișier deteriorat, sesiune blocată sau spațiu insuficient. Conținutul existent rămâne neschimbat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копия не восстановлена: неверный пароль, повреждённый файл, блокировка или нехватка места. Существующие данные не изменены."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yedek yüklenemedi: yanlış parola, bozuk dosya, kilitli oturum veya yetersiz alan. Mevcut içerik değişmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Копію не відновлено: неправильний пароль, пошкоджений файл, блокування або брак місця. Наявні дані не змінено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未恢复备份。可能是密码错误、文件损坏、会话锁定或空间不足。现有内容保持不变。"
          }
        }
      }
    },
