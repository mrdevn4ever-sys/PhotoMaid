    "vault_intro_1": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصور ومقاطع الفيديو في الخزنة مشفّرة برمزك ولا تظهر إلا هنا – وليس في أي مكان آخر في GaleriQ."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভল্টের ফটো ও ভিডিও আপনার কোড দিয়ে এনক্রিপ্ট করা এবং শুধু এখানেই দেখা যায় – GaleriQ-এর অন্য কোথাও নয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fotos i els vídeos de la caixa forta es xifren amb el teu codi i només són visibles aquí, enlloc més de GaleriQ."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotky a videa v trezoru jsou šifrované vaším kódem a viditelné jen tady – nikde jinde v GaleriQ."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos og videoer i boksen krypteres med din kode og er kun synlige her – ingen andre steder i GaleriQ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos und Videos im Tresor sind mit deinem Code verschlüsselt und nur hier zu sehen – nirgends sonst in GaleriQ."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι φωτογραφίες και τα βίντεο στο θησαυροφυλάκιο κρυπτογραφούνται με τον κωδικό σου και φαίνονται μόνο εδώ – πουθενά αλλού στο GaleriQ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos and videos in the vault are encrypted with your code and visible only here – nowhere else in GaleriQ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos y los vídeos de la caja fuerte están cifrados con tu código y solo se ven aquí, en ningún otro lugar de GaleriQ."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Holvin kuvat ja videot salataan koodillasi ja näkyvät vain täällä – ei missään muualla GaleriQ:ssa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos et vidéos du coffre-fort sont chiffrées avec ton code et visibles uniquement ici – nulle part ailleurs dans GaleriQ."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "વૉલ્ટના ફોટા અને વીડિયો તમારા કોડથી એન્ક્રિપ્ટેડ છે અને ફક્ત અહીં જ દેખાય છે – GaleriQ માં બીજે ક્યાંય નહીં."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תמונות וסרטונים בכספת מוצפנים עם הקוד שלך וגלויים רק כאן – לא בשום מקום אחר ב-GaleriQ."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तिजोरी की फ़ोटो और वीडियो आपके कोड से एन्क्रिप्टेड हैं और सिर्फ़ यहाँ दिखती हैं – GaleriQ में कहीं और नहीं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografije i videozapisi u trezoru šifrirani su tvojim kôdom i vidljivi samo ovdje – nigdje drugdje u GaleriQ-u."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A széfben lévő fotók és videók a kódoddal titkosítva vannak, és csak itt láthatók – a GaleriQ máshol nem mutatja őket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto dan video di brankas dienkripsi dengan kodemu dan hanya terlihat di sini – tidak di tempat lain di GaleriQ."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto e video nella cassaforte sono crittografati con il tuo codice e visibili solo qui, in nessun’altra parte di GaleriQ."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保管庫内の写真とビデオはあなたのコードで暗号化され、ここでのみ表示されます。GaleriQのほかの場所には表示されません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ವಾಲ್ಟ್‌ನಲ್ಲಿರುವ ಫೋಟೋಗಳು ಮತ್ತು ವೀಡಿಯೊಗಳು ನಿಮ್ಮ ಕೋಡ್‌ನಿಂದ ಎನ್‌ಕ್ರಿಪ್ಟ್ ಆಗಿವೆ ಮತ್ತು ಇಲ್ಲಿ ಮಾತ್ರ ಕಾಣಿಸುತ್ತವೆ – GaleriQ ನ ಬೇರೆಡೆ ಎಲ್ಲಿಯೂ ಅಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "금고 안의 사진과 비디오는 암호로 암호화되어 여기에서만 보이며, GaleriQ의 다른 곳에는 표시되지 않습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വോൾട്ടിലെ ഫോട്ടോകളും വീഡിയോകളും നിങ്ങളുടെ കോഡ് ഉപയോഗിച്ച് എൻക്രിപ്റ്റ് ചെയ്തവയും ഇവിടെ മാത്രം ദൃശ്യമാകുന്നവയുമാണ് – GaleriQ-ലെ മറ്റെവിടെയുമല്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "व्हॉल्टमधील फोटो आणि व्हिडिओ तुमच्या कोडने एन्क्रिप्ट केलेले असतात आणि फक्त इथेच दिसतात – GaleriQ मध्ये इतरत्र नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto dan video dalam peti besi disulitkan dengan kod anda dan hanya kelihatan di sini – tidak di tempat lain dalam GaleriQ."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilder og videoer i safen krypteres med koden din og er bare synlige her – ingen andre steder i GaleriQ."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto’s en video’s in de kluis zijn versleuteld met je code en alleen hier zichtbaar – nergens anders in GaleriQ."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଭଲ୍ଟର ଫଟୋ ଓ ଭିଡିଓ ଆପଣଙ୍କ କୋଡ୍ ସହ ଏନକ୍ରିପ୍ଟେଡ୍ ଏବଂ କେବଳ ଏଠାରେ ଦେଖାଯାଏ – GaleriQର ଅନ୍ୟ କେଉଁଠି ନୁହେଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਵੌਲਟ ਵਿਚਲੀਆਂ ਫ਼ੋਟੋਆਂ ਅਤੇ ਵੀਡੀਓ ਤੁਹਾਡੇ ਕੋਡ ਨਾਲ ਇਨਕ੍ਰਿਪਟਡ ਹਨ ਅਤੇ ਸਿਰਫ਼ ਇੱਥੇ ਦਿਸਦੀਆਂ ਹਨ – GaleriQ ਵਿੱਚ ਹੋਰ ਕਿਤੇ ਨਹੀਂ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdjęcia i filmy w sejfie są zaszyfrowane Twoim kodem i widoczne tylko tutaj – nigdzie indziej w GaleriQ."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos e vídeos no cofre são criptografados com o seu código e só aparecem aqui – em nenhum outro lugar do GaleriQ."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As fotografias e os vídeos no cofre estão encriptados com o teu código e só são visíveis aqui – em mais nenhum lugar do GaleriQ."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozele și videoclipurile din seif sunt criptate cu codul tău și vizibile doar aici – nicăieri altundeva în GaleriQ."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото и видео в сейфе зашифрованы твоим кодом и видны только здесь — больше нигде в GaleriQ."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotky a videá v trezore sú šifrované vaším kódom a viditeľné len tu – nikde inde v GaleriQ."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografije in videoposnetki v sefu so šifrirani s tvojo kodo in vidni samo tukaj – nikjer drugje v GaleriQ."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilder och videor i valvet krypteras med din kod och syns bara här – ingen annanstans i GaleriQ."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "லாக்கரில் உள்ள புகைப்படங்களும் வீடியோக்களும் உங்கள் குறியீட்டால் குறியாக்கப்பட்டு இங்கே மட்டுமே தெரியும் – GaleriQ-இன் வேறு எங்கும் அல்ல."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వాల్ట్‌లోని ఫోటోలు, వీడియోలు మీ కోడ్‌తో ఎన్‌క్రిప్ట్ అయి ఇక్కడ మాత్రమే కనిపిస్తాయి – GaleriQలో మరెక్కడా కాదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปภาพและวิดีโอในตู้เซฟถูกเข้ารหัสด้วยรหัสของคุณ และมองเห็นได้ที่นี่เท่านั้น – ไม่ปรากฏที่อื่นใน GaleriQ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasadaki fotoğraflar ve videolar kodunla şifrelenir ve yalnızca burada görünür – GaleriQ’in başka hiçbir yerinde görünmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото й відео в сейфі зашифровано твоїм кодом, і їх видно лише тут — більше ніде в GaleriQ."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "والٹ کی تصاویر اور ویڈیوز آپ کے کوڈ سے خفیہ ہیں اور صرف یہاں دکھتی ہیں – GaleriQ میں کہیں اور نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh và video trong két sắt được mã hóa bằng mã của bạn và chỉ hiện ở đây – không ở đâu khác trong GaleriQ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保险箱中的照片和视频已用你的密码加密，只在这里可见，GaleriQ 的其他地方都看不到。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保險箱中的照片和影片會用你的密碼加密，只會在這裡顯示 – 不會出現在 GaleriQ 的其他地方。"
          }
        }
      }
    },
    "vault_intro_2": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند إضافة عناصر، يسألك iOS هل يمكن حذفها من تطبيق الصور. بعدها تبقى في «المحذوفة مؤخرًا» لمدة 30 يومًا ما لم تُفرغه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আইটেম যোগ করলে iOS জিজ্ঞেস করে ফটো অ্যাপ থেকে এগুলো মোছা যাবে কি না। তারপর আপনি খালি না করলে এগুলো ৩০ দিন “সম্প্রতি মুছে ফেলা”-তে থাকে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Quan afegeixes elements, l’iOS pregunta si es poden esborrar de l’app Fotos. Després es queden 30 dies a «Eliminat recentment», tret que el buidis."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když přidáte položky, iOS se zeptá, zda je smí smazat z aplikace Fotky. Pak zůstanou 30 dní v „Nedávno smazaných“, pokud je nevyprázdníte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du tilføjer emner, spørger iOS, om de må slettes fra appen Fotos. De bliver derefter i “Senest slettet” i 30 dage, medmindre du tømmer det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Ablegen fragt iOS, ob sie aus der Fotos-App gelöscht werden dürfen. Danach liegen sie dort noch 30 Tage in „Zuletzt gelöscht“, außer du leerst den Ordner."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν προσθέτεις στοιχεία, το iOS ρωτά αν μπορούν να διαγραφούν από την εφαρμογή Φωτογραφίες. Τότε μένουν 30 ημέρες στα «Πρόσφατα διαγραμμένα», εκτός αν τα αδειάσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you add items, iOS asks whether they may be deleted from the Photos app. They then stay in “Recently Deleted” for 30 days unless you empty it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al añadir elementos, iOS pregunta si se pueden eliminar de la app Fotos. Después permanecen 30 días en «Eliminado», salvo que lo vacíes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun lisäät kohteita, iOS kysyy, saako ne poistaa Kuvat-apista. Sen jälkeen ne pysyvät 30 päivää kansiossa ”Äskettäin poistetut”, ellet tyhjennä sitä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand tu ajoutes des éléments, iOS demande s’ils peuvent être supprimés de l’app Photos. Ils restent ensuite 30 jours dans « Suppressions récentes », sauf si tu le vides."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આઇટમ ઉમેરતી વખતે iOS પૂછે છે કે શું તેમને ફોટો ઍપમાંથી ડિલીટ કરી શકાય. પછી તમે ખાલી ન કરો ત્યાં સુધી તે 30 દિવસ “તાજેતરમાં ડિલીટ કરેલ” માં રહે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כשמוסיפים פריטים, iOS שואלת אם מותר למחוק אותם מהיישום ״תמונות״. אחר כך הם נשארים 30 יום ב„נמחקו לאחרונה”, אלא אם מרוקנים אותו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आइटम जोड़ने पर iOS पूछता है कि क्या उन्हें तस्वीरें ऐप से डिलीट किया जा सकता है। फिर वे 30 दिन “हाल ही में डिलीट किए गए” में रहते हैं, जब तक आप उसे खाली न करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad dodaš stavke, iOS pita smiju li se izbrisati iz aplikacije Fotografije. Zatim ostaju 30 dana u „Nedavno izbrisano” ako ga ne isprazniš."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Elemek hozzáadásakor az iOS megkérdezi, törölhetők-e a Fotók appból. Ezután 30 napig a „Nemrég törölt” albumban maradnak, hacsak ki nem üríted."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat kamu menambahkan item, iOS bertanya apakah boleh dihapus dari app Foto. Item lalu tetap di “Baru Dihapus” selama 30 hari kecuali kamu mengosongkannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando aggiungi elementi, iOS chiede se possono essere eliminati dall’app Foto. Poi restano per 30 giorni in «Eliminati di recente», a meno che tu non lo svuoti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "項目を追加すると、写真アプリから削除してよいかiOSが確認します。その後、空にしない限り30日間「最近削除した項目」に残ります。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಐಟಂಗಳನ್ನು ಸೇರಿಸಿದಾಗ, ಅವುಗಳನ್ನು ಫೋಟೋಗಳು ಆ್ಯಪ್‌ನಿಂದ ಅಳಿಸಬಹುದೇ ಎಂದು iOS ಕೇಳುತ್ತದೆ. ನಂತರ ನೀವು ಖಾಲಿ ಮಾಡದಿದ್ದರೆ ಅವು 30 ದಿನಗಳ ಕಾಲ “ಇತ್ತೀಚೆಗೆ ಅಳಿಸಲಾಗಿದೆ” ನಲ್ಲಿ ಉಳಿಯುತ್ತವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목을 추가하면 iOS가 사진 앱에서 삭제해도 되는지 묻습니다. 이후 직접 비우지 않는 한 30일 동안 ‘최근 삭제된 항목’에 남아 있습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ ഇനങ്ങൾ ചേർക്കുമ്പോൾ, ഫോട്ടോസ് ആപ്പിൽ നിന്ന് അവ ഇല്ലാതാക്കാമോ എന്ന് iOS ചോദിക്കും. തുടർന്ന് നിങ്ങൾ ശൂന്യമാക്കാത്തിടത്തോളം അവ 30 ദിവസം “അടുത്തിടെ ഇല്ലാതാക്കിയവ”-ൽ തുടരും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आयटम जोडल्यावर iOS विचारते की ते फोटो अ‍ॅपमधून डिलीट करता येतील का. मग तुम्ही रिकामे न केल्यास ते 30 दिवस “अलीकडे डिलीट केलेले” मध्ये राहतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apabila anda menambah item, iOS bertanya sama ada ia boleh dipadam daripada app Foto. Ia kemudian kekal dalam “Dipadam Baru-baru Ini” selama 30 hari melainkan anda mengosongkannya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du legger til elementer, spør iOS om de kan slettes fra Bilder-appen. De blir deretter liggende i «Nylig slettet» i 30 dager med mindre du tømmer den."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je onderdelen toevoegt, vraagt iOS of ze uit de Foto’s-app mogen worden verwijderd. Daarna blijven ze nog 30 dagen in ‘Recent verwijderd’, tenzij je dat leegmaakt."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣ ଆଇଟମ୍ ଯୋଗ କଲେ iOS ପଚାରେ ଫଟୋ ଆପ୍‌ରୁ ସେଗୁଡ଼ିକ ଡିଲିଟ୍ କରାଯାଇପାରିବ କି ନାହିଁ। ତାପରେ ଆପଣ ଖାଲି ନକଲେ ସେଗୁଡ଼ିକ 30 ଦିନ “ନିକଟରେ ଡିଲିଟ୍ ହୋଇଥିବା”ରେ ରହେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਦੋਂ ਤੁਸੀਂ ਆਈਟਮਾਂ ਜੋੜਦੇ ਹੋ, ਤਾਂ iOS ਪੁੱਛਦਾ ਹੈ ਕਿ ਕੀ ਇਨ੍ਹਾਂ ਨੂੰ ਫ਼ੋਟੋਆਂ ਐਪ ਤੋਂ ਮਿਟਾਇਆ ਜਾ ਸਕਦਾ ਹੈ। ਫਿਰ ਇਹ 30 ਦਿਨਾਂ ਤੱਕ “ਹਾਲ ਹੀ ਵਿੱਚ ਮਿਟਾਏ ਗਏ” ਵਿੱਚ ਰਹਿੰਦੀਆਂ ਹਨ, ਜਦੋਂ ਤੱਕ ਤੁਸੀਂ ਉਸ ਨੂੰ ਖਾਲੀ ਨਹੀਂ ਕਰਦੇ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy dodajesz elementy, iOS pyta, czy można je usunąć z aplikacji Zdjęcia. Potem pozostają przez 30 dni w albumie „Ostatnio usunięte”, chyba że go opróżnisz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando você adiciona itens, o iOS pergunta se eles podem ser apagados do app Fotos. Eles ficam então em “Apagados” por 30 dias, a menos que você esvazie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando adicionas itens, o iOS pergunta se podem ser apagados da app Fotografias. Depois ficam 30 dias em «Apagados recentemente», a não ser que o esvazies."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Când adaugi elemente, iOS întreabă dacă pot fi șterse din aplicația Poze. Apoi rămân 30 de zile în „Șterse recent”, dacă nu golești dosarul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При добавлении iOS спрашивает, можно ли удалить объекты из «Фото». Затем они ещё 30 дней остаются в «Недавно удаленных», если ты не очистишь этот альбом."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Keď pridáte položky, iOS sa opýta, či ich smie vymazať z aplikácie Fotky. Potom zostanú 30 dní v „Nedávno vymazaných“, ak ich nevyprázdnite."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko dodaš elemente, iOS vpraša, ali jih sme izbrisati iz aplikacije Fotografije. Nato ostanejo 30 dni v »Nedavno izbrisano«, razen če ga izprazniš."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När du lägger till objekt frågar iOS om de får raderas från appen Bilder. De ligger sedan kvar i ”Nyligen raderade” i 30 dagar om du inte tömmer den."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் உருப்படிகளைச் சேர்க்கும்போது, Photos ஆப்பிலிருந்து அவற்றை நீக்கலாமா என iOS கேட்கும். பின்னர் நீங்கள் காலி செய்யாவிட்டால் அவை 30 நாட்கள் “சமீபத்தில் நீக்கியவை”-இல் இருக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు అంశాలను జోడించినప్పుడు, వాటిని Photos యాప్ నుండి తొలగించవచ్చా అని iOS అడుగుతుంది. ఆ తర్వాత మీరు ఖాళీ చేయకపోతే అవి 30 రోజులు “ఇటీవల తొలగించినవి”లో ఉంటాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อคุณเพิ่มรายการ iOS จะถามว่าลบออกจากแอพรูปภาพได้หรือไม่ จากนั้นรายการจะอยู่ใน “ที่ลบล่าสุด” 30 วัน เว้นแต่คุณจะล้าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Öğe eklediğinde iOS, Fotoğraflar uygulamasından silinip silinemeyeceklerini sorar. Ardından sen boşaltmadıkça 30 gün boyunca “Son Silinenler”de kalırlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під час додавання iOS запитує, чи можна видалити об’єкти з «Фото». Потім вони ще 30 днів залишаються в «Нещодавно видалених», якщо ти не очистиш цей альбом."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آئٹمز شامل کرنے پر iOS پوچھتا ہے کہ کیا انہیں تصاویر ایپ سے حذف کیا جا سکتا ہے۔ پھر وہ 30 دن ”حال ہی میں حذف کردہ“ میں رہتے ہیں، جب تک آپ اسے خالی نہ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi bạn thêm mục, iOS hỏi có được xóa chúng khỏi ứng dụng Ảnh không. Sau đó chúng nằm trong “Đã xóa gần đây” 30 ngày, trừ khi bạn dọn nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加项目时，iOS 会询问是否可以从“照片”App 中删除它们。之后它们会在“最近删除”中保留 30 天，除非你将其清空。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加入項目時，iOS 會詢問是否可以從「照片」App 刪除。之後它們會在「最近刪除」中保留 30 天，除非你清空它。"
          }
        }
      }
    },
    "vault_intro_3": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الخزنة مضمّنة في نسخة iPhone الاحتياطية (مشفّرة). إذا حذفت GaleriQ، تختفي الخزنة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভল্টটি আপনার iPhone ব্যাকআপে (এনক্রিপ্ট করা) অন্তর্ভুক্ত। GaleriQ মুছে ফেললে ভল্টও চলে যায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La caixa forta s’inclou a la còpia de seguretat de l’iPhone (xifrada). Si esborres GaleriQ, la caixa forta desapareix."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Trezor je součástí zálohy iPhonu (šifrovaně). Pokud GaleriQ smažete, trezor zmizí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Boksen indgår i din iPhone-sikkerhedskopi (krypteret). Hvis du sletter GaleriQ, forsvinder boksen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Tresor ist verschlüsselt in deinem iPhone-Backup enthalten. Löschst du GaleriQ, ist er weg."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το θησαυροφυλάκιο περιλαμβάνεται στο αντίγραφο ασφαλείας του iPhone (κρυπτογραφημένο). Αν διαγράψεις το GaleriQ, το θησαυροφυλάκιο χάνεται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The vault is included in your iPhone backup (encrypted). If you delete GaleriQ, the vault is gone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La caja fuerte se incluye en la copia de seguridad de tu iPhone (cifrada). Si eliminas GaleriQ, la caja fuerte desaparece."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Holvi sisältyy iPhonesi varmuuskopioon (salattuna). Jos poistat GaleriQ:n, holvi katoaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le coffre-fort est inclus dans la sauvegarde de ton iPhone (chiffré). Si tu supprimes GaleriQ, le coffre-fort disparaît."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "વૉલ્ટ તમારા iPhone બૅકઅપમાં સામેલ છે (એન્ક્રિપ્ટેડ). તમે GaleriQ ડિલીટ કરો તો વૉલ્ટ જતું રહે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הכספת נכללת בגיבוי של ה-iPhone (מוצפנת). מחיקת GaleriQ מעלימה את הכספת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तिजोरी आपके iPhone बैकअप में शामिल है (एन्क्रिप्टेड)। अगर आप GaleriQ डिलीट करते हैं, तो तिजोरी चली जाती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trezor je uključen u sigurnosnu kopiju iPhonea (šifrirano). Ako izbrišeš GaleriQ, trezor nestaje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A széf része az iPhone biztonsági mentésének (titkosítva). Ha törlöd a GaleriQ-t, a széf eltűnik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Brankas termasuk dalam cadangan iPhone-mu (terenkripsi). Jika kamu menghapus GaleriQ, brankas ikut hilang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cassaforte è inclusa nel backup del tuo iPhone (crittografata). Se elimini GaleriQ, la cassaforte sparisce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保管庫はiPhoneのバックアップに（暗号化された状態で）含まれます。GaleriQを削除すると、保管庫はなくなります。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ವಾಲ್ಟ್ ನಿಮ್ಮ iPhone ಬ್ಯಾಕಪ್‌ನಲ್ಲಿ (ಎನ್‌ಕ್ರಿಪ್ಟ್ ಆಗಿ) ಸೇರಿದೆ. ನೀವು GaleriQ ಅಳಿಸಿದರೆ ವಾಲ್ಟ್ ಹೋಗುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "금고는 iPhone 백업에 (암호화된 상태로) 포함됩니다. GaleriQ를 삭제하면 금고도 사라집니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വോൾട്ട് നിങ്ങളുടെ iPhone ബാക്കപ്പിൽ (എൻക്രിപ്റ്റ് ചെയ്ത്) ഉൾപ്പെടുന്നു. നിങ്ങൾ GaleriQ ഇല്ലാതാക്കിയാൽ വോൾട്ട് ഇല്ലാതാകും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "व्हॉल्ट तुमच्या iPhone बॅकअपमध्ये समाविष्ट आहे (एन्क्रिप्टेड). तुम्ही GaleriQ डिलीट केल्यास व्हॉल्ट नाहीसा होतो."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Peti besi termasuk dalam sandaran iPhone anda (disulitkan). Jika anda memadam GaleriQ, peti besi hilang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Safen inngår i iPhone-sikkerhetskopien din (kryptert). Hvis du sletter GaleriQ, forsvinner safen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De kluis zit (versleuteld) in je iPhone-reservekopie. Als je GaleriQ verwijdert, is de kluis weg."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଭଲ୍ଟ ଆପଣଙ୍କ iPhone ବ୍ୟାକଅପ୍‌ରେ (ଏନକ୍ରିପ୍ଟେଡ୍) ଅନ୍ତର୍ଭୁକ୍ତ। ଆପଣ GaleriQ ଡିଲିଟ୍ କଲେ ଭଲ୍ଟ ଚାଲିଯାଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਵੌਲਟ ਤੁਹਾਡੇ iPhone ਬੈਕਅੱਪ ਵਿੱਚ (ਇਨਕ੍ਰਿਪਟਡ) ਸ਼ਾਮਲ ਹੈ। ਜੇ ਤੁਸੀਂ GaleriQ ਮਿਟਾਉਂਦੇ ਹੋ, ਤਾਂ ਵੌਲਟ ਖ਼ਤਮ ਹੋ ਜਾਂਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sejf jest (w postaci zaszyfrowanej) częścią kopii zapasowej Twojego iPhone’a. Jeśli usuniesz GaleriQ, sejf zniknie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cofre está incluído no backup do seu iPhone (criptografado). Se você apagar o GaleriQ, o cofre some."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O cofre está incluído na cópia de segurança do teu iPhone (encriptado). Se apagares o GaleriQ, o cofre desaparece."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Seiful este inclus (criptat) în backupul iPhone-ului tău. Dacă ștergi GaleriQ, seiful dispare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейф входит в резервную копию iPhone (в зашифрованном виде). Если удалишь GaleriQ, сейф пропадёт."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Trezor je súčasťou zálohy iPhonu (šifrovane). Ak GaleriQ vymažete, trezor zmizne."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sef je vključen v varnostno kopijo iPhona (šifrirano). Če izbrišeš GaleriQ, sefa ni več."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Valvet ingår i din iPhone-säkerhetskopia (krypterat). Om du raderar GaleriQ försvinner valvet."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "லாக்கர் உங்கள் iPhone காப்புப்பிரதியில் (குறியாக்கப்பட்டு) அடங்கும். GaleriQ-ஐ நீக்கினால் லாக்கர் போய்விடும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వాల్ట్ మీ iPhone బ్యాకప్‌లో (ఎన్‌క్రిప్ట్ అయి) చేరి ఉంది. మీరు GaleriQను తొలగిస్తే వాల్ట్ పోతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตู้เซฟรวมอยู่ในข้อมูลสำรอง iPhone ของคุณ (เข้ารหัส) หากคุณลบ GaleriQ ตู้เซฟจะหายไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasa, iPhone yedeğine (şifreli olarak) dahildir. GaleriQ’i silersen kasa da gider."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейф входить до резервної копії iPhone (у зашифрованому вигляді). Якщо видалиш GaleriQ, сейф зникне."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "والٹ آپ کے iPhone بیک اپ میں شامل ہے (خفیہ)۔ اگر آپ GaleriQ حذف کرتے ہیں تو والٹ ختم ہو جاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Két sắt có trong bản sao lưu iPhone (đã mã hóa). Nếu bạn xóa GaleriQ, két sắt sẽ mất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保险箱（已加密）包含在你的 iPhone 备份中。如果删除 GaleriQ，保险箱也会随之消失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保險箱包含在你的 iPhone 備份中（已加密）。如果刪除 GaleriQ，保險箱也會消失。"
          }
        }
      }
    },
    "vault_intro_4": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في النسخة المجانية يحتاج كل مجلد جديد إلى فيديو إعلاني قصير. مع Pro تنشئ المجلدات بلا إعلانات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিনামূল্যের সংস্করণে প্রতিটি নতুন ফোল্ডারের জন্য একটি ছোট বিজ্ঞাপন ভিডিও লাগে। Pro-তে ফোল্ডার বিজ্ঞাপন ছাড়াই তৈরি হয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "A la versió gratuïta, cada carpeta nova necessita un vídeo publicitari curt. Amb Pro, les carpetes es creen sense anuncis."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V bezplatné verzi potřebuje každá nová složka krátké reklamní video. S Pro se složky vytvářejí bez reklam."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "I gratisversionen kræver hver ny mappe en kort reklamevideo. Med Pro oprettes mapper uden reklamer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der Gratis-Version braucht jeder neue Ordner ein kurzes Werbevideo. Mit Pro legst du Ordner ohne Werbung an."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στη δωρεάν έκδοση, κάθε νέος φάκελος χρειάζεται ένα σύντομο διαφημιστικό βίντεο. Με το Pro οι φάκελοι δημιουργούνται χωρίς διαφημίσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the free version, each new folder needs a short ad video. With Pro, folders are created without ads."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la versión gratuita, cada carpeta nueva requiere un breve vídeo publicitario. Con Pro creas carpetas sin anuncios."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmaisversiossa jokainen uusi kansio vaatii lyhyen mainosvideon. Pron kanssa kansiot luodaan ilman mainoksia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans la version gratuite, chaque nouveau dossier nécessite une courte vidéo publicitaire. Avec Pro, tu crées des dossiers sans publicité."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "મફત વર્ઝનમાં દરેક નવા ફોલ્ડર માટે ટૂંકો જાહેરાત વીડિયો જોઈએ. Pro સાથે ફોલ્ડર જાહેરાત વિના બને છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בגרסה החינמית, כל תיקייה חדשה דורשת סרטון פרסומת קצר. עם Pro התיקיות נוצרות בלי פרסומות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मुफ़्त वर्शन में हर नए फ़ोल्डर के लिए एक छोटा विज्ञापन वीडियो चाहिए। Pro के साथ फ़ोल्डर बिना विज्ञापन बनते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "U besplatnoj verziji svaka nova mapa zahtijeva kratak reklamni videozapis. Uz Pro mape se izrađuju bez oglasa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az ingyenes verzióban minden új mappához egy rövid reklámvideó kell. A Próval a mappák hirdetés nélkül jönnek létre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di versi gratis, setiap folder baru butuh video iklan pendek. Dengan Pro, folder dibuat tanpa iklan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nella versione gratuita ogni nuova cartella richiede un breve video pubblicitario. Con Pro crei cartelle senza pubblicità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料版では新しいフォルダごとに短い広告動画が必要です。Proなら広告なしでフォルダを作成できます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಉಚಿತ ಆವೃತ್ತಿಯಲ್ಲಿ ಪ್ರತಿ ಹೊಸ ಫೋಲ್ಡರ್‌ಗೆ ಒಂದು ಚಿಕ್ಕ ಜಾಹೀರಾತು ವೀಡಿಯೊ ಬೇಕು. Pro ನಲ್ಲಿ ಫೋಲ್ಡರ್‌ಗಳು ಜಾಹೀರಾತುಗಳಿಲ್ಲದೆ ರಚನೆಯಾಗುತ್ತವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 버전에서는 새 폴더마다 짧은 광고 동영상이 필요해요. Pro에서는 광고 없이 폴더를 만들어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സൗജന്യ പതിപ്പിൽ ഓരോ പുതിയ ഫോൾഡറിനും ഒരു ചെറിയ പരസ്യ വീഡിയോ വേണം. Pro-യിൽ ഫോൾഡറുകൾ പരസ്യങ്ങളില്ലാതെ സൃഷ്‌ടിക്കപ്പെടും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "विनामूल्य आवृत्तीत प्रत्येक नवीन फोल्डरसाठी एक छोटा जाहिरात व्हिडिओ लागतो. Pro सह फोल्डर जाहिरातीशिवाय तयार होतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dalam versi percuma, setiap folder baharu memerlukan video iklan pendek. Dengan Pro, folder dicipta tanpa iklan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "I gratisversjonen krever hver nye mappe en kort annonsevideo. Med Pro opprettes mapper uten annonser."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In de gratis versie heeft elke nieuwe map een korte advertentievideo nodig. Met Pro maak je mappen zonder advertenties."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ମାଗଣା ସଂସ୍କରଣରେ ପ୍ରତ୍ୟେକ ନୂଆ ଫୋଲ୍ଡର ପାଇଁ ଏକ ଛୋଟ ବିଜ୍ଞାପନ ଭିଡିଓ ଦରକାର। Proରେ ଫୋଲ୍ଡର ବିଜ୍ଞାପନ ବିନା ତିଆରି ହୁଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮੁਫ਼ਤ ਵਰਜ਼ਨ ਵਿੱਚ ਹਰ ਨਵੇਂ ਫ਼ੋਲਡਰ ਲਈ ਇੱਕ ਛੋਟੀ ਇਸ਼ਤਿਹਾਰ ਵੀਡੀਓ ਚਾਹੀਦੀ ਹੈ। Pro ਨਾਲ ਫ਼ੋਲਡਰ ਬਿਨਾਂ ਇਸ਼ਤਿਹਾਰਾਂ ਦੇ ਬਣਦੇ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W wersji bezpłatnej każdy nowy folder wymaga krótkiego filmu reklamowego. Z Pro tworzysz foldery bez reklam."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Na versão grátis, cada nova pasta exige um vídeo curto de anúncio. Com o Pro, as pastas são criadas sem anúncios."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Na versão gratuita, cada nova pasta requer um curto vídeo publicitário. Com o Pro crias pastas sem anúncios."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În versiunea gratuită, fiecare dosar nou necesită un scurt videoclip publicitar. Cu Pro creezi dosare fără reclame."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В бесплатной версии для каждой новой папки нужно короткое рекламное видео. С Pro папки создаются без рекламы."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "V bezplatnej verzii potrebuje každý nový priečinok krátke reklamné video. S Pro sa priečinky vytvárajú bez reklám."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "V brezplačni različici vsaka nova mapa potrebuje kratek oglasni video. S Pro se mape ustvarijo brez oglasov."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "I gratisversionen kräver varje ny mapp en kort annonsvideo. Med Pro skapas mappar utan annonser."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இலவசப் பதிப்பில் ஒவ்வொரு புதிய கோப்புறைக்கும் ஒரு சிறிய விளம்பர வீடியோ தேவை. Pro-வில் கோப்புறைகள் விளம்பரமின்றி உருவாக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఉచిత వెర్షన్‌లో ప్రతి కొత్త ఫోల్డర్‌కి ఒక చిన్న ప్రకటన వీడియో అవసరం. Proలో ఫోల్డర్‌లు ప్రకటనలు లేకుండా సృష్టించబడతాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในเวอร์ชันฟรี แต่ละโฟลเดอร์ใหม่ต้องดูวิดีโอโฆษณาสั้นๆ กับ Pro จะสร้างโฟลเดอร์ได้โดยไม่มีโฆษณา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ücretsiz sürümde her yeni klasör için kısa bir reklam videosu gerekir. Pro ile klasörleri reklamsız oluşturursun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У безкоштовній версії для кожної нової теки потрібне коротке рекламне відео. З Pro теки створюються без реклами."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مفت ورژن میں ہر نئے فولڈر کے لیے ایک مختصر اشتہاری ویڈیو چاہیے۔ Pro کے ساتھ فولڈرز بغیر اشتہار بنتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ở bản miễn phí, mỗi thư mục mới cần xem một video quảng cáo ngắn. Với Pro, thư mục được tạo không cần quảng cáo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免费版中，每个新文件夹都需要观看一段简短的广告视频。使用 Pro 可无广告新建文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在免費版中，每個新檔案夾都需要觀看一段短廣告影片。使用 Pro 建立檔案夾不需看廣告。"
          }
        }
      }
    },
