    "vault_import_confirm_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم نسخها مشفّرة والتحقق منها. بعد ذلك يسألك iOS هل يمكن حذفها من تطبيق الصور. وهناك تبقى في «المحذوفة مؤخرًا» لمدة 30 يومًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De kopieres krypteret og kontrolleres. Derefter spørger iOS, om de må slettes fra appen Fotos. Der bliver de i “Senest slettet” i 30 dage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie werden verschlüsselt kopiert und geprüft. Danach fragt iOS, ob sie aus der Fotos-App gelöscht werden dürfen. Dort liegen sie dann noch 30 Tage in „Zuletzt gelöscht“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They are copied encrypted and verified. Then iOS asks whether they may be deleted from the Photos app. There they stay in “Recently Deleted” for 30 days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se copian cifrados y se verifican. Después, iOS pregunta si se pueden eliminar de la app Fotos. Allí permanecen 30 días en «Eliminado»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils sont copiés de manière chiffrée et vérifiés. Ensuite, iOS demande s’ils peuvent être supprimés de l’app Photos. Ils y restent 30 jours dans « Suppressions récentes »."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Item disalin terenkripsi dan diperiksa. Lalu iOS bertanya apakah boleh dihapus dari app Foto. Di sana item tetap di “Baru Dihapus” selama 30 hari."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vengono copiati in forma crittografata e verificati. Poi iOS chiede se possono essere eliminati dall’app Foto. Lì restano per 30 giorni in «Eliminati di recente»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "暗号化してコピーし、検証します。その後、写真アプリから削除してよいかiOSが確認します。写真アプリでは30日間「最近削除した項目」に残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "암호화된 상태로 복사하고 확인합니다. 그런 다음 iOS가 사진 앱에서 삭제해도 되는지 묻습니다. 사진 앱에서는 30일 동안 ‘최근 삭제된 항목’에 남아 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "De kopieres kryptert og kontrolleres. Deretter spør iOS om de kan slettes fra Bilder-appen. Der blir de liggende i «Nylig slettet» i 30 dager."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ze worden versleuteld gekopieerd en gecontroleerd. Daarna vraagt iOS of ze uit de Foto’s-app mogen worden verwijderd. Daar blijven ze nog 30 dagen in ‘Recent verwijderd’."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostaną skopiowane w postaci zaszyfrowanej i sprawdzone. Potem iOS zapyta, czy można je usunąć z aplikacji Zdjęcia. Tam pozostaną jeszcze przez 30 dni w albumie „Ostatnio usunięte”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Eles são copiados de forma criptografada e verificados. Depois o iOS pergunta se podem ser apagados do app Fotos. Lá eles ficam em “Apagados” por 30 dias."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "São copiados de forma encriptada e verificados. Depois, o iOS pergunta se podem ser apagados da app Fotografias. Aí ficam 30 dias em «Apagados recentemente»."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunt copiate criptat și verificate. Apoi iOS întreabă dacă pot fi șterse din aplicația Poze. Acolo rămân încă 30 de zile în „Șterse recent”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Они копируются в зашифрованном виде и проверяются. Затем iOS спросит, можно ли удалить их из «Фото». Там они ещё 30 дней останутся в «Недавно удаленных»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De kopieras krypterat och kontrolleras. Sedan frågar iOS om de får raderas från appen Bilder. Där ligger de kvar i ”Nyligen raderade” i 30 dagar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการจะถูกคัดลอกแบบเข้ารหัสและตรวจสอบ จากนั้น iOS จะถามว่าลบออกจากแอพรูปภาพได้หรือไม่ ที่นั่นรายการจะอยู่ใน “ที่ลบล่าสุด” 30 วัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şifrelenerek kopyalanır ve doğrulanırlar. Ardından iOS, Fotoğraflar uygulamasından silinip silinemeyeceklerini sorar. Orada 30 gün boyunca “Son Silinenler”de kalırlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Їх буде скопійовано в зашифрованому вигляді та перевірено. Потім iOS запитає, чи можна видалити їх із «Фото». Там вони ще 30 днів залишатимуться в «Нещодавно видалених»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng được sao chép có mã hóa và được kiểm tra. Sau đó iOS hỏi có được xóa khỏi ứng dụng Ảnh không. Ở đó chúng nằm trong “Đã xóa gần đây” 30 ngày."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它们会被加密复制并校验。随后 iOS 会询问是否可以从“照片”App 中删除它们。在那里，它们会在“最近删除”中保留 30 天。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它們會被加密複製並驗證。接著 iOS 會詢問是否可以從「照片」App 刪除。它們會在那裡的「最近刪除」中保留 30 天。"
          }
        }
      }
    },
