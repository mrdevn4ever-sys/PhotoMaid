    "org_basket_intro": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اجمع وسائط من أشهر ومجلدات مختلفة. تبقى السلة حتى تفرغها – ولا علاقة لها بسلة المهملات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিভিন্ন মাস ও ফোল্ডার থেকে ফটো ও ভিডিও জড়ো করুন। আপনি খালি না করা পর্যন্ত ঝুড়ি থাকে – ট্র্যাশের সাথে এর কোনো সম্পর্ক নেই।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Recull fotos i vídeos de mesos i carpetes diferents. La cistella es manté fins que la buides i no té res a veure amb la paperera."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sbírejte fotky a videa z různých měsíců a složek. Košík zůstává, dokud ho nevyprázdníte – s košem nemá nic společného."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Saml fotos og videoer fra forskellige måneder og mapper. Kurven bliver, til du tømmer den – den har intet med papirkurven at gøre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sammle Fotos und Videos aus verschiedenen Monaten und Ordnern. Der Korb bleibt erhalten, bis du ihn leerst – mit dem Papierkorb hat er nichts zu tun."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μάζεψε φωτογραφίες και βίντεο από διαφορετικούς μήνες και φακέλους. Το καλάθι μένει μέχρι να το αδειάσεις – δεν έχει καμία σχέση με τον κάδο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Collect photos and videos from different months and folders. The basket stays until you empty it – it has nothing to do with the trash."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reúne contenido de distintos meses y carpetas. La cesta se mantiene hasta que la vacíes; no tiene nada que ver con la papelera."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kerää kuvia ja videoita eri kuukausista ja kansioista. Kori säilyy, kunnes tyhjennät sen – sillä ei ole mitään tekemistä roskakorin kanssa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rassemble des médias de différents mois et dossiers. Le panier reste jusqu’à ce que tu le vides – il n’a rien à voir avec la corbeille."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અલગ-અલગ મહિના અને ફોલ્ડરમાંથી ફોટા અને વીડિયો એકઠા કરો. તમે ખાલી ન કરો ત્યાં સુધી ટોપલી રહે છે – તેને ટ્રેશ સાથે કોઈ લેવાદેવા નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לאסוף תמונות וסרטונים מחודשים ותיקיות שונים. הסל נשאר עד שמרוקנים אותו – אין לו קשר לפח."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अलग-अलग महीनों और फ़ोल्डर से फ़ोटो और वीडियो इकट्ठा करें। टोकरी तब तक रहती है जब तक आप उसे खाली न करें – इसका ट्रैश से कोई लेना-देना नहीं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Skupljaj fotografije i videozapise iz različitih mjeseci i mapa. Košarica ostaje dok je ne isprazniš – nema nikakve veze sa smećem."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Gyűjts fotókat és videókat különböző hónapokból és mappákból. A kosár addig marad, amíg ki nem üríted – semmi köze a kukához."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kumpulkan foto dan video dari bulan dan folder yang berbeda. Keranjang tetap ada sampai kamu mengosongkannya – tidak ada hubungannya dengan sampah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Raccogli contenuti da mesi e cartelle diversi. Il cestino resta finché non lo svuoti e non ha nulla a che fare con il cestino dei rifiuti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いろいろな月やフォルダからメディアを集めます。かごは空にするまで残り、ゴミ箱とは関係ありません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಬೇರೆ ಬೇರೆ ತಿಂಗಳುಗಳು ಮತ್ತು ಫೋಲ್ಡರ್‌ಗಳಿಂದ ಫೋಟೋಗಳು ಮತ್ತು ವೀಡಿಯೊಗಳನ್ನು ಸಂಗ್ರಹಿಸಿ. ನೀವು ಖಾಲಿ ಮಾಡುವವರೆಗೆ ಬುಟ್ಟಿ ಉಳಿಯುತ್ತದೆ – ಇದಕ್ಕೂ ಕಸದ ಬುಟ್ಟಿಗೂ ಸಂಬಂಧವಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여러 달과 폴더의 미디어를 모으세요. 바구니는 비울 때까지 유지되며 휴지통과는 관계없어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വിവിധ മാസങ്ങളിൽ നിന്നും ഫോൾഡറുകളിൽ നിന്നും ഫോട്ടോകളും വീഡിയോകളും ശേഖരിക്കുക. നിങ്ങൾ ശൂന്യമാക്കുന്നതുവരെ കൊട്ട നിലനിൽക്കും – ഇതിന് ട്രാഷുമായി ബന്ധമില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "वेगवेगळ्या महिन्यांतून आणि फोल्डरमधून फोटो व व्हिडिओ गोळा करा. तुम्ही रिकामी करेपर्यंत टोपली राहते – तिचा ट्रॅशशी काहीही संबंध नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kumpul foto dan video daripada bulan dan folder yang berbeza. Bakul kekal sehingga anda mengosongkannya – ia tiada kaitan dengan sampah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Samle bilder og videoer fra ulike måneder og mapper. Kurven blir til du tømmer den – den har ingenting med papirkurven å gjøre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verzamel media uit verschillende maanden en mappen. De mand blijft tot je hem leegt – hij heeft niets met de prullenbak te maken."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ବିଭିନ୍ନ ମାସ ଓ ଫୋଲ୍ଡରରୁ ଫଟୋ ଓ ଭିଡିଓ ସଂଗ୍ରହ କରନ୍ତୁ। ଆପଣ ଖାଲି ନକରିବା ପର୍ଯ୍ୟନ୍ତ ଟୋକେଇ ରହେ – ଟ୍ରାସ ସହ ଏହାର କୌଣସି ସମ୍ପର୍କ ନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਵੱਖ-ਵੱਖ ਮਹੀਨਿਆਂ ਅਤੇ ਫ਼ੋਲਡਰਾਂ ਤੋਂ ਫ਼ੋਟੋਆਂ ਅਤੇ ਵੀਡੀਓ ਇਕੱਠੀਆਂ ਕਰੋ। ਟੋਕਰੀ ਤਦ ਤੱਕ ਰਹਿੰਦੀ ਹੈ ਜਦ ਤੱਕ ਤੁਸੀਂ ਇਸ ਨੂੰ ਖਾਲੀ ਨਹੀਂ ਕਰਦੇ – ਇਸ ਦਾ ਰੱਦੀ ਨਾਲ ਕੋਈ ਸੰਬੰਧ ਨਹੀਂ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbieraj multimedia z różnych miesięcy i folderów. Koszyk zostaje, dopóki go nie opróżnisz – nie ma nic wspólnego z koszem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reúna fotos e vídeos de meses e pastas diferentes. A cesta fica até você esvaziá-la – ela não tem nada a ver com a lixeira."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Junta conteúdos de vários meses e pastas. O cesto mantém-se até o esvaziares – não tem nada a ver com o lixo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adună conținut din luni și dosare diferite. Coșul rămâne până îl golești – nu are legătură cu coșul de gunoi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Собирай медиа из разных месяцев и папок. Корзина сохраняется, пока ты её не очистишь, и не связана с корзиной для удалённых."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbierajte fotky a videá z rôznych mesiacov a priečinkov. Košík zostáva, kým ho nevyprázdnite – s košom nemá nič spoločné."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbiraj fotografije in videoposnetke iz različnih mesecev in map. Košarica ostane, dokler je ne izprazniš – s košem nima nič skupnega."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Samla bilder och videor från olika månader och mappar. Korgen finns kvar tills du tömmer den – den har inget med papperskorgen att göra."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வெவ்வேறு மாதங்கள், கோப்புறைகளிலிருந்து புகைப்படங்களையும் வீடியோக்களையும் சேகரியுங்கள். நீங்கள் காலி செய்யும் வரை கூடை இருக்கும் – இதற்கும் குப்பைக்கும் தொடர்பில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వేర్వేరు నెలలు, ఫోల్డర్‌ల నుండి ఫోటోలు, వీడియోలను సేకరించండి. మీరు ఖాళీ చేసే వరకు బుట్ట ఉంటుంది – దీనికీ ట్రాష్‌కీ సంబంధం లేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รวบรวมรูปภาพและวิดีโอจากเดือนและโฟลเดอร์ต่างๆ ตะกร้าจะอยู่จนกว่าคุณจะล้าง – ไม่เกี่ยวกับถังขยะ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Farklı aylar ve klasörlerden medya topla. Sepet sen boşaltana kadar kalır – çöp kutusuyla ilgisi yoktur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збирай медіа з різних місяців і папок. Кошик зберігається, доки ти його не очистиш, і не пов’язаний із кошиком для видалених."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مختلف مہینوں اور فولڈرز سے تصاویر اور ویڈیوز جمع کریں۔ ٹوکری تب تک رہتی ہے جب تک آپ اسے خالی نہ کریں – اس کا ردی سے کوئی تعلق نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gom ảnh và video từ các tháng và thư mục khác nhau. Giỏ được giữ cho đến khi bạn làm trống – không liên quan gì đến thùng rác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从不同月份和文件夹收集媒体。选择篮会一直保留，直到你清空它——它与回收站无关。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "收集不同月份和檔案夾中的照片和影片。選擇籃會一直保留，直到你清空它 – 它和垃圾桶無關。"
          }
        }
      }
    },
