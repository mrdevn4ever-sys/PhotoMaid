            "value": "ಲಭ್ಯವಿಲ್ಲ — ದಯವಿಟ್ಟು ಮತ್ತೆ ಸಂಪರ್ಕಿಸಿ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "접근할 수 없어요. 다시 연결해 주세요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ലഭ്യമല്ല — ദയവായി വീണ്ടും കണക്റ്റ് ചെയ്യുക"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "उपलब्ध नाही — कृपया पुन्हा जोडा"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak tersedia — sila sambung semula"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke tilgjengelig — koble til igjen"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet bereikbaar — koppel opnieuw"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଉପଲବ୍ଧ ନାହିଁ — ଦୟାକରି ପୁଣି ସଂଯୋଗ କରନ୍ତୁ"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਉਪਲਬਧ ਨਹੀਂ — ਕਿਰਪਾ ਕਰਕੇ ਦੁਬਾਰਾ ਕਨੈਕਟ ਕਰੋ"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niedostępny — połącz ponownie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Indisponível — conecte novamente"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Inacessível — liga novamente"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Inaccesibil — conectează din nou"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Недоступна — подключи снова"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nedostupné — pripojte znova"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ni na voljo — znova poveži"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inte tillgänglig — anslut igen"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கிடைக்கவில்லை — மீண்டும் இணையுங்கள்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అందుబాటులో లేదు — దయచేసి మళ్లీ కనెక్ట్ చేయండి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่พร้อมใช้งาน — โปรดเชื่อมต่ออีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişilemiyor — yeniden bağla"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Недоступна — підключи знову"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دستیاب نہیں — براہ کرم دوبارہ منسلک کریں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không khả dụng — hãy kết nối lại"
          }
        },
        "zh-Hans": {
          "stringUnit": {
