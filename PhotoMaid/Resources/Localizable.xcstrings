    "fav_removed_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُزيلت علامة المفضلة. اسحب لليسار لنقله إلى سلة المهملات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আর পছন্দের হিসেবে চিহ্নিত নয়। ট্র্যাশে রাখতে বাঁয়ে সোয়াইপ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja no està marcat com a preferit. Llisca cap a l’esquerra per posar-lo a la paperera."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Už není označeno jako oblíbené. Přejetím doleva ho dáte do koše."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke længere markeret som favorit. Swipe til venstre for at lægge den i papirkurven."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht mehr als Favorit markiert. Wische nach links für den Papierkorb."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν είναι πια αγαπημένο. Σύρε αριστερά για να το βάλεις στον κάδο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No longer marked as a favorite. Swipe left to put it in the trash."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya no está marcado como favorito. Desliza a la izquierda para enviarlo a la papelera."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei enää merkitty suosikiksi. Pyyhkäise vasemmalle siirtääksesi roskakoriin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’élément n’est plus un favori. Glisse vers la gauche pour le mettre à la corbeille."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હવે મનપસંદ નથી. ટ્રેશમાં મૂકવા ડાબે સ્વાઇપ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כבר לא מסומן כמועדף. החלקה שמאלה מעבירה אותו לפח."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अब पसंदीदा नहीं है। ट्रैश में डालने के लिए बाएँ स्वाइप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Više nije označeno kao omiljeno. Povuci ulijevo da ga staviš u smeće."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Már nem kedvenc. Húzd balra, hogy a kukába tedd."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak lagi ditandai favorit. Geser ke kiri untuk memasukkannya ke sampah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è più tra i preferiti. Scorri a sinistra per metterlo nel cestino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お気に入りから外しました。左にスワイプするとゴミ箱に入ります。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇನ್ನು ಮೆಚ್ಚಿನದಾಗಿ ಗುರುತಿಸಲಾಗಿಲ್ಲ. ಕಸದ ಬುಟ್ಟಿಗೆ ಹಾಕಲು ಎಡಕ್ಕೆ ಸ್ವೈಪ್ ಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "즐겨찾기를 해제했어요. 왼쪽으로 밀면 휴지통에 들어가요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇനി പ്രിയപ്പെട്ടതായി അടയാളപ്പെടുത്തിയിട്ടില്ല. ട്രാഷിലേക്ക് ഇടാൻ ഇടത്തേക്ക് സ്വൈപ്പ് ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आता आवडते नाही. ट्रॅशमध्ये टाकण्यासाठी डावीकडे स्वाइप करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak lagi ditandakan sebagai kegemaran. Leret ke kiri untuk memasukkannya ke sampah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke lenger merket som favoritt. Sveip til venstre for å legge den i papirkurven."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet meer als favoriet gemarkeerd. Veeg naar links voor de prullenbak."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆଉ ପସନ୍ଦର ଭାବେ ଚିହ୍ନିତ ନୁହେଁ। ଟ୍ରାସରେ ରଖିବାକୁ ବାମକୁ ସ୍ୱାଇପ୍ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹੁਣ ਮਨਪਸੰਦ ਵਜੋਂ ਨਿਸ਼ਾਨਿਤ ਨਹੀਂ। ਰੱਦੀ ਵਿੱਚ ਪਾਉਣ ਲਈ ਖੱਬੇ ਸਵਾਈਪ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunięto oznaczenie ulubionego. Przesuń w lewo, aby przenieść do kosza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não está mais nos Favoritos. Deslize para a esquerda para colocar o item na lixeira."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Já não está marcado como favorito. Desliza para a esquerda para o colocar no lixo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu mai este marcat ca favorit. Glisează la stânga pentru a-l muta în coș."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отметка избранного убрана. Смахни влево, чтобы переместить в корзину."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Už nie je označené ako obľúbené. Potiahnutím doľava ho dáte do koša."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ni več označeno kot priljubljeno. Podrsaj levo, da ga daš v koš."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inte längre markerad som favorit. Svep åt vänster för att lägga den i papperskorgen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இனி பிடித்ததாகக் குறிக்கப்படவில்லை. குப்பையில் போட இடப்புறம் ஸ்வைப் செய்யுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇక ఇష్టమైనదిగా గుర్తించబడలేదు. ట్రాష్‌లో వేయడానికి ఎడమకు స్వైప్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ได้เป็นรายการโปรดแล้ว ปัดซ้ายเพื่อใส่ถังขยะ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Artık favori değil. Çöp kutusu için sola kaydır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позначку обраного прибрано. Змахни ліворуч, щоб перемістити в кошик."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اب پسندیدہ نہیں۔ ردی میں ڈالنے کے لیے بائیں سوائپ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không còn là mục ưa thích. Vuốt sang trái để cho vào thùng rác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已取消收藏。向左滑动即可放入回收站。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已不再標示為個人收藏。向左滑即可放入垃圾桶。"
          }
        }
      }
    },
