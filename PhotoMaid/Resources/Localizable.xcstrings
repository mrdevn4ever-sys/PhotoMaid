    "ach_sub": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما أنجزته بالفعل – أرقامك أنت فقط."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি যা ইতিমধ্যে অর্জন করেছেন – শুধু আপনার নিজের সংখ্যা।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El que ja has aconseguit: només les teves pròpies xifres."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Co už jste dokázali – jen vaše vlastní čísla."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det, du allerede har opnået – kun dine egne tal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was du schon geschafft hast – nur deine eigenen Zahlen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όσα έχεις ήδη πετύχει – μόνο οι δικοί σου αριθμοί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What you’ve already achieved – only your own numbers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que ya has conseguido: solo tus propios números."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitä olet jo saavuttanut – vain omat lukusi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que tu as déjà accompli – uniquement tes propres chiffres."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે જે પહેલેથી મેળવ્યું છે – ફક્ત તમારા પોતાના આંકડા."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מה שכבר השגת – רק המספרים שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने जो हासिल कर लिया है – सिर्फ़ आपके अपने आँकड़े।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ono što si već postigao – samo tvoji vlastiti brojevi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Amit már elértél – csak a saját számaid."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa yang sudah kamu capai – hanya angkamu sendiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quello che hai già fatto – solo i tuoi numeri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これまでの成果。あなた自身の数字だけ。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಈಗಾಗಲೇ ಸಾಧಿಸಿರುವುದು – ನಿಮ್ಮ ಸ್ವಂತ ಸಂಖ್ಯೆಗಳು ಮಾತ್ರ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금까지 해낸 것 – 내 숫자만 보여요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ ഇതിനകം നേടിയത് – നിങ്ങളുടെ സ്വന്തം സംഖ്യകൾ മാത്രം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही आधीच जे मिळवले आहे – फक्त तुमचे स्वतःचे आकडे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa yang telah anda capai – hanya angka anda sendiri."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det du allerede har oppnådd – bare dine egne tall."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat je al hebt bereikt – alleen je eigen cijfers."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣ ଯାହା ପୂର୍ବରୁ ହାସଲ କରିସାରିଛନ୍ତି – କେବଳ ଆପଣଙ୍କ ନିଜ ସଂଖ୍ୟା।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜੋ ਤੁਸੀਂ ਪਹਿਲਾਂ ਹੀ ਹਾਸਲ ਕਰ ਲਿਆ ਹੈ – ਸਿਰਫ਼ ਤੁਹਾਡੇ ਆਪਣੇ ਅੰਕੜੇ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co już udało ci się osiągnąć – tylko twoje własne liczby."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que você já conquistou – só os seus próprios números."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O que já conseguiste – apenas os teus próprios números."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce ai reușit deja – doar cifrele tale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чего ты уже добился – только твои собственные цифры."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Čo ste už dosiahli – len vaše vlastné čísla."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kar si že dosegel – samo tvoje lastne številke."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det du redan har uppnått – bara dina egna siffror."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் ஏற்கனவே அடைந்தவை – உங்கள் சொந்த எண்கள் மட்டும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఇప్పటికే సాధించినవి – మీ సొంత సంఖ్యలు మాత్రమే."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิ่งที่คุณทำได้แล้ว – เฉพาะตัวเลขของคุณเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimdiye kadar başardıkların – yalnızca kendi sayıların."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чого ти вже досяг – лише твої власні цифри."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جو آپ حاصل کر چکے ہیں – صرف آپ کے اپنے اعداد۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những gì bạn đã đạt được – chỉ là con số của riêng bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已取得的成果——只看你自己的数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你已經達成的成果 – 只有你自己的數字。"
          }
        }
      }
    },
