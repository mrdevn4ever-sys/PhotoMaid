    "onb_demo_desc": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بطاقات للتجربة. لا يُحفظ شيء هنا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Øvekort. Intet gemmes her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übungskarten. Hier wird nichts gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Practice cards. Nothing is saved here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarjetas de práctica. Aquí no se guarda nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cartes d’essai. Rien n’est enregistré ici."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartu latihan. Tidak ada yang disimpan di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Schede di prova. Qui non viene salvato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "練習用のカードです。ここでの操作は保存されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연습용 카드예요. 여기서는 아무것도 저장하지 않아요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Øvingskort. Ingenting lagres her."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oefenkaarten. Hier wordt niets opgeslagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Karty do ćwiczeń. Nic nie jest tu zapisywane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cartas de treino. Nada é salvo aqui."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cartões de treino. Nada é guardado aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Carduri de probă. Nimic nu se salvează aici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Учебные карточки. Здесь ничего не сохраняется."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Övningskort. Inget sparas här."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การ์ดฝึกซ้อม ไม่มีอะไรถูกบันทึกที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alıştırma kartları. Burada hiçbir şey kaydedilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Навчальні картки. Тут нічого не зберігається."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thẻ luyện tập. Không có gì được lưu ở đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "练习卡片，不会保存任何操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "練習用卡片。這裡不會儲存任何內容。"
          }
        }
      }
    },
