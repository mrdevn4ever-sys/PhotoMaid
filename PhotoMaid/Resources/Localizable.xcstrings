            "value": "Rezultatele nu au putut fi salvate. Verifică spațiul liber."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить результаты. Проверь свободное место."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Výsledky sa nepodarilo uložiť. Skontrolujte voľné miesto."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezultatov ni bilo mogoče shraniti. Preveri prosti prostor."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Resultaten kunde inte sparas. Kontrollera ledigt utrymme."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முடிவுகளைச் சேமிக்க முடியவில்லை. காலியான சேமிப்பகத்தைச் சரிபாருங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫలితాలను సేవ్ చేయడం సాధ్యం కాలేదు. ఖాళీ స్టోరేజ్‌ను తనిఖీ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
