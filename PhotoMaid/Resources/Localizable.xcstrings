    "vault2_empty_trash_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُحذف كل ما في سلة الخزنة (%1$@) نهائيًا من هذه الخزنة: الصور والفيديوهات والملاحظات والملفات. لن تتغير النسخ الخارجية والاحتياطية الحالية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভল্টের ট্র্যাশের (%1$@) সবকিছু এই ভল্ট থেকে স্থায়ীভাবে সরানো হবে: ফটো, ভিডিও, নোট ও ফাইল। বিদ্যমান বাইরের কপি ও ব্যাকআপ অপরিবর্তিত থাকে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tot el que hi ha a la paperera de la caixa forta (%1$@) s’eliminarà definitivament d’aquesta caixa forta: fotos, vídeos, notes i fitxers. Les còpies externes i les còpies de seguretat existents no canvien."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vše v koši trezoru (%1$@) bude z tohoto trezoru trvale odstraněno: fotky, videa, poznámky a soubory. Stávající externí kopie a zálohy zůstanou beze změny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt i boksens papirkurv (%1$@) fjernes permanent fra boksen: fotos, videoer, noter og filer. Eksisterende eksterne kopier og sikkerhedskopier er uændrede."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles im Tresor-Papierkorb (%1$@) wird unwiderruflich aus diesem Tresor entfernt: Fotos, Videos, Notizen und Dateien. Vorhandene externe Kopien und Backups bleiben unverändert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όλα όσα βρίσκονται στον κάδο του θησαυροφυλακίου (%1$@) θα αφαιρεθούν οριστικά από αυτό το θησαυροφυλάκιο: φωτογραφίες, βίντεο, σημειώσεις και αρχεία. Τα υπάρχοντα εξωτερικά αντίγραφα και αντίγραφα ασφαλείας δεν αλλάζουν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything in vault trash (%1$@) will be permanently removed from this vault: photos, videos, notes and files. Existing external copies and backups are unchanged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que hay en la papelera de la caja fuerte (%1$@) se eliminará permanentemente: fotos, vídeos, notas y archivos. Las copias externas y de seguridad no cambiarán."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki holvin roskakorissa (%1$@) poistetaan tästä holvista pysyvästi: kuvat, videot, muistiinpanot ja tiedostot. Olemassa olevat ulkoiset kopiot ja varmuuskopiot pysyvät ennallaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout le contenu de la corbeille du coffre (%1$@) sera définitivement supprimé de ce coffre : photos, vidéos, notes et fichiers. Les copies externes et sauvegardes existantes restent inchangées."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "વૉલ્ટ ટ્રેશમાંનું બધું (%1$@) આ વૉલ્ટમાંથી કાયમ માટે દૂર થશે: ફોટા, વીડિયો, નોંધો અને ફાઇલો. હાલની બાહ્ય નકલો અને બૅકઅપ બદલાતાં નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל מה שבפח של הכספת (%1$@) יוסר לצמיתות מהכספת הזו: תמונות, סרטונים, הערות וקבצים. עותקים חיצוניים וגיבויים קיימים לא משתנים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तिजोरी के ट्रैश में सब कुछ (%1$@) इस तिजोरी से स्थायी रूप से हट जाएगा: फ़ोटो, वीडियो, नोट और फ़ाइलें। मौजूदा बाहरी कॉपी और बैकअप नहीं बदलते।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sve u smeću trezora (%1$@) bit će trajno uklonjeno iz ovog trezora: fotografije, videozapisi, bilješke i datoteke. Postojeće vanjske kopije i sigurnosne kopije ostaju nepromijenjene."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A széf kukájában lévő minden tartalom (%1$@) véglegesen eltávolításra kerül ebből a széfből: fotók, videók, jegyzetek és fájlok. A meglévő külső másolatok és biztonsági mentések változatlanok maradnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua isi sampah brankas (%1$@) akan dihapus permanen dari brankas ini: foto, video, catatan, dan file. Salinan eksternal dan cadangan yang ada tidak berubah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto il contenuto del cestino della cassaforte (%1$@) sarà eliminato definitivamente: foto, video, note e file. Copie esterne e backup restano invariati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保管庫のゴミ箱にあるすべて（%1$@）をこの保管庫から完全に削除します：写真、ビデオ、メモ、ファイル。既存の外部コピーやバックアップは変更されません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ವಾಲ್ಟ್ ಕಸದ ಬುಟ್ಟಿಯಲ್ಲಿರುವ (%1$@) ಎಲ್ಲವನ್ನೂ ಈ ವಾಲ್ಟ್‌ನಿಂದ ಶಾಶ್ವತವಾಗಿ ತೆಗೆದುಹಾಕಲಾಗುತ್ತದೆ: ಫೋಟೋಗಳು, ವೀಡಿಯೊಗಳು, ಟಿಪ್ಪಣಿಗಳು ಮತ್ತು ಫೈಲ್‌ಗಳು. ಅಸ್ತಿತ್ವದಲ್ಲಿರುವ ಬಾಹ್ಯ ಪ್ರತಿಗಳು ಮತ್ತು ಬ್ಯಾಕಪ್‌ಗಳು ಬದಲಾಗುವುದಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관함 휴지통의 모든 항목(%1$@)이 이 보관함에서 영구 삭제됩니다: 사진, 비디오, 메모, 파일. 기존 외부 사본과 백업은 변경되지 않습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വോൾട്ട് ട്രാഷിലെ (%1$@) എല്ലാം ഈ വോൾട്ടിൽ നിന്ന് ശാശ്വതമായി നീക്കം ചെയ്യും: ഫോട്ടോകൾ, വീഡിയോകൾ, കുറിപ്പുകൾ, ഫയലുകൾ. നിലവിലുള്ള ബാഹ്യ പകർപ്പുകൾക്കും ബാക്കപ്പുകൾക്കും മാറ്റമില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "व्हॉल्ट ट्रॅशमधील सर्व काही (%1$@) या व्हॉल्टमधून कायमचे काढले जाईल: फोटो, व्हिडिओ, नोंदी आणि फाइल्स. सध्याच्या बाह्य प्रती आणि बॅकअप बदलत नाहीत."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua dalam sampah peti besi (%1$@) akan dibuang secara kekal daripada peti besi ini: foto, video, nota dan fail. Salinan luaran dan sandaran sedia ada tidak berubah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt i safens papirkurv (%1$@) fjernes permanent fra safen: bilder, videoer, notater og filer. Eksisterende eksterne kopier og sikkerhetskopier er uendret."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles in de kluisprullenmand (%1$@) wordt definitief uit deze kluis verwijderd: foto’s, video’s, notities en bestanden. Externe kopieën en back-ups blijven ongewijzigd."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଭଲ୍ଟ ଟ୍ରାସ (%1$@)ର ସବୁକିଛି ଏହି ଭଲ୍ଟରୁ ସ୍ଥାୟୀ ଭାବେ ହଟାଯିବ: ଫଟୋ, ଭିଡିଓ, ନୋଟ୍ ଓ ଫାଇଲ୍। ବିଦ୍ୟମାନ ବାହ୍ୟ କପି ଓ ବ୍ୟାକଅପ୍ ଅପରିବର୍ତ୍ତିତ ରହେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਵੌਲਟ ਦੀ ਰੱਦੀ (%1$@) ਵਿਚਲਾ ਸਭ ਕੁਝ ਇਸ ਵੌਲਟ ਤੋਂ ਪੱਕੇ ਤੌਰ ’ਤੇ ਹਟਾ ਦਿੱਤਾ ਜਾਵੇਗਾ: ਫ਼ੋਟੋਆਂ, ਵੀਡੀਓ, ਨੋਟ ਅਤੇ ਫ਼ਾਈਲਾਂ। ਮੌਜੂਦਾ ਬਾਹਰੀ ਕਾਪੀਆਂ ਅਤੇ ਬੈਕਅੱਪ ਬਿਨਾਂ ਬਦਲੇ ਰਹਿੰਦੇ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cała zawartość kosza sejfu (%1$@) zostanie trwale usunięta z tego sejfu: zdjęcia, filmy, notatki i pliki. Zewnętrzne kopie i kopie zapasowe pozostaną bez zmian."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo na lixeira do cofre (%1$@) será removido permanentemente deste cofre: fotos, vídeos, notas e arquivos. Cópias externas e backups existentes não são alterados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que está no lixo do cofre (%1$@) será apagado permanentemente deste cofre: fotografias, vídeos, notas e ficheiros. Cópias externas e de segurança ficam inalteradas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tot conținutul din coșul seifului (%1$@) va fi șters definitiv din acest seif: poze, videoclipuri, notițe și fișiere. Copiile externe și de siguranță rămân neschimbate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё содержимое корзины сейфа (%1$@) будет удалено из этого сейфа навсегда: фото, видео, заметки и файлы. Внешние и резервные копии останутся без изменений."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Všetko v koši trezoru (%1$@) bude z tohto trezoru natrvalo odstránené: fotky, videá, poznámky a súbory. Existujúce externé kópie a zálohy zostanú bez zmeny."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vse v košu sefa (%1$@) bo trajno odstranjeno iz tega sefa: fotografije, videoposnetki, zapiski in datoteke. Obstoječe zunanje kopije in varnostne kopije ostanejo nespremenjene."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Allt i valvets papperskorg (%1$@) tas bort permanent från valvet: bilder, videor, anteckningar och filer. Befintliga externa kopior och säkerhetskopior är oförändrade."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "லாக்கர் குப்பையில் (%1$@) உள்ள அனைத்தும் இந்த லாக்கரிலிருந்து நிரந்தரமாக அகற்றப்படும்: புகைப்படங்கள், வீடியோக்கள், குறிப்புகள், கோப்புகள். ஏற்கனவே உள்ள வெளிப்புற நகல்களும் காப்புப்பிரதிகளும் மாறாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వాల్ట్ ట్రాష్ (%1$@)లోని ప్రతిదీ ఈ వాల్ట్ నుండి శాశ్వతంగా తీసివేయబడుతుంది: ఫోటోలు, వీడియోలు, నోట్‌లు, ఫైళ్లు. ఇప్పటికే ఉన్న బయటి కాపీలు, బ్యాకప్‌లు మారవు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกอย่างในถังขยะตู้เซฟ (%1$@) จะถูกลบออกจากตู้เซฟอย่างถาวร: รูปภาพ วิดีโอ โน้ต และไฟล์ สำเนาภายนอกและข้อมูลสำรองที่มีอยู่ไม่เปลี่ยนแปลง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasa çöp kutusundaki her şey (%1$@) bu kasadan kalıcı olarak silinir: fotoğraflar, videolar, notlar ve dosyalar. Mevcut dış kopyalar ve yedekler değişmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увесь вміст кошика сховища (%1$@) буде видалено з цього сховища назавжди: фото, відео, нотатки й файли. Зовнішні й резервні копії залишаться без змін."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "والٹ کی ردی میں موجود سب کچھ (%1$@) اس والٹ سے مستقل طور پر ہٹ جائے گا: تصاویر، ویڈیوز، نوٹس اور فائلیں۔ موجودہ بیرونی کاپیاں اور بیک اپ تبدیل نہیں ہوتے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi thứ trong thùng rác két sắt (%1$@) sẽ bị xóa vĩnh viễn khỏi két sắt: ảnh, video, ghi chú và tệp. Bản sao bên ngoài và bản sao lưu hiện có không thay đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保险库废纸篓中的所有内容（%1$@）将从此保险库永久删除：照片、视频、笔记和文件。现有外部副本和备份保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保險箱垃圾桶中的所有內容（%1$@）將從此保險箱中永久移除：照片、影片、備忘錄和檔案。現有的外部副本和備份保持不變。"
          }
        }
      }
    },
