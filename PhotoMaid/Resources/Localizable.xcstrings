    "snake_photo_error": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تحميل بعض الصور. تحقق من اتصالك لصور iCloud وحاول مجددًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কিছু ফটো লোড করা যায়নি। iCloud ফটোর জন্য আপনার সংযোগ দেখে আবার চেষ্টা করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s’han pogut carregar algunes fotos. Comprova la connexió per a les fotos d’iCloud i torna-ho a provar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Některé fotky se nepodařilo načíst. Zkontrolujte připojení pro fotky z iCloudu a zkuste to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nogle fotos kunne ikke indlæses. Tjek forbindelsen for iCloud-fotos, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Fotos konnten nicht geladen werden. Prüfe bei iCloud-Fotos deine Verbindung und versuche es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ορισμένες φωτογραφίες δεν φορτώθηκαν. Έλεγξε τη σύνδεση για τις φωτογραφίες iCloud και δοκίμασε ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some photos could not be loaded. Check your connection for iCloud photos and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han podido cargar algunas fotos. Comprueba la conexión para las fotos de iCloud y vuelve a intentarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Joitakin kuvia ei voitu ladata. Tarkista iCloud-kuvien yhteys ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines photos n’ont pas pu être chargées. Vérifiez la connexion pour les photos iCloud et réessayez."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કેટલાક ફોટા લોડ થઈ શક્યા નથી. iCloud ફોટા માટે તમારું કનેક્શન તપાસો અને ફરી પ્રયાસ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה לטעון חלק מהתמונות. כדאי לבדוק את החיבור לתמונות iCloud ולנסות שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ फ़ोटो लोड नहीं हो सकीं। iCloud फ़ोटो के लिए अपना कनेक्शन जाँचें और फिर कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neke fotografije nije bilo moguće učitati. Provjeri vezu za iCloud fotografije i pokušaj ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Néhány fotó nem tölthető be. Ellenőrizd az iCloud-fotók kapcsolatát, és próbáld újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beberapa foto tidak dapat dimuat. Periksa koneksi untuk foto iCloud dan coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile caricare alcune foto. Controlla la connessione per le foto iCloud e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部の写真を読み込めませんでした。iCloud写真の接続を確認して再試行してください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕೆಲವು ಫೋಟೋಗಳನ್ನು ಲೋಡ್ ಮಾಡಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ. iCloud ಫೋಟೋಗಳಿಗಾಗಿ ನಿಮ್ಮ ಸಂಪರ್ಕ ಪರಿಶೀಲಿಸಿ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 사진을 불러오지 못했습니다. iCloud 사진의 연결을 확인하고 다시 시도하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ചില ഫോട്ടോകൾ ലോഡ് ചെയ്യാനായില്ല. iCloud ഫോട്ടോകൾക്കായി നിങ്ങളുടെ കണക്ഷൻ പരിശോധിച്ച് വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "काही फोटो लोड करता आले नाहीत. iCloud फोटोसाठी तुमचे कनेक्शन तपासा आणि पुन्हा प्रयत्न करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesetengah foto tidak dapat dimuatkan. Semak sambungan anda untuk foto iCloud dan cuba lagi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Noen bilder kunne ikke lastes inn. Sjekk forbindelsen for iCloud-bilder og prøv igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sommige foto's konden niet worden geladen. Controleer je verbinding voor iCloud-foto's en probeer opnieuw."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "କିଛି ଫଟୋ ଲୋଡ୍ ହୋଇପାରିଲା ନାହିଁ। iCloud ଫଟୋ ପାଇଁ ଆପଣଙ୍କ ସଂଯୋଗ ଯାଞ୍ଚ କରି ପୁଣି ଚେଷ୍ଟା କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੁਝ ਫ਼ੋਟੋਆਂ ਲੋਡ ਨਹੀਂ ਹੋ ਸਕੀਆਂ। iCloud ਫ਼ੋਟੋਆਂ ਲਈ ਆਪਣਾ ਕਨੈਕਸ਼ਨ ਜਾਂਚੋ ਅਤੇ ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się wczytać części zdjęć. Sprawdź połączenie dla zdjęć iCloud i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algumas fotos não puderam ser carregadas. Verifique sua conexão para fotos do iCloud e tente de novo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar algumas fotos. Verifica a ligação para as fotos iCloud e tenta novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Unele fotografii nu au putut fi încărcate. Verifică conexiunea pentru fotografiile iCloud și încearcă din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить некоторые фото. Проверьте подключение для фото iCloud и повторите попытку."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Niektoré fotky sa nepodarilo načítať. Skontrolujte pripojenie pre fotky z iCloudu a skúste to znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nekaterih fotografij ni bilo mogoče naložiti. Preveri povezavo za fotografije iCloud in poskusi znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Några bilder kunde inte läsas in. Kontrollera anslutningen för iCloud-bilder och försök igen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சில புகைப்படங்களை ஏற்ற முடியவில்லை. iCloud புகைப்படங்களுக்கு உங்கள் இணைப்பைச் சரிபார்த்து மீண்டும் முயலுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కొన్ని ఫోటోలను లోడ్ చేయడం సాధ్యం కాలేదు. iCloud ఫోటోల కోసం మీ కనెక్షన్ తనిఖీ చేసి మళ్లీ ప్రయత్నించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โหลดบางรูปไม่ได้ ตรวจสอบการเชื่อมต่อสำหรับรูปภาพ iCloud แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazı fotoğraflar yüklenemedi. iCloud fotoğrafları için bağlantını kontrol edip tekrar dene."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося завантажити деякі фото. Перевір з’єднання для фото iCloud і спробуй ще раз."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کچھ تصاویر لوڈ نہیں ہو سکیں۔ iCloud تصاویر کے لیے اپنا کنکشن چیک کریں اور دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tải được một số ảnh. Hãy kiểm tra kết nối cho ảnh iCloud và thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分照片无法加载。请检查iCloud照片的网络连接后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分照片無法載入。請檢查 iCloud 照片的網路連線後再試一次。"
          }
        }
      }
    },
