    "done_note_files": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حُذفت الملفات نهائيًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Dateien wurden endgültig gelöscht."
          }
        },
        "en": {
