    "error_undo_busy": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن التراجع أثناء إفراغ سلة المهملات."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vent, til papirkurven er tømt, før du bruger Fortryd."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Während der Papierkorb geleert wird, kannst du keine Aktion rückgängig machen."
          }
        },
        "en": {
          "stringUnit": {
