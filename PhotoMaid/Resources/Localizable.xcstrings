        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiza se izvodi samo na ovom iPhoneu (Apple Vision). Rezultati su prijedlozi – ti odlučuješ u feedu. Ništa se ne prenosi ni ne briše automatski."
