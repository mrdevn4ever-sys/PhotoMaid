    "edits_empty_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عندما تعدّل صورة أو تحفظ كولاجًا أو فيلمًا أو صورًا مصغّرة، تظهر النتيجة هنا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du ein Foto bearbeitest oder eine Collage, einen Film oder verkleinerte Bilder speicherst, erscheint das Ergebnis hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you edit a photo or save a collage, a movie or resized images, the result appears here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando editas una foto o guardas un collage, una película o imágenes reducidas, el resultado aparece aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand tu modifies une photo ou enregistres un collage, un film ou des images réduites, le résultat apparaît ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando modifichi una foto o salvi un collage, un filmato o immagini ridotte, il risultato compare qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真を編集したり、コラージュ、ムービー、縮小した画像を保存したりすると、ここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진을 편집하거나 콜라주, 영상, 축소한 이미지를 저장하면 결과가 여기에 표시돼요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je een foto bewerkt of een collage, film of verkleinde afbeeldingen bewaart, verschijnt het resultaat hier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy edytujesz zdjęcie lub zapiszesz kolaż, film albo pomniejszone obrazy, wynik pojawi się tutaj."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando editas uma fotografia ou guardas uma colagem, um filme ou imagens reduzidas, o resultado aparece aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Când editezi o poză sau salvezi un colaj, un film ori imagini micșorate, rezultatul apare aici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда ты редактируешь фото или сохраняешь коллаж, фильм или уменьшенные изображения, результат появится здесь."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir fotoğrafı düzenlediğinde ya da kolaj, film veya küçültülmüş görseller kaydettiğinde sonuç burada görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли ти редагуєш фото або зберігаєш колаж, фільм чи зменшені зображення, результат з’явиться тут."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当你编辑照片或保存拼贴、影片或缩小的图片时，结果会显示在这里。"
          }
        }
      }
    },
