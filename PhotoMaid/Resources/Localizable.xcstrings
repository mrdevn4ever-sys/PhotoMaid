    "vault_delete_folder_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى العناصر في الخزنة، لكن دون مجلد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আইটেমগুলো ভল্টেই থাকে, শুধু ফোল্ডার ছাড়া।"
