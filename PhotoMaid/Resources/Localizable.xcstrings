    "rec_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الميداليات تقيس نتائجك أنت فقط – لا لوائح ترتيب، ولا شيء يغادر الجهاز."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পদক শুধু আপনার নিজের ফলাফলের সাথে তুলনা করে – কোনো লিডারবোর্ড নেই, কিছুই ডিভাইস ছেড়ে যায় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les medalles només comparen amb els teus propis resultats: sense classificacions i res no surt del dispositiu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Medaile porovnávají jen s vašimi vlastními výsledky – žádné žebříčky, nic neopouští zařízení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Medaljer sammenlignes kun med dine egne resultater – ingen ranglister, intet forlader enheden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Medaillen messen nur deine eigenen Werte – keine Ranglisten, nichts verlässt das Gerät."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα μετάλλια συγκρίνουν μόνο με τα δικά σου αποτελέσματα – χωρίς κατατάξεις, τίποτα δεν φεύγει από τη συσκευή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Medals only compare with your own results – no leaderboards, nothing leaves the device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las medallas solo miden tus propios resultados: sin clasificaciones, nada sale del dispositivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitalit vertaavat vain omiin tuloksiisi – ei tulostaulukoita, mikään ei lähde laitteelta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les médailles ne mesurent que tes propres résultats – pas de classement, rien ne quitte l’appareil."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ચંદ્રકો ફક્ત તમારાં પોતાનાં પરિણામો સાથે સરખામણી કરે છે – કોઈ લીડરબોર્ડ નહીં, કંઈ ઉપકરણની બહાર જતું નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המדליות משוות רק לתוצאות שלך – בלי טבלאות דירוג, שום דבר לא יוצא מהמכשיר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पदक सिर्फ़ आपके अपने नतीजों से तुलना करते हैं – कोई लीडरबोर्ड नहीं, कुछ भी डिवाइस से बाहर नहीं जाता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Medalje se uspoređuju samo s tvojim vlastitim rezultatima – bez ljestvica, ništa ne napušta uređaj."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az érmek csak a saját eredményeiddel vetnek össze – nincs ranglista, semmi sem hagyja el az eszközt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Medali hanya dibandingkan dengan hasilmu sendiri – tanpa papan peringkat, tidak ada yang keluar dari perangkat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le medaglie misurano solo i tuoi risultati – nessuna classifica, nulla lascia il dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メダルはあなた自身の記録だけで決まります。ランキングはなく、データは端末の外に出ません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪದಕಗಳು ನಿಮ್ಮ ಸ್ವಂತ ಫಲಿತಾಂಶಗಳೊಂದಿಗೆ ಮಾತ್ರ ಹೋಲಿಸುತ್ತವೆ – ಲೀಡರ್‌ಬೋರ್ಡ್‌ಗಳಿಲ್ಲ, ಏನೂ ಸಾಧನವನ್ನು ಬಿಟ್ಟು ಹೋಗುವುದಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메달은 내 기록만으로 정해져요. 순위표는 없고, 아무것도 기기 밖으로 나가지 않아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മെഡലുകൾ നിങ്ങളുടെ സ്വന്തം ഫലങ്ങളുമായി മാത്രം താരതമ്യം ചെയ്യുന്നു – ലീഡർബോർഡുകളില്ല, ഒന്നും ഉപകരണം വിട്ടുപോകില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पदके फक्त तुमच्या स्वतःच्या निकालांशी तुलना करतात – लीडरबोर्ड नाही, काहीही डिव्हाइसबाहेर जात नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pingat hanya membandingkan dengan keputusan anda sendiri – tiada papan pendahulu, tiada apa meninggalkan peranti."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Medaljer sammenlignes bare med dine egne resultater – ingen ledertavler, ingenting forlater enheten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Medailles meten alleen je eigen resultaten – geen ranglijsten, niets verlaat het apparaat."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପଦକ କେବଳ ଆପଣଙ୍କ ନିଜ ଫଳାଫଳ ସହ ତୁଳନା କରେ – କୌଣସି ଲିଡରବୋର୍ଡ ନାହିଁ, କିଛି ଡିଭାଇସ୍ ଛାଡ଼େ ନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮੈਡਲ ਸਿਰਫ਼ ਤੁਹਾਡੇ ਆਪਣੇ ਨਤੀਜਿਆਂ ਨਾਲ ਤੁਲਨਾ ਕਰਦੇ ਹਨ – ਕੋਈ ਲੀਡਰਬੋਰਡ ਨਹੀਂ, ਕੁਝ ਵੀ ਡਿਵਾਈਸ ਤੋਂ ਬਾਹਰ ਨਹੀਂ ਜਾਂਦਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Medale mierzą tylko twoje wyniki – bez rankingów, nic nie opuszcza urządzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As medalhas só comparam com seus próprios resultados – sem ranking, nada sai do aparelho."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As medalhas medem apenas os teus resultados – sem classificações, nada sai do dispositivo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Medaliile măsoară doar rezultatele tale – fără clasamente, nimic nu părăsește dispozitivul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Медали учитывают только твои результаты – без рейтингов, ничего не покидает устройство."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Medaily porovnávajú len s vašimi vlastnými výsledkami – žiadne rebríčky, nič neopúšťa zariadenie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Medalje primerjajo le s tvojimi lastnimi rezultati – brez lestvic, nič ne zapusti naprave."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Medaljerna jämförs bara med dina egna resultat – inga topplistor, inget lämnar enheten."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பதக்கங்கள் உங்கள் சொந்த முடிவுகளுடன் மட்டுமே ஒப்பிடுகின்றன – தரவரிசைகள் இல்லை, எதுவும் சாதனத்தை விட்டு வெளியேறாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పతకాలు మీ సొంత ఫలితాలతో మాత్రమే పోలుస్తాయి – లీడర్‌బోర్డ్‌లు లేవు, ఏదీ పరికరాన్ని వదిలి వెళ్లదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เหรียญเปรียบเทียบกับผลงานของคุณเองเท่านั้น – ไม่มีกระดานอันดับ ไม่มีอะไรออกจากอุปกรณ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Madalyalar yalnızca kendi sonuçlarını ölçer – sıralama yok, hiçbir şey cihazdan çıkmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Медалі враховують лише твої результати – без рейтингів, нічого не залишає пристрій."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تمغے صرف آپ کے اپنے نتائج سے موازنہ کرتے ہیں – کوئی لیڈر بورڈ نہیں، کچھ بھی ڈیوائس سے باہر نہیں جاتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Huy chương chỉ so với kết quả của chính bạn – không có bảng xếp hạng, không có gì rời khỏi thiết bị."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "奖牌只与你自己的成绩相比——没有排行榜，数据不会离开设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "獎牌只和你自己的成績比較 – 沒有排行榜，任何內容都不會離開裝置。"
          }
        }
      }
    },
