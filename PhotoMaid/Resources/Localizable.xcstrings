    "vid_estimate_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقدير تقريبي فقط. سترى الحجم الفعلي بعد الحفظ."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun et groft skøn. Den rigtige filstørrelse ser du efter gemning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur ungefähr. Wie groß die Datei wirklich wird, siehst du nach dem Speichern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only a rough guess. You’ll see the real file size after saving."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo es aproximado. Verás el tamaño real después de guardar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est seulement une estimation. Vous verrez la vraie taille après l’enregistrement."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya perkiraan kasar. Kamu akan melihat ukuran file sebenarnya setelah menyimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È solo una stima. La dimensione reale la vedi dopo il salvataggio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "おおよその目安です。実際のサイズは保存後にわかります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대략적인 크기예요. 실제 크기는 저장한 뒤 확인할 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare et grovt anslag. Den faktiske filstørrelsen ser du etter lagring."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen een schatting. De echte grootte zie je na het opslaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To tylko przybliżenie. Rzeczywisty rozmiar zobaczysz po zapisaniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só uma estimativa aproximada. Você verá o tamanho real do arquivo depois de salvar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "É apenas uma estimativa. Verá o tamanho real depois de guardar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar aproximativ. Mărimea reală o vezi după salvare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это лишь примерная оценка. Точный размер вы увидите после сохранения."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara en grov uppskattning. Den verkliga filstorleken ser du efter sparandet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เป็นเพียงการประมาณคร่าวๆ คุณจะเห็นขนาดไฟล์จริงหลังบันทึก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca yaklaşık. Gerçek boyutu kaydettikten sonra görürsün."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це лише приблизно. Справжній розмір ви побачите після збереження."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ là ước tính sơ bộ. Bạn sẽ thấy kích thước thật sau khi lưu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这只是大致估算。保存后可看到实际大小。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只是粗略估計。儲存後才會看到實際檔案大小。"
          }
        }
      }
    },
