    "dup_incomplete_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت قراءة بعض المحتويات. قد تحتوي العناصر التي لم تُفحص على نسخ متطابقة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কিছু বিষয়বস্তু পড়া যায়নি। যাচাই না হওয়া আইটেমে আরও অভিন্ন কপি থাকতে পারে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s’ha pogut llegir part del contingut. Els elements no comprovats poden contenir més còpies idèntiques."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Část obsahu se nepodařilo přečíst. Nezkontrolované položky mohou obsahovat další identické kopie."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Noget indhold kunne ikke læses. Ukontrollerede emner kan indeholde flere identiske kopier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht alle Inhalte konnten gelesen werden. Ungeprüfte Elemente können weitere identische Kopien enthalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μέρος του περιεχομένου δεν διαβάστηκε. Τα μη ελεγμένα στοιχεία μπορεί να περιέχουν κι άλλα πανομοιότυπα αντίγραφα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some content could not be read. Unchecked items may contain more identical copies."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer todo el contenido. Los elementos sin comprobar pueden contener más copias idénticas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Osaa sisällöstä ei voitu lukea. Tarkistamattomissa kohteissa voi olla lisää identtisiä kopioita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains contenus n’ont pas pu être lus. Les éléments non vérifiés peuvent contenir d’autres copies identiques."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કેટલીક સામગ્રી વાંચી શકાઈ નથી. ન ચકાસેલી આઇટમમાં વધુ સરખી નકલો હોઈ શકે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חלק מהתוכן לא נקרא. ייתכן שבפריטים שלא נבדקו יש עוד עותקים זהים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ सामग्री पढ़ी नहीं जा सकी। बिना जाँचे आइटम में और एक जैसी कॉपी हो सकती हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dio sadržaja nije bilo moguće pročitati. Neprovjerene stavke mogu sadržavati još identičnih kopija."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A tartalom egy része nem olvasható. A nem ellenőrzött elemek további azonos másolatokat tartalmazhatnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebagian konten tidak dapat dibaca. Item yang belum diperiksa mungkin masih berisi salinan identik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile leggere tutti i contenuti. Gli elementi non verificati potrebbero contenere altre copie identiche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部のコンテンツを読み取れませんでした。未確認の項目に同一のコピーが含まれている可能性があります。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕೆಲವು ವಿಷಯವನ್ನು ಓದಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ. ಪರಿಶೀಲಿಸದ ಐಟಂಗಳಲ್ಲಿ ಇನ್ನಷ್ಟು ಒಂದೇ ಪ್ರತಿಗಳಿರಬಹುದು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 콘텐츠를 읽을 수 없었습니다. 확인하지 못한 항목에 동일한 복사본이 더 있을 수 있습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ചില ഉള്ളടക്കം വായിക്കാനായില്ല. പരിശോധിക്കാത്ത ഇനങ്ങളിൽ കൂടുതൽ ഒരുപോലെയുള്ള പകർപ്പുകൾ ഉണ്ടാകാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "काही मजकूर वाचता आला नाही. न तपासलेल्या आयटममध्ये आणखी एकसारख्या प्रती असू शकतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesetengah kandungan tidak dapat dibaca. Item yang belum disemak mungkin mengandungi lebih banyak salinan yang sama."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Noe innhold kunne ikke leses. Ukontrollerte elementer kan inneholde flere identiske kopier."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet alle inhoud kon worden gelezen. Niet-gecontroleerde items kunnen meer identieke kopieën bevatten."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "କିଛି ବିଷୟବସ୍ତୁ ପଢ଼ାଯାଇପାରିଲା ନାହିଁ। ଯାଞ୍ଚ ହୋଇନଥିବା ଆଇଟମ୍‌ରେ ଅଧିକ ସମାନ କପି ଥାଇପାରେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੁਝ ਸਮੱਗਰੀ ਪੜ੍ਹੀ ਨਹੀਂ ਜਾ ਸਕੀ। ਬਿਨਾਂ ਜਾਂਚੀਆਂ ਆਈਟਮਾਂ ਵਿੱਚ ਹੋਰ ਇੱਕੋ ਜਿਹੀਆਂ ਕਾਪੀਆਂ ਹੋ ਸਕਦੀਆਂ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się odczytać całej zawartości. Niesprawdzone elementy mogą zawierać kolejne identyczne kopie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Parte do conteúdo não pôde ser lida. Itens não verificados podem conter mais cópias idênticas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler todo o conteúdo. Os itens não verificados podem conter mais cópias idênticas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O parte din conținut nu a putut fi citită. Elementele neverificate pot conține alte copii identice."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать часть содержимого. Среди непроверенных объектов могут быть другие идентичные копии."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Časť obsahu sa nepodarilo prečítať. Neskontrolované položky môžu obsahovať ďalšie identické kópie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dela vsebine ni bilo mogoče prebrati. Nepreverjeni elementi lahko vsebujejo še več enakih kopij."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En del innehåll kunde inte läsas. Okontrollerade objekt kan innehålla fler identiska kopior."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சில உள்ளடக்கத்தைப் படிக்க முடியவில்லை. சரிபார்க்கப்படாத உருப்படிகளில் மேலும் ஒரே நகல்கள் இருக்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కొంత కంటెంట్‌ను చదవడం సాధ్యం కాలేదు. తనిఖీ చేయని అంశాల్లో మరిన్ని ఒకేలాంటి కాపీలు ఉండవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านเนื้อหาบางส่วนไม่ได้ รายการที่ยังไม่ได้ตรวจอาจมีสำเนาที่เหมือนกันอีก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazı içerikler okunamadı. Denetlenmeyen öğeler başka özdeş kopyalar içerebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Частину вмісту не вдалося прочитати. Неперевірені елементи можуть містити інші ідентичні копії."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کچھ مواد پڑھا نہیں جا سکا۔ غیر جانچے آئٹمز میں مزید یکساں کاپیاں ہو سکتی ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không đọc được một số nội dung. Các mục chưa kiểm tra có thể còn bản sao giống hệt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分内容无法读取。未检查的项目中可能还有其他完全相同的副本。"
          }
        },
        "zh-Hant": {
