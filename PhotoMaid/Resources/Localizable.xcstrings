    "ach_equal_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احتفاظ وسلة المهملات ولاحقًا تُحتسب بالتساوي."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Behold, Papirkurv og Senere tæller lige meget."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behalten, Papierkorb und Später zählen gleich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep, Trash and Later count equally."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservar, Papelera y Después cuentan igual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garder, Corbeille et Plus tard comptent pareil."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan, Sampah, dan Nanti dihitung sama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva, Cestino e Più tardi contano allo stesso modo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「残す」「ゴミ箱」「あとで」は同じように数えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관, 휴지통, 나중에는 똑같이 집계돼요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Behold, Papirkurv og Senere teller likt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaren, Prullenbak en Later tellen even zwaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowaj, Kosz i Później liczą się tak samo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Manter, Lixeira e Depois contam igualmente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Manter, Lixo e Mais tarde contam da mesma forma."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Păstrează, Coș și Mai târziu contează la fel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Оставить», «Корзина» и «Позже» считаются одинаково."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Behåll, Papperskorg och Senare räknas lika."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เก็บไว้ ถังขยะ และไว้ทีหลัง นับเท่ากัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sakla, Çöp kutusu ve Sonra eşit sayılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Залишити», «Кошик» і «Пізніше» рахуються однаково."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ, Thùng rác và Để sau đều được tính như nhau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留、回收站和稍后同样计入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保留、垃圾桶和稍後都同樣計算。"
          }
        }
      }
    },
