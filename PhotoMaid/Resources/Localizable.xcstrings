    "pdf_privacy": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُضمَّن الصور من جديد: لا ينتقل الموقع وبيانات التصوير الأخرى إلى ملف PDF. تبقى الأصول دون تغيير."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos indlejres på ny: lokalitet og andre optagelsesdata kommer ikke med i PDF'en. Originalerne forbliver uændrede."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Fotos werden neu eingebettet: Standort und andere Aufnahmedaten gelangen nicht ins PDF. Die Originale bleiben unverändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos are re-embedded: location and other capture data don’t go into the PDF. The originals stay unchanged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos se vuelven a incrustar: la ubicación y otros datos de captura no pasan al PDF. Los originales no cambian."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos sont réintégrées : la position et les autres données de prise de vue ne vont pas dans le PDF. Les originaux restent inchangés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto disematkan ulang: lokasi dan data pengambilan lainnya tidak masuk ke PDF. Aslinya tidak berubah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le foto vengono reinserite: posizione e altri dati di scatto non finiscono nel PDF. Gli originali restano invariati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真は埋め込み直されるため、位置情報などの撮影データは PDF に含まれません。元の写真は変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진을 새로 넣기 때문에 위치와 기타 촬영 정보는 PDF에 들어가지 않아요. 원본은 그대로예요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildene bygges inn på nytt: sted og andre opptaksdata blir ikke med i PDF-en. Originalene forblir uendret."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto’s worden opnieuw ingesloten: locatie en andere opnamegegevens komen niet in de PDF. De originelen blijven ongewijzigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdjęcia są osadzane na nowo: lokalizacja i inne dane zdjęcia nie trafiają do PDF. Oryginały pozostają bez zmian."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As fotos são incorporadas de novo: localização e outros dados de captura não vão para o PDF. Os originais não são alterados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As fotos são incorporadas de novo: a localização e outros dados da captura não passam para o PDF. Os originais ficam inalterados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografiile sunt încorporate din nou: locația și alte date de captură nu ajung în PDF. Originalele rămân neschimbate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото встраиваются заново: местоположение и другие данные съёмки не попадают в PDF. Оригиналы не меняются."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilderna bäddas in på nytt: plats och andra tagningsdata följer inte med till PDF:en. Originalen förblir oförändrade."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปจะถูกฝังใหม่: ตำแหน่งและข้อมูลการถ่ายอื่นๆ จะไม่อยู่ใน PDF ต้นฉบับไม่เปลี่ยนแปลง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraflar yeniden yerleştirilir: konum ve diğer çekim verileri PDF’e geçmez. Orijinaller değişmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото вбудовуються заново: місце та інші дані зйомки не потрапляють у PDF. Оригінали не змінюються."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh được nhúng lại: vị trí và dữ liệu chụp khác không vào PDF. Bản gốc không thay đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片会重新嵌入：位置及其他拍摄数据不会进入 PDF。原始照片保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "照片會重新嵌入：位置和其他拍攝資料不會放進 PDF。原始檔保持不變。"
          }
        }
      }
    },
