    "movie_kenburns_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقترب الصور ببطء حتى لا تبدو جامدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos zoomen langsam heran, damit sie nicht starr wirken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos zoom in slowly so they don’t look static."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos se acercan despacio para que no parezcan estáticas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos zooment lentement pour ne pas paraître figées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le foto si avvicinano lentamente per non sembrare statiche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真がゆっくりズームし、止まって見えないようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진이 천천히 확대되어 정지된 느낌이 덜해요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto’s zoomen langzaam in, zodat ze niet statisch ogen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdjęcia powoli się przybliżają, żeby nie wyglądały statycznie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As fotografias aproximam-se lentamente para não parecerem estáticas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografiile se apropie lent, ca să nu pară statice."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото медленно приближаются и не выглядят застывшими."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraflar durağan görünmesin diye yavaşça yakınlaşır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото повільно наближаються й не виглядають застиглими."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片缓慢放大，看起来不呆板。"
          }
        }
      }
    },
