    "archive_no_cleanup_provider": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النسخ لدى تطبيق آخر. لا يستطيع GaleriQ معرفة إن كانت آمنة هناك، لذلك لا يعرض إزالة الأصول."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "The copies are with another app. GaleriQ can’t see whether they’re safe there, so it doesn’t offer to remove originals."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kopien liegen bei einer anderen App. Ob sie dort sicher sind, kann GaleriQ nicht sehen – deshalb kein Angebot, Originale zu entfernen."
          }
        },
        "en": {
