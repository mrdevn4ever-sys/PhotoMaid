        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하루 한 번. 추가 혜택은 오늘만 유효해요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Én gang om dagen. Bonusen gjelder bare i dag."
