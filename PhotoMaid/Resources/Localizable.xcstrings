    "collage_res_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الرقم يخص الضلع الأطول. الدقة الأعلى أوضح عند التكبير أو الطباعة، لكن الملف يصبح أكبر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সংখ্যাটি লম্বা দিক। বেশি হলে জুম বা প্রিন্টে বেশি স্পষ্ট দেখায়, তবে ফাইল বড় হয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El número és el costat més llarg. Com més alt, més nítid es veu en ampliar o imprimir, però el fitxer és més gran."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Číslo udává delší stranu. Vyšší vypadá ostřeji při přiblížení nebo tisku, ale soubor je větší."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallet er den længste side. Højere ser skarpere ud, når du zoomer eller udskriver, men filen bliver større."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zahl gilt für die längere Seite. Höher wirkt beim Zoomen und Drucken schärfer, ergibt aber eine größere Datei."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο αριθμός είναι η μεγαλύτερη πλευρά. Υψηλότερο δείχνει πιο καθαρό σε ζουμ ή εκτύπωση, αλλά το αρχείο μεγαλώνει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The number is the longer side. Higher looks sharper when zoomed in or printed, but the file gets larger."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El número es el lado más largo. Una resolución más alta se ve más nítida al ampliar o imprimir, pero el archivo es más grande."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luku on pidempi sivu. Suurempi näyttää terävämmältä zoomatessa tai tulostettuna, mutta tiedosto on suurempi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nombre correspond au côté le plus long. Plus elle est élevée, plus l’image est nette au zoom ou à l’impression, mais le fichier est plus lourd."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સંખ્યા એટલે લાંબી બાજુ. વધુ હોય તો ઝૂમ કે પ્રિન્ટમાં વધુ સ્પષ્ટ દેખાય, પણ ફાઇલ મોટી થાય."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המספר הוא הצלע הארוכה. גבוה יותר נראה חד יותר בהגדלה או בהדפסה, אבל הקובץ גדל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संख्या लंबी भुजा है। ज़्यादा होने पर ज़ूम या प्रिंट में तस्वीर ज़्यादा शार्प दिखती है, लेकिन फ़ाइल बड़ी होती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Broj je dulja stranica. Veće izgleda oštrije pri zumiranju ili ispisu, ali datoteka je veća."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szám a hosszabbik oldal. Nagyobb érték élesebb nagyításkor vagy nyomtatáskor, de nagyobb a fájl."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Angkanya adalah sisi yang lebih panjang. Makin tinggi makin tajam saat di-zoom atau dicetak, tapi file makin besar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il numero indica il lato più lungo. Più è alta, più l’immagine è nitida con lo zoom o in stampa, ma il file è più grande."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "数値は長辺のピクセル数です。高いほど拡大や印刷でくっきりしますが、ファイルは大きくなります。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಂಖ್ಯೆಯು ಉದ್ದದ ಬದಿ. ಹೆಚ್ಚಿದ್ದರೆ ಜೂಮ್ ಅಥವಾ ಮುದ್ರಣದಲ್ಲಿ ಹೆಚ್ಚು ಸ್ಪಷ್ಟ, ಆದರೆ ಫೈಲ್ ದೊಡ್ಡದಾಗುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "숫자는 긴 변의 길이입니다. 높을수록 확대하거나 인쇄할 때 선명하지만 파일이 커집니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സംഖ്യ നീളമുള്ള വശമാണ്. കൂടുതലാണെങ്കിൽ സൂം ചെയ്യുമ്പോഴും പ്രിന്റ് ചെയ്യുമ്പോഴും കൂടുതൽ വ്യക്തമായിരിക്കും, പക്ഷേ ഫയൽ വലുതാകും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "संख्या म्हणजे लांब बाजू. जास्त असल्यास झूम किंवा प्रिंटमध्ये अधिक स्पष्ट दिसते, पण फाइल मोठी होते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombor ialah sisi yang lebih panjang. Lebih tinggi kelihatan lebih tajam apabila dizum atau dicetak, tetapi fail menjadi lebih besar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallet er den lengste siden. Høyere ser skarpere ut ved zoom eller utskrift, men filen blir større."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het getal is de langste zijde. Hoger is scherper bij inzoomen of afdrukken, maar het bestand wordt groter."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସଂଖ୍ୟାଟି ଲମ୍ବା ପାର୍ଶ୍ୱ। ଅଧିକ ହେଲେ ଜୁମ୍ କିମ୍ବା ପ୍ରିଣ୍ଟରେ ଅଧିକ ସ୍ପଷ୍ଟ ଦେଖାଯାଏ, କିନ୍ତୁ ଫାଇଲ୍ ବଡ଼ ହୁଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਅੰਕ ਲੰਬਾ ਪਾਸਾ ਹੈ। ਵੱਧ ਹੋਣ ’ਤੇ ਜ਼ੂਮ ਜਾਂ ਪ੍ਰਿੰਟ ਵਿੱਚ ਵੱਧ ਸਪਸ਼ਟ ਦਿਸਦਾ ਹੈ, ਪਰ ਫ਼ਾਈਲ ਵੱਡੀ ਹੁੰਦੀ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Liczba dotyczy dłuższego boku. Wyższa rozdzielczość wygląda ostrzej po powiększeniu lub wydruku, ale plik jest większy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O número é o lado maior. Mais alto fica mais nítido ao ampliar ou imprimir, mas o arquivo fica maior."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O número refere-se ao lado mais comprido. Uma resolução mais alta fica mais nítida ao ampliar ou imprimir, mas o ficheiro fica maior."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Numărul se referă la latura mai lungă. O rezoluție mai mare arată mai clar la mărire sau tipărire, dar fișierul e mai mare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Число — длина большей стороны. Чем выше, тем чётче при увеличении и печати, но файл больше."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Číslo udáva dlhšiu stranu. Vyššie vyzerá ostrejšie pri priblížení alebo tlači, ale súbor je väčší."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Število je daljša stranica. Višje je ostrejše pri povečavi ali tiskanju, a datoteka je večja."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Talet är den längre sidan. Högre ser skarpare ut vid zoom eller utskrift, men filen blir större."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எண் என்பது நீளமான பக்கம். அதிகமானால் பெரிதாக்கும்போதும் அச்சிடும்போதும் தெளிவாக இருக்கும், ஆனால் கோப்பு பெரிதாகும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సంఖ్య పొడవైన వైపు. ఎక్కువైతే జూమ్ లేదా ప్రింట్‌లో ఎక్కువ స్పష్టంగా ఉంటుంది, కానీ ఫైల్ పెద్దదవుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวเลขคือด้านที่ยาวกว่า ยิ่งสูงยิ่งคมชัดเมื่อซูมหรือพิมพ์ แต่ไฟล์จะใหญ่ขึ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayı uzun kenarı belirtir. Daha yüksek değer yakınlaştırınca ve baskıda daha net görünür, ancak dosya büyür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Число — довжина більшої сторони. Що вище, то чіткіше при збільшенні й друку, але файл більший."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "عدد لمبا کنارہ ہے۔ زیادہ ہونے پر زوم یا پرنٹ میں تصویر زیادہ واضح لگتی ہے، لیکن فائل بڑی ہوتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Con số là cạnh dài hơn. Càng cao càng nét khi phóng to hoặc in, nhưng tệp càng lớn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数字指较长边。越高放大或打印时越清晰，但文件越大。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "數字代表較長的一邊。數值越高，放大或列印時越清晰，但檔案也越大。"
          }
        }
      }
    },
