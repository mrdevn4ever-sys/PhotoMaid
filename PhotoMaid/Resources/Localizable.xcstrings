        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ହୁଏତ ଏହା ଘୁଞ୍ଚାଯାଇଛି କିମ୍ବା ଏପର୍ଯ୍ୟନ୍ତ ସମ୍ପୂର୍ଣ୍ଣ ସେଭ୍ ହୋଇନାହିଁ।"
