        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Find identical copies"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查找相同副本"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Find identical copies"
          }
        }
      }
