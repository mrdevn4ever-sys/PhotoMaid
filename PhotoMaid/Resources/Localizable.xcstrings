    "qa_remove_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُزال الاختصار فقط. تبقى ملفاتك واختياراتك محفوظة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু শর্টকাট সরানো হয়। আপনার ফাইল ও সিদ্ধান্ত থেকে যায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Només es treu la drecera. Els teus fitxers i decisions es mantenen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odebere se jen zkratka. Vaše soubory a rozhodnutí zůstanou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun genvejen fjernes. Dine filer og valg bevares."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur der Schnellzugriff wird entfernt. Dateien und Entscheidungen bleiben erhalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αφαιρείται μόνο η συντόμευση. Τα αρχεία και οι επιλογές σου διατηρούνται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the shortcut is removed. Your files and choices are kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se quita el acceso rápido. Tus archivos y decisiones se conservan."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain oikotie poistetaan. Tiedostosi ja valintasi säilyvät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul le raccourci est retiré. Tes fichiers et tes choix sont conservés."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફક્ત શૉર્ટકટ દૂર થાય છે. તમારી ફાઇલો અને પસંદગીઓ રહે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רק הקיצור מוסר. הקבצים וההחלטות שלך נשמרים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिर्फ़ शॉर्टकट हटता है। आपकी फ़ाइलें और चुनाव बने रहते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uklanja se samo prečac. Tvoje datoteke i odluke ostaju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak a parancsikon törlődik. A fájljaid és döntéseid megmaradnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya pintasan yang dihapus. File dan pilihanmu tetap disimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Viene rimosso solo l’accesso rapido. I file e le tue scelte restano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットだけが外れます。ファイルとこれまでの選択は残ります。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಶಾರ್ಟ್‌ಕಟ್ ಮಾತ್ರ ತೆಗೆದುಹಾಕಲಾಗುತ್ತದೆ. ನಿಮ್ಮ ಫೈಲ್‌ಗಳು ಮತ್ತು ಆಯ್ಕೆಗಳು ಉಳಿಯುತ್ತವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바로가기만 제거해요. 파일과 이전 선택은 그대로 남아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കുറുക്കുവഴി മാത്രം നീക്കം ചെയ്യും. നിങ്ങളുടെ ഫയലുകളും തിരഞ്ഞെടുപ്പുകളും നിലനിൽക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फक्त शॉर्टकट काढला जातो. तुमच्या फाइल्स आणि निवडी राहतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya pintasan dibuang. Fail dan pilihan anda disimpan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare snarveien fjernes. Filene og valgene dine beholdes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen de snelkoppeling wordt verwijderd. Je bestanden en keuzes blijven bewaard."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "କେବଳ ସର୍ଟକଟ୍ ହଟେ। ଆପଣଙ୍କ ଫାଇଲ୍ ଓ ଚୟନ ରହେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਿਰਫ਼ ਸ਼ਾਰਟਕੱਟ ਹਟਦਾ ਹੈ। ਤੁਹਾਡੀਆਂ ਫ਼ਾਈਲਾਂ ਅਤੇ ਚੋਣਾਂ ਰਹਿੰਦੀਆਂ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuwany jest tylko skrót. Pliki i Twoje wybory pozostają zapisane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só o atalho é removido. Seus arquivos e escolhas são mantidos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Só o atalho é removido. Os ficheiros e as tuas escolhas mantêm-se."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Este eliminată doar scurtătura. Fișierele și alegerile tale rămân."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Убирается только ярлык. Файлы и прежние решения остаются."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstráni sa len skratka. Vaše súbory a rozhodnutia zostanú."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstrani se samo bližnjica. Tvoje datoteke in odločitve ostanejo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara genvägen tas bort. Dina filer och val behålls."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "குறுக்குவழி மட்டுமே அகற்றப்படும். உங்கள் கோப்புகளும் தேர்வுகளும் இருக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "షార్ట్‌కట్ మాత్రమే తీసివేయబడుతుంది. మీ ఫైళ్లు, ఎంపికలు అలాగే ఉంటాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบเฉพาะทางลัด ไฟล์และการเลือกของคุณยังคงอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca kısayol kaldırılır. Dosyaların ve seçimlerin korunur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прибирається лише ярлик. Файли й попередні рішення залишаються."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف شارٹ کٹ ہٹتا ہے۔ آپ کی فائلیں اور انتخاب برقرار رہتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ lối tắt bị xóa. Tệp và lựa chọn của bạn vẫn được giữ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只会移除快捷入口，文件和之前的选择都会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只會移除捷徑。你的檔案和選擇都會保留。"
          }
        }
      }
    },
