    "movie_quality_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عالية ومتوازنة: حتى Full HD (1080p) – المتوازنة تعطي ملفات أصغر بفرق بالكاد يُرى. صغيرة: حتى HD (720p)، أصغر ملف، مناسبة للإرسال."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "উচ্চ ও সুষম: Full HD (1080p) পর্যন্ত – সুষম প্রায় দৃশ্যমান পার্থক্য ছাড়াই ছোট ফাইল তৈরি করে। ছোট: HD (720p) পর্যন্ত, সবচেয়ে ছোট ফাইল, পাঠানোর জন্য ভালো।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Alta i Equilibrada: fins a Full HD (1080p). Equilibrada fa fitxers més petits gairebé sense diferència visible. Petita: fins a HD (720p), el fitxer més petit, bo per enviar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vysoká a Vyvážená: až Full HD (1080p) – Vyvážená vytváří menší soubory téměř bez viditelného rozdílu. Malá: až HD (720p), nejmenší soubor, vhodný k odesílání."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Høj og Balanceret: op til Full HD (1080p) – Balanceret giver mindre filer med næsten ingen synlig forskel. Lille: op til HD (720p), den mindste fil, god til at sende."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoch und Ausgewogen: bis Full HD (1080p) – Ausgewogen spart Speicher, der Unterschied ist kaum zu sehen. Klein: bis HD (720p), kleinste Datei, gut zum Verschicken."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Υψηλή και Ισορροπημένη: έως Full HD (1080p) – η Ισορροπημένη κάνει μικρότερα αρχεία σχεδόν χωρίς ορατή διαφορά. Μικρή: έως HD (720p), το μικρότερο αρχείο, καλό για αποστολή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "High and Balanced: up to Full HD (1080p) – Balanced makes smaller files with hardly any visible difference. Small: up to HD (720p), the smallest file, good for sending."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alta y Equilibrada: hasta Full HD (1080p); Equilibrada ocupa menos con una diferencia apenas visible. Pequeña: hasta HD (720p), el archivo más pequeño, ideal para enviar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Korkea ja Tasapainoinen: enintään Full HD (1080p) – Tasapainoinen tekee pienempiä tiedostoja lähes ilman näkyvää eroa. Pieni: enintään HD (720p), pienin tiedosto, hyvä lähettämiseen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Haute et Équilibrée : jusqu’à Full HD (1080p) – Équilibrée produit des fichiers plus légers, différence à peine visible. Petite : jusqu’à HD (720p), le fichier le plus léger, idéal pour l’envoi."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઊંચી અને સંતુલિત: Full HD (1080p) સુધી – સંતુલિત લગભગ ન દેખાતા ફરક સાથે નાની ફાઇલો બનાવે છે. નાની: HD (720p) સુધી, સૌથી નાની ફાઇલ, મોકલવા માટે સારી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גבוהה ומאוזנת: עד Full HD (1080p) – מאוזנת יוצרת קבצים קטנים יותר כמעט בלי הבדל נראה. קטנה: עד HD (720p), הקובץ הקטן ביותר, טוב לשליחה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऊँची और संतुलित: Full HD (1080p) तक – संतुलित लगभग बिना दिखने वाले अंतर के छोटी फ़ाइलें बनाती है। छोटी: HD (720p) तक, सबसे छोटी फ़ाइल, भेजने के लिए अच्छी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Visoka i Uravnoteženo: do Full HD (1080p) – Uravnoteženo daje manje datoteke gotovo bez vidljive razlike. Mala: do HD (720p), najmanja datoteka, dobra za slanje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Magas és Kiegyensúlyozott: legfeljebb Full HD (1080p) – a Kiegyensúlyozott kisebb fájlokat készít szinte látható különbség nélkül. Kicsi: legfeljebb HD (720p), a legkisebb fájl, küldéshez ideális."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinggi dan Seimbang: hingga Full HD (1080p) – Seimbang menghasilkan file lebih kecil dengan perbedaan yang hampir tak terlihat. Kecil: hingga HD (720p), file terkecil, cocok untuk dikirim."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alta e Bilanciata: fino a Full HD (1080p); Bilanciata crea file più piccoli con una differenza appena visibile. Piccola: fino a HD (720p), il file più piccolo, ideale da inviare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高とバランス：最大フルHD（1080p）。バランスは見た目の差がほとんどなく、ファイルが小さくなります。小：最大HD（720p）、最小のファイルで送信向きです。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಹೆಚ್ಚು ಮತ್ತು ಸಮತೋಲಿತ: Full HD (1080p) ವರೆಗೆ – ಸಮತೋಲಿತವು ಕಾಣುವ ವ್ಯತ್ಯಾಸವಿಲ್ಲದೆ ಚಿಕ್ಕ ಫೈಲ್‌ಗಳನ್ನು ಮಾಡುತ್ತದೆ. ಚಿಕ್ಕದು: HD (720p) ವರೆಗೆ, ಅತಿ ಚಿಕ್ಕ ಫೈಲ್, ಕಳುಹಿಸಲು ಉತ್ತಮ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "높음과 균형: 최대 풀 HD(1080p) – 균형은 차이가 거의 보이지 않으면서 파일이 작아요. 작게: 최대 HD(720p), 가장 작은 파일로 보내기에 좋아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഉയർന്നതും സന്തുലിതവും: Full HD (1080p) വരെ – സന്തുലിതം കാര്യമായ വ്യത്യാസമില്ലാതെ ചെറിയ ഫയലുകൾ ഉണ്ടാക്കുന്നു. ചെറുത്: HD (720p) വരെ, ഏറ്റവും ചെറിയ ഫയൽ, അയയ്ക്കാൻ നല്ലത്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "उच्च आणि संतुलित: Full HD (1080p) पर्यंत – संतुलित जवळजवळ न दिसणाऱ्या फरकासह लहान फाइल्स बनवते. लहान: HD (720p) पर्यंत, सर्वात लहान फाइल, पाठवण्यासाठी चांगली."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinggi dan Seimbang: sehingga Full HD (1080p) – Seimbang menghasilkan fail lebih kecil dengan hampir tiada perbezaan ketara. Kecil: sehingga HD (720p), fail terkecil, sesuai untuk dihantar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Høy og Balansert: opptil Full HD (1080p) – Balansert gir mindre filer med knapt synlig forskjell. Liten: opptil HD (720p), den minste filen, fin for sending."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoog en Gebalanceerd: tot Full HD (1080p) – Gebalanceerd geeft kleinere bestanden met nauwelijks zichtbaar verschil. Klein: tot HD (720p), het kleinste bestand, handig om te versturen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଉଚ୍ଚ ଓ ସନ୍ତୁଳିତ: Full HD (1080p) ପର୍ଯ୍ୟନ୍ତ – ସନ୍ତୁଳିତ ପ୍ରାୟ ଦୃଶ୍ୟମାନ ପାର୍ଥକ୍ୟ ବିନା ଛୋଟ ଫାଇଲ୍ ତିଆରି କରେ। ଛୋଟ: HD (720p) ପର୍ଯ୍ୟନ୍ତ, ସବୁଠାରୁ ଛୋଟ ଫାଇଲ୍, ପଠାଇବା ପାଇଁ ଭଲ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਉੱਚ ਅਤੇ ਸੰਤੁਲਿਤ: Full HD (1080p) ਤੱਕ – ਸੰਤੁਲਿਤ ਛੋਟੀਆਂ ਫ਼ਾਈਲਾਂ ਬਣਾਉਂਦਾ ਹੈ, ਜਿਨ੍ਹਾਂ ਵਿੱਚ ਮੁਸ਼ਕਲ ਨਾਲ ਹੀ ਕੋਈ ਫ਼ਰਕ ਦਿਸਦਾ ਹੈ। ਛੋਟਾ: HD (720p) ਤੱਕ, ਸਭ ਤੋਂ ਛੋਟੀ ਫ਼ਾਈਲ, ਭੇਜਣ ਲਈ ਵਧੀਆ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysoka i Zrównoważona: do Full HD (1080p) – Zrównoważona daje mniejsze pliki przy ledwo widocznej różnicy. Mała: do HD (720p), najmniejszy plik, dobry do wysyłania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alta e Equilibrada: até Full HD (1080p) – Equilibrada gera arquivos menores quase sem diferença visível. Pequena: até HD (720p), o menor arquivo, bom para enviar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Alta e Equilibrada: até Full HD (1080p) – Equilibrada cria ficheiros mais pequenos com uma diferença quase invisível. Pequena: até HD (720p), o ficheiro mais pequeno, bom para enviar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înaltă și Echilibrată: până la Full HD (1080p) – Echilibrată face fișiere mai mici, cu o diferență abia vizibilă. Mică: până la HD (720p), cel mai mic fișier, bun de trimis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Высокое и Сбалансированное: до Full HD (1080p) – Сбалансированное даёт файлы меньше почти без видимой разницы. Маленькое: до HD (720p), самый маленький файл, удобно для отправки."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vysoká a Vyvážená: až Full HD (1080p) – Vyvážená vytvára menšie súbory takmer bez viditeľného rozdielu. Malá: až HD (720p), najmenší súbor, vhodný na odosielanie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Visoka in Uravnoteženo: do Full HD (1080p) – Uravnoteženo ustvari manjše datoteke skoraj brez vidne razlike. Majhna: do HD (720p), najmanjša datoteka, primerna za pošiljanje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hög och Balanserad: upp till Full HD (1080p) – Balanserad ger mindre filer med knappt synlig skillnad. Liten: upp till HD (720p), minsta filen, bra för att skicka."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உயர் மற்றும் சமநிலை: Full HD (1080p) வரை – சமநிலை கண்ணுக்குத் தெரியாத வேறுபாட்டுடன் சிறிய கோப்புகளை உருவாக்கும். சிறியது: HD (720p) வரை, மிகச் சிறிய கோப்பு, அனுப்ப ஏற்றது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అధికం, సమతుల్యం: Full HD (1080p) వరకు – సమతుల్యం దాదాపు కనిపించని తేడాతో చిన్న ఫైళ్లు చేస్తుంది. చిన్నది: HD (720p) వరకు, అతి చిన్న ఫైల్, పంపడానికి మంచిది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สูงและสมดุล: สูงสุด Full HD (1080p) – สมดุลให้ไฟล์เล็กกว่าโดยแทบไม่เห็นความต่าง เล็ก: สูงสุด HD (720p) ไฟล์เล็กที่สุด เหมาะสำหรับส่ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüksek ve Dengeli: Full HD’ye (1080p) kadar – Dengeli, farkı neredeyse görünmeyen daha küçük dosyalar oluşturur. Küçük: HD’ye (720p) kadar, en küçük dosya, göndermek için ideal."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Висока й Збалансована: до Full HD (1080p) – Збалансована дає менші файли майже без помітної різниці. Мала: до HD (720p), найменший файл, зручно надсилати."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اعلیٰ اور متوازن: Full HD (1080p) تک – متوازن تقریباً بغیر نظر آنے والے فرق کے چھوٹی فائلیں بناتی ہے۔ چھوٹی: HD (720p) تک، سب سے چھوٹی فائل، بھیجنے کے لیے اچھی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cao và Cân bằng: tối đa Full HD (1080p) – Cân bằng tạo tệp nhỏ hơn mà gần như không thấy khác biệt. Nhỏ: tối đa HD (720p), tệp nhỏ nhất, phù hợp để gửi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高和均衡：最高全高清 (1080p)——均衡的文件更小，几乎看不出差别。小：最高高清 (720p)，文件最小，适合发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "高和平衡：最高 Full HD（1080p）– 平衡會產生較小的檔案，幾乎看不出差別。小：最高 HD（720p），檔案最小，適合傳送。"
          }
        }
      }
    },
