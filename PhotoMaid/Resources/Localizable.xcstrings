    "tour_today_hero_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط «ابدأ التنظيف» لتراجع بالسحب كل ما تبقى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Tipp auf „Jetzt aufräumen“ und du wischst durch alles, was noch offen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap “Start cleaning up” to swipe through everything left to review."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca «Empezar a limpiar» para revisar todo lo que queda pendiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche « Commencer le tri » pour parcourir tout ce qu’il reste à voir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca «Inizia a riordinare» per scorrere tutto ciò che resta da controllare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「整理を始める」をタップして、まだ確認していないものをスワイプしましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘정리 시작’을 눌러 아직 확인하지 않은 항목을 하나씩 넘겨 보세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op ‘Begin met opruimen’ om door alles te vegen wat nog bekeken moet worden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotknij „Zacznij porządki”, aby przejrzeć wszystko, co jeszcze zostało."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca em «Começar a limpar» para percorrer tudo o que falta rever."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge „Începe curățenia” ca să treci prin tot ce a mai rămas de verificat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажми «Начать уборку», чтобы просмотреть всё, что ещё осталось."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İncelenecek her şeyi kaydırarak görmek için “Temizliğe başla” seçeneğine dokun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисни «Почати прибирання», щоб переглянути все, що ще залишилося."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击“开始清理”，滑动查看尚未处理的内容。"
          }
        }
      }
    },
    "tour_today_hero_title": {
      "extractionState": "manual",
      "localizations": {
