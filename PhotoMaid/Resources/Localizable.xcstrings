    "excl_intro": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مجلدات لا تريد ترتيبها، مثل مستندات العمل أو صور العائلة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordner, die du nicht aufräumen möchtest, zum Beispiel Arbeitsdokumente oder Familienfotos."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Folders you don’t want to clean up, for example work documents or family photos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Carpetas que no quieres ordenar, por ejemplo documentos de trabajo o fotos familiares."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dossiers que tu ne veux pas trier, par exemple des documents de travail ou des photos de famille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cartelle che non vuoi riordinare, ad esempio documenti di lavoro o foto di famiglia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "整理したくないフォルダ（仕事の書類や家族の写真など）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정리하고 싶지 않은 폴더예요. 예를 들어 업무 문서나 가족 사진이요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mappen die je niet wilt opruimen, bijvoorbeeld werkdocumenten of familiefoto’s."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Foldery, których nie chcesz porządkować, np. dokumenty służbowe albo zdjęcia rodzinne."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastas que não queres arrumar, por exemplo documentos de trabalho ou fotos de família."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosare pe care nu vrei să le ordonezi, de exemplu documente de lucru sau fotografii de familie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Папки, которые не нужно разбирать, например рабочие документы или семейные фото."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düzenlemek istemediğin klasörler, örneğin iş belgeleri veya aile fotoğrafları."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Папки, які не потрібно упорядковувати, наприклад робочі документи чи сімейні фото."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你不想整理的文件夹，例如工作文档或家庭照片。"
          }
        }
      }
    },
