    "folder_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى الصورة في مكانها وتظهر أيضًا في الألبوم – في تطبيق الصور كذلك، ومع صور iCloud على أجهزتك الأخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফটোটি যেখানে আছে সেখানেই থাকে এবং অ্যালবামেও দেখা যায় – ফটো অ্যাপেও এবং iCloud ফটো চালু থাকলে আপনার অন্য ডিভাইসেও।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La foto es queda on és i també apareix a l’àlbum, a l’app Fotos i, amb Fotos d’iCloud, als teus altres dispositius."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotka zůstane, kde je, a objeví se i v albu – také v aplikaci Fotky a s Fotkami na iCloudu i na vašich dalších zařízeních."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoet bliver, hvor det er, og vises også i albummet – også i appen Fotos og, med iCloud-fotos, på dine andre enheder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Foto bleibt, wo es ist, und erscheint zusätzlich im Album – auch in der Fotos-App und mit iCloud-Fotos auf deinen anderen Geräten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η φωτογραφία μένει εκεί που είναι και εμφανίζεται και στο άλμπουμ – και στις Φωτογραφίες και, με τις Φωτογραφίες iCloud, στις άλλες συσκευές σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The photo stays where it is and also appears in the album – in the Photos app too and, with iCloud Photos, on your other devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La foto se queda donde está y aparece además en el álbum, también en la app Fotos y, con Fotos de iCloud, en tus otros dispositivos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuva pysyy paikallaan ja näkyy myös albumissa – myös Kuvat-apissa ja iCloud-kuvien kanssa muilla laitteillasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La photo reste où elle est et apparaît aussi dans l’album – dans l’app Photos et, avec Photos iCloud, sur vos autres appareils."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફોટો તેની જગ્યાએ રહે છે અને આલ્બમમાં પણ દેખાય છે – ફોટો ઍપમાં પણ, અને iCloud ફોટો સાથે તમારાં બીજાં ઉપકરણો પર પણ."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התמונה נשארת במקומה ומופיעה גם באלבום – גם ביישום ״תמונות״ ועם ״תמונות iCloud״ גם במכשירים האחרים שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोटो अपनी जगह रहती है और एल्बम में भी दिखती है – तस्वीरें ऐप में भी, और iCloud तस्वीरें के साथ आपके दूसरे डिवाइस पर भी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografija ostaje gdje jest i pojavljuje se i u albumu – i u aplikaciji Fotografije te, uz iCloud fotografije, na tvojim drugim uređajima."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fotó a helyén marad, és az albumban is megjelenik – a Fotók appban is, iCloud-fotókkal pedig a többi eszközödön is."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto tetap di tempatnya dan juga muncul di album – di app Foto juga dan, dengan Foto iCloud, di perangkatmu yang lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La foto resta dov’è e compare anche nell’album, anche nell’app Foto e, con Foto di iCloud, sugli altri tuoi dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真はそのままの場所に残り、アルバムにも表示されます。写真アプリでも、iCloud写真なら他のデバイスでも表示されます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಫೋಟೋ ಇರುವಲ್ಲೇ ಉಳಿಯುತ್ತದೆ ಮತ್ತು ಆಲ್ಬಮ್‌ನಲ್ಲೂ ಕಾಣಿಸುತ್ತದೆ – ಫೋಟೋಗಳು ಆ್ಯಪ್‌ನಲ್ಲೂ ಮತ್ತು iCloud ಫೋಟೋಗಳೊಂದಿಗೆ ನಿಮ್ಮ ಇತರ ಸಾಧನಗಳಲ್ಲೂ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진은 그대로 있고 앨범에도 표시됩니다. 사진 앱에서도, iCloud 사진을 사용하면 다른 기기에서도 보입니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഫോട്ടോ എവിടെയാണോ അവിടെത്തന്നെ തുടരുകയും ആൽബത്തിലും ദൃശ്യമാകുകയും ചെയ്യും – ഫോട്ടോസ് ആപ്പിലും, iCloud ഫോട്ടോസ് ഉണ്ടെങ്കിൽ നിങ്ങളുടെ മറ്റ് ഉപകരണങ്ങളിലും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फोटो जागीच राहतो आणि अल्बममध्येही दिसतो – फोटो अ‍ॅपमध्येही, आणि iCloud फोटोसह तुमच्या इतर डिव्हाइसवरही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto kekal di tempatnya dan juga muncul dalam album – dalam app Foto juga dan, dengan Foto iCloud, pada peranti anda yang lain."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildet blir der det er og vises også i albumet – også i Bilder-appen og, med iCloud-bilder, på de andre enhetene dine."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De foto blijft waar hij is en verschijnt ook in het album – ook in de Foto’s-app en met iCloud-foto’s op je andere apparaten."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଫଟୋଟି ଯେଉଁଠି ଅଛି ସେଠାରେ ହିଁ ରହେ ଏବଂ ଆଲବମ୍‌ରେ ମଧ୍ୟ ଦେଖାଯାଏ – ଫଟୋ ଆପ୍‌ରେ ମଧ୍ୟ ଏବଂ iCloud ଫଟୋ ସହ ଆପଣଙ୍କ ଅନ୍ୟ ଡିଭାଇସ୍‌ରେ ମଧ୍ୟ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਫ਼ੋਟੋ ਜਿੱਥੇ ਹੈ ਉੱਥੇ ਹੀ ਰਹਿੰਦੀ ਹੈ ਅਤੇ ਐਲਬਮ ਵਿੱਚ ਵੀ ਦਿਸਦੀ ਹੈ – ਫ਼ੋਟੋਆਂ ਐਪ ਵਿੱਚ ਵੀ ਅਤੇ, iCloud ਫ਼ੋਟੋਆਂ ਨਾਲ, ਤੁਹਾਡੇ ਹੋਰ ਡਿਵਾਈਸਾਂ ਉੱਤੇ ਵੀ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdjęcie zostaje na swoim miejscu i pojawia się też w albumie – również w aplikacji Zdjęcia, a przy Zdjęciach iCloud na innych urządzeniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A foto fica onde está e também aparece no álbum – no app Fotos também e, com as Fotos do iCloud, nos seus outros aparelhos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A fotografia fica onde está e aparece também no álbum – na app Fotografias e, com Fotografias em iCloud, nos seus outros dispositivos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Poza rămâne unde este și apare și în album – inclusiv în aplicația Poze și, cu Poze iCloud, pe celelalte dispozitive."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото остаётся на месте и появляется ещё и в альбоме — в приложении «Фото» и, с Фото iCloud, на других ваших устройствах."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotka zostane, kde je, a objaví sa aj v albume – aj v aplikácii Fotky a s Fotkami na iCloude aj na vašich ďalších zariadeniach."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografija ostane, kjer je, in se prikaže tudi v albumu – tudi v aplikaciji Fotografije in s Fotografijami iCloud na tvojih drugih napravah."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilden stannar där den är och visas även i albumet – även i appen Bilder och, med iCloud-bilder, på dina andra enheter."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "புகைப்படம் இருக்கும் இடத்திலேயே இருக்கும், ஆல்பத்திலும் தோன்றும் – Photos ஆப்பிலும், iCloud புகைப்படங்களுடன் உங்கள் மற்ற சாதனங்களிலும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫోటో ఉన్న చోటే ఉంటుంది, ఆల్బమ్‌లో కూడా కనిపిస్తుంది – Photos యాప్‌లో కూడా, iCloud ఫోటోలతో మీ ఇతర పరికరాల్లో కూడా."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปยังอยู่ที่เดิมและปรากฏในอัลบั้มด้วย – ในแอพรูปภาพเช่นกัน และบนอุปกรณ์อื่นของคุณหากใช้รูปภาพ iCloud"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraf olduğu yerde kalır ve albümde de görünür – Fotoğraflar uygulamasında ve iCloud Fotoğrafları ile diğer aygıtlarında da."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото лишається на місці й з’являється також в альбомі — у програмі «Фото» і, з Фото iCloud, на інших ваших пристроях."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تصویر اپنی جگہ رہتی ہے اور البم میں بھی دکھتی ہے – تصاویر ایپ میں بھی، اور iCloud تصاویر کے ساتھ آپ کی دوسری ڈیوائسز پر بھی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh vẫn ở nguyên chỗ và đồng thời xuất hiện trong album – cả trong ứng dụng Ảnh và, với Ảnh iCloud, trên các thiết bị khác của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片保留在原处，同时出现在相簿中——在“照片”App 中，以及开启 iCloud 照片时在你的其他设备上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "照片會留在原處，同時出現在相簿中 – 包括「照片」App，若開啟「iCloud 照片」，也會出現在你的其他裝置上。"
          }
        }
      }
    },
