    "files_none_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر مجلدًا لمراجعة ملفاته في GaleriQ."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg en mappe for at gennemgå dens filer i GaleriQ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Ordner aus, um seine Dateien in GaleriQ durchzusehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a folder to review its files in GaleriQ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una carpeta para revisar sus archivos en GaleriQ."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis un dossier pour passer ses fichiers en revue dans GaleriQ."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih folder untuk meninjau file-nya di GaleriQ."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una cartella per controllarne i file in GaleriQ."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダを選ぶと、中のファイルをGaleriQで確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더를 선택하면 GaleriQ에서 그 안의 파일을 확인할 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg en mappe for å gå gjennom filene i den i GaleriQ."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een map om de bestanden in GaleriQ te bekijken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz folder, aby przejrzeć jego pliki w GaleriQ."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma pasta para revisar os arquivos dela no GaleriQ."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe uma pasta para reveres os respetivos ficheiros no GaleriQ."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege un dosar pentru a-i verifica fișierele în GaleriQ."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбери папку, чтобы просмотреть её файлы в GaleriQ."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj en mapp för att gå igenom dess filer i GaleriQ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกโฟลเดอร์เพื่อตรวจดูไฟล์ใน GaleriQ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyalarını GaleriQ içinde incelemek için bir klasör seç."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибери папку, щоб переглянути її файли в GaleriQ."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn một thư mục để xem lại các tệp trong GaleriQ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一个文件夹，即可在 GaleriQ 中查看里面的文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇一個檔案夾，在 GaleriQ 中整理其中的檔案。"
          }
        }
      }
    },
    "files_none_tip": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن اختيار مجلد التنزيلات نفسه هنا. اختر مجلدًا فرعيًا داخله بدلًا منه."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "The Downloads folder can’t be selected here. Choose a subfolder inside it instead."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Download-Ordner lässt sich hier nicht auswählen. Wähle stattdessen einen Unterordner darin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Downloads folder can’t be selected here. Choose a subfolder inside it instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No puedes seleccionar la carpeta Descargas aquí. Elige una subcarpeta dentro de ella."
