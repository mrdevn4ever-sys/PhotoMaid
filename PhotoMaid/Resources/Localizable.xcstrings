    "tour_history_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هنا ترى ما احتفظت به أو استبعدته أو أجّلته. يمكنك تغيير أي قرار من هنا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Se, hvad du har beholdt, lagt til side eller gemt til senere. Du kan stadig ændre enhver beslutning her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier siehst du, was du behalten, aussortiert oder auf später gelegt hast. Jede Entscheidung kannst du hier noch ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See what you kept, set aside or saved for later. You can still change any decision here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí ves lo que has conservado, apartado o dejado para después. Puedes cambiar cualquier decisión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyez ce que vous avez gardé, écarté ou remis à plus tard. Vous pouvez encore changer chaque décision ici."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihat apa yang kamu simpan, sisihkan, atau tunda untuk nanti. Kamu masih bisa mengubah keputusan apa pun di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui vedi cosa hai tenuto, scartato o rimandato. Puoi ancora cambiare ogni decisione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残したもの、外したもの、あとで見るものを確認できます。どの判断もここで変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관한 것, 골라낸 것, 나중에 볼 것을 확인할 수 있어요. 여기서 모든 결정을 바꿀 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Se hva du har beholdt, lagt til side eller lagret til senere. Du kan fortsatt endre alle beslutninger her."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zie wat je hebt bewaard, apart gezet of voor later bewaard. Elke keuze kun je hier nog aanpassen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobacz, co zachowujesz, odkładasz lub zostawiasz na później. Każdą decyzję możesz tu jeszcze zmienić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja o que você manteve, separou ou guardou para depois. Você ainda pode mudar qualquer decisão aqui."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja o que manteve, pôs de lado ou deixou para mais tarde. Pode ainda alterar qualquer decisão aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vezi ce ai păstrat, ai pus deoparte sau ai lăsat pe mai târziu. Poți schimba aici orice decizie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь видно, что вы оставили, отложили в сторону или на потом. Любое решение можно изменить."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Se vad du har behållit, lagt undan eller sparat till senare. Du kan fortfarande ändra alla beslut här."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูสิ่งที่คุณเก็บไว้ แยกไว้ หรือบันทึกไว้ทีหลัง คุณยังเปลี่ยนการตัดสินใจใดก็ได้ที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neyi tuttuğunu, ayırdığını veya sonraya bıraktığını burada görürsün. Her kararı burada değiştirebilirsin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут видно, що ви залишили, відклали вбік чи на потім. Будь-яке рішення можна змінити."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem những gì bạn đã giữ, để riêng hoặc để sau. Bạn vẫn có thể thay đổi mọi quyết định ở đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这里查看你保留、挑出或留到稍后的内容。任何决定都可以在这里更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "查看你保留、擱置或存為稍後的內容。你仍可以在這裡更改任何決定。"
          }
        }
      }
    },
