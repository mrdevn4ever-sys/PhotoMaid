    "done_partial": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى العناصر التي لم تُزل في سلة مهملات GaleriQ."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যে আইটেমগুলো সরানো হয়নি, সেগুলো GaleriQ ট্র্যাশে থাকে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els elements que no s’han eliminat es queden a la paperera de GaleriQ."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Položky, které nebyly odstraněny, zůstávají v koši GaleriQ."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Emner, der ikke blev fjernet, bliver i GaleriQ-papirkurven."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht entfernte Elemente bleiben im GaleriQ-Papierkorb."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα στοιχεία που δεν αφαιρέθηκαν μένουν στον κάδο του GaleriQ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Items that weren’t removed stay in the GaleriQ trash."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los elementos que no se han quitado siguen en la papelera de GaleriQ."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kohteet, joita ei poistettu, jäävät GaleriQ-roskakoriin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les éléments non retirés restent dans la corbeille GaleriQ."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જે આઇટમ દૂર ન થઈ તે GaleriQ ટ્રેશમાં રહે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פריטים שלא הוסרו נשארים בפח של GaleriQ."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जो आइटम नहीं हटे, वे GaleriQ ट्रैश में रहते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stavke koje nisu uklonjene ostaju u GaleriQ smeću."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az el nem távolított elemek a GaleriQ kukájában maradnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Item yang tidak dihapus tetap di sampah GaleriQ."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli elementi non rimossi restano nel cestino di GaleriQ."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除できなかったものは、GaleriQのゴミ箱に残ります。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ತೆಗೆದುಹಾಕದ ಐಟಂಗಳು GaleriQ ಕಸದ ಬುಟ್ಟಿಯಲ್ಲೇ ಉಳಿಯುತ್ತವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제되지 않은 항목은 GaleriQ 휴지통에 남아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നീക്കം ചെയ്യാത്ത ഇനങ്ങൾ GaleriQ ട്രാഷിൽ തുടരും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "जे आयटम काढले गेले नाहीत ते GaleriQ ट्रॅशमध्ये राहतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Item yang tidak dibuang kekal dalam sampah GaleriQ."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Elementer som ikke ble fjernet, blir i GaleriQ-papirkurven."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet-verwijderde items blijven in de GaleriQ-prullenbak."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଯେଉଁ ଆଇଟମ୍ ହଟାଯାଇନାହିଁ, ସେଗୁଡ଼ିକ GaleriQ ଟ୍ରାସରେ ରହେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜੋ ਆਈਟਮਾਂ ਨਹੀਂ ਹਟੀਆਂ, ਉਹ GaleriQ ਰੱਦੀ ਵਿੱਚ ਰਹਿੰਦੀਆਂ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieusunięte elementy pozostają w koszu GaleriQ."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os itens que não foram removidos continuam na lixeira do GaleriQ."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os itens que não foram removidos continuam no lixo do GaleriQ."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Elementele care nu au fost eliminate rămân în coșul GaleriQ."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неудалённые элементы остаются в корзине GaleriQ."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Položky, ktoré neboli odstránené, zostávajú v koši GaleriQ."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elementi, ki niso bili odstranjeni, ostanejo v košu GaleriQ."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Objekt som inte togs bort stannar i GaleriQ-papperskorgen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அகற்றப்படாத உருப்படிகள் GaleriQ குப்பையில் இருக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "తీసివేయని అంశాలు GaleriQ ట్రాష్‌లోనే ఉంటాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการที่ไม่ได้นำออกยังอยู่ในถังขยะ GaleriQ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaldırılmayan öğeler GaleriQ çöp kutusunda kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Невидалені елементи залишаються в кошику GaleriQ."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جو آئٹمز نہیں ہٹے، وہ GaleriQ ردی میں رہتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các mục chưa xóa vẫn ở trong thùng rác GaleriQ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能移除的内容会留在 GaleriQ 回收站中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未移除的項目會留在 GaleriQ 垃圾桶中。"
          }
