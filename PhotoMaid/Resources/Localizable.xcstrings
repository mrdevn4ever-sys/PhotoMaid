    "archive_kind_device": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا المجلد على نفس مساحة التخزين التي تحتوي على صورك. لن تفيد نسخة ثانية هناك إذا ضاع هاتفك أو تعطل."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne mappe ligger på samme lager som dine fotos. En ekstra kopi her hjælper ikke, hvis telefonen bliver væk eller går i stykker."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Ordner liegt auf demselben Speicher wie deine Fotos. Eine zweite Kopie dort hilft nicht, wenn das Handy verloren geht oder kaputtgeht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This folder is on the same storage as your photos. A second copy there won’t help if your phone is lost or breaks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta carpeta está en el mismo almacenamiento que tus fotos. Una segunda copia ahí no sirve si pierdes el móvil o se estropea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce dossier se trouve sur le même stockage que vos photos. Une deuxième copie à cet endroit n’aide pas si le téléphone est perdu ou cassé."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder ini ada di penyimpanan yang sama dengan fotomu. Salinan kedua di sana tidak membantu jika ponselmu hilang atau rusak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa cartella si trova sulla stessa memoria delle tue foto. Una seconda copia lì non aiuta se il telefono si perde o si rompe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフォルダーは写真と同じストレージにあります。そこに2つ目のコピーがあっても、スマホをなくしたり壊れたりしたときには役に立ちません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 폴더는 사진과 같은 저장 공간에 있어요. 휴대폰을 잃어버리거나 고장 나면 그곳의 두 번째 사본은 도움이 되지 않아요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne mappen ligger på samme lagring som bildene dine. En ekstra kopi der hjelper ikke hvis telefonen blir borte eller går i stykker."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze map staat op dezelfde opslag als je foto’s. Een tweede kopie daar helpt niet als je telefoon kwijtraakt of kapotgaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten folder jest w tej samej pamięci co Twoje zdjęcia. Druga kopia w tym miejscu nie pomoże, jeśli telefon zginie lub się zepsuje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta pasta está no mesmo armazenamento que suas fotos. Uma segunda cópia ali não ajuda se o celular for perdido ou quebrar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta pasta está no mesmo armazenamento que as suas fotos. Uma segunda cópia aí não ajuda se o telemóvel se perder ou avariar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest dosar este pe aceeași memorie ca fotografiile tale. O a doua copie acolo nu ajută dacă telefonul se pierde sau se strică."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта папка находится в той же памяти, что и ваши фото. Вторая копия там не поможет, если телефон потеряется или сломается."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här mappen ligger på samma lagring som dina bilder. En andra kopia där hjälper inte om telefonen försvinner eller går sönder."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โฟลเดอร์นี้อยู่ในพื้นที่จัดเก็บเดียวกับรูปภาพของคุณ สำเนาชุดที่สองที่นี่จะไม่ช่วยอะไรหากโทรศัพท์หายหรือเสีย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu klasör fotoğraflarınla aynı depolama alanında. Telefon kaybolursa veya bozulursa oradaki ikinci kopya işe yaramaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця папка в тій самій пам’яті, що й ваші фото. Друга копія там не допоможе, якщо телефон загубиться чи зламається."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thư mục này nằm trên cùng bộ nhớ với ảnh của bạn. Bản sao thứ hai ở đó sẽ không giúp được nếu điện thoại bị mất hoặc hỏng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件夹与照片位于同一存储空间。手机丢失或损坏时，那里的第二份副本帮不上忙。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個檔案夾和你的照片在同一個儲存空間。如果手機遺失或損壞，放在這裡的第二份副本沒有幫助。"
          }
        }
      }
    },
    "archive_kind_provider": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينتمي هذا المجلد إلى تطبيق آخر، مثل خدمة تخزين عبر الإنترنت. هذا التطبيق هو من يقرر إن كانت الملفات تبقى على الهاتف أو تُرفع إلى الإنترنت."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne mappe tilhører en anden app, f.eks. en onlinelagringstjeneste. Den app bestemmer, om filerne bliver på telefonen eller kommer online."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Ordner gehört zu einer anderen App, zum Beispiel einem Online-Speicher. Ob die Dateien dort auf dem Handy oder im Internet liegen, entscheidet diese App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This folder belongs to another app, such as an online storage service. That app decides whether the files stay on your phone or go online."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta carpeta pertenece a otra app, por ejemplo un almacenamiento en línea. Esa app decide si los archivos se quedan en el móvil o van a internet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce dossier appartient à une autre app, par exemple un stockage en ligne. C’est elle qui décide si les fichiers restent sur le téléphone ou partent en ligne."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder ini milik app lain, misalnya layanan penyimpanan online. App itu yang menentukan apakah file tetap di ponsel atau masuk ke cloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa cartella appartiene a un’altra app, ad esempio uno spazio di archiviazione online. È quell’app a decidere se i file restano sul telefono o vanno online."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフォルダーは別のアプリ（オンラインストレージなど）のものです。ファイルをスマホに置くかオンラインに送るかは、そのアプリが決めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 폴더는 온라인 저장소 같은 다른 앱의 것이에요. 파일을 휴대폰에 둘지 온라인에 올릴지는 그 앱이 정해요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne mappen tilhører en annen app, for eksempel en nettlagringstjeneste. Den appen bestemmer om filene blir på telefonen eller havner på nettet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze map hoort bij een andere app, bijvoorbeeld een onlineopslag. Die app bepaalt of de bestanden op je telefoon blijven of online gaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten folder należy do innej aplikacji, np. usługi przechowywania online. To ona decyduje, czy pliki zostaną w telefonie, czy trafią do internetu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta pasta pertence a outro app, como um serviço de armazenamento online. Esse app decide se os arquivos ficam no celular ou vão para a nuvem."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta pasta pertence a outra app, por exemplo um armazenamento online. É essa app que decide se os ficheiros ficam no telemóvel ou vão para a internet."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest dosar aparține altei aplicații, de exemplu unui spațiu de stocare online. Ea decide dacă fișierele rămân pe telefon sau ajung online."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта папка принадлежит другому приложению, например онлайн-хранилищу. Оно и решает, останутся ли файлы на телефоне или уйдут в интернет."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här mappen tillhör en annan app, till exempel en molntjänst. Den appen bestämmer om filerna stannar på telefonen eller hamnar online."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โฟลเดอร์นี้เป็นของแอพอื่น เช่น บริการจัดเก็บออนไลน์ แอพนั้นเป็นผู้ตัดสินว่าไฟล์จะอยู่บนโทรศัพท์หรือขึ้นออนไลน์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu klasör başka bir uygulamaya, örneğin çevrimiçi bir depolama hizmetine ait. Dosyaların telefonda mı kalacağına yoksa internete mi gideceğine o uygulama karar verir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця папка належить іншому застосунку, наприклад онлайн-сховищу. Саме він вирішує, чи залишаться файли на телефоні, чи підуть в інтернет."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thư mục này thuộc về ứng dụng khác, như dịch vụ lưu trữ trực tuyến. Ứng dụng đó quyết định tệp ở lại trên điện thoại hay lên mạng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件夹属于另一个应用，例如在线存储。文件留在手机上还是上传到网上，由该应用决定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個檔案夾屬於其他 App，例如雲端儲存服務。由該 App 決定檔案留在手機上或上傳到雲端。"
          }
        }
      }
    },
    "archive_kind_removable": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وسيط تخزين منفصل، مثل ذاكرة USB أو قرص خارجي."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En separat lagerenhed, f.eks. en USB-nøgle eller et eksternt drev."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein eigener Datenträger, zum Beispiel ein USB-Stick oder eine externe Festplatte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A separate storage device, such as a USB stick or external drive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un soporte de almacenamiento aparte, como una memoria USB o un disco externo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un support de stockage séparé, comme une clé USB ou un disque externe."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perangkat penyimpanan terpisah, seperti flashdisk USB atau drive eksternal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un supporto di archiviazione separato, come una chiavetta USB o un disco esterno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "USBメモリや外付けドライブなど、別の記憶装置です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "USB 메모리나 외장 드라이브 같은 별도의 저장 장치예요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
