    "vault_progress_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُرجى إبقاء GaleriQ مفتوحًا. مغادرة التطبيق توقف العملية، ولا يُحذف أي شيء."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অনুগ্রহ করে GaleriQ খোলা রাখুন। অ্যাপ ছেড়ে গেলে প্রক্রিয়া থেমে যায়; কিছুই মুছে ফেলা হয় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixa GaleriQ obert. Si surts de l’app, el procés s’atura; no s’esborra res."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nechte prosím GaleriQ otevřený. Opuštění aplikace proces zastaví; nic se nesmaže."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold GaleriQ åben. Hvis du forlader appen, stopper processen; intet slettes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte GaleriQ geöffnet lassen. Beim Verlassen wird abgebrochen; dabei wird nichts gelöscht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κράτα το GaleriQ ανοιχτό. Αν βγεις από την εφαρμογή, η διαδικασία σταματά· τίποτα δεν διαγράφεται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please keep GaleriQ open. Leaving the app stops the process; nothing is deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén GaleriQ abierto. Si sales de la app, el proceso se detiene; no se elimina nada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä GaleriQ auki. Apista poistuminen pysäyttää toiminnon; mitään ei poisteta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde GaleriQ ouvert. Quitter l’app interrompt l’opération ; rien n’est supprimé."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કૃપા કરીને GaleriQ ખુલ્લું રાખો. ઍપ છોડવાથી પ્રક્રિયા અટકે છે; કંઈ ડિલીટ થતું નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להשאיר את GaleriQ פתוחה. יציאה מהיישום עוצרת את התהליך; שום דבר לא נמחק."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कृपया GaleriQ खुला रखें। ऐप छोड़ने से प्रक्रिया रुक जाती है; कुछ भी डिलीट नहीं होता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostavi GaleriQ otvoren. Izlazak iz aplikacije zaustavlja postupak; ništa se ne briše."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hagyd nyitva a GaleriQ-t. Az appból kilépve a folyamat leáll; semmi sem törlődik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Biarkan GaleriQ tetap terbuka. Keluar dari app menghentikan proses; tidak ada yang dihapus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni aperto GaleriQ. Uscire dall’app interrompe l’operazione; non viene eliminato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQを開いたままにしてください。アプリを離れると処理が中止されますが、何も削除されません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ದಯವಿಟ್ಟು GaleriQ ತೆರೆದಿಡಿ. ಆ್ಯಪ್ ಬಿಟ್ಟರೆ ಪ್ರಕ್ರಿಯೆ ನಿಲ್ಲುತ್ತದೆ; ಏನನ್ನೂ ಅಳಿಸಲಾಗುವುದಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ를 열어 두세요. 앱을 나가면 작업이 중단되며, 아무것도 삭제되지 않습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ദയവായി GaleriQ തുറന്നുവയ്ക്കുക. ആപ്പ് വിട്ടുപോകുന്നത് പ്രക്രിയ നിർത്തും; ഒന്നും ഇല്ലാതാക്കില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कृपया GaleriQ उघडे ठेवा. अ‍ॅप सोडल्यास प्रक्रिया थांबते; काहीही डिलीट होत नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sila biarkan GaleriQ terbuka. Meninggalkan app akan menghentikan proses; tiada apa dipadam."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold GaleriQ åpen. Hvis du forlater appen, stoppes prosessen; ingenting slettes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd GaleriQ open. Als je de app verlaat, stopt het proces; er wordt niets verwijderd."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଦୟାକରି GaleriQ ଖୋଲା ରଖନ୍ତୁ। ଆପ୍ ଛାଡ଼ିଲେ ପ୍ରକ୍ରିୟା ବନ୍ଦ ହୁଏ; କିଛି ଡିଲିଟ୍ ହୁଏ ନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕਿਰਪਾ ਕਰਕੇ GaleriQ ਖੁੱਲ੍ਹਾ ਰੱਖੋ। ਐਪ ਛੱਡਣ ਨਾਲ ਪ੍ਰਕਿਰਿਆ ਰੁਕ ਜਾਂਦੀ ਹੈ; ਕੁਝ ਵੀ ਨਹੀਂ ਮਿਟਦਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie zamykaj GaleriQ. Opuszczenie aplikacji przerywa proces; nic nie zostanie usunięte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha o GaleriQ aberto. Sair do app interrompe o processo; nada é apagado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém o GaleriQ aberto. Sair da app interrompe o processo; nada é apagado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ține GaleriQ deschis. Dacă ieși din aplicație, procesul se oprește; nu se șterge nimic."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не закрывай GaleriQ. При выходе из приложения процесс прервётся; ничего не удалится."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nechajte GaleriQ otvorený. Opustenie aplikácie proces zastaví; nič sa nevymaže."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pusti GaleriQ odprt. Izhod iz aplikacije ustavi postopek; nič se ne izbriše."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll GaleriQ öppet. Om du lämnar appen stoppas processen; inget raderas."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ-ஐத் திறந்தே வையுங்கள். ஆப்பை விட்டு வெளியேறினால் செயல்முறை நிற்கும்; எதுவும் நீக்கப்படாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "దయచేసి GaleriQను తెరిచి ఉంచండి. యాప్ వదిలి వెళ్తే ప్రక్రియ ఆగిపోతుంది; ఏదీ తొలగించబడదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรดเปิด GaleriQ ไว้ การออกจากแอพจะหยุดกระบวนการ ไม่มีอะไรถูกลบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lütfen GaleriQ’i açık tut. Uygulamadan çıkarsan işlem durur; hiçbir şey silinmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не закривай GaleriQ. Якщо вийти з програми, процес зупиниться; нічого не буде видалено."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "براہ کرم GaleriQ کھلا رکھیں۔ ایپ چھوڑنے سے عمل رک جاتا ہے؛ کچھ حذف نہیں ہوتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vui lòng giữ GaleriQ mở. Rời ứng dụng sẽ dừng quá trình; không có gì bị xóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请保持 GaleriQ 打开。离开 App 会中止此过程，但不会删除任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請保持 GaleriQ 開啟。離開 App 會停止處理；不會刪除任何內容。"
          }
        }
      }
    },
