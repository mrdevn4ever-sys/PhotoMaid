            "state": "translated",
            "value": "Filmy są zapisywane ponownie, by zmieściły się w docelowym rozmiarze. Obraz zmniejsza się tylko w razie potrzeby."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Videos are saved again to fit the target size. The picture only gets smaller if needed."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os vídeos são guardados de novo para caberem no tamanho pretendido. A imagem só diminui se for preciso."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
