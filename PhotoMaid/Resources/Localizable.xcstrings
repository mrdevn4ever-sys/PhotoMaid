    "rec_sub": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرقامك القياسية. تبقى على هذا الـ iPhone."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine rekorder. De bliver på denne iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Rekorde. Bleiben auf diesem iPhone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your records. They stay on this iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus récords. Se quedan en este iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes records. Ils restent sur cet iPhone."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekormu. Semuanya tetap di iPhone ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi record. Restano su questo iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの記録。このiPhoneだけに保存。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 기록. 이 iPhone에만 남아요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekordene dine. De blir på denne iPhonen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je records. Ze blijven op deze iPhone."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje rekordy. Zostają na tym iPhonie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus recordes. Eles ficam neste iPhone."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os teus recordes. Ficam neste iPhone."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Recordurile tale. Rămân pe acest iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твои рекорды. Остаются на этом iPhone."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina rekord. De stannar på den här iPhonen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สถิติของคุณ อยู่บน iPhone เครื่องนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekorların. Bu iPhone’da kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Твої рекорди. Залишаються на цьому iPhone."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kỷ lục của bạn. Chúng ở lại trên iPhone này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的纪录，只保存在这台 iPhone 上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的紀錄。它們只留在這部 iPhone 上。"
