    "vault2_local_only": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا حساب ولا خادم GaleriQ. لا تغادر الصادرات والنسخ الاحتياطية التطبيق إلا بإجراء صريح منك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো অ্যাকাউন্ট নেই এবং কোনো GaleriQ সার্ভার নেই। এক্সপোর্ট ও ব্যাকআপ শুধু আপনার স্পষ্ট কাজের মাধ্যমেই অ্যাপ ছেড়ে যায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Sense compte i sense servidor de GaleriQ. Les exportacions i les còpies de seguretat només surten de l’app per una acció explícita teva."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žádný účet a žádný server GaleriQ. Exporty a zálohy opouštějí aplikaci jen vaší výslovnou akcí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen konto og ingen GaleriQ-server. Eksporter og sikkerhedskopier forlader kun appen ved en udtrykkelig handling fra dig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Konto und kein GaleriQ-Server. Exporte und Backups verlassen die App nur durch deine ausdrückliche Aktion."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χωρίς λογαριασμό και χωρίς διακομιστή GaleriQ. Οι εξαγωγές και τα αντίγραφα ασφαλείας φεύγουν από την εφαρμογή μόνο με ρητή δική σου ενέργεια."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No account and no GaleriQ server. Exports and backups leave the app only through your explicit action."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin cuenta ni servidor GaleriQ. Las exportaciones y copias solo salen de la app por una acción explícita tuya."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei tiliä eikä GaleriQ-palvelinta. Viennit ja varmuuskopiot lähtevät apista vain nimenomaisella toiminnollasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun compte ni serveur GaleriQ. Les exports et sauvegardes quittent l’app uniquement sur votre action explicite."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કોઈ એકાઉન્ટ નહીં અને કોઈ GaleriQ સર્વર નહીં. એક્સપોર્ટ અને બૅકઅપ ફક્ત તમારી સ્પષ્ટ ક્રિયાથી જ ઍપની બહાર જાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בלי חשבון ובלי שרת של GaleriQ. ייצואים וגיבויים יוצאים מהיישום רק בפעולה מפורשת שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई खाता नहीं और कोई GaleriQ सर्वर नहीं। एक्सपोर्ट और बैकअप सिर्फ़ आपकी स्पष्ट कार्रवाई से ऐप से बाहर जाते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez računa i bez GaleriQ poslužitelja. Izvozi i sigurnosne kopije napuštaju aplikaciju samo tvojom izričitom radnjom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs fiók és nincs GaleriQ-szerver. Az exportok és mentések csak a kifejezett műveleteddel hagyják el az appot."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa akun dan tanpa server GaleriQ. Ekspor dan cadangan hanya keluar dari app lewat tindakanmu sendiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun account o server GaleriQ. Esportazioni e backup escono dall’app solo con una tua azione esplicita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントもGaleriQサーバーも使いません。書き出しやバックアップは明示的に操作したときだけアプリの外に出ます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಖಾತೆ ಇಲ್ಲ ಮತ್ತು GaleriQ ಸರ್ವರ್ ಇಲ್ಲ. ಎಕ್ಸ್‌ಪೋರ್ಟ್‌ಗಳು ಮತ್ತು ಬ್ಯಾಕಪ್‌ಗಳು ನಿಮ್ಮ ಸ್ಪಷ್ಟ ಕ್ರಿಯೆಯ ಮೂಲಕ ಮಾತ್ರ ಆ್ಯಪ್‌ನಿಂದ ಹೊರಹೋಗುತ್ತವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정이나 GaleriQ 서버가 없습니다. 명시적인 작업을 수행해야 내보내기와 백업이 앱 밖으로 나갑니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അക്കൗണ്ടില്ല, GaleriQ സെർവറുമില്ല. എക്‌സ്‌പോർട്ടുകളും ബാക്കപ്പുകളും നിങ്ങളുടെ വ്യക്തമായ പ്രവർത്തനത്തിലൂടെ മാത്രമേ ആപ്പിൽ നിന്ന് പുറത്തുപോകൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "खाते नाही आणि GaleriQ सर्व्हर नाही. एक्सपोर्ट आणि बॅकअप फक्त तुमच्या स्पष्ट कृतीनेच अ‍ॅपबाहेर जातात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada akaun dan tiada pelayan GaleriQ. Eksport dan sandaran hanya meninggalkan app melalui tindakan jelas anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen konto og ingen GaleriQ-server. Eksporter og sikkerhetskopier forlater bare appen ved en uttrykkelig handling fra deg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen account of GaleriQ-server. Exports en back-ups verlaten de app alleen op jouw uitdrukkelijke verzoek."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "କୌଣସି ଆକାଉଣ୍ଟ ନାହିଁ ଏବଂ କୌଣସି GaleriQ ସର୍ଭର ନାହିଁ। ଏକ୍ସପୋର୍ଟ ଓ ବ୍ୟାକଅପ୍ କେବଳ ଆପଣଙ୍କ ସ୍ପଷ୍ଟ କାର୍ଯ୍ୟ ଦ୍ୱାରା ହିଁ ଆପ୍ ଛାଡ଼େ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੋਈ ਖਾਤਾ ਨਹੀਂ ਅਤੇ ਕੋਈ GaleriQ ਸਰਵਰ ਨਹੀਂ। ਐਕਸਪੋਰਟ ਅਤੇ ਬੈਕਅੱਪ ਸਿਰਫ਼ ਤੁਹਾਡੀ ਸਪਸ਼ਟ ਕਾਰਵਾਈ ਨਾਲ ਹੀ ਐਪ ਤੋਂ ਬਾਹਰ ਜਾਂਦੇ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez konta i serwera GaleriQ. Eksporty i kopie opuszczają aplikację tylko po Twoim wyraźnym działaniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem conta e sem servidor do GaleriQ. Exportações e backups só saem do app por uma ação explícita sua."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem conta nem servidor GaleriQ. Exportações e cópias só saem da app por uma ação tua explícita."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fără cont și fără server GaleriQ. Exporturile și copiile părăsesc aplicația doar prin acțiunea ta explicită."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без аккаунта и сервера GaleriQ. Экспорт и резервные копии покидают приложение только по вашему явному действию."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Žiadny účet a žiadny server GaleriQ. Exporty a zálohy opúšťajú aplikáciu len vašou výslovnou akciou."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brez računa in brez strežnika GaleriQ. Izvozi in varnostne kopije zapustijo aplikacijo le s tvojim izrecnim dejanjem."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget konto och ingen GaleriQ-server. Exporter och säkerhetskopior lämnar appen bara genom en uttrycklig åtgärd från dig."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கணக்கு இல்லை, GaleriQ சேவையகமும் இல்லை. ஏற்றுமதிகளும் காப்புப்பிரதிகளும் உங்கள் வெளிப்படையான செயலால் மட்டுமே ஆப்பை விட்டு வெளியேறும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఖాతా లేదు, GaleriQ సర్వర్ లేదు. ఎక్స్‌పోర్ట్‌లు, బ్యాకప్‌లు మీ స్పష్టమైన చర్య ద్వారా మాత్రమే యాప్ నుండి బయటకు వెళ్తాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีบัญชีและไม่มีเซิร์ฟเวอร์ของ GaleriQ การส่งออกและข้อมูลสำรองจะออกจากแอพเมื่อคุณสั่งเองเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap ve GaleriQ sunucusu yoktur. Dışa aktarımlar ve yedekler yalnızca açık işleminle uygulamadan çıkar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Без облікового запису та сервера GaleriQ. Експорт і копії залишають програму лише після вашої явної дії."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی اکاؤنٹ نہیں اور کوئی GaleriQ سرور نہیں۔ ایکسپورٹ اور بیک اپ صرف آپ کی واضح کارروائی سے ایپ سے باہر جاتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có tài khoản và không có máy chủ GaleriQ. Bản xuất và bản sao lưu chỉ rời ứng dụng khi bạn chủ động thực hiện."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需账户，不使用GaleriQ服务器。只有在你明确操作后，导出文件和备份才会离开应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有帳號，也沒有 GaleriQ 伺服器。輸出和備份只會在你明確操作時離開 App。"
          }
        }
      }
    },
