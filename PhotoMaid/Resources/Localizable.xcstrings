    "archive_failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقف النسخ بشكل غير متوقع. تُظهر النتيجة ما تم التحقق منه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Kopieren wurde unerwartet beendet. Was geprüft ist, siehst du im Ergebnis."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copying stopped unexpectedly. The result shows what was checked."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia se detuvo de forma inesperada. En el resultado verás lo que se ha comprobado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La copie s’est arrêtée de façon inattendue. Le résultat indique ce qui a été vérifié."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia si è interrotta inaspettatamente. Nel risultato vedi cosa è stato controllato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピーが予期せず止まりました。確認済みのものは結果で見られます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복사가 예기치 않게 멈췄어요. 확인된 항목은 결과에서 볼 수 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het kopiëren is onverwacht gestopt. In het resultaat zie je wat er is gecontroleerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiowanie nieoczekiwanie się zatrzymało. W wyniku zobaczysz, co zostało sprawdzone."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A cópia parou inesperadamente. No resultado vê o que foi verificado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Copierea s-a oprit neașteptat. În rezultat vezi ce a fost verificat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копирование неожиданно прервалось. В результате видно, что уже проверено."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopyalama beklenmedik şekilde durdu. Neyin kontrol edildiğini sonuçta görebilirsin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Копіювання несподівано зупинилося. У результаті видно, що вже перевірено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制意外停止。结果中会显示已检查的内容。"
          }
        }
      }
    },
