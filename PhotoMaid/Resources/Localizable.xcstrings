            "value": "દિશા બદલવા બોર્ડ પર સ્વાઇપ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החלקה על הלוח משנה כיוון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दिशा बदलने के लिए बोर्ड पर स्वाइप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Povuci po ploči da promijeniš smjer."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzz a táblán az irányváltáshoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Geser di papan untuk mengubah arah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri sul campo per cambiare direzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "盤面をスワイプして方向を変えます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ದಿಕ್ಕು ಬದಲಿಸಲು ಬೋರ್ಡ್‌ನಲ್ಲಿ ಸ್ವೈಪ್ ಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게임판을 스와이프해 방향을 바꾸세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ദിശ മാറ്റാൻ ബോർഡിൽ സ്വൈപ്പ് ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "दिशा बदलण्यासाठी बोर्डवर स्वाइप करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Leret pada papan untuk menukar arah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sveip på brettet for å endre retning."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Veeg op het speelveld om van richting te veranderen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଦିଗ ବଦଳାଇବାକୁ ବୋର୍ଡରେ ସ୍ୱାଇପ୍ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਦਿਸ਼ਾ ਬਦਲਣ ਲਈ ਬੋਰਡ ਉੱਤੇ ਸਵਾਈਪ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
