    "edit_pro_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "القص والتدوير والتسوية مجانية. تُحفظ التعديلات والفلاتر والحجم وقص الفيديو مع Pro. التجربة مجانية دائمًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্রপ, ঘোরানো ও সোজা করা বিনামূল্যে। অ্যাডজাস্টমেন্ট, ফিল্টার, আকার ও ভিডিও ছাঁটা Pro দিয়ে সংরক্ষিত হয়। চেষ্টা করে দেখা সবসময় বিনামূল্যে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Retallar, girar i redreçar és gratuït. Els ajustos, els filtres, la mida i el retall de vídeos es desen amb Pro. Provar-los és sempre gratuït."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ořez, otočení a narovnání jsou zdarma. Úpravy, filtry, velikost a zkracování videí se ukládají s Pro. Vyzkoušení je vždy zdarma."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Beskæring, rotation og udretning er gratis. Justeringer, filtre, størrelse og videoklipning gemmes med Pro. At prøve er altid gratis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuschneiden, Drehen und Begradigen sind kostenlos. Regler, Filter, Größe und Video kürzen speicherst du mit Pro. Ausprobieren ist immer kostenlos."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η περικοπή, η περιστροφή και η ευθυγράμμιση είναι δωρεάν. Ρυθμίσεις, φίλτρα, μέγεθος και περικοπή βίντεο αποθηκεύονται με Pro. Η δοκιμή είναι πάντα δωρεάν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cropping, rotating and straightening are free. Adjustments, filters, size and video trimming save with Pro. Trying them out is always free."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recortar, girar y enderezar es gratis. Los ajustes, filtros, tamaño y recorte de vídeo se guardan con Pro. Probarlos siempre es gratis."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rajaus, kierto ja suoristus ovat ilmaisia. Säädöt, suodattimet, koko ja videoiden trimmaus tallennetaan Pron kanssa. Kokeileminen on aina ilmaista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recadrer, faire pivoter et redresser est gratuit. Les réglages, filtres, la taille et le découpage vidéo s’enregistrent avec Pro. Les essayer est toujours gratuit."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ક્રૉપ, ફેરવવું અને સીધું કરવું મફત છે. ગોઠવણો, ફિલ્ટર, કદ અને વીડિયો ટ્રિમ Pro સાથે સચવાય છે. અજમાવવું હંમેશાં મફત છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חיתוך, סיבוב ויישור הם בחינם. כוונונים, פילטרים, גודל וקיצור סרטונים נשמרים עם Pro. הניסיון תמיד בחינם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्रॉप करना, घुमाना और सीधा करना मुफ़्त है। एडजस्टमेंट, फ़िल्टर, साइज़ और वीडियो ट्रिम Pro के साथ सहेजे जाते हैं। आज़माना हमेशा मुफ़्त है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrezivanje, okretanje i ravnanje su besplatni. Prilagodbe, filtri, veličina i skraćivanje videozapisa spremaju se uz Pro. Isprobavanje je uvijek besplatno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A vágás, forgatás és kiegyenesítés ingyenes. A beállítások, szűrők, méret és videóvágás Próval menthetők. Kipróbálni mindig ingyenes."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memotong, memutar, dan meluruskan gratis. Penyesuaian, filter, ukuran, dan pemangkasan video disimpan dengan Pro. Mencoba selalu gratis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ritagliare, ruotare e raddrizzare è gratis. Regolazioni, filtri, dimensioni e taglio video si salvano con Pro. Provarli è sempre gratis."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "切り取り、回転、傾き補正は無料です。調整、フィルタ、サイズ、ビデオのトリミングはProで保存できます。試すのはいつでも無料です。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕ್ರಾಪ್, ತಿರುಗಿಸುವಿಕೆ ಮತ್ತು ನೇರಗೊಳಿಸುವಿಕೆ ಉಚಿತ. ಹೊಂದಾಣಿಕೆಗಳು, ಫಿಲ್ಟರ್‌ಗಳು, ಗಾತ್ರ ಮತ್ತು ವೀಡಿಯೊ ಟ್ರಿಮ್ Pro ಮೂಲಕ ಉಳಿಯುತ್ತವೆ. ಪ್ರಯತ್ನಿಸುವುದು ಯಾವಾಗಲೂ ಉಚಿತ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자르기, 회전, 수평 맞추기는 무료입니다. 조정, 필터, 크기, 비디오 다듬기는 Pro로 저장합니다. 사용해 보는 것은 언제나 무료입니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ക്രോപ്പ് ചെയ്യൽ, തിരിക്കൽ, നേരെയാക്കൽ എന്നിവ സൗജന്യമാണ്. ക്രമീകരണങ്ങൾ, ഫിൽട്ടറുകൾ, വലുപ്പം, വീഡിയോ ട്രിം എന്നിവ Pro ഉപയോഗിച്ച് സംരക്ഷിക്കാം. പരീക്ഷിക്കുന്നത് എപ്പോഴും സൗജന്യമാണ്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "क्रॉप, फिरवणे आणि सरळ करणे विनामूल्य आहे. समायोजने, फिल्टर, आकार आणि व्हिडिओ ट्रिम Pro सह जतन होतात. वापरून पाहणे नेहमी विनामूल्य आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Memangkas, memutar dan meluruskan adalah percuma. Pelarasan, penapis, saiz dan pemangkasan video disimpan dengan Pro. Mencuba sentiasa percuma."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Beskjæring, rotering og retting er gratis. Justeringer, filtre, størrelse og videoklipping lagres med Pro. Å prøve er alltid gratis."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bijsnijden, draaien en rechtzetten is gratis. Aanpassingen, filters, formaat en video inkorten bewaar je met Pro. Uitproberen is altijd gratis."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "କ୍ରପ୍, ଘୁରାଇବା ଓ ସିଧା କରିବା ମାଗଣା। ଆଡଜଷ୍ଟମେଣ୍ଟ, ଫିଲ୍ଟର୍, ଆକାର ଓ ଭିଡିଓ ଟ୍ରିମ୍ Pro ସହ ସେଭ୍ ହୁଏ। ଚେଷ୍ଟା କରିବା ସବୁବେଳେ ମାଗଣା।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕ੍ਰੌਪ ਕਰਨਾ, ਘੁਮਾਉਣਾ ਅਤੇ ਸਿੱਧਾ ਕਰਨਾ ਮੁਫ਼ਤ ਹੈ। ਐਡਜਸਟਮੈਂਟ, ਫ਼ਿਲਟਰ, ਆਕਾਰ ਅਤੇ ਵੀਡੀਓ ਟ੍ਰਿਮ Pro ਨਾਲ ਸੰਭਾਲੇ ਜਾਂਦੇ ਹਨ। ਅਜ਼ਮਾਉਣਾ ਹਮੇਸ਼ਾ ਮੁਫ਼ਤ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kadrowanie, obracanie i prostowanie są bezpłatne. Regulacje, filtry, rozmiar i przycinanie filmów zapiszesz z Pro. Wypróbowanie jest zawsze bezpłatne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cortar, girar e endireitar são grátis. Ajustes, filtros, tamanho e corte de vídeo são salvos com o Pro. Experimentar é sempre grátis."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Recortar, rodar e endireitar é gratuito. Ajustes, filtros, tamanho e corte de vídeo guardam-se com o Pro. Experimentar é sempre gratuito."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Decuparea, rotirea și îndreptarea sunt gratuite. Reglajele, filtrele, dimensiunea și scurtarea video se salvează cu Pro. Încercarea e mereu gratuită."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обрезка, поворот и выравнивание бесплатны. Настройки, фильтры, размер и обрезка видео сохраняются с Pro. Попробовать можно всегда бесплатно."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Orezanie, otočenie a vyrovnanie sú zadarmo. Úpravy, filtre, veľkosť a skracovanie videí sa ukladajú s Pro. Vyskúšanie je vždy zadarmo."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrezovanje, vrtenje in ravnanje so brezplačni. Prilagoditve, filtri, velikost in krajšanje videoposnetkov se shranijo s Pro. Preizkušanje je vedno brezplačno."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Beskära, rotera och räta upp är gratis. Justeringar, filter, storlek och videoklippning sparas med Pro. Att prova är alltid gratis."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வெட்டுதல், சுழற்றுதல், நேராக்குதல் இலவசம். சரிசெய்தல்கள், வடிப்பான்கள், அளவு, வீடியோ வெட்டுதல் Pro மூலம் சேமிக்கப்படும். முயன்று பார்ப்பது எப்போதும் இலவசம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "క్రాప్ చేయడం, తిప్పడం, నిటారుగా చేయడం ఉచితం. సర్దుబాట్లు, ఫిల్టర్‌లు, పరిమాణం, వీడియో ట్రిమ్ Pro తో సేవ్ అవుతాయి. ప్రయత్నించడం ఎప్పుడూ ఉచితం."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การครอบตัด หมุน และปรับให้ตรงใช้ได้ฟรี การปรับแต่ง ฟิลเตอร์ ขนาด และการตัดวิดีโอบันทึกได้ด้วย Pro ลองใช้ได้ฟรีเสมอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kırpma, döndürme ve düzleştirme ücretsizdir. Ayarlar, filtreler, boyut ve video kırpma Pro ile kaydedilir. Denemek her zaman ücretsizdir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обрізання, поворот і вирівнювання безкоштовні. Налаштування, фільтри, розмір і обрізання відео зберігаються з Pro. Спробувати завжди безкоштовно."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کراپ، گھمانا اور سیدھا کرنا مفت ہے۔ ایڈجسٹمنٹ، فلٹرز، سائز اور ویڈیو ٹرم Pro کے ساتھ محفوظ ہوتے ہیں۔ آزمانا ہمیشہ مفت ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cắt, xoay và làm thẳng miễn phí. Điều chỉnh, bộ lọc, kích thước và cắt video được lưu với Pro. Dùng thử luôn miễn phí."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "裁剪、旋转和拉直是免费的。调整、滤镜、尺寸和视频修剪需 Pro 才能存储。试用始终免费。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裁切、旋轉和拉直免費。調整、濾鏡、尺寸和影片剪輯需要 Pro 才能儲存。試用永遠免費。"
          }
        }
      }
    },
