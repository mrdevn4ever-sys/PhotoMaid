    "archive_studio_sub": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النسخ إلى مجلد مختار والتحقق من كل نسخة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বেছে নেওয়া ফোল্ডারে কপি করুন এবং প্রতিটি কপি যাচাই করুন"
          }
        },
        "ca": {
