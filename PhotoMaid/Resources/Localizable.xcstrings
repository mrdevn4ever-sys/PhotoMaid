        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रद्द किया गया। कुछ भी सहेजा नहीं गया।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otkazano. Ništa nije spremljeno."
