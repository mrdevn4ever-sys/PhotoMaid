    "vault_import_limit": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم النقل: %1$lld. حدّ الخزنة في Free: %2$lld، وفي Pro بلا حدود."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke flyttet: %1$lld. Gratisversionen tillader %2$lld emner i boksen; med Pro er der ingen grænse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht abgelegt: %1$lld. Free erlaubt %2$lld Medien im Tresor, Pro unbegrenzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not moved: %1$lld. Free allows %2$lld items in the vault; Pro is unlimited."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No movidos: %1$lld. Free permite %2$lld elementos en la caja fuerte; Pro, ilimitados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non déplacés : %1$lld. Free autorise %2$lld éléments dans le coffre-fort ; Pro est illimité."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dipindahkan: %1$lld. Versi gratis mengizinkan %2$lld item di brankas; Pro tanpa batas."
