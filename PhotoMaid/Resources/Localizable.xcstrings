    "studio_intro": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أبدع بصورك. يبقى كل شيء على جهازك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ফটো দিয়ে কিছু তৈরি করুন। সবকিছু আপনার ডিভাইসেই থাকে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea amb les teves fotos. Tot es queda al dispositiu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvořte se svými fotkami. Vše zůstává ve vašem zařízení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skab med dine fotos. Alt bliver på din enhed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestalte mit deinen Fotos. Alles bleibt auf deinem Gerät."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δημιούργησε με τις φωτογραφίες σου. Όλα μένουν στη συσκευή σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create with your photos. Everything stays on your device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea con tus fotos. Todo se queda en tu dispositivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luo kuvillasi. Kaikki pysyy laitteellasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crée avec tes photos. Tout reste sur ton appareil."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારા ફોટાથી બનાવો. બધું તમારા ઉપકરણ પર રહે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ליצור עם התמונות שלך. הכול נשאר במכשיר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी फ़ोटो से बनाएँ। सब कुछ आपके डिवाइस पर रहता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stvaraj sa svojim fotografijama. Sve ostaje na tvom uređaju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Alkoss a fotóiddal. Minden az eszközödön marad."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berkreasi dengan fotomu. Semuanya tetap di perangkatmu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea con le tue foto. Tutto resta sul tuo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真で作品を作りましょう。すべて端末内で処理されます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಫೋಟೋಗಳೊಂದಿಗೆ ರಚಿಸಿ. ಎಲ್ಲವೂ ನಿಮ್ಮ ಸಾಧನದಲ್ಲೇ ಉಳಿಯುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진으로 만들어 보세요. 모든 것이 기기에만 남아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ഫോട്ടോകൾ ഉപയോഗിച്ച് സൃഷ്‌ടിക്കുക. എല്ലാം നിങ്ങളുടെ ഉപകരണത്തിൽ തന്നെ തുടരും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या फोटोंनी तयार करा. सर्व काही तुमच्या डिव्हाइसवर राहते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cipta dengan foto anda. Semuanya kekal pada peranti anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lag noe med bildene dine. Alt blir på enheten din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak iets met je foto’s. Alles blijft op je apparaat."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ ଫଟୋ ସହ କିଛି ତିଆରି କରନ୍ତୁ। ସବୁକିଛି ଆପଣଙ୍କ ଡିଭାଇସ୍‌ରେ ହିଁ ରହେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਆਪਣੀਆਂ ਫ਼ੋਟੋਆਂ ਨਾਲ ਕੁਝ ਬਣਾਓ। ਸਭ ਕੁਝ ਤੁਹਾਡੇ ਡਿਵਾਈਸ ਉੱਤੇ ਰਹਿੰਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twórz ze swoich zdjęć. Wszystko zostaje na urządzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie com suas fotos. Tudo fica no seu aparelho."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cria com as tuas fotos. Tudo fica no teu dispositivo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Creează cu fotografiile tale. Totul rămâne pe dispozitiv."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создавай из своих фото. Всё остаётся на устройстве."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvorte so svojimi fotkami. Všetko zostáva vo vašom zariadení."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustvarjaj s svojimi fotografijami. Vse ostane v tvoji napravi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skapa med dina bilder. Allt stannar på din enhet."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் புகைப்படங்களைக் கொண்டு உருவாக்குங்கள். அனைத்தும் உங்கள் சாதனத்திலேயே இருக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ ఫోటోలతో సృష్టించండి. అంతా మీ పరికరంలోనే ఉంటుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สร้างสรรค์ด้วยรูปภาพของคุณ ทุกอย่างอยู่บนอุปกรณ์ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraflarınla oluştur. Her şey cihazında kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Створюй зі своїх фото. Усе залишається на пристрої."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنی تصاویر سے بنائیں۔ سب کچھ آپ کی ڈیوائس پر رہتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sáng tạo với ảnh của bạn. Mọi thứ ở lại trên thiết bị."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用你的照片进行创作。一切都保留在设备上。"
          }
