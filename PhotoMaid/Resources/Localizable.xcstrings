    "tour_months_later_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العناصر المؤجلة لوقت لاحق تُحسب كمراجعة، لكنك ما زلت تراها هنا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পরের জন্য আলাদা রাখা আইটেম পর্যালোচিত হিসেবে গণ্য হয় – আপনি এখনো এখানে সেগুলো দেখতে পান।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els elements apartats per a més tard compten com a revisats; aquí encara els veus."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Položky odložené na později se počítají jako prošlé – tady je stále vidíte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Emner, der er lagt til side til senere, tæller som gennemgået – du ser dem stadig her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für später Zurückgestelltes zählt als durchgesehen – du siehst es hier trotzdem."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα στοιχεία για αργότερα μετράνε ως ελεγμένα – εδώ τα βλέπεις ακόμη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Items set aside for later count as reviewed – you still see them here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo dejado para después cuenta como revisado, pero lo sigues viendo aquí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Myöhemmäksi siirretyt lasketaan läpikäydyiksi – näet ne silti täällä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui est remis à plus tard compte comme passé en revue – tu le vois quand même ici."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પછી માટે બાજુએ રાખેલી આઇટમ જોયેલી ગણાય છે – તમે તેમને અહીં હજી જુઓ છો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פריטים שהועברו הצידה למאוחר יותר נחשבים כנסקרו – כאן עדיין רואים אותם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बाद के लिए अलग रखे आइटम देखे हुए गिने जाते हैं – आप उन्हें यहाँ अब भी देखते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stavke odložene za kasnije broje se kao pregledane – ovdje ih i dalje vidiš."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A későbbre félretett elemek átnézettnek számítanak – itt továbbra is látod őket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Item yang disisihkan untuk nanti dihitung sudah ditinjau – kamu tetap melihatnya di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò che è rimandato conta come rivisto, ma lo vedi comunque qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「あとで」にしたものは見直し済みとして数えますが、ここに表示されます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಂತರಕ್ಕೆ ಪಕ್ಕಕ್ಕಿಟ್ಟ ಐಟಂಗಳನ್ನು ಪರಿಶೀಲಿಸಿದವು ಎಂದು ಎಣಿಸಲಾಗುತ್ತದೆ – ನೀವು ಅವುಗಳನ್ನು ಇಲ್ಲಿ ಇನ್ನೂ ನೋಡುತ್ತೀರಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘나중에’로 미룬 항목은 확인한 것으로 세지만 여기에서 계속 보여요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പിന്നീടേക്ക് മാറ്റിവച്ച ഇനങ്ങൾ പരിശോധിച്ചതായി കണക്കാക്കും – നിങ്ങൾക്ക് അവ ഇപ്പോഴും ഇവിടെ കാണാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "नंतरसाठी बाजूला ठेवलेले आयटम पाहिलेले म्हणून मोजले जातात – तुम्ही ते इथे अजूनही पाहता."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Item yang diketepikan untuk nanti dikira sebagai disemak – anda masih melihatnya di sini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Elementer lagt til side til senere teller som gått gjennom – du ser dem fortsatt her."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat voor later is bewaard telt als bekeken – je ziet het hier toch."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପରେ ପାଇଁ ଅଲଗା ରଖାଯାଇଥିବା ଆଇଟମ୍ ସମୀକ୍ଷିତ ଭାବେ ଗଣାଯାଏ – ଆପଣ ଏବେ ବି ଏଠାରେ ସେଗୁଡ଼ିକ ଦେଖନ୍ତି।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਬਾਅਦ ਲਈ ਵੱਖ ਰੱਖੀਆਂ ਆਈਟਮਾਂ ਸਮੀਖਿਆ ਹੋਈਆਂ ਗਿਣੀਆਂ ਜਾਂਦੀਆਂ ਹਨ – ਤੁਸੀਂ ਉਨ੍ਹਾਂ ਨੂੰ ਇੱਥੇ ਹਾਲੇ ਵੀ ਦੇਖਦੇ ਹੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odłożone na później liczą się jako przejrzane – nadal widzisz je tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Itens deixados para depois contam como revisados – você ainda os vê aqui."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O que ficou para mais tarde conta como revisto, mas continuas a vê-lo aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce ai amânat contează ca revizuit, dar îl vezi în continuare aici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отложенное на потом считается просмотренным, но ты всё равно видишь его здесь."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Položky odložené na neskôr sa počítajú ako prezreté – tu ich stále vidíte."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elementi, odloženi za pozneje, štejejo kot pregledani – tukaj jih še vedno vidiš."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Objekt som lagts undan till senare räknas som genomgångna – du ser dem fortfarande här."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பிறகுக்கு ஒதுக்கியவை பார்வையிடப்பட்டவையாகக் கணக்கிடப்படும் – அவற்றை இங்கே இன்னும் பார்க்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "తర్వాతకు పక్కన పెట్టిన అంశాలు సమీక్షించినవిగా లెక్కించబడతాయి – అవి ఇక్కడ ఇంకా కనిపిస్తాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการที่แยกไว้ทีหลังนับว่าตรวจดูแล้ว – คุณยังเห็นได้ที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonraya bırakılanlar gözden geçirilmiş sayılır ama burada yine görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкладене на потім вважається переглянутим, але ти все одно бачиш його тут."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد کے لیے الگ رکھے آئٹمز جائزہ شدہ گنے جاتے ہیں – آپ انہیں یہاں اب بھی دیکھتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các mục để sau được tính là đã xem lại – bạn vẫn thấy chúng ở đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设为稍后的内容计为已查看，但仍会在这里显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "存為稍後的項目也算已整理 – 你仍會在這裡看到它們。"
          }
        }
      }
    },
