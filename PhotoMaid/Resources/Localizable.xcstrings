    "wf_video_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحفظ الفيديوهات من جديد لتناسب الحجم المطلوب. لا تصغر الصورة إلا عند الحاجة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Videos werden passend zur Zielgröße neu gespeichert. Das Bild wird nur kleiner, wenn es nötig ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Videos are saved again to fit the target size. The picture only gets smaller if needed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los vídeos se vuelven a guardar para ajustarse al tamaño objetivo. La imagen solo se reduce si hace falta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les vidéos sont réenregistrées pour respecter la taille visée. L’image ne rétrécit que si c’est nécessaire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I video vengono salvati di nuovo per rientrare nella dimensione scelta. L’immagine si rimpicciolisce solo se serve."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画は目標サイズに合うように保存し直されます。画面サイズは必要なときだけ小さくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동영상은 목표 크기에 맞게 다시 저장돼요. 화면 크기는 필요할 때만 작아져요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Video’s worden opnieuw opgeslagen om bij de doelgrootte te passen. Het beeld wordt alleen kleiner als het nodig is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Filmy są zapisywane ponownie, by zmieściły się w docelowym rozmiarze. Obraz zmniejsza się tylko w razie potrzeby."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os vídeos são guardados de novo para caberem no tamanho pretendido. A imagem só diminui se for preciso."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Videoclipurile sunt salvate din nou ca să se încadreze în mărimea dorită. Imaginea se micșorează doar dacă e nevoie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Видео сохраняются заново под нужный размер. Изображение уменьшается, только если нужно."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Videolar hedef boyuta uyacak şekilde yeniden kaydedilir. Görüntü yalnızca gerekirse küçülür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відео зберігаються заново під потрібний розмір. Зображення зменшується лише за потреби."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "视频会重新保存以符合目标大小。只有在需要时画面才会变小。"
          }
        }
      }
    },
