    "ana2_swipe_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لأعلى للاحتفاظ، ولليسار لسلة المهملات، ولليمين للعرض لاحقًا. اضغط على صورة للبدء منها."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Op beholder, venstre flytter til papirkurven, højre viser det igen senere. Tryk på et foto for at starte der."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoch behält, links legt in den Papierkorb, rechts zeigt es später wieder. Tipp auf ein Foto startet dort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Up keeps, left moves to trash, right shows it again later. Tap a photo to start there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arriba conserva, a la izquierda va a la papelera y a la derecha vuelve más tarde. Toca una foto para empezar ahí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Haut pour garder, gauche pour la corbeille, droite pour plus tard. Touche une photo pour commencer là."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ke atas menyimpan, ke kiri memindahkan ke sampah, ke kanan menampilkannya lagi nanti. Ketuk foto untuk mulai dari situ."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su per conservare, a sinistra nel cestino, a destra per più tardi. Tocca una foto per iniziare da lì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上で残す、左でゴミ箱、右であとで表示。写真をタップするとそこから始めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위는 보관, 왼쪽은 휴지통, 오른쪽은 나중에 다시 보기예요. 사진을 탭하면 거기서 시작해요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opp beholder, venstre flytter til papirkurven, høyre viser det igjen senere. Trykk på et bilde for å starte der."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omhoog bewaart, links naar de prullenbak, rechts voor later. Tik op een foto om daar te beginnen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W górę zachowuje, w lewo do kosza, w prawo na później. Stuknij zdjęcie, aby zacząć od niego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para cima mantém, para a esquerda vai para a lixeira, para a direita mostra de novo depois. Toque numa foto para começar por ela."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para cima mantém, para a esquerda vai para o lixo, para a direita volta mais tarde. Toca numa fotografia para começar aí."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În sus păstrează, la stânga în coș, la dreapta pentru mai târziu. Atinge o fotografie ca să începi de acolo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вверх — оставить, влево — в корзину, вправо — на потом. Нажми на фото, чтобы начать с него."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Upp behåller, vänster flyttar till papperskorgen, höger visar den igen senare. Tryck på en bild för att börja där."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปัดขึ้นเพื่อเก็บไว้ ปัดซ้ายเพื่อย้ายไปถังขยะ ปัดขวาเพื่อแสดงอีกครั้งภายหลัง แตะรูปเพื่อเริ่มจากตรงนั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yukarı saklar, sol çöp kutusuna atar, sağ sonra tekrar gösterir. Oradan başlamak için bir fotoğrafa dokun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вгору — залишити, ліворуч — у кошик, праворуч — на потім. Торкнися фото, щоб почати з нього."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lên để giữ, trái để chuyển vào thùng rác, phải để xem lại sau. Chạm vào một ảnh để bắt đầu từ đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向上保留，向左放入回收站，向右稍后再看。点按一张照片即可从这里开始。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上滑保留，左滑移到垃圾桶，右滑稍後再顯示。點一下照片即可從那裡開始。"
          }
        }
      }
    },
    "ana2_swipe_hint_similar": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على مجموعة لمقارنتها، أو تصفّحها كلها واحدة تلو الأخرى بالسحب."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på en gruppe for at sammenligne den – eller swipe igennem dem alle efter hinanden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipp auf eine Gruppe zum Vergleichen – oder alle nacheinander durchwischen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a group to compare it – or swipe through all of them one after another."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un grupo para compararlo o repásalos todos seguidos deslizando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche un groupe pour le comparer – ou parcours-les tous à la suite."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk grup untuk membandingkannya – atau geser semuanya satu per satu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca un gruppo per confrontarlo, oppure scorrili tutti uno dopo l’altro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループをタップして比較するか、すべてを順にスワイプで確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그룹을 탭해 비교하거나 전체를 차례로 스와이프해 정리하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på en gruppe for å sammenligne den – eller sveip gjennom alle etter hverandre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op een groep om te vergelijken – of veeg ze allemaal na elkaar door."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij grupę, aby ją porównać – albo przejrzyj wszystkie po kolei gestami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque num grupo para compará-lo – ou deslize por todos, um após o outro."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca num grupo para o comparar – ou revê todos seguidos a deslizar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge un grup pentru comparare – sau parcurge-le pe toate, unul după altul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажми на группу, чтобы сравнить, – или пролистай все подряд."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på en grupp för att jämföra den – eller svep igenom alla i tur och ordning."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะกลุ่มเพื่อเปรียบเทียบ – หรือปัดดูทั้งหมดทีละกลุ่ม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karşılaştırmak için bir gruba dokun – ya da hepsini sırayla kaydırarak geç."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкнися групи, щоб порівняти, – або перегорни всі поспіль."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm vào một nhóm để so sánh – hoặc vuốt qua tất cả lần lượt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按一组进行比较，或依次滑动整理全部。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下群組即可比較 – 或依序滑動瀏覽全部。"
          }
        }
      }
    },
