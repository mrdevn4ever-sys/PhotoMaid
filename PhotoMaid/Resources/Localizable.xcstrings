    "org_basket_intro": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اجمع وسائط من أشهر ومجلدات مختلفة. تبقى السلة حتى تفرغها – ولا علاقة لها بسلة المهملات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sammle Fotos und Videos aus verschiedenen Monaten und Ordnern. Der Korb bleibt erhalten, bis du ihn leerst – mit dem Papierkorb hat er nichts zu tun."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Collect photos and videos from different months and folders. The basket stays until you empty it – it has nothing to do with the trash."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reúne contenido de distintos meses y carpetas. La cesta se mantiene hasta que la vacíes; no tiene nada que ver con la papelera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rassemble des médias de différents mois et dossiers. Le panier reste jusqu’à ce que tu le vides – il n’a rien à voir avec la corbeille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Raccogli contenuti da mesi e cartelle diversi. Il cestino resta finché non lo svuoti e non ha nulla a che fare con il cestino dei rifiuti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いろいろな月やフォルダからメディアを集めます。かごは空にするまで残り、ゴミ箱とは関係ありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여러 달과 폴더의 미디어를 모으세요. 바구니는 비울 때까지 유지되며 휴지통과는 관계없어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verzamel media uit verschillende maanden en mappen. De mand blijft tot je hem leegt – hij heeft niets met de prullenbak te maken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbieraj multimedia z różnych miesięcy i folderów. Koszyk zostaje, dopóki go nie opróżnisz – nie ma nic wspólnego z koszem."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Junta conteúdos de vários meses e pastas. O cesto mantém-se até o esvaziares – não tem nada a ver com o lixo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adună conținut din luni și dosare diferite. Coșul rămâne până îl golești – nu are legătură cu coșul de gunoi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Собирай медиа из разных месяцев и папок. Корзина сохраняется, пока ты её не очистишь, и не связана с корзиной для удалённых."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Farklı aylar ve klasörlerden medya topla. Sepet sen boşaltana kadar kalır – çöp kutusuyla ilgisi yoktur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збирай медіа з різних місяців і папок. Кошик зберігається, доки ти його не очистиш, і не пов’язаний із кошиком для видалених."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从不同月份和文件夹收集媒体。选择篮会一直保留，直到你清空它——它与回收站无关。"
          }
        }
      }
    },
