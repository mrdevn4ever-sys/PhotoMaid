          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre em qualquer dispositivo e app"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se deschide pe orice dispozitiv și în orice aplicație"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывается на любом устройстве и в любом приложении"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her cihazda ve her uygulamada açılır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкривається на будь-якому пристрої та в будь-якій програмі"
