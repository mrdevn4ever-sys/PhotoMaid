    "col_missing": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعض الصور لم تعد متاحة ولن تظهر."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nogle fotos findes ikke længere og er udeladt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Fotos sind nicht mehr vorhanden und fehlen in der Collage."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some photos are no longer available and are left out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
