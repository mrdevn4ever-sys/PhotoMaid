            "value": "ไม่สามารถเปลี่ยนสถานะรายการโปรดได้ สถานะยังคงเดิม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Favori işareti değiştirilemedi. Aynı kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося змінити позначку обраного. Вона залишилася без змін."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پسندیدہ حالت تبدیل نہیں ہو سکی۔ یہ پہلے جیسی رہے گی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể thay đổi trạng thái ưa thích. Nó vẫn như cũ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
