    "basket_empty_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يظهر هنا كل ما اخترت إزالته. اسحب صورة أو فيديو إلى اليسار لإضافته."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সরানোর জন্য আলাদা করে রাখা সবকিছু এখানে দেখা যায়। যোগ করতে কোনো ফটো বা ভিডিও বাঁয়ে সোয়াইপ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí apareix tot el que has apartat per eliminar. Llisca una foto o un vídeo cap a l’esquerra per afegir-lo."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tady se zobrazí vše, co jste odložili k odstranění. Přejetím fotky nebo videa doleva ho přidáte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt, hvad du har lagt til side til fjernelse, vises her. Swipe et foto eller en video til venstre for at tilføje det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier findest du alles, was du aussortiert hast. Fotos und Videos kommen mit einem Wisch nach links hierher."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εδώ εμφανίζονται όσα έβαλες στην άκρη για αφαίρεση. Σύρε μια φωτογραφία ή ένα βίντεο αριστερά για να το προσθέσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything you set aside for removal appears here. Swipe a photo or video left to add it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí aparece todo lo que has apartado para quitarlo. Desliza una foto o vídeo a la izquierda para añadirlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tässä näkyy kaikki, minkä olet siirtänyt syrjään poistettavaksi. Pyyhkäise kuva tai video vasemmalle lisätäksesi sen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu retrouves ici tout ce que tu as mis de côté pour le retirer. Glisse une photo ou vidéo vers la gauche pour l’ajouter."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "દૂર કરવા માટે અલગ રાખેલું બધું અહીં દેખાય છે. ઉમેરવા માટે ફોટો કે વીડિયોને ડાબે સ્વાઇપ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כאן מופיע כל מה שהעברת הצידה להסרה. אפשר להחליק תמונה או סרטון שמאלה כדי להוסיף."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हटाने के लिए अलग रखी हर चीज़ यहाँ दिखती है। जोड़ने के लिए किसी फ़ोटो या वीडियो को बाएँ स्वाइप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovdje se prikazuje sve što si odvojio za uklanjanje. Povuci fotografiju ili videozapis ulijevo da ga dodaš."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Itt jelenik meg minden, amit eltávolításra félretettél. Húzz balra egy fotót vagy videót a hozzáadáshoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua yang kamu sisihkan untuk dihapus muncul di sini. Geser foto atau video ke kiri untuk menambahkannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui trovi tutto ciò che hai scelto di rimuovere. Scorri una foto o un video verso sinistra per aggiungerlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除するために選んだものがここに表示されます。写真や動画を左にスワイプすると追加できます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ತೆಗೆದುಹಾಕಲು ನೀವು ಪಕ್ಕಕ್ಕಿಟ್ಟ ಎಲ್ಲವೂ ಇಲ್ಲಿ ಕಾಣಿಸುತ್ತದೆ. ಸೇರಿಸಲು ಫೋಟೋ ಅಥವಾ ವೀಡಿಯೊವನ್ನು ಎಡಕ್ಕೆ ಸ್ವೈಪ್ ಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제하려고 골라 둔 항목이 여기에 표시돼요. 사진이나 동영상을 왼쪽으로 밀어 추가하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നീക്കം ചെയ്യാൻ മാറ്റിവച്ചതെല്ലാം ഇവിടെ കാണാം. ചേർക്കാൻ ഒരു ഫോട്ടോ അല്ലെങ്കിൽ വീഡിയോ ഇടത്തേക്ക് സ്വൈപ്പ് ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "काढण्यासाठी बाजूला ठेवलेले सर्व इथे दिसते. जोडण्यासाठी फोटो किंवा व्हिडिओ डावीकडे स्वाइप करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua yang anda ketepikan untuk dibuang dipaparkan di sini. Leret foto atau video ke kiri untuk menambahnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt du har lagt til side for fjerning, vises her. Sveip et bilde eller en video til venstre for å legge det til."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier staat alles wat je wilt verwijderen. Veeg een foto of video naar links om die toe te voegen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ହଟାଇବା ପାଇଁ ଅଲଗା ରଖାଯାଇଥିବା ସବୁକିଛି ଏଠାରେ ଦେଖାଯାଏ। ଯୋଗ କରିବାକୁ ଏକ ଫଟୋ କିମ୍ବା ଭିଡିଓକୁ ବାମକୁ ସ୍ୱାଇପ୍ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹਟਾਉਣ ਲਈ ਵੱਖ ਰੱਖੀ ਹਰ ਚੀਜ਼ ਇੱਥੇ ਦਿਸਦੀ ਹੈ। ਜੋੜਨ ਲਈ ਕਿਸੇ ਫ਼ੋਟੋ ਜਾਂ ਵੀਡੀਓ ਨੂੰ ਖੱਬੇ ਸਵਾਈਪ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu znajdziesz wszystko, co wybierzesz do usunięcia. Przesuń zdjęcie lub film w lewo, aby je dodać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que você separou para remover aparece aqui. Deslize uma foto ou vídeo para a esquerda para adicioná-lo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Aqui encontras tudo o que separaste para remover. Desliza uma foto ou vídeo para a esquerda para o adicionar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aici găsești tot ce ai ales să elimini. Glisează o fotografie sau un videoclip spre stânga pentru a-l adăuga."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь всё, что ты выбираешь для удаления. Смахни фото или видео влево, чтобы добавить его."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu sa zobrazí všetko, čo ste odložili na odstránenie. Potiahnutím fotky alebo videa doľava ho pridáte."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tukaj se prikaže vse, kar si odložil za odstranitev. Podrsaj fotografijo ali videoposnetek levo, da ga dodaš."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Allt du lagt undan för borttagning visas här. Svep en bild eller video åt vänster för att lägga till den."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அகற்ற ஒதுக்கிவைத்த அனைத்தும் இங்கே தோன்றும். சேர்க்க ஒரு புகைப்படம் அல்லது வீடியோவை இடப்புறம் ஸ்வைப் செய்யுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "తీసివేయడానికి పక్కన పెట్టినవన్నీ ఇక్కడ కనిపిస్తాయి. జోడించడానికి ఫోటో లేదా వీడియోను ఎడమకు స్వైప్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกอย่างที่คุณแยกไว้เพื่อนำออกจะปรากฏที่นี่ ปัดรูปภาพหรือวิดีโอไปทางซ้ายเพื่อเพิ่ม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaldırmak için ayırdığın her şey burada görünür. Eklemek için fotoğrafı veya videoyu sola kaydır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут є все, що ти вибираєш для видалення. Змахни фото або відео ліворуч, щоб додати його."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہٹانے کے لیے الگ رکھی ہر چیز یہاں دکھتی ہے۔ شامل کرنے کے لیے کسی تصویر یا ویڈیو کو بائیں سوائپ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi thứ bạn để riêng để xóa đều hiện ở đây. Vuốt ảnh hoặc video sang trái để thêm vào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你选出的待移除内容会出现在这里。向左滑动照片或视频即可加入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你準備移除的所有內容都會出現在這裡。將照片或影片向左滑即可加入。"
          }
        }
      }
    },
