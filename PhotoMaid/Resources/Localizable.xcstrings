    "offer_ads_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بطاقات إعلانية قابلة للتخطي بين العناصر، ولا تغطي فيديوهاتك أبدًا."
