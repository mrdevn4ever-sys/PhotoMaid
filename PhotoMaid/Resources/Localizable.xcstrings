        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appareil photo : colonne %1$lld, ligne %2$lld. Photo : colonne %3$lld, ligne %4$lld."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera: kolom %1$lld, baris %2$lld. Foto: kolom %3$lld, baris %4$lld."
