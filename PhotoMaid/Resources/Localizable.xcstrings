    "size_approx_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "«حوالي» = تقدير من صورك وفيديوهاتك المقاسة. لا يكشف iOS الحجم الدقيق لأصول iCloud إلا بعد التنزيل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "“প্রায়” = আপনার মাপা ফটো ও ভিডিও থেকে অনুমান। iOS iCloud মূল ফাইলের সঠিক আকার শুধু ডাউনলোডের পরে জানায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "«aprox.» = estimat a partir de les fotos i els vídeos mesurats. L’iOS només revela la mida exacta dels originals d’iCloud després de baixar-los."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "„cca“ = odhadnuto podle vašich změřených fotek a videí. iOS přesnou velikost originálů na iCloudu prozradí až po stažení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "“ca.” = anslået ud fra dine målte fotos og videoer. iOS viser først den præcise størrelse af iCloud-originaler efter download."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„ca.“ = geschätzt aus deinen gemessenen Fotos und Videos. Die genaue Größe von iCloud-Originalen nennt iOS erst nach dem Herunterladen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "«περ.» = εκτίμηση από τις μετρημένες φωτογραφίες και βίντεό σου. Το iOS δείχνει το ακριβές μέγεθος των πρωτοτύπων iCloud μόνο μετά τη λήψη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“approx.” = estimated from your measured photos and videos. iOS only reveals the exact size of iCloud originals after downloading."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«aprox.» = estimado a partir de tus fotos y vídeos medidos. iOS solo indica el tamaño exacto de los originales de iCloud tras descargarlos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "”n.” = arvioitu mitattujen kuviesi ja videoidesi perusteella. iOS kertoo iCloud-alkuperäisten tarkan koon vasta latauksen jälkeen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« env. » = estimé d’après tes photos et vidéos mesurées. iOS n’indique la taille exacte des originaux iCloud qu’après téléchargement."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "“આશરે” = તમારા માપેલા ફોટા અને વીડિયો પરથી અંદાજ. iOS iCloud મૂળ ફાઇલોનું ચોક્કસ કદ ડાઉનલોડ પછી જ જણાવે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "„בערך” = הערכה לפי התמונות והסרטונים שנמדדו. ‏iOS חושפת את הגודל המדויק של מקוריים ב-iCloud רק אחרי הורדה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“लगभग” = आपकी नापी गई फ़ोटो और वीडियो से अनुमान। iOS iCloud मूल फ़ाइलों का सही साइज़ डाउनलोड के बाद ही बताता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "„pribl.” = procijenjeno na temelju tvojih izmjerenih fotografija i videozapisa. iOS otkriva točnu veličinu iCloud originala tek nakon preuzimanja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "„kb.” = a lemért fotóid és videóid alapján becsült érték. Az iCloud-eredetik pontos méretét az iOS csak letöltés után árulja el."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "“sekitar” = diperkirakan dari foto dan video yang sudah diukur. iOS baru memberi tahu ukuran pasti asli iCloud setelah diunduh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«circa» = stimato dalle tue foto e dai tuoi video misurati. iOS indica la dimensione esatta degli originali iCloud solo dopo il download."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「約」＝計測済みの写真や動画からの推定です。iCloudのオリジナルの正確なサイズは、ダウンロード後にのみiOSが示します。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "“ಸುಮಾರು” = ನಿಮ್ಮ ಅಳೆದ ಫೋಟೋಗಳು ಮತ್ತು ವೀಡಿಯೊಗಳಿಂದ ಅಂದಾಜು. iCloud ಮೂಲಗಳ ನಿಖರ ಗಾತ್ರವನ್ನು iOS ಡೌನ್‌ಲೋಡ್ ನಂತರ ಮಾತ್ರ ತಿಳಿಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘약’ = 측정한 사진과 동영상을 바탕으로 한 추정치예요. iCloud 원본의 정확한 크기는 다운로드한 후에만 iOS가 알려 줘요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "“ഏകദേശം” = നിങ്ങളുടെ അളന്ന ഫോട്ടോകളിൽ നിന്നും വീഡിയോകളിൽ നിന്നും കണക്കാക്കിയത്. iCloud ഒറിജിനലുകളുടെ കൃത്യമായ വലുപ്പം ഡൗൺലോഡിന് ശേഷം മാത്രമേ iOS വെളിപ്പെടുത്തൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "“सुमारे” = तुमच्या मोजलेल्या फोटो आणि व्हिडिओंवरून अंदाज. iOS iCloud मूळ फाइल्सचा अचूक आकार डाउनलोडनंतरच सांगते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "“lebih kurang” = dianggarkan daripada foto dan video anda yang telah diukur. iOS hanya mendedahkan saiz tepat fail asal iCloud selepas dimuat turun."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "«ca.» = anslått ut fra de målte bildene og videoene dine. iOS viser den nøyaktige størrelsen på iCloud-originaler først etter nedlasting."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘ca.’ = geschat op basis van je gemeten foto’s en video’s. De exacte grootte van iCloud-originelen geeft iOS pas na het downloaden."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "“ପ୍ରାୟ” = ଆପଣଙ୍କ ମାପାଯାଇଥିବା ଫଟୋ ଓ ଭିଡିଓରୁ ଅନୁମାନ। iOS iCloud ମୂଳ ଫାଇଲ୍‌ର ସଠିକ୍ ଆକାର କେବଳ ଡାଉନଲୋଡ୍ ପରେ ଜଣାଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "“ਲਗਭਗ” = ਤੁਹਾਡੀਆਂ ਮਾਪੀਆਂ ਫ਼ੋਟੋਆਂ ਅਤੇ ਵੀਡੀਓ ਤੋਂ ਅੰਦਾਜ਼ਾ। iOS iCloud ਮੂਲਾਂ ਦਾ ਸਹੀ ਆਕਾਰ ਸਿਰਫ਼ ਡਾਊਨਲੋਡ ਤੋਂ ਬਾਅਦ ਦੱਸਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„ok.” = szacunek na podstawie zmierzonych zdjęć i filmów. Dokładny rozmiar oryginałów z iCloud iOS podaje dopiero po pobraniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“aprox.” = estimado a partir das suas fotos e vídeos medidos. O iOS só informa o tamanho exato de originais do iCloud depois do download."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "«aprox.» = estimado a partir das tuas fotografias e vídeos medidos. O iOS só indica o tamanho exato dos originais do iCloud depois de os descarregar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "„cca.” = estimat din fotografiile și videoclipurile tale măsurate. iOS arată dimensiunea exactă a originalelor din iCloud abia după descărcare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«≈» = оценка по измеренным фото и видео. Точный размер оригиналов в iCloud iOS сообщает только после загрузки."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "„cca“ = odhadnuté podľa vašich zmeraných fotiek a videí. iOS presnú veľkosť originálov na iCloude prezradí až po stiahnutí."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "»pribl.« = ocenjeno iz tvojih izmerjenih fotografij in videoposnetkov. iOS natančno velikost izvirnikov iCloud razkrije šele po prenosu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”ca” = uppskattat utifrån dina uppmätta bilder och videor. iOS visar den exakta storleken på iCloud-original först efter hämtning."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "“சுமார்” = உங்கள் அளவிட்ட புகைப்படங்கள், வீடியோக்களிலிருந்து மதிப்பீடு. iCloud அசல்களின் சரியான அளவை iOS பதிவிறக்கிய பின்னரே காட்டும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "“సుమారు” = మీ కొలిచిన ఫోటోలు, వీడియోల నుండి అంచనా. iCloud ఒరిజినల్‌ల ఖచ్చితమైన పరిమాణాన్ని iOS డౌన్‌లోడ్ తర్వాత మాత్రమే చెబుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "“ประมาณ” = ประมาณการจากรูปภาพและวิดีโอที่วัดแล้ว iOS จะบอกขนาดที่แน่นอนของต้นฉบับใน iCloud หลังดาวน์โหลดเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“yaklaşık” = ölçülmüş fotoğraf ve videolarından tahmin edilir. iOS, iCloud orijinallerinin tam boyutunu ancak indirdikten sonra gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«≈» = оцінка за виміряними фото й відео. Точний розмір оригіналів в iCloud iOS повідомляє лише після завантаження."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "”تقریباً“ = آپ کی ناپی گئی تصاویر اور ویڈیوز سے اندازہ۔ iOS iCloud اصل فائلوں کا درست سائز ڈاؤن لوڈ کے بعد ہی بتاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "“khoảng” = ước tính từ ảnh và video đã đo của bạn. iOS chỉ cho biết kích thước chính xác của bản gốc iCloud sau khi tải về."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“约”= 根据你已测量的照片和视频估算。iCloud 原件的确切大小只有下载后 iOS 才会提供。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「約」= 根據你已測量的照片和影片估計。iOS 只有在下載後才會提供 iCloud 原始檔的確切大小。"
          }
        }
      }
    },
