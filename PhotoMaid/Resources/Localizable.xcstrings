    "col_intro": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر مجموعة لمراجعة الصور والفيديوهات المطابقة. لا يُحذف شيء تلقائيًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine Sammlung und sieh dir die passenden Fotos und Videos an. Gelöscht wird nichts automatisch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a collection to review matching photos and videos. Nothing is deleted automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una colección para revisar las fotos y los vídeos que coincidan. No se borra nada automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis une collection pour voir les photos et vidéos correspondantes. Rien n’est supprimé automatiquement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una raccolta per controllare le foto e i video corrispondenti. Nulla viene eliminato automaticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コレクションを選んで、条件に合う写真や動画を確認しましょう。自動で削除されることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모음을 선택해 조건에 맞는 사진과 동영상을 확인하세요. 자동으로 삭제하지 않아요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een verzameling om passende foto’s en video’s te bekijken. Er wordt niets automatisch verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz kolekcję i przejrzyj pasujące zdjęcia oraz filmy. Nic nie jest usuwane automatycznie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe uma coleção para veres as fotos e os vídeos correspondentes. Nada é eliminado automaticamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege o colecție și verifică fotografiile și videoclipurile potrivite. Nimic nu este șters automat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбери подборку и просмотри подходящие фото и видео. Ничего не удаляется автоматически."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir koleksiyon seçip eşleşen fotoğraf ve videoları incele. Hiçbir şey otomatik silinmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибери добірку й переглянь відповідні фото та відео. Нічого не видаляється автоматично."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择合集，查看符合条件的照片和视频。不会自动删除任何内容。"
          }
        }
      }
    },
