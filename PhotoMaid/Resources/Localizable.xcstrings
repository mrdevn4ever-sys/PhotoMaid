            "state": "translated",
            "value": "Muokattu kuva. Näet alkuperäisen pitämällä painettuna."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo modifiée. Maintiens le doigt pour voir l’original."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફેરફાર કરેલો ફોટો. મૂળ જોવા દબાવી રાખો."
