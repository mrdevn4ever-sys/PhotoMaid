    "org_albums_empty_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجمع الألبوم الصور ومقاطع الفيديو من أي مجلد دون نسخها أو نقلها. يمكن أن تكون الصورة في عدة ألبومات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Album sammelt Fotos und Videos aus beliebigen Ordnern, ohne sie zu kopieren oder zu verschieben. Ein Foto kann in mehreren Alben sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An album collects photos and videos from any folder without copying or moving them. A photo can be in several albums."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un álbum reúne fotos y vídeos de cualquier carpeta sin copiarlos ni moverlos. Una foto puede estar en varios álbumes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un album rassemble des photos et vidéos de n’importe quel dossier, sans les copier ni les déplacer. Une photo peut figurer dans plusieurs albums."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un album raccoglie foto e video da qualsiasi cartella senza copiarli né spostarli. Una foto può stare in più album."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アルバムは、どのフォルダの写真や動画もコピーや移動をせずにまとめます。1枚の写真を複数のアルバムに入れられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앨범은 어느 폴더의 사진과 동영상이든 복사하거나 옮기지 않고 모아 줘요. 사진 한 장을 여러 앨범에 넣을 수 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een album verzamelt foto’s en video’s uit elke map, zonder ze te kopiëren of te verplaatsen. Een foto kan in meerdere albums staan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Album zbiera zdjęcia i filmy z dowolnych folderów bez kopiowania ani przenoszenia. Jedno zdjęcie może być w kilku albumach."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um álbum reúne fotos e vídeos de qualquer pasta sem os copiar nem mover. Uma foto pode estar em vários álbuns."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un album adună fotografii și videoclipuri din orice dosar, fără să le copieze sau să le mute. O fotografie poate fi în mai multe albume."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Альбом собирает фото и видео из любых папок, не копируя и не перемещая их. Одно фото может быть в нескольких альбомах."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Albüm, her klasörden fotoğraf ve videoları kopyalamadan veya taşımadan bir araya getirir. Bir fotoğraf birden fazla albümde olabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Альбом збирає фото й відео з будь-яких папок, не копіюючи й не переміщуючи їх. Одне фото може бути в кількох альбомах."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相册可以汇集任意文件夹中的照片和视频，无需复制或移动。一张照片可以同时在多个相册中。"
          }
        }
      }
    },
