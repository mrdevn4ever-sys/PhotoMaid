    "share_prepare_failed_all": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن مشاركة الصور والفيديوهات المحددة الآن. تحقّق من الاتصال بـ iCloud وحاول مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নির্বাচিত ফটো ও ভিডিও এখন শেয়ার করা যায় না। iCloud-এর সাথে সংযোগ দেখে আবার চেষ্টা করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ara no es poden compartir les fotos i els vídeos seleccionats. Comprova la connexió amb iCloud i torna-ho a provar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vybrané fotky a videa teď nelze sdílet. Zkontrolujte připojení k iCloudu a zkuste to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De valgte fotos og videoer kan ikke deles lige nu. Tjek forbindelsen til iCloud, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ausgewählten Fotos und Videos lassen sich gerade nicht teilen. Prüfe die Verbindung zu iCloud und versuche es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι επιλεγμένες φωτογραφίες και τα βίντεο δεν μπορούν να κοινοποιηθούν τώρα. Έλεγξε τη σύνδεση με το iCloud και δοκίμασε ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected photos and videos can’t be shared right now. Check the connection to iCloud and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora no se pueden compartir las fotos y vídeos seleccionados. Comprueba la conexión con iCloud e inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valittuja kuvia ja videoita ei voi jakaa juuri nyt. Tarkista iCloud-yhteys ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos et vidéos sélectionnées ne peuvent pas être partagées pour le moment. Vérifie la connexion à iCloud et réessaie."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પસંદ કરેલા ફોટા અને વીડિયો અત્યારે શેર થઈ શકતા નથી. iCloud સાથેનું કનેક્શન તપાસો અને ફરી પ્રયાસ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אי אפשר לשתף כרגע את התמונות והסרטונים שנבחרו. כדאי לבדוק את החיבור ל-iCloud ולנסות שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुनी गई फ़ोटो और वीडियो अभी शेयर नहीं किए जा सकते। iCloud से कनेक्शन जाँचें और फिर कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odabrane fotografije i videozapisi trenutačno se ne mogu podijeliti. Provjeri vezu s iCloudom i pokušaj ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kijelölt fotók és videók most nem oszthatók meg. Ellenőrizd az iCloud-kapcsolatot, és próbáld újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto dan video yang dipilih tidak dapat dibagikan sekarang. Periksa koneksi ke iCloud dan coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al momento non è possibile condividere le foto e i video selezionati. Controlla la connessione a iCloud e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した写真と動画は今は共有できません。iCloudへの接続を確認して、もう一度お試しください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆಯ್ಕೆಮಾಡಿದ ಫೋಟೋಗಳು ಮತ್ತು ವೀಡಿಯೊಗಳನ್ನು ಈಗ ಹಂಚಿಕೊಳ್ಳಲು ಸಾಧ್ಯವಿಲ್ಲ. iCloud ಸಂಪರ್ಕ ಪರಿಶೀಲಿಸಿ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 사진과 동영상을 지금은 공유할 수 없어요. iCloud 연결을 확인하고 다시 시도하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "തിരഞ്ഞെടുത്ത ഫോട്ടോകളും വീഡിയോകളും ഇപ്പോൾ പങ്കിടാനാകില്ല. iCloud-ലേക്കുള്ള കണക്ഷൻ പരിശോധിച്ച് വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "निवडलेले फोटो आणि व्हिडिओ आत्ता शेअर करता येत नाहीत. iCloud शी कनेक्शन तपासा आणि पुन्हा प्रयत्न करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto dan video yang dipilih tidak dapat dikongsi sekarang. Semak sambungan ke iCloud dan cuba lagi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "De valgte bildene og videoene kan ikke deles akkurat nå. Sjekk forbindelsen til iCloud og prøv igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De geselecteerde foto’s en video’s kunnen nu niet worden gedeeld. Controleer de verbinding met iCloud en probeer het opnieuw."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ବଛାଯାଇଥିବା ଫଟୋ ଓ ଭିଡିଓ ବର୍ତ୍ତମାନ ସେୟାର୍ କରାଯାଇପାରିବ ନାହିଁ। iCloud ସହ ସଂଯୋଗ ଯାଞ୍ଚ କରି ପୁଣି ଚେଷ୍ଟା କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਚੁਣੀਆਂ ਫ਼ੋਟੋਆਂ ਅਤੇ ਵੀਡੀਓ ਇਸ ਵੇਲੇ ਸਾਂਝੀਆਂ ਨਹੀਂ ਕੀਤੀਆਂ ਜਾ ਸਕਦੀਆਂ। iCloud ਨਾਲ ਕਨੈਕਸ਼ਨ ਜਾਂਚੋ ਅਤੇ ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można teraz udostępnić wybranych zdjęć i filmów. Sprawdź połączenie z iCloud i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As fotos e vídeos selecionados não podem ser compartilhados agora. Verifique a conexão com o iCloud e tente de novo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível partilhar as fotos e vídeos selecionados de momento. Verifica a ligação ao iCloud e tenta novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografiile și videoclipurile selectate nu pot fi distribuite acum. Verifică conexiunea la iCloud și încearcă din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас невозможно поделиться выбранными фото и видео. Проверьте подключение к iCloud и повторите попытку."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vybraté fotky a videá teraz nemožno zdieľať. Skontrolujte pripojenie k iCloudu a skúste to znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izbranih fotografij in videoposnetkov trenutno ni mogoče deliti. Preveri povezavo z iCloudom in poskusi znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De valda bilderna och videorna kan inte delas just nu. Kontrollera anslutningen till iCloud och försök igen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தேர்ந்தெடுத்த புகைப்படங்களையும் வீடியோக்களையும் இப்போது பகிர முடியாது. iCloud இணைப்பைச் சரிபார்த்து மீண்டும் முயலுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఎంచుకున్న ఫోటోలు, వీడియోలను ఇప్పుడు షేర్ చేయడం సాధ్యం కాదు. iCloud కనెక్షన్ తనిఖీ చేసి మళ్లీ ప్రయత్నించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถแชร์รูปภาพและวิดีโอที่เลือกได้ในขณะนี้ ตรวจสอบการเชื่อมต่อกับ iCloud แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen fotoğraf ve videolar şu anda paylaşılamıyor. iCloud bağlantısını kontrol edip tekrar dene."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зараз неможливо поділитися вибраними фото й відео. Перевірте з’єднання з iCloud і спробуйте ще раз."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "منتخب تصاویر اور ویڈیوز ابھی شیئر نہیں ہو سکتیں۔ iCloud سے کنکشن چیک کریں اور دوبارہ کوشش کریں۔"
