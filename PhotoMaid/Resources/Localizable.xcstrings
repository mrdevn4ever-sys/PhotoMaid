    "ana2_queue_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يُلغى التحليل الجاري أبدًا: «تشغيل هذا أولًا» يوقفه مؤقتًا فقط، ثم يستأنف من تلقاء نفسه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "চলমান বিশ্লেষণ কখনো বাতিল হয় না: “আগে এটি চালান” শুধু এটিকে থামিয়ে রাখে, পরে এটি নিজে থেকেই চলতে থাকে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’anàlisi en curs no es cancel·la mai: «Executar primer» només la posa en pausa, i després continua sola."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Probíhající analýza se nikdy neruší: „Spustit nejdřív“ ji jen pozastaví a potom sama pokračuje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En igangværende analyse annulleres aldrig: “Kør denne først” sætter den kun på pause, og den fortsætter derefter af sig selv."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die laufende Analyse wird nicht abgebrochen: „Jetzt zuerst“ hält sie nur an, danach läuft sie von selbst weiter."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η τρέχουσα ανάλυση δεν ακυρώνεται ποτέ: το «Εκτέλεση πρώτα» απλώς την παύει και μετά συνεχίζει μόνη της."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The running analysis is never cancelled: “Run this first” only pauses it, and it continues by itself afterwards."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El análisis en curso nunca se cancela: «Primero esta» solo lo pausa y después continúa solo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käynnissä olevaa analyysia ei koskaan peruta: ”Suorita ensin” vain keskeyttää sen, ja se jatkuu sen jälkeen itsestään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’analyse en cours n’est jamais annulée : « D’abord celle-ci » la met seulement en pause, puis elle reprend d’elle-même."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ચાલુ વિશ્લેષણ ક્યારેય રદ થતું નથી: “પહેલાં આ ચલાવો” તેને ફક્ત થોભાવે છે, અને પછી તે આપમેળે ચાલુ થાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הניתוח הפעיל אף פעם לא מבוטל: „להריץ קודם” רק משהה אותו, והוא ממשיך מעצמו אחר כך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चल रहा विश्लेषण कभी रद्द नहीं होता: “पहले इसे चलाएँ” उसे सिर्फ़ रोकता है, और उसके बाद वह खुद आगे चलता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiza u tijeku nikad se ne prekida: „Pokreni ovo prvo” samo je pauzira, a poslije se sama nastavlja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A futó elemzés sosem szakad meg: a „Futtatás előbb” csak szünetelteti, utána magától folytatódik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Analisis yang berjalan tidak pernah dibatalkan: “Jalankan ini dulu” hanya menjedanya, lalu analisis berlanjut sendiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’analisi in corso non viene mai annullata: «Prima questa» la mette solo in pausa, poi riprende da sola."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行中の分析は中止されません。「先にこれを実行」は一時停止するだけで、その後自動で再開します。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಡೆಯುತ್ತಿರುವ ವಿಶ್ಲೇಷಣೆ ಎಂದಿಗೂ ರದ್ದಾಗುವುದಿಲ್ಲ: “ಮೊದಲು ಇದನ್ನು ರನ್ ಮಾಡಿ” ಅದನ್ನು ವಿರಾಮಗೊಳಿಸುತ್ತದೆ ಮಾತ್ರ, ನಂತರ ಅದು ತಾನಾಗಿಯೇ ಮುಂದುವರಿಯುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진행 중인 분석은 취소되지 않아요. ‘이것 먼저’는 잠시 멈출 뿐이고 이후 자동으로 이어져요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നടക്കുന്ന വിശകലനം ഒരിക്കലും റദ്ദാകില്ല: “ആദ്യം ഇത് പ്രവർത്തിപ്പിക്കുക” അതിനെ താൽക്കാലികമായി നിർത്തുക മാത്രം ചെയ്യുന്നു, പിന്നീട് അത് സ്വയം തുടരും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सुरू असलेले विश्लेषण कधीही रद्द होत नाही: “आधी हे चालवा” ते फक्त थांबवते, आणि नंतर ते आपोआप सुरू राहते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Analisis yang sedang berjalan tidak pernah dibatalkan: “Jalankan ini dahulu” hanya menjedanya, dan ia bersambung sendiri selepas itu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En pågående analyse avbrytes aldri: «Kjør denne først» setter den bare på pause, og den fortsetter av seg selv etterpå."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De lopende analyse wordt nooit afgebroken: ‘Eerst deze’ pauzeert hem alleen, daarna gaat hij vanzelf verder."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଚାଲୁଥିବା ବିଶ୍ଳେଷଣ କେବେ ବାତିଲ ହୁଏ ନାହିଁ: “ପ୍ରଥମେ ଏହା ଚଳାନ୍ତୁ” ଏହାକୁ କେବଳ ବିରତି ଦିଏ, ଏବଂ ପରେ ଏହା ନିଜେ ଜାରି ରହେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਚੱਲ ਰਿਹਾ ਵਿਸ਼ਲੇਸ਼ਣ ਕਦੇ ਰੱਦ ਨਹੀਂ ਹੁੰਦਾ: “ਪਹਿਲਾਂ ਇਹ ਚਲਾਓ” ਇਸਨੂੰ ਸਿਰਫ਼ ਰੋਕਦਾ ਹੈ, ਅਤੇ ਫਿਰ ਇਹ ਆਪਣੇ ਆਪ ਜਾਰੀ ਰਹਿੰਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trwająca analiza nigdy nie jest przerywana: „Najpierw ta” tylko ją wstrzymuje, potem wznowi się sama."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A análise em andamento nunca é cancelada: “Executar esta primeiro” apenas a pausa, e ela continua sozinha depois."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A análise em curso nunca é cancelada: «Primeiro esta» apenas a pausa e depois continua sozinha."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiza în curs nu este anulată niciodată: „Mai întâi aceasta” doar o întrerupe, apoi continuă singură."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текущий анализ никогда не отменяется: «Сначала эту» лишь приостанавливает его, потом он продолжится сам."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prebiehajúca analýza sa nikdy neruší: „Spustiť najprv“ ju len pozastaví a potom sama pokračuje."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiza, ki teče, se nikoli ne prekliče: »Najprej zaženi to« jo le začasno ustavi, nato pa se sama nadaljuje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En pågående analys avbryts aldrig: ”Kör den här först” pausar den bara, och den fortsätter sedan av sig själv."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நடந்துகொண்டிருக்கும் பகுப்பாய்வு ஒருபோதும் ரத்தாகாது: “முதலில் இதை இயக்குங்கள்” அதை இடைநிறுத்த மட்டுமே செய்கிறது, பின்னர் அது தானாகவே தொடரும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "జరుగుతున్న విశ్లేషణ ఎప్పుడూ రద్దు కాదు: “ముందు దీన్ని రన్ చేయండి” దాన్ని పాజ్ మాత్రమే చేస్తుంది, తర్వాత అది తనంతట తానే కొనసాగుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การวิเคราะห์ที่กำลังทำอยู่จะไม่ถูกยกเลิก: “ทำอันนี้ก่อน” แค่หยุดไว้ชั่วคราว แล้วจะทำต่อเองภายหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalışan analiz asla iptal edilmez: “Önce bunu” onu yalnızca duraklatır, sonra kendiliğinden devam eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поточний аналіз ніколи не скасовується: «Спершу цей» лише призупиняє його, потім він продовжиться сам."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جاری تجزیہ کبھی منسوخ نہیں ہوتا: ”پہلے یہ چلائیں“ اسے صرف روکتا ہے، اور اس کے بعد یہ خود جاری رہتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phân tích đang chạy không bao giờ bị hủy: “Chạy cái này trước” chỉ tạm dừng nó, sau đó nó tự tiếp tục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在进行的分析不会被取消：“先运行这个”只会暂停它，之后它会自动继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "進行中的分析永遠不會取消：「先執行這項」只會暫停它，之後它會自動繼續。"
          }
        }
      }
    },
