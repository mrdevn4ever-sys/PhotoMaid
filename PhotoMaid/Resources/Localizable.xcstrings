        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元の写真をAndroidのゴミ箱に移動してよいか、Androidが一度確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android가 원본을 Android 휴지통으로 옮겨도 되는지 한 번 물어봐요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
