    "vault_code_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الرمز هو مفتاح الخزنة. اختر رمزًا لا يخمّنه الآخرون – ويُفضّل ألا يكون رمز دخول iPhone."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই কোডটিই ভল্টের চাবি। এমন একটি বেছে নিন যা অন্যরা অনুমান করতে পারবে না – সম্ভব হলে আপনার iPhone পাসকোড নয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquest codi és la clau de la caixa forta. Tria’n un que els altres no endevinin; millor que no sigui el codi de l’iPhone."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento kód je klíčem k trezoru. Zvolte takový, který ostatní neuhodnou – ideálně ne kód vašeho iPhonu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne kode er nøglen til boksen. Vælg en, som andre ikke gætter – helst ikke din iPhone-kode."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Code ist der Schlüssel zum Tresor. Wähle einen, den andere nicht erraten – am besten nicht deinen iPhone-Code."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτός ο κωδικός είναι το κλειδί του θησαυροφυλακίου. Διάλεξε έναν που δεν θα μαντέψουν άλλοι – καλύτερα όχι τον κωδικό του iPhone σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This code is the key to the vault. Choose one that others won’t guess – ideally not your iPhone passcode."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este código es la llave de la caja fuerte. Elige uno que otros no adivinen; mejor que no sea el código de tu iPhone."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä koodi on holvin avain. Valitse sellainen, jota muut eivät arvaa – mieluiten ei iPhonesi pääsykoodi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce code est la clé du coffre-fort. Choisis-en un que les autres ne devineront pas – idéalement pas le code de ton iPhone."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ કોડ વૉલ્ટની ચાવી છે. એવો પસંદ કરો જેનો બીજા અંદાજ ન લગાવી શકે – શક્ય હોય તો તમારા iPhone નો પાસકોડ નહીં."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקוד הזה הוא המפתח לכספת. כדאי לבחור קוד שאחרים לא ינחשו – רצוי לא את קוד ה-iPhone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह कोड तिजोरी की चाबी है। ऐसा चुनें जिसका दूसरे अंदाज़ा न लगा सकें – बेहतर है कि यह आपके iPhone का पासकोड न हो।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj je kôd ključ trezora. Odaberi onaj koji drugi neće pogoditi – najbolje ne kôd tvog iPhonea."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a kód a széf kulcsa. Olyat válassz, amit mások nem találnak ki – lehetőleg ne az iPhone-od jelkódját."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kode ini adalah kunci brankas. Pilih yang tidak mudah ditebak orang lain – sebaiknya bukan kode sandi iPhone-mu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo codice è la chiave della cassaforte. Scegline uno che gli altri non possano indovinare, possibilmente non il codice del tuo iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコードが保管庫の鍵になります。他人に推測されにくいものを選んでください。iPhoneのパスコードとは別のものがおすすめです。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಕೋಡ್ ವಾಲ್ಟ್‌ನ ಕೀಲಿ. ಇತರರು ಊಹಿಸಲಾಗದಂತಹದನ್ನು ಆಯ್ಕೆಮಾಡಿ – ಸಾಧ್ಯವಾದರೆ ನಿಮ್ಮ iPhone ಪಾಸ್‌ಕೋಡ್ ಅಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 암호가 금고의 열쇠입니다. 다른 사람이 추측하기 어려운 암호를 선택하세요. iPhone 암호와 다른 것이 좋습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ കോഡ് വോൾട്ടിന്റെ താക്കോലാണ്. മറ്റുള്ളവർ ഊഹിക്കാത്ത ഒന്ന് തിരഞ്ഞെടുക്കുക – കഴിയുമെങ്കിൽ നിങ്ങളുടെ iPhone പാസ്‌കോഡ് അല്ലാത്തത്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हा कोड व्हॉल्टची किल्ली आहे. इतरांना अंदाज लावता येणार नाही असा निवडा – शक्यतो तुमच्या iPhone चा पासकोड नको."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod ini ialah kunci peti besi. Pilih kod yang tidak dapat diteka orang lain – sebaiknya bukan kod laluan iPhone anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne koden er nøkkelen til safen. Velg en som andre ikke gjetter – helst ikke iPhone-koden din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze code is de sleutel tot de kluis. Kies er een die anderen niet raden – liefst niet je iPhone-toegangscode."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହି କୋଡ୍ ଭଲ୍ଟର ଚାବି। ଅନ୍ୟମାନେ ଅନୁମାନ କରିପାରିବେ ନାହିଁ ଏମିତି ଗୋଟିଏ ବାଛନ୍ତୁ – ସମ୍ଭବ ହେଲେ ଆପଣଙ୍କ iPhone ପାସକୋଡ୍ ନୁହେଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਕੋਡ ਵੌਲਟ ਦੀ ਚਾਬੀ ਹੈ। ਅਜਿਹਾ ਚੁਣੋ ਜਿਸ ਦਾ ਦੂਜੇ ਅੰਦਾਜ਼ਾ ਨਾ ਲਗਾ ਸਕਣ – ਬਿਹਤਰ ਹੈ ਤੁਹਾਡਾ iPhone ਪਾਸਕੋਡ ਨਾ ਹੋਵੇ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten kod jest kluczem do sejfu. Wybierz taki, którego inni nie odgadną – najlepiej inny niż kod dostępu do iPhone’a."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este código é a chave do cofre. Escolha um que outras pessoas não adivinhem – de preferência diferente do código do seu iPhone."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este código é a chave do cofre. Escolhe um que os outros não adivinhem – de preferência, não o código do teu iPhone."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest cod este cheia seifului. Alege unul pe care alții nu-l pot ghici – ideal, nu codul de acces al iPhone-ului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот код — ключ к сейфу. Выбери такой, который другие не угадают, — лучше не код-пароль iPhone."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento kód je kľúčom k trezoru. Zvoľte taký, ktorý ostatní neuhádnu – ideálne nie kód vášho iPhonu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta koda je ključ do sefa. Izberi takšno, ki je drugi ne bodo uganili – najbolje ne kode tvojega iPhona."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här koden är nyckeln till valvet. Välj en som andra inte gissar – helst inte din iPhone-lösenkod."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தக் குறியீடே லாக்கரின் சாவி. மற்றவர்கள் ஊகிக்க முடியாத ஒன்றைத் தேர்ந்தெடுங்கள் – முடிந்தால் உங்கள் iPhone கடவுக்குறியீடு அல்லாதது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ కోడే వాల్ట్ తాళం చెవి. ఇతరులు ఊహించలేనిది ఎంచుకోండి – వీలైతే మీ iPhone పాస్‌కోడ్ కానిది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รหัสนี้คือกุญแจของตู้เซฟ เลือกรหัสที่คนอื่นเดาไม่ได้ – ควรไม่ใช่รหัสผ่าน iPhone ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kod kasanın anahtarıdır. Başkalarının tahmin edemeyeceği bir kod seç – tercihen iPhone parolan olmasın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей код — ключ до сейфа. Вибери такий, який інші не вгадають, — краще не код-пароль iPhone."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ کوڈ والٹ کی چابی ہے۔ ایسا منتخب کریں جس کا دوسرے اندازہ نہ لگا سکیں – بہتر ہے کہ یہ آپ کے iPhone کا پاس کوڈ نہ ہو۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mã này là chìa khóa của két sắt. Hãy chọn mã người khác khó đoán – tốt nhất không trùng mật mã iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此密码是保险箱的钥匙。请选择别人猜不到的密码——最好不要与 iPhone 锁屏密码相同。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個密碼是保險箱的鑰匙。請選擇別人猜不到的密碼 – 最好不要和 iPhone 密碼相同。"
          }
        }
      }
    },
