    "tour_months_later_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العناصر المؤجلة لوقت لاحق تُحسب كمراجعة، لكنك ما زلت تراها هنا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für später Zurückgestelltes zählt als durchgesehen – du siehst es hier trotzdem."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Items set aside for later count as reviewed – you still see them here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo dejado para después cuenta como revisado, pero lo sigues viendo aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui est remis à plus tard compte comme passé en revue – tu le vois quand même ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò che è rimandato conta come rivisto, ma lo vedi comunque qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「あとで」にしたものは見直し済みとして数えますが、ここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘나중에’로 미룬 항목은 확인한 것으로 세지만 여기에서 계속 보여요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat voor later is bewaard telt als bekeken – je ziet het hier toch."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odłożone na później liczą się jako przejrzane – nadal widzisz je tutaj."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O que ficou para mais tarde conta como revisto, mas continuas a vê-lo aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce ai amânat contează ca revizuit, dar îl vezi în continuare aici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отложенное на потом считается просмотренным, но ты всё равно видишь его здесь."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonraya bırakılanlar gözden geçirilmiş sayılır ama burada yine görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкладене на потім вважається переглянутим, але ти все одно бачиш його тут."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设为稍后的内容计为已查看，但仍会在这里显示。"
          }
        }
      }
    },
    "tour_months_later_title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "«لاحقًا» ليس مفتوحًا"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Später ist nicht offen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Later isn’t open"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después no está pendiente"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus tard n’est pas en attente"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Più tardi non è in sospeso"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「あとで」は未確認ではありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘나중에’는 미확인이 아니에요"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Later is niet open"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Później to nie zaległość"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais tarde não está pendente"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mai târziu nu e în așteptare"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Позже» — не непросмотренное"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonra bekleyen değil"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Пізніше» — не непереглянуте"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“稍后”不算未查看"
          }
        }
      }
    },
    "tour_months_more_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح النظرة العامة كشبكة أو راجع شهرًا مكتملًا مجددًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne die Übersicht als Raster oder sieh einen fertigen Monat erneut durch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the overview as a grid or review a finished month again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la vista general como cuadrícula o revisa de nuevo un mes terminado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre la vue d’ensemble en grille ou revois un mois terminé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri la panoramica a griglia o rivedi un mese completato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一覧をグリッドで開いたり、終わった月をもう一度見直したりできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한눈에 보기를 격자로 열거나 끝낸 달을 다시 볼 수 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open het overzicht als raster of bekijk een afgeronde maand opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz przegląd jako siatkę albo przejrzyj ukończony miesiąc ponownie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre a vista geral em grelha ou revê um mês concluído."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschide prezentarea ca grilă sau revizuiește din nou o lună terminată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открой обзор сеткой или пересмотри завершённый месяц."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Genel bakışı ızgara olarak aç veya biten bir ayı yeniden gözden geçir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрий огляд сіткою або переглянь завершений місяць знову."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以网格打开概览，或重新查看已完成的月份。"
          }
        }
      }
    },
    "tour_months_more_title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
