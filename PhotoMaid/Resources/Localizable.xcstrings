    "snake_board_position": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الكاميرا: العمود %1$lld، الصف %2$lld. الصورة: العمود %3$lld، الصف %4$lld."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera: kolonne %1$lld, række %2$lld. Foto: kolonne %3$lld, række %4$lld."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera: Spalte %1$lld, Zeile %2$lld. Foto: Spalte %3$lld, Zeile %4$lld."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera: column %1$lld, row %2$lld. Photo: column %3$lld, row %4$lld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cámara: columna %1$lld, fila %2$lld. Foto: columna %3$lld, fila %4$lld."
