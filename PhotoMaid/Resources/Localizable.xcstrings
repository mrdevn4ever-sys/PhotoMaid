    "vault_biometric_reason": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فتح المحتوى المحمي"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার সুরক্ষিত বিষয়বস্তু খুলুন"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Obre el teu contingut protegit"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevřete svůj chráněný obsah"
          }
        },
        "da": {
