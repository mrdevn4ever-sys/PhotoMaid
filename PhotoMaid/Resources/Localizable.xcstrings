    "pro_msg_rewarded": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تفعيل أدوات Pro لمدة 30 دقيقة. يظل حد الإزالة اليومي كما هو."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro-Funktionen sind für 30 Minuten freigeschaltet. Dein Tageslimit zum Entfernen bleibt gleich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro tools are unlocked for 30 minutes. Your daily removal limit stays the same."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las herramientas Pro están desbloqueadas durante 30 minutos. Tu límite diario para quitar elementos no cambia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les outils Pro sont débloqués pour 30 minutes. Ta limite quotidienne de retrait reste inchangée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli strumenti Pro sono sbloccati per 30 minuti. Il limite giornaliero di rimozione resta invariato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Proのツールを30分間使えます。1日の削除上限は変わりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "30분 동안 Pro 도구를 사용할 수 있어요. 하루 삭제 한도는 그대로예요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro-functies zijn 30 minuten ontgrendeld. Je daglimiet voor verwijderen blijft gelijk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Narzędzia Pro odblokowano na 30 minut. Twój dzienny limit usuwania pozostaje bez zmian."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As ferramentas Pro estão desbloqueadas durante 30 minutos. O limite diário de remoção não muda."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Instrumentele Pro sunt deblocate pentru 30 de minute. Limita zilnică de eliminare rămâne neschimbată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Инструменты Pro открыты на 30 минут. Дневной лимит удаления не меняется."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro araçları 30 dakikalığına açıldı. Günlük kaldırma sınırın aynı kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інструменти Pro відкрито на 30 хвилин. Денний ліміт видалення не змінюється."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro 工具已解锁，可使用 30 分钟。每日移除上限不变。"
          }
        }
      }
    },
