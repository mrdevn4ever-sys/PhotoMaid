      }
    },
    "ana2_cloud_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحمَّل صور iCloud كمعاينات صغيرة فقط عبر Wi-Fi. لا يتم رفع أي شيء."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud-fotos indlæses kun som små eksempler via Wi-Fi. Intet uploades."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud-Fotos werden nur als kleine Vorschau über WLAN geladen. Es wird nichts hochgeladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud photos are only loaded as small previews over Wi-Fi. Nothing is uploaded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos de iCloud solo se cargan como vistas previas pequeñas por Wi-Fi. No se sube nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos iCloud ne sont chargées qu’en petits aperçus via le Wi-Fi. Rien n’est envoyé."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto iCloud hanya dimuat sebagai pratinjau kecil lewat Wi-Fi. Tidak ada yang diunggah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le foto di iCloud vengono caricate solo come piccole anteprime tramite Wi-Fi. Non viene caricato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud写真はWi-Fi経由で小さなプレビューとしてのみ読み込まれます。何もアップロードされません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 사진은 Wi-Fi를 통해 작은 미리보기로만 불러옵니다. 아무것도 업로드되지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud-bilder lastes bare inn som små forhåndsvisninger via Wi-Fi. Ingenting lastes opp."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud-foto’s worden alleen als kleine voorvertoning via wifi geladen. Er wordt niets geüpload."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdjęcia z iCloud są wczytywane tylko jako małe podglądy przez Wi-Fi. Nic nie jest wysyłane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos do iCloud só são carregadas como pequenas prévias via Wi-Fi. Nada é enviado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As fotografias do iCloud só são carregadas como pequenas pré-visualizações por Wi-Fi. Nada é enviado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozele din iCloud se încarcă doar ca previzualizări mici prin Wi-Fi. Nu se încarcă nimic în cloud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото из iCloud загружаются только как небольшие превью по Wi-Fi. Ничего не выгружается."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud-bilder läses bara in som små förhandsvisningar via wifi. Inget laddas upp."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปภาพ iCloud จะโหลดเป็นภาพตัวอย่างขนาดเล็กผ่าน Wi-Fi เท่านั้น ไม่มีการอัปโหลดใดๆ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud fotoğrafları yalnızca Wi-Fi üzerinden küçük önizlemeler olarak yüklenir. Hiçbir şey karşıya yüklenmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото з iCloud завантажуються лише як невеликі прев’ю через Wi-Fi. Нічого не вивантажується."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh iCloud chỉ được tải dưới dạng bản xem trước nhỏ qua Wi-Fi. Không có gì được tải lên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 照片仅通过无线局域网以小预览形式载入。不会上传任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 照片只會透過 Wi-Fi 載入小型預覽。不會上傳任何內容。"
          }
        }
      }
    },
