    "pdf_capped": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld صورة كحد أقصى لكل PDF – تم أخذ أول %1$lld."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
