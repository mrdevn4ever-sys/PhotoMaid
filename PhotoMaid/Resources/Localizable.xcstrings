    "edit_pro_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "القص والتدوير والتسوية مجانية. تُحفظ التعديلات والفلاتر والحجم وقص الفيديو مع Pro. التجربة مجانية دائمًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Beskæring, rotation og udretning er gratis. Justeringer, filtre, størrelse og videoklipning gemmes med Pro. At prøve er altid gratis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuschneiden, Drehen und Begradigen sind kostenlos. Regler, Filter, Größe und Video kürzen speicherst du mit Pro. Ausprobieren ist immer kostenlos."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cropping, rotating and straightening are free. Adjustments, filters, size and video trimming save with Pro. Trying them out is always free."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recortar, girar y enderezar es gratis. Los ajustes, filtros, tamaño y recorte de vídeo se guardan con Pro. Probarlos siempre es gratis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recadrer, faire pivoter et redresser est gratuit. Les réglages, filtres, la taille et le découpage vidéo s’enregistrent avec Pro. Les essayer est toujours gratuit."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memotong, memutar, dan meluruskan gratis. Penyesuaian, filter, ukuran, dan pemangkasan video disimpan dengan Pro. Mencoba selalu gratis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ritagliare, ruotare e raddrizzare è gratis. Regolazioni, filtri, dimensioni e taglio video si salvano con Pro. Provarli è sempre gratis."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "切り取り、回転、傾き補正は無料です。調整、フィルタ、サイズ、ビデオのトリミングはProで保存できます。試すのはいつでも無料です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자르기, 회전, 수평 맞추기는 무료입니다. 조정, 필터, 크기, 비디오 다듬기는 Pro로 저장합니다. 사용해 보는 것은 언제나 무료입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Beskjæring, rotering og retting er gratis. Justeringer, filtre, størrelse og videoklipping lagres med Pro. Å prøve er alltid gratis."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bijsnijden, draaien en rechtzetten is gratis. Aanpassingen, filters, formaat en video inkorten bewaar je met Pro. Uitproberen is altijd gratis."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kadrowanie, obracanie i prostowanie są bezpłatne. Regulacje, filtry, rozmiar i przycinanie filmów zapiszesz z Pro. Wypróbowanie jest zawsze bezpłatne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cortar, girar e endireitar são grátis. Ajustes, filtros, tamanho e corte de vídeo são salvos com o Pro. Experimentar é sempre grátis."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Recortar, rodar e endireitar é gratuito. Ajustes, filtros, tamanho e corte de vídeo guardam-se com o Pro. Experimentar é sempre gratuito."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Decuparea, rotirea și îndreptarea sunt gratuite. Reglajele, filtrele, dimensiunea și scurtarea video se salvează cu Pro. Încercarea e mereu gratuită."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обрезка, поворот и выравнивание бесплатны. Настройки, фильтры, размер и обрезка видео сохраняются с Pro. Попробовать можно всегда бесплатно."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Beskära, rotera och räta upp är gratis. Justeringar, filter, storlek och videoklippning sparas med Pro. Att prova är alltid gratis."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การครอบตัด หมุน และปรับให้ตรงใช้ได้ฟรี การปรับแต่ง ฟิลเตอร์ ขนาด และการตัดวิดีโอบันทึกได้ด้วย Pro ลองใช้ได้ฟรีเสมอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kırpma, döndürme ve düzleştirme ücretsizdir. Ayarlar, filtreler, boyut ve video kırpma Pro ile kaydedilir. Denemek her zaman ücretsizdir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обрізання, поворот і вирівнювання безкоштовні. Налаштування, фільтри, розмір і обрізання відео зберігаються з Pro. Спробувати завжди безкоштовно."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cắt, xoay và làm thẳng miễn phí. Điều chỉnh, bộ lọc, kích thước và cắt video được lưu với Pro. Dùng thử luôn miễn phí."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "裁剪、旋转和拉直是免费的。调整、滤镜、尺寸和视频修剪需 Pro 才能存储。试用始终免费。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裁切、旋轉和拉直免費。調整、濾鏡、尺寸和影片剪輯需要 Pro 才能儲存。試用永遠免費。"
          }
        }
      }
    },
