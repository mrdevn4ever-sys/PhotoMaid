    "pdf_editor_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دمج الملفات وترتيب الصفحات وتدويرها"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফাইল জুড়ুন, পৃষ্ঠার ক্রম বদলান ও ঘোরান"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Combina fitxers, reordena i gira pàgines"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Spojování souborů, řazení a otáčení stránek"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kombinér filer, omarranger og roter sider"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien verbinden, Seiten sortieren und drehen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνένωση αρχείων, αναδιάταξη και περιστροφή σελίδων"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Combine files, reorder and rotate pages"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Combina archivos, ordena y gira páginas"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhdistä tiedostoja, järjestä ja kierrä sivuja"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assembler des fichiers, réorganiser et pivoter les pages"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફાઇલો જોડો, પાનાંનો ક્રમ બદલો અને ફેરવો"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "איחוד קבצים, שינוי סדר וסיבוב עמודים"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ाइलें जोड़ें, पेज का क्रम बदलें और घुमाएँ"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spajanje datoteka, redoslijed i okretanje stranica"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Fájlok összefűzése, oldalak átrendezése és forgatása"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gabungkan file, atur urutan dan putar halaman"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Unisci file, riordina e ruota le pagine"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルの結合、ページの並べ替えと回転"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಫೈಲ್‌ಗಳನ್ನು ಸೇರಿಸಿ, ಪುಟಗಳ ಕ್ರಮ ಬದಲಿಸಿ ಮತ್ತು ತಿರುಗಿಸಿ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 합치기, 페이지 정렬 및 회전"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഫയലുകൾ സംയോജിപ്പിക്കുക, പേജുകളുടെ ക്രമം മാറ്റുക, തിരിക്കുക"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फाइल्स जोडा, पानांचा क्रम बदला आणि फिरवा"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gabungkan fail, susun semula dan putar halaman"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kombiner filer, endre rekkefølge og roter sider"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestanden combineren, pagina’s ordenen en draaien"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଫାଇଲ୍ ଯୋଡ଼ନ୍ତୁ, ପୃଷ୍ଠାର କ୍ରମ ବଦଳାନ୍ତୁ ଓ ଘୁରାନ୍ତୁ"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਫ਼ਾਈਲਾਂ ਜੋੜੋ, ਪੰਨਿਆਂ ਦਾ ਕ੍ਰਮ ਬਦਲੋ ਅਤੇ ਘੁਮਾਓ"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Łącz pliki, porządkuj i obracaj strony"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Juntar arquivos, reordenar e girar páginas"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Combinar ficheiros, ordenar e rodar páginas"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Combină fișiere, reordonează și rotește pagini"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Объединение файлов, порядок и поворот страниц"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Spájanie súborov, radenie a otáčanie strán"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Združevanje datotek, razvrščanje in vrtenje strani"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kombinera filer, ändra ordning och rotera sidor"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கோப்புகளை இணை, பக்கங்களின் வரிசையை மாற்று, சுழற்று"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫైళ్లను కలపండి, పేజీల క్రమం మార్చండి, తిప్పండి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รวมไฟล์ เรียงลำดับ และหมุนหน้า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya birleştir, sayfaları sırala ve döndür"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Об’єднання файлів, порядок і поворот сторінок"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فائلیں جوڑیں، صفحات کی ترتیب بدلیں اور گھمائیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghép tệp, sắp xếp lại và xoay trang"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合并文件、排序和旋转页面"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "合併檔案、重新排序和旋轉頁面"
          }
        }
      }
    },
