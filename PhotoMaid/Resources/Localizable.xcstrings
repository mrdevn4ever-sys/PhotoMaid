          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Раз на день. Бонус діє лише сьогодні."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi ngày một lần. Phần thưởng chỉ có hiệu lực hôm nay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每天一次，额外额度仅限今天使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
