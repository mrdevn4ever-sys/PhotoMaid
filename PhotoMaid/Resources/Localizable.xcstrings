    "movie_quality_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عالية ومتوازنة: حتى Full HD (1080p) – المتوازنة تعطي ملفات أصغر بفرق بالكاد يُرى. صغيرة: حتى HD (720p)، أصغر ملف، مناسبة للإرسال."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Høj og Balanceret: op til Full HD (1080p) – Balanceret giver mindre filer med næsten ingen synlig forskel. Lille: op til HD (720p), den mindste fil, god til at sende."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoch und Ausgewogen: bis Full HD (1080p) – Ausgewogen spart Speicher, der Unterschied ist kaum zu sehen. Klein: bis HD (720p), kleinste Datei, gut zum Verschicken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "High and Balanced: up to Full HD (1080p) – Balanced makes smaller files with hardly any visible difference. Small: up to HD (720p), the smallest file, good for sending."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alta y Equilibrada: hasta Full HD (1080p); Equilibrada ocupa menos con una diferencia apenas visible. Pequeña: hasta HD (720p), el archivo más pequeño, ideal para enviar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Haute et Équilibrée : jusqu’à Full HD (1080p) – Équilibrée produit des fichiers plus légers, différence à peine visible. Petite : jusqu’à HD (720p), le fichier le plus léger, idéal pour l’envoi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinggi dan Seimbang: hingga Full HD (1080p) – Seimbang menghasilkan file lebih kecil dengan perbedaan yang hampir tak terlihat. Kecil: hingga HD (720p), file terkecil, cocok untuk dikirim."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alta e Bilanciata: fino a Full HD (1080p); Bilanciata crea file più piccoli con una differenza appena visibile. Piccola: fino a HD (720p), il file più piccolo, ideale da inviare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高とバランス：最大フルHD（1080p）。バランスは見た目の差がほとんどなく、ファイルが小さくなります。小：最大HD（720p）、最小のファイルで送信向きです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "높음과 균형: 최대 풀 HD(1080p) – 균형은 차이가 거의 보이지 않으면서 파일이 작아요. 작게: 최대 HD(720p), 가장 작은 파일로 보내기에 좋아요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Høy og Balansert: opptil Full HD (1080p) – Balansert gir mindre filer med knapt synlig forskjell. Liten: opptil HD (720p), den minste filen, fin for sending."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoog en Gebalanceerd: tot Full HD (1080p) – Gebalanceerd geeft kleinere bestanden met nauwelijks zichtbaar verschil. Klein: tot HD (720p), het kleinste bestand, handig om te versturen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysoka i Zrównoważona: do Full HD (1080p) – Zrównoważona daje mniejsze pliki przy ledwo widocznej różnicy. Mała: do HD (720p), najmniejszy plik, dobry do wysyłania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alta e Equilibrada: até Full HD (1080p) – Equilibrada gera arquivos menores quase sem diferença visível. Pequena: até HD (720p), o menor arquivo, bom para enviar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Alta e Equilibrada: até Full HD (1080p) – Equilibrada cria ficheiros mais pequenos com uma diferença quase invisível. Pequena: até HD (720p), o ficheiro mais pequeno, bom para enviar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înaltă și Echilibrată: până la Full HD (1080p) – Echilibrată face fișiere mai mici, cu o diferență abia vizibilă. Mică: până la HD (720p), cel mai mic fișier, bun de trimis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Высокое и Сбалансированное: до Full HD (1080p) – Сбалансированное даёт файлы меньше почти без видимой разницы. Маленькое: до HD (720p), самый маленький файл, удобно для отправки."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hög och Balanserad: upp till Full HD (1080p) – Balanserad ger mindre filer med knappt synlig skillnad. Liten: upp till HD (720p), minsta filen, bra för att skicka."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สูงและสมดุล: สูงสุด Full HD (1080p) – สมดุลให้ไฟล์เล็กกว่าโดยแทบไม่เห็นความต่าง เล็ก: สูงสุด HD (720p) ไฟล์เล็กที่สุด เหมาะสำหรับส่ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüksek ve Dengeli: Full HD’ye (1080p) kadar – Dengeli, farkı neredeyse görünmeyen daha küçük dosyalar oluşturur. Küçük: HD’ye (720p) kadar, en küçük dosya, göndermek için ideal."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Висока й Збалансована: до Full HD (1080p) – Збалансована дає менші файли майже без помітної різниці. Мала: до HD (720p), найменший файл, зручно надсилати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cao và Cân bằng: tối đa Full HD (1080p) – Cân bằng tạo tệp nhỏ hơn mà gần như không thấy khác biệt. Nhỏ: tối đa HD (720p), tệp nhỏ nhất, phù hợp để gửi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高和均衡：最高全高清 (1080p)——均衡的文件更小，几乎看不出差别。小：最高高清 (720p)，文件最小，适合发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "高和平衡：最高 Full HD（1080p）– 平衡會產生較小的檔案，幾乎看不出差別。小：最高 HD（720p），檔案最小，適合傳送。"
          }
        }
      }
    },
