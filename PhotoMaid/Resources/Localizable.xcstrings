    "vault_edit_private_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى في الخزنة فقط – لن تظهر في تطبيق الصور ولا في أي مكان آخر في GaleriQ."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু ভল্টে থাকে – এটি ফটো অ্যাপে বা GaleriQ-এর অন্য কোথাও দেখা যাবে না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Es queda només a la caixa forta: no apareixerà a l’app Fotos ni enlloc més de GaleriQ."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zůstává jen v trezoru – neobjeví se v aplikaci Fotky ani nikde jinde v GaleriQ."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bliver kun i boksen – vises ikke i appen Fotos eller andre steder i GaleriQ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bleibt nur im Tresor – erscheint weder in der Fotos-App noch sonst irgendwo in GaleriQ."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μένει μόνο στο θησαυροφυλάκιο – δεν θα εμφανιστεί στην εφαρμογή Φωτογραφίες ούτε αλλού στο GaleriQ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stays in the vault only – it won’t show up in the Photos app or anywhere else in GaleriQ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se queda solo en la caja fuerte: no aparece en la app Fotos ni en ningún otro lugar de GaleriQ."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pysyy vain holvissa – se ei näy Kuvat-apissa eikä missään muualla GaleriQ:ssa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reste uniquement dans le coffre : n’apparaît ni dans l’app Photos ni ailleurs dans GaleriQ."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફક્ત વૉલ્ટમાં રહે છે – તે ફોટો ઍપમાં કે GaleriQ માં બીજે ક્યાંય દેખાશે નહીં."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נשאר רק בכספת – לא יופיע ביישום ״תמונות״ או בשום מקום אחר ב-GaleriQ."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिर्फ़ तिजोरी में रहता है – यह तस्वीरें ऐप में या GaleriQ में कहीं और नहीं दिखेगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostaje samo u trezoru – neće se prikazati u aplikaciji Fotografije ni bilo gdje drugdje u GaleriQ-u."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak a széfben marad – nem jelenik meg a Fotók appban és a GaleriQ más részein sem."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya tetap di brankas – tidak muncul di app Foto atau di tempat lain di GaleriQ."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Resta solo nella cassaforte: non compare nell’app Foto né altrove in GaleriQ."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保管庫の中だけに保存され、写真アプリやGaleriQのほかの場所には表示されません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ವಾಲ್ಟ್‌ನಲ್ಲಿ ಮಾತ್ರ ಉಳಿಯುತ್ತದೆ – ಇದು ಫೋಟೋಗಳು ಆ್ಯಪ್‌ನಲ್ಲಿ ಅಥವಾ GaleriQ ನ ಬೇರೆಡೆ ಕಾಣಿಸುವುದಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "금고에만 저장되며 사진 앱이나 GaleriQ의 다른 곳에는 나타나지 않아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വോൾട്ടിൽ മാത്രം തുടരും – ഫോട്ടോസ് ആപ്പിലോ GaleriQ-ലെ മറ്റെവിടെയെങ്കിലുമോ ഇത് ദൃശ്യമാകില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फक्त व्हॉल्टमध्ये राहते – ते फोटो अ‍ॅपमध्ये किंवा GaleriQ मध्ये इतरत्र दिसणार नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kekal dalam peti besi sahaja – ia tidak akan muncul dalam app Foto atau di mana-mana lagi dalam GaleriQ."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Blir bare i safen – vises ikke i Bilder-appen eller noe annet sted i GaleriQ."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blijft alleen in de kluis – verschijnt niet in de Foto’s-app of ergens anders in GaleriQ."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "କେବଳ ଭଲ୍ଟରେ ରହେ – ଏହା ଫଟୋ ଆପ୍‌ରେ କିମ୍ବା GaleriQର ଅନ୍ୟ କେଉଁଠି ଦେଖାଯିବ ନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਿਰਫ਼ ਵੌਲਟ ਵਿੱਚ ਰਹਿੰਦਾ ਹੈ – ਇਹ ਫ਼ੋਟੋਆਂ ਐਪ ਵਿੱਚ ਜਾਂ GaleriQ ਵਿੱਚ ਹੋਰ ਕਿਤੇ ਨਹੀਂ ਦਿਸੇਗਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostaje tylko w sejfie – nie pojawi się w aplikacji Zdjęcia ani nigdzie indziej w GaleriQ."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fica só no cofre – não aparece no app Fotos nem em nenhum outro lugar do GaleriQ."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Fica apenas no cofre – não aparece na app Fotografias nem em mais nenhum lado no GaleriQ."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Rămâne doar în seif – nu apare în aplicația Poze și nici în altă parte în GaleriQ."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остаётся только в сейфе – не появится ни в «Фото», ни где-либо ещё в GaleriQ."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostáva len v trezore – neobjaví sa v aplikácii Fotky ani nikde inde v GaleriQ."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostane samo v sefu – ne prikaže se v aplikaciji Fotografije ali kjer koli drugje v GaleriQ."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stannar bara i valvet – visas inte i appen Bilder eller någon annanstans i GaleriQ."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "லாக்கரில் மட்டுமே இருக்கும் – இது Photos ஆப்பிலோ GaleriQ-இன் வேறு எங்குமோ தோன்றாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వాల్ట్‌లో మాత్రమే ఉంటుంది – ఇది Photos యాప్‌లో లేదా GaleriQలో మరెక్కడా కనిపించదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อยู่ในตู้เซฟเท่านั้น – จะไม่ปรากฏในแอพรูปภาพหรือที่อื่นใน GaleriQ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca kasada kalır – Fotoğraflar uygulamasında ya da GaleriQ’in başka bir yerinde görünmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишається лише в сейфі – не з’явиться ні у «Фото», ні деінде в GaleriQ."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف والٹ میں رہتا ہے – یہ تصاویر ایپ میں یا GaleriQ میں کہیں اور نہیں دکھے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ ở trong két sắt – không hiện trong ứng dụng Ảnh hay bất kỳ đâu khác trong GaleriQ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅保存在保险箱中，不会出现在“照片”App 或 GaleriQ 的其他任何位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只留在保險箱中 – 不會出現在「照片」App 或 GaleriQ 的其他地方。"
          }
        }
      }
    },
