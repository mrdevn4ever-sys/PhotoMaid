        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "રાહમાં – “%1$@” પૂર્ણ થતાં જ આપમેળે શરૂ થશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בהמתנה – יתחיל מעצמו ברגע ש„%1$@” יסתיים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इंतज़ार में – “%1$@” पूरा होते ही अपने-आप शुरू होगा।"
