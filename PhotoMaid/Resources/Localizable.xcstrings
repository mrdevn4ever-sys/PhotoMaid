    "large_footnote": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر فقط الملفات المعروفة الحجم، من %1$lld ميغابايت فأكثر. قد يختلف حجمها عن المساحة التي تتحرر عند حذفها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু অন্তত %1$lld MB জানা আকারের ফাইল। মুছে ফেললে যে জায়গা খালি হয় তার থেকে এদের আকার আলাদা হতে পারে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Només fitxers amb una mida coneguda d’almenys %1$lld MB. La mida pot ser diferent de l’espai que s’allibera en esborrar-los."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jen soubory se známou velikostí nejméně %1$lld MB. Jejich velikost se může lišit od místa uvolněného jejich smazáním."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun filer med kendt størrelse på mindst %1$lld MB. Størrelsen kan afvige fra den plads, der frigøres, når du sletter dem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Dateien mit bekannter Größe ab %1$lld MB. Ihre Größe entspricht nicht unbedingt dem Speicher, der beim Löschen frei wird."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόνο αρχεία γνωστού μεγέθους τουλάχιστον %1$lld MB. Το μέγεθός τους μπορεί να διαφέρει από τον χώρο που ελευθερώνεται με τη διαγραφή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only files with a known size of at least %1$lld MB. Their size may differ from the space freed when you delete them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo archivos de tamaño conocido a partir de %1$lld MB. Su tamaño no siempre coincide con el espacio que se libera al borrarlos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain tiedostot, joiden tunnettu koko on vähintään %1$lld Mt. Koko voi poiketa tilasta, joka vapautuu niitä poistettaessa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seulement les fichiers de taille connue à partir de %1$lld Mo. Leur taille ne correspond pas forcément à l’espace libéré après suppression."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફક્ત ઓછામાં ઓછા %1$lld MB ના જાણીતા કદની ફાઇલો. ડિલીટ કરતાં ખાલી થતી જગ્યા તેમના કદથી અલગ હોઈ શકે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רק קבצים בגודל ידוע של לפחות %1$lld MB. הגודל שלהם עשוי להיות שונה מהמקום שמתפנה כשמוחקים אותם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिर्फ़ कम से कम %1$lld MB के ज्ञात साइज़ वाली फ़ाइलें। डिलीट करने पर खाली होने वाली जगह उनके साइज़ से अलग हो सकती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo datoteke poznate veličine od najmanje %1$lld MB. Njihova veličina može se razlikovati od prostora koji se oslobodi brisanjem."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak a legalább %1$lld MB ismert méretű fájlok. A méretük eltérhet a törlésükkel felszabaduló helytől."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya file dengan ukuran diketahui minimal %1$lld MB. Ukurannya bisa berbeda dari ruang yang kosong saat dihapus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo file di dimensione nota a partire da %1$lld MB. La loro dimensione potrebbe non coincidere con lo spazio liberato eliminandoli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイズがわかる%1$lld MB以上のファイルのみ表示します。ファイルサイズと、削除で空く容量は一致しないことがあります。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕನಿಷ್ಠ %1$lld MB ತಿಳಿದ ಗಾತ್ರದ ಫೈಲ್‌ಗಳು ಮಾತ್ರ. ಅಳಿಸಿದಾಗ ಮುಕ್ತವಾಗುವ ಸ್ಥಳಕ್ಕಿಂತ ಅವುಗಳ ಗಾತ್ರ ಭಿನ್ನವಾಗಿರಬಹುದು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "크기를 알 수 있는 %1$lld MB 이상의 파일만 표시해요. 파일 크기와 실제로 확보되는 공간은 다를 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കുറഞ്ഞത് %1$lld MB അറിയപ്പെടുന്ന വലുപ്പമുള്ള ഫയലുകൾ മാത്രം. ഇല്ലാതാക്കുമ്പോൾ ഒഴിവാകുന്ന സ്ഥലത്തിൽ നിന്ന് അവയുടെ വലുപ്പം വ്യത്യസ്തമായിരിക്കാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फक्त किमान %1$lld MB ज्ञात आकाराच्या फाइल्स. डिलीट केल्यावर मोकळी होणारी जागा त्यांच्या आकारापेक्षा वेगळी असू शकते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya fail dengan saiz yang diketahui sekurang-kurangnya %1$lld MB. Saiznya mungkin berbeza daripada ruang yang dikosongkan apabila anda memadamnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare filer med kjent størrelse på minst %1$lld MB. Størrelsen kan avvike fra plassen som frigjøres når du sletter dem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen bestanden met een bekende grootte vanaf %1$lld MB. Hun grootte is niet altijd gelijk aan de ruimte die vrijkomt na verwijderen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "କେବଳ ଅନ୍ତତଃ %1$lld MB ଜଣାଥିବା ଆକାରର ଫାଇଲ୍। ଡିଲିଟ୍ କଲେ ଖାଲି ହେଉଥିବା ସ୍ଥାନଠାରୁ ଏଗୁଡ଼ିକର ଆକାର ଭିନ୍ନ ହୋଇପାରେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਿਰਫ਼ ਘੱਟੋ-ਘੱਟ %1$lld MB ਦੇ ਜਾਣੇ-ਪਛਾਣੇ ਆਕਾਰ ਵਾਲੀਆਂ ਫ਼ਾਈਲਾਂ। ਇਨ੍ਹਾਂ ਦਾ ਆਕਾਰ ਮਿਟਾਉਣ ’ਤੇ ਖਾਲੀ ਹੋਣ ਵਾਲੀ ਥਾਂ ਤੋਂ ਵੱਖ ਹੋ ਸਕਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko pliki o znanym rozmiarze od %1$lld MB. Ich rozmiar nie musi odpowiadać miejscu zwolnionemu po usunięciu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só arquivos com tamanho conhecido de pelo menos %1$lld MB. O tamanho pode diferir do espaço liberado ao apagá-los."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas ficheiros de tamanho conhecido a partir de %1$lld MB. O tamanho pode não corresponder ao espaço libertado ao eliminá-los."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar fișiere cu dimensiune cunoscută, de la %1$lld MB. Dimensiunea lor poate diferi de spațiul eliberat după ștergere."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только файлы с известным размером от %1$lld МБ. Их размер может отличаться от объёма места, которое освободится после удаления."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Len súbory so známou veľkosťou najmenej %1$lld MB. Ich veľkosť sa môže líšiť od miesta uvoľneného ich vymazaním."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo datoteke znane velikosti vsaj %1$lld MB. Njihova velikost se lahko razlikuje od prostora, ki se sprosti z izbrisom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara filer med känd storlek på minst %1$lld MB. Storleken kan skilja sig från utrymmet som frigörs när du raderar dem."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "குறைந்தது %1$lld MB தெரிந்த அளவுள்ள கோப்புகள் மட்டும். நீக்கும்போது காலியாகும் இடத்திலிருந்து அவற்றின் அளவு வேறுபடலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కనీసం %1$lld MB తెలిసిన పరిమాణం ఉన్న ఫైళ్లు మాత్రమే. తొలగించినప్పుడు ఖాళీ అయ్యే స్థలం నుండి వాటి పరిమాణం వేరుగా ఉండవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เฉพาะไฟล์ที่ทราบขนาดอย่างน้อย %1$lld MB ขนาดอาจต่างจากพื้นที่ที่ว่างขึ้นเมื่อลบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca boyutu bilinen, en az %1$lld MB olan dosyalar. Boyutları, silinince açılacak alanla aynı olmayabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише файли з відомим розміром від %1$lld МБ. Їхній розмір може не збігатися з обсягом звільненого місця після видалення."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف کم از کم %1$lld MB کے معلوم سائز والی فائلیں۔ حذف کرنے پر خالی ہونے والی جگہ ان کے سائز سے مختلف ہو سکتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ các tệp có kích thước đã biết từ %1$lld MB trở lên. Kích thước có thể khác với dung lượng được giải phóng khi xóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅显示大小已知且至少为 %1$lld MB 的文件。文件大小不一定等于删除后释放的空间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只顯示已知大小至少 %1$lld MB 的檔案。刪除後釋放的空間可能與其大小不同。"
          }
        }
      }
    },
    "large_icloud_footer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مع «تحسين تخزين الـ iPhone» تكون هذه الأصول في iCloud فقط. لا يكشف iOS حجمها الدقيق دون تنزيلها، لذا يقدّره GaleriQ من صورك وفيديوهاتك المقاسة ويعرضه بعبارة «حوالي»."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "“iPhone স্টোরেজ অপটিমাইজ করুন” চালু থাকলে এই মূল ফাইলগুলো শুধু iCloud-এ থাকে। ডাউনলোড না করে iOS এদের সঠিক আকার জানায় না, তাই GaleriQ আপনার মাপা ফটো ও ভিডিও থেকে অনুমান করে এবং “প্রায়” হিসেবে দেখায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Amb «Optimitzar l’emmagatzematge de l’iPhone», aquests originals només són a iCloud. L’iOS no en revela la mida exacta sense baixar-los, així que GaleriQ l’estima a partir de les fotos i els vídeos mesurats i la mostra com a «aprox.»."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "S volbou „Optimalizovat úložiště iPhonu“ jsou tyto originály jen na iCloudu. iOS bez stažení neprozradí jejich přesnou velikost, proto ji GaleriQ odhadne podle vašich změřených fotek a videí a zobrazí jako „cca“."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Med “Optimer iPhone-lagring” findes disse originaler kun i iCloud. iOS viser ikke deres præcise størrelse uden at hente dem, så GaleriQ anslår den ud fra dine målte fotos og videoer og viser den som “ca.”."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit „iPhone-Speicher optimieren“ liegen diese Originale nur in iCloud. iOS nennt ihre genaue Größe nicht, ohne sie herunterzuladen – GaleriQ schätzt sie deshalb aus deinen gemessenen Fotos und Videos und zeigt sie als „ca.“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Με τη «Βελτιστοποίηση αποθήκευσης iPhone», αυτά τα πρωτότυπα βρίσκονται μόνο στο iCloud. Το iOS δεν δείχνει το ακριβές μέγεθός τους χωρίς λήψη, οπότε το GaleriQ το εκτιμά από τις μετρημένες φωτογραφίες και βίντεό σου και το δείχνει ως «περ.»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With “Optimize iPhone Storage”, these originals are only in iCloud. iOS doesn’t reveal their exact size without downloading them, so GaleriQ estimates it from your measured photos and videos and shows it as “approx.”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con «Optimizar almacenamiento del iPhone», estos originales solo están en iCloud. iOS no indica su tamaño exacto sin descargarlos, así que GaleriQ lo estima a partir de tus fotos y vídeos medidos y lo muestra como «aprox.»."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun ”Optimoi iPhonen tallennustila” on käytössä, nämä alkuperäiset ovat vain iCloudissa. iOS ei kerro niiden tarkkaa kokoa ilman latausta, joten GaleriQ arvioi sen mitattujen kuviesi ja videoidesi perusteella ja näyttää sen merkinnällä ”n.”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec « Optimiser le stockage de l’iPhone », ces originaux sont uniquement dans iCloud. iOS n’indique pas leur taille exacte sans les télécharger : GaleriQ l’estime donc d’après tes photos et vidéos mesurées et l’affiche avec « env. »."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "“iPhone સ્ટોરેજ ઑપ્ટિમાઇઝ કરો” સાથે આ મૂળ ફાઇલો ફક્ત iCloud માં છે. iOS ડાઉનલોડ વિના તેમનું ચોક્કસ કદ જણાવતું નથી, તેથી GaleriQ તમારા માપેલા ફોટા અને વીડિયો પરથી અંદાજ લગાવીને તેને “આશરે” તરીકે બતાવે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עם „מיטוב האחסון ב-iPhone”, המקוריים האלה נמצאים רק ב-iCloud. ‏iOS לא חושפת את הגודל המדויק שלהם בלי הורדה, לכן GaleriQ מעריכה אותו לפי התמונות והסרטונים שנמדדו ומציגה אותו כ„בערך”."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“iPhone स्टोरेज ऑप्टिमाइज़ करें” के साथ ये मूल फ़ाइलें सिर्फ़ iCloud में हैं। iOS डाउनलोड के बिना उनका सही साइज़ नहीं बताता, इसलिए GaleriQ आपकी नापी गई फ़ोटो और वीडियो से उसका अनुमान लगाकर “लगभग” के रूप में दिखाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uz „Optimiziraj pohranu iPhonea” ovi su originali samo u iCloudu. iOS ne otkriva njihovu točnu veličinu bez preuzimanja pa je GaleriQ procjenjuje na temelju tvojih izmjerenih fotografija i videozapisa i prikazuje kao „pribl.”."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az „iPhone-tárhely optimalizálása” beállítással ezek az eredetik csak az iCloudban vannak. Az iOS letöltés nélkül nem árulja el a pontos méretüket, ezért a GaleriQ a lemért fotóid és videóid alapján becsüli meg, és „kb.” jelöléssel mutatja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengan “Optimalkan Penyimpanan iPhone”, aslinya hanya ada di iCloud. iOS tidak memberi tahu ukuran pastinya tanpa mengunduh, jadi GaleriQ memperkirakannya dari foto dan video yang sudah diukur dan menampilkannya sebagai “sekitar”."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con «Ottimizza spazio su iPhone» questi originali sono solo in iCloud. iOS non ne indica la dimensione esatta senza scaricarli, quindi GaleriQ la stima dalle tue foto e dai tuoi video misurati e la mostra come «circa»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「iPhoneのストレージを最適化」が有効な場合、これらのオリジナルはiCloudにのみあります。iOSはダウンロードしないと正確なサイズを教えないため、GaleriQは計測済みの写真や動画から推定し、「約」として表示します。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "“iPhone ಸಂಗ್ರಹಣೆಯನ್ನು ಆಪ್ಟಿಮೈಸ್ ಮಾಡಿ” ಆನ್ ಆಗಿದ್ದರೆ ಈ ಮೂಲಗಳು iCloud ನಲ್ಲಿ ಮಾತ್ರ ಇರುತ್ತವೆ. ಡೌನ್‌ಲೋಡ್ ಮಾಡದೆ iOS ಅವುಗಳ ನಿಖರ ಗಾತ್ರ ತಿಳಿಸುವುದಿಲ್ಲ, ಆದ್ದರಿಂದ GaleriQ ನಿಮ್ಮ ಅಳೆದ ಫೋಟೋಗಳು ಮತ್ತು ವೀಡಿಯೊಗಳಿಂದ ಅಂದಾಜು ಮಾಡಿ “ಸುಮಾರು” ಎಂದು ತೋರಿಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘iPhone 저장 공간 최적화’를 사용하면 이 원본은 iCloud에만 있어요. iOS는 다운로드하지 않으면 정확한 크기를 알려 주지 않으므로 GaleriQ가 측정한 사진과 동영상을 바탕으로 추정해 ‘약’으로 표시해요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "“iPhone സ്റ്റോറേജ് ഒപ്റ്റിമൈസ് ചെയ്യുക” ഓണാണെങ്കിൽ ഈ ഒറിജിനലുകൾ iCloud-ൽ മാത്രമാണ്. ഡൗൺലോഡ് ചെയ്യാതെ iOS അവയുടെ കൃത്യമായ വലുപ്പം വെളിപ്പെടുത്തില്ല, അതിനാൽ GaleriQ നിങ്ങളുടെ അളന്ന ഫോട്ടോകളിൽ നിന്നും വീഡിയോകളിൽ നിന്നും കണക്കാക്കി “ഏകദേശം” എന്ന് കാണിക്കുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "“iPhone स्टोरेज ऑप्टिमाइझ करा” सह या मूळ फाइल्स फक्त iCloud मध्ये आहेत. iOS डाउनलोडशिवाय त्यांचा अचूक आकार सांगत नाही, म्हणून GaleriQ तुमच्या मोजलेल्या फोटो आणि व्हिडिओंवरून अंदाज लावून तो “सुमारे” म्हणून दाखवते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengan “Optimumkan Storan iPhone”, fail asal ini hanya berada dalam iCloud. iOS tidak mendedahkan saiz tepatnya tanpa memuat turunnya, jadi GaleriQ menganggarkannya daripada foto dan video anda yang telah diukur dan menunjukkannya sebagai “lebih kurang”."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Med «Optimaliser iPhone-lagring» finnes disse originalene bare i iCloud. iOS viser ikke den nøyaktige størrelsen uten å laste dem ned, så GaleriQ anslår den ut fra de målte bildene og videoene dine og viser den som «ca.»."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met ‘Optimaliseer iPhone-opslag’ staan deze originelen alleen in iCloud. iOS geeft hun exacte grootte niet zonder ze te downloaden, dus schat GaleriQ die op basis van je gemeten foto’s en video’s en toont ze als ‘ca.’."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "“iPhone ଷ୍ଟୋରେଜ୍ ଅପ୍ଟିମାଇଜ୍ କରନ୍ତୁ” ସହ ଏହି ମୂଳ ଫାଇଲ୍ କେବଳ iCloudରେ ଅଛି। ଡାଉନଲୋଡ୍ ବିନା iOS ସେଗୁଡ଼ିକର ସଠିକ୍ ଆକାର ଜଣାଏ ନାହିଁ, ତେଣୁ GaleriQ ଆପଣଙ୍କ ମାପାଯାଇଥିବା ଫଟୋ ଓ ଭିଡିଓରୁ ଅନୁମାନ କରି “ପ୍ରାୟ” ଭାବେ ଦେଖାଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "“iPhone ਸਟੋਰੇਜ ਅਨੁਕੂਲ ਬਣਾਓ” ਨਾਲ ਇਹ ਮੂਲ ਸਿਰਫ਼ iCloud ਵਿੱਚ ਹਨ। iOS ਇਨ੍ਹਾਂ ਨੂੰ ਡਾਊਨਲੋਡ ਕੀਤੇ ਬਿਨਾਂ ਸਹੀ ਆਕਾਰ ਨਹੀਂ ਦੱਸਦਾ, ਇਸ ਲਈ GaleriQ ਤੁਹਾਡੀਆਂ ਮਾਪੀਆਂ ਫ਼ੋਟੋਆਂ ਅਤੇ ਵੀਡੀਓ ਤੋਂ ਇਸ ਦਾ ਅੰਦਾਜ਼ਾ ਲਗਾਉਂਦਾ ਹੈ ਅਤੇ ਇਸ ਨੂੰ “ਲਗਭਗ” ਵਜੋਂ ਦਿਖਾਉਂਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przy „Optymalizuj pamięć iPhone’a” te oryginały są tylko w iCloud. iOS nie podaje ich dokładnego rozmiaru bez pobierania, więc GaleriQ szacuje go na podstawie zmierzonych zdjęć i filmów i pokazuje jako „ok.”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com “Otimizar Armazenamento do iPhone”, esses originais estão só no iCloud. O iOS não informa o tamanho exato sem baixá-los, então o GaleriQ o estima a partir das suas fotos e vídeos medidos e mostra como “aprox.”."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Com «Otimizar armazenamento do iPhone», estes originais estão apenas no iCloud. O iOS não indica o tamanho exato sem os descarregar, por isso o GaleriQ estima-o a partir das tuas fotografias e vídeos medidos e mostra-o como «aprox.»."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cu „Optimizează spațiul iPhone-ului”, aceste originale sunt doar în iCloud. iOS nu le arată dimensiunea exactă fără descărcare, așa că GaleriQ o estimează din fotografiile și videoclipurile tale măsurate și o afișează cu „cca.”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При «Оптимизации хранилища iPhone» эти оригиналы есть только в iCloud. iOS не сообщает их точный размер без загрузки, поэтому GaleriQ оценивает его по измеренным фото и видео и показывает со знаком «≈»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "S voľbou „Optimalizovať úložisko iPhonu“ sú tieto originály len na iCloude. iOS bez stiahnutia neprezradí ich presnú veľkosť, preto ju GaleriQ odhadne podľa vašich zmeraných fotiek a videí a zobrazí ako „cca“."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Z »Optimiziraj shrambo iPhona« so ti izvirniki samo v iCloudu. iOS brez prenosa ne razkrije njihove natančne velikosti, zato jo GaleriQ oceni iz tvojih izmerjenih fotografij in videoposnetkov ter prikaže kot »pribl.«."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Med ”Optimera iPhone-lagring” finns dessa original bara i iCloud. iOS visar inte deras exakta storlek utan att hämta dem, så GaleriQ uppskattar den utifrån dina uppmätta bilder och videor och visar den som ”ca”."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "“iPhone சேமிப்பகத்தை மேம்படுத்து” இயக்கத்தில் இருந்தால் இந்த அசல்கள் iCloud-இல் மட்டும் உள்ளன. பதிவிறக்காமல் iOS அவற்றின் சரியான அளவைக் காட்டாது, எனவே GaleriQ உங்கள் அளவிட்ட புகைப்படங்கள், வீடியோக்களிலிருந்து மதிப்பிட்டு “சுமார்” எனக் காட்டுகிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "“iPhone స్టోరేజ్‌ను ఆప్టిమైజ్ చేయి” ఆన్‌లో ఉంటే ఈ ఒరిజినల్‌లు iCloudలో మాత్రమే ఉంటాయి. డౌన్‌లోడ్ చేయకుండా iOS వాటి ఖచ్చితమైన పరిమాణం చెప్పదు, కాబట్టి GaleriQ మీ కొలిచిన ఫోటోలు, వీడియోల నుండి అంచనా వేసి “సుమారు”గా చూపిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อเปิด “ปรับพื้นที่จัดเก็บข้อมูล iPhone” ต้นฉบับเหล่านี้จะอยู่ใน iCloud เท่านั้น iOS ไม่บอกขนาดที่แน่นอนหากไม่ดาวน์โหลด GaleriQ จึงประมาณจากรูปภาพและวิดีโอที่วัดแล้วและแสดงเป็น “ประมาณ”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“iPhone Saklama Alanını Optimize Et” açıkken bu orijinaller yalnızca iCloud’dadır. iOS tam boyutlarını indirmeden göstermez; bu yüzden GaleriQ boyutu ölçülmüş fotoğraf ve videolarından tahmin eder ve “yaklaşık” olarak gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "З «Оптимізацією сховища iPhone» ці оригінали є лише в iCloud. iOS не повідомляє їхній точний розмір без завантаження, тому GaleriQ оцінює його за виміряними фото й відео та показує зі знаком «≈»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "”iPhone اسٹوریج بہتر بنائیں“ کے ساتھ یہ اصل فائلیں صرف iCloud میں ہیں۔ iOS ڈاؤن لوڈ کے بغیر ان کا درست سائز نہیں بتاتا، اس لیے GaleriQ آپ کی ناپی گئی تصاویر اور ویڈیوز سے اندازہ لگا کر ”تقریباً“ کے طور پر دکھاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Với “Tối ưu hóa dung lượng iPhone”, các bản gốc này chỉ có trên iCloud. iOS không cho biết kích thước chính xác nếu không tải về, nên GaleriQ ước tính từ ảnh và video đã đo của bạn và hiển thị là “khoảng”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启“优化 iPhone 储存空间”后，这些原件只在 iCloud 中。iOS 不下载就不会提供其确切大小，因此 GaleriQ 会根据你已测量的照片和视频进行估算，并显示为“约”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟「最佳化 iPhone 儲存空間」後，這些原始檔只存在 iCloud 中。iOS 不下載就不會提供確切大小，因此 GaleriQ 會根據你已測量的照片和影片估計，並標示為「約」。"
          }
        }
      }
    },
