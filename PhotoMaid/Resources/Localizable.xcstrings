    "archive_step_verify": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد ذلك تُقرأ كل نسخة من جديد وتُقارن بالأصل بايتًا ببايت."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Each copy is then read again and compared byte by byte with the original."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Kopie wird danach neu gelesen und Byte für Byte mit dem Original verglichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each copy is then read again and compared byte by byte with the original."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después, cada copia se vuelve a leer y se compara byte a byte con el original."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque copie est ensuite relue et comparée octet par octet à l’original."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Each copy is then read again and compared byte by byte with the original."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Poi ogni copia viene riletta e confrontata byte per byte con l’originale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その後、各コピーを読み直し、元のファイルと1バイトずつ比べます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그다음 각 사본을 다시 읽어 원본과 바이트 단위로 비교해요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Each copy is then read again and compared byte by byte with the original."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Daarna wordt elke kopie opnieuw gelezen en byte voor byte met het origineel vergeleken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potem każda kopia jest odczytywana ponownie i porównywana bajt po bajcie z oryginałem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Each copy is then read again and compared byte by byte with the original."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois, cada cópia é lida de novo e comparada byte a byte com o original."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apoi fiecare copie este citită din nou și comparată octet cu octet cu originalul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Затем каждая копия читается заново и побайтно сравнивается с оригиналом."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Each copy is then read again and compared byte by byte with the original."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Each copy is then read again and compared byte by byte with the original."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ardından her kopya yeniden okunur ve orijinalle bayt bayt karşılaştırılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Потім кожну копію читають знову й побайтово порівнюють з оригіналом."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Each copy is then read again and compared byte by byte with the original."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随后会重新读取每份副本，并与原件逐字节比对。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Each copy is then read again and compared byte by byte with the original."
          }
        }
      }
    },
    "archive_studio_sub": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النسخ إلى مجلد مختار والتحقق من كل نسخة"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiér til en valgt mappe og kontrollér hver kopi"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In einen gewählten Ordner kopieren und jede Kopie prüfen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy to a chosen folder and verify every copy"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiar a una carpeta elegida y verificar cada copia"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copier dans un dossier choisi et vérifier chaque copie"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Salin ke folder pilihan dan periksa setiap salinan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia in una cartella scelta e verifica ogni copia"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したフォルダにコピーし、各コピーを検証"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 폴더에 복사하고 각 사본 확인"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopier til en valgt mappe og kontroller hver kopi"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naar een gekozen map kopiëren en elke kopie controleren"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skopiuj do wybranego folderu i sprawdź każdą kopię"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiar para uma pasta escolhida e verificar cada cópia"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiar para uma pasta escolhida e verificar cada cópia"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiază într-un dosar ales și verifică fiecare copie"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скопировать в выбранную папку и проверить каждую копию"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiera till en vald mapp och kontrollera varje kopia"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คัดลอกไปยังโฟลเดอร์ที่เลือกและตรวจสอบทุกสำเนา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen klasöre kopyala ve her kopyayı doğrula"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Копіювати до вибраної папки й перевірити кожну копію"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sao chép vào thư mục đã chọn và kiểm tra từng bản sao"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制到所选文件夹并验证每个副本"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "複製到選擇的檔案夾並驗證每份副本"
          }
        }
      }
    },
