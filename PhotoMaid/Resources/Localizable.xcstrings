    "today_access_default": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح لـ GaleriQ بالوصول لتتمكن من عرض صورك وفيديوهاتك وترتيبها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ-কে অ্যাক্সেসের অনুমতি দিন যাতে আপনি আপনার ফটো ও ভিডিও দেখতে ও গোছাতে পারেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet l’accés a GaleriQ per poder veure i organitzar les teves fotos i vídeos."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povolte GaleriQ přístup, abyste mohli prohlížet a třídit své fotky a videa."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Giv GaleriQ adgang, så du kan se og organisere dine fotos og videoer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube GaleriQ den Zugriff, damit du deine Fotos und Videos ansehen und sortieren kannst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δώσε πρόσβαση στο GaleriQ για να βλέπεις και να οργανώνεις τις φωτογραφίες και τα βίντεό σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow GaleriQ access so you can view and organize your photos and videos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el acceso a GaleriQ para ver y organizar tus fotos y vídeos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salli GaleriQ:lle käyttöoikeus, jotta voit katsoa ja järjestää kuviasi ja videoitasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorise GaleriQ à accéder à tes photos et vidéos pour les voir et les organiser."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ને ઍક્સેસ આપો જેથી તમે તમારા ફોટા અને વીડિયો જોઈ અને ગોઠવી શકો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לתת ל-GaleriQ גישה כדי לצפות בתמונות ובסרטונים שלך ולארגן אותם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ को एक्सेस दें ताकि आप अपनी फ़ोटो और वीडियो देख और व्यवस्थित कर सकें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopusti GaleriQ-u pristup kako bi mogao pregledavati i organizirati svoje fotografije i videozapise."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Engedélyezd a GaleriQ hozzáférését, hogy megtekinthesd és rendszerezhesd a fotóidat és videóidat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan akses GaleriQ agar kamu bisa melihat dan merapikan foto dan videomu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti l’accesso a GaleriQ per vedere e organizzare foto e video."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真や動画を表示して整理するには、GaleriQにアクセスを許可してください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಫೋಟೋಗಳು ಮತ್ತು ವೀಡಿಯೊಗಳನ್ನು ವೀಕ್ಷಿಸಲು ಮತ್ತು ವ್ಯವಸ್ಥಿತಗೊಳಿಸಲು GaleriQ ಗೆ ಪ್ರವೇಶ ಅನುಮತಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진과 동영상을 보고 정리할 수 있도록 GaleriQ에 접근을 허용해 주세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ഫോട്ടോകളും വീഡിയോകളും കാണാനും ക്രമീകരിക്കാനും GaleriQ-ന് ആക്‌സസ് അനുവദിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ला ॲक्सेस द्या, जेणेकरून तुम्ही तुमचे फोटो आणि व्हिडिओ पाहू आणि व्यवस्थित करू शकता."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Benarkan GaleriQ mengakses supaya anda boleh melihat dan menyusun foto dan video anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gi GaleriQ tilgang så du kan se og organisere bildene og videoene dine."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef GaleriQ toegang om je foto’s en video’s te bekijken en te ordenen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQକୁ ଆକ୍ସେସ୍‌ର ଅନୁମତି ଦିଅନ୍ତୁ ଯାହାଦ୍ୱାରା ଆପଣ ଆପଣଙ୍କ ଫଟୋ ଓ ଭିଡିଓ ଦେଖି ସଜାଇପାରିବେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ਨੂੰ ਪਹੁੰਚ ਦੀ ਇਜਾਜ਼ਤ ਦਿਓ ਤਾਂ ਜੋ ਤੁਸੀਂ ਆਪਣੀਆਂ ਫ਼ੋਟੋਆਂ ਅਤੇ ਵੀਡੀਓ ਦੇਖ ਅਤੇ ਵਿਵਸਥਿਤ ਕਰ ਸਕੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól GaleriQ na dostęp, aby przeglądać i porządkować zdjęcia i filmy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso do GaleriQ para ver e organizar suas fotos e vídeos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite o acesso ao GaleriQ para veres e organizares as tuas fotos e vídeos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite accesul pentru GaleriQ ca să vezi și să organizezi fotografiile și videoclipurile."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разреши GaleriQ доступ, чтобы просматривать и упорядочивать фото и видео."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Povoľte GaleriQ prístup, aby ste mohli prezerať a triediť svoje fotky a videá."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dovoli GaleriQ dostop, da lahko pregleduješ in urejaš svoje fotografije in videoposnetke."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ge GaleriQ åtkomst så att du kan visa och sortera dina bilder och videor."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் புகைப்படங்களையும் வீடியோக்களையும் பார்த்து ஒழுங்குபடுத்த GaleriQ-க்கு அணுகலை அனுமதியுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ ఫోటోలు, వీడియోలను చూసి సర్దుకోవడానికి GaleriQకి యాక్సెస్ అనుమతించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตให้ GaleriQ เข้าถึงเพื่อดูและจัดระเบียบรูปภาพและวิดีโอของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraf ve videolarını görüntüleyip düzenlemek için GaleriQ uygulamasına erişim izni ver."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надай GaleriQ доступ, щоб переглядати й упорядковувати фото та відео."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ کو رسائی دیں تاکہ آپ اپنی تصاویر اور ویڈیوز دیکھ اور ترتیب دے سکیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép GaleriQ truy cập để bạn xem và sắp xếp ảnh, video."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请允许 GaleriQ 访问照片和视频，以便查看和整理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許 GaleriQ 取用，即可檢視和整理你的照片和影片。"
          }
        }
      }
    },
    "today_access_denied": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح بالوصول في إعدادات iOS ضمن GaleriQ › الصور. ستبقى قراراتك السابقة محفوظة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS সেটিংসে GaleriQ › ফটো-এর অধীনে অ্যাক্সেসের অনুমতি দিন। আপনার আগের সিদ্ধান্তগুলো সংরক্ষিত থাকবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet l’accés a la configuració de l’iOS, a GaleriQ › Fotos. Les teves decisions anteriors es mantindran desades."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povolte přístup v nastavení iOS v části GaleriQ › Fotky. Vaše dosavadní rozhodnutí zůstanou uložená."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillad adgang i iOS-indstillingerne under GaleriQ › Fotos. Dine tidligere valg forbliver gemt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube den Zugriff in den iOS-Einstellungen unter GaleriQ › Fotos. Deine bisherigen Entscheidungen bleiben gespeichert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επίτρεψε την πρόσβαση στις Ρυθμίσεις iOS στο GaleriQ › Φωτογραφίες. Οι προηγούμενες επιλογές σου μένουν αποθηκευμένες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow access in iOS Settings under GaleriQ › Photos. Your previous choices will stay saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el acceso en Ajustes de iOS, en GaleriQ › Fotos. Tus decisiones anteriores se conservan."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salli käyttö iOS:n asetuksissa kohdassa GaleriQ › Kuvat. Aiemmat valintasi pysyvät tallessa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l’accès dans les Réglages d’iOS, sous GaleriQ › Photos. Vos choix précédents restent enregistrés."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS સેટિંગ્સમાં GaleriQ › ફોટો હેઠળ ઍક્સેસ આપો. તમારી અગાઉની પસંદગીઓ સાચવેલી રહેશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר לתת גישה בהגדרות של iOS תחת GaleriQ › תמונות. ההחלטות הקודמות שלך יישארו שמורות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS सेटिंग्ज़ में GaleriQ › तस्वीरें के अंतर्गत एक्सेस दें। आपके पिछले चुनाव सहेजे रहेंगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopusti pristup u postavkama iOS-a pod GaleriQ › Fotografije. Tvoje prethodne odluke ostaju spremljene."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Engedélyezd a hozzáférést az iOS-beállításokban: GaleriQ › Fotók. A korábbi döntéseid mentve maradnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan akses di Pengaturan iOS pada GaleriQ › Foto. Pilihanmu sebelumnya tetap tersimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti l’accesso nelle Impostazioni di iOS, in GaleriQ › Foto. Le tue scelte precedenti restano salvate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOSの設定 › GaleriQ › 写真 でアクセスを許可してください。これまでの判断は保存されたままです。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ GaleriQ › ಫೋಟೋಗಳು ಅಡಿಯಲ್ಲಿ ಪ್ರವೇಶ ಅನುಮತಿಸಿ. ನಿಮ್ಮ ಹಿಂದಿನ ಆಯ್ಕೆಗಳು ಉಳಿದಿರುತ್ತವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 설정 › GaleriQ › 사진에서 접근을 허용하세요. 이전 결정은 그대로 저장됩니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ക്രമീകരണങ്ങളിൽ GaleriQ › ഫോട്ടോസ് എന്നതിന് കീഴിൽ ആക്‌സസ് അനുവദിക്കുക. നിങ്ങളുടെ മുൻ തിരഞ്ഞെടുപ്പുകൾ സംരക്ഷിച്ചിരിക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS सेटिंग्जमध्ये GaleriQ › फोटो अंतर्गत ॲक्सेस द्या. तुमच्या मागील निवडी जतन राहतील."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Benarkan akses dalam Seting iOS di bawah GaleriQ › Foto. Pilihan anda sebelum ini akan kekal disimpan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillat tilgang i iOS-innstillingene under GaleriQ › Bilder. De tidligere valgene dine forblir lagret."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta toegang toe in Instellingen van iOS onder GaleriQ › Foto’s. Je eerdere keuzes blijven bewaard."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ସେଟିଂସରେ GaleriQ › ଫଟୋ ଅଧୀନରେ ଆକ୍ସେସ୍‌ର ଅନୁମତି ଦିଅନ୍ତୁ। ଆପଣଙ୍କ ପୂର୍ବ ଚୟନ ସେଭ୍ ରହିବ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ਸੈਟਿੰਗਾਂ ਵਿੱਚ GaleriQ › ਫ਼ੋਟੋਆਂ ਹੇਠ ਪਹੁੰਚ ਦੀ ਇਜਾਜ਼ਤ ਦਿਓ। ਤੁਹਾਡੀਆਂ ਪਿਛਲੀਆਂ ਚੋਣਾਂ ਸੰਭਾਲੀਆਂ ਰਹਿਣਗੀਆਂ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól na dostęp w Ustawieniach iOS w sekcji GaleriQ › Zdjęcia. Wcześniejsze decyzje pozostaną zapisane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso nos Ajustes do iOS em GaleriQ › Fotos. Suas escolhas anteriores continuam salvas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso nas Definições do iOS, em GaleriQ › Fotografias. As suas escolhas anteriores continuam guardadas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite accesul în Configurări iOS, la GaleriQ › Poze. Alegerile anterioare rămân salvate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите доступ в Настройках iOS: GaleriQ › Фото. Ваши прежние решения сохранятся."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Povoľte prístup v nastaveniach iOS v časti GaleriQ › Fotky. Vaše doterajšie rozhodnutia zostanú uložené."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dovoli dostop v nastavitvah iOS pod GaleriQ › Fotografije. Tvoje prejšnje odločitve ostanejo shranjene."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillåt åtkomst i iOS-inställningarna under GaleriQ › Bilder. Dina tidigare val förblir sparade."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS அமைப்புகளில் GaleriQ › Photos என்பதன் கீழ் அணுகலை அனுமதியுங்கள். உங்கள் முந்தைய தேர்வுகள் சேமிக்கப்பட்டிருக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS సెట్టింగ్‌లలో GaleriQ › Photos కింద యాక్సెస్ అనుమతించండి. మీ మునుపటి ఎంపికలు సేవ్ అయి ఉంటాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตการเข้าถึงในการตั้งค่า iOS ที่ GaleriQ › รูปภาพ การเลือกก่อนหน้านี้ของคุณยังคงบันทึกไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS Ayarlar’da GaleriQ › Fotoğraflar bölümünden erişime izin ver. Önceki kararların kayıtlı kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозвольте доступ у Параметрах iOS: GaleriQ › Фото. Ваші попередні рішення збережуться."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ترتیبات میں GaleriQ › تصاویر کے تحت رسائی دیں۔ آپ کے پچھلے انتخاب محفوظ رہیں گے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép truy cập trong Cài đặt iOS tại GaleriQ › Ảnh. Các lựa chọn trước đây của bạn vẫn được lưu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在 iOS“设置”中的 GaleriQ › 照片里允许访问。你之前的决定会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在 iOS「設定」› GaleriQ › 照片 中允許取用。你先前的選擇會繼續保留。"
          }
        }
      }
    },
