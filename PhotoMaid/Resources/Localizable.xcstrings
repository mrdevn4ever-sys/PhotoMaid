    "basket_confirm_delete_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ثم أكِّد لدى Android. لن تذهب هذه الصور والفيديوهات إلى سلة مهملات Android ولا يمكن استعادتها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätige anschließend bei Android. Die Fotos und Videos kommen nicht in den Android-Papierkorb und lassen sich nicht wiederherstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Then confirm with Android. These photos and videos will not go to the Android trash and cannot be restored."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después confirma en Android. Estas fotos y vídeos no irán a la papelera de Android y no se podrán recuperar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmez ensuite auprès d’Android. Ces photos et vidéos n’iront pas dans la corbeille Android et ne pourront pas être restaurées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Poi conferma con Android. Queste foto e questi video non finiranno nel cestino di Android e non si potranno recuperare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続けてAndroidで確認します。これらの写真と動画はAndroidのゴミ箱に入らず、復元できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이어서 Android에서 확인하세요. 이 사진과 동영상은 Android 휴지통에 들어가지 않으며 복원할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevestig daarna bij Android. Deze foto’s en video’s gaan niet naar de Android-prullenbak en zijn niet terug te halen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Następnie potwierdź w Androidzie. Te zdjęcia i filmy nie trafią do kosza Androida i nie da się ich przywrócić."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois confirme no Android. Estas fotos e vídeos não vão para o lixo do Android e não podem ser recuperados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apoi confirmă în Android. Aceste fotografii și videoclipuri nu ajung în coșul Android și nu pot fi recuperate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Затем подтвердите в Android. Эти фото и видео не попадут в корзину Android, восстановить их нельзя."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ardından Android’de onayla. Bu fotoğraf ve videolar Android çöp kutusuna gitmez ve geri yüklenemez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Потім підтвердьте в Android. Ці фото й відео не потраплять до кошика Android, відновити їх не можна."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随后请在 Android 中确认。这些照片和视频不会进入 Android 回收站，且无法恢复。"
          }
        }
      }
    },
