    "lib_fav_empty_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط ♡ على صورة أو فيديو لجعله مفضلًا. المفضلة هي نفسها في تطبيق الصور."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på ♡ på et foto eller en video for at gøre det til favorit. Favoritterne er de samme som i appen Fotos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe bei einem Foto oder Video auf ♡, um es zum Favoriten zu machen. Es sind dieselben Favoriten wie in der Fotos-App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap ♡ on a photo or video to make it a favourite. Favourites are the same as in the Photos app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca ♡ en una foto o vídeo para marcarlo como favorito. Son los mismos favoritos que en la app Fotos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez ♡ sur une photo ou une vidéo pour l’ajouter aux favoris. Ce sont les mêmes favoris que dans l’app Photos."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk ♡ pada foto atau video untuk menjadikannya favorit. Favorit sama dengan di app Foto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca ♡ su una foto o un video per aggiungerlo ai preferiti. Sono gli stessi preferiti dell’app Foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真やビデオの♡をタップするとお気に入りになります。写真アプリと同じお気に入りです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진이나 비디오에서 ♡를 탭하면 즐겨찾기가 됩니다. 사진 앱과 같은 즐겨찾기입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på ♡ på et bilde eller en video for å gjøre det til favoritt. Favorittene er de samme som i Bilder-appen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op ♡ bij een foto of video om er een favoriet van te maken. Het zijn dezelfde favorieten als in de Foto’s-app."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij ♡ przy zdjęciu lub filmie, aby dodać je do ulubionych. To te same ulubione, co w aplikacji Zdjęcia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em ♡ numa foto ou vídeo para torná-lo favorito. Os Favoritos são os mesmos do app Fotos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em ♡ numa fotografia ou vídeo para o tornar favorito. São os mesmos favoritos da app Fotografias."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge ♡ la o poză sau un videoclip ca să-l faci favorit. Sunt aceleași favorite ca în aplicația Poze."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите ♡ на фото или видео, чтобы добавить его в избранное. Это то же избранное, что и в приложении «Фото»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på ♡ på en bild eller video för att göra den till favorit. Favoriterna är desamma som i appen Bilder."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะ ♡ บนรูปหรือวิดีโอเพื่อตั้งเป็นรายการโปรด รายการโปรดเหมือนกับในแอพรูปภาพ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir fotoğraf veya videoda ♡ simgesine dokunarak favori yap. Favoriler Fotoğraflar uygulamasındakilerle aynıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться ♡ на фото чи відео, щоб додати його до вибраного. Це те саме вибране, що й у програмі «Фото»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm ♡ trên ảnh hoặc video để đánh dấu ưa thích. Mục ưa thích giống với trong ứng dụng Ảnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点照片或视频上的 ♡ 即可设为个人收藏。与“照片”App 中的个人收藏相同。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在照片或影片上點一下 ♡ 即可設為個人收藏。個人收藏與「照片」App 中相同。"
          }
        }
      }
    },
