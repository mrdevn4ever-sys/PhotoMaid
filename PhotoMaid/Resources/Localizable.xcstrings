    "edit_pro_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المعاينة مجانية · الحفظ يتطلب Pro أو تجربة 30 دقيقة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রিভিউ বিনামূল্যে · সংরক্ষণে Pro বা ৩০ মিনিটের পরীক্ষা লাগে"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La previsualització és gratuïta · per desar cal Pro o la prova de 30 minuts"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Náhled je zdarma · k uložení je potřeba Pro nebo 30minutový test"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksempel er gratis · at gemme kræver Pro eller 30-minutterstesten"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorschau frei · Speichern mit Pro oder 30-Minuten-Test"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η προεπισκόπηση είναι δωρεάν · για αποθήκευση χρειάζεται Pro ή η δοκιμή 30 λεπτών"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview is free · saving needs Pro or the 30-minute test"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vista previa gratis · guardar con Pro o la prueba de 30 minutos"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Esikatselu on ilmainen · tallentaminen vaatii Pron tai 30 minuutin kokeilun"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperçu gratuit · enregistrer avec Pro ou l’essai de 30 minutes"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પ્રીવ્યૂ મફત છે · સાચવવા Pro અથવા 30 મિનિટની ટ્રાયલ જોઈએ"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התצוגה המקדימה בחינם · לשמירה צריך Pro או ניסיון של 30 דקות"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रीव्यू मुफ़्त है · सहेजने के लिए Pro या 30 मिनट का टेस्ट चाहिए"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregled je besplatan · za spremanje treba Pro ili 30-minutni test"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az előnézet ingyenes · a mentéshez Pro vagy a 30 perces próba kell"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratinjau gratis · menyimpan butuh Pro atau uji coba 30 menit"
