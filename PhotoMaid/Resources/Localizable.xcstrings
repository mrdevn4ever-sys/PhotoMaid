    "sources_footer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قطع اتصال المجلد لا يحذف أي ملفات. أنت تختار المجلدات التي يصل إليها GaleriQ في عرض الملفات هذا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফোল্ডার বিচ্ছিন্ন করলে কোনো ফাইল মুছে যায় না। এই ফাইল দৃশ্যে আপনি বেছে নেন GaleriQ কোন ফোল্ডারে অ্যাক্সেস পাবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconnectar una carpeta no esborra cap fitxer. En aquesta vista de fitxers tries a quines carpetes pot accedir GaleriQ."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpojením složky se žádné soubory nesmažou. V tomto zobrazení souborů vybíráte, ke kterým složkám má GaleriQ přístup."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At afbryde forbindelsen til en mappe sletter ingen filer. Du vælger i denne filvisning, hvilke mapper GaleriQ må få adgang til."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Ordner zu trennen löscht keine Dateien. Für diese Dateiansicht wählst du selbst, welche Ordner GaleriQ sehen darf."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αποσύνδεση ενός φακέλου δεν διαγράφει αρχεία. Σε αυτή την προβολή αρχείων επιλέγεις σε ποιους φακέλους έχει πρόσβαση το GaleriQ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnecting a folder doesn’t delete any files. You choose which folders GaleriQ can access in this file view."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconectar una carpeta no borra sus archivos. Tú eliges a qué carpetas puede acceder GaleriQ en esta vista."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kansion yhteyden katkaiseminen ei poista tiedostoja. Tässä tiedostonäkymässä valitset, mihin kansioihin GaleriQ pääsee."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déconnecter un dossier ne supprime aucun fichier. Tu choisis les dossiers auxquels GaleriQ peut accéder dans cette vue."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફોલ્ડર અલગ કરવાથી કોઈ ફાઇલ ડિલીટ થતી નથી. આ ફાઇલ દૃશ્યમાં તમે પસંદ કરો છો કે GaleriQ કયાં ફોલ્ડર સુધી પહોંચી શકે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתוק תיקייה לא מוחק קבצים. בתצוגת הקבצים הזו בוחרים לאילו תיקיות GaleriQ יכולה לגשת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोल्डर अलग करने से कोई फ़ाइल डिलीट नहीं होती। इस फ़ाइल व्यू में आप चुनते हैं कि GaleriQ किन फ़ोल्डर तक पहुँच सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odspajanje mape ne briše nijednu datoteku. U ovom prikazu datoteka biraš kojim mapama GaleriQ smije pristupiti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy mappa leválasztása nem töröl fájlokat. Ebben a fájlnézetben választod ki, mely mappákhoz férhet hozzá a GaleriQ."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memutus folder tidak menghapus file apa pun. Kamu memilih folder mana yang bisa diakses GaleriQ di tampilan file ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scollegare una cartella non elimina i file. Decidi tu quali cartelle rendere accessibili a GaleriQ in questa vista."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続を解除しても、ファイルは削除されません。このファイル画面でGaleriQがアクセスするフォルダは自分で選べます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಫೋಲ್ಡರ್ ಸಂಪರ್ಕ ಕಡಿತಗೊಳಿಸುವುದರಿಂದ ಯಾವುದೇ ಫೈಲ್ ಅಳಿಸಲಾಗುವುದಿಲ್ಲ. GaleriQ ಯಾವ ಫೋಲ್ಡರ್‌ಗಳನ್ನು ಪ್ರವೇಶಿಸಬಹುದು ಎಂದು ಈ ಫೈಲ್ ವೀಕ್ಷಣೆಯಲ್ಲಿ ನೀವು ಆಯ್ಕೆಮಾಡುತ್ತೀರಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결을 해제해도 파일은 삭제되지 않아요. 이 파일 화면에서 GaleriQ가 접근할 폴더를 직접 선택할 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരു ഫോൾഡർ വിച്ഛേദിക്കുന്നത് ഒരു ഫയലും ഇല്ലാതാക്കില്ല. GaleriQ-ന് ഏത് ഫോൾഡറുകൾ ആക്‌സസ് ചെയ്യാമെന്ന് ഈ ഫയൽ കാഴ്ചയിൽ നിങ്ങൾ തിരഞ്ഞെടുക്കുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फोल्डर वेगळा केल्याने कोणतीही फाइल डिलीट होत नाही. या फाइल दृश्यात GaleriQ कोणत्या फोल्डरपर्यंत पोहोचू शकते ते तुम्ही निवडता."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Memutuskan sambungan folder tidak memadam sebarang fail. Anda memilih folder yang boleh diakses oleh GaleriQ dalam paparan fail ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å koble fra en mappe sletter ingen filer. Du velger i denne filvisningen hvilke mapper GaleriQ får tilgang til."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een map ontkoppelen verwijdert geen bestanden. Je kiest zelf welke mappen GaleriQ in deze bestandsweergave mag zien."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଫୋଲ୍ଡର ବିଚ୍ଛିନ୍ନ କଲେ କୌଣସି ଫାଇଲ୍ ଡିଲିଟ୍ ହୁଏ ନାହିଁ। GaleriQ କେଉଁ ଫୋଲ୍ଡର ଆକ୍ସେସ୍ କରିପାରିବ ଆପଣ ଏହି ଫାଇଲ୍ ଦୃଶ୍ୟରେ ବାଛନ୍ତି।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਫ਼ੋਲਡਰ ਡਿਸਕਨੈਕਟ ਕਰਨ ਨਾਲ ਕੋਈ ਫ਼ਾਈਲ ਨਹੀਂ ਮਿਟਦੀ। ਤੁਸੀਂ ਇਸ ਫ਼ਾਈਲ ਦ੍ਰਿਸ਼ ਵਿੱਚ ਚੁਣਦੇ ਹੋ ਕਿ GaleriQ ਕਿਹੜੇ ਫ਼ੋਲਡਰਾਂ ਤੱਕ ਪਹੁੰਚ ਸਕਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odłączenie folderu nie usuwa plików. W tym widoku samodzielnie wybierasz foldery dostępne dla GaleriQ."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconectar uma pasta não apaga nenhum arquivo. Você escolhe nesta visualização de arquivos quais pastas o GaleriQ pode acessar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Desligar uma pasta não elimina ficheiros. Escolhes as pastas a que o GaleriQ pode aceder nesta vista."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deconectarea unui dosar nu șterge fișiere. Tu alegi dosarele pe care GaleriQ le poate accesa în această vedere."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отключение папки не удаляет файлы. В этом разделе ты сам выбираешь папки, доступные GaleriQ."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpojením priečinka sa žiadne súbory nevymažú. V tomto zobrazení súborov vyberáte, ku ktorým priečinkom má GaleriQ prístup."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odklop mape ne izbriše nobene datoteke. V tem pogledu datotek izbiraš, do katerih map lahko dostopa GaleriQ."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att koppla från en mapp raderar inga filer. Du väljer i den här filvyn vilka mappar GaleriQ får komma åt."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கோப்புறையைத் துண்டிப்பது எந்தக் கோப்பையும் நீக்காது. GaleriQ எந்தக் கோப்புறைகளை அணுகலாம் என்பதை இந்தக் கோப்புக் காட்சியில் நீங்கள் தேர்ந்தெடுக்கிறீர்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫోల్డర్‌ను డిస్‌కనెక్ట్ చేయడం వల్ల ఏ ఫైల్ తొలగించబడదు. GaleriQ ఏ ఫోల్డర్‌లను యాక్సెస్ చేయగలదో ఈ ఫైల్ వీక్షణలో మీరే ఎంచుకుంటారు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การยกเลิกการเชื่อมต่อโฟลเดอร์ไม่ลบไฟล์ใดๆ คุณเลือกในมุมมองไฟล์นี้ว่า GaleriQ เข้าถึงโฟลเดอร์ใดได้บ้าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klasör bağlantısını kesmek dosyaları silmez. Bu görünümde GaleriQ uygulamasının hangi klasörlere erişeceğini sen seçersin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відключення папки не видаляє файли. У цьому розділі ти самостійно вибираєш папки, доступні для GaleriQ."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فولڈر الگ کرنے سے کوئی فائل حذف نہیں ہوتی۔ اس فائل ویو میں آپ منتخب کرتے ہیں کہ GaleriQ کن فولڈرز تک رسائی رکھے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngắt kết nối thư mục không xóa tệp nào. Bạn chọn thư mục mà GaleriQ được truy cập trong chế độ xem tệp này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "断开连接不会删除任何文件。你可以自行选择此文件页面中 GaleriQ 能访问的文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "中斷連接檔案夾不會刪除任何檔案。你在這個檔案檢視中選擇 GaleriQ 可以取用哪些檔案夾。"
          }
        }
      }
    },
