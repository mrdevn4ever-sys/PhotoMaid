    "set_weekly_recap": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عرض «أسبوعك الماضي»"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "“আপনার গত সপ্তাহ” দেখান"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar «La teva última setmana»"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazovat „Váš poslední týden“"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis “Din seneste uge”"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Deine letzte Woche“ anzeigen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφάνιση «Η τελευταία σου εβδομάδα»"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show “Your last week”"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar «Tu última semana»"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näytä ”Viime viikkosi”"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher « Ta semaine passée »"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "“તમારું પાછલું અઠવાડિયું” બતાવો"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הצגת „השבוע האחרון שלך”"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“आपका पिछला हफ़्ता” दिखाएँ"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikaži „Tvoj prošli tjedan”"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "„Az elmúlt heted” megjelenítése"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilkan “Minggu terakhirmu”"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra «La tua ultima settimana»"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「先週のふりかえり」を表示"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "“ನಿಮ್ಮ ಕಳೆದ ವಾರ” ತೋರಿಸಿ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘지난주 돌아보기’ 표시"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "“നിങ്ങളുടെ കഴിഞ്ഞ ആഴ്ച” കാണിക്കുക"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "“तुमचा मागील आठवडा” दाखवा"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunjukkan “Minggu lepas anda”"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis «Den siste uken din»"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘Je afgelopen week’ tonen"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "“ଆପଣଙ୍କ ଗତ ସପ୍ତାହ” ଦେଖାନ୍ତୁ"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "“ਤੁਹਾਡਾ ਪਿਛਲਾ ਹਫ਼ਤਾ” ਦਿਖਾਓ"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuj „Twój ostatni tydzień”"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar “Sua última semana”"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar «A tua última semana»"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Afișează „Săptămâna ta trecută”"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать «Твоя прошлая неделя»"
          }
        },
        "sk": {
