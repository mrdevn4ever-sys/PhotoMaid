          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În seif: %1$lld. Eliminate din aplicația Poze: %2$lld."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В сейфе: %1$lld. Удалено из «Фото»: %2$lld."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasada: %1$lld. Fotoğraflar uygulamasından kaldırılan: %2$lld."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У сейфі: %1$lld. Видалено з «Фото»: %2$lld."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已移入保险箱：%1$lld。已从“照片”App 移除：%2$lld。"
          }
        }
      }
    },
    "vault_import_failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر النقل: %1$lld (مثلًا عند عدم الاتصال بـ iCloud). ستبقى في تطبيق الصور."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht abgelegt: %1$lld (z. B. ohne Verbindung zu iCloud). Sie bleiben in der Fotos-App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t be moved: %1$lld (for example without a connection to iCloud). They stay in the Photos app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han podido mover: %1$lld (por ejemplo, sin conexión con iCloud). Se quedan en la app Fotos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible à déplacer : %1$lld (par exemple sans connexion à iCloud). Ils restent dans l’app Photos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non spostati: %1$lld (ad esempio senza connessione a iCloud). Restano nell’app Foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "移動できませんでした：%1$lld（iCloudに接続できない場合など）。写真アプリに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이동하지 못함: %1$lld개(예: iCloud에 연결되지 않은 경우). 사진 앱에 그대로 남아 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet verplaatst: %1$lld (bijvoorbeeld zonder verbinding met iCloud). Ze blijven in de Foto’s-app."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie przeniesiono: %1$lld (np. z powodu braku połączenia z iCloud). Pozostają w aplikacji Zdjęcia."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível mover: %1$lld (por exemplo, sem ligação ao iCloud). Ficam na app Fotografias."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu au putut fi mutate: %1$lld (de exemplu, fără conexiune la iCloud). Rămân în aplicația Poze."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось переместить: %1$lld (например, без подключения к iCloud). Они останутся в «Фото»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taşınamadı: %1$lld (örneğin iCloud bağlantısı olmadığında). Fotoğraflar uygulamasında kalırlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося перемістити: %1$lld (наприклад, без з’єднання з iCloud). Вони залишаться у «Фото»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法移入：%1$lld（例如未连接到 iCloud）。它们仍保留在“照片”App 中。"
          }
        }
      }
    },
    "vault_import_limit": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم النقل: %1$lld. حدّ الخزنة في Free: %2$lld، وفي Pro بلا حدود."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht abgelegt: %1$lld. Free erlaubt %2$lld Medien im Tresor, Pro unbegrenzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not moved: %1$lld. Free allows %2$lld items in the vault; Pro is unlimited."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No movidos: %1$lld. Free permite %2$lld elementos en la caja fuerte; Pro, ilimitados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non déplacés : %1$lld. Free autorise %2$lld éléments dans le coffre-fort ; Pro est illimité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non spostati: %1$lld. Free consente %2$lld elementi nella cassaforte; Pro è illimitato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "移動されませんでした：%1$lld。Freeでは保管庫に%2$lld項目まで、Proは無制限です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이동되지 않음: %1$lld개. Free는 금고에 %2$lld개까지, Pro는 무제한입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet verplaatst: %1$lld. Free staat %2$lld onderdelen in de kluis toe; Pro is onbeperkt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie przeniesiono: %1$lld. Limit sejfu w Free: %2$lld, w Pro bez limitu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não movidos: %1$lld. O Free permite %2$lld itens no cofre; o Pro é ilimitado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nemutate: %1$lld. Limita seifului în Free: %2$lld; Pro este nelimitat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не перемещено: %1$lld. Лимит сейфа во Free: %2$lld, в Pro — без ограничений."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taşınmadı: %1$lld. Free kasada %2$lld öğeye izin verir; Pro sınırsızdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не переміщено: %1$lld. Ліміт сейфа у Free: %2$lld, у Pro — без обмежень."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未移入：%1$lld。Free 版保险箱最多 %2$lld 项，Pro 版不限。"
          }
        }
      }
    },
    "vault_import_recently_deleted": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نصيحة: أفرِغ «المحذوفة مؤخرًا» في تطبيق الصور إذا أردت أن تختفي من هناك أيضًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipp: Leere „Zuletzt gelöscht“ in der Fotos-App, wenn sie auch dort verschwinden sollen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: empty “Recently Deleted” in the Photos app if they should disappear there too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consejo: vacía «Eliminado» en la app Fotos si quieres que desaparezcan también de allí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Astuce : vide « Suppressions récentes » dans l’app Photos s’ils doivent aussi disparaître de là."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggerimento: svuota «Eliminati di recente» nell’app Foto se vuoi che spariscano anche da lì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヒント：写真アプリからも消したい場合は、「最近削除した項目」を空にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팁: 사진 앱에서도 없애려면 ‘최근 삭제된 항목’을 비우세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: leeg ‘Recent verwijderd’ in de Foto’s-app als ze daar ook moeten verdwijnen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wskazówka: opróżnij „Ostatnio usunięte” w aplikacji Zdjęcia, jeśli mają zniknąć także stamtąd."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Dica: esvazia «Apagados recentemente» na app Fotografias se quiseres que desapareçam também de lá."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sfat: golește „Șterse recent” în aplicația Poze dacă vrei să dispară și de acolo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Совет: очисти «Недавно удаленные» в «Фото», если они должны исчезнуть и оттуда."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İpucu: Oradan da kaybolmalarını istiyorsan Fotoğraflar uygulamasındaki “Son Silinenler”i boşalt."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Порада: очисти «Нещодавно видалені» у «Фото», якщо вони мають зникнути й звідти."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提示：如果也想让它们从“照片”App 中消失，请清空“最近删除”。"
          }
        }
      }
    },
    "vault_import_with_copies": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النقل مع النسخ (%1$lld)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit Kopien ablegen (%1$lld)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
