    },
    "ach_local_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبقى كل شيء على هذا الـ iPhone. للإيقاف: الإعدادات › عرض الإنجازات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সবকিছু এই iPhone-এই থাকে। বন্ধ করতে: সেটিংস › অর্জন দেখান।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tot es queda en aquest iPhone. Per desactivar-ho: Configuració › Mostrar els èxits."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vše zůstává v tomto iPhonu. Vypnutí: Nastavení › Zobrazovat úspěchy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt bliver på denne iPhone. Slå fra: Indstillinger › Vis præstationer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles bleibt auf diesem iPhone. Abschalten: Einstellungen › Erfolge anzeigen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όλα μένουν σε αυτό το iPhone. Για απενεργοποίηση: Ρυθμίσεις › Εμφάνιση επιτευγμάτων."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything stays on this iPhone. To turn it off: Settings › Show achievements."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo se queda en este iPhone. Para desactivarlo: Ajustes › Mostrar logros."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki pysyy tässä iPhonessa. Poista käytöstä: Asetukset › Näytä saavutukset."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout reste sur cet iPhone. Pour désactiver : Paramètres › Afficher les succès."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બધું આ જ iPhone પર રહે છે. બંધ કરવા: સેટિંગ્સ › સિદ્ધિઓ બતાવો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הכול נשאר ב-iPhone הזה. לכיבוי: הגדרות › הצגת הישגים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सब कुछ इसी iPhone पर रहता है। बंद करने के लिए: सेटिंग्ज़ › उपलब्धियाँ दिखाएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sve ostaje na ovom iPhoneu. Za isključivanje: Postavke › Prikaži postignuća."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden ezen az iPhone-on marad. Kikapcsolás: Beállítások › Eredmények megjelenítése."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semuanya tetap di iPhone ini. Untuk mematikan: Pengaturan › Tampilkan pencapaian."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto resta su questo iPhone. Per disattivare: Impostazioni › Mostra traguardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてこのiPhone内に保存されます。オフにするには：設定 › 実績を表示"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಎಲ್ಲವೂ ಈ iPhone ನಲ್ಲೇ ಉಳಿಯುತ್ತದೆ. ಆಫ್ ಮಾಡಲು: ಸೆಟ್ಟಿಂಗ್‌ಗಳು › ಸಾಧನೆಗಳನ್ನು ತೋರಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 정보는 이 iPhone에만 있어요. 끄려면: 설정 › 업적 표시"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എല്ലാം ഈ iPhone-ൽ തന്നെ തുടരും. ഓഫാക്കാൻ: ക്രമീകരണം › നേട്ടങ്ങൾ കാണിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्व काही याच iPhone वर राहते. बंद करण्यासाठी: सेटिंग्ज › कामगिरी दाखवा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semuanya kekal pada iPhone ini. Untuk mematikannya: Seting › Tunjukkan pencapaian."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt blir på denne iPhonen. Slå av: Innstillinger › Vis prestasjoner."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles blijft op deze iPhone. Uitzetten: Instellingen › Prestaties tonen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସବୁକିଛି ଏହି iPhoneରେ ହିଁ ରହେ। ବନ୍ଦ କରିବାକୁ: ସେଟିଂସ › ସଫଳତା ଦେଖାନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਭ ਕੁਝ ਇਸੇ iPhone ਉੱਤੇ ਰਹਿੰਦਾ ਹੈ। ਬੰਦ ਕਰਨ ਲਈ: ਸੈਟਿੰਗਾਂ › ਪ੍ਰਾਪਤੀਆਂ ਦਿਖਾਓ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko zostaje na tym iPhonie. Wyłączanie: Ustawienia › Pokazuj osiągnięcia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo fica neste iPhone. Para desativar: Ajustes › Mostrar conquistas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo fica neste iPhone. Para desativar: Definições › Mostrar conquistas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Totul rămâne pe acest iPhone. Dezactivare: Setări › Afișează realizările."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё остаётся на этом iPhone. Отключить: Настройки › Показывать достижения."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Všetko zostáva v tomto iPhone. Vypnutie: Nastavenia › Zobrazovať úspechy."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vse ostane v tem iPhonu. Za izklop: Nastavitve › Prikaži dosežke."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Allt stannar på den här iPhonen. Stäng av: Inställningar › Visa prestationer."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அனைத்தும் இந்த iPhone-இலேயே இருக்கும். முடக்க: அமைப்புகள் › சாதனைகளைக் காட்டு."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అంతా ఈ iPhoneలోనే ఉంటుంది. ఆఫ్ చేయడానికి: సెట్టింగ్‌లు › విజయాలను చూపించు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกอย่างอยู่บน iPhone เครื่องนี้ หากต้องการปิด: การตั้งค่า › แสดงความสำเร็จ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her şey bu iPhone’da kalır. Kapatmak için: Ayarlar › Başarıları göster."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе залишається на цьому iPhone. Вимкнути: Налаштування › Показувати досягнення."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سب کچھ اسی iPhone پر رہتا ہے۔ بند کرنے کے لیے: ترتیبات › کامیابیاں دکھائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi thứ chỉ ở trên iPhone này. Để tắt: Cài đặt › Hiện thành tích."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有数据都保存在这台 iPhone 上。关闭：设置 › 显示成就。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一切都只留在這部 iPhone 上。若要關閉：設定 › 顯示成就。"
          }
        }
      }
    },
