    "help_cloud_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد تزامن خدمات سحابية مثل صور Google عمليات الحذف مع أجهزة أخرى. راجع إعداداتها. يحمّل GaleriQ الصور والفيديوهات من صور iCloud تلقائيًا عند الحاجة، تمامًا مثل تطبيق الصور."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Photos-এর মতো ক্লাউড সেবা মুছে ফেলা জিনিস অন্য ডিভাইসে সিঙ্ক করতে পারে। তাদের সেটিংস দেখে নিন। GaleriQ প্রয়োজনে iCloud ফটো থেকে ফটো ও ভিডিও স্বয়ংক্রিয়ভাবে লোড করে, ঠিক ফটো অ্যাপের মতো।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els serveis al núvol com Google Fotos poden sincronitzar les eliminacions amb altres dispositius. Revisa’n la configuració. GaleriQ carrega automàticament fotos i vídeos de Fotos d’iCloud quan cal, igual que l’app Fotos."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudové služby jako Fotky Google mohou synchronizovat smazání do dalších zařízení. Zkontrolujte jejich nastavení. GaleriQ načítá fotky a videa z Fotek na iCloudu automaticky podle potřeby, stejně jako aplikace Fotky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skytjenester som Google Fotos kan synkronisere sletninger til andre enheder. Tjek deres indstillinger. GaleriQ indlæser automatisk fotos og videoer fra iCloud-fotos efter behov, ligesom appen Fotos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud-Dienste wie Google Fotos können Löschungen auf andere Geräte übertragen. Prüfe dazu ihre Einstellungen. Fotos und Videos aus iCloud-Fotos lädt GaleriQ bei Bedarf automatisch – wie die Fotos-App."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Υπηρεσίες cloud όπως το Google Photos μπορεί να συγχρονίζουν τις διαγραφές σε άλλες συσκευές. Έλεγξε τις ρυθμίσεις τους. Το GaleriQ φορτώνει αυτόματα φωτογραφίες και βίντεο από τις Φωτογραφίες iCloud όταν χρειάζεται, όπως και η εφαρμογή Φωτογραφίες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud services such as Google Photos may sync deletions to other devices. Check their settings. GaleriQ loads photos and videos from iCloud Photos automatically when needed, just like the Photos app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los servicios en la nube, como Google Fotos, pueden sincronizar los borrados con otros dispositivos. Revisa sus ajustes. GaleriQ carga automáticamente las fotos y los vídeos de Fotos de iCloud cuando hace falta, igual que la app Fotos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilvipalvelut, kuten Google Kuvat, voivat synkronoida poistot muille laitteille. Tarkista niiden asetukset. GaleriQ lataa kuvat ja videot iCloud-kuvista automaattisesti tarvittaessa, aivan kuten Kuvat-appi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les services cloud comme Google Photos peuvent répercuter les suppressions sur d’autres appareils. Vérifie leurs paramètres. GaleriQ charge automatiquement les photos et vidéos de Photos iCloud si nécessaire, comme l’app Photos."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Photos જેવી ક્લાઉડ સેવાઓ ડિલીટ કરેલું બીજાં ઉપકરણો પર સિંક કરી શકે છે. તેમનાં સેટિંગ્સ તપાસો. GaleriQ જરૂર પડે ત્યારે iCloud ફોટોમાંથી ફોટા અને વીડિયો આપમેળે લોડ કરે છે, બરાબર ફોટો ઍપની જેમ."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שירותי ענן כמו Google Photos עשויים לסנכרן מחיקות למכשירים אחרים. כדאי לבדוק את ההגדרות שלהם. GaleriQ טוענת תמונות וסרטונים מ״תמונות iCloud״ אוטומטית לפי הצורך, בדיוק כמו היישום ״תמונות״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Photos जैसी क्लाउड सेवाएँ डिलीट को दूसरे डिवाइस पर सिंक कर सकती हैं। उनकी सेटिंग्ज़ जाँचें। GaleriQ ज़रूरत पड़ने पर iCloud तस्वीरें से फ़ोटो और वीडियो अपने-आप लोड करता है, बिल्कुल तस्वीरें ऐप की तरह।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Usluge u oblaku poput Google fotografija mogu sinkronizirati brisanja na druge uređaje. Provjeri njihove postavke. GaleriQ automatski učitava fotografije i videozapise iz iCloud fotografija po potrebi, baš kao aplikacija Fotografije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A felhőszolgáltatások, például a Google Fotók, más eszközökre is szinkronizálhatják a törléseket. Ellenőrizd a beállításaikat. A GaleriQ szükség esetén automatikusan betölti a fotókat és videókat az iCloud-fotókból, ahogy a Fotók app is."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Layanan cloud seperti Google Foto mungkin menyinkronkan penghapusan ke perangkat lain. Periksa pengaturannya. GaleriQ memuat foto dan video dari Foto iCloud secara otomatis saat diperlukan, sama seperti app Foto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I servizi cloud, come Google Foto, possono sincronizzare le eliminazioni con altri dispositivi. Controlla le loro impostazioni. GaleriQ carica automaticamente foto e video da Foto di iCloud quando serve, proprio come l’app Foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Google フォトなどのクラウドサービスでは、削除が他の端末に同期される場合があります。各サービスの設定を確認してください。GaleriQは写真アプリと同じように、必要に応じてiCloud写真の写真やビデオを自動的に読み込みます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Photos ನಂತಹ ಕ್ಲೌಡ್ ಸೇವೆಗಳು ಅಳಿಸುವಿಕೆಗಳನ್ನು ಇತರ ಸಾಧನಗಳಿಗೆ ಸಿಂಕ್ ಮಾಡಬಹುದು. ಅವುಗಳ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಪರಿಶೀಲಿಸಿ. GaleriQ ಅಗತ್ಯವಿದ್ದಾಗ iCloud ಫೋಟೋಗಳಿಂದ ಫೋಟೋಗಳು ಮತ್ತು ವೀಡಿಯೊಗಳನ್ನು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಲೋಡ್ ಮಾಡುತ್ತದೆ, ಫೋಟೋಗಳು ಆ್ಯಪ್‌ನಂತೆಯೇ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Google 포토 같은 클라우드 서비스가 삭제 내용을 다른 기기에 동기화할 수 있어요. 각 서비스의 설정을 확인하세요. GaleriQ는 사진 앱처럼 필요할 때 iCloud 사진의 사진과 동영상을 자동으로 불러와요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Photos പോലുള്ള ക്ലൗഡ് സേവനങ്ങൾ ഇല്ലാതാക്കലുകൾ മറ്റ് ഉപകരണങ്ങളിലേക്ക് സമന്വയിപ്പിച്ചേക്കാം. അവയുടെ ക്രമീകരണങ്ങൾ പരിശോധിക്കുക. GaleriQ ആവശ്യമുള്ളപ്പോൾ iCloud ഫോട്ടോസിൽ നിന്ന് ഫോട്ടോകളും വീഡിയോകളും സ്വയമേവ ലോഡ് ചെയ്യുന്നു, ഫോട്ടോസ് ആപ്പ് പോലെ തന്നെ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Photos सारख्या क्लाउड सेवा डिलीट केलेले इतर डिव्हाइसवर सिंक करू शकतात. त्यांची सेटिंग्ज तपासा. GaleriQ गरजेनुसार iCloud फोटोमधून फोटो आणि व्हिडिओ आपोआप लोड करते, अगदी फोटो अ‍ॅपसारखे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perkhidmatan awan seperti Google Photos mungkin menyegerakkan pemadaman ke peranti lain. Semak seting mereka. GaleriQ memuatkan foto dan video daripada Foto iCloud secara automatik apabila perlu, sama seperti app Foto."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skytjenester som Google Foto kan synkronisere slettinger til andre enheter. Sjekk innstillingene deres. GaleriQ laster automatisk inn bilder og videoer fra iCloud-bilder ved behov, akkurat som Bilder-appen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Clouddiensten zoals Google Foto’s kunnen verwijderingen synchroniseren met andere apparaten. Controleer hun instellingen. GaleriQ laadt foto’s en video’s uit iCloud-foto’s automatisch wanneer nodig, net als de Foto’s-app."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Photos ଭଳି କ୍ଲାଉଡ୍ ସେବା ଡିଲିଟ୍‌କୁ ଅନ୍ୟ ଡିଭାଇସ୍‌ରେ ସିଙ୍କ୍ କରିପାରେ। ସେଗୁଡ଼ିକର ସେଟିଂସ ଯାଞ୍ଚ କରନ୍ତୁ। GaleriQ ଆବଶ୍ୟକ ହେଲେ iCloud ଫଟୋରୁ ଫଟୋ ଓ ଭିଡିଓ ସ୍ୱୟଂଚାଳିତ ଭାବେ ଲୋଡ୍ କରେ, ଠିକ୍ ଫଟୋ ଆପ୍ ଭଳି।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Photos ਵਰਗੀਆਂ ਕਲਾਊਡ ਸੇਵਾਵਾਂ ਮਿਟਾਈਆਂ ਚੀਜ਼ਾਂ ਨੂੰ ਹੋਰ ਡਿਵਾਈਸਾਂ ਨਾਲ ਸਿੰਕ ਕਰ ਸਕਦੀਆਂ ਹਨ। ਉਨ੍ਹਾਂ ਦੀਆਂ ਸੈਟਿੰਗਾਂ ਜਾਂਚੋ। GaleriQ ਲੋੜ ਪੈਣ ’ਤੇ iCloud ਫ਼ੋਟੋਆਂ ਤੋਂ ਫ਼ੋਟੋਆਂ ਅਤੇ ਵੀਡੀਓ ਆਪਣੇ-ਆਪ ਲੋਡ ਕਰਦਾ ਹੈ, ਬਿਲਕੁਲ ਫ਼ੋਟੋਆਂ ਐਪ ਵਾਂਗ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usługi chmurowe, takie jak Zdjęcia Google, mogą synchronizować usunięcia z innymi urządzeniami. Sprawdź ich ustawienia. GaleriQ w razie potrzeby automatycznie wczytuje zdjęcia i filmy ze Zdjęć iCloud – tak jak aplikacja Zdjęcia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Serviços de nuvem como o Google Fotos podem sincronizar exclusões com outros aparelhos. Confira os ajustes deles. O GaleriQ carrega fotos e vídeos das Fotos do iCloud automaticamente quando necessário, como o app Fotos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Serviços na nuvem, como o Google Fotos, podem sincronizar eliminações com outros dispositivos. Verifica as respetivas definições. O GaleriQ carrega automaticamente fotografias e vídeos das Fotografias em iCloud quando necessário, tal como a app Fotografias."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Serviciile cloud precum Google Foto pot sincroniza ștergerile cu alte dispozitive. Verifică-le setările. GaleriQ încarcă automat, la nevoie, fotografiile și videoclipurile din Poze iCloud, la fel ca aplicația Poze."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Облачные сервисы, например Google Фото, могут синхронизировать удаления с другими устройствами. Проверь их настройки. При необходимости GaleriQ автоматически загружает фото и видео из Фото iCloud — как приложение «Фото»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudové služby ako Fotky Google môžu synchronizovať vymazanie do ďalších zariadení. Skontrolujte ich nastavenia. GaleriQ načítava fotky a videá z Fotiek na iCloude automaticky podľa potreby, rovnako ako aplikácia Fotky."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Storitve v oblaku, kot je Google Foto, lahko izbrise sinhronizirajo v druge naprave. Preveri njihove nastavitve. GaleriQ po potrebi samodejno naloži fotografije in videoposnetke iz Fotografij iCloud, tako kot aplikacija Fotografije."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Molntjänster som Google Foto kan synka raderingar till andra enheter. Kontrollera deras inställningar. GaleriQ läser in bilder och videor från iCloud-bilder automatiskt vid behov, precis som appen Bilder."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Photos போன்ற மேகக்கணிச் சேவைகள் நீக்கங்களை மற்ற சாதனங்களுக்கு ஒத்திசைக்கலாம். அவற்றின் அமைப்புகளைச் சரிபாருங்கள். GaleriQ தேவைப்படும்போது iCloud புகைப்படங்களிலிருந்து புகைப்படங்களையும் வீடியோக்களையும் தானாக ஏற்றுகிறது, Photos ஆப்பைப் போலவே."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Photos వంటి క్లౌడ్ సేవలు తొలగింపులను ఇతర పరికరాలకు సింక్ చేయవచ్చు. వాటి సెట్టింగ్‌లు తనిఖీ చేయండి. GaleriQ అవసరమైనప్పుడు iCloud ఫోటోల నుండి ఫోటోలు, వీడియోలను ఆటోమేటిక్‌గా లోడ్ చేస్తుంది, Photos యాప్ లాగానే."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บริการคลาวด์อย่าง Google Photos อาจซิงค์การลบไปยังอุปกรณ์อื่น ตรวจสอบการตั้งค่าของบริการเหล่านั้น GaleriQ โหลดรูปภาพและวิดีโอจากรูปภาพ iCloud โดยอัตโนมัติเมื่อจำเป็น เหมือนแอพรูปภาพ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Fotoğraflar gibi bulut hizmetleri silme işlemlerini diğer cihazlarla eşitleyebilir. Ayarlarını kontrol et. GaleriQ, Fotoğraflar uygulaması gibi gerektiğinde iCloud Fotoğrafları’ndaki fotoğraf ve videoları otomatik olarak yükler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Хмарні сервіси, як-от Google Фото, можуть синхронізувати видалення з іншими пристроями. Перевір їхні налаштування. За потреби GaleriQ автоматично завантажує фото й відео з Фото iCloud — як програма «Фото»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Photos جیسی کلاؤڈ سروسز حذف کرنے کو دوسری ڈیوائسز پر سنک کر سکتی ہیں۔ ان کی ترتیبات چیک کریں۔ GaleriQ ضرورت پر iCloud تصاویر سے تصاویر اور ویڈیوز خود بخود لوڈ کرتا ہے، بالکل تصاویر ایپ کی طرح۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các dịch vụ đám mây như Google Photos có thể đồng bộ việc xóa sang thiết bị khác. Hãy kiểm tra cài đặt của chúng. GaleriQ tự động tải ảnh và video từ Ảnh iCloud khi cần, giống như ứng dụng Ảnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Google 相册等云服务可能将删除操作同步到其他设备。请检查各服务的设置。GaleriQ 会像“照片”App 一样，在需要时自动载入 iCloud 照片中的照片和视频。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Google 相簿等雲端服務可能會將刪除同步到其他裝置。請檢查它們的設定。GaleriQ 會在需要時自動從「iCloud 照片」載入照片和影片，就像「照片」App 一樣。"
          }
        }
      }
    },
