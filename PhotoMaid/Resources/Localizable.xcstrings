    "dock_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح سلة المهملات. لا يُحذف شيء دون تأكيدك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet den Papierkorb. Gelöscht wird erst nach deiner Bestätigung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens the trash. Nothing is deleted without your confirmation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la papelera. No se borra nada sin tu confirmación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre la corbeille. Rien n’est supprimé sans ta confirmation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre il cestino. Nulla viene eliminato senza la tua conferma."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴミ箱を開きます。確認なしで削除されることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통을 열어요. 확인 없이 삭제하지 않아요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent de prullenbak. Er wordt niets verwijderd zonder je bevestiging."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwiera kosz. Nic nie zostanie usunięte bez Twojej zgody."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o lixo. Nada é eliminado sem a tua confirmação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschide coșul. Nimic nu este șters fără confirmarea ta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает корзину. Ничего не удаляется без твоего подтверждения."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çöp kutusunu açar. Onayın olmadan hiçbir şey silinmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкриває кошик. Нічого не видаляється без твого підтвердження."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开回收站。未经确认，不会删除任何内容。"
          }
        }
      }
    },
