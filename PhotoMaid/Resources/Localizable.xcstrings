    "set_protect_favorites_detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمنع انتقال الصور والفيديوهات المفضّلة إلى سلة المهملات بالخطأ."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stops favorite photos and videos from going into the trash by mistake."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verhindert, dass favorisierte Fotos und Videos versehentlich im Papierkorb landen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stops favorite photos and videos from going into the trash by mistake."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita que las fotos y los vídeos favoritos vayan a la papelera por error."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Empêche de mettre les photos et vidéos favorites à la corbeille par erreur."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stops favorite photos and videos from going into the trash by mistake."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita che foto e video preferiti finiscano nel cestino per errore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お気に入りの写真や動画が、誤ってゴミ箱に入るのを防ぎます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "즐겨찾기한 사진과 동영상이 실수로 휴지통에 들어가지 않도록 해요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stops favorite photos and videos from going into the trash by mistake."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voorkomt dat favoriete foto’s en video’s per ongeluk in de prullenbak terechtkomen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapobiega przypadkowemu przeniesieniu ulubionych zdjęć i filmów do kosza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stops favorite photos and videos from going into the trash by mistake."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita que fotos e vídeos favoritos sejam colocados no lixo por engano."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Împiedică mutarea din greșeală în coș a fotografiilor și videoclipurilor favorite."
