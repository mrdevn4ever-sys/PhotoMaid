    "tools_originals_kept": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أصولك لم تتغير – لم تتحرر أي مساحة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার মূল ফাইল অপরিবর্তিত – কোনো জায়গা খালি হয়নি।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els originals no han canviat: no s’ha alliberat espai."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše originály jsou beze změny – žádné místo nebylo uvolněno."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine originaler er uændrede – ingen plads blev frigjort."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Originale sind unverändert – es wurde kein Platz frei."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα πρωτότυπά σου δεν άλλαξαν – δεν ελευθερώθηκε χώρος."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your originals are unchanged – no space was freed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus originales no han cambiado; no se ha liberado espacio."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Alkuperäisesi ovat ennallaan – tilaa ei vapautunut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos originaux sont inchangés : aucun espace libéré."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારાં મૂળ બદલાયાં નથી – કોઈ જગ્યા ખાલી થઈ નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המקוריים שלך לא השתנו – לא התפנה מקום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके मूल नहीं बदले – कोई जगह खाली नहीं हुई।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoji originali su nepromijenjeni – prostor nije oslobođen."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az eredetijeid változatlanok – nem szabadult fel hely."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aslimu tidak berubah – tidak ada ruang yang dikosongkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi originali sono invariati: nessuno spazio liberato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元のファイルはそのままです。容量は空いていません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಮೂಲಗಳು ಬದಲಾಗಿಲ್ಲ – ಯಾವುದೇ ಸ್ಥಳ ಮುಕ್ತವಾಗಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본은 그대로이며 공간은 확보되지 않았습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ഒറിജിനലുകൾക്ക് മാറ്റമില്ല – സ്ഥലമൊന്നും ഒഴിവായില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमची मूळ बदललेली नाहीत – जागा मोकळी झाली नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Fail asal anda tidak berubah – tiada ruang dikosongkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Originalene dine er uendret – ingen plass ble frigjort."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je originelen zijn ongewijzigd – er is geen ruimte vrijgekomen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ ମୂଳ ଫାଇଲ୍ ଅପରିବର୍ତ୍ତିତ – କୌଣସି ସ୍ଥାନ ଖାଲି ହୋଇନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੇ ਮੂਲ ਬਿਨਾਂ ਬਦਲੇ ਹਨ – ਕੋਈ ਥਾਂ ਖਾਲੀ ਨਹੀਂ ਹੋਈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oryginały są bez zmian – nie zwolniono miejsca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus originais não foram alterados – nenhum espaço foi liberado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os originais não foram alterados – não foi libertado espaço."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Originalele sunt neschimbate – nu s-a eliberat spațiu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оригиналы не изменены – место не освобождено."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše originály sú bez zmeny – žiadne miesto sa neuvoľnilo."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoji izvirniki so nespremenjeni – prostor se ni sprostil."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina original är oförändrade – inget utrymme frigjordes."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் அசல்கள் மாறவில்லை – இடம் எதுவும் காலியாகவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ ఒరిజినల్‌లు మారలేదు – స్థలం ఏదీ ఖాళీ కాలేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้นฉบับของคุณไม่เปลี่ยนแปลง – ยังไม่มีพื้นที่ว่างเพิ่ม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Orijinallerin değişmedi; yer açılmadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оригінали не змінено – місце не звільнено."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے اصل تبدیل نہیں ہوئے – کوئی جگہ خالی نہیں ہوئی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản gốc không thay đổi – chưa giải phóng dung lượng nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原文件未更改，未释放空间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的原始檔沒有更改 – 沒有釋放空間。"
          }
        }
      }
    },
