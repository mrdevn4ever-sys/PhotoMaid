    "privacy_media_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لعرض الصور والفيديوهات وترتيبها وإزالتها بعد تأكيدك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit du Fotos und Videos ansehen, sortieren und nach deiner Bestätigung entfernen kannst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To view, organize and remove photos and videos after your confirmation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ver, organizar y quitar fotos y vídeos tras tu confirmación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour voir, organiser et retirer des photos et vidéos après ta confirmation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per vedere, organizzare e rimuovere foto e video dopo la tua conferma."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真や動画の表示、整理、確認後の削除に使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진과 동영상을 보고 정리하고, 확인 후 삭제하는 데 사용해요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om foto’s en video’s te bekijken, te ordenen en na je bevestiging te verwijderen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby przeglądać, porządkować i usuwać zdjęcia oraz filmy po Twoim potwierdzeniu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ver, organizar e remover fotos e vídeos após a tua confirmação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a vedea, organiza și elimina fotografii și videoclipuri după confirmarea ta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы просматривать, упорядочивать и удалять фото и видео после твоего подтверждения."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraf ve videoları görüntülemek, düzenlemek ve onayından sonra kaldırmak için."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб переглядати, впорядковувати й видаляти фото та відео після твого підтвердження."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于查看、整理照片和视频，并在你确认后移除。"
          }
        }
      }
    },
