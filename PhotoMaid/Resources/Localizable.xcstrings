        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarjetas de práctica. Aquí no se guarda nada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Harjoituskortteja. Täällä ei tallenneta mitään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cartes d’essai. Rien n’est enregistré ici."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અભ્યાસ કાર્ડ. અહીં કંઈ સચવાતું નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קלפי תרגול. שום דבר לא נשמר כאן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभ्यास कार्ड। यहाँ कुछ भी सहेजा नहीं जाता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartice za vježbu. Ovdje se ništa ne sprema."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Gyakorlókártyák. Itt semmi sem mentődik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartu latihan. Tidak ada yang disimpan di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Schede di prova. Qui non viene salvato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "練習用のカードです。ここでの操作は保存されません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅಭ್ಯಾಸ ಕಾರ್ಡ್‌ಗಳು. ಇಲ್ಲಿ ಏನನ್ನೂ ಉಳಿಸಲಾಗುವುದಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연습용 카드예요. 여기서는 아무것도 저장하지 않아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പരിശീലന കാർഡുകൾ. ഇവിടെ ഒന്നും സംരക്ഷിക്കില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सरावाची कार्डे. इथे काहीही जतन होत नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad latihan. Tiada apa disimpan di sini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Øvingskort. Ingenting lagres her."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oefenkaarten. Hier wordt niets opgeslagen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଅଭ୍ୟାସ କାର୍ଡ। ଏଠାରେ କିଛି ସେଭ୍ ହୁଏ ନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਅਭਿਆਸ ਕਾਰਡ। ਇੱਥੇ ਕੁਝ ਨਹੀਂ ਸੰਭਾਲਿਆ ਜਾਂਦਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Karty do ćwiczeń. Nic nie jest tu zapisywane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cartas de treino. Nada é salvo aqui."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cartões de treino. Nada é guardado aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Carduri de probă. Nimic nu se salvează aici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Учебные карточки. Здесь ничего не сохраняется."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Cvičné karty. Nič sa tu neukladá."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vadbene karte. Tukaj se nič ne shrani."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Övningskort. Inget sparas här."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பயிற்சி அட்டைகள். இங்கே எதுவும் சேமிக்கப்படாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రాక్టీస్ కార్డ్‌లు. ఇక్కడ ఏదీ సేవ్ కాదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การ์ดฝึกซ้อม ไม่มีอะไรถูกบันทึกที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alıştırma kartları. Burada hiçbir şey kaydedilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Навчальні картки. Тут нічого не зберігається."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مشق کے کارڈ۔ یہاں کچھ محفوظ نہیں ہوتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thẻ luyện tập. Không có gì được lưu ở đây."
          }
        },
        "zh-Hans": {
