    "feed_icloud_retry_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعيد تحميل الجودة الكاملة من iCloud. يمكنك اتخاذ القرار بالمعاينة في أي وقت."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud থেকে পূর্ণ মান আবার লোড করে। আপনি প্রিভিউ দেখে যেকোনো সময় সিদ্ধান্ত নিতে পারেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Torna a carregar la qualitat completa d’iCloud. Pots decidir amb la previsualització en qualsevol moment."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Znovu načte plnou kvalitu z iCloudu. Rozhodnout se můžete kdykoli i podle náhledu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indlæser den fulde kvalitet fra iCloud igen. Du kan altid beslutte ud fra eksemplet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lädt die volle Qualität erneut aus iCloud. Entscheiden kannst du jederzeit mit der Vorschau."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Φορτώνει ξανά την πλήρη ποιότητα από το iCloud. Μπορείς να αποφασίσεις με την προεπισκόπηση ανά πάσα στιγμή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loads the full quality from iCloud again. You can decide with the preview at any time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a cargar la calidad completa desde iCloud. Puedes decidir con la vista previa en cualquier momento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lataa täyden laadun iCloudista uudelleen. Voit päättää esikatselun perusteella milloin tahansa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recharge la qualité maximale depuis iCloud. Tu peux décider avec l’aperçu à tout moment."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud માંથી પૂરી ગુણવત્તા ફરી લોડ કરે છે. તમે ગમે ત્યારે પ્રીવ્યૂ જોઈને નિર્ણય લઈ શકો છો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "טוען שוב את האיכות המלאה מ-iCloud. אפשר להחליט לפי התצוגה המקדימה בכל עת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud से पूरी क्वालिटी फिर लोड करता है। आप कभी भी प्रीव्यू देखकर फ़ैसला कर सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponovno učitava punu kvalitetu iz iClouda. Uvijek možeš odlučiti i na temelju pregleda."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Újra betölti a teljes minőséget az iCloudból. Az előnézet alapján bármikor dönthetsz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memuat kualitas penuh dari iCloud lagi. Kamu bisa memutuskan dengan pratinjau kapan saja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricarica la qualità piena da iCloud. Puoi decidere con l’anteprima in qualsiasi momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudからフル画質をもう一度読み込みます。プレビューのままいつでも判断できます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ನಿಂದ ಪೂರ್ಣ ಗುಣಮಟ್ಟವನ್ನು ಮತ್ತೆ ಲೋಡ್ ಮಾಡುತ್ತದೆ. ಪೂರ್ವವೀಕ್ಷಣೆಯೊಂದಿಗೆ ಯಾವಾಗ ಬೇಕಾದರೂ ನಿರ್ಧರಿಸಬಹುದು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud에서 원본 화질을 다시 불러와요. 미리보기로 언제든 결정할 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud-ൽ നിന്ന് പൂർണ്ണ നിലവാരം വീണ്ടും ലോഡ് ചെയ്യുന്നു. പ്രിവ്യൂ ഉപയോഗിച്ച് എപ്പോൾ വേണമെങ്കിലും തീരുമാനിക്കാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud मधून पूर्ण गुणवत्ता पुन्हा लोड करते. तुम्ही कधीही पूर्वावलोकन पाहून निर्णय घेऊ शकता."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Memuatkan semula kualiti penuh dari iCloud. Anda boleh membuat keputusan dengan pratonton pada bila-bila masa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Laster inn full kvalitet fra iCloud igjen. Du kan når som helst bestemme ut fra forhåndsvisningen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laadt de volledige kwaliteit opnieuw uit iCloud. Je kunt altijd met de voorvertoning beslissen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudରୁ ସମ୍ପୂର୍ଣ୍ଣ ଗୁଣବତ୍ତା ପୁଣି ଲୋଡ୍ କରେ। ଆପଣ ପ୍ରିଭ୍ୟୁ ସହ ଯେକୌଣସି ସମୟରେ ନିଷ୍ପତ୍ତି ନେଇପାରିବେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ਤੋਂ ਪੂਰੀ ਗੁਣਵੱਤਾ ਦੁਬਾਰਾ ਲੋਡ ਕਰਦਾ ਹੈ। ਤੁਸੀਂ ਪੂਰਵ-ਝਲਕ ਨਾਲ ਕਦੇ ਵੀ ਫ਼ੈਸਲਾ ਕਰ ਸਕਦੇ ਹੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponownie wczytuje pełną jakość z iCloud. Możesz zdecydować na podstawie podglądu w każdej chwili."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Carrega de novo a qualidade total do iCloud. Você pode decidir com a prévia a qualquer momento."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta a carregar a qualidade total do iCloud. Podes decidir com a pré-visualização a qualquer momento."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Reîncarcă la calitate maximă din iCloud. Poți decide oricând pe baza previzualizării."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снова загружает полное качество из iCloud. Решать можно в любой момент по превью."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Znova načíta plnú kvalitu z iCloudu. Rozhodnúť sa môžete kedykoľvek aj podľa náhľadu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znova naloži polno kakovost iz iClouda. S predogledom se lahko odločiš kadar koli."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Läser in full kvalitet från iCloud igen. Du kan när som helst bestämma utifrån förhandsvisningen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud-இலிருந்து முழுத் தரத்தை மீண்டும் ஏற்றுகிறது. முன்னோட்டத்தைக் கொண்டே எப்போது வேண்டுமானாலும் முடிவு செய்யலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud నుండి పూర్తి నాణ్యతను మళ్లీ లోడ్ చేస్తుంది. ప్రివ్యూతో ఎప్పుడైనా నిర్ణయించవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โหลดคุณภาพเต็มจาก iCloud อีกครั้ง คุณตัดสินใจจากภาพตัวอย่างได้ทุกเมื่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam kaliteyi iCloud’dan yeniden yükler. Önizlemeyle istediğin zaman karar verebilirsin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Знову завантажує повну якість з iCloud. Вирішувати можна будь-коли за попереднім переглядом."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud سے پوری کوالٹی دوبارہ لوڈ کرتا ہے۔ آپ کسی بھی وقت پیش منظر دیکھ کر فیصلہ کر سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tải lại chất lượng đầy đủ từ iCloud. Bạn có thể quyết định dựa trên bản xem trước bất cứ lúc nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新从 iCloud 载入完整画质。你随时都可以根据预览做决定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新從 iCloud 載入完整畫質。你隨時可以根據預覽做決定。"
          }
        }
      }
