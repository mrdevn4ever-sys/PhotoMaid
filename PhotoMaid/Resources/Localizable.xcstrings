    "done_note_media": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصور ومقاطع الفيديو الآن في «المحذوفة مؤخرًا» في تطبيق الصور. لا تتحرّر المساحة إلا بعد حذفها نهائيًا هناك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফটো ও ভিডিও এখন ফটো অ্যাপের “সম্প্রতি মুছে ফেলা”-তে আছে। সেখান থেকেও স্থায়ীভাবে মুছলে তবেই জায়গা খালি হয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fotos i els vídeos ara són a «Eliminat recentment» a l’app Fotos. L’espai només s’allibera quan s’esborren definitivament d’allà."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotky a videa jsou teď v „Nedávno smazaných“ v aplikaci Fotky. Místo se uvolní až po jejich trvalém smazání tam."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos og videoer ligger nu i “Senest slettet” i appen Fotos. Pladsen frigøres først, når de slettes permanent der."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos und Videos liegen jetzt in „Zuletzt gelöscht“ der Fotos-App. Speicher wird erst frei, wenn sie dort endgültig gelöscht werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι φωτογραφίες και τα βίντεο βρίσκονται τώρα στα «Πρόσφατα διαγραμμένα» της εφαρμογής Φωτογραφίες. Ο χώρος ελευθερώνεται μόνο όταν διαγραφούν οριστικά από εκεί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos and videos are now in “Recently Deleted” in the Photos app. Space is freed only once they’re permanently deleted there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos y los vídeos están ahora en «Eliminado» de la app Fotos. El espacio se libera cuando se borran definitivamente allí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvat ja videot ovat nyt Kuvat-apin kansiossa ”Äskettäin poistetut”. Tilaa vapautuu vasta, kun ne poistetaan sieltä pysyvästi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos et vidéos sont maintenant dans « Suppressions récentes » de l’app Photos. L’espace n’est libéré qu’une fois qu’elles y sont définitivement supprimées."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફોટા અને વીડિયો હવે ફોટો ઍપના “તાજેતરમાં ડિલીટ કરેલ” માં છે. ત્યાંથી પણ કાયમ માટે ડિલીટ થાય ત્યારે જ જગ્યા ખાલી થાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התמונות והסרטונים נמצאים עכשיו ב„נמחקו לאחרונה” ביישום ״תמונות״. המקום מתפנה רק כשהם נמחקים שם לצמיתות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोटो और वीडियो अब तस्वीरें ऐप के “हाल ही में डिलीट किए गए” में हैं। जगह तभी खाली होती है जब वहाँ से भी स्थायी रूप से डिलीट हों।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografije i videozapisi sada su u „Nedavno izbrisano” u aplikaciji Fotografije. Prostor se oslobađa tek kad se ondje trajno izbrišu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fotók és videók most a Fotók app „Nemrég törölt” albumában vannak. Hely csak akkor szabadul fel, ha ott véglegesen törlöd őket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto dan video sekarang ada di “Baru Dihapus” di app Foto. Ruang baru kosong setelah dihapus permanen di sana."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto e video ora sono in «Eliminati di recente» nell’app Foto. Lo spazio si libera solo quando vengono eliminati definitivamente da lì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真とビデオは写真アプリの「最近削除した項目」にあります。そこで完全に削除されたときに容量が空きます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಫೋಟೋಗಳು ಮತ್ತು ವೀಡಿಯೊಗಳು ಈಗ ಫೋಟೋಗಳು ಆ್ಯಪ್‌ನ “ಇತ್ತೀಚೆಗೆ ಅಳಿಸಲಾಗಿದೆ” ನಲ್ಲಿವೆ. ಅಲ್ಲಿಂದಲೂ ಶಾಶ್ವತವಾಗಿ ಅಳಿಸಿದಾಗ ಮಾತ್ರ ಸ್ಥಳ ಮುಕ್ತವಾಗುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진과 비디오는 이제 사진 앱의 '최근 삭제된 항목'에 있습니다. 그곳에서 영구 삭제되어야 공간이 확보됩니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഫോട്ടോകളും വീഡിയോകളും ഇപ്പോൾ ഫോട്ടോസ് ആപ്പിലെ “അടുത്തിടെ ഇല്ലാതാക്കിയവ”-ൽ ആണ്. അവിടെ നിന്നും ശാശ്വതമായി ഇല്ലാതാക്കുമ്പോൾ മാത്രമേ സ്ഥലം ഒഴിവാകൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फोटो आणि व्हिडिओ आता फोटो अ‍ॅपच्या “अलीकडे डिलीट केलेले” मध्ये आहेत. तिथूनही कायमचे डिलीट झाल्यावरच जागा मोकळी होते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto dan video kini berada dalam “Dipadam Baru-baru Ini” dalam app Foto. Ruang hanya dikosongkan setelah ia dipadam secara kekal di sana."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildene og videoene ligger nå i «Nylig slettet» i Bilder-appen. Plassen frigjøres først når de slettes permanent der."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto’s en video’s staan nu in ‘Recent verwijderd’ in de Foto’s-app. Er komt pas ruimte vrij als ze daar definitief zijn verwijderd."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଫଟୋ ଓ ଭିଡିଓ ଏବେ ଫଟୋ ଆପ୍‌ର “ନିକଟରେ ଡିଲିଟ୍ ହୋଇଥିବା”ରେ ଅଛି। ସେଠାରୁ ମଧ୍ୟ ସ୍ଥାୟୀ ଭାବେ ଡିଲିଟ୍ ହେଲେ ହିଁ ସ୍ଥାନ ଖାଲି ହୁଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਫ਼ੋਟੋਆਂ ਅਤੇ ਵੀਡੀਓ ਹੁਣ ਫ਼ੋਟੋਆਂ ਐਪ ਦੇ “ਹਾਲ ਹੀ ਵਿੱਚ ਮਿਟਾਏ ਗਏ” ਵਿੱਚ ਹਨ। ਥਾਂ ਤਾਂ ਹੀ ਖਾਲੀ ਹੁੰਦੀ ਹੈ ਜਦੋਂ ਉੱਥੋਂ ਵੀ ਪੱਕੇ ਤੌਰ ’ਤੇ ਮਿਟਾਏ ਜਾਣ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdjęcia i filmy są teraz w „Ostatnio usunięte” w aplikacji Zdjęcia. Miejsce zwolni się dopiero po ich trwałym usunięciu stamtąd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As fotos e vídeos agora estão em “Apagados” no app Fotos. O espaço só é liberado quando forem apagados permanentemente lá."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As fotografias e vídeos estão agora em «Apagados recentemente» na app Fotografias. O espaço só é libertado quando forem apagados definitivamente aí."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozele și videoclipurile sunt acum în „Șterse recent” din aplicația Poze. Spațiul se eliberează abia când sunt șterse definitiv de acolo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото и видео теперь в «Недавно удаленных» приложения «Фото». Место освободится, только когда они будут окончательно удалены оттуда."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotky a videá sú teraz v „Nedávno vymazaných“ v aplikácii Fotky. Miesto sa uvoľní až po ich natrvalo vymazaní tam."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografije in videoposnetki so zdaj v »Nedavno izbrisano« v aplikaciji Fotografije. Prostor se sprosti šele, ko jih tam trajno izbrišeš."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilderna och videorna ligger nu i ”Nyligen raderade” i appen Bilder. Utrymmet frigörs först när de raderas permanent där."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "புகைப்படங்களும் வீடியோக்களும் இப்போது Photos ஆப்பின் “சமீபத்தில் நீக்கியவை”-இல் உள்ளன. அங்கிருந்தும் நிரந்தரமாக நீக்கிய பின்னரே இடம் காலியாகும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫోటోలు, వీడియోలు ఇప్పుడు Photos యాప్‌లోని “ఇటీవల తొలగించినవి”లో ఉన్నాయి. అక్కడి నుండి కూడా శాశ్వతంగా తొలగించినప్పుడే స్థలం ఖాళీ అవుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปภาพและวิดีโอตอนนี้อยู่ใน “ที่ลบล่าสุด” ในแอพรูปภาพ พื้นที่จะว่างเมื่อลบถาวรที่นั่นแล้วเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraflar ve videolar artık Fotoğraflar uygulamasındaki \"Son Silinenler\"de. Alan ancak oradan kalıcı olarak silindiklerinde boşalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото й відео тепер у «Нещодавно видалених» програми «Фото». Місце звільниться лише після остаточного видалення звідти."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تصاویر اور ویڈیوز اب تصاویر ایپ کے ”حال ہی میں حذف کردہ“ میں ہیں۔ جگہ تب ہی خالی ہوتی ہے جب وہاں سے بھی مستقل طور پر حذف ہوں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh và video giờ nằm trong “Đã xóa gần đây” trong ứng dụng Ảnh. Dung lượng chỉ được giải phóng khi chúng bị xóa vĩnh viễn ở đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片和视频现在位于“照片”App 的“最近删除”中。只有在那里永久删除后才会释放空间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "照片和影片現在位於「照片」App 的「最近刪除」中。只有在那裡永久刪除後才會釋放空間。"
          }
        }
      }
    },
