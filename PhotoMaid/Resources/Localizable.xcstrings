    "today_access_default": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح لـ PhotoMaid بالوصول لتتمكن من عرض صورك وفيديوهاتك وترتيبها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube PhotoMaid den Zugriff, damit du deine Fotos und Videos ansehen und sortieren kannst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow PhotoMaid access so you can view and organize your photos and videos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el acceso a PhotoMaid para ver y organizar tus fotos y vídeos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorise PhotoMaid à accéder à tes photos et vidéos pour les voir et les organiser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti l’accesso a PhotoMaid per vedere e organizzare foto e video."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真や動画を表示して整理するには、PhotoMaidにアクセスを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진과 동영상을 보고 정리할 수 있도록 PhotoMaid에 접근을 허용해 주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef PhotoMaid toegang om je foto’s en video’s te bekijken en te ordenen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól PhotoMaid na dostęp, aby przeglądać i porządkować zdjęcia i filmy."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite o acesso ao PhotoMaid para veres e organizares as tuas fotos e vídeos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite accesul pentru PhotoMaid ca să vezi și să organizezi fotografiile și videoclipurile."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разреши PhotoMaid доступ, чтобы просматривать и упорядочивать фото и видео."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraf ve videolarını görüntüleyip düzenlemek için PhotoMaid uygulamasına erişim izni ver."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надай PhotoMaid доступ, щоб переглядати й упорядковувати фото та відео."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请允许 PhotoMaid 访问照片和视频，以便查看和整理。"
          }
        }
      }
    },
    "today_access_denied": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح بالوصول في إعدادات iOS ضمن PhotoMaid › الصور. ستبقى قراراتك السابقة محفوظة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube den Zugriff in den iOS-Einstellungen unter PhotoMaid › Fotos. Deine bisherigen Entscheidungen bleiben gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow access in iOS Settings under PhotoMaid › Photos. Your previous choices will stay saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el acceso en Ajustes de iOS, en PhotoMaid › Fotos. Tus decisiones anteriores se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l’accès dans les Réglages d’iOS, sous PhotoMaid › Photos. Vos choix précédents restent enregistrés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti l’accesso nelle Impostazioni di iOS, in PhotoMaid › Foto. Le tue scelte precedenti restano salvate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOSの設定 › PhotoMaid › 写真 でアクセスを許可してください。これまでの判断は保存されたままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 설정 › PhotoMaid › 사진에서 접근을 허용하세요. 이전 결정은 그대로 저장됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta toegang toe in Instellingen van iOS onder PhotoMaid › Foto’s. Je eerdere keuzes blijven bewaard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól na dostęp w Ustawieniach iOS w sekcji PhotoMaid › Zdjęcia. Wcześniejsze decyzje pozostaną zapisane."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso nas Definições do iOS, em PhotoMaid › Fotografias. As suas escolhas anteriores continuam guardadas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite accesul în Configurări iOS, la PhotoMaid › Poze. Alegerile anterioare rămân salvate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите доступ в Настройках iOS: PhotoMaid › Фото. Ваши прежние решения сохранятся."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS Ayarlar’da PhotoMaid › Fotoğraflar bölümünden erişime izin ver. Önceki kararların kayıtlı kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозвольте доступ у Параметрах iOS: PhotoMaid › Фото. Ваші попередні рішення збережуться."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在 iOS“设置”中的 PhotoMaid › 照片里允许访问。你之前的决定会保留。"
          }
        }
      }
    },
    "today_access_denied_title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن الوصول إلى صورك وفيديوهاتك"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Zugriff auf deine Fotos und Videos"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No access to your photos and videos"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin acceso a tus fotos y vídeos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas d’accès à tes photos et vidéos"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun accesso alle tue foto e ai tuoi video"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真と動画にアクセスできません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진과 동영상에 접근할 수 없어요"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen toegang tot je foto’s en video’s"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak dostępu do zdjęć i filmów"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem acesso às tuas fotos e vídeos"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fără acces la fotografiile și videoclipurile tale"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет доступа к твоим фото и видео"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraf ve videolarına erişim yok"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає доступу до твоїх фото й відео"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法访问你的照片和视频"
          }
        }
      }
    },
