    "dock_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح سلة المهملات. لا يُحذف شيء دون تأكيدك."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbner papirkurven. Intet slettes uden din bekræftelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet den Papierkorb. Gelöscht wird erst nach deiner Bestätigung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens the trash. Nothing is deleted without your confirmation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la papelera. No se borra nada sin tu confirmación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre la corbeille. Rien n’est supprimé sans ta confirmation."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka sampah. Tidak ada yang dihapus tanpa konfirmasimu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre il cestino. Nulla viene eliminato senza la tua conferma."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴミ箱を開きます。確認なしで削除されることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통을 열어요. 확인 없이 삭제하지 않아요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpner papirkurven. Ingenting slettes uten at du bekrefter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent de prullenbak. Er wordt niets verwijderd zonder je bevestiging."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwiera kosz. Nic nie zostanie usunięte bez Twojej zgody."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre a lixeira. Nada é apagado sem a sua confirmação."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o lixo. Nada é eliminado sem a tua confirmação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschide coșul. Nimic nu este șters fără confirmarea ta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает корзину. Ничего не удаляется без твоего подтверждения."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppnar papperskorgen. Inget raderas utan din bekräftelse."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดถังขยะ ไม่มีอะไรถูกลบโดยไม่มีการยืนยันจากคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çöp kutusunu açar. Onayın olmadan hiçbir şey silinmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкриває кошик. Нічого не видаляється без твого підтвердження."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở thùng rác. Không có gì bị xóa khi chưa có xác nhận của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开回收站。未经确认，不会删除任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開垃圾桶。未經你確認，不會刪除任何內容。"
          }
        }
      }
    },
