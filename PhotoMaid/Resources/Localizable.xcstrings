    "vault2_no_preview_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن عرض هذا التنسيق هنا. يبقى الملف في الخزنة. المشاركة تُخرج نسخة خارج الخزنة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ফরম্যাট এখানে দেখানো যায় না। ফাইলটি ভল্টে সংরক্ষিত থাকে। শেয়ার করলে ভল্টের বাইরে একটি কপি এক্সপোর্ট হয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquest format no es pot mostrar aquí. El fitxer es queda desat a la caixa forta. Compartir exporta una còpia fora de la caixa forta."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento formát tu nelze zobrazit. Soubor zůstává uložený v trezoru. Sdílení exportuje kopii mimo trezor."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette format kan ikke vises her. Filen forbliver gemt i boksen. Deling eksporterer en kopi uden for boksen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Format kann hier nicht angezeigt werden. Die Datei bleibt im Tresor gespeichert. Teilen gibt eine Kopie außerhalb des Tresors aus."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η μορφή δεν εμφανίζεται εδώ. Το αρχείο μένει αποθηκευμένο στο θησαυροφυλάκιο. Η κοινή χρήση εξάγει αντίγραφο εκτός θησαυροφυλακίου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This format cannot be displayed here. The file stays stored in the vault. Sharing exports a copy outside the vault."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este formato no se puede mostrar aquí. El archivo sigue en la caja fuerte. Compartir exporta una copia fuera."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tätä muotoa ei voi näyttää täällä. Tiedosto pysyy tallessa holvissa. Jakaminen vie kopion holvin ulkopuolelle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce format ne peut pas être affiché ici. Le fichier reste dans le coffre. Le partage exporte une copie hors du coffre."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ ફૉર્મેટ અહીં બતાવી શકાતું નથી. ફાઇલ વૉલ્ટમાં સાચવેલી રહે છે. શેર કરવાથી વૉલ્ટની બહાર એક નકલ એક્સપોર્ટ થાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אי אפשר להציג כאן את התבנית הזו. הקובץ נשאר שמור בכספת. שיתוף מייצא עותק אל מחוץ לכספת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह फ़ॉर्मेट यहाँ दिखाया नहीं जा सकता। फ़ाइल तिजोरी में सहेजी रहती है। शेयर करने से तिजोरी के बाहर एक कॉपी एक्सपोर्ट होती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj se format ovdje ne može prikazati. Datoteka ostaje spremljena u trezoru. Dijeljenje izvozi kopiju izvan trezora."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a formátum itt nem jeleníthető meg. A fájl a széfben tárolva marad. A megosztás a széfen kívülre exportál egy másolatot."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Format ini tidak dapat ditampilkan di sini. File tetap tersimpan di brankas. Berbagi mengekspor salinan ke luar brankas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il formato non è visualizzabile qui. Il file resta nella cassaforte. Condividerlo esporta una copia all’esterno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この形式はここで表示できません。ファイルは保管庫に保存されています。共有すると外部にコピーを書き出します。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಸ್ವರೂಪವನ್ನು ಇಲ್ಲಿ ತೋರಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ. ಫೈಲ್ ವಾಲ್ಟ್‌ನಲ್ಲೇ ಸಂಗ್ರಹವಾಗಿರುತ್ತದೆ. ಹಂಚಿಕೊಂಡರೆ ವಾಲ್ಟ್‌ನ ಹೊರಗೆ ಒಂದು ಪ್ರತಿ ಎಕ್ಸ್‌ಪೋರ್ಟ್ ಆಗುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 형식은 여기서 표시할 수 없습니다. 파일은 보관함에 유지됩니다. 공유하면 외부로 사본이 내보내집니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ഫോർമാറ്റ് ഇവിടെ കാണിക്കാനാകില്ല. ഫയൽ വോൾട്ടിൽ സംഭരിച്ചിരിക്കും. പങ്കിടുന്നത് വോൾട്ടിന് പുറത്ത് ഒരു പകർപ്പ് എക്‌സ്‌പോർട്ട് ചെയ്യും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हा फॉरमॅट इथे दाखवता येत नाही. फाइल व्हॉल्टमध्ये जतन राहते. शेअर केल्याने व्हॉल्टबाहेर एक प्रत एक्सपोर्ट होते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Format ini tidak dapat dipaparkan di sini. Fail kekal disimpan dalam peti besi. Berkongsi mengeksport salinan ke luar peti besi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette formatet kan ikke vises her. Filen forblir lagret i safen. Deling eksporterer en kopi utenfor safen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit formaat kan hier niet worden weergegeven. Het bestand blijft in de kluis. Delen geeft een kopie buiten de kluis."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହି ଫର୍ମାଟ୍ ଏଠାରେ ଦେଖାଯାଇପାରିବ ନାହିଁ। ଫାଇଲ୍ ଭଲ୍ଟରେ ଷ୍ଟୋର୍ ହୋଇ ରହେ। ସେୟାର୍ କଲେ ଭଲ୍ଟ ବାହାରେ ଏକ କପି ଏକ୍ସପୋର୍ଟ ହୁଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਫ਼ਾਰਮੈਟ ਇੱਥੇ ਦਿਖਾਇਆ ਨਹੀਂ ਜਾ ਸਕਦਾ। ਫ਼ਾਈਲ ਵੌਲਟ ਵਿੱਚ ਸਟੋਰ ਰਹਿੰਦੀ ਹੈ। ਸਾਂਝਾ ਕਰਨ ਨਾਲ ਵੌਲਟ ਤੋਂ ਬਾਹਰ ਇੱਕ ਕਾਪੀ ਐਕਸਪੋਰਟ ਹੁੰਦੀ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można tu wyświetlić tego formatu. Plik pozostaje w sejfie. Udostępnianie eksportuje kopię poza sejf."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este formato não pode ser exibido aqui. O arquivo continua guardado no cofre. Compartilhar exporta uma cópia para fora do cofre."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este formato não pode ser mostrado aqui. O ficheiro permanece no cofre. Partilhar exporta uma cópia para fora."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Formatul nu poate fi afișat aici. Fișierul rămâne în seif. Partajarea exportă o copie în afară."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот формат здесь не отображается. Файл остаётся в сейфе. При отправке копия выходит за пределы сейфа."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento formát tu nemožno zobraziť. Súbor zostáva uložený v trezore. Zdieľanie exportuje kópiu mimo trezoru."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te oblike tukaj ni mogoče prikazati. Datoteka ostane shranjena v sefu. Deljenje izvozi kopijo zunaj sefa."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här formatet kan inte visas här. Filen förblir lagrad i valvet. Att dela exporterar en kopia utanför valvet."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த வடிவத்தை இங்கே காட்ட முடியாது. கோப்பு லாக்கரிலேயே சேமிக்கப்பட்டிருக்கும். பகிர்ந்தால் லாக்கருக்கு வெளியே ஒரு நகல் ஏற்றுமதியாகும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ ఫార్మాట్‌ను ఇక్కడ చూపించలేము. ఫైల్ వాల్ట్‌లోనే నిల్వ ఉంటుంది. షేర్ చేస్తే వాల్ట్ బయటకు ఒక కాపీ ఎక్స్‌పోర్ట్ అవుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงรูปแบบนี้ที่นี่ไม่ได้ ไฟล์ยังเก็บอยู่ในตู้เซฟ การแชร์จะส่งออกสำเนานอกตู้เซฟ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu biçim burada gösterilemez. Dosya kasada kalır. Paylaşım, kasa dışına bir kopya çıkarır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей формат тут не відображається. Файл залишається у сховищі. Поширення виводить копію за його межі."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ فارمیٹ یہاں دکھایا نہیں جا سکتا۔ فائل والٹ میں محفوظ رہتی ہے۔ شیئر کرنے سے والٹ کے باہر ایک کاپی ایکسپورٹ ہوتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể hiển thị định dạng này ở đây. Tệp vẫn được lưu trong két sắt. Chia sẻ sẽ xuất một bản sao ra ngoài két sắt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此格式无法在这里显示。文件仍保存在保险库中。分享会将副本导出到保险库外。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這裡無法顯示此格式。檔案仍保存在保險箱中。分享會將副本輸出到保險箱以外。"
          }
        }
      }
    },
