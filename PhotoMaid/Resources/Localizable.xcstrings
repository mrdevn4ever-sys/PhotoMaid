    "org_album_empty": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الألبوم فارغ. في „الصور“ حدّد وسائط واضغط ⋯ › إضافة إلى ألبوم."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "This album is empty. In “Photos”, select something and tap ⋯ › Add to album."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Album ist leer. Wähle in „Fotos“ etwas aus und tippe auf ⋯ › Zu Album hinzufügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This album is empty. In “Photos”, select something and tap ⋯ › Add to album."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este álbum está vacío. En «Fotos», selecciona contenido y toca ⋯ › Añadir a un álbum."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
