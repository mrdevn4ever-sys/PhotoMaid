    "vault_recovery_skip_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدون مفتاح استرداد، يضيع المحتوى نهائيًا إذا نسيت رمزك ولم يكن Face ID متاحًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রিকভারি কী ছাড়া, কোড ভুলে গেলে এবং Face ID না থাকলে বিষয়বস্তু চিরতরে হারিয়ে যায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Sense clau de recuperació, el contingut es perd per sempre si oblides el codi i Face ID no està disponible."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez klíče pro obnovení je obsah navždy ztracen, pokud zapomenete kód a Face ID nebude k dispozici."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Uden gendannelsesnøgle går indholdet tabt for altid, hvis du glemmer din kode, og Face ID ikke er tilgængeligt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Notfallschlüssel ist der Inhalt endgültig verloren, wenn du den Code vergisst und Face ID nicht verfügbar ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χωρίς κλειδί ανάκτησης, το περιεχόμενο χάνεται για πάντα αν ξεχάσεις τον κωδικό και το Face ID δεν είναι διαθέσιμο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without a recovery key, the content is lost for good if you forget your code and Face ID isn’t available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin clave de recuperación, el contenido se pierde para siempre si olvidas tu código y Face ID no está disponible."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilman palautusavainta sisältö menetetään lopullisesti, jos unohdat koodisi eikä Face ID ole käytettävissä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans clé de secours, le contenu est perdu définitivement si tu oublies ton code et que Face ID n’est pas disponible."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પુનઃપ્રાપ્તિ ચાવી વિના, જો તમે કોડ ભૂલી જાઓ અને Face ID ઉપલબ્ધ ન હોય, તો સામગ્રી કાયમ માટે ખોવાઈ જાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בלי מפתח שחזור, התוכן אובד לתמיד אם שוכחים את הקוד ו-Face ID לא זמין."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकवरी कुंजी के बिना, अगर आप कोड भूल जाएँ और Face ID उपलब्ध न हो, तो सामग्री हमेशा के लिए खो जाती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez ključa za oporavak sadržaj je zauvijek izgubljen ako zaboraviš kôd, a Face ID nije dostupan."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Helyreállítási kulcs nélkül a tartalom végleg elvész, ha elfelejted a kódot, és a Face ID nem érhető el."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa kunci pemulihan, konten hilang selamanya jika kamu lupa kode dan Face ID tidak tersedia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza chiave di recupero, il contenuto va perso per sempre se dimentichi il codice e Face ID non è disponibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復旧キーがないと、コードを忘れてFace IDも使えない場合、中身は完全に失われます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮರುಪಡೆಯುವಿಕೆ ಕೀಲಿ ಇಲ್ಲದೆ, ನಿಮ್ಮ ಕೋಡ್ ಮರೆತರೆ ಮತ್ತು Face ID ಲಭ್ಯವಿಲ್ಲದಿದ್ದರೆ ವಿಷಯ ಶಾಶ್ವತವಾಗಿ ಕಳೆದುಹೋಗುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복구 키가 없으면 암호를 잊고 Face ID도 사용할 수 없을 때 콘텐츠를 영구적으로 잃게 됩니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "റിക്കവറി കീ ഇല്ലാതെ, കോഡ് മറക്കുകയും Face ID ലഭ്യമല്ലാതിരിക്കുകയും ചെയ്താൽ ഉള്ളടക്കം എന്നെന്നേക്കുമായി നഷ്ടമാകും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पुनर्प्राप्ती किल्लीशिवाय, तुम्ही कोड विसरलात आणि Face ID उपलब्ध नसेल तर मजकूर कायमचा गमावला जातो."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa kunci pemulihan, kandungan hilang selama-lamanya jika anda terlupa kod dan Face ID tidak tersedia."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Uten gjenopprettingsnøkkel går innholdet tapt for godt hvis du glemmer koden og Face ID ikke er tilgjengelig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonder herstelsleutel ben je de inhoud voorgoed kwijt als je je code vergeet en Face ID niet beschikbaar is."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ରିକଭରି କି ବିନା, ଆପଣ କୋଡ୍ ଭୁଲିଗଲେ ଏବଂ Face ID ଉପଲବ୍ଧ ନଥିଲେ ବିଷୟବସ୍ତୁ ସବୁଦିନ ପାଇଁ ହଜିଯାଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਰਿਕਵਰੀ ਕੁੰਜੀ ਤੋਂ ਬਿਨਾਂ, ਜੇ ਤੁਸੀਂ ਆਪਣਾ ਕੋਡ ਭੁੱਲ ਜਾਂਦੇ ਹੋ ਅਤੇ Face ID ਉਪਲਬਧ ਨਹੀਂ, ਤਾਂ ਸਮੱਗਰੀ ਹਮੇਸ਼ਾ ਲਈ ਗੁੰਮ ਹੋ ਜਾਂਦੀ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez klucza odzyskiwania zawartość przepadnie na zawsze, jeśli zapomnisz kodu, a Face ID nie będzie dostępny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem chave de recuperação, o conteúdo se perde para sempre se você esquecer seu código e o Face ID não estiver disponível."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem chave de recuperação, o conteúdo perde-se para sempre se te esqueceres do código e o Face ID não estiver disponível."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fără cheie de recuperare, conținutul se pierde definitiv dacă uiți codul și Face ID nu este disponibil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без ключа восстановления содержимое будет потеряно навсегда, если ты забудешь код, а Face ID будет недоступен."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez kľúča na obnovenie je obsah navždy stratený, ak zabudnete kód a Face ID nebude dostupné."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brez obnovitvenega ključa je vsebina za vedno izgubljena, če pozabiš kodo in Face ID ni na voljo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utan återställningsnyckel går innehållet förlorat för alltid om du glömmer koden och Face ID inte är tillgängligt."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மீட்புச் சாவி இல்லாமல், குறியீட்டை மறந்து Face ID கிடைக்காவிட்டால் உள்ளடக்கம் நிரந்தரமாக இழக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రికవరీ కీ లేకుండా, మీరు కోడ్ మర్చిపోయి Face ID అందుబాటులో లేకపోతే కంటెంట్ శాశ్వతంగా పోతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากไม่มีกุญแจกู้คืน เนื้อหาจะสูญหายถาวรถ้าคุณลืมรหัสและใช้ Face ID ไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurtarma anahtarı olmadan, kodunu unutursan ve Face ID kullanılamıyorsa içerik kalıcı olarak kaybolur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Без ключа відновлення вміст буде втрачено назавжди, якщо ти забудеш код, а Face ID буде недоступний."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ریکوری کلید کے بغیر، اگر آپ کوڈ بھول جائیں اور Face ID دستیاب نہ ہو تو مواد ہمیشہ کے لیے ضائع ہو جاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có khóa khôi phục, nội dung sẽ mất vĩnh viễn nếu bạn quên mã và không dùng được Face ID."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果没有恢复密钥，一旦忘记密码且无法使用 Face ID，内容将永久丢失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有復原金鑰，如果忘記密碼且無法使用 Face ID，內容將永久遺失。"
          }
        }
      }
    },
