    "movie_too_long": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "30 دقيقة كحد أقصى إجمالًا. قصّر المقاطع أو أزل بعضها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Insgesamt höchstens 30 Minuten. Kürze Clips oder nimm welche heraus."
          }
        },
        "en": {
