            "value": "Odložiť bez dátumu"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odloži brez datuma"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg undan utan datum"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தேதி இல்லாமல் ஒதுக்கி வை"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "తేదీ లేకుండా పక్కన పెట్టండి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แยกไว้โดยไม่มีวันที่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarihsiz ayır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкласти без дати"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بغیر تاریخ الگ رکھیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để riêng không có ngày"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无日期搁置"
          }
        },
        "zh-Hant": {
