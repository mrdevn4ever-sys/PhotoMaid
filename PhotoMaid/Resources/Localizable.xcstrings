    "archive_by_month_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرتّب النسخ في مجلدات فرعية حسب تاريخ الالتقاط، مثل «2026/10». عند الإيقاف: توضع كل الملفات في مجلد واحد."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorterer kopierne i undermapper efter optagelsesdato, f.eks. “2026/10”. Fra: alle filer i én mappe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sortiert die Kopien nach Aufnahmedatum in Unterordner, z. B. „2026/10“. Aus: alle Dateien landen in einem Ordner."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorts the copies into subfolders by date taken, e.g. “2026/10”. Off: all files go into one folder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordena las copias en subcarpetas por fecha de captura, p. ej. «2026/10». Desactivado: todos los archivos van a una sola carpeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Range les copies dans des sous-dossiers selon la date de prise, p. ex. « 2026/10 ». Désactivé : tous les fichiers vont dans un seul dossier."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengurutkan salinan ke subfolder menurut tanggal diambil, misalnya “2026/10”. Mati: semua file masuk ke satu folder."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordina le copie in sottocartelle per data di scatto, ad es. «2026/10». Disattivato: tutti i file in un’unica cartella."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "撮影日ごとにサブフォルダ（例：「2026/10」）に分けます。オフ：すべてのファイルを1つのフォルダに入れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "촬영 날짜별 하위 폴더(예: ‘2026/10’)로 정리해요. 끄면 모든 파일이 한 폴더에 들어가요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorterer kopiene i undermapper etter opptaksdato, f.eks. «2026/10». Av: alle filer havner i én mappe."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorteert de kopieën op opnamedatum in submappen, bijv. ‘2026/10’. Uit: alle bestanden in één map."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Układa kopie w podfolderach według daty wykonania, np. „2026/10”. Wyłączone: wszystkie pliki w jednym folderze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Organiza as cópias em subpastas pela data de captura, por exemplo “2026/10”. Desativado: todos os arquivos vão para uma pasta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Organiza as cópias em subpastas pela data de captura, p. ex. «2026/10». Desativado: todos os ficheiros numa só pasta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sortează copiile în subdosare după data fotografierii, de ex. „2026/10”. Dezactivat: toate fișierele într-un singur dosar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Раскладывает копии по подпапкам по дате съёмки, например «2026/10». Выкл.: все файлы в одной папке."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorterar kopiorna i undermappar efter tagningsdatum, t.ex. ”2026/10”. Av: alla filer hamnar i en mapp."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จัดสำเนาลงในโฟลเดอร์ย่อยตามวันที่ถ่าย เช่น “2026/10” ปิด: ไฟล์ทั้งหมดอยู่ในโฟลเดอร์เดียว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopyaları çekim tarihine göre alt klasörlere ayırır, örneğin “2026/10”. Kapalı: tüm dosyalar tek klasöre gider."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розкладає копії по підпапках за датою зйомки, наприклад «2026/10». Вимк.: усі файли в одній папці."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xếp các bản sao vào thư mục con theo ngày chụp, ví dụ “2026/10”. Tắt: mọi tệp vào một thư mục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按拍摄日期将副本放入子文件夹，例如“2026/10”。关闭：所有文件放在同一文件夹中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依拍攝日期將副本分到子檔案夾，例如「2026/10」。關閉：所有檔案都放在同一個檔案夾。"
          }
        }
      }
    },
