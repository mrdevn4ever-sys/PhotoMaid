          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевіримо результат під час наступного запуску. Нічого не буде видалено повторно."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng tôi sẽ kiểm tra kết quả lần tới bạn mở ứng dụng. Sẽ không có gì bị xóa lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
