    "edit_size_small": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه الصورة صغيرة بالفعل. لا يكبّر GaleriQ الصور أبدًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette foto er allerede lille. GaleriQ forstørrer aldrig fotos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Foto ist schon klein. GaleriQ vergrößert nie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This photo is already small. GaleriQ never enlarges photos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta foto ya es pequeña. GaleriQ nunca amplía."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette photo est déjà petite. GaleriQ n’agrandit jamais."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto ini sudah kecil. GaleriQ tidak pernah memperbesar foto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa foto è già piccola. GaleriQ non ingrandisce mai."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この写真はすでに小さいサイズです。GaleriQが拡大することはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 작은 사진이에요. GaleriQ는 확대하지 않아요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette bildet er allerede lite. GaleriQ forstørrer aldri bilder."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze foto is al klein. GaleriQ vergroot nooit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To zdjęcie jest już małe. GaleriQ nigdy nie powiększa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta foto já é pequena. O GaleriQ nunca amplia fotos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta foto já é pequena. O GaleriQ nunca amplia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografia este deja mică. GaleriQ nu mărește niciodată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это фото уже маленькое. GaleriQ никогда не увеличивает."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här bilden är redan liten. GaleriQ förstorar aldrig bilder."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปนี้เล็กอยู่แล้ว GaleriQ ไม่เคยขยายรูปภาพ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu fotoğraf zaten küçük. GaleriQ asla büyütmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це фото вже маленьке. GaleriQ ніколи не збільшує."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh này đã nhỏ. GaleriQ không bao giờ phóng to ảnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这张照片已经很小。GaleriQ 从不放大照片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這張照片已經很小。GaleriQ 從不放大照片。"
          }
        }
      }
    },
