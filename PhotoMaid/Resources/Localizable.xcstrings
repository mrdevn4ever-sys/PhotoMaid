    },
    "archive_meaning": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "«تم التحقق» يعني أن النسخة مطابقة للأصل بايتًا ببايت. لا أحد يستطيع التحقق من المدة التي سيصمد فيها وسيط التخزين – احتفظ بالأشياء المهمة في مكانين."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "“যাচাই করা” মানে কপিটি মূলটির সাথে বাইট-বাই-বাইট হুবহু এক। কোনো স্টোরেজ ডিভাইস কত দিন টিকবে তা কেউ যাচাই করতে পারে না – গুরুত্বপূর্ণ জিনিস দুই জায়গায় রাখুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "«Comprovat» vol dir que la còpia és idèntica a l’original, byte a byte. Ningú no pot saber quant durarà un dispositiu d’emmagatzematge: guarda el que és important en dos llocs."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "„Ověřeno“ znamená, že kopie je bajt po bajtu stejná jako originál. Nikdo nedokáže zjistit, jak dlouho úložiště vydrží – důležité věci mějte na dvou místech."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "“Kontrolleret” betyder, at kopien er identisk med originalen, byte for byte. Ingen kan vide, hvor længe en lagerenhed holder – opbevar vigtige ting to steder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Geprüft“ heißt: Die Kopie ist Byte für Byte gleich wie das Original. Ob ein Datenträger lange hält, kann niemand prüfen – bewahre Wichtiges an zwei Orten auf."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "«Ελέγχθηκε» σημαίνει ότι το αντίγραφο είναι ίδιο με το πρωτότυπο, byte προς byte. Κανείς δεν μπορεί να ξέρει πόσο θα αντέξει μια συσκευή αποθήκευσης – κράτα τα σημαντικά σε δύο μέρη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Checked” means the copy is identical to the original, byte for byte. No one can check how long a storage device will last – keep important things in two places."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Comprobado» significa que la copia es idéntica al original, byte a byte. Nadie puede comprobar cuánto durará un soporte: guarda lo importante en dos sitios."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "”Tarkistettu” tarkoittaa, että kopio on tavu tavulta sama kuin alkuperäinen. Kukaan ei voi tietää, kuinka kauan tallennuslaite kestää – säilytä tärkeät asiat kahdessa paikassa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Vérifié » signifie que la copie est identique à l’original, octet par octet. Personne ne peut vérifier combien de temps un support tiendra : gardez l’essentiel à deux endroits."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "“ચકાસેલું” એટલે નકલ મૂળ સાથે બાઇટ-દર-બાઇટ બરાબર સરખી છે. સ્ટોરેજ ઉપકરણ કેટલું ચાલશે તે કોઈ કહી શકતું નથી – મહત્ત્વની વસ્તુઓ બે જગ્યાએ રાખો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "„אומת” פירושו שהעותק זהה למקור, בייט אחר בייט. אי אפשר לדעת כמה זמן התקן אחסון יחזיק מעמד – כדאי לשמור דברים חשובים בשני מקומות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“जाँचा गया” का मतलब है कि कॉपी मूल से बाइट-दर-बाइट बिल्कुल एक जैसी है। कोई नहीं बता सकता कि स्टोरेज डिवाइस कितना चलेगा – ज़रूरी चीज़ें दो जगह रखें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "„Provjereno” znači da je kopija identična originalu, bajt po bajt. Nitko ne može provjeriti koliko će uređaj za pohranu trajati – važne stvari čuvaj na dva mjesta."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az „Ellenőrizve” azt jelenti, hogy a másolat bájtról bájtra azonos az eredetivel. Senki sem tudja, meddig bírja egy tárolóeszköz – a fontos dolgokat tartsd két helyen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "“Diperiksa” berarti salinan identik dengan aslinya, byte demi byte. Tidak ada yang bisa memastikan berapa lama perangkat penyimpanan bertahan – simpan hal penting di dua tempat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«Controllato» significa che la copia è identica all’originale, byte per byte. Nessuno può verificare quanto durerà un supporto: conserva le cose importanti in due posti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「確認済み」とは、コピーが元のファイルと1バイト単位で同じという意味です。記憶装置がどれだけもつかは誰にも確かめられません。大切なものは2か所に保管しましょう。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "“ಪರಿಶೀಲಿಸಲಾಗಿದೆ” ಎಂದರೆ ಪ್ರತಿಯು ಮೂಲದೊಂದಿಗೆ ಬೈಟ್-ಬೈಟ್ ಒಂದೇ ಆಗಿದೆ. ಸಂಗ್ರಹಣಾ ಸಾಧನ ಎಷ್ಟು ಕಾಲ ಬಾಳುತ್ತದೆ ಎಂದು ಯಾರೂ ಪರಿಶೀಲಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ – ಮುಖ್ಯವಾದವುಗಳನ್ನು ಎರಡು ಕಡೆ ಇರಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘확인됨’은 사본이 원본과 바이트 단위까지 같다는 뜻이에요. 저장 장치가 얼마나 오래갈지는 누구도 확인할 수 없어요. 중요한 것은 두 곳에 보관하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "“പരിശോധിച്ചു” എന്നാൽ പകർപ്പ് ഒറിജിനലുമായി ബൈറ്റ്-ബൈ-ബൈറ്റ് ഒരുപോലെയാണ്. ഒരു സ്റ്റോറേജ് ഉപകരണം എത്രകാലം നിലനിൽക്കുമെന്ന് ആർക്കും പരിശോധിക്കാനാവില്ല – പ്രധാനപ്പെട്ടവ രണ്ടിടത്ത് സൂക്ഷിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "“तपासलेले” म्हणजे प्रत मूळशी बाइट-दर-बाइट तंतोतंत सारखी आहे. स्टोरेज डिव्हाइस किती काळ टिकेल हे कोणीही सांगू शकत नाही – महत्त्वाच्या गोष्टी दोन ठिकाणी ठेवा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "“Disemak” bermaksud salinan sama dengan yang asal, bait demi bait. Tiada sesiapa dapat memastikan berapa lama peranti storan akan bertahan – simpan perkara penting di dua tempat."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "«Kontrollert» betyr at kopien er identisk med originalen, byte for byte. Ingen kan vite hvor lenge en lagringsenhet holder – oppbevar viktige ting to steder."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘Gecontroleerd’ betekent: de kopie is byte voor byte gelijk aan het origineel. Hoe lang een gegevensdrager meegaat, kan niemand controleren – bewaar belangrijke dingen op twee plekken."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "“ଯାଞ୍ଚ ହୋଇଛି” ଅର୍ଥ କପିଟି ମୂଳ ସହ ବାଇଟ୍-ବାଇ-ବାଇଟ୍ ସମାନ। କୌଣସି ଷ୍ଟୋରେଜ୍ ଡିଭାଇସ୍ କେତେ ଦିନ ଚାଲିବ ତାହା କେହି ଯାଞ୍ଚ କରିପାରିବେ ନାହିଁ – ଗୁରୁତ୍ୱପୂର୍ଣ୍ଣ ଜିନିଷ ଦୁଇ ଜାଗାରେ ରଖନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "“ਜਾਂਚਿਆ ਗਿਆ” ਦਾ ਮਤਲਬ ਹੈ ਕਿ ਕਾਪੀ ਮੂਲ ਨਾਲ ਬਾਈਟ-ਦਰ-ਬਾਈਟ ਬਿਲਕੁਲ ਇੱਕੋ ਜਿਹੀ ਹੈ। ਕੋਈ ਨਹੀਂ ਦੱਸ ਸਕਦਾ ਕਿ ਸਟੋਰੇਜ ਡਿਵਾਈਸ ਕਿੰਨਾ ਚੱਲੇਗਾ – ਜ਼ਰੂਰੀ ਚੀਜ਼ਾਂ ਦੋ ਥਾਵਾਂ ਉੱਤੇ ਰੱਖੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„Sprawdzono” oznacza, że kopia jest bajt po bajcie taka sama jak oryginał. Nikt nie sprawdzi, jak długo wytrzyma nośnik – ważne rzeczy trzymaj w dwóch miejscach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“Verificado” significa que a cópia é idêntica ao original, byte a byte. Ninguém consegue prever quanto tempo um dispositivo de armazenamento vai durar – guarde o que é importante em dois lugares."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "“Verificado” significa que a cópia é igual ao original, byte a byte. Ninguém consegue verificar quanto tempo um suporte dura – guarde o que é importante em dois sítios."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "„Verificat” înseamnă că copia este identică cu originalul, octet cu octet. Nimeni nu poate verifica cât rezistă un suport – păstrează lucrurile importante în două locuri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Проверено» значит, что копия побайтно совпадает с оригиналом. Сколько прослужит носитель, проверить невозможно — храните важное в двух местах."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "„Overené“ znamená, že kópia je bajt po bajte rovnaká ako originál. Nikto nedokáže zistiť, ako dlho úložisko vydrží – dôležité veci majte na dvoch miestach."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "»Preverjeno« pomeni, da je kopija bajt za bajtom enaka izvirniku. Nihče ne more preveriti, kako dolgo bo shramba zdržala – pomembne stvari hrani na dveh mestih."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”Kontrollerad” betyder att kopian är identisk med originalet, byte för byte. Ingen kan veta hur länge en lagringsenhet håller – förvara viktiga saker på två ställen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "“சரிபார்க்கப்பட்டது” என்றால் நகல் அசலுடன் பைட்-பைட்டாக ஒன்றே. ஒரு சேமிப்பகச் சாதனம் எவ்வளவு காலம் நீடிக்கும் என்பதை யாராலும் சரிபார்க்க முடியாது – முக்கியமானவற்றை இரண்டு இடங்களில் வையுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "“తనిఖీ చేశారు” అంటే కాపీ ఒరిజినల్‌తో బైట్-బై-బైట్ ఒకేలా ఉంది. స్టోరేజ్ పరికరం ఎంతకాలం పనిచేస్తుందో ఎవరూ తనిఖీ చేయలేరు – ముఖ్యమైనవి రెండు చోట్ల ఉంచండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "“ตรวจสอบแล้ว” หมายความว่าสำเนาเหมือนต้นฉบับทุกไบต์ ไม่มีใครบอกได้ว่าอุปกรณ์จัดเก็บจะใช้ได้นานแค่ไหน – เก็บสิ่งสำคัญไว้สองที่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Kontrol edildi”, kopyanın orijinalle bayt bayt aynı olduğu anlamına gelir. Bir depolama aygıtının ne kadar dayanacağını kimse kontrol edemez – önemli şeyleri iki yerde sakla."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Перевірено» означає, що копія побайтово збігається з оригіналом. Скільки прослужить носій, перевірити неможливо — зберігайте важливе у двох місцях."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "”جانچا گیا“ کا مطلب ہے کہ کاپی اصل سے بائٹ بہ بائٹ بالکل یکساں ہے۔ کوئی نہیں بتا سکتا کہ اسٹوریج ڈیوائس کتنا چلے گا – اہم چیزیں دو جگہ رکھیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "“Đã kiểm tra” nghĩa là bản sao giống hệt bản gốc, từng byte một. Không ai biết chắc thiết bị lưu trữ dùng được bao lâu – hãy giữ những thứ quan trọng ở hai nơi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“已检查”表示副本与原件逐字节一致。存储设备能用多久，谁也无法检查——重要内容请保存在两个地方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「已驗證」表示副本與原始檔逐位元組完全相同。沒有人能確定儲存裝置能用多久 – 重要的東西請放在兩個地方。"
          }
        }
      }
    },
    "archive_need_both": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر أولًا ما تريد نسخه ومجلد الوجهة."
