    "basket_files_footer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستُحذف هذه الملفات نهائيًا. لا يمكنك التراجع عن ذلك."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Disse filer slettes permanent. Det kan ikke fortrydes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Dateien werden endgültig gelöscht. Du kannst das nicht rückgängig machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These files will be permanently deleted. You can’t undo this."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos archivos se borrarán definitivamente. No podrás deshacerlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces fichiers seront supprimés définitivement. Tu ne pourras pas annuler cette action."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File ini akan dihapus secara permanen. Ini tidak dapat diurungkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questi file verranno eliminati definitivamente. Non potrai annullare l’azione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのファイルは完全に削除されます。元に戻すことはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일들은 영구 삭제돼요. 되돌릴 수 없어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Disse filene slettes permanent. Det kan ikke angres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze bestanden worden definitief verwijderd. Je kunt dit niet ongedaan maken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te pliki zostaną trwale usunięte. Nie możesz tego cofnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estes arquivos serão apagados permanentemente. Não é possível desfazer."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Estes ficheiros serão eliminados definitivamente. Não poderás anular esta ação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceste fișiere vor fi șterse definitiv. Nu vei putea anula acțiunea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти файлы будут удалены навсегда. Отменить это нельзя."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Filerna raderas permanent. Det går inte att ångra."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์เหล่านี้จะถูกลบถาวร ไม่สามารถเลิกทำได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dosyalar kalıcı olarak silinecek. Bu işlemi geri alamazsın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ці файли буде видалено назавжди. Скасувати це не можна."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các tệp này sẽ bị xóa vĩnh viễn. Bạn không thể hoàn tác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些文件将被永久删除，无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些檔案將被永久刪除。此動作無法還原。"
          }
        }
      }
    },
    "basket_files_header": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملفات"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Filer"
          }
        },
        "de": {
