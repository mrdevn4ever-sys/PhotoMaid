    "tour_history_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هنا ترى ما احتفظت به أو استبعدته أو أجّلته. يمكنك تغيير أي قرار من هنا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier siehst du, was du behalten, aussortiert oder auf später gelegt hast. Jede Entscheidung kannst du hier noch ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See what you kept, set aside or saved for later. You can still change any decision here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí ves lo que has conservado, apartado o dejado para después. Puedes cambiar cualquier decisión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyez ce que vous avez gardé, écarté ou remis à plus tard. Vous pouvez encore changer chaque décision ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui vedi cosa hai tenuto, scartato o rimandato. Puoi ancora cambiare ogni decisione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残したもの、外したもの、あとで見るものを確認できます。どの判断もここで変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관한 것, 골라낸 것, 나중에 볼 것을 확인할 수 있어요. 여기서 모든 결정을 바꿀 수 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zie wat je hebt bewaard, apart gezet of voor later bewaard. Elke keuze kun je hier nog aanpassen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobacz, co zachowujesz, odkładasz lub zostawiasz na później. Każdą decyzję możesz tu jeszcze zmienić."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja o que manteve, pôs de lado ou deixou para mais tarde. Pode ainda alterar qualquer decisão aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vezi ce ai păstrat, ai pus deoparte sau ai lăsat pe mai târziu. Poți schimba aici orice decizie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь видно, что вы оставили, отложили в сторону или на потом. Любое решение можно изменить."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neyi tuttuğunu, ayırdığını veya sonraya bıraktığını burada görürsün. Her kararı burada değiştirebilirsin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут видно, що ви залишили, відклали вбік чи на потім. Будь-яке рішення можна змінити."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这里查看你保留、挑出或留到稍后的内容。任何决定都可以在这里更改。"
          }
        }
      }
    },
    "tour_history_title": {
