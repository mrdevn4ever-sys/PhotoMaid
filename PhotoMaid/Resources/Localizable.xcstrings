            "value": "日付なしで保留"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ದಿನಾಂಕವಿಲ್ಲದೆ ಪಕ್ಕಕ್ಕಿಡಿ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
