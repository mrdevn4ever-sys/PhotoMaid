      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنتقل العناصر أولاً إلى سلة PhotoMaid. تؤكد الإزالة هناك، ويسألك iOS مرة أخرى قبل نقل الصور والفيديوهات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Medien landen zuerst im PhotoMaid-Papierkorb. Dort bestätigst du das Entfernen; iOS fragt vor ‚Zuletzt gelöscht‘ noch einmal nach."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Items first go to PhotoMaid’s trash. You confirm removal there, and iOS asks again before moving photos and videos to Recently Deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los elementos van primero a la papelera de PhotoMaid. Confirmas allí y iOS vuelve a preguntar antes de mover fotos y vídeos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les éléments vont d’abord dans la corbeille PhotoMaid. Vous confirmez, puis iOS redemande avant de déplacer photos et vidéos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli elementi vanno prima nel cestino PhotoMaid. Confermi lì e iOS chiede di nuovo prima di spostare foto e video."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まずPhotoMaidのゴミ箱に入ります。そこで確認し、写真やビデオを移動する前にiOSがもう一度確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 PhotoMaid 휴지통에 들어갑니다. 여기서 확인하면 사진과 비디오를 옮기기 전에 iOS가 다시 묻습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Items gaan eerst naar de PhotoMaid-prullenbak. Je bevestigt daar; iOS vraagt opnieuw voordat foto’s en video’s worden verplaatst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elementy trafiają najpierw do kosza PhotoMaid. Tam potwierdzasz; iOS pyta ponownie przed przeniesieniem zdjęć i filmów."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os itens vão primeiro para o lixo do PhotoMaid. Confirma aí; o iOS volta a perguntar antes de mover fotos e vídeos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Elementele ajung întâi în coșul PhotoMaid. Confirmi acolo; iOS întreabă din nou înainte de a muta pozele și clipurile."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Объекты сначала попадают в корзину PhotoMaid. Вы подтверждаете там; iOS спросит ещё раз перед перемещением фото и видео."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Öğeler önce PhotoMaid çöpüne gider. Orada onaylarsın; iOS fotoğraf ve videoları taşımadan önce tekrar sorar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Об’єкти спочатку потрапляють у кошик PhotoMaid. Там ви підтверджуєте; iOS перепитає перед переміщенням фото й відео."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "项目会先进入 PhotoMaid 废纸篓。你在其中确认；iOS 在移动照片和视频前还会再次询问。"
          }
        }
      }
    },
    "onb_safe_title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت تقرر ما يُحذف"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du entscheidest, was gelöscht wird"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You decide what gets deleted"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tú decides qué se borra"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu décides de ce qui est supprimé"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Decidi tu cosa eliminare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除するものは自分で選べます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제할 항목은 직접 선택해요"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jij bepaalt wat wordt verwijderd"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ty decydujesz, co usunąć"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu decides o que é eliminado"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu decizi ce se șterge"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ты решаешь, что удалить"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neyin silineceğine sen karar ver"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ти вирішуєш, що видалити"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由你决定删除什么"
          }
        }
      }
    },
