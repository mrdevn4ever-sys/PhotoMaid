    "lib_hidden_none_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم «إخفاء في PhotoMaid» على ألبوم أو صورة أو تحديد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze „In PhotoMaid ausblenden“ bei einem Album, einem Foto oder einer Auswahl."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use “Hide in PhotoMaid” on an album, a photo or a selection."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa «Ocultar en PhotoMaid» en un álbum, una foto o una selección."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez « Masquer dans PhotoMaid » sur un album, une photo ou une sélection."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa «Nascondi in PhotoMaid» su un album, una foto o una selezione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アルバム、写真、選択項目で「PhotoMaidで非表示」を使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앨범, 사진 또는 선택 항목에서 'PhotoMaid에서 숨기기'를 사용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik ‘Verbergen in PhotoMaid’ bij een album, foto of selectie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj „Ukryj w PhotoMaid” przy albumie, zdjęciu lub zaznaczeniu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Use «Ocultar no PhotoMaid» num álbum, numa fotografia ou numa seleção."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Folosește „Ascunde în PhotoMaid” la un album, o poză sau o selecție."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте «Скрыть в PhotoMaid» для альбома, фото или выбранного."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir albümde, fotoğrafta veya seçimde \"PhotoMaid’de gizle\"yi kullan."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скористайтеся «Сховати в PhotoMaid» для альбому, фото чи вибраного."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对相簿、照片或所选内容使用“在 PhotoMaid 中隐藏”。"
          }
        }
      }
    },
    "lib_hidden_none_title": {
      "extractionState": "manual",
      "localizations": {
