          "stringUnit": {
            "state": "translated",
            "value": "Hapus sebanyak yang kamu mau — tanpa batas harian %1$lld."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuovi quanto vuoi, senza il limite giornaliero di %1$lld."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1日%1$lld件の上限を気にせず、好きなだけ削除できます。"
