        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibatalkan. Tidak ada yang disimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annullato. Non è stato salvato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中止しました。何も保存されていません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ರದ್ದುಗೊಳಿಸಲಾಗಿದೆ. ಏನನ್ನೂ ಉಳಿಸಲಾಗಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "취소했습니다. 아무것도 저장되지 않았습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "റദ്ദാക്കി. ഒന്നും സംരക്ഷിച്ചില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "रद्द केले. काहीही जतन झाले नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibatalkan. Tiada apa disimpan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Avbrutt. Ingenting ble lagret."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geannuleerd. Er is niets bewaard."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ବାତିଲ ହେଲା। କିଛି ସେଭ୍ ହୋଇନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਰੱਦ ਕੀਤਾ। ਕੁਝ ਨਹੀਂ ਸੰਭਾਲਿਆ ਗਿਆ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Anulowano. Nic nie zostało zapisane."
