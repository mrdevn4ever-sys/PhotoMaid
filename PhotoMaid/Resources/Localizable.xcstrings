    "pdf_privacy": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُضمَّن الصور من جديد: لا ينتقل الموقع وبيانات التصوير الأخرى إلى ملف PDF. تبقى الأصول دون تغيير."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফটোগুলো নতুন করে বসানো হয়: লোকেশন ও তোলার অন্যান্য তথ্য PDF-এ যায় না। মূল ফাইল অপরিবর্তিত থাকে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fotos s’incrusten de nou: la ubicació i altres dades de presa no van al PDF. Els originals no canvien."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotky se vloží znovu: poloha a další údaje o pořízení se do PDF nedostanou. Originály zůstanou beze změny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos indlejres på ny: lokalitet og andre optagelsesdata kommer ikke med i PDF'en. Originalerne forbliver uændrede."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Fotos werden neu eingebettet: Standort und andere Aufnahmedaten gelangen nicht ins PDF. Die Originale bleiben unverändert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι φωτογραφίες ενσωματώνονται ξανά: η τοποθεσία και άλλα δεδομένα λήψης δεν μπαίνουν στο PDF. Τα πρωτότυπα μένουν αμετάβλητα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos are re-embedded: location and other capture data don’t go into the PDF. The originals stay unchanged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos se vuelven a incrustar: la ubicación y otros datos de captura no pasan al PDF. Los originales no cambian."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvat upotetaan uudelleen: sijainti ja muut kuvaustiedot eivät päädy PDF:ään. Alkuperäiset pysyvät ennallaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos sont réintégrées : la position et les autres données de prise de vue ne vont pas dans le PDF. Les originaux restent inchangés."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફોટા ફરી એમ્બેડ થાય છે: સ્થાન અને લીધાનો બીજો ડેટા PDF માં જતો નથી. મૂળ બદલાતાં નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התמונות מוטמעות מחדש: מיקום ונתוני צילום אחרים לא נכנסים ל-PDF. המקוריים לא משתנים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोटो दोबारा एम्बेड होती हैं: लोकेशन और लेने का दूसरा डेटा PDF में नहीं जाता। मूल नहीं बदलते।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografije se ponovno ugrađuju: lokacija i drugi podaci o snimanju ne ulaze u PDF. Originali ostaju nepromijenjeni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fotók újra beágyazódnak: a hely és más felvételi adatok nem kerülnek a PDF-be. Az eredetik változatlanok maradnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto disematkan ulang: lokasi dan data pengambilan lainnya tidak masuk ke PDF. Aslinya tidak berubah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le foto vengono reinserite: posizione e altri dati di scatto non finiscono nel PDF. Gli originali restano invariati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真は埋め込み直されるため、位置情報などの撮影データは PDF に含まれません。元の写真は変更されません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಫೋಟೋಗಳನ್ನು ಮರು-ಸೇರಿಸಲಾಗುತ್ತದೆ: ಸ್ಥಳ ಮತ್ತು ಇತರ ಸೆರೆಹಿಡಿಯುವ ಡೇಟಾ PDF ಗೆ ಹೋಗುವುದಿಲ್ಲ. ಮೂಲಗಳು ಬದಲಾಗದೆ ಉಳಿಯುತ್ತವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진을 새로 넣기 때문에 위치와 기타 촬영 정보는 PDF에 들어가지 않아요. 원본은 그대로예요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഫോട്ടോകൾ പുതുതായി ഉൾച്ചേർക്കുന്നു: ലൊക്കേഷനും മറ്റ് ക്യാപ്‌ചർ ഡാറ്റയും PDF-ലേക്ക് പോകില്ല. ഒറിജിനലുകൾക്ക് മാറ്റമുണ്ടാകില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फोटो पुन्हा एम्बेड होतात: स्थान आणि काढल्याचा इतर डेटा PDF मध्ये जात नाही. मूळ बदलत नाहीत."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto dibenamkan semula: lokasi dan data penangkapan lain tidak masuk ke dalam PDF. Fail asal kekal tidak berubah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildene bygges inn på nytt: sted og andre opptaksdata blir ikke med i PDF-en. Originalene forblir uendret."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto’s worden opnieuw ingesloten: locatie en andere opnamegegevens komen niet in de PDF. De originelen blijven ongewijzigd."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଫଟୋଗୁଡ଼ିକ ନୂଆ କରି ସନ୍ନିବେଶିତ ହୁଏ: ଲୋକେସନ୍ ଓ ଅନ୍ୟ କ୍ୟାପଚର୍ ଡାଟା PDFକୁ ଯାଏ ନାହିଁ। ମୂଳ ଅପରିବର୍ତ୍ତିତ ରହେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਫ਼ੋਟੋਆਂ ਦੁਬਾਰਾ ਸ਼ਾਮਲ ਕੀਤੀਆਂ ਜਾਂਦੀਆਂ ਹਨ: ਟਿਕਾਣਾ ਅਤੇ ਹੋਰ ਖਿੱਚਣ ਵਾਲਾ ਡਾਟਾ PDF ਵਿੱਚ ਨਹੀਂ ਜਾਂਦਾ। ਮੂਲ ਬਿਨਾਂ ਬਦਲੇ ਰਹਿੰਦੇ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdjęcia są osadzane na nowo: lokalizacja i inne dane zdjęcia nie trafiają do PDF. Oryginały pozostają bez zmian."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As fotos são incorporadas de novo: localização e outros dados de captura não vão para o PDF. Os originais não são alterados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As fotos são incorporadas de novo: a localização e outros dados da captura não passam para o PDF. Os originais ficam inalterados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografiile sunt încorporate din nou: locația și alte date de captură nu ajung în PDF. Originalele rămân neschimbate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото встраиваются заново: местоположение и другие данные съёмки не попадают в PDF. Оригиналы не меняются."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotky sa vložia znova: poloha a ďalšie údaje o nasnímaní sa do PDF nedostanú. Originály zostanú bez zmeny."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografije se znova vdelajo: lokacija in drugi podatki o posnetku ne gredo v PDF. Izvirniki ostanejo nespremenjeni."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilderna bäddas in på nytt: plats och andra tagningsdata följer inte med till PDF:en. Originalen förblir oförändrade."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "புகைப்படங்கள் புதிதாக உட்பொதிக்கப்படும்: இருப்பிடமும் மற்ற படப்பிடிப்புத் தரவும் PDF-க்குச் செல்லாது. அசல்கள் மாறாமல் இருக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫోటోలు కొత్తగా పొందుపరచబడతాయి: లొకేషన్, ఇతర క్యాప్చర్ డేటా PDFలోకి వెళ్లవు. ఒరిజినల్‌లు మారవు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปจะถูกฝังใหม่: ตำแหน่งและข้อมูลการถ่ายอื่นๆ จะไม่อยู่ใน PDF ต้นฉบับไม่เปลี่ยนแปลง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraflar yeniden yerleştirilir: konum ve diğer çekim verileri PDF’e geçmez. Orijinaller değişmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото вбудовуються заново: місце та інші дані зйомки не потрапляють у PDF. Оригінали не змінюються."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تصاویر دوبارہ ایمبیڈ ہوتی ہیں: مقام اور لینے کا دیگر ڈیٹا PDF میں نہیں جاتا۔ اصل تبدیل نہیں ہوتے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh được nhúng lại: vị trí và dữ liệu chụp khác không vào PDF. Bản gốc không thay đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片会重新嵌入：位置及其他拍摄数据不会进入 PDF。原始照片保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "照片會重新嵌入：位置和其他拍攝資料不會放進 PDF。原始檔保持不變。"
          }
        }
      }
    },
