          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい画像としてライブラリに保存しました。スクリーンショットは変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 이미지로 보관함에 저장했어요. 스크린샷은 바뀌지 않아요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaard als nieuwe afbeelding in je bibliotheek. De schermafbeeldingen blijven ongewijzigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisano jako nowy obraz w bibliotece. Zrzuty ekranu pozostają bez zmian."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardada como nova imagem na fototeca. As capturas de ecrã ficam inalteradas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvată ca imagine nouă în fototecă. Capturile de ecran rămân neschimbate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранено как новое изображение в медиатеке. Скриншоты не изменены."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arşivine yeni bir görüntü olarak kaydedildi. Ekran görüntüleri değişmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збережено як нове зображення в медіатеці. Знімки екрана не змінено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已作为新图片存储到图库。截屏保持不变。"
          }
        }
      }
    },
