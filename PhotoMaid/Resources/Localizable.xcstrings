    "ana2_background_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض iOS التقدّم وقد يوقف التحليل في أي وقت، ثم يتابع عند فتح GaleriQ في المرة التالية. لا يغادر أي شيء هذا الـ iPhone."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS shows the progress and may stop the analysis at any time. It then continues the next time you open GaleriQ. Nothing leaves this iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS zeigt den Fortschritt an und kann die Analyse jederzeit beenden. Sie geht dann beim nächsten Öffnen von GaleriQ weiter. Nichts verlässt dieses iPhone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS shows the progress and may stop the analysis at any time. It then continues the next time you open GaleriQ. Nothing leaves this iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS muestra el progreso y puede detener el análisis en cualquier momento. Continuará la próxima vez que abras GaleriQ. Nada sale de este iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS affiche la progression et peut arrêter l’analyse à tout moment. Elle reprend à la prochaine ouverture de GaleriQ. Rien ne quitte cet iPhone."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS shows the progress and may stop the analysis at any time. It then continues the next time you open GaleriQ. Nothing leaves this iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS mostra l’avanzamento e può interrompere l’analisi in qualsiasi momento. Riprende alla prossima apertura di GaleriQ. Nulla lascia questo iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "進行状況はiOSが表示し、iOSが分析をいつでも終了することがあります。その場合は次にGaleriQを開いたときに続行します。データはこのiPhoneから出ません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS가 진행 상황을 보여 주며 언제든 분석을 멈출 수 있어요. 그러면 다음에 GaleriQ를 열 때 이어서 진행돼요. 어떤 데이터도 이 iPhone 밖으로 나가지 않아요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS shows the progress and may stop the analysis at any time. It then continues the next time you open GaleriQ. Nothing leaves this iPhone."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS toont de voortgang en kan de analyse altijd stoppen. Hij gaat dan verder als je GaleriQ weer opent. Niets verlaat deze iPhone."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS pokazuje postęp i może w każdej chwili przerwać analizę. Wtedy będzie kontynuowana przy następnym otwarciu GaleriQ. Nic nie opuszcza tego iPhone’a."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS shows the progress and may stop the analysis at any time. It then continues the next time you open GaleriQ. Nothing leaves this iPhone."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O iOS mostra o progresso e pode parar a análise a qualquer momento. Ela continua na próxima vez que abrires o GaleriQ. Nada sai deste iPhone."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS afișează progresul și poate opri oricând analiza. Ea continuă data viitoare când deschizi GaleriQ. Nimic nu părăsește acest iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS показывает ход работы и может в любой момент остановить анализ. Тогда он продолжится при следующем открытии GaleriQ. Ничто не покидает этот iPhone."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS shows the progress and may stop the analysis at any time. It then continues the next time you open GaleriQ. Nothing leaves this iPhone."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS shows the progress and may stop the analysis at any time. It then continues the next time you open GaleriQ. Nothing leaves this iPhone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlerlemeyi iOS gösterir ve analizi her an durdurabilir. Analiz, GaleriQ’i bir sonraki açışında devam eder. Hiçbir şey bu iPhone’dan çıkmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS показує поступ і може будь-коли зупинити аналіз. Тоді він продовжиться під час наступного відкриття GaleriQ. Ніщо не залишає цей iPhone."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS shows the progress and may stop the analysis at any time. It then continues the next time you open GaleriQ. Nothing leaves this iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 会显示进度，并可能随时停止分析。下次打开 GaleriQ 时会继续。任何内容都不会离开这台 iPhone。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS shows the progress and may stop the analysis at any time. It then continues the next time you open GaleriQ. Nothing leaves this iPhone."
          }
        }
      }
    },
    "ana2_background_silent": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المتابعة لفترة قصيرة في الخلفية"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsæt kort i baggrunden"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurz im Hintergrund weiteranalysieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue briefly in the background"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuar brevemente en segundo plano"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuer brièvement en arrière-plan"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lanjutkan sebentar di latar belakang"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua brevemente in background"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックグラウンドで短時間続行"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백그라운드에서 잠시 계속"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsett en kort stund i bakgrunnen"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kort doorgaan op de achtergrond"
          }
        },
        "pl": {
