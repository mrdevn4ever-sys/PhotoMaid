    "privacy_folders_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأتي الملفات الأخرى فقط من مجلدات تختارها. وصّلها من تنظيف › ملفات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weitere Dateien stammen nur aus Ordnern, die du auswählst. Verbinde sie unter Aufräumen › Dateien."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Other files come only from folders you choose. Connect them under Clean up › Files."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los demás archivos solo proceden de las carpetas que elijas. Conéctalas en Limpiar › Archivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les autres fichiers proviennent uniquement des dossiers que tu choisis. Connecte-les dans Faire le tri › Fichiers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli altri file provengono solo dalle cartelle che scegli. Collegale in Riordina › File."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その他のファイルは、自分で選んだフォルダだけから表示します。「整理」›「ファイル」で接続できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 파일은 직접 선택한 폴더에서만 가져와요. 정리 › 파일에서 연결하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere bestanden komen alleen uit mappen die je kiest. Koppel ze via Opruimen › Bestanden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozostałe pliki pochodzą tylko z wybranych folderów. Połącz je w Porządki › Pliki."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os outros ficheiros vêm apenas das pastas que escolheres. Liga-as em Limpar › Ficheiros."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Celelalte fișiere provin doar din dosarele alese de tine. Conectează-le în Curățenie › Fișiere."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Другие файлы берутся только из выбранных папок. Подключи их в разделе Уборка › Файлы."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer dosyalar yalnızca seçtiğin klasörlerden gelir. Temizle › Dosyalar bölümünden bağla."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інші файли надходять лише з папок, які ти вибираєш. Підключи їх у Прибирання › Файли."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他文件只来自你选择的文件夹。可在“清理”›“文件”中连接。"
          }
        }
      }
    },
