    "archive_target_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صِل ذاكرة USB أو قرصًا خارجيًا واختر مجلدًا عليه. يمكن أيضًا استخدام iCloud Drive ومواقع أخرى في تطبيق الملفات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি USB স্টিক বা এক্সটার্নাল ড্রাইভ সংযুক্ত করে তাতে একটি ফোল্ডার বেছে নিন। iCloud Drive ও ফাইলস অ্যাপের অন্যান্য জায়গাও চলে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecta un llapis USB o un disc extern i tria-hi una carpeta. També funcionen l’iCloud Drive i altres ubicacions de l’app Fitxers."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připojte USB disk nebo externí disk a vyberte na něm složku. Funguje i iCloud Drive a další místa v aplikaci Soubory."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilslut en USB-nøgle eller et eksternt drev, og vælg en mappe på det. iCloud Drive og andre steder i appen Arkiver virker også."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließe einen USB-Stick oder eine externe Festplatte an und wähle dort einen Ordner. iCloud Drive und andere Orte der Dateien-App gehen auch."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σύνδεσε ένα στικάκι USB ή εξωτερικό δίσκο και επίλεξε έναν φάκελο εκεί. Λειτουργούν επίσης το iCloud Drive και άλλες τοποθεσίες της εφαρμογής Αρχεία."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect a USB stick or external drive and choose a folder on it. iCloud Drive and other locations in the Files app work too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta una memoria USB o un disco externo y elige una carpeta en él. También sirven iCloud Drive y otras ubicaciones de la app Archivos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liitä USB-tikku tai ulkoinen levy ja valitse sieltä kansio. Myös iCloud Drive ja muut Tiedostot-apin sijainnit toimivat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Branchez une clé USB ou un disque externe et choisissez-y un dossier. iCloud Drive et les autres emplacements de l’app Fichiers fonctionnent aussi."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "USB સ્ટિક કે બાહ્ય ડ્રાઇવ જોડો અને તેના પર ફોલ્ડર પસંદ કરો. iCloud Drive અને ફાઇલ્સ ઍપની બીજી જગ્યાઓ પણ ચાલે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר לחבר דיסק און קי או כונן חיצוני ולבחור בו תיקייה. גם iCloud Drive ומיקומים אחרים ביישום ״קבצים״ מתאימים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "USB स्टिक या एक्सटर्नल ड्राइव जोड़ें और उस पर कोई फ़ोल्डर चुनें। iCloud Drive और फ़ाइल्स ऐप की दूसरी जगहें भी काम करती हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Priključi USB stick ili vanjski disk i odaberi mapu na njemu. Rade i iCloud Drive i druga mjesta u aplikaciji Datoteke."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csatlakoztass egy pendrive-ot vagy külső meghajtót, és válassz rajta mappát. Az iCloud Drive és a Fájlok app más helyei is működnek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sambungkan flashdisk USB atau drive eksternal dan pilih folder di dalamnya. iCloud Drive dan lokasi lain di app File juga bisa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collega una chiavetta USB o un disco esterno e scegli una cartella. Vanno bene anche iCloud Drive e altre posizioni dell’app File."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "USBメモリや外付けドライブを接続し、その中のフォルダを選んでください。iCloud Driveや「ファイル」アプリのほかの場所も使えます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "USB ಸ್ಟಿಕ್ ಅಥವಾ ಬಾಹ್ಯ ಡ್ರೈವ್ ಸಂಪರ್ಕಿಸಿ ಅದರಲ್ಲಿ ಫೋಲ್ಡರ್ ಆಯ್ಕೆಮಾಡಿ. iCloud Drive ಮತ್ತು ಫೈಲ್‌ಗಳು ಆ್ಯಪ್‌ನ ಇತರ ಸ್ಥಳಗಳೂ ಕೆಲಸ ಮಾಡುತ್ತವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "USB 메모리나 외장 드라이브를 연결하고 그 안의 폴더를 선택하세요. iCloud Drive와 파일 앱의 다른 위치도 사용할 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "USB സ്റ്റിക്ക് അല്ലെങ്കിൽ എക്സ്റ്റേണൽ ഡ്രൈവ് കണക്റ്റ് ചെയ്ത് അതിൽ ഒരു ഫോൾഡർ തിരഞ്ഞെടുക്കുക. iCloud Drive-ഉം ഫയൽസ് ആപ്പിലെ മറ്റ് സ്ഥലങ്ങളും പ്രവർത്തിക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "USB स्टिक किंवा बाह्य ड्राइव्ह जोडा आणि त्यावरील फोल्डर निवडा. iCloud Drive आणि फाइल्स अ‍ॅपमधील इतर ठिकाणेही चालतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sambungkan pemacu USB atau cakera luaran dan pilih folder padanya. iCloud Drive dan lokasi lain dalam app Fail juga boleh digunakan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Koble til en minnepinne eller en ekstern disk og velg en mappe på den. iCloud Drive og andre steder i Filer-appen fungerer også."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sluit een usb-stick of externe schijf aan en kies daar een map. iCloud Drive en andere locaties in de Bestanden-app werken ook."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏକ USB ଷ୍ଟିକ୍ କିମ୍ବା ବାହ୍ୟ ଡ୍ରାଇଭ୍ ସଂଯୋଗ କରି ସେଥିରେ ଏକ ଫୋଲ୍ଡର ବାଛନ୍ତୁ। iCloud Drive ଓ ଫାଇଲ୍ସ ଆପ୍‌ର ଅନ୍ୟ ସ୍ଥାନ ମଧ୍ୟ କାମ କରେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "USB ਸਟਿੱਕ ਜਾਂ ਬਾਹਰੀ ਡਰਾਈਵ ਜੋੜੋ ਅਤੇ ਉਸ ਉੱਤੇ ਫ਼ੋਲਡਰ ਚੁਣੋ। iCloud Drive ਅਤੇ ਫ਼ਾਈਲਾਂ ਐਪ ਦੀਆਂ ਹੋਰ ਥਾਵਾਂ ਵੀ ਕੰਮ ਕਰਦੀਆਂ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podłącz pendrive lub dysk zewnętrzny i wybierz na nim folder. Działa też iCloud Drive i inne miejsca w aplikacji Pliki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte um pendrive ou disco externo e escolha uma pasta nele. O iCloud Drive e outros locais do app Arquivos também funcionam."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ligue uma pen USB ou um disco externo e escolha lá uma pasta. O iCloud Drive e outras localizações da app Ficheiros também funcionam."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectează un stick USB sau un hard disk extern și alege un dosar de pe el. Merg și iCloud Drive și alte locații din aplicația Fișiere."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключите USB-флешку или внешний диск и выберите на нём папку. Подойдут также iCloud Drive и другие места в приложении «Файлы»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pripojte USB kľúč alebo externý disk a vyberte na ňom priečinok. Funguje aj iCloud Drive a ďalšie miesta v aplikácii Súbory."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Priklopi ključek USB ali zunanji disk in na njem izberi mapo. Delujeta tudi iCloud Drive in druga mesta v aplikaciji Datoteke."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anslut ett USB-minne eller en extern disk och välj en mapp på den. iCloud Drive och andra platser i appen Filer fungerar också."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "USB ஸ்டிக் அல்லது வெளிப்புற டிரைவை இணைத்து அதில் ஒரு கோப்புறையைத் தேர்ந்தெடுங்கள். iCloud Drive மற்றும் Files ஆப்பின் மற்ற இடங்களும் வேலை செய்யும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "USB స్టిక్ లేదా ఎక్స్‌టర్నల్ డ్రైవ్‌ను కనెక్ట్ చేసి అందులో ఒక ఫోల్డర్ ఎంచుకోండి. iCloud Drive, Files యాప్‌లోని ఇతర స్థానాలు కూడా పనిచేస్తాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อแฟลชไดรฟ์ USB หรือฮาร์ดดิสก์ภายนอกแล้วเลือกโฟลเดอร์ในนั้น iCloud Drive และตำแหน่งอื่นในแอพไฟล์ก็ใช้ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir USB bellek veya harici disk tak ve üzerinde bir klasör seç. iCloud Drive ve Dosyalar uygulamasındaki diğer konumlar da olur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під’єднайте USB-флешку або зовнішній диск і виберіть на ньому папку. Також підійдуть iCloud Drive та інші місця в програмі «Файли»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "USB اسٹک یا بیرونی ڈرائیو لگائیں اور اس پر فولڈر منتخب کریں۔ iCloud Drive اور فائلز ایپ کی دوسری جگہیں بھی کام کرتی ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cắm USB hoặc ổ cứng ngoài và chọn một thư mục trên đó. iCloud Drive và các vị trí khác trong ứng dụng Tệp cũng dùng được."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接 U 盘或外置硬盘并在其中选择一个文件夹。也可以使用 iCloud Drive 和“文件”App 中的其他位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連接 USB 隨身碟或外接硬碟，並選擇其中的檔案夾。iCloud 雲碟和「檔案」App 中的其他位置也可以。"
          }
        }
      }
    },
