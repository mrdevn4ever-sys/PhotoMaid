    "pro2_free_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل ما عدا ذلك – التحرير والتحليل والتكرارات والمجموعات والاستوديو – مجاني للجميع."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt andet – redigering, analyse, dubletter, samlinger, Studio – er gratis for alle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles andere – Bearbeiten, Analyse, Duplikate, Sammlungen, Studio – ist für alle kostenlos."
          }
        },
        "en": {
