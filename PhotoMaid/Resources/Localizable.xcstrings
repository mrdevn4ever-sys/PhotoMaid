            "state": "translated",
            "value": "Fotky uložené na iCloudu se načtou podle potřeby."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos i iCloud indlæses efter behov."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fehlende Fotos werden bei Bedarf aus iCloud geladen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι φωτογραφίες στο iCloud φορτώνονται όταν χρειάζεται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos stored in iCloud load when needed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos de iCloud se cargan cuando hacen falta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudiin tallennetut kuvat ladataan tarvittaessa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos iCloud se chargent au besoin."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud માં સાચવેલા ફોટા જરૂર પડે ત્યારે લોડ થાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תמונות שמאוחסנות ב-iCloud נטענות לפי הצורך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud में रखी फ़ोटो ज़रूरत पड़ने पर लोड होती हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografije spremljene u iCloudu učitavaju se po potrebi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az iCloudban tárolt fotók szükség esetén töltődnek be."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto yang tersimpan di iCloud dimuat saat diperlukan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le foto su iCloud vengono caricate quando servono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "必要に応じてiCloudから写真を読み込みます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ನಲ್ಲಿ ಸಂಗ್ರಹಿಸಿದ ಫೋಟೋಗಳು ಅಗತ್ಯವಿದ್ದಾಗ ಲೋಡ್ ಆಗುತ್ತವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "필요한 사진을 iCloud에서 불러와요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud-ൽ സംഭരിച്ച ഫോട്ടോകൾ ആവശ്യമുള്ളപ്പോൾ ലോഡ് ചെയ്യും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud मध्ये जतन केलेले फोटो गरजेनुसार लोड होतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto yang disimpan dalam iCloud dimuatkan apabila perlu."
          }
