    "help_free_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العرض والسحب والحفظ لوقت لاحق بلا حدود. من دون Pro، يمكنك إزالة ما يصل إلى %1$lld يوميًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Viewing, swiping and saving for later are unlimited. Without Pro, you can remove up to %1$lld a day."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ansehen, wischen und für später speichern ist unbegrenzt. Ohne Pro kannst du pro Tag bis zu %1$lld davon entfernen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Viewing, swiping and saving for later are unlimited. Without Pro, you can remove up to %1$lld a day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ver, deslizar y guardar para después no tiene límite. Sin Pro, puedes quitar hasta %1$lld al día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voir, faire défiler et garder pour plus tard sont illimités. Sans Pro, tu peux en retirer jusqu’à %1$lld par jour."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Viewing, swiping and saving for later are unlimited. Without Pro, you can remove up to %1$lld a day."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedere, scorrere e salvare per più tardi è illimitato. Senza Pro puoi rimuoverne fino a %1$lld al giorno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示、スワイプ、あとで見るための保存は無制限です。Proなしでは、1日%1$lld件まで削除できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보기, 스와이프, 나중에 보기 저장은 무제한이에요. Pro 없이도 하루에 최대 %1$lld개를 삭제할 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Viewing, swiping and saving for later are unlimited. Without Pro, you can remove up to %1$lld a day."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekijken, vegen en voor later bewaren is onbeperkt. Zonder Pro kun je er maximaal %1$lld per dag verwijderen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeglądanie, przesuwanie i zapisywanie na później jest bez limitu. Bez Pro możesz usunąć maksymalnie %1$lld dziennie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Viewing, swiping and saving for later are unlimited. Without Pro, you can remove up to %1$lld a day."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ver, deslizar e guardar para mais tarde não tem limite. Sem Pro, podes remover até %1$lld por dia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Poți vedea, glisa și salva pentru mai târziu fără limită. Fără Pro, poți elimina cel mult %1$lld pe zi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Просмотр, смахивания и сохранение на потом — без ограничений. Без Pro можно удалить до %1$lld в день."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Viewing, swiping and saving for later are unlimited. Without Pro, you can remove up to %1$lld a day."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Viewing, swiping and saving for later are unlimited. Without Pro, you can remove up to %1$lld a day."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görüntüleme, kaydırma ve sonra için saklama sınırsızdır. Pro olmadan günde en fazla %1$lld öğe kaldırabilirsin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перегляд, змахування й збереження на потім — без обмежень. Без Pro можна видалити до %1$lld за день."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Viewing, swiping and saving for later are unlimited. Without Pro, you can remove up to %1$lld a day."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看、滑动和留待稍后的次数不限。无需 Pro，每天最多可移除 %1$lld 项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Viewing, swiping and saving for later are unlimited. Without Pro, you can remove up to %1$lld a day."
          }
        }
      }
    },
