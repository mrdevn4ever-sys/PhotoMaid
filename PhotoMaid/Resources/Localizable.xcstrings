    "set_rate_app_sub": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رأيك يساعدنا كثيرًا – شكرًا!"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি সত্যিই আমাদের সাহায্য করে – ধন্যবাদ!"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ens ajuda molt. Gràcies!"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Opravdu nám to pomáhá – děkujeme!"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det hjælper os virkelig – tak!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hilft uns sehr – danke!"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μας βοηθά πραγματικά – ευχαριστούμε!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It really helps us – thank you!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nos ayuda mucho. ¡Gracias!"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se auttaa meitä todella – kiitos!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ça nous aide beaucoup, merci !"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તેનાથી અમને ખરેખર મદદ મળે છે – આભાર!"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זה ממש עוזר לנו – תודה!"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे हमें सच में मदद मिलती है – धन्यवाद!"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stvarno nam pomaže – hvala!"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagyon sokat segít – köszönjük!"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Itu sangat membantu kami – terima kasih!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ci aiuta molto, grazie!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "とても励みになります。ありがとうございます！"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇದು ನಿಜವಾಗಿಯೂ ನಮಗೆ ಸಹಾಯ ಮಾಡುತ್ತದೆ – ಧನ್ಯವಾದಗಳು!"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "큰 힘이 돼요. 고마워요!"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇത് ഞങ്ങളെ ശരിക്കും സഹായിക്കുന്നു – നന്ദി!"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "याची आम्हाला खरोखर मदत होते – धन्यवाद!"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ia sangat membantu kami – terima kasih!"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det hjelper oss virkelig – takk!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat helpt ons enorm. Bedankt!"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହା ସତରେ ଆମକୁ ସାହାଯ୍ୟ କରେ – ଧନ୍ୟବାଦ!"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਨਾਲ ਸਾਡੀ ਸੱਚਮੁੱਚ ਮਦਦ ਹੁੰਦੀ ਹੈ – ਧੰਨਵਾਦ!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To nam bardzo pomaga. Dziękujemy!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso nos ajuda muito – obrigado!"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuda-nos muito. Obrigado!"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne ajută mult. Mulțumim!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это очень нам помогает. Спасибо!"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Naozaj nám to pomáha – ďakujeme!"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Res nam pomaga – hvala!"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det hjälper oss verkligen – tack!"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இது எங்களுக்கு உண்மையில் உதவுகிறது – நன்றி!"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇది మాకు నిజంగా సహాయపడుతుంది – ధన్యవాదాలు!"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ช่วยเราได้มากจริงๆ – ขอบคุณ!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bize çok yardımcı olur. Teşekkürler!"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це дуже нам допомагає. Дякуємо!"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس سے ہمیں واقعی مدد ملتی ہے – شکریہ!"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điều đó thật sự giúp chúng tôi – cảm ơn bạn!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这对我们帮助很大，谢谢！"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這對我們真的很有幫助 – 謝謝你！"
          }
        }
      }
    },
