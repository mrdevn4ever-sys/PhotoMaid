    "summary_offer_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مع PhotoMaid Pro ترتّب دون حد يومي. شراء مرة واحدة، بلا اشتراك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit PhotoMaid Pro räumst du ohne Tageslimit auf. Einmal kaufen, kein Abo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clean up without a daily limit with PhotoMaid Pro. Buy once, no subscription."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con PhotoMaid Pro ordenas sin límite diario. Pago único, sin suscripción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec PhotoMaid Pro, triez sans limite quotidienne. Achat unique, sans abonnement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con PhotoMaid Pro riordini senza limite giornaliero. Acquisto unico, nessun abbonamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid Proなら1日の上限なしで整理できます。買い切りでサブスクなし。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid Pro로 하루 한도 없이 정리하세요. 한 번 구매, 구독 없음."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met PhotoMaid Pro ruim je op zonder daglimiet. Eenmalig kopen, geen abonnement."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Z PhotoMaid Pro porządkujesz bez dziennego limitu. Jednorazowy zakup, bez subskrypcji."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Com o PhotoMaid Pro arruma sem limite diário. Compra única, sem subscrição."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cu PhotoMaid Pro ordonezi fără limită zilnică. Cumperi o dată, fără abonament."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С PhotoMaid Pro можно убирать без дневного лимита. Одна покупка, без подписки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid Pro ile günlük sınır olmadan temizle. Tek seferlik satın alma, abonelik yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "З PhotoMaid Pro прибирайте без денного ліміту. Одноразова покупка, без підписки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 PhotoMaid Pro 整理不受每日限制。一次购买，无需订阅。"
          }
        }
      }
    },
