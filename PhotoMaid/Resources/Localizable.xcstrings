    "vault_recovery_skip_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدون مفتاح استرداد، يضيع المحتوى نهائيًا إذا نسيت رمزك ولم يكن Face ID متاحًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Notfallschlüssel ist der Inhalt endgültig verloren, wenn du den Code vergisst und Face ID nicht verfügbar ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without a recovery key, the content is lost for good if you forget your code and Face ID isn’t available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin clave de recuperación, el contenido se pierde para siempre si olvidas tu código y Face ID no está disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans clé de secours, le contenu est perdu définitivement si tu oublies ton code et que Face ID n’est pas disponible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza chiave di recupero, il contenuto va perso per sempre se dimentichi il codice e Face ID non è disponibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復旧キーがないと、コードを忘れてFace IDも使えない場合、中身は完全に失われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복구 키가 없으면 암호를 잊고 Face ID도 사용할 수 없을 때 콘텐츠를 영구적으로 잃게 됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonder herstelsleutel ben je de inhoud voorgoed kwijt als je je code vergeet en Face ID niet beschikbaar is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez klucza odzyskiwania zawartość przepadnie na zawsze, jeśli zapomnisz kodu, a Face ID nie będzie dostępny."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem chave de recuperação, o conteúdo perde-se para sempre se te esqueceres do código e o Face ID não estiver disponível."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fără cheie de recuperare, conținutul se pierde definitiv dacă uiți codul și Face ID nu este disponibil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без ключа восстановления содержимое будет потеряно навсегда, если ты забудешь код, а Face ID будет недоступен."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurtarma anahtarı olmadan, kodunu unutursan ve Face ID kullanılamıyorsa içerik kalıcı olarak kaybolur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Без ключа відновлення вміст буде втрачено назавжди, якщо ти забудеш код, а Face ID буде недоступний."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果没有恢复密钥，一旦忘记密码且无法使用 Face ID，内容将永久丢失。"
          }
        }
      }
    },
    "vault_recovery_skip_title": {
      "extractionState": "manual",
      "localizations": {
