        }
      }
    },
    "ana2_stage_thermal": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متوقف مؤقتًا – الـ iPhone ساخن جدًا. سيتابع تلقائيًا بعد أن يبرد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Angehalten – das iPhone ist sehr heiß. Geht von selbst weiter, sobald es abgekühlt ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paused – the iPhone is very hot. It continues on its own once it has cooled down."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En pausa: el iPhone está muy caliente. Continuará solo cuando se enfríe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En pause – l’iPhone est très chaud. Reprend tout seul une fois refroidi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In pausa: l’iPhone è molto caldo. Riprende da solo quando si è raffreddato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一時停止中 – iPhoneがとても熱くなっています。冷えると自動で続行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일시 정지됨 – iPhone이 매우 뜨거워요. 식으면 자동으로 계속돼요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gepauzeerd – de iPhone is erg heet. Gaat vanzelf verder zodra hij is afgekoeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wstrzymano – iPhone jest bardzo gorący. Wznowi się sam, gdy ostygnie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Em pausa – o iPhone está muito quente. Continua sozinho quando arrefecer."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Întrerupt – iPhone-ul este foarte fierbinte. Continuă singur după ce se răcește."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приостановлено – iPhone очень горячий. Продолжится само, когда он остынет."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Duraklatıldı – iPhone çok sıcak. Soğuyunca kendiliğinden devam eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Призупинено – iPhone дуже гарячий. Продовжиться саме, щойно він охолоне."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已暂停 – iPhone 过热。降温后会自动继续。"
          }
        }
      }
    },
    "ana2_stage_wifi": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
