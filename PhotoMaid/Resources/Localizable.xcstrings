    "qa_random_sub": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld من الصور والفيديوهات غير المراجعة عشوائيًا، بخلط جديد في كل مرة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lldটি এলোমেলো বাকি ফটো ও ভিডিও, প্রতিবার নতুন করে মেশানো"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld fotos i vídeos pendents a l’atzar, barrejats cada vegada"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld náhodných neprošlých fotek a videí, pokaždé znovu zamíchaných"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld tilfældige fotos og videoer, der endnu ikke er gennemgået, blandet på ny hver gang"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld zufällige offene Fotos und Videos, jedes Mal neu gemischt"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld τυχαίες μη ελεγμένες φωτογραφίες και βίντεο, ανακατεμένες κάθε φορά"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld random open photos and videos, reshuffled every time"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld fotos y vídeos pendientes al azar, mezclados de nuevo cada vez"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld satunnaista läpikäymätöntä kuvaa ja videota, joka kerta uudelleen sekoitettuina"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld photos et vidéos à trier au hasard, remélangées à chaque fois"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld અવ્યવસ્થિત ન જોયેલા ફોટા અને વીડિયો, દર વખતે નવેસરથી મિક્સ કરેલા"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld תמונות וסרטונים אקראיים שטרם נסקרו, מעורבבים מחדש בכל פעם"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld रैंडम बिना देखी फ़ोटो और वीडियो, हर बार नए सिरे से मिलाए गए"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld nasumičnih nepregledanih fotografija i videozapisa, svaki put ponovno izmiješanih"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld véletlen, még át nem nézett fotó és videó, minden alkalommal újrakeverve"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld foto dan video acak yang belum ditinjau, diacak ulang setiap kali"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld foto e video da controllare a caso, rimescolati ogni volta"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未確認の写真と動画からランダムに%1$lld件（毎回シャッフル）"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld ಯಾದೃಚ್ಛಿಕ ಬಾಕಿ ಫೋಟೋಗಳು ಮತ್ತು ವೀಡಿಯೊಗಳು, ಪ್ರತಿ ಬಾರಿ ಹೊಸದಾಗಿ ಷಫಲ್"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인할 사진과 동영상 중 무작위 %1$lld개, 매번 새로 섞기"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld ക്രമരഹിത ബാക്കി ഫോട്ടോകളും വീഡിയോകളും, ഓരോ തവണയും പുതുതായി ഷഫിൾ ചെയ്തത്"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld यादृच्छिक न पाहिलेले फोटो आणि व्हिडिओ, प्रत्येक वेळी नव्याने मिसळलेले"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld foto dan video rawak yang belum disemak, dikocok semula setiap kali"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld tilfeldige bilder og videoer som du ikke har gått gjennom, blandet på nytt hver gang"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld willekeurige open foto’s en video’s, elke keer opnieuw geschud"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lldଟି ଅନିୟମିତ ବାକି ଫଟୋ ଓ ଭିଡିଓ, ପ୍ରତିଥର ନୂଆ କରି ମିଶା"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld ਬੇਤਰਤੀਬ ਬਾਕੀ ਫ਼ੋਟੋਆਂ ਅਤੇ ਵੀਡੀਓ, ਹਰ ਵਾਰ ਨਵੇਂ ਸਿਰੇ ਤੋਂ ਰਲਾਈਆਂ"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld losowych zdjęć i filmów do przejrzenia, za każdym razem na nowo"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld fotos e vídeos aleatórios ainda não revisados, embaralhados a cada vez"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld fotos e vídeos por rever ao acaso, baralhados de novo a cada vez"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografii și videoclipuri aleatorii de verificat (%1$lld), amestecate de fiecare dată"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld случайных фото и видео для просмотра, каждый раз заново"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld náhodných neprezretých fotiek a videí, zakaždým znova zamiešaných"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld naključnih nepregledanih fotografij in videoposnetkov, vsakič znova premešanih"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld slumpvis valda bilder och videor som du inte gått igenom, blandade på nytt varje gång"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld சீரற்ற மீதமுள்ள புகைப்படங்களும் வீடியோக்களும், ஒவ்வொரு முறையும் புதிதாகக் கலக்கப்படும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld యాదృచ్ఛిక మిగిలిన ఫోటోలు, వీడియోలు, ప్రతిసారీ కొత్తగా షఫుల్"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปภาพและวิดีโอที่ยังไม่ตรวจดูแบบสุ่ม %1$lld รายการ สลับใหม่ทุกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İncelenecek %1$lld rastgele fotoğraf ve video, her seferinde yeniden karıştırılır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld випадкових фото й відео для перегляду, щоразу по-новому"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld بے ترتیب غیر جائزہ شدہ تصاویر اور ویڈیوز، ہر بار نئے سرے سے ملائی گئیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld ảnh và video chưa xem lại ngẫu nhiên, xáo lại mỗi lần"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随机 %1$lld 个待查看的照片和视频，每次重新打乱"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 個隨機待整理的照片和影片，每次重新洗牌"
