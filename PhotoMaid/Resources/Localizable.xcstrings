    "tour_today_hero_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط «ابدأ التنظيف» لتراجع بالسحب كل ما تبقى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পর্যালোচনার বাকি সবকিছু সোয়াইপ করে দেখতে “পরিষ্কার শুরু করুন”-এ ট্যাপ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca «Començar a endreçar» per lliscar per tot el que queda per revisar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepněte na „Začít uklízet“ a projeďte vše, co zbývá projít."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på “Begynd at rydde op” for at swipe igennem alt, der mangler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Tipp auf „Jetzt aufräumen“ und du wischst durch alles, was noch offen ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάτησε «Έναρξη τακτοποίησης» για να περάσεις όσα απομένουν για έλεγχο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap “Start cleaning up” to swipe through everything left to review."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca «Empezar a limpiar» para revisar todo lo que queda pendiente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta ”Aloita siivous” pyyhkäistäksesi läpi kaiken, mikä on vielä läpikäymättä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche « Commencer le tri » pour parcourir tout ce qu’il reste à voir."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જોવાનું બાકી બધું સ્વાઇપ કરવા “સાફસફાઈ શરૂ કરો” પર ટૅપ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקשה על „התחלת סידור” מאפשרת להחליק על כל מה שנשאר לסקור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बचा हुआ सब कुछ देखने के लिए “सफ़ाई शुरू करें” पर टैप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirni „Počni raščišćavati” da povlačenjem prođeš sve što je preostalo za pregled."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints a „Rendrakás indítása” gombra, hogy végighúzd mindazt, ami még átnézendő."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk “Mulai merapikan” untuk menggeser semua yang belum ditinjau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca «Inizia a riordinare» per scorrere tutto ciò che resta da controllare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「整理を始める」をタップして、まだ確認していないものをスワイプしましょう。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪರಿಶೀಲಿಸಲು ಬಾಕಿ ಇರುವ ಎಲ್ಲವನ್ನೂ ಸ್ವೈಪ್ ಮಾಡಲು “ಸ್ವಚ್ಛಗೊಳಿಸಲು ಪ್ರಾರಂಭಿಸಿ” ಟ್ಯಾಪ್ ಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘정리 시작’을 눌러 아직 확인하지 않은 항목을 하나씩 넘겨 보세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പരിശോധിക്കാൻ ബാക്കിയുള്ളതെല്ലാം സ്വൈപ്പ് ചെയ്യാൻ “വൃത്തിയാക്കൽ ആരംഭിക്കുക” ടാപ്പ് ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पाहायचे बाकी सर्व स्वाइप करण्यासाठी “साफसफाई सुरू करा” वर टॅप करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik “Mula mengemas” untuk meleret melalui semua yang masih perlu disemak."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på «Begynn å rydde» for å sveipe gjennom alt som gjenstår."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op ‘Begin met opruimen’ om door alles te vegen wat nog bekeken moet worden."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସମୀକ୍ଷା ପାଇଁ ବାକି ସବୁକୁ ସ୍ୱାଇପ୍ କରିବାକୁ “ସଫା କରିବା ଆରମ୍ଭ କରନ୍ତୁ”ରେ ଟାପ୍ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਮੀਖਿਆ ਲਈ ਬਾਕੀ ਹਰ ਚੀਜ਼ ਉੱਤੇ ਸਵਾਈਪ ਕਰਨ ਲਈ “ਸਫ਼ਾਈ ਸ਼ੁਰੂ ਕਰੋ” ਉੱਤੇ ਟੈਪ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotknij „Zacznij porządki”, aby przejrzeć wszystko, co jeszcze zostało."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em “Começar a limpar” para deslizar por tudo o que falta revisar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca em «Começar a limpar» para percorrer tudo o que falta rever."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge „Începe curățenia” ca să treci prin tot ce a mai rămas de verificat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажми «Начать уборку», чтобы просмотреть всё, что ещё осталось."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnite na „Začať upratovať“ a prejdite všetko, čo zostáva prezrieť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapni »Začni čistiti«, da podrsaš skozi vse, kar je še za pregled."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på ”Börja rensa” för att svepa igenom allt som återstår."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பார்வையிட மீதமுள்ள அனைத்தையும் ஸ்வைப் செய்ய “சுத்தம் செய்யத் தொடங்கு” என்பதைத் தட்டுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సమీక్షించాల్సిన మిగతావన్నీ స్వైప్ చేయడానికి “శుభ్రం చేయడం ప్రారంభించండి” ట్యాప్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะ “เริ่มจัดระเบียบ” เพื่อปัดดูทุกอย่างที่ยังรอตรวจดู"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İncelenecek her şeyi kaydırarak görmek için “Temizliğe başla” seçeneğine dokun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисни «Почати прибирання», щоб переглянути все, що ще залишилося."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جائزے کے لیے باقی سب کچھ دیکھنے کے لیے ”صفائی شروع کریں“ پر ٹیپ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm “Bắt đầu dọn dẹp” để vuốt qua mọi thứ còn cần xem lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击“开始清理”，滑动查看尚未处理的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下「開始整理」，滑動瀏覽所有待整理的內容。"
          }
        }
      }
    },
    "tour_today_hero_title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ هنا"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখান থেকে শুরু করুন"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
