    "today_access_default": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح لـ GaleriQ بالوصول لتتمكن من عرض صورك وفيديوهاتك وترتيبها."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Giv GaleriQ adgang, så du kan se og organisere dine fotos og videoer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube GaleriQ den Zugriff, damit du deine Fotos und Videos ansehen und sortieren kannst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow GaleriQ access so you can view and organize your photos and videos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el acceso a GaleriQ para ver y organizar tus fotos y vídeos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorise GaleriQ à accéder à tes photos et vidéos pour les voir et les organiser."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan akses GaleriQ agar kamu bisa melihat dan merapikan foto dan videomu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti l’accesso a GaleriQ per vedere e organizzare foto e video."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真や動画を表示して整理するには、GaleriQにアクセスを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진과 동영상을 보고 정리할 수 있도록 GaleriQ에 접근을 허용해 주세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gi GaleriQ tilgang så du kan se og organisere bildene og videoene dine."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef GaleriQ toegang om je foto’s en video’s te bekijken en te ordenen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól GaleriQ na dostęp, aby przeglądać i porządkować zdjęcia i filmy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso do GaleriQ para ver e organizar suas fotos e vídeos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite o acesso ao GaleriQ para veres e organizares as tuas fotos e vídeos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite accesul pentru GaleriQ ca să vezi și să organizezi fotografiile și videoclipurile."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разреши GaleriQ доступ, чтобы просматривать и упорядочивать фото и видео."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ge GaleriQ åtkomst så att du kan visa och sortera dina bilder och videor."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตให้ GaleriQ เข้าถึงเพื่อดูและจัดระเบียบรูปภาพและวิดีโอของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraf ve videolarını görüntüleyip düzenlemek için GaleriQ uygulamasına erişim izni ver."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надай GaleriQ доступ, щоб переглядати й упорядковувати фото та відео."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép GaleriQ truy cập để bạn xem và sắp xếp ảnh, video."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请允许 GaleriQ 访问照片和视频，以便查看和整理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許 GaleriQ 取用，即可檢視和整理你的照片和影片。"
          }
        }
      }
    },
    "today_access_denied": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح بالوصول في إعدادات iOS ضمن GaleriQ › الصور. ستبقى قراراتك السابقة محفوظة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillad adgang i iOS-indstillingerne under GaleriQ › Fotos. Dine tidligere valg forbliver gemt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube den Zugriff in den iOS-Einstellungen unter GaleriQ › Fotos. Deine bisherigen Entscheidungen bleiben gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow access in iOS Settings under GaleriQ › Photos. Your previous choices will stay saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el acceso en Ajustes de iOS, en GaleriQ › Fotos. Tus decisiones anteriores se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l’accès dans les Réglages d’iOS, sous GaleriQ › Photos. Vos choix précédents restent enregistrés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan akses di Pengaturan iOS pada GaleriQ › Foto. Pilihanmu sebelumnya tetap tersimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti l’accesso nelle Impostazioni di iOS, in GaleriQ › Foto. Le tue scelte precedenti restano salvate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOSの設定 › GaleriQ › 写真 でアクセスを許可してください。これまでの判断は保存されたままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 설정 › GaleriQ › 사진에서 접근을 허용하세요. 이전 결정은 그대로 저장됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillat tilgang i iOS-innstillingene under GaleriQ › Bilder. De tidligere valgene dine forblir lagret."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta toegang toe in Instellingen van iOS onder GaleriQ › Foto’s. Je eerdere keuzes blijven bewaard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól na dostęp w Ustawieniach iOS w sekcji GaleriQ › Zdjęcia. Wcześniejsze decyzje pozostaną zapisane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso nos Ajustes do iOS em GaleriQ › Fotos. Suas escolhas anteriores continuam salvas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso nas Definições do iOS, em GaleriQ › Fotografias. As suas escolhas anteriores continuam guardadas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite accesul în Configurări iOS, la GaleriQ › Poze. Alegerile anterioare rămân salvate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите доступ в Настройках iOS: GaleriQ › Фото. Ваши прежние решения сохранятся."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillåt åtkomst i iOS-inställningarna under GaleriQ › Bilder. Dina tidigare val förblir sparade."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตการเข้าถึงในการตั้งค่า iOS ที่ GaleriQ › รูปภาพ การเลือกก่อนหน้านี้ของคุณยังคงบันทึกไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS Ayarlar’da GaleriQ › Fotoğraflar bölümünden erişime izin ver. Önceki kararların kayıtlı kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозвольте доступ у Параметрах iOS: GaleriQ › Фото. Ваші попередні рішення збережуться."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép truy cập trong Cài đặt iOS tại GaleriQ › Ảnh. Các lựa chọn trước đây của bạn vẫn được lưu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在 iOS“设置”中的 GaleriQ › 照片里允许访问。你之前的决定会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在 iOS「設定」› GaleriQ › 照片 中允許取用。你先前的選擇會繼續保留。"
          }
        }
