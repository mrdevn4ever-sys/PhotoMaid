        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nel cestino di GaleriQ: non viene eliminato nulla. Decidi lì più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQのゴミ箱へ。何も削除されません。あとでそこで決めます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ಕಸದ ಬುಟ್ಟಿಗೆ – ಏನನ್ನೂ ಅಳಿಸಲಾಗುವುದಿಲ್ಲ. ನಂತರ ಅಲ್ಲಿ ನೀವು ನಿರ್ಧರಿಸುತ್ತೀರಿ."
          }
