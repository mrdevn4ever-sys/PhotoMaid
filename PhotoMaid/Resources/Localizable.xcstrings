    "edit_remove_location_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن تتضمن الصورة المحفوظة مكان التقاطها."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gemte foto vil ikke indeholde, hvor det blev taget."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das gespeicherte Foto enthält dann keinen Aufnahmeort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved photo won’t include where it was taken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La foto guardada no incluirá dónde se tomó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La photo enregistrée n’indiquera pas où elle a été prise."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto yang disimpan tidak akan menyertakan tempat pengambilannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La foto salvata non conterrà il luogo dello scatto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存した写真に撮影場所が含まれなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장한 사진에 촬영 위치가 들어가지 않아요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det lagrede bildet vil ikke inneholde hvor det ble tatt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De opgeslagen foto bevat dan geen opnamelocatie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisane zdjęcie nie będzie zawierać miejsca wykonania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A foto salva não incluirá onde foi tirada."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A foto guardada não incluirá onde foi tirada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografia salvată nu va conține locul fotografierii."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В сохранённом фото не будет места съёмки."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den sparade bilden innehåller inte var den togs."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปที่บันทึกจะไม่มีข้อมูลสถานที่ถ่าย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydedilen fotoğrafta çekim yeri olmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У збереженому фото не буде місця зйомки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh được lưu sẽ không chứa nơi chụp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存的照片将不包含拍摄地点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存的照片不會包含拍攝地點。"
          }
        }
      }
    },
