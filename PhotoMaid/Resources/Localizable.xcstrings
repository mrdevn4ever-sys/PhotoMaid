        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "e.g. Listing → Listing_001 (empty = keep original name)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "p. ej. Anuncio → Anuncio_001 (vacío = nombre original)"
          }
        },
        "fr": {
