        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimés (« env. ») : %1$lld – iOS n’indique leur taille exacte qu’après téléchargement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stimati («circa»): %1$lld – iOS ne indica la dimensione esatta solo dopo il download."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "推定（「約」）：%1$lld – 正確なサイズはダウンロード後にのみiOSが示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추정(‘약’): %1$lld – 정확한 크기는 다운로드한 후에만 iOS가 알려 줘요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geschat (‘ca.’): %1$lld – de exacte grootte geeft iOS pas na het downloaden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szacowane („ok.”): %1$lld – dokładny rozmiar iOS podaje dopiero po pobraniu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimados («aprox.»): %1$lld – o iOS só indica o tamanho exato depois de os descarregar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimate („cca.”): %1$lld – iOS arată dimensiunea exactă abia după descărcare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оценка («≈»): %1$lld – точный размер iOS сообщает только после загрузки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahmini (“yaklaşık”): %1$lld – iOS tam boyutu ancak indirdikten sonra gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оцінка («≈»): %1$lld – точний розмір iOS повідомляє лише після завантаження."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "估算（“约”）：%1$lld – 只有下载后 iOS 才会提供确切大小。"
          }
        }
      }
    },
