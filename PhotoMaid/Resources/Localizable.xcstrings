    "storage_c_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستطيع GaleriQ فحص التطبيقات الأخرى أو ملفات النظام أو المحتوى السحابي أو المجلدات التي لم تسمح له بها. لذلك لا يعرض حجمًا لها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ অন্য অ্যাপ, সিস্টেম ফাইল, ক্লাউডের বিষয়বস্তু বা আপনি অনুমতি দেননি এমন ফোল্ডার দেখতে পারে না। এগুলোর জন্য কোনো আকার দেখানো হয় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ no pot comprovar altres apps, fitxers del sistema, contingut al núvol ni carpetes que no has permès. Per a aquests no es mostra cap mida."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ nemůže zkontrolovat jiné aplikace, systémové soubory, obsah v cloudu ani složky, které jste nepovolili. Pro ty se velikost nezobrazuje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ kan ikke kontrollere andre apps, systemfiler, skyindhold eller mapper, du ikke har tilladt. Der vises ingen størrelse for disse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere Apps, Systemdateien, Cloud-Inhalte und nicht freigegebene Ordner kann GaleriQ nicht prüfen. Dafür wird keine Größe angezeigt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το GaleriQ δεν μπορεί να ελέγξει άλλες εφαρμογές, αρχεία συστήματος, περιεχόμενο cloud ή φακέλους που δεν επέτρεψες. Για αυτά δεν εμφανίζεται μέγεθος."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ can’t check other apps, system files, cloud content or folders you haven’t allowed. No size is shown for these."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ no puede revisar otras apps, archivos del sistema, contenido en la nube ni carpetas no autorizadas. No se muestra su tamaño."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ei voi tarkistaa muita appeja, järjestelmätiedostoja, pilvisisältöä tai kansioita, joita et ole sallinut. Niille ei näytetä kokoa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ne peut pas vérifier les autres applications, les fichiers système, le contenu cloud ni les dossiers non autorisés. Aucune taille n’est affichée pour eux."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ બીજી ઍપ, સિસ્ટમ ફાઇલો, ક્લાઉડ સામગ્રી કે તમે મંજૂરી ન આપી હોય તેવાં ફોલ્ડર ચકાસી શકતું નથી. તેમના માટે કોઈ કદ બતાવાતું નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ לא יכולה לבדוק יישומים אחרים, קובצי מערכת, תוכן בענן או תיקיות שלא אישרת. עבורם לא מוצג גודל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ दूसरे ऐप, सिस्टम फ़ाइलें, क्लाउड सामग्री या वे फ़ोल्डर नहीं जाँच सकता जिनकी आपने अनुमति नहीं दी। इनके लिए कोई साइज़ नहीं दिखता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ne može provjeriti druge aplikacije, sistemske datoteke, sadržaj u oblaku ni mape koje nisi dopustio. Za njih se ne prikazuje veličina."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A GaleriQ nem tudja ellenőrizni más appokat, rendszerfájlokat, felhőtartalmat vagy az általad nem engedélyezett mappákat. Ezekhez nem jelenik meg méret."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ tidak bisa memeriksa app lain, file sistem, konten cloud, atau folder yang belum kamu izinkan. Tidak ada ukuran yang ditampilkan untuk ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ non può controllare altre app, file di sistema, contenuti cloud e cartelle non autorizzate. Per questi non viene mostrata una dimensione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQでは他のアプリ、システムファイル、クラウド上のデータ、許可していないフォルダは確認できません。そのため、これらのサイズは表示しません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ಇತರ ಆ್ಯಪ್‌ಗಳು, ಸಿಸ್ಟಮ್ ಫೈಲ್‌ಗಳು, ಕ್ಲೌಡ್ ವಿಷಯ ಅಥವಾ ನೀವು ಅನುಮತಿಸದ ಫೋಲ್ಡರ್‌ಗಳನ್ನು ಪರಿಶೀಲಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ. ಇವುಗಳಿಗೆ ಯಾವುದೇ ಗಾತ್ರ ತೋರಿಸಲಾಗುವುದಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 앱, 시스템 파일, 클라우드 콘텐츠, 허용하지 않은 폴더는 GaleriQ가 확인할 수 없어요. 이 항목들의 크기는 표시하지 않아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മറ്റ് ആപ്പുകൾ, സിസ്റ്റം ഫയലുകൾ, ക്ലൗഡ് ഉള്ളടക്കം അല്ലെങ്കിൽ നിങ്ങൾ അനുവദിക്കാത്ത ഫോൾഡറുകൾ GaleriQ-ന് പരിശോധിക്കാനാകില്ല. ഇവയ്ക്ക് വലുപ്പം കാണിക്കില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ इतर अ‍ॅप्स, सिस्टम फाइल्स, क्लाउड मजकूर किंवा तुम्ही परवानगी न दिलेले फोल्डर तपासू शकत नाही. त्यांच्यासाठी आकार दाखवला जात नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ tidak dapat menyemak app lain, fail sistem, kandungan awan atau folder yang tidak anda benarkan. Tiada saiz ditunjukkan untuk ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ kan ikke kontrollere andre apper, systemfiler, skyinnhold eller mapper du ikke har tillatt. Ingen størrelse vises for disse."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ kan andere apps, systeembestanden, cloudinhoud en niet-toegestane mappen niet controleren. Daarvoor wordt geen grootte getoond."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ଅନ୍ୟ ଆପ୍, ସିଷ୍ଟମ୍ ଫାଇଲ୍, କ୍ଲାଉଡ୍ ବିଷୟବସ୍ତୁ କିମ୍ବା ଆପଣ ଅନୁମତି ଦେଇନଥିବା ଫୋଲ୍ଡର ଯାଞ୍ଚ କରିପାରିବ ନାହିଁ। ଏଗୁଡ଼ିକ ପାଇଁ କୌଣସି ଆକାର ଦେଖାଯାଏ ନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ਹੋਰ ਐਪਾਂ, ਸਿਸਟਮ ਫ਼ਾਈਲਾਂ, ਕਲਾਊਡ ਸਮੱਗਰੀ ਜਾਂ ਉਹ ਫ਼ੋਲਡਰ ਨਹੀਂ ਜਾਂਚ ਸਕਦਾ ਜਿਨ੍ਹਾਂ ਦੀ ਤੁਸੀਂ ਇਜਾਜ਼ਤ ਨਹੀਂ ਦਿੱਤੀ। ਇਨ੍ਹਾਂ ਲਈ ਕੋਈ ਆਕਾਰ ਨਹੀਂ ਦਿਖਾਇਆ ਜਾਂਦਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ nie może sprawdzać innych aplikacji, plików systemowych, chmury ani folderów bez dostępu. Nie pokazuje dla nich rozmiaru."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O GaleriQ não pode verificar outros apps, arquivos do sistema, conteúdo na nuvem ou pastas que você não permitiu. Nenhum tamanho é mostrado para eles."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O GaleriQ não pode verificar outras apps, ficheiros do sistema, conteúdo na nuvem ou pastas não autorizadas. Não é mostrado um tamanho para estes dados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ nu poate verifica alte aplicații, fișiere de sistem, conținut cloud sau dosare fără acces. Pentru acestea nu afișează o dimensiune."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ не может проверять другие приложения, системные файлы, облачные данные и папки без доступа. Их размер не показывается."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ nemôže skontrolovať iné aplikácie, systémové súbory, obsah v cloude ani priečinky, ktoré ste nepovolili. Pre tie sa veľkosť nezobrazuje."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ne more preveriti drugih aplikacij, sistemskih datotek, vsebine v oblaku ali map, ki jih nisi dovolil. Zanje se velikost ne prikaže."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ kan inte kontrollera andra appar, systemfiler, molninnehåll eller mappar du inte har tillåtit. Ingen storlek visas för dessa."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மற்ற ஆப்கள், சிஸ்டம் கோப்புகள், மேகக்கணி உள்ளடக்கம் அல்லது நீங்கள் அனுமதிக்காத கோப்புறைகளை GaleriQ சரிபார்க்க முடியாது. இவற்றுக்கு அளவு காட்டப்படாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇతర యాప్‌లు, సిస్టమ్ ఫైళ్లు, క్లౌడ్ కంటెంట్ లేదా మీరు అనుమతించని ఫోల్డర్‌లను GaleriQ తనిఖీ చేయలేదు. వీటికి పరిమాణం చూపబడదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ตรวจสอบแอพอื่น ไฟล์ระบบ เนื้อหาบนคลาวด์ หรือโฟลเดอร์ที่คุณไม่ได้อนุญาตไม่ได้ จะไม่แสดงขนาดของสิ่งเหล่านี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ diğer uygulamaları, sistem dosyalarını, bulut içeriğini ve izin verilmeyen klasörleri inceleyemez. Bunlar için boyut gösterilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ не може перевіряти інші застосунки, системні файли, хмарні дані й папки без доступу. Їхній розмір не показується."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ دوسری ایپس، سسٹم فائلیں، کلاؤڈ مواد یا وہ فولڈرز نہیں جانچ سکتا جن کی آپ نے اجازت نہیں دی۔ ان کے لیے کوئی سائز نہیں دکھتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ không thể kiểm tra ứng dụng khác, tệp hệ thống, nội dung đám mây hoặc thư mục bạn chưa cho phép. Không hiển thị kích thước cho những mục này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ 无法检查其他应用、系统文件、云端内容或未授权的文件夹，因此不显示这些内容的大小。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ 無法檢查其他 App、系統檔案、雲端內容或你未允許的檔案夾。這些不會顯示大小。"
          }
        }
      }
    },
