            "value": "Odłóż bez daty"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixar de lado sem data"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pôr de parte sem data"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pune deoparte fără dată"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отложить без даты"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg undan utan datum"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แยกไว้โดยไม่มีวันที่"
          }
        },
