          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Buy once, clean up without ads. No subscription or GaleriQ account."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén keer kopen en opruimen zonder advertenties. Geen abonnement of GaleriQ-account."
