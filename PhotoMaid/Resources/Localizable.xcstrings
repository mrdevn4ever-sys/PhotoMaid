    "backup_save_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحفظ بيانات GaleriQ في ملف صغير: القرارات والألبومات والوسوم والملاحظات وسلة التحديد والعناصر المخفية والإعدادات وسير العمل والإعدادات المسبقة. لا يتضمن الصور."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার GaleriQ ডেটা একটি ছোট ফাইলে সংরক্ষণ করে: সিদ্ধান্ত, অ্যালবাম, ট্যাগ, নোট, নির্বাচন ঝুড়ি, লুকানো আইটেম, সেটিংস, ওয়ার্কফ্লো ও প্রিসেট। কোনো ফটো অন্তর্ভুক্ত থাকে না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Desa les teves dades de GaleriQ en un fitxer petit: decisions, àlbums, etiquetes, notes, cistella de selecció, elements amagats, configuració, fluxos de treball i predefinits. No inclou cap foto."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uloží vaše data GaleriQ do malého souboru: rozhodnutí, alba, štítky, poznámky, výběrový košík, skryté položky, nastavení, postupy a předvolby. Fotky nejsou součástí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemmer dine GaleriQ-data i en lille fil: beslutninger, albummer, tags, noter, udvalgskurv, skjulte emner, indstillinger, arbejdsgange og forudindstillinger. Ingen fotos er inkluderet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichert deine GaleriQ-Daten in eine kleine Datei: Entscheidungen, Alben, Schlagwörter, Notizen, Auswahlkorb, Ausgeblendetes, Einstellungen, Abläufe und Vorlagen. Fotos sind nicht dabei."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αποθηκεύει τα δεδομένα GaleriQ σε ένα μικρό αρχείο: αποφάσεις, άλμπουμ, ετικέτες, σημειώσεις, καλάθι επιλογής, κρυφά στοιχεία, ρυθμίσεις, ροές εργασιών και προεπιλογές. Δεν περιλαμβάνονται φωτογραφίες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves your GaleriQ data in a small file: decisions, albums, tags, notes, selection basket, hidden items, settings, workflows and presets. No photos are included."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda tus datos de GaleriQ en un archivo pequeño: decisiones, álbumes, etiquetas, notas, cesta de selección, elementos ocultos, ajustes, flujos de trabajo y ajustes guardados. No incluye fotos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallentaa GaleriQ-tietosi pieneen tiedostoon: päätökset, albumit, tunnisteet, muistiinpanot, valintakorin, piilotetut kohteet, asetukset, työnkulut ja esiasetukset. Kuvia ei sisällytetä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre vos données GaleriQ dans un petit fichier : décisions, albums, mots-clés, notes, panier de sélection, éléments masqués, réglages, flux de travail et préréglages. Aucune photo n’est incluse."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારો GaleriQ ડેટા એક નાની ફાઇલમાં સાચવે છે: નિર્ણયો, આલ્બમ, ટૅગ, નોંધો, પસંદગીની ટોપલી, છુપાયેલી આઇટમ, સેટિંગ્સ, વર્કફ્લો અને પ્રીસેટ. કોઈ ફોટો સામેલ નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שומר את נתוני GaleriQ שלך בקובץ קטן: החלטות, אלבומים, תגיות, הערות, סל הבחירה, פריטים מוסתרים, הגדרות, תהליכי עבודה והגדרות קבועות. תמונות לא נכללות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका GaleriQ डेटा एक छोटी फ़ाइल में सहेजता है: फ़ैसले, एल्बम, टैग, नोट, चयन टोकरी, छिपे आइटम, सेटिंग्ज़, वर्कफ़्लो और प्रीसेट। कोई फ़ोटो शामिल नहीं होती।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprema tvoje GaleriQ podatke u malu datoteku: odluke, albume, oznake, bilješke, košaricu odabira, skrivene stavke, postavke, tijekove rada i predloške. Fotografije nisu uključene."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A GaleriQ-adataidat egy kis fájlba menti: döntések, albumok, címkék, jegyzetek, válogatókosár, rejtett elemek, beállítások, munkafolyamatok és sablonok. Fotókat nem tartalmaz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyimpan data GaleriQ-mu dalam file kecil: keputusan, album, tag, catatan, keranjang pilihan, item tersembunyi, pengaturan, alur kerja, dan preset. Tidak ada foto yang disertakan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva i tuoi dati di GaleriQ in un piccolo file: decisioni, album, tag, note, cestino di selezione, elementi nascosti, impostazioni, flussi di lavoro e preset. Le foto non sono incluse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQのデータを小さなファイルに保存します：判断、アルバム、タグ、メモ、選択かご、非表示の項目、設定、ワークフロー、プリセット。写真は含まれません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ GaleriQ ಡೇಟಾವನ್ನು ಸಣ್ಣ ಫೈಲ್‌ನಲ್ಲಿ ಉಳಿಸುತ್ತದೆ: ನಿರ್ಧಾರಗಳು, ಆಲ್ಬಮ್‌ಗಳು, ಟ್ಯಾಗ್‌ಗಳು, ಟಿಪ್ಪಣಿಗಳು, ಆಯ್ಕೆ ಬುಟ್ಟಿ, ಮರೆಮಾಡಿದ ಐಟಂಗಳು, ಸೆಟ್ಟಿಂಗ್‌ಗಳು, ವರ್ಕ್‌ಫ್ಲೋಗಳು ಮತ್ತು ಪ್ರಿಸೆಟ್‌ಗಳು. ಯಾವುದೇ ಫೋಟೋಗಳನ್ನು ಸೇರಿಸಲಾಗಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ 데이터를 작은 파일에 저장해요: 결정, 앨범, 태그, 메모, 선택 바구니, 숨긴 항목, 설정, 작업 흐름, 프리셋. 사진은 들어가지 않아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ GaleriQ ഡാറ്റ ഒരു ചെറിയ ഫയലിൽ സംരക്ഷിക്കുന്നു: തീരുമാനങ്ങൾ, ആൽബങ്ങൾ, ടാഗുകൾ, കുറിപ്പുകൾ, തിരഞ്ഞെടുപ്പ് കൊട്ട, മറച്ച ഇനങ്ങൾ, ക്രമീകരണങ്ങൾ, വർക്ക്‌ഫ്ലോകൾ, പ്രീസെറ്റുകൾ. ഫോട്ടോകൾ ഉൾപ്പെടുന്നില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचा GaleriQ डेटा एका छोट्या फाइलमध्ये जतन करते: निर्णय, अल्बम, टॅग, नोंदी, निवड टोपली, लपवलेले आयटम, सेटिंग्ज, वर्कफ्लो आणि प्रीसेट. कोणताही फोटो समाविष्ट नसतो."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyimpan data GaleriQ anda dalam fail kecil: keputusan, album, tag, nota, bakul pilihan, item tersembunyi, seting, aliran kerja dan praset. Tiada foto disertakan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagrer GaleriQ-dataene dine i en liten fil: beslutninger, album, etiketter, notater, utvalgskurv, skjulte elementer, innstillinger, arbeidsflyter og forhåndsinnstillinger. Ingen bilder er med."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Slaat je GaleriQ-gegevens op in een klein bestand: beslissingen, albums, labels, notities, selectiemand, verborgen items, instellingen, werkstromen en voorinstellingen. Er zitten geen foto’s in."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ GaleriQ ଡାଟାକୁ ଏକ ଛୋଟ ଫାଇଲ୍‌ରେ ସେଭ୍ କରେ: ନିଷ୍ପତ୍ତି, ଆଲବମ୍, ଟ୍ୟାଗ୍, ନୋଟ୍, ଚୟନ ଟୋକେଇ, ଲୁଚାଯାଇଥିବା ଆଇଟମ୍, ସେଟିଂସ, ୱାର୍କଫ୍ଲୋ ଓ ପ୍ରିସେଟ୍। କୌଣସି ଫଟୋ ଅନ୍ତର୍ଭୁକ୍ତ ନୁହେଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡਾ GaleriQ ਡਾਟਾ ਇੱਕ ਛੋਟੀ ਫ਼ਾਈਲ ਵਿੱਚ ਸੰਭਾਲਦਾ ਹੈ: ਫ਼ੈਸਲੇ, ਐਲਬਮਾਂ, ਟੈਗ, ਨੋਟ, ਚੋਣ ਟੋਕਰੀ, ਲੁਕਾਈਆਂ ਆਈਟਮਾਂ, ਸੈਟਿੰਗਾਂ, ਵਰਕਫ਼ਲੋ ਅਤੇ ਪ੍ਰੀਸੈੱਟ। ਕੋਈ ਫ਼ੋਟੋ ਸ਼ਾਮਲ ਨਹੀਂ ਹੁੰਦੀ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisuje dane GaleriQ w małym pliku: decyzje, albumy, tagi, notatki, koszyk wyboru, ukryte elementy, ustawienia, przepływy pracy i ustawienia filtrów. Bez zdjęć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva seus dados do GaleriQ num pequeno arquivo: decisões, álbuns, etiquetas, notas, cesta de seleção, itens ocultos, ajustes, fluxos e predefinições. Nenhuma foto é incluída."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda os seus dados do GaleriQ num ficheiro pequeno: decisões, álbuns, etiquetas, notas, cesto de seleção, itens ocultos, definições, fluxos de trabalho e predefinições. Não inclui fotos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvează datele GaleriQ într-un fișier mic: decizii, albume, etichete, note, coș de selecție, elemente ascunse, setări, fluxuri de lucru și presetări. Fotografiile nu sunt incluse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняет данные GaleriQ в небольшой файл: решения, альбомы, метки, заметки, корзину выбора, скрытое, настройки, сценарии и пресеты. Фото в него не входят."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Uloží vaše údaje GaleriQ do malého súboru: rozhodnutia, albumy, štítky, poznámky, výberový košík, skryté položky, nastavenia, postupy a predvoľby. Fotky nie sú súčasťou."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Shrani tvoje podatke GaleriQ v majhno datoteko: odločitve, albume, oznake, zapiske, košarico izbora, skrite elemente, nastavitve, poteke dela in prednastavitve. Fotografije niso vključene."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparar dina GaleriQ-data i en liten fil: beslut, album, taggar, anteckningar, urvalskorg, dolda objekt, inställningar, arbetsflöden och förinställningar. Inga bilder ingår."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் GaleriQ தரவை ஒரு சிறிய கோப்பில் சேமிக்கிறது: முடிவுகள், ஆல்பங்கள், குறிச்சொற்கள், குறிப்புகள், தேர்வுக் கூடை, மறைக்கப்பட்டவை, அமைப்புகள், பணிப்பாய்வுகள், முன்னமைவுகள். புகைப்படங்கள் எதுவும் சேர்க்கப்படாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ GaleriQ డేటాను ఒక చిన్న ఫైల్‌లో సేవ్ చేస్తుంది: నిర్ణయాలు, ఆల్బమ్‌లు, ట్యాగ్‌లు, నోట్‌లు, ఎంపిక బుట్ట, దాచినవి, సెట్టింగ్‌లు, వర్క్‌ఫ్లోలు, ప్రీసెట్‌లు. ఫోటోలు ఏవీ చేర్చబడవు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกข้อมูล GaleriQ ของคุณเป็นไฟล์เล็กๆ: การตัดสินใจ อัลบั้ม แท็ก โน้ต ตะกร้ารายการที่เลือก รายการที่ซ่อน การตั้งค่า เวิร์กโฟลว์ และค่าที่ตั้งไว้ ไม่มีรูปภาพรวมอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ verilerini küçük bir dosyaya kaydeder: kararlar, albümler, etiketler, notlar, seçim sepeti, gizlenen öğeler, ayarlar, iş akışları ve hazır ayarlar. Fotoğraflar dahil değildir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберігає дані GaleriQ у невеликий файл: рішення, альбоми, мітки, нотатки, кошик вибору, приховане, налаштування, сценарії та пресети. Фото до нього не входять."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا GaleriQ ڈیٹا ایک چھوٹی فائل میں محفوظ کرتا ہے: فیصلے، البمز، ٹیگز، نوٹس، انتخاب کی ٹوکری، چھپے آئٹمز، ترتیبات، ورک فلوز اور پری سیٹس۔ کوئی تصویر شامل نہیں ہوتی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu dữ liệu GaleriQ của bạn trong một tệp nhỏ: quyết định, album, thẻ, ghi chú, giỏ chọn, mục ẩn, cài đặt, quy trình và mẫu cài sẵn. Không bao gồm ảnh nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将你的 GaleriQ 数据保存到一个小文件中：决定、相册、标签、备注、选择篮、隐藏项、设置、工作流程和预设。不包含照片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將你的 GaleriQ 資料存成一個小檔案：決定、相簿、標籤、備註、選擇籃、隱藏項目、設定、工作流程和預設。不包含任何照片。"
          }
        }
      }
    },
