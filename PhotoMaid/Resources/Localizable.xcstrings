    "onb_offer_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب ورتّب بلا حدود، مع إعلانات من حين لآخر. إزالة العناصر لها حد يومي."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সীমা ছাড়া সোয়াইপ করুন ও গুছিয়ে নিন, মাঝে মাঝে বিজ্ঞাপনসহ। আইটেম সরানোর দৈনিক সীমা আছে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Llisca i organitza sense límits, amb algun anunci. Eliminar elements té un límit diari."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přejíždějte a třiďte bez omezení, s občasnými reklamami. Odstraňování položek má denní limit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe og organisér uden grænser, med lejlighedsvise reklamer. Fjernelse har en daglig grænse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wische und sortiere unbegrenzt, mit gelegentlicher Werbung. Für das Entfernen gilt ein Tageslimit."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σάρωσε και οργάνωσε χωρίς όρια, με περιστασιακές διαφημίσεις. Η αφαίρεση στοιχείων έχει ημερήσιο όριο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe and organize without limits, with occasional ads. Removing items has a daily limit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza y organiza sin límite, con anuncios ocasionales. Quitar elementos tiene un límite diario."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pyyhkäise ja järjestä rajattomasti, satunnaisten mainosten kera. Kohteiden poistamisella on päiväraja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais défiler et organise sans limite, avec quelques publicités. Le retrait d’éléments est limité par jour."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "મર્યાદા વિના સ્વાઇપ કરો અને ગોઠવો, ક્યારેક જાહેરાતો સાથે. આઇટમ દૂર કરવાની દૈનિક મર્યાદા છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "להחליק ולסדר בלי הגבלה, עם פרסומות מדי פעם. להסרת פריטים יש מגבלה יומית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बिना सीमा स्वाइप और व्यवस्थित करें, कभी-कभार विज्ञापनों के साथ। आइटम हटाने की रोज़ की सीमा है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Povlači i organiziraj bez ograničenja, uz povremene oglase. Uklanjanje stavki ima dnevno ograničenje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzz és rendszerezz korlátlanul, időnként hirdetésekkel. Az elemek eltávolításának napi korlátja van."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Geser dan rapikan tanpa batas, dengan iklan sesekali. Menghapus item punya batas harian."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri e organizza senza limiti, con pubblicità occasionali. La rimozione ha un limite giornaliero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スワイプと整理は無制限で、ときどき広告が表示されます。削除には1日の上限があります。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮಿತಿಯಿಲ್ಲದೆ ಸ್ವೈಪ್ ಮಾಡಿ ಮತ್ತು ವ್ಯವಸ್ಥಿತಗೊಳಿಸಿ, ಆಗಾಗ ಜಾಹೀರಾತುಗಳೊಂದಿಗೆ. ಐಟಂಗಳನ್ನು ತೆಗೆದುಹಾಕಲು ದೈನಂದಿನ ಮಿತಿ ಇದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가끔 광고가 표시되며, 스와이프와 정리는 무제한이에요. 항목 삭제에는 하루 한도가 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പരിധിയില്ലാതെ സ്വൈപ്പ് ചെയ്യുകയും ക്രമീകരിക്കുകയും ചെയ്യുക, ഇടയ്ക്കിടെ പരസ്യങ്ങളോടെ. ഇനങ്ങൾ നീക്കം ചെയ്യുന്നതിന് ദൈനംദിന പരിധിയുണ്ട്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मर्यादेशिवाय स्वाइप करा आणि व्यवस्थित करा, अधूनमधून जाहिरातींसह. आयटम काढण्याला दैनिक मर्यादा आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Leret dan susun tanpa had, dengan iklan sekali-sekala. Membuang item mempunyai had harian."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sveip og organiser uten grenser, med annonser av og til. Fjerning har en daglig grense."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Veeg en orden onbeperkt, met af en toe een advertentie. Voor verwijderen geldt een daglimiet."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସୀମା ବିନା ସ୍ୱାଇପ୍ ଓ ସଜାଣି କରନ୍ତୁ, ବେଳେବେଳେ ବିଜ୍ଞାପନ ସହ। ଆଇଟମ୍ ହଟାଇବାର ଦୈନିକ ସୀମା ଅଛି।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਬਿਨਾਂ ਸੀਮਾ ਸਵਾਈਪ ਅਤੇ ਵਿਵਸਥਿਤ ਕਰੋ, ਕਦੇ-ਕਦਾਈਂ ਇਸ਼ਤਿਹਾਰਾਂ ਨਾਲ। ਆਈਟਮਾਂ ਹਟਾਉਣ ਦੀ ਰੋਜ਼ਾਨਾ ਸੀਮਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeglądaj i porządkuj bez limitu, z reklamami od czasu do czasu. Usuwanie ma limit dzienny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslize e organize sem limites, com anúncios ocasionais. Remover itens tem um limite diário."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza e organiza sem limites, com anúncios ocasionais. A remoção de itens tem um limite diário."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Glisează și organizează fără limită, cu reclame ocazionale. Eliminarea are o limită zilnică."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Листай и упорядочивай без ограничений, с рекламой время от времени. Для удаления действует дневной лимит."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Potiahajte a triedte bez obmedzení, s občasnými reklamami. Odstraňovanie položiek má denný limit."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podrsaj in urejaj brez omejitev, z občasnimi oglasi. Odstranjevanje elementov ima dnevno omejitev."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Svep och sortera utan gränser, med annonser ibland. Borttagning har en daglig gräns."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வரம்பின்றி ஸ்வைப் செய்து ஒழுங்குபடுத்துங்கள், அவ்வப்போது விளம்பரங்களுடன். உருப்படிகளை அகற்றுவதற்குத் தினசரி வரம்பு உண்டு."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పరిమితి లేకుండా స్వైప్ చేసి సర్దుకోండి, అప్పుడప్పుడు ప్రకటనలతో. అంశాలను తీసివేయడానికి రోజువారీ పరిమితి ఉంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปัดและจัดระเบียบได้ไม่จำกัด มีโฆษณาเป็นครั้งคราว การนำออกมีขีดจำกัดรายวัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ara sıra reklamlarla sınırsız kaydır ve düzenle. Kaldırma işlemi için günlük sınır vardır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гортай і впорядковуй без обмежень, із рекламою час від часу. Для видалення діє денний ліміт."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بغیر حد سوائپ اور ترتیب دیں، کبھی کبھار اشتہارات کے ساتھ۔ آئٹمز ہٹانے کی روزانہ حد ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuốt và sắp xếp không giới hạn, thỉnh thoảng có quảng cáo. Việc xóa có giới hạn hằng ngày."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "滑动和整理不限次数，偶尔会显示广告。移除内容有每日上限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無限制地滑動和整理，偶爾會有廣告。移除項目有每日上限。"
          }
        }
      }
    },
