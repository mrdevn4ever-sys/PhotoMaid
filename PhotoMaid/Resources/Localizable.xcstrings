    "tour_settings_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضبط GaleriQ كما تحب واعثر على الإجابات هنا. يمكنك إعادة هذه الجولة في أي وقت."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ নিজের মতো করে নিন এবং এখানে উত্তর খুঁজুন। এই ট্যুর যেকোনো সময় আবার নিতে পারেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Personalitza GaleriQ i troba-hi respostes. Pots tornar a fer aquest recorregut quan vulguis."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přizpůsobte si GaleriQ a najděte tu odpovědi. Tuto prohlídku můžete kdykoli zopakovat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gør GaleriQ til dit eget, og find svar her. Du kan tage rundvisningen igen når som helst."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier stellst du GaleriQ nach deinem Geschmack ein und findest Antworten. Diesen Rundgang kannst du dort jederzeit wiederholen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάνε το GaleriQ δικό σου και βρες απαντήσεις εδώ. Μπορείς να κάνεις ξανά αυτή την ξενάγηση οποτεδήποτε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make GaleriQ your own and find answers here. You can take this tour again at any time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura GaleriQ a tu gusto y encuentra respuestas. Puedes repetir este recorrido cuando quieras."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tee GaleriQ:sta omasi ja löydä vastauksia täältä. Voit katsoa tämän esittelyn uudelleen milloin tahansa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglez GaleriQ à votre goût et trouvez des réponses. Vous pouvez refaire cette visite à tout moment."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ને તમારું બનાવો અને અહીં જવાબો મેળવો. તમે આ ટૂર ગમે ત્યારે ફરી લઈ શકો છો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר להתאים את GaleriQ אישית ולמצוא כאן תשובות. אפשר לחזור על הסיור הזה בכל עת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ को अपना बनाएँ और यहाँ जवाब पाएँ। आप यह टूर कभी भी फिर ले सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prilagodi GaleriQ sebi i ovdje pronađi odgovore. Ovaj obilazak možeš ponoviti u bilo kojem trenutku."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szabd testre a GaleriQ-t, és itt találsz válaszokat. Ezt a bemutatót bármikor újra megnézheted."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Atur GaleriQ sesuai keinginanmu dan temukan jawaban di sini. Kamu bisa mengikuti tur ini lagi kapan saja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta GaleriQ come preferisci e trova risposte. Puoi ripetere questa guida in qualsiasi momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ を好みに合わせて設定し、答えを探せます。このツアーはいつでももう一度見られます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ಅನ್ನು ನಿಮ್ಮದಾಗಿಸಿಕೊಳ್ಳಿ ಮತ್ತು ಇಲ್ಲಿ ಉತ್ತರಗಳನ್ನು ಹುಡುಕಿ. ಈ ಪ್ರವಾಸವನ್ನು ಯಾವಾಗ ಬೇಕಾದರೂ ಮತ್ತೆ ಮಾಡಬಹುದು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ를 원하는 대로 설정하고 답을 찾아보세요. 이 둘러보기는 언제든 다시 볼 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ നിങ്ങളുടേതാക്കുക, ഇവിടെ ഉത്തരങ്ങൾ കണ്ടെത്തുക. ഈ ടൂർ എപ്പോൾ വേണമെങ്കിലും വീണ്ടും എടുക്കാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ तुमच्या पद्धतीने वापरा आणि इथे उत्तरे मिळवा. ही टूर तुम्ही कधीही पुन्हा घेऊ शकता."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jadikan GaleriQ milik anda dan cari jawapan di sini. Anda boleh mengikuti lawatan ini semula bila-bila masa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjør GaleriQ til ditt eget og finn svar her. Du kan ta omvisningen igjen når som helst."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel GaleriQ naar wens in en vind antwoorden. Deze rondleiding kun je altijd opnieuw bekijken."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQକୁ ନିଜ ଭଳି କରନ୍ତୁ ଏବଂ ଏଠାରେ ଉତ୍ତର ଖୋଜନ୍ତୁ। ଏହି ଟୁର୍ ଯେକୌଣସି ସମୟରେ ପୁଣି ନେଇପାରିବେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ਨੂੰ ਆਪਣੇ ਮੁਤਾਬਕ ਬਣਾਓ ਅਤੇ ਇੱਥੇ ਜਵਾਬ ਲੱਭੋ। ਤੁਸੀਂ ਇਹ ਟੂਰ ਕਦੇ ਵੀ ਦੁਬਾਰਾ ਲੈ ਸਕਦੇ ਹੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostosuj GaleriQ do siebie i znajdź odpowiedzi. Ten przewodnik możesz obejrzeć ponownie w każdej chwili."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe o GaleriQ do seu jeito e encontre respostas aqui. Você pode fazer este tour de novo a qualquer momento."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste o GaleriQ ao seu gosto e encontre respostas. Pode repetir esta visita a qualquer momento."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Setează GaleriQ după gustul tău și găsește răspunsuri. Poți relua oricând acest tur."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройте GaleriQ под себя и найдите ответы. Этот обзор можно повторить в любое время."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prispôsobte si GaleriQ a nájdite tu odpovede. Túto prehliadku môžete kedykoľvek zopakovať."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prilagodi GaleriQ po svoje in tukaj najdi odgovore. Ta ogled lahko kadar koli ponoviš."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gör GaleriQ till ditt eget och hitta svar här. Du kan ta den här rundturen igen när som helst."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ-ஐ உங்களுக்கேற்ப மாற்றி, இங்கே பதில்களைக் கண்டறியுங்கள். இந்தச் சுற்றுலாவை எப்போது வேண்டுமானாலும் மீண்டும் பார்க்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQను మీకు నచ్చినట్లు మార్చుకోండి, ఇక్కడ సమాధానాలు కనుగొనండి. ఈ టూర్‌ను ఎప్పుడైనా మళ్లీ చేయవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปรับ GaleriQ ให้เป็นแบบของคุณและหาคำตอบได้ที่นี่ คุณดูการแนะนำนี้อีกครั้งได้ทุกเมื่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ’i zevkine göre ayarla ve yanıtları bul. Bu turu istediğin zaman tekrarlayabilirsin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Налаштуйте GaleriQ під себе й знайдіть відповіді. Цей огляд можна повторити будь-коли."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ کو اپنا بنائیں اور یہاں جوابات پائیں۔ آپ یہ ٹور کسی بھی وقت دوبارہ لے سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Biến GaleriQ thành của riêng bạn và tìm câu trả lời ở đây. Bạn có thể xem lại hướng dẫn này bất cứ lúc nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按你的喜好设置 GaleriQ，并找到答案。你可以随时重新查看这个导览。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓 GaleriQ 更符合你的習慣，也可以在這裡找到解答。你隨時可以重新觀看這個導覽。"
          }
        }
      }
    },
