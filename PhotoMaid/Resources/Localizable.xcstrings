    "edit_compare_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصورة المعدلة. المس مع الاستمرار لرؤية الأصل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সম্পাদিত ফটো। মূলটি দেখতে স্পর্শ করে ধরে রাখুন।"
          }
        },
        "ca": {
          "stringUnit": {
