    "edit_hint_hdr": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لهذه الصورة إضاءة شديدة السطوع (HDR). بعد تغيير الألوان يقلّ سطوعها قليلًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "This photo has extra-bright highlights (HDR). After colour changes it shines a little less."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Foto hat besonders helle Lichter (HDR). Nach Farbänderungen leuchtet es etwas weniger stark."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This photo has extra-bright highlights (HDR). After colour changes it shines a little less."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta foto tiene luces muy brillantes (HDR). Tras cambiar los colores brillará un poco menos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette photo a des hautes lumières très vives (HDR). Après des changements de couleur, elle brille un peu moins."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "This photo has extra-bright highlights (HDR). After colour changes it shines a little less."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa foto ha luci molto brillanti (HDR). Dopo le modifiche al colore brillerà un po’ meno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この写真は特に明るい部分（HDR）があります。色を変更すると輝きが少し弱くなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사진은 아주 밝은 부분(HDR)이 있어요. 색을 바꾸면 조금 덜 빛나요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "This photo has extra-bright highlights (HDR). After colour changes it shines a little less."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze foto heeft extra heldere lichten (HDR). Na kleurwijzigingen straalt hij iets minder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To zdjęcie ma szczególnie jasne światła (HDR). Po zmianie kolorów będzie świecić nieco słabiej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "This photo has extra-bright highlights (HDR). After colour changes it shines a little less."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta foto tem luzes muito intensas (HDR). Depois de alterar as cores, brilha um pouco menos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această fotografie are lumini foarte strălucitoare (HDR). După modificarea culorilor strălucește puțin mai slab."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом фото особенно яркие света (HDR). После изменения цвета оно будет сиять чуть слабее."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "This photo has extra-bright highlights (HDR). After colour changes it shines a little less."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "This photo has extra-bright highlights (HDR). After colour changes it shines a little less."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu fotoğrafın ışıkları çok parlak (HDR). Renk değişikliklerinden sonra biraz daha az parlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На цьому фото особливо яскраві світла (HDR). Після зміни кольорів воно сяятиме трохи слабше."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "This photo has extra-bright highlights (HDR). After colour changes it shines a little less."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这张照片的高光特别明亮（HDR）。调整颜色后会稍微暗一些。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "This photo has extra-bright highlights (HDR). After colour changes it shines a little less."
          }
        }
      }
    },
    "edit_hint_heic": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحفظ بصيغة JPEG ليعمل في كل مكان – لا يستطيع هذا الجهاز حفظ HEIC بشكل موثوق."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Saved as JPEG so it works everywhere – this device can’t reliably save HEIC."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird als JPEG gespeichert, damit es überall funktioniert – HEIC kann dieses Gerät nicht zuverlässig speichern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved as JPEG so it works everywhere – this device can’t reliably save HEIC."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
