    "vault2_delete_forever_warning": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُحذف المحتوى نهائيًا من هذه الخزنة. لن تتغير النسخ الخارجية والاحتياطية الحالية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি নির্বাচিত বিষয়বস্তু এই ভল্ট থেকে স্থায়ীভাবে সরিয়ে দেয়। বিদ্যমান বাইরের কপি ও ব্যাকআপ অপরিবর্তিত থাকে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Això elimina definitivament el contingut seleccionat d’aquesta caixa forta. Les còpies externes i les còpies de seguretat existents no canvien."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tímto se vybraný obsah z tohoto trezoru trvale odstraní. Stávající externí kopie a zálohy zůstanou beze změny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette fjerner det valgte indhold permanent fra boksen. Eksisterende eksterne kopier og sikkerhedskopier er uændrede."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies entfernt den ausgewählten Inhalt unwiderruflich aus diesem Tresor. Vorhandene externe Kopien und Backups bleiben unverändert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό αφαιρεί οριστικά το επιλεγμένο περιεχόμενο από αυτό το θησαυροφυλάκιο. Τα υπάρχοντα εξωτερικά αντίγραφα και αντίγραφα ασφαλείας δεν αλλάζουν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently removes the selected content from this vault. Existing external copies and backups are unchanged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminará permanentemente el contenido de esta caja fuerte. Las copias externas y de seguridad no cambiarán."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä poistaa valitun sisällön tästä holvista pysyvästi. Olemassa olevat ulkoiset kopiot ja varmuuskopiot pysyvät ennallaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contenu sélectionné sera définitivement supprimé de ce coffre. Les copies externes et sauvegardes existantes restent inchangées."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આનાથી પસંદ કરેલી સામગ્રી આ વૉલ્ટમાંથી કાયમ માટે દૂર થાય છે. હાલની બાહ્ય નકલો અને બૅકઅપ બદલાતાં નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולה זו מסירה לצמיתות את התוכן שנבחר מהכספת הזו. עותקים חיצוניים וגיבויים קיימים לא משתנים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे चुनी गई सामग्री इस तिजोरी से स्थायी रूप से हट जाती है। मौजूदा बाहरी कॉपी और बैकअप नहीं बदलते।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo trajno uklanja odabrani sadržaj iz ovog trezora. Postojeće vanjske kopije i sigurnosne kopije ostaju nepromijenjene."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez véglegesen eltávolítja a kijelölt tartalmat ebből a széfből. A meglévő külső másolatok és biztonsági mentések változatlanok maradnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini menghapus konten terpilih dari brankas ini secara permanen. Salinan eksternal dan cadangan yang ada tidak berubah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il contenuto selezionato sarà eliminato definitivamente da questa cassaforte. Copie esterne e backup restano invariati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した内容をこの保管庫から完全に削除します。既存の外部コピーやバックアップは変更されません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇದು ಆಯ್ಕೆಮಾಡಿದ ವಿಷಯವನ್ನು ಈ ವಾಲ್ಟ್‌ನಿಂದ ಶಾಶ್ವತವಾಗಿ ತೆಗೆದುಹಾಕುತ್ತದೆ. ಅಸ್ತಿತ್ವದಲ್ಲಿರುವ ಬಾಹ್ಯ ಪ್ರತಿಗಳು ಮತ್ತು ಬ್ಯಾಕಪ್‌ಗಳು ಬದಲಾಗುವುದಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 내용이 이 보관함에서 영구 삭제됩니다. 기존 외부 사본과 백업은 변경되지 않습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇത് തിരഞ്ഞെടുത്ത ഉള്ളടക്കം ഈ വോൾട്ടിൽ നിന്ന് ശാശ്വതമായി നീക്കം ചെയ്യുന്നു. നിലവിലുള്ള ബാഹ്യ പകർപ്പുകൾക്കും ബാക്കപ്പുകൾക്കും മാറ്റമില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "यामुळे निवडलेला मजकूर या व्हॉल्टमधून कायमचा काढला जातो. सध्याच्या बाह्य प्रती आणि बॅकअप बदलत नाहीत."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini membuang kandungan yang dipilih daripada peti besi ini secara kekal. Salinan luaran dan sandaran sedia ada tidak berubah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette fjerner det valgte innholdet permanent fra safen. Eksisterende eksterne kopier og sikkerhetskopier er uendret."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit verwijdert de inhoud definitief uit deze kluis. Externe kopieën en back-ups blijven ongewijzigd."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହା ବଛାଯାଇଥିବା ବିଷୟବସ୍ତୁକୁ ଏହି ଭଲ୍ଟରୁ ସ୍ଥାୟୀ ଭାବେ ହଟାଏ। ବିଦ୍ୟମାନ ବାହ୍ୟ କପି ଓ ବ୍ୟାକଅପ୍ ଅପରିବର୍ତ୍ତିତ ରହେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਚੁਣੀ ਸਮੱਗਰੀ ਨੂੰ ਇਸ ਵੌਲਟ ਤੋਂ ਪੱਕੇ ਤੌਰ ’ਤੇ ਹਟਾ ਦਿੰਦਾ ਹੈ। ਮੌਜੂਦਾ ਬਾਹਰੀ ਕਾਪੀਆਂ ਅਤੇ ਬੈਕਅੱਪ ਬਿਨਾਂ ਬਦਲੇ ਰਹਿੰਦੇ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zawartość zostanie trwale usunięta z tego sejfu. Zewnętrzne kopie i kopie zapasowe pozostaną bez zmian."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso remove permanentemente o conteúdo selecionado deste cofre. Cópias externas e backups existentes não são alterados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O conteúdo será apagado permanentemente deste cofre. Cópias externas e de segurança ficam inalteradas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conținutul va fi șters definitiv din acest seif. Copiile externe și de siguranță rămân neschimbate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Содержимое будет удалено из этого сейфа навсегда. Внешние и резервные копии останутся без изменений."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Týmto sa vybraný obsah z tohto trezoru natrvalo odstráni. Existujúce externé kópie a zálohy zostanú bez zmeny."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "S tem se izbrana vsebina trajno odstrani iz tega sefa. Obstoječe zunanje kopije in varnostne kopije ostanejo nespremenjene."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta tar bort det markerade innehållet permanent från valvet. Befintliga externa kopior och säkerhetskopior är oförändrade."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இது தேர்ந்தெடுத்த உள்ளடக்கத்தை இந்த லாக்கரிலிருந்து நிரந்தரமாக அகற்றும். ஏற்கனவே உள்ள வெளிப்புற நகல்களும் காப்புப்பிரதிகளும் மாறாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇది ఎంచుకున్న కంటెంట్‌ను ఈ వాల్ట్ నుండి శాశ్వతంగా తీసివేస్తుంది. ఇప్పటికే ఉన్న బయటి కాపీలు, బ్యాకప్‌లు మారవు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การดำเนินการนี้จะลบเนื้อหาที่เลือกออกจากตู้เซฟอย่างถาวร สำเนาภายนอกและข้อมูลสำรองที่มีอยู่ไม่เปลี่ยนแปลง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen içerik bu kasadan kalıcı olarak silinir. Mevcut dış kopyalar ve yedekler değişmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вміст буде видалено з цього сховища назавжди. Зовнішні й резервні копії залишаться без змін."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس سے منتخب مواد اس والٹ سے مستقل طور پر ہٹ جاتا ہے۔ موجودہ بیرونی کاپیاں اور بیک اپ تبدیل نہیں ہوتے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này xóa vĩnh viễn nội dung đã chọn khỏi két sắt. Bản sao bên ngoài và bản sao lưu hiện có không thay đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将从此保险库永久删除所选内容。现有外部副本和备份保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會從此保險箱中永久移除所選內容。現有的外部副本和備份保持不變。"
          }
        }
      }
    },
