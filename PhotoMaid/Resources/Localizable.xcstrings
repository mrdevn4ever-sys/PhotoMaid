    "edit_err_save": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر حفظ التعديل. الأصل لم يتغير."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bearbeitung konnte nicht gespeichert werden. Das Original ist unverändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t save the edit. The original is unchanged."
