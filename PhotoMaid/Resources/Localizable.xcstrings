    "history_empty": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر اختياراتك هنا عندما تبدأ التنظيف."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine valg vises her, når du begynder at rydde op."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier siehst du deine Entscheidungen, sobald du mit dem Aufräumen beginnst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your choices appear here once you start cleaning up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus decisiones aparecen aquí cuando empiezas a limpiar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes choix apparaissent ici dès que tu commences le tri."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilihanmu muncul di sini setelah kamu mulai merapikan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue scelte appaiono qui quando inizi a riordinare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "整理を始めると、選んだ操作がここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정리를 시작하면 선택한 내용이 여기에 표시돼요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgene dine vises her når du begynner å rydde."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je keuzes verschijnen hier zodra je begint met opruimen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje wybory pojawią się tutaj, gdy zaczniesz porządki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas escolhas aparecem aqui quando você começar a limpar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As tuas escolhas aparecem aqui quando começares a limpar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alegerile tale apar aici după ce începi curățenia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твои решения появятся здесь, как только начнёшь уборку."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina val visas här när du börjar rensa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเลือกของคุณจะปรากฏที่นี่เมื่อคุณเริ่มจัดระเบียบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temizliğe başladığında seçimlerin burada görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут з’являться твої рішення, щойно почнеш прибирання."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lựa chọn của bạn sẽ hiện ở đây khi bạn bắt đầu dọn dẹp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始清理后，你的选择会记录在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開始整理後，你的選擇會顯示在這裡。"
