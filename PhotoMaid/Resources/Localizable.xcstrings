    "error_cloud_folder": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر مجلدًا محفوظًا على هذا الـ iPhone. المجلدات الموجودة في السحابة فقط غير مدعومة هنا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই iPhone-এ রাখা একটি ফোল্ডার বেছে নিন। শুধু ক্লাউডে থাকা ফোল্ডার এখানে সমর্থিত নয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tria una carpeta desada en aquest iPhone. Aquí no es poden fer servir carpetes que només són al núvol."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte složku uloženou v tomto iPhonu. Složky, které jsou jen v cloudu, tu nejsou podporované."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg en mappe, der ligger på denne iPhone. Mapper, der kun findes i skyen, understøttes ikke her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Ordner, der auf diesem iPhone gespeichert ist. Ordner, die nur in der Cloud liegen, werden hier nicht unterstützt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επίλεξε φάκελο αποθηκευμένο σε αυτό το iPhone. Φάκελοι που υπάρχουν μόνο στο cloud δεν υποστηρίζονται εδώ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a folder stored on this iPhone. Folders that are only in the cloud aren’t supported here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una carpeta guardada en este iPhone. Aquí no se admiten carpetas que solo estén en la nube."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse tähän iPhoneen tallennettu kansio. Vain pilvessä olevia kansioita ei tueta tässä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un dossier stocké sur cet iPhone. Les dossiers uniquement dans le cloud ne sont pas pris en charge ici."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ iPhone પર સાચવેલું ફોલ્ડર પસંદ કરો. ફક્ત ક્લાઉડમાં હોય તેવાં ફોલ્ડર અહીં ચાલતાં નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לבחור תיקייה שמאוחסנת ב-iPhone הזה. תיקיות שנמצאות רק בענן לא נתמכות כאן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस iPhone पर सहेजा गया फ़ोल्डर चुनें। सिर्फ़ क्लाउड में मौजूद फ़ोल्डर यहाँ काम नहीं करते।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberi mapu spremljenu na ovom iPhoneu. Mape koje su samo u oblaku ovdje nisu podržane."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válassz egy ezen az iPhone-on tárolt mappát. A csak felhőben lévő mappák itt nem támogatottak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih folder yang tersimpan di iPhone ini. Folder yang hanya ada di cloud tidak didukung di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una cartella salvata su questo iPhone. Le cartelle presenti solo nel cloud non sono supportate qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPhoneに保存されているフォルダを選んでください。クラウドにしかないフォルダはここでは使えません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ iPhone ನಲ್ಲಿ ಸಂಗ್ರಹಿಸಿದ ಫೋಲ್ಡರ್ ಆಯ್ಕೆಮಾಡಿ. ಕ್ಲೌಡ್‌ನಲ್ಲಿ ಮಾತ್ರ ಇರುವ ಫೋಲ್ಡರ್‌ಗಳು ಇಲ್ಲಿ ಬೆಂಬಲಿತವಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone에 저장된 폴더를 선택하세요. 클라우드에만 있는 폴더는 여기서 지원되지 않습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ iPhone-ൽ സംഭരിച്ച ഒരു ഫോൾഡർ തിരഞ്ഞെടുക്കുക. ക്ലൗഡിൽ മാത്രമുള്ള ഫോൾഡറുകൾ ഇവിടെ പിന്തുണയ്ക്കില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या iPhone वर जतन केलेला फोल्डर निवडा. फक्त क्लाउडमध्ये असलेले फोल्डर इथे चालत नाहीत."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih folder yang disimpan pada iPhone ini. Folder yang hanya berada dalam awan tidak disokong di sini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg en mappe som ligger på denne iPhonen. Mapper som bare finnes i skyen, støttes ikke her."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een map die op deze iPhone staat. Mappen die alleen in de cloud staan, worden hier niet ondersteund."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହି iPhoneରେ ଷ୍ଟୋର୍ ହୋଇଥିବା ଏକ ଫୋଲ୍ଡର ବାଛନ୍ତୁ। କେବଳ କ୍ଲାଉଡ୍‌ରେ ଥିବା ଫୋଲ୍ଡର ଏଠାରେ ସମର୍ଥିତ ନୁହେଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ iPhone ਉੱਤੇ ਸਟੋਰ ਕੀਤਾ ਫ਼ੋਲਡਰ ਚੁਣੋ। ਜੋ ਫ਼ੋਲਡਰ ਸਿਰਫ਼ ਕਲਾਊਡ ਵਿੱਚ ਹਨ, ਉਹ ਇੱਥੇ ਸਮਰਥਿਤ ਨਹੀਂ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz folder zapisany na tym iPhonie. Foldery tylko w chmurze nie są tu obsługiwane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma pasta armazenada neste iPhone. Pastas que estão só na nuvem não são compatíveis aqui."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma pasta guardada neste iPhone. Pastas que estão apenas na nuvem não são suportadas aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege un dosar salvat pe acest iPhone. Dosarele aflate doar în cloud nu sunt acceptate aici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите папку, сохранённую на этом iPhone. Папки только в облаке здесь не поддерживаются."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte priečinok uložený v tomto iPhone. Priečinky, ktoré sú len v cloude, tu nie sú podporované."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izberi mapo, shranjeno v tem iPhonu. Mape, ki so samo v oblaku, tukaj niso podprte."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj en mapp som finns på den här iPhonen. Mappar som bara finns i molnet stöds inte här."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த iPhone-இல் சேமிக்கப்பட்ட கோப்புறையைத் தேர்ந்தெடுங்கள். மேகக்கணியில் மட்டும் உள்ள கோப்புறைகள் இங்கே ஆதரிக்கப்படாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ iPhoneలో నిల్వ ఉన్న ఫోల్డర్‌ను ఎంచుకోండి. క్లౌడ్‌లో మాత్రమే ఉన్న ఫోల్డర్‌లకు ఇక్కడ మద్దతు లేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกโฟลเดอร์ที่จัดเก็บบน iPhone เครื่องนี้ โฟลเดอร์ที่อยู่บนคลาวด์เท่านั้นไม่รองรับที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu iPhone’da saklanan bir klasör seç. Yalnızca bulutta olan klasörler burada desteklenmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть папку, збережену на цьому iPhone. Папки лише в хмарі тут не підтримуються."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس iPhone پر محفوظ فولڈر منتخب کریں۔ صرف کلاؤڈ میں موجود فولڈرز یہاں کام نہیں کرتے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn thư mục được lưu trên iPhone này. Thư mục chỉ có trên đám mây không được hỗ trợ ở đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择存储在此 iPhone 上的文件夹。此处不支持仅存在于云端的文件夹。"
