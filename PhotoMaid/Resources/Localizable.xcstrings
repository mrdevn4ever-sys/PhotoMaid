    "ach_local_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبقى كل شيء على هذا الـ iPhone. للإيقاف: الإعدادات › عرض الإنجازات."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt bliver på denne iPhone. Slå fra: Indstillinger › Vis præstationer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles bleibt auf diesem iPhone. Abschalten: Einstellungen › Erfolge anzeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything stays on this iPhone. To turn it off: Settings › Show achievements."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo se queda en este iPhone. Para desactivarlo: Ajustes › Mostrar logros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout reste sur cet iPhone. Pour désactiver : Paramètres › Afficher les succès."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semuanya tetap di iPhone ini. Untuk mematikan: Pengaturan › Tampilkan pencapaian."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto resta su questo iPhone. Per disattivare: Impostazioni › Mostra traguardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてこのiPhone内に保存されます。オフにするには：設定 › 実績を表示"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 정보는 이 iPhone에만 있어요. 끄려면: 설정 › 업적 표시"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt blir på denne iPhonen. Slå av: Innstillinger › Vis prestasjoner."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles blijft op deze iPhone. Uitzetten: Instellingen › Prestaties tonen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko zostaje na tym iPhonie. Wyłączanie: Ustawienia › Pokazuj osiągnięcia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo fica neste iPhone. Para desativar: Ajustes › Mostrar conquistas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo fica neste iPhone. Para desativar: Definições › Mostrar conquistas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Totul rămâne pe acest iPhone. Dezactivare: Setări › Afișează realizările."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё остаётся на этом iPhone. Отключить: Настройки › Показывать достижения."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Allt stannar på den här iPhonen. Stäng av: Inställningar › Visa prestationer."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกอย่างอยู่บน iPhone เครื่องนี้ หากต้องการปิด: การตั้งค่า › แสดงความสำเร็จ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her şey bu iPhone’da kalır. Kapatmak için: Ayarlar › Başarıları göster."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе залишається на цьому iPhone. Вимкнути: Налаштування › Показувати досягнення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi thứ chỉ ở trên iPhone này. Để tắt: Cài đặt › Hiện thành tích."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有数据都保存在这台 iPhone 上。关闭：设置 › 显示成就。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一切都只留在這部 iPhone 上。若要關閉：設定 › 顯示成就。"
          }
        }
      }
    },
