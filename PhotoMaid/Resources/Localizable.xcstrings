    "snake_swipe_intro": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اجمع الصور وأطل شريطك. العب بملء الشاشة بالسحب."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Collect pictures and grow your photo strip. Play full screen by swiping."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sammle Bilder und verlängere deinen Fotostreifen. Spiele bildschirmfüllend mit Wischgesten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Collect pictures and grow your photo strip. Play full screen by swiping."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recoge imágenes y alarga tu tira de fotos. Juega a pantalla completa deslizando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collectez des images pour allonger votre bande photo. Jouez en plein écran par balayages."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Collect pictures and grow your photo strip. Play full screen by swiping."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Raccogli immagini e allunga la tua striscia di foto. Gioca a tutto schermo scorrendo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真を集めてフォトストリップを伸ばしましょう。全画面でスワイプして遊べます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진을 모아 포토 스트립을 늘려 보세요. 전체 화면에서 밀어서 플레이하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Collect pictures and grow your photo strip. Play full screen by swiping."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verzamel foto's en laat je fotostrook groeien. Speel met veegbewegingen op het hele scherm."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbieraj zdjęcia i wydłużaj pasek. Graj na pełnym ekranie, przesuwając palcem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Collect pictures and grow your photo strip. Play full screen by swiping."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Recolhe imagens e aumenta a tua tira de fotos. Joga em ecrã inteiro com deslizes."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adună imagini și mărește banda foto. Joacă pe tot ecranul prin glisări."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Собирайте снимки и растите фотоленту. Играйте на весь экран смахиваниями."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Collect pictures and grow your photo strip. Play full screen by swiping."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Collect pictures and grow your photo strip. Play full screen by swiping."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraf topla ve fotoğraf şeridini büyüt. Tam ekranda kaydırarak oyna."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збирайте знімки й подовжуйте фотострічку. Грайте на весь екран рухами пальця."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Collect pictures and grow your photo strip. Play full screen by swiping."
          }
        },
        "zh-Hans": {
