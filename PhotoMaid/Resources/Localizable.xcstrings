    "storage_b_footer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقطات الشاشة محسوبة ضمن الصور. لا تُحسب الملفات الكبيرة والنسخ المكررة مرة أخرى. تُستثنى الأحجام غير المعروفة من الإجمالي، ويُشار إليه حينها بعبارة «على الأقل»."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্ক্রিনশট আগে থেকেই ফটোতে অন্তর্ভুক্ত। বড় ফাইল ও ডুপ্লিকেট আবার গোনা হয় না। অজানা আকার মোট থেকে বাদ থাকে, এবং তখন মোটকে “অন্তত” দিয়ে চিহ্নিত করা হয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les captures de pantalla ja s’inclouen a les fotos. Els fitxers grans i els duplicats no es tornen a comptar. Les mides desconegudes queden fora del total, que llavors es marca amb «Com a mínim»."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Snímky obrazovky už jsou zahrnuté ve fotkách. Velké soubory a duplicity se nepočítají znovu. Neznámé velikosti se do součtu nezapočítají a součet je pak označen „Nejméně“."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skærmbilleder er allerede med i fotos. Store filer og dubletter tælles ikke igen. Ukendte størrelser udelades af summen, som så markeres med “Mindst”."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Screenshots sind bereits bei den Fotos enthalten. Große Dateien und Duplikate werden nicht zusätzlich gezählt. Unbekannte Größen fehlen in der Summe; dann steht dort „mind.“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα στιγμιότυπα οθόνης περιλαμβάνονται ήδη στις φωτογραφίες. Τα μεγάλα αρχεία και τα διπλότυπα δεν μετρώνται ξανά. Τα άγνωστα μεγέθη μένουν εκτός συνόλου, το οποίο τότε σημειώνεται «Τουλάχιστον»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screenshots are already included in photos. Large files and duplicates aren’t counted again. Unknown sizes are left out of the total, which is then marked “At least”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las capturas de pantalla ya se incluyen en las fotos. Los archivos grandes y duplicados no se cuentan de nuevo. Los tamaños desconocidos se excluyen del total, que entonces indica «Al menos»."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvakaappaukset sisältyvät jo kuviin. Suuria tiedostoja ja kaksoiskappaleita ei lasketa uudelleen. Tuntemattomat koot jätetään pois kokonaismäärästä, joka merkitään silloin ”Vähintään”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les captures d’écran sont déjà comptées parmi les photos. Les gros fichiers et doublons ne sont pas comptés une deuxième fois. Les tailles inconnues sont exclues du total, qui porte alors la mention « Au moins »."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સ્ક્રીનશૉટ પહેલેથી ફોટામાં સામેલ છે. મોટી ફાઇલો અને ડુપ્લિકેટ ફરી ગણાતાં નથી. અજાણ કદ કુલમાંથી બાકાત રહે છે, અને ત્યારે કુલ પર “ઓછામાં ઓછું” લખાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "צילומי מסך כבר כלולים בתמונות. קבצים גדולים וכפילויות לא נספרים שוב. גדלים לא ידועים לא נכללים בסכום, ואז הוא מסומן „לפחות”."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्क्रीनशॉट पहले से फ़ोटो में शामिल हैं। बड़ी फ़ाइलें और डुप्लिकेट दोबारा नहीं गिने जाते। अज्ञात साइज़ कुल से बाहर रहते हैं, और तब कुल पर “कम से कम” लिखा होता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Snimke zaslona već su uključene u fotografije. Velike datoteke i duplikati ne broje se ponovno. Nepoznate veličine izostavljaju se iz ukupnog iznosa, koji se tada označava s „Najmanje”."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A képernyőképek már benne vannak a fotókban. A nagy fájlokat és az ismétlődéseket nem számoljuk újra. Az ismeretlen méretek kimaradnak az összegből, amely ekkor „Legalább” jelölést kap."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tangkapan layar sudah termasuk dalam foto. File besar dan duplikat tidak dihitung lagi. Ukuran yang tidak diketahui tidak masuk total, yang kemudian ditandai “Setidaknya”."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli screenshot sono già inclusi nelle foto. I file grandi e i duplicati non vengono contati di nuovo. Le dimensioni sconosciute sono escluse dal totale, che in quel caso indica «Almeno»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクリーンショットは写真に含まれます。大きなファイルや重複ファイルは二重に数えません。サイズ不明のものは合計から除き、その場合は「少なくとも」と表示します。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ಕ್ರೀನ್‌ಶಾಟ್‌ಗಳು ಈಗಾಗಲೇ ಫೋಟೋಗಳಲ್ಲಿ ಸೇರಿವೆ. ದೊಡ್ಡ ಫೈಲ್‌ಗಳು ಮತ್ತು ನಕಲುಗಳನ್ನು ಮತ್ತೆ ಎಣಿಸಲಾಗುವುದಿಲ್ಲ. ಅಜ್ಞಾತ ಗಾತ್ರಗಳನ್ನು ಒಟ್ಟಿನಿಂದ ಬಿಡಲಾಗುತ್ತದೆ, ಆಗ ಒಟ್ಟನ್ನು “ಕನಿಷ್ಠ” ಎಂದು ಗುರುತಿಸಲಾಗುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크린샷은 사진에 이미 포함돼요. 큰 파일과 중복 파일을 다시 합산하지 않아요. 크기를 알 수 없는 항목은 합계에서 제외하고 ‘최소’로 표시해요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്ക്രീൻഷോട്ടുകൾ ഇതിനകം ഫോട്ടോകളിൽ ഉൾപ്പെടുന്നു. വലിയ ഫയലുകളും ഡ്യൂപ്ലിക്കേറ്റുകളും വീണ്ടും എണ്ണില്ല. അജ്ഞാത വലുപ്പങ്ങൾ ആകെയിൽ നിന്ന് ഒഴിവാക്കും, തുടർന്ന് ആകെയെ “കുറഞ്ഞത്” എന്ന് അടയാളപ്പെടുത്തും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "स्क्रीनशॉट आधीच फोटोंमध्ये समाविष्ट आहेत. मोठ्या फाइल्स आणि डुप्लिकेट पुन्हा मोजले जात नाहीत. अज्ञात आकार एकूणमधून वगळले जातात, आणि मग एकूणवर “किमान” लिहिले जाते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Syot layar sudah termasuk dalam foto. Fail besar dan pendua tidak dikira semula. Saiz yang tidak diketahui tidak dimasukkan dalam jumlah, yang kemudian ditandakan “Sekurang-kurangnya”."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjermbilder er allerede med i bilder. Store filer og duplikater telles ikke igjen. Ukjente størrelser utelates fra summen, som da merkes med «Minst»."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schermafbeeldingen zijn al meegeteld bij foto’s. Grote bestanden en duplicaten worden niet opnieuw geteld. Onbekende groottes ontbreken in het totaal; dan staat er ‘Minstens’."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସ୍କ୍ରିନସଟ୍ ପୂର୍ବରୁ ଫଟୋରେ ଅନ୍ତର୍ଭୁକ୍ତ। ବଡ଼ ଫାଇଲ୍ ଓ ଡୁପ୍ଲିକେଟ୍ ପୁଣି ଗଣାଯାଏ ନାହିଁ। ଅଜଣା ଆକାର ମୋଟରୁ ବାଦ ଦିଆଯାଏ, ଏବଂ ତାପରେ ମୋଟକୁ “ଅନ୍ତତଃ” ଭାବେ ଚିହ୍ନିତ କରାଯାଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਕ੍ਰੀਨਸ਼ਾਟ ਪਹਿਲਾਂ ਹੀ ਫ਼ੋਟੋਆਂ ਵਿੱਚ ਸ਼ਾਮਲ ਹਨ। ਵੱਡੀਆਂ ਫ਼ਾਈਲਾਂ ਅਤੇ ਡੁਪਲੀਕੇਟ ਦੁਬਾਰਾ ਨਹੀਂ ਗਿਣੇ ਜਾਂਦੇ। ਅਗਿਆਤ ਆਕਾਰ ਕੁੱਲ ਤੋਂ ਬਾਹਰ ਰਹਿੰਦੇ ਹਨ, ਜਿਸ ਨੂੰ ਫਿਰ “ਘੱਟੋ-ਘੱਟ” ਨਾਲ ਨਿਸ਼ਾਨਿਤ ਕੀਤਾ ਜਾਂਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zrzuty ekranu są już uwzględnione w zdjęciach. Duże pliki i duplikaty nie są liczone ponownie. Nieznane rozmiary są pomijane w sumie, która wtedy ma oznaczenie „Co najmniej”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As capturas de tela já estão incluídas nas fotos. Arquivos grandes e duplicatas não são contados de novo. Tamanhos desconhecidos ficam fora do total, que então é marcado como “Pelo menos”."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As capturas de ecrã já estão incluídas nas fotos. Os ficheiros grandes e duplicados não são contados novamente. Os tamanhos desconhecidos ficam fora do total, que passa a indicar «Pelo menos»."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Capturile de ecran sunt deja incluse în fotografii. Fișierele mari și duplicatele nu sunt numărate din nou. Dimensiunile necunoscute sunt omise din total, care atunci este marcat „Cel puțin”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скриншоты уже учтены в фотографиях. Большие файлы и дубликаты не считаются повторно. Неизвестные размеры не включаются в сумму — тогда рядом указано «Не менее»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Snímky obrazovky sú už zahrnuté vo fotkách. Veľké súbory a duplicity sa nepočítajú znova. Neznáme veľkosti sa do súčtu nezapočítajú a súčet je potom označený „Najmenej“."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaslonske slike so že vključene v fotografije. Velike datoteke in dvojniki se ne štejejo znova. Neznane velikosti so izpuščene iz seštevka, ki je nato označen z »Vsaj«."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skärmavbilder ingår redan i bilder. Stora filer och dubbletter räknas inte igen. Okända storlekar utelämnas ur summan, som då markeras med ”Minst”."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஸ்கிரீன்ஷாட்கள் ஏற்கனவே புகைப்படங்களில் அடங்கும். பெரிய கோப்புகளும் நகல்களும் மீண்டும் கணக்கிடப்படாது. தெரியாத அளவுகள் மொத்தத்திலிருந்து விடுபடும், அப்போது மொத்தம் “குறைந்தது” எனக் குறிக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "స్క్రీన్‌షాట్‌లు ఇప్పటికే ఫోటోలలో చేరి ఉన్నాయి. పెద్ద ఫైళ్లు, నకళ్లు మళ్లీ లెక్కించబడవు. తెలియని పరిమాణాలు మొత్తం నుండి వదిలేయబడతాయి, అప్పుడు మొత్తం “కనీసం”గా గుర్తించబడుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ภาพหน้าจอรวมอยู่ในรูปภาพแล้ว ไฟล์ขนาดใหญ่และรายการซ้ำจะไม่นับซ้ำ ขนาดที่ไม่ทราบจะไม่รวมในยอดรวม ซึ่งจะถูกระบุว่า “อย่างน้อย”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran görüntüleri zaten fotoğraflara dâhildir. Büyük dosyalar ve kopyalar yeniden sayılmaz. Bilinmeyen boyutlar toplama katılmaz; bu durumda “En az” gösterilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Знімки екрана вже враховано серед фото. Великі файли й дублікати не рахуються повторно. Невідомі розміри не входять у суму — тоді біля неї стоїть «Щонайменше»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اسکرین شاٹس پہلے سے تصاویر میں شامل ہیں۔ بڑی فائلیں اور ڈپلیکیٹس دوبارہ نہیں گنے جاتے۔ نامعلوم سائز کل سے باہر رہتے ہیں، اور تب کل پر ”کم از کم“ لکھا ہوتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh chụp màn hình đã được tính trong ảnh. Tệp lớn và mục trùng lặp không được tính lại. Kích thước không rõ không được tính vào tổng, khi đó tổng được ghi là “Ít nhất”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "截图已计入照片。大文件和重复文件不会重复累计。大小未知的内容不计入总大小，此时会标注“至少”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "截圖已包含在照片中。大型檔案和重複項目不會重複計算。大小未知的項目不計入總數，總數會標示為「至少」。"
          }
        }
      }
    },
