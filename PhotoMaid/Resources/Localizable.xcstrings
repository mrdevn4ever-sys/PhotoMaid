    "help_free_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العرض والسحب والحفظ لوقت لاحق بلا حدود. من دون Pro، يمكنك إزالة ما يصل إلى %1$lld يوميًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
