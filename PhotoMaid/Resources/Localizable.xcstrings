        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आयटम व्हॉल्टमध्येच राहतात, फक्त फोल्डरशिवाय."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Item kekal dalam peti besi, cuma tanpa folder."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Elementene blir i safen, bare uten mappe."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De onderdelen blijven in de kluis, alleen zonder map."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆଇଟମ୍ ଭଲ୍ଟରେ ହିଁ ରହେ, କେବଳ ଫୋଲ୍ଡର ବିନା।"
