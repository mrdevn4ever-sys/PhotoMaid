    "systrash_delete_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ثم أكِّد لدى Android. لا يمكن استعادة الصور والفيديوهات المحذوفة نهائيًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätige anschließend bei Android. Endgültig gelöschte Fotos und Videos lassen sich nicht wiederherstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Then confirm with Android. Permanently deleted photos and videos cannot be restored."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después confirma en Android. Las fotos y vídeos eliminados definitivamente no se pueden recuperar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmez ensuite auprès d’Android. Les photos et vidéos supprimées définitivement ne peuvent pas être restaurées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Poi conferma con Android. Foto e video eliminati definitivamente non si possono recuperare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続けてAndroidで確認します。完全に削除した写真と動画は復元できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이어서 Android에서 확인하세요. 영구 삭제한 사진과 동영상은 복원할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevestig daarna bij Android. Definitief verwijderde foto’s en video’s zijn niet terug te halen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Następnie potwierdź w Androidzie. Trwale usuniętych zdjęć i filmów nie da się przywrócić."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois confirme no Android. Fotos e vídeos eliminados definitivamente não podem ser recuperados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apoi confirmă în Android. Fotografiile și videoclipurile șterse definitiv nu pot fi recuperate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Затем подтвердите в Android. Удалённые навсегда фото и видео восстановить нельзя."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ardından Android’de onayla. Kalıcı olarak silinen fotoğraf ve videolar geri yüklenemez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Потім підтвердьте в Android. Назавжди видалені фото й відео відновити не можна."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随后请在 Android 中确认。永久删除的照片和视频无法恢复。"
          }
        }
      }
    },
    "systrash_empty_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر هنا الصور والفيديوهات التي تزيلها لفترة ويمكن استعادتها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernte Fotos und Videos erscheinen hier eine Zeit lang und lassen sich zurückholen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos and videos you remove appear here for a while and can be restored."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos y vídeos que quitas aparecen aquí durante un tiempo y se pueden recuperar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos et vidéos retirées apparaissent ici un moment et peuvent être restaurées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le foto e i video rimossi compaiono qui per un po’ e si possono recuperare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除した写真や動画はしばらくここに表示され、復元できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제거한 사진과 동영상이 한동안 여기에 표시되며 복원할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijderde foto’s en video’s staan hier een tijdje en zijn terug te halen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunięte zdjęcia i filmy pojawiają się tu na jakiś czas i można je przywrócić."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As fotos e vídeos removidos aparecem aqui durante algum tempo e podem ser recuperados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografiile și videoclipurile eliminate apar aici o vreme și pot fi recuperate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалённые фото и видео какое-то время находятся здесь, их можно восстановить."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaldırdığın fotoğraf ve videolar bir süre burada görünür ve geri yüklenebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видалені фото й відео деякий час є тут, їх можна відновити."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除的照片和视频会在此保留一段时间，可以恢复。"
          }
        }
      }
    },
    "systrash_empty_title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
