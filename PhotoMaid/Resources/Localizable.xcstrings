    "dup_explain": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعثر على صور وفيديوهات وملفات متطابقة المحتوى تمامًا. أنت تختار النسخ التي تنتقل إلى سلة المهملات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "হুবহু একই বিষয়বস্তুর ফটো, ভিডিও ও ফাইল খুঁজুন। কোন কপিগুলো ট্র্যাশে যাবে তা আপনি বেছে নেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Troba fotos, vídeos i fitxers amb exactament el mateix contingut. Tu tries quines còpies van a la paperera."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Najděte fotky, videa a soubory s naprosto stejným obsahem. Vy vyberete, které kopie půjdou do koše."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Find fotos, videoer og filer med præcis samme indhold. Du vælger, hvilke kopier der havner i papirkurven."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finde Fotos, Videos und Dateien mit genau gleichem Inhalt. Du entscheidest, welche Kopien in den Papierkorb kommen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βρες φωτογραφίες, βίντεο και αρχεία με ακριβώς το ίδιο περιεχόμενο. Εσύ επιλέγεις ποια αντίγραφα πάνε στον κάδο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find photos, videos and files with exactly the same content. You choose which copies go to the trash."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra fotos, vídeos y archivos con el mismo contenido exacto. Tú eliges qué copias van a la papelera."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Etsi kuvat, videot ja tiedostot, joiden sisältö on täsmälleen sama. Sinä valitset, mitkä kopiot menevät roskakoriin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouve des photos, vidéos et fichiers au contenu exactement identique. Tu choisis les copies à mettre à la corbeille."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બરાબર સરખી સામગ્રીવાળા ફોટા, વીડિયો અને ફાઇલો શોધો. કઈ નકલો ટ્રેશમાં જાય તે તમે પસંદ કરો છો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "למצוא תמונות, סרטונים וקבצים עם תוכן זהה לחלוטין. הבחירה אילו עותקים עוברים לפח היא שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बिल्कुल एक जैसी सामग्री वाली फ़ोटो, वीडियो और फ़ाइलें ढूँढें। कौन-सी कॉपी ट्रैश में जाएँ, यह आप चुनते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pronađi fotografije, videozapise i datoteke potpuno istog sadržaja. Ti biraš koje kopije idu u smeće."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Keresd meg a pontosan azonos tartalmú fotókat, videókat és fájlokat. Te választod ki, melyik másolat kerül a kukába."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Temukan foto, video, dan file dengan isi yang persis sama. Kamu yang memilih salinan mana yang masuk ke sampah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trova foto, video e file con lo stesso identico contenuto. Decidi tu quali copie mettere nel cestino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内容が完全に同じ写真、動画、ファイルを探します。どのコピーをゴミ箱に入れるかは自分で選べます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಂಪೂರ್ಣ ಒಂದೇ ವಿಷಯವಿರುವ ಫೋಟೋಗಳು, ವೀಡಿಯೊಗಳು ಮತ್ತು ಫೈಲ್‌ಗಳನ್ನು ಹುಡುಕಿ. ಯಾವ ಪ್ರತಿಗಳು ಕಸದ ಬುಟ್ಟಿಗೆ ಹೋಗಬೇಕು ಎಂದು ನೀವು ಆಯ್ಕೆಮಾಡುತ್ತೀರಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내용이 완전히 같은 사진, 동영상, 파일을 찾아요. 어떤 사본을 휴지통에 넣을지는 직접 선택해요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരേ ഉള്ളടക്കമുള്ള ഫോട്ടോകളും വീഡിയോകളും ഫയലുകളും കണ്ടെത്തുക. ഏത് പകർപ്പുകൾ ട്രാഷിലേക്ക് പോകണമെന്ന് നിങ്ങൾ തിരഞ്ഞെടുക്കുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अगदी एकसारखा मजकूर असलेले फोटो, व्हिडिओ आणि फाइल्स शोधा. कोणत्या प्रती ट्रॅशमध्ये जातील ते तुम्ही निवडता."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cari foto, video dan fail dengan kandungan yang betul-betul sama. Anda pilih salinan mana yang masuk ke sampah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Finn bilder, videoer og filer med nøyaktig samme innhold. Du velger hvilke kopier som havner i papirkurven."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vind foto’s, video’s en bestanden met precies dezelfde inhoud. Je bepaalt zelf welke kopieën naar de prullenbak gaan."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଠିକ୍ ସମାନ ବିଷୟବସ୍ତୁ ଥିବା ଫଟୋ, ଭିଡିଓ ଓ ଫାଇଲ୍ ଖୋଜନ୍ତୁ। କେଉଁ କପି ଟ୍ରାସକୁ ଯିବ ଆପଣ ବାଛନ୍ତି।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਬਿਲਕੁਲ ਇੱਕੋ ਜਿਹੀ ਸਮੱਗਰੀ ਵਾਲੀਆਂ ਫ਼ੋਟੋਆਂ, ਵੀਡੀਓ ਅਤੇ ਫ਼ਾਈਲਾਂ ਲੱਭੋ। ਕਿਹੜੀਆਂ ਕਾਪੀਆਂ ਰੱਦੀ ਵਿੱਚ ਜਾਣ, ਇਹ ਤੁਸੀਂ ਚੁਣਦੇ ਹੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znajdź zdjęcia, filmy i pliki o dokładnie tej samej zawartości. Ty wybierasz, które kopie trafią do kosza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontre fotos, vídeos e arquivos com exatamente o mesmo conteúdo. Você escolhe quais cópias vão para a lixeira."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontra fotos, vídeos e ficheiros com exatamente o mesmo conteúdo. Escolhes as cópias que vão para o lixo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Găsește fotografii, videoclipuri și fișiere cu exact același conținut. Tu alegi ce copii ajung în coș."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Найди фото, видео и файлы с полностью одинаковым содержимым. Ты решаешь, какие копии попадут в корзину."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nájdite fotky, videá a súbory s úplne rovnakým obsahom. Vy vyberiete, ktoré kópie pôjdu do koša."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poišči fotografije, videoposnetke in datoteke s popolnoma enako vsebino. Ti izbereš, katere kopije gredo v koš."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hitta bilder, videor och filer med exakt samma innehåll. Du väljer vilka kopior som hamnar i papperskorgen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரே உள்ளடக்கம் கொண்ட புகைப்படங்கள், வீடியோக்கள், கோப்புகளைக் கண்டறியுங்கள். எந்த நகல்கள் குப்பைக்குச் செல்ல வேண்டும் என்பதை நீங்கள் தேர்ந்தெடுக்கிறீர்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఖచ్చితంగా ఒకే కంటెంట్ ఉన్న ఫోటోలు, వీడియోలు, ఫైళ్లను కనుగొనండి. ఏ కాపీలు ట్రాష్‌కి వెళ్లాలో మీరే ఎంచుకుంటారు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค้นหารูปภาพ วิดีโอ และไฟล์ที่มีเนื้อหาเหมือนกันทุกประการ คุณเลือกว่าจะให้สำเนาไหนไปถังขยะ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçeriği birebir aynı fotoğraf, video ve dosyaları bul. Hangi kopyaların çöp kutusuna gideceğine sen karar verirsin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Знайди фото, відео й файли з точно однаковим вмістом. Ти вирішуєш, які копії потраплять у кошик."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بالکل یکساں مواد والی تصاویر، ویڈیوز اور فائلیں تلاش کریں۔ کون سی کاپیاں ردی میں جائیں، یہ آپ منتخب کرتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tìm ảnh, video và tệp có nội dung giống hệt nhau. Bạn chọn bản sao nào vào thùng rác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查找内容完全相同的照片、视频和文件。由你决定把哪些副本放入回收站。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找出內容完全相同的照片、影片和檔案。由你選擇哪些副本移到垃圾桶。"
          }
        }
      }
