    "vid_remove_audio_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يُكتب مسار الصوت في الملف إطلاقًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tonspur wird gar nicht in die Datei geschrieben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sound track is not written into the file at all."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pista de sonido no se escribe en el archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La piste son n’est pas du tout écrite dans le fichier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La traccia audio non viene scritta nel file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声トラックはファイルに書き込まれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소리 트랙이 파일에 아예 기록되지 않아요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het geluidsspoor wordt helemaal niet in het bestand geschreven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ścieżka dźwiękowa w ogóle nie trafia do pliku."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A faixa de som não é escrita no ficheiro."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pista audio nu este scrisă deloc în fișier."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звуковая дорожка вообще не записывается в файл."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses kanalı dosyaya hiç yazılmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Звукова доріжка взагалі не записується у файл."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音轨完全不会写入文件。"
          }
        }
      }
    },
    "vid_speed_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُسرَّع الصوت أو يُبطَّأ مع الحفاظ على طبقته."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ton wird mit gleicher Tonhöhe schneller oder langsamer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sound is sped up or slowed down with the same pitch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sonido se acelera o ralentiza sin cambiar el tono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le son est accéléré ou ralenti sans changer de hauteur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio viene accelerato o rallentato mantenendo l’intonazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声は音程を保ったまま速く・遅くなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소리는 음높이를 유지한 채 빨라지거나 느려져요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het geluid wordt sneller of langzamer met dezelfde toonhoogte."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dźwięk przyspiesza lub zwalnia bez zmiany wysokości."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O som fica mais rápido ou lento sem mudar o tom."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunetul se accelerează sau încetinește fără să-și schimbe tonalitatea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звук ускоряется или замедляется без изменения высоты."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses, perdesi değişmeden hızlanır veya yavaşlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Звук пришвидшується чи сповільнюється без зміни висоти."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "声音会变快或变慢，音调保持不变。"
          }
        }
      }
    },
