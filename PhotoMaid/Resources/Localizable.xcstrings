    "edit_trim_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب المقابض لتحديد البداية والنهاية. المدة الكلية %1$@. تبقى جودة الصورة كما هي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieh an den Griffen, um Anfang und Ende festzulegen. Gesamtlänge %1$@. Die Bildqualität bleibt erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag the handles to set the start and end. Total length %1$@. The picture quality stays the same."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra los tiradores para elegir el inicio y el final. Duración total %1$@. La calidad de imagen no cambia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser les poignées pour choisir le début et la fin. Durée totale %1$@. La qualité d’image reste la même."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina le maniglie per scegliere inizio e fine. Durata totale %1$@. La qualità dell’immagine resta invariata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハンドルをドラッグして始まりと終わりを決めます。全体の長さ %1$@。画質はそのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "핸들을 끌어 시작과 끝을 정하세요. 전체 길이 %1$@. 화질은 그대로예요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep aan de grepen om begin en einde te kiezen. Totale lengte %1$@. De beeldkwaliteit blijft gelijk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij uchwyty, aby wybrać początek i koniec. Łączna długość %1$@. Jakość obrazu się nie zmienia."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste as pegas para definir o início e o fim. Duração total %1$@. A qualidade da imagem mantém-se."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trage de mânere pentru a alege începutul și sfârșitul. Durată totală %1$@. Calitatea imaginii rămâne aceeași."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Потяните за ручки, чтобы выбрать начало и конец. Общая длина %1$@. Качество изображения не меняется."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlangıcı ve bitişi seçmek için tutamaçları sürükle. Toplam süre %1$@. Görüntü kalitesi aynı kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Потягніть ручки, щоб вибрати початок і кінець. Загальна довжина %1$@. Якість зображення не змінюється."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动手柄设置开头和结尾。总时长 %1$@。画质保持不变。"
          }
        }
      }
    },
