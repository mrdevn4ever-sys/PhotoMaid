    "privacy_purchases": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتم المشتريات عبر App Store من Apple. لا يرسل GaleriQ صورك أو أسماءها أو بياناتها الوصفية."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Køb sker via Apples App Store. GaleriQ sender aldrig dine fotos, navne eller metadata i den forbindelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Käufe laufen über Apples App Store. GaleriQ überträgt dafür nie Fotos, Namen oder Metadaten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Purchases use Apple’s App Store. GaleriQ never sends your photos, names or metadata for this."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las compras usan el App Store de Apple. GaleriQ nunca envía tus fotos, nombres ni metadatos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les achats passent par l’App Store d’Apple. GaleriQ n’envoie jamais vos photos, noms ou métadonnées."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembelian memakai App Store milik Apple. GaleriQ tidak pernah mengirim foto, nama, atau metadata untuk ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli acquisti usano l’App Store di Apple. GaleriQ non invia mai foto, nomi o metadati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入にはAppleのApp Storeを使用します。GaleriQが写真、名前、メタデータを送信することはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매는 Apple App Store를 사용합니다. GaleriQ는 사진, 이름 또는 메타데이터를 전송하지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjøp skjer via Apples App Store. GaleriQ sender aldri bildene, navnene eller metadataene dine i den forbindelse."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aankopen lopen via Apples App Store. GaleriQ verstuurt hiervoor nooit foto’s, namen of metadata."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakupy odbywają się przez App Store Apple. GaleriQ nigdy nie wysyła zdjęć, nazw ani metadanych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As compras usam a App Store da Apple. O GaleriQ nunca envia suas fotos, nomes ou metadados para isso."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As compras usam a App Store da Apple. O GaleriQ nunca envia fotografias, nomes ou metadados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Achizițiile folosesc App Store Apple. GaleriQ nu trimite niciodată poze, nume sau metadate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покупки проходят через App Store Apple. GaleriQ никогда не отправляет фотографии, имена или метаданные."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Köp sker via Apples App Store. GaleriQ skickar aldrig dina bilder, namn eller metadata för detta."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การซื้อใช้ App Store ของ Apple GaleriQ ไม่เคยส่งรูปภาพ ชื่อ หรือข้อมูลเมตาของคุณเพื่อการนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satın alımlar Apple App Store üzerinden yapılır. GaleriQ fotoğraf, ad veya meta veri göndermez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Покупки здійснюються через App Store Apple. GaleriQ ніколи не надсилає фото, назви чи метадані."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc mua dùng App Store của Apple. GaleriQ không bao giờ gửi ảnh, tên hay siêu dữ liệu của bạn cho việc này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "购买通过 Apple App Store 完成。GaleriQ 绝不会为此发送照片、名称或元数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "購買透過 Apple 的 App Store 進行。GaleriQ 從不會為此傳送你的照片、名稱或後設資料。"
          }
        }
      }
    },
    "privacy_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يطّلع GaleriQ على صورك ومقاطع الفيديو والملفات المسموح بها على جهازك فقط. لا تحتاج إلى حساب، ولا يوجد خادم لـ GaleriQ. من المفيد أن تعرف: مع الخدمات السحابية مثل صور Google قد يختفي ما تحذفه من أجهزتك الأخرى أيضًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ser kun på dine fotos, videoer og tilladte filer på din enhed. Du behøver ingen konto, og der er ingen GaleriQ-server. Godt at vide: med skytjenester som Google Fotos kan det, du sletter, også forsvinde på dine andre enheder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ sieht sich deine Fotos, Videos und freigegebenen Dateien nur auf deinem Gerät an. Du brauchst kein Konto, und es gibt keinen GaleriQ-Server. Gut zu wissen: Bei Cloud-Diensten wie Google Fotos kann Gelöschtes auch auf deinen anderen Geräten verschwinden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ looks at your photos, videos and allowed files only on your device. You don’t need an account, and there’s no GaleriQ server. Good to know: with cloud services like Google Photos, things you delete may also disappear on your other devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ mira tus fotos, vídeos y archivos permitidos solo en tu dispositivo. No necesitas cuenta y no hay servidor de GaleriQ. Ten en cuenta que con servicios en la nube como Google Fotos lo que borres puede desaparecer también en tus otros dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ consulte vos photos, vidéos et fichiers autorisés uniquement sur votre appareil. Pas besoin de compte, et il n’y a pas de serveur GaleriQ. Bon à savoir : avec des services cloud comme Google Photos, ce que vous supprimez peut aussi disparaître de vos autres appareils."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ melihat foto, video, dan file yang diizinkan hanya di perangkatmu. Kamu tidak perlu akun, dan tidak ada server GaleriQ. Perlu diketahui: dengan layanan cloud seperti Google Foto, yang kamu hapus mungkin juga hilang di perangkatmu yang lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ guarda foto, video e file consentiti solo sul tuo dispositivo. Non serve un account e non esiste un server GaleriQ. Buono a sapersi: con servizi cloud come Google Foto ciò che elimini può sparire anche sugli altri dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ は写真・動画・許可したファイルを端末の中だけで扱います。アカウントは不要で、GaleriQ のサーバーもありません。なお、Google フォトなどのクラウドでは、削除したものがほかの端末からも消えることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ는 사진, 동영상, 허용한 파일을 기기 안에서만 봐요. 계정이 필요 없고 GaleriQ 서버도 없어요. 참고: Google 포토 같은 클라우드에서는 지운 것이 다른 기기에서도 사라질 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ser på bildene, videoene og de tillatte filene dine bare på enheten din. Du trenger ingen konto, og det finnes ingen GaleriQ-server. Greit å vite: med skytjenester som Google Foto kan det du sletter, også forsvinne på de andre enhetene dine."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ bekijkt je foto’s, video’s en toegestane bestanden alleen op je apparaat. Je hebt geen account nodig en er is geen GaleriQ-server. Goed om te weten: bij clouddiensten zoals Google Foto kan wat je verwijdert ook op je andere apparaten verdwijnen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ przegląda zdjęcia, filmy i dozwolone pliki tylko na Twoim urządzeniu. Nie potrzebujesz konta i nie ma serwera GaleriQ. Warto wiedzieć: w usługach chmurowych, takich jak Zdjęcia Google, usunięte rzeczy mogą zniknąć też z innych urządzeń."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O GaleriQ analisa suas fotos, vídeos e arquivos permitidos só no seu aparelho. Você não precisa de conta e não há servidor do GaleriQ. Bom saber: com serviços de nuvem como o Google Fotos, o que você apagar também pode sumir nos seus outros aparelhos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O GaleriQ vê as suas fotos, vídeos e ficheiros permitidos apenas no seu dispositivo. Não precisa de conta e não existe servidor GaleriQ. É bom saber: em serviços na nuvem como o Google Fotos, o que eliminar pode desaparecer também nos outros dispositivos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ se uită la fotografiile, videoclipurile și fișierele permise doar pe dispozitivul tău. Nu ai nevoie de cont și nu există server GaleriQ. Bine de știut: la servicii cloud precum Google Foto, ce ștergi poate dispărea și de pe celelalte dispozitive."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ просматривает ваши фото, видео и разрешённые файлы только на устройстве. Аккаунт не нужен, и сервера GaleriQ нет. Полезно знать: в облачных сервисах вроде Google Фото удалённое может исчезнуть и на других устройствах."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ tittar på dina bilder, videor och tillåtna filer bara på din enhet. Du behöver inget konto och det finns ingen GaleriQ-server. Bra att veta: med molntjänster som Google Foto kan det du raderar försvinna även på dina andra enheter."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ดูรูปภาพ วิดีโอ และไฟล์ที่อนุญาตบนอุปกรณ์ของคุณเท่านั้น คุณไม่ต้องมีบัญชี และไม่มีเซิร์ฟเวอร์ของ GaleriQ ควรรู้: กับบริการคลาวด์อย่าง Google Photos สิ่งที่คุณลบอาจหายไปจากอุปกรณ์อื่นด้วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ fotoğraflarına, videolarına ve izin verdiğin dosyalara yalnızca cihazında bakar. Hesap gerekmez ve GaleriQ sunucusu yoktur. Bilmekte fayda var: Google Fotoğraflar gibi bulut hizmetlerinde sildiklerin diğer cihazlarından da kaybolabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ переглядає ваші фото, відео й дозволені файли лише на пристрої. Обліковий запис не потрібен, і сервера GaleriQ немає. Варто знати: у хмарних сервісах, як-от Google Фото, видалене може зникнути й на інших пристроях."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ chỉ xem ảnh, video và tệp được phép trên thiết bị của bạn. Bạn không cần tài khoản và không có máy chủ GaleriQ. Lưu ý: với dịch vụ đám mây như Google Photos, những gì bạn xóa cũng có thể biến mất trên các thiết bị khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ 只在你的设备上查看照片、视频和你允许的文件。无需账户，也没有 GaleriQ 服务器。请注意：在 Google 相册等云服务中，你删除的内容也可能从其他设备上消失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ 只在你的裝置上查看你的照片、影片和允許的檔案。你不需要帳號，也沒有 GaleriQ 伺服器。小提醒：使用 Google 相簿等雲端服務時，你刪除的內容也可能從其他裝置上消失。"
          }
        }
      }
    },
