    "dup_how": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقارن PhotoMaid محتوى الملفات على جهازك مباشرةً. الصور المتشابهة في الشكل ليست نسخًا متطابقة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid vergleicht die Dateiinhalte direkt auf deinem Gerät. Ähnlich aussehende Bilder zählen nicht als identische Kopien."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid compares file contents directly on your device. Similar-looking images don’t count as identical copies."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid compara el contenido de los archivos en tu dispositivo. Las imágenes parecidas no cuentan como copias idénticas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid compare le contenu des fichiers directement sur ton appareil. Les images qui se ressemblent ne comptent pas comme des copies identiques."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid confronta i contenuti dei file sul tuo dispositivo. Le immagini che si assomigliano non contano come copie identiche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaidは端末内でファイルの内容を比較します。見た目が似ているだけの画像は、同じコピーとはみなしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid는 기기에서 파일 내용을 직접 비교해요. 비슷하게 보이기만 하는 이미지는 같은 사본으로 보지 않아요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid vergelijkt bestandsinhoud op je apparaat. Afbeeldingen die op elkaar lijken, tellen niet als identieke kopieën."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid porównuje zawartość plików na urządzeniu. Podobnie wyglądające zdjęcia nie są uznawane za identyczne kopie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O PhotoMaid compara o conteúdo dos ficheiros no teu dispositivo. Imagens parecidas não contam como cópias idênticas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid compară conținutul fișierelor pe dispozitiv. Imaginile care seamănă nu sunt considerate copii identice."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid сравнивает содержимое файлов на устройстве. Похожие изображения не считаются одинаковыми копиями."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid dosya içeriklerini cihazında karşılaştırır. Benzer görünen resimler birebir aynı kopya sayılmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid порівнює вміст файлів на твоєму пристрої. Схожі зображення не вважаються ідентичними копіями."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid 直接在设备上比较文件内容。只是看起来相似的图片不算相同副本。"
          }
        }
      }
    },
    "dup_icloud_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحمّل النسخ الأصلية غير الموجودة عبر Wi-Fi. قد تستغرق المكتبات الكبيرة وقتًا وتستهلك بيانات كثيرة. يبحث في الوسائط المسموح بها والمجلدات المتصلة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lädt fehlende Originale über WLAN. Große Mediatheken können viel Zeit und Daten benötigen. Durchsucht freigegebene Medien und verbundene Ordner."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads missing originals over Wi-Fi. Large libraries can take time and use a lot of data. Searches permitted media and connected folders."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarga los originales que faltan por Wi-Fi. Las bibliotecas grandes pueden tardar y consumir muchos datos. Busca en los medios autorizados y las carpetas conectadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Télécharge les originaux manquants par Wi-Fi. Les grandes photothèques peuvent prendre du temps et consommer beaucoup de données. Recherche dans les médias autorisés et les dossiers connectés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarica gli originali mancanti tramite Wi-Fi. Le librerie grandi possono richiedere tempo e molti dati. Cerca nei contenuti autorizzati e nelle cartelle collegate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "不足しているオリジナルをWi-Fiでダウンロードします。大きなライブラリでは時間と大量のデータ通信が必要になる場合があります。アクセスを許可したメディアと接続したフォルダを検索します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기에 없는 원본을 Wi-Fi로 다운로드합니다. 보관함이 크면 시간과 데이터가 많이 필요할 수 있습니다. 접근이 허용된 미디어와 연결된 폴더를 검색합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloadt ontbrekende originelen via wifi. Grote bibliotheken kunnen veel tijd en data kosten. Doorzoekt toegestane media en gekoppelde mappen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobiera brakujące oryginały przez Wi-Fi. Duże biblioteki mogą wymagać czasu i wielu danych. Przeszukuje udostępnione multimedia i połączone foldery."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarrega os originais em falta por Wi-Fi. Bibliotecas grandes podem demorar e consumir muitos dados. Pesquisa conteúdos autorizados e pastas ligadas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarcă originalele lipsă prin Wi-Fi. Bibliotecile mari pot necesita timp și multe date. Caută în conținutul permis și în dosarele conectate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загружает недостающие оригиналы по Wi-Fi. Для большой медиатеки может потребоваться много времени и трафика. Поиск выполняется в разрешённых медиафайлах и подключённых папках."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksik özgünleri Wi-Fi üzerinden indirir. Büyük arşivler zaman ve çok miktarda veri gerektirebilir. İzin verilen ortamları ve bağlı klasörleri arar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завантажує відсутні оригінали через Wi-Fi. Великі медіатеки можуть потребувати багато часу й трафіку. Шукає в дозволених медіафайлах і підключених папках."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过无线局域网下载缺失的原片。大型图库可能需要较长时间并消耗大量流量。搜索已授权的媒体和已连接的文件夹。"
          }
        }
      }
    },
