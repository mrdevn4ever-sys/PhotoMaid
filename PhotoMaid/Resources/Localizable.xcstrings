    "tour_grid_select_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر على الصور لتحديدها. اضغط مطولًا واسحب لتحديد نطاق كامل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf Bilder, um sie auszuwählen. Lange drücken und ziehen wählt einen ganzen Bereich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap photos to select them. Long-press and drag to select a whole range."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca fotos para seleccionarlas. Mantén pulsado y arrastra para elegir un rango."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche des photos pour les sélectionner. Appuie longuement et fais glisser pour choisir toute une plage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca le foto per selezionarle. Tieni premuto e trascina per scegliere un intervallo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真をタップして選択。長押ししてドラッグすると範囲を選択できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진을 탭해 선택해요. 길게 누른 채 드래그하면 범위를 선택해요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op foto’s om ze te selecteren. Houd ingedrukt en sleep om een hele reeks te kiezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotykaj zdjęć, aby je zaznaczyć. Przytrzymaj i przeciągnij, aby zaznaczyć zakres."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca nas fotos para as selecionar. Mantém premido e arrasta para escolher um intervalo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge fotografiile pentru a le selecta. Ține apăsat și trage pentru un interval."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажимай на фото, чтобы выбрать. Удерживай и веди, чтобы выбрать диапазон."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçmek için fotoğraflara dokun. Bir aralık seçmek için basılı tutup sürükle."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкайся фото, щоб вибрати. Утримуй і тягни, щоб вибрати діапазон."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按照片即可选择。长按并拖动可选择一个范围。"
          }
        }
      }
    },
    "tour_grid_select_title": {
      "extractionState": "manual",
      "localizations": {
