    "tools_remove_location": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إزالة الموقع أيضًا"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লোকেশনও সরান"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar també la ubicació"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstranit i polohu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjern også lokalitet"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standort auch entfernen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αφαίρεση και τοποθεσίας"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Also remove location"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitar también la ubicación"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poista myös sijainti"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirer aussi la position"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સ્થાન પણ દૂર કરો"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "להסיר גם את המיקום"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लोकेशन भी हटाएँ"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukloni i lokaciju"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hely eltávolítása is"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus juga lokasi"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuovi anche la posizione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置情報も削除"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ಥಳವನ್ನೂ ತೆಗೆದುಹಾಕಿ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위치 정보도 제거"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ലൊക്കേഷനും നീക്കം ചെയ്യുക"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थानही काढा"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buang lokasi juga"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjern også sted"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ook locatie verwijderen"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଲୋକେସନ୍ ମଧ୍ୟ ହଟାନ୍ତୁ"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਟਿਕਾਣਾ ਵੀ ਹਟਾਓ"
          }
        },
        "pl": {
          "stringUnit": {
