    "months_empty_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر الأشهر هنا عندما يكون للصور أو الفيديوهات تاريخ التقاط."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফটো বা ভিডিওর তোলার তারিখ থাকলে মাসগুলো এখানে দেখা যায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els mesos apareixen aquí quan les fotos o els vídeos tenen data de presa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Měsíce se tu zobrazí, jakmile budou mít fotky nebo videa datum pořízení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Måneder vises her, når fotos eller videoer har en optagelsesdato."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobald Fotos oder Videos ein Aufnahmedatum haben, erscheinen hier die Monate."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι μήνες εμφανίζονται εδώ μόλις οι φωτογραφίες ή τα βίντεο έχουν ημερομηνία λήψης."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Months appear here once photos or videos have a capture date."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los meses aparecen aquí cuando las fotos o vídeos tienen fecha de captura."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuukaudet näkyvät täällä, kun kuvilla tai videoilla on kuvauspäivä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mois apparaissent ici dès que les photos ou vidéos ont une date de prise de vue."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફોટા કે વીડિયોને લીધાની તારીખ મળતાં જ મહિના અહીં દેખાશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החודשים יופיעו כאן ברגע שלתמונות או לסרטונים יש תאריך צילום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोटो या वीडियो की लेने की तारीख होते ही महीने यहाँ दिखेंगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mjeseci se ovdje prikazuju čim fotografije ili videozapisi imaju datum snimanja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hónapok itt jelennek meg, amint a fotóknak vagy videóknak van készítési dátuma."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bulan muncul di sini setelah foto atau video punya tanggal pengambilan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I mesi compaiono qui quando foto o video hanno una data di scatto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真や動画に撮影日があると、ここに月が表示されます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಫೋಟೋಗಳು ಅಥವಾ ವೀಡಿಯೊಗಳಿಗೆ ತೆಗೆದ ದಿನಾಂಕವಿದ್ದಾಗ ತಿಂಗಳುಗಳು ಇಲ್ಲಿ ಕಾಣಿಸುತ್ತವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진이나 동영상에 촬영 날짜가 있으면 여기에 월이 표시돼요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഫോട്ടോകൾക്കോ വീഡിയോകൾക്കോ എടുത്ത തീയതി ഉള്ളപ്പോൾ മാസങ്ങൾ ഇവിടെ ദൃശ്യമാകും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फोटो किंवा व्हिडिओंना काढल्याची तारीख असताच महिने इथे दिसतील."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bulan dipaparkan di sini sebaik sahaja foto atau video mempunyai tarikh diambil."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Måneder vises her når bilder eller videoer har en opptaksdato."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maanden verschijnen hier zodra foto’s of video’s een opnamedatum hebben."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଫଟୋ କିମ୍ବା ଭିଡିଓର ଉଠାଯାଇଥିବା ତାରିଖ ଥିଲେ ମାସଗୁଡ଼ିକ ଏଠାରେ ଦେଖାଯାଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਦੋਂ ਫ਼ੋਟੋਆਂ ਜਾਂ ਵੀਡੀਓ ਦੀ ਖਿੱਚਣ ਦੀ ਤਾਰੀਖ਼ ਹੋਵੇ, ਤਾਂ ਮਹੀਨੇ ਇੱਥੇ ਦਿਸਦੇ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Miesiące pojawią się tu, gdy zdjęcia lub filmy będą miały datę wykonania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os meses aparecem aqui quando fotos ou vídeos tiverem data de captura."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os meses aparecem aqui quando as fotos ou vídeos têm data de captura."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lunile apar aici când fotografiile sau videoclipurile au o dată de captură."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Месяцы появятся здесь, когда у фото или видео будет дата съёмки."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesiace sa tu zobrazia, keď budú mať fotky alebo videá dátum nasnímania."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meseci se prikažejo tukaj, ko imajo fotografije ali videoposnetki datum posnetka."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Månader visas här när bilder eller videor har ett tagningsdatum."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "புகைப்படங்களுக்கோ வீடியோக்களுக்கோ எடுத்த தேதி இருந்தால் மாதங்கள் இங்கே தோன்றும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫోటోలు లేదా వీడియోలకు తీసిన తేదీ ఉన్నప్పుడు నెలలు ఇక్కడ కనిపిస్తాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เดือนจะปรากฏที่นี่เมื่อรูปภาพหรือวิดีโอมีวันที่ถ่าย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraf veya videoların çekim tarihi olduğunda aylar burada görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Місяці з’являться тут, коли фото чи відео матимуть дату зйомки."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تصاویر یا ویڈیوز کی لینے کی تاریخ ہوتے ہی مہینے یہاں دکھیں گے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các tháng sẽ hiện ở đây khi ảnh hoặc video có ngày chụp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片或视频有拍摄日期后，月份会显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "照片或影片有拍攝日期後，月份就會顯示在這裡。"
          }
        }
      }
    },
