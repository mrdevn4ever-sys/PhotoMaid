    "org_tags_none": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد وسوم بعد. أضف كلماتك مثل „فاتورة“ أو „عطلة“ – يعرف GaleriQ فقط ما تُدخله بنفسك."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen tags endnu. Tilføj dine egne ord som “Faktura” eller “Ferie” – GaleriQ kender kun det, du selv indtaster."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Schlagwörter. Vergib eigene Begriffe wie „Rechnung“ oder „Ferien“ – GaleriQ kennt nur, was du selbst einträgst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No tags yet. Add your own words like “Invoice” or “Holiday” – GaleriQ only knows what you enter yourself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay etiquetas. Añade tus propias palabras, como «Factura» o «Vacaciones»: GaleriQ solo sabe lo que tú escribes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore de mot-clé. Ajoute tes propres mots comme « Facture » ou « Vacances » – GaleriQ ne connaît que ce que tu saisis."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada tag. Tambahkan kata-katamu sendiri seperti “Tagihan” atau “Liburan” – GaleriQ hanya tahu apa yang kamu masukkan sendiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessun tag. Aggiungi parole tue come «Fattura» o «Vacanze»: GaleriQ conosce solo ciò che inserisci tu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タグはまだありません。「請求書」「旅行」など自分の言葉を追加できます。GaleriQが知るのはあなたが入力した内容だけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 태그가 없어요. ‘영수증’, ‘여행’ 같은 단어를 직접 추가하세요. GaleriQ는 직접 입력한 내용만 알아요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen etiketter ennå. Legg til egne ord som «Faktura» eller «Ferie» – GaleriQ kjenner bare det du selv skriver inn."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen labels. Voeg eigen woorden toe zoals ‘Factuur’ of ‘Vakantie’ – GaleriQ weet alleen wat je zelf invult."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak tagów. Dodaj własne słowa, np. „Faktura” lub „Wakacje” – GaleriQ zna tylko to, co sam wpiszesz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda sem etiquetas. Adicione suas próprias palavras, como “Nota fiscal” ou “Férias” – o GaleriQ só sabe o que você mesmo digitar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há etiquetas. Adiciona palavras tuas, como «Fatura» ou «Férias» – o GaleriQ só sabe o que tu escreves."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încă nu există etichete. Adaugă propriile cuvinte, de pildă „Factură” sau „Vacanță” – GaleriQ știe doar ce introduci tu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меток пока нет. Добавь свои слова, например «Счёт» или «Отпуск», – GaleriQ знает только то, что ты вводишь сам."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga taggar ännu. Lägg till egna ord som ”Faktura” eller ”Semester” – GaleriQ känner bara till det du själv anger."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีแท็ก เพิ่มคำของคุณเอง เช่น “ใบแจ้งหนี้” หรือ “วันหยุด” – GaleriQ รู้เฉพาะสิ่งที่คุณป้อนเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz etiket yok. “Fatura” veya “Tatil” gibi kendi kelimelerini ekle – GaleriQ yalnızca senin girdiklerini bilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Міток ще немає. Додай власні слова, наприклад «Рахунок» або «Відпустка», – GaleriQ знає лише те, що ти вводиш сам."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có thẻ. Thêm từ của riêng bạn như “Hóa đơn” hoặc “Kỳ nghỉ” – GaleriQ chỉ biết những gì bạn tự nhập."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有标签。添加你自己的词，例如“发票”或“假期”——GaleriQ 只知道你自己输入的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚無標籤。加入你自己的字詞，例如「發票」或「假期」– GaleriQ 只知道你自己輸入的內容。"
          }
        }
      }
    },
