    "pro_privacy": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُفحص صورك وملفاتك وتُرتّب على جهازك فقط. للشراء والإعلانات يصل إلى Google أو المعلنين الحد الأدنى فقط – وليس صورك أو أسماءها أو أي بيانات مستخلصة منها أبدًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Your photos and files are checked and sorted only on your device. For purchases and ads only the bare minimum goes to Google or ad providers – never your photos, their names or anything derived from them."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Fotos und Dateien werden nur auf deinem Gerät geprüft und sortiert. Für Käufe und Werbung geht nur das Nötigste an Google oder Werbeanbieter – nie deine Fotos, ihre Namen oder Angaben daraus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your photos and files are checked and sorted only on your device. For purchases and ads only the bare minimum goes to Google or ad providers – never your photos, their names or anything derived from them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus fotos y archivos se revisan y ordenan solo en tu dispositivo. Para compras y anuncios solo se envía lo imprescindible a Google o a los anunciantes, nunca tus fotos, sus nombres ni nada obtenido de ellas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos photos et fichiers sont examinés et triés uniquement sur votre appareil. Pour les achats et la publicité, seul le strict nécessaire va à Google ou aux régies – jamais vos photos, leurs noms ou ce qui en est tiré."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Your photos and files are checked and sorted only on your device. For purchases and ads only the bare minimum goes to Google or ad providers – never your photos, their names or anything derived from them."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto e file vengono controllati e ordinati solo sul tuo dispositivo. Per acquisti e pubblicità va a Google o agli inserzionisti solo lo stretto necessario, mai le tue foto, i loro nomi o dati ricavati da esse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真とファイルの確認・整理は端末の中だけで行います。購入と広告のために Google や広告会社へ送るのは必要最小限だけで、写真やその名前、写真から得た情報は送りません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진과 파일은 기기 안에서만 확인하고 정리해요. 구매와 광고를 위해 Google이나 광고 업체에 꼭 필요한 것만 보내고, 사진이나 사진 이름, 사진에서 얻은 정보는 절대 보내지 않아요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Your photos and files are checked and sorted only on your device. For purchases and ads only the bare minimum goes to Google or ad providers – never your photos, their names or anything derived from them."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je foto’s en bestanden worden alleen op je apparaat bekeken en gesorteerd. Voor aankopen en advertenties gaat alleen het hoognodige naar Google of adverteerders – nooit je foto’s, hun namen of iets wat eruit is afgeleid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdjęcia i pliki są sprawdzane i porządkowane tylko na Twoim urządzeniu. Do zakupów i reklam do Google lub reklamodawców trafia tylko to, co niezbędne – nigdy zdjęcia, ich nazwy ani nic z nich wyliczonego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Your photos and files are checked and sorted only on your device. For purchases and ads only the bare minimum goes to Google or ad providers – never your photos, their names or anything derived from them."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As suas fotos e ficheiros são verificados e organizados apenas no dispositivo. Para compras e anúncios só segue o mínimo indispensável para a Google ou anunciantes – nunca as suas fotos, os nomes ou dados obtidos a partir delas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografiile și fișierele tale sunt verificate și sortate doar pe dispozitiv. Pentru cumpărături și reclame ajunge la Google sau la furnizori doar strictul necesar – niciodată fotografiile, numele lor sau ceva derivat din ele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши фото и файлы проверяются и сортируются только на устройстве. Для покупок и рекламы Google или рекламодателям уходит лишь самое необходимое – никогда ваши фото, их названия или данные из них."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Your photos and files are checked and sorted only on your device. For purchases and ads only the bare minimum goes to Google or ad providers – never your photos, their names or anything derived from them."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Your photos and files are checked and sorted only on your device. For purchases and ads only the bare minimum goes to Google or ad providers – never your photos, their names or anything derived from them."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğrafların ve dosyaların yalnızca cihazında incelenir ve sıralanır. Satın almalar ve reklamlar için Google’a veya reklamcılara yalnızca gerekenler gider – asla fotoğrafların, adları veya onlardan elde edilen bilgiler değil."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші фото й файли перевіряються та сортуються лише на пристрої. Для покупок і реклами Google чи рекламодавцям іде тільки найнеобхідніше – ніколи ваші фото, їхні назви чи дані з них."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Your photos and files are checked and sorted only on your device. For purchases and ads only the bare minimum goes to Google or ad providers – never your photos, their names or anything derived from them."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的照片和文件只在设备上检查和整理。为了购买和广告，只会把最必要的信息发给 Google 或广告商——绝不会发送你的照片、照片名称或由其得出的信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Your photos and files are checked and sorted only on your device. For purchases and ads only the bare minimum goes to Google or ad providers – never your photos, their names or anything derived from them."
          }
        }
      }
    },
    "pro_privacy_no_ads": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُفحص صورك وملفاتك وتُرتّب على جهازك فقط. للشراء يصل إلى Google الحد الأدنى فقط – وليس صورك أو أسماءها أو أي بيانات مستخلصة منها أبدًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine fotos og filer kontrolleres og sorteres kun på din enhed. Ved købet går kun det allermest nødvendige til Google – aldrig dine fotos, deres navne eller noget afledt af dem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Fotos und Dateien werden nur auf deinem Gerät geprüft und sortiert. Für den Kauf geht nur das Nötigste an Google – nie deine Fotos, ihre Namen oder Angaben daraus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your photos and files are checked and sorted only on your device. For the purchase only the bare minimum goes to Google – never your photos, their names or anything derived from them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus fotos y archivos se revisan y ordenan solo en tu dispositivo. Para la compra solo se envía lo imprescindible a Google, nunca tus fotos, sus nombres ni nada obtenido de ellas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos photos et fichiers sont examinés et triés uniquement sur votre appareil. Pour l’achat, seul le strict nécessaire va à Google – jamais vos photos, leurs noms ou ce qui en est tiré."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto dan file-mu hanya diperiksa dan diurutkan di perangkatmu. Untuk pembelian, hanya yang benar-benar diperlukan dikirim ke Google – tidak pernah fotomu, namanya, atau apa pun yang berasal darinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto e file vengono controllati e ordinati solo sul tuo dispositivo. Per l’acquisto va a Google solo lo stretto necessario, mai le tue foto, i loro nomi o dati ricavati da esse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真とファイルの確認・整理は端末の中だけで行います。購入のために Google へ送るのは必要最小限だけで、写真やその名前、写真から得た情報は送りません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진과 파일은 기기 안에서만 확인하고 정리해요. 구매를 위해 Google에 꼭 필요한 것만 보내고, 사진이나 사진 이름, 사진에서 얻은 정보는 절대 보내지 않아요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildene og filene dine kontrolleres og sorteres bare på enheten din. Ved kjøp går bare det aller nødvendigste til Google – aldri bildene dine, navnene på dem eller noe som er avledet fra dem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je foto’s en bestanden worden alleen op je apparaat bekeken en gesorteerd. Voor de aankoop gaat alleen het hoognodige naar Google – nooit je foto’s, hun namen of iets wat eruit is afgeleid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdjęcia i pliki są sprawdzane i porządkowane tylko na Twoim urządzeniu. Do zakupu do Google trafia tylko to, co niezbędne – nigdy zdjęcia, ich nazwy ani nic z nich wyliczonego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas fotos e arquivos são verificados e organizados só no seu aparelho. Na compra, só o mínimo necessário vai para o Google – nunca suas fotos, os nomes delas ou algo derivado delas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As suas fotos e ficheiros são verificados e organizados apenas no dispositivo. Para a compra só segue o mínimo indispensável para a Google – nunca as suas fotos, os nomes ou dados obtidos a partir delas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografiile și fișierele tale sunt verificate și sortate doar pe dispozitiv. Pentru cumpărare ajunge la Google doar strictul necesar – niciodată fotografiile, numele lor sau ceva derivat din ele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши фото и файлы проверяются и сортируются только на устройстве. Для покупки Google получает лишь самое необходимое – никогда ваши фото, их названия или данные из них."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina bilder och filer kontrolleras och sorteras bara på din enhet. Vid köpet går bara det allra nödvändigaste till Google – aldrig dina bilder, deras namn eller något som härleds från dem."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปภาพและไฟล์ของคุณถูกตรวจสอบและจัดเรียงบนอุปกรณ์ของคุณเท่านั้น สำหรับการซื้อ จะส่งเฉพาะสิ่งที่จำเป็นที่สุดไปยัง Google – ไม่เคยส่งรูปภาพ ชื่อรูป หรือสิ่งใดที่ได้มาจากรูป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğrafların ve dosyaların yalnızca cihazında incelenir ve sıralanır. Satın alma için Google’a yalnızca gerekenler gider – asla fotoğrafların, adları veya onlardan elde edilen bilgiler değil."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші фото й файли перевіряються та сортуються лише на пристрої. Для покупки Google отримує тільки найнеобхідніше – ніколи ваші фото, їхні назви чи дані з них."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh và tệp của bạn chỉ được kiểm tra và sắp xếp trên thiết bị. Khi mua, chỉ những gì tối thiểu cần thiết được gửi cho Google – không bao giờ là ảnh, tên ảnh hay bất cứ thứ gì suy ra từ chúng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的照片和文件只在设备上检查和整理。为了购买，只会把最必要的信息发给 Google——绝不会发送你的照片、照片名称或由其得出的信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的照片和檔案只在你的裝置上檢查和整理。購買時只會向 Google 傳送最少的必要資訊 – 絕不包含你的照片、照片名稱或從中衍生的任何內容。"
          }
        }
      }
    },
