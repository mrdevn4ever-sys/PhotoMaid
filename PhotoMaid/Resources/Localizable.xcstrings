    "fc_reset_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لأعلى للاحتفاظ، ولليسار لسلة المهملات، ولليمين لاحقًا، ولأسفل للرجوع – مع الأزرار القياسية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "উপরে রাখে, বাঁয়ে ট্র্যাশে পাঠায়, ডানে পরে, নিচে পেছনে যায় – ডিফল্ট বোতামসহ।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Amunt conserva, a l’esquerra a la paperera, a la dreta més tard, avall torna enrere, amb els botons per defecte."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahoru ponechá, doleva do koše, doprava později, dolů zpět – s výchozími tlačítky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Op beholder, venstre til papirkurven, højre er senere, ned går tilbage – med standardknapperne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoch behält, links legt in den Papierkorb, rechts ist später, runter geht zurück – mit den Standard-Tasten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάνω διατήρηση, αριστερά στον κάδο, δεξιά αργότερα, κάτω πίσω – με τα προεπιλεγμένα κουμπιά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Up keeps, left moves to trash, right is later, down goes back – with the default buttons."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arriba conserva, izquierda a la papelera, derecha para después, abajo vuelve atrás, con los botones estándar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ylös säilyttää, vasemmalle roskakoriin, oikealle myöhemmäksi, alas takaisin – oletuspainikkeilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Haut garde, gauche va à la corbeille, droite pour plus tard, bas revient en arrière – avec les boutons standard."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઉપર રાખો, ડાબે ટ્રેશ, જમણે પછી, નીચે પાછળ – ડિફૉલ્ટ બટન સાથે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "למעלה – שמירה, שמאלה – לפח, ימינה – מאוחר יותר, למטה – חזרה, עם כפתורי ברירת המחדל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऊपर रखें, बाएँ ट्रैश, दाएँ बाद में, नीचे वापस – डिफ़ॉल्ट बटनों के साथ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gore zadržava, lijevo u smeće, desno kasnije, dolje natrag – sa zadanim tipkama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Fel: megtartás, balra: kuka, jobbra: később, le: vissza – az alapértelmezett gombokkal."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ke atas menyimpan, ke kiri ke sampah, ke kanan nanti, ke bawah kembali – dengan tombol default."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su conserva, sinistra nel cestino, destra più tardi, giù torna indietro, con i pulsanti standard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上で残す、左でゴミ箱、右であとで、下で戻る – 標準のボタン付き。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮೇಲೆ ಇರಿಸುತ್ತದೆ, ಎಡಕ್ಕೆ ಕಸದ ಬುಟ್ಟಿಗೆ, ಬಲಕ್ಕೆ ನಂತರ, ಕೆಳಗೆ ಹಿಂದಕ್ಕೆ – ಡೀಫಾಲ್ಟ್ ಬಟನ್‌ಗಳೊಂದಿಗೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위는 보관, 왼쪽은 휴지통, 오른쪽은 나중에, 아래는 뒤로 – 기본 버튼과 함께."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മുകളിലേക്ക് സൂക്ഷിക്കുന്നു, ഇടത്തേക്ക് ട്രാഷിലേക്ക്, വലത്തേക്ക് പിന്നീട്, താഴേക്ക് പിന്നോട്ട് – ഡിഫോൾട്ട് ബട്ടണുകളോടെ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "वर ठेवा, डावीकडे ट्रॅश, उजवीकडे नंतर, खाली मागे – डीफॉल्ट बटणांसह."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Atas simpan, kiri ke sampah, kanan nanti, bawah kembali – dengan butang lalai."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opp beholder, venstre til papirkurven, høyre er senere, ned går tilbake – med standardknappene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omhoog bewaart, links naar de prullenbak, rechts voor later, omlaag terug – met de standaardknoppen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଉପରକୁ ରଖେ, ବାମକୁ ଟ୍ରାସକୁ, ଡାହାଣକୁ ପରେ, ତଳକୁ ପଛକୁ ଯାଏ – ଡିଫଲ୍ଟ ବଟନ୍ ସହ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਉੱਪਰ ਰੱਖਦਾ ਹੈ, ਖੱਬੇ ਰੱਦੀ ਵਿੱਚ ਭੇਜਦਾ ਹੈ, ਸੱਜੇ ਬਾਅਦ ਵਿੱਚ ਹੈ, ਹੇਠਾਂ ਪਿੱਛੇ ਜਾਂਦਾ ਹੈ – ਮੂਲ ਬਟਨਾਂ ਨਾਲ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W górę zachowuje, w lewo do kosza, w prawo na później, w dół wraca – ze standardowymi przyciskami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para cima mantém, para a esquerda vai para a lixeira, para a direita é depois, para baixo volta – com os botões padrão."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para cima mantém, esquerda para o lixo, direita para mais tarde, para baixo volta – com os botões padrão."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus păstrează, stânga în coș, dreapta mai târziu, jos înapoi – cu butoanele standard."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вверх — оставить, влево — в корзину, вправо — на потом, вниз — назад, со стандартными кнопками."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahor ponechá, doľava do koša, doprava neskôr, nadol späť – s predvolenými tlačidlami."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gor obdrži, levo v koš, desno pozneje, dol nazaj – s privzetimi gumbi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Upp behåller, vänster till papperskorgen, höger är senare, ned går tillbaka – med standardknapparna."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மேலே வைத்திருக்கும், இடப்புறம் குப்பைக்கு, வலப்புறம் பிறகு, கீழே பின்செல்லும் – இயல்புநிலைப் பொத்தான்களுடன்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పైకి ఉంచుతుంది, ఎడమకు ట్రాష్‌కి, కుడికి తర్వాత, కిందికి వెనక్కి – డిఫాల్ట్ బటన్‌లతో."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปัดขึ้นเก็บไว้ ซ้ายไปถังขยะ ขวาไว้ทีหลัง ลงย้อนกลับ – ด้วยปุ่มเริ่มต้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yukarı saklar, sol çöp kutusu, sağ sonra, aşağı geri – standart düğmelerle."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вгору — залишити, ліворуч — у кошик, праворуч — на потім, вниз — назад, зі стандартними кнопками."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اوپر رکھیں، بائیں ردی، دائیں بعد میں، نیچے واپس – ڈیفالٹ بٹنوں کے ساتھ۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lên để giữ, trái vào thùng rác, phải để sau, xuống để quay lại – với các nút mặc định."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向上保留，向左放入回收站，向右稍后，向下返回，并使用标准按钮。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用預設按鈕時：上滑保留，左滑移到垃圾桶，右滑稍後，下滑返回。"
          }
        }
      }
    },
