        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 앱으로 전환해도 계속 진행됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsetter hvis du bytter app."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gaat door, ook als je van app wisselt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Działa dalej, nawet gdy przełączysz aplikację."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua rodando se você trocar de app."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua mesmo que mude de app."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuă și dacă schimbi aplicația."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжается, даже если переключиться на другое приложение."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsätter om du byter app."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำงานต่อแม้คุณสลับแอพ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir uygulamaya geçsen de devam eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Триває, навіть якщо перейти до іншої програми."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
