    "vault2_recording_explanation": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يبدأ التسجيل إلا عند الضغط. يُحفظ مشفّرًا ويتوقف عند قفل الخزنة أو مغادرتها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি ট্যাপ করলেই কেবল রেকর্ডিং শুরু হয়। এটি এনক্রিপ্ট করে সংরক্ষিত হয় এবং ভল্ট লক করলে বা ছেড়ে গেলে থেমে যায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La gravació només comença quan toques. Es desa xifrada i s’atura quan bloqueges la caixa forta o en surts."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahrávání začne, až klepnete. Ukládá se šifrovaně a zastaví se, když trezor zamknete nebo opustíte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Optagelsen starter først, når du trykker. Den gemmes krypteret og stopper, når du låser eller forlader boksen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufnahme beginnt erst nach deinem Tippen. Sie wird verschlüsselt gespeichert und beim Sperren oder Verlassen beendet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εγγραφή ξεκινά μόνο όταν πατήσεις. Αποθηκεύεται κρυπτογραφημένη και σταματά όταν κλειδώνεις ή φεύγεις από το θησαυροφυλάκιο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording starts only when you tap. It is stored encrypted and stops when you lock or leave the vault."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabación empieza solo al tocar. Se guarda cifrada y se detiene al bloquear o salir de la caja fuerte."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallennus alkaa vasta, kun napautat. Se tallennetaan salattuna ja pysähtyy, kun lukitset holvin tai poistut siitä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’enregistrement commence uniquement à votre demande. Il est stocké chiffré et s’arrête au verrouillage ou à la sortie du coffre."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે ટૅપ કરો ત્યારે જ રેકોર્ડિંગ શરૂ થાય છે. તે એન્ક્રિપ્ટ થઈને સચવાય છે અને તમે વૉલ્ટ લૉક કરો કે છોડો ત્યારે બંધ થાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההקלטה מתחילה רק כשמקישים. היא נשמרת מוצפנת ונעצרת כשנועלים את הכספת או יוצאים ממנה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्डिंग तभी शुरू होती है जब आप टैप करें। यह एन्क्रिप्ट होकर सहेजी जाती है और तिजोरी लॉक करने या छोड़ने पर रुक जाती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Snimanje počinje tek kad dodirneš. Sprema se šifrirano i zaustavlja se kad zaključaš trezor ili ga napustiš."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A felvétel csak koppintásra indul. Titkosítva tárolódik, és leáll, ha zárolod vagy elhagyod a széfet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perekaman baru dimulai saat kamu mengetuk. Rekaman disimpan terenkripsi dan berhenti saat kamu mengunci atau keluar dari brankas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La registrazione inizia solo al tuo tocco. È salvata crittografata e si ferma quando blocchi o lasci la cassaforte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップしたときだけ録音を開始します。暗号化して保存し、ロックまたは保管庫を閉じると停止します。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಟ್ಯಾಪ್ ಮಾಡಿದಾಗ ಮಾತ್ರ ರೆಕಾರ್ಡಿಂಗ್ ಪ್ರಾರಂಭವಾಗುತ್ತದೆ. ಅದು ಎನ್‌ಕ್ರಿಪ್ಟ್ ಆಗಿ ಸಂಗ್ರಹವಾಗುತ್ತದೆ ಮತ್ತು ನೀವು ವಾಲ್ಟ್ ಲಾಕ್ ಮಾಡಿದಾಗ ಅಥವಾ ಬಿಟ್ಟಾಗ ನಿಲ್ಲುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭해야 녹음이 시작됩니다. 암호화하여 저장되며 보관함을 잠그거나 나가면 중지됩니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ ടാപ്പ് ചെയ്യുമ്പോൾ മാത്രമേ റെക്കോർഡിംഗ് ആരംഭിക്കൂ. ഇത് എൻക്രിപ്റ്റ് ചെയ്ത് സംഭരിക്കുകയും നിങ്ങൾ വോൾട്ട് ലോക്ക് ചെയ്യുമ്പോഴോ വിട്ടുപോകുമ്പോഴോ നിർത്തുകയും ചെയ്യും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही टॅप केल्यावरच रेकॉर्डिंग सुरू होते. ते एन्क्रिप्ट करून जतन होते आणि तुम्ही व्हॉल्ट लॉक केल्यावर किंवा सोडल्यावर थांबते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Rakaman hanya bermula apabila anda mengetik. Ia disimpan secara disulitkan dan berhenti apabila anda mengunci atau meninggalkan peti besi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opptaket starter først når du trykker. Det lagres kryptert og stopper når du låser eller forlater safen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opname begint pas na je tik. Ze wordt versleuteld opgeslagen en stopt bij vergrendelen of verlaten van de kluis."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣ ଟାପ୍ କଲେ ହିଁ ରେକର୍ଡିଂ ଆରମ୍ଭ ହୁଏ। ଏହା ଏନକ୍ରିପ୍ଟ କରି ଷ୍ଟୋର୍ ହୁଏ ଏବଂ ଆପଣ ଭଲ୍ଟ ଲକ୍ କଲେ କିମ୍ବା ଛାଡ଼ିଲେ ବନ୍ଦ ହୁଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਰਿਕਾਰਡਿੰਗ ਸਿਰਫ਼ ਤੁਹਾਡੇ ਟੈਪ ਕਰਨ ’ਤੇ ਸ਼ੁਰੂ ਹੁੰਦੀ ਹੈ। ਇਹ ਇਨਕ੍ਰਿਪਟ ਕਰਕੇ ਸਟੋਰ ਹੁੰਦੀ ਹੈ ਅਤੇ ਵੌਲਟ ਨੂੰ ਲੌਕ ਕਰਨ ਜਾਂ ਛੱਡਣ ’ਤੇ ਰੁਕ ਜਾਂਦੀ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagrywanie zaczyna się dopiero po stuknięciu. Jest zapisywane w postaci zaszyfrowanej i kończy się przy blokadzie lub opuszczeniu sejfu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravação só começa quando você toca. Ela é guardada criptografada e para quando você bloqueia ou sai do cofre."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravação só começa ao tocares. É guardada cifrada e para ao bloqueares ou saíres do cofre."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înregistrarea începe doar la atingere. Este stocată criptat și se oprește când blochezi sau părăsești seiful."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись начинается только по нажатию. Она хранится зашифрованной и останавливается при блокировке или выходе из сейфа."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahrávanie sa začne, až keď klepnete. Ukladá sa šifrovane a zastaví sa, keď trezor zamknete alebo opustíte."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Snemanje se začne šele, ko tapneš. Shrani se šifrirano in se ustavi, ko sef zakleneš ali zapustiš."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspelningen startar först när du trycker. Den lagras krypterad och stoppas när du låser eller lämnar valvet."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் தட்டும்போது மட்டுமே பதிவு தொடங்கும். இது குறியாக்கம் செய்யப்பட்டுச் சேமிக்கப்படும், நீங்கள் லாக்கரைப் பூட்டும்போது அல்லது விட்டு வெளியேறும்போது நின்றுவிடும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ట్యాప్ చేసినప్పుడు మాత్రమే రికార్డింగ్ ప్రారంభమవుతుంది. అది ఎన్‌క్రిప్ట్ అయి నిల్వ ఉంటుంది, మీరు వాల్ట్‌ను లాక్ చేసినప్పుడు లేదా వదిలి వెళ్లినప్పుడు ఆగిపోతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การบันทึกจะเริ่มเมื่อคุณแตะเท่านั้น จะถูกเก็บแบบเข้ารหัสและหยุดเมื่อคุณล็อกหรือออกจากตู้เซฟ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt yalnızca dokunduğunda başlar. Şifreli saklanır ve kasa kilitlendiğinde veya kasadan çıkıldığında durur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запис починається лише після натискання. Він зберігається зашифрованим і зупиняється під час блокування або виходу зі сховища."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ریکارڈنگ تب ہی شروع ہوتی ہے جب آپ ٹیپ کریں۔ یہ خفیہ ہو کر محفوظ ہوتی ہے اور والٹ لاک کرنے یا چھوڑنے پر رک جاتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ bắt đầu ghi khi bạn chạm. Bản ghi được lưu mã hóa và dừng khi bạn khóa hoặc rời két sắt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在你点击后开始录音。录音加密存储，锁定或离开保险库时停止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有在你點一下時才會開始錄音。錄音會加密儲存，並在你鎖定或離開保險箱時停止。"
          }
        }
      }
    },
