    "edit_err_gone": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تغيير هذا العنصر أو نقله أو حذفه في هذه الأثناء. لم يُحفظ أي شيء."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette emne er blevet ændret, flyttet eller slettet i mellemtiden. Intet blev gemt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Foto oder Video wurde inzwischen geändert, verschoben oder gelöscht. Es wurde nichts gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This item was changed, moved or deleted in the meantime. Nothing was saved."
