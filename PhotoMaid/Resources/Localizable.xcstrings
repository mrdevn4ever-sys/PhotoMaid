        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जोड़ी गई चीज़ को हिलाने के लिए उस पर टैप करें। दो उँगलियों से साइज़ बदलें और घुमाएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirni nešto što si dodao da ga pomakneš. Dvama prstima mijenjaš veličinu i okrećeš."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints egy hozzáadott elemre a mozgatásához. Két ujjal méretezel és forgatsz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk sesuatu yang kamu tambahkan untuk memindahkannya. Dua jari mengubah ukuran dan memutar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca un elemento aggiunto per spostarlo. Con due dita cambi dimensione e rotazione."
