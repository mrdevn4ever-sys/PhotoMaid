    "backup_restore_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستعيد نسخة احتياطية، على هاتف جديد مثلًا. يُعثر على الصور مجددًا من خلال الاسم والحجم ووقت الالتقاط. ما تم تحديده أو إدخاله هنا يبقى كما هو."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি ব্যাকআপ আনে, যেমন নতুন ফোনে। ফটোগুলো নাম, আকার ও তোলার সময় দিয়ে আবার খুঁজে পাওয়া যায়। এখানে আগে থেকে নেওয়া সিদ্ধান্ত বা লেখা যেমন আছে তেমনই থাকে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Recupera una còpia de seguretat, per exemple en un telèfon nou. Les fotos es tornen a trobar pel nom, la mida i l’hora de presa. El que ja s’hagi decidit o introduït aquí es queda com està."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Načte zálohu, například v novém telefonu. Fotky se znovu najdou podle názvu, velikosti a času pořízení. Co tady už bylo rozhodnuto nebo zadáno, zůstane beze změny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indlæser en sikkerhedskopi, f.eks. på en ny telefon. Fotos findes igen via navn, størrelse og optagelsestidspunkt. Det, der allerede er besluttet eller indtastet her, forbliver uændret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übernimmt eine Sicherung, zum Beispiel auf einem neuen Handy. Fotos werden über Name, Größe und Aufnahmezeit wiedergefunden. Was hier schon entschieden oder eingetragen ist, bleibt, wie es ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Φέρνει ένα αντίγραφο ασφαλείας, π.χ. σε νέο τηλέφωνο. Οι φωτογραφίες εντοπίζονται ξανά από όνομα, μέγεθος και ώρα λήψης. Ό,τι έχει ήδη αποφασιστεί ή καταχωριστεί εδώ μένει όπως είναι."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brings in a backup, for example on a new phone. Photos are found again by name, size and time taken. Anything already decided or entered here stays as it is."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recupera una copia de seguridad, por ejemplo en un móvil nuevo. Las fotos se vuelven a encontrar por nombre, tamaño y hora de captura. Lo que ya esté decidido o anotado aquí se queda como está."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuo varmuuskopion esimerkiksi uuteen puhelimeen. Kuvat löydetään uudelleen nimen, koon ja kuvausajan perusteella. Täällä jo päätetty tai syötetty pysyy ennallaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reprend une sauvegarde, par exemple sur un nouveau téléphone. Les photos sont retrouvées grâce au nom, à la taille et à l’heure de prise. Ce qui est déjà décidé ou saisi ici reste tel quel."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બૅકઅપ લાવે છે, દા.ત. નવા ફોન પર. ફોટા નામ, કદ અને લીધાના સમયથી ફરી મળી જાય છે. અહીં પહેલેથી નક્કી કે દાખલ કરેલું જેમ છે તેમ રહે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "טוען גיבוי, למשל בטלפון חדש. התמונות נמצאות שוב לפי שם, גודל ושעת צילום. מה שכבר הוחלט או הוזן כאן נשאר כמו שהוא."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बैकअप लाता है, जैसे नए फ़ोन पर। फ़ोटो नाम, साइज़ और लेने के समय से फिर से मिल जाती हैं। जो यहाँ पहले से तय या दर्ज है, वह वैसा ही रहता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Učitava sigurnosnu kopiju, npr. na novom telefonu. Fotografije se ponovno pronalaze po nazivu, veličini i vremenu snimanja. Ono što je ovdje već odlučeno ili uneseno ostaje kako jest."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Behoz egy biztonsági mentést, például új telefonon. A fotók név, méret és készítési idő alapján újra megtalálhatók. Ami itt már el van döntve vagy be van írva, az változatlan marad."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memasukkan cadangan, misalnya di ponsel baru. Foto ditemukan kembali lewat nama, ukuran, dan waktu diambil. Apa pun yang sudah diputuskan atau dimasukkan di sini tetap seperti semula."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Recupera un backup, ad esempio su un nuovo telefono. Le foto vengono ritrovate da nome, dimensione e ora dello scatto. Ciò che è già deciso o inserito qui resta com’è."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいスマホなどでバックアップを取り込みます。写真は名前・サイズ・撮影日時で見つけ直します。ここで既に判断・入力した内容はそのままです。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಬ್ಯಾಕಪ್ ಅನ್ನು ತರುತ್ತದೆ, ಉದಾಹರಣೆಗೆ ಹೊಸ ಫೋನ್‌ನಲ್ಲಿ. ಫೋಟೋಗಳನ್ನು ಹೆಸರು, ಗಾತ್ರ ಮತ್ತು ತೆಗೆದ ಸಮಯದಿಂದ ಮತ್ತೆ ಕಂಡುಹಿಡಿಯಲಾಗುತ್ತದೆ. ಇಲ್ಲಿ ಈಗಾಗಲೇ ನಿರ್ಧರಿಸಿದ ಅಥವಾ ನಮೂದಿಸಿದ ಯಾವುದೂ ಹಾಗೆಯೇ ಉಳಿಯುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 휴대폰 등에서 백업을 가져와요. 사진은 이름, 크기, 촬영 시각으로 다시 찾아요. 여기서 이미 정했거나 입력한 것은 그대로 남아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരു ബാക്കപ്പ് കൊണ്ടുവരുന്നു, ഉദാഹരണത്തിന് പുതിയ ഫോണിൽ. ഫോട്ടോകൾ പേര്, വലുപ്പം, എടുത്ത സമയം എന്നിവ വഴി വീണ്ടും കണ്ടെത്തുന്നു. ഇവിടെ ഇതിനകം തീരുമാനിച്ചതോ നൽകിയതോ ആയവ അതുപോലെ തുടരും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "बॅकअप आणते, उदा. नवीन फोनवर. फोटो नाव, आकार आणि काढण्याच्या वेळेवरून पुन्हा सापडतात. इथे आधीच ठरवलेले किंवा भरलेले जसेच्या तसे राहते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Membawa masuk sandaran, contohnya pada telefon baharu. Foto ditemui semula melalui nama, saiz dan masa diambil. Apa-apa yang sudah diputuskan atau dimasukkan di sini kekal seperti sedia ada."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Henter inn en sikkerhetskopi, for eksempel på en ny telefon. Bildene finnes igjen via navn, størrelse og opptakstidspunkt. Det som allerede er avgjort eller skrevet inn her, forblir som det er."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neemt een back-up over, bijvoorbeeld op een nieuwe telefoon. Foto’s worden teruggevonden via naam, grootte en opnametijd. Wat hier al besloten of ingevuld is, blijft zoals het is."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏକ ବ୍ୟାକଅପ୍ ଆଣେ, ଯେପରି ନୂଆ ଫୋନ୍‌ରେ। ଫଟୋଗୁଡ଼ିକୁ ନାମ, ଆକାର ଓ ଉଠାଯାଇଥିବା ସମୟ ଦ୍ୱାରା ପୁଣି ଖୋଜାଯାଏ। ଏଠାରେ ପୂର୍ବରୁ ନିଷ୍ପତ୍ତି ହୋଇଥିବା କିମ୍ବା ପ୍ରବେଶ କରାଯାଇଥିବା ଯାହା କିଛି ସେମିତି ରହେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਬੈਕਅੱਪ ਲਿਆਉਂਦਾ ਹੈ, ਜਿਵੇਂ ਨਵੇਂ ਫ਼ੋਨ ਉੱਤੇ। ਫ਼ੋਟੋਆਂ ਨਾਮ, ਆਕਾਰ ਅਤੇ ਖਿੱਚਣ ਦੇ ਸਮੇਂ ਤੋਂ ਦੁਬਾਰਾ ਮਿਲ ਜਾਂਦੀਆਂ ਹਨ। ਜੋ ਇੱਥੇ ਪਹਿਲਾਂ ਤੋਂ ਤੈਅ ਜਾਂ ਦਰਜ ਹੈ, ਉਹ ਉਵੇਂ ਹੀ ਰਹਿੰਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przywraca kopię zapasową, np. na nowym telefonie. Zdjęcia są odnajdywane po nazwie, rozmiarze i czasie wykonania. To, co już tu zdecydowano lub wpisano, zostaje bez zmian."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Traz um backup de volta, por exemplo num celular novo. As fotos são encontradas de novo por nome, tamanho e data de captura. O que já foi decidido ou inserido aqui continua como está."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Recupera uma cópia de segurança, por exemplo num telemóvel novo. As fotos são reencontradas pelo nome, tamanho e hora da captação. O que já estiver decidido ou registado aqui fica como está."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Preia un backup, de exemplu pe un telefon nou. Fotografiile sunt regăsite după nume, dimensiune și ora realizării. Ce este deja decis sau introdus aici rămâne neschimbat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переносит резервную копию, например на новый телефон. Фото находятся по имени, размеру и времени съёмки. То, что здесь уже решено или записано, остаётся как есть."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Načíta zálohu, napríklad v novom telefóne. Fotky sa znova nájdu podľa názvu, veľkosti a času nasnímania. Čo tu už bolo rozhodnuté alebo zadané, zostane bez zmeny."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uvozi varnostno kopijo, na primer v novem telefonu. Fotografije se znova najdejo po imenu, velikosti in času posnetka. Kar je tukaj že odločeno ali vneseno, ostane nespremenjeno."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Läser in en säkerhetskopia, till exempel på en ny telefon. Bilderna hittas igen via namn, storlek och tagningstid. Det som redan är beslutat eller inmatat här förblir som det är."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு காப்புப்பிரதியைக் கொண்டுவருகிறது, எ.கா. புதிய ஃபோனில். புகைப்படங்கள் பெயர், அளவு, எடுத்த நேரம் மூலம் மீண்டும் கண்டறியப்படும். இங்கே ஏற்கனவே முடிவு செய்தவை அல்லது உள்ளிட்டவை அப்படியே இருக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "బ్యాకప్‌ను తీసుకువస్తుంది, ఉదాహరణకు కొత్త ఫోన్‌లో. ఫోటోలు పేరు, పరిమాణం, తీసిన సమయం ద్వారా మళ్లీ కనుగొనబడతాయి. ఇక్కడ ఇప్పటికే నిర్ణయించినవి లేదా నమోదు చేసినవి అలాగే ఉంటాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นำข้อมูลสำรองกลับมา เช่น บนโทรศัพท์เครื่องใหม่ รูปภาพจะถูกค้นหาอีกครั้งจากชื่อ ขนาด และเวลาที่ถ่าย สิ่งที่ตัดสินใจหรือป้อนไว้ที่นี่แล้วจะคงเดิม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir yedeği, örneğin yeni bir telefona aktarır. Fotoğraflar ad, boyut ve çekim zamanıyla yeniden bulunur. Burada zaten karar verilmiş veya girilmiş olanlar olduğu gibi kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переносить резервну копію, наприклад на новий телефон. Фото знаходяться за назвою, розміром і часом зйомки. Те, що тут уже вирішено чи записано, лишається як є."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بیک اپ لاتا ہے، مثلاً نئے فون پر۔ تصاویر نام، سائز اور لینے کے وقت سے دوبارہ مل جاتی ہیں۔ جو یہاں پہلے سے طے یا درج ہے، وہ ویسا ہی رہتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nạp lại bản sao lưu, ví dụ trên điện thoại mới. Ảnh được tìm lại theo tên, kích thước và thời gian chụp. Những gì đã quyết định hoặc đã nhập ở đây vẫn giữ nguyên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入一份备份，例如在新手机上。照片会通过名称、大小和拍摄时间重新找到。此处已做出的决定或已输入的内容保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯入備份，例如在新手機上。照片會依名稱、大小和拍攝時間重新找到。這裡已決定或輸入的內容保持不變。"
          }
        }
      }
    },
