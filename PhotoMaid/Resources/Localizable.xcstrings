    "org_tag_delete_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يختفي الوسم من كل الوسائط. تبقى الملفات دون تغيير."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ট্যাগটি সব জায়গা থেকে মুছে যায়। ফটো ও ভিডিওগুলো নিজে অপরিবর্তিত থাকে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’etiqueta desapareix de tot arreu. Les fotos i els vídeos no canvien."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Štítek zmizí všude. Samotné fotky a videa zůstanou beze změny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagget forsvinder overalt. Selve fotos og videoer forbliver uændrede."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Schlagwort verschwindet überall. Die Fotos und Videos selbst bleiben unverändert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ετικέτα εξαφανίζεται παντού. Οι ίδιες οι φωτογραφίες και τα βίντεο μένουν αμετάβλητα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The tag disappears everywhere. The photos and videos themselves stay unchanged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La etiqueta desaparece de todo el contenido. Los archivos no cambian."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunniste katoaa kaikkialta. Kuvat ja videot itse pysyvät ennallaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mot-clé disparaît de tous les médias. Les fichiers restent inchangés."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ટૅગ બધેથી ગાયબ થાય છે. ફોટા અને વીડિયો પોતે બદલાતા નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התגית נעלמת מכל מקום. התמונות והסרטונים עצמם לא משתנים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टैग हर जगह से हट जाता है। फ़ोटो और वीडियो खुद नहीं बदलते।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznaka nestaje posvuda. Same fotografije i videozapisi ostaju nepromijenjeni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A címke mindenhonnan eltűnik. Maguk a fotók és videók változatlanok maradnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tag hilang di mana-mana. Foto dan videonya sendiri tidak berubah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tag scompare da tutti i contenuti. I file restano invariati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タグはすべてのメディアから消えます。ファイルは変わりません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಟ್ಯಾಗ್ ಎಲ್ಲೆಡೆಯಿಂದ ಮಾಯವಾಗುತ್ತದೆ. ಫೋಟೋಗಳು ಮತ್ತು ವೀಡಿಯೊಗಳು ಸ್ವತಃ ಬದಲಾಗದೆ ಉಳಿಯುತ್ತವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 미디어에서 태그가 사라져요. 파일은 그대로예요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ടാഗ് എല്ലായിടത്തുനിന്നും അപ്രത്യക്ഷമാകും. ഫോട്ടോകൾക്കും വീഡിയോകൾക്കും മാറ്റമുണ്ടാകില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "टॅग सर्वत्र नाहीसा होतो. फोटो आणि व्हिडिओ स्वतः बदलत नाहीत."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tag hilang di semua tempat. Foto dan video itu sendiri kekal tidak berubah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Etiketten forsvinner overalt. Selve bildene og videoene forblir uendret."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het label verdwijnt van alle media. De bestanden blijven ongewijzigd."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଟ୍ୟାଗ୍ ସବୁଠାରୁ ଚାଲିଯାଏ। ଫଟୋ ଓ ଭିଡିଓ ନିଜେ ଅପରିବର୍ତ୍ତିତ ରହେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਟੈਗ ਹਰ ਥਾਂ ਤੋਂ ਗ਼ਾਇਬ ਹੋ ਜਾਂਦਾ ਹੈ। ਫ਼ੋਟੋਆਂ ਅਤੇ ਵੀਡੀਓ ਖ਼ੁਦ ਬਿਨਾਂ ਬਦਲੇ ਰਹਿੰਦੀਆਂ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tag zniknie ze wszystkich multimediów. Pliki pozostają bez zmian."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A etiqueta some de todos os lugares. As fotos e vídeos em si não são alterados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A etiqueta desaparece de todos os conteúdos. Os ficheiros ficam inalterados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Eticheta dispare de pe tot conținutul. Fișierele rămân neschimbate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Метка исчезнет со всех медиа. Файлы не изменятся."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Štítok zmizne všade. Samotné fotky a videá zostanú bez zmeny."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznaka povsod izgine. Same fotografije in videoposnetki ostanejo nespremenjeni."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Taggen försvinner överallt. Själva bilderna och videorna förblir oförändrade."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "குறிச்சொல் எல்லா இடங்களிலிருந்தும் மறையும். புகைப்படங்களும் வீடியோக்களும் மாறாமல் இருக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ట్యాగ్ అన్నిచోట్ల నుండి మాయమవుతుంది. ఫోటోలు, వీడియోలు మారవు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แท็กจะหายไปทุกที่ รูปภาพและวิดีโอเองไม่เปลี่ยนแปลง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etiket tüm medyadan kalkar. Dosyalar değişmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мітка зникне з усіх медіа. Файли не зміняться."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹیگ ہر جگہ سے ہٹ جاتا ہے۔ تصاویر اور ویڈیوز خود تبدیل نہیں ہوتیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thẻ biến mất ở mọi nơi. Bản thân ảnh và video không thay đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该标签将从所有媒体中消失。文件保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標籤會從所有地方消失。照片和影片本身保持不變。"
          }
        }
      }
    },
