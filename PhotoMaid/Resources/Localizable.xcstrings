    "org_albums_footer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الألبومات موجودة في GaleriQ فقط. تُظهر المجلدات مكان تخزين الملف، وتجد المجموعات الوسائط وفق شرط."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Albums exist only in GaleriQ. Folders show where a file is stored; collections find photos by a condition."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alben gibt es nur in GaleriQ. Ordner zeigen, wo eine Datei liegt; Sammlungen finden Fotos über eine Bedingung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Albums exist only in GaleriQ. Folders show where a file is stored; collections find photos by a condition."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los álbumes solo existen en GaleriQ. Las carpetas muestran dónde está un archivo; las colecciones encuentran contenido según una condición."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les albums n’existent que dans GaleriQ. Les dossiers indiquent où se trouve un fichier ; les collections trouvent des médias selon une condition."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Albums exist only in GaleriQ. Folders show where a file is stored; collections find photos by a condition."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli album esistono solo in GaleriQ. Le cartelle mostrano dove si trova un file; le raccolte trovano i contenuti in base a una condizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アルバムはGaleriQの中だけのものです。フォルダはファイルの保存場所、コレクションは条件で見つけたメディアです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앨범은 GaleriQ 안에만 있어요. 폴더는 파일이 저장된 위치를, 모음은 조건으로 찾은 미디어를 보여 줘요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Albums exist only in GaleriQ. Folders show where a file is stored; collections find photos by a condition."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Albums bestaan alleen in GaleriQ. Mappen tonen waar een bestand staat; collecties vinden media via een voorwaarde."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Albumy istnieją tylko w GaleriQ. Foldery pokazują, gdzie leży plik; kolekcje znajdują multimedia według warunku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Albums exist only in GaleriQ. Folders show where a file is stored; collections find photos by a condition."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os álbuns só existem no GaleriQ. As pastas mostram onde está um ficheiro; as coleções encontram multimédia por uma condição."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Albumele există doar în GaleriQ. Dosarele arată unde se află un fișier; colecțiile găsesc conținut după o condiție."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Альбомы есть только в GaleriQ. Папки показывают, где лежит файл; подборки находят медиа по условию."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Albums exist only in GaleriQ. Folders show where a file is stored; collections find photos by a condition."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Albums exist only in GaleriQ. Folders show where a file is stored; collections find photos by a condition."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Albümler yalnızca GaleriQ’de vardır. Klasörler dosyanın nerede olduğunu gösterir; koleksiyonlar medyayı bir koşula göre bulur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Альбоми є лише в GaleriQ. Папки показують, де лежить файл; добірки знаходять медіа за умовою."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Albums exist only in GaleriQ. Folders show where a file is stored; collections find photos by a condition."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相册只存在于 GaleriQ 中。文件夹显示文件的存储位置，合集按条件查找媒体。"
