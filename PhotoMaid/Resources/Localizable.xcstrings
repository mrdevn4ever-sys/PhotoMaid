    "ana_footer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل التحليل على هذا الـ iPhone فقط (Apple Vision). النتائج اقتراحات – والقرار لك في الموجز. لا يُرفع أي شيء ولا يُحذف تلقائيًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Analyse läuft nur auf diesem iPhone (Apple Vision). Ergebnisse sind Vorschläge – entscheiden tust du im Feed. Nichts wird hochgeladen oder automatisch gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Analysis runs only on this iPhone (Apple Vision). Results are suggestions – you decide in the feed. Nothing is uploaded or deleted automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El análisis se realiza solo en este iPhone (Apple Vision). Los resultados son sugerencias: tú decides en el feed. No se sube ni se borra nada automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’analyse se fait uniquement sur cet iPhone (Apple Vision). Les résultats sont des suggestions – c’est vous qui décidez dans le flux. Rien n’est envoyé ni supprimé automatiquement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’analisi avviene solo su questo iPhone (Apple Vision). I risultati sono suggerimenti: decidi tu nel feed. Nulla viene caricato o eliminato automaticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "解析はこのiPhone上だけで行われます（Apple Vision）。結果は提案で、決めるのはフィードのあなたです。アップロードや自動削除はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "분석은 이 iPhone에서만 실행됩니다(Apple Vision). 결과는 제안일 뿐이며 결정은 피드에서 직접 합니다. 업로드되거나 자동으로 삭제되는 것은 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De analyse gebeurt alleen op deze iPhone (Apple Vision). Resultaten zijn suggesties – jij beslist in de feed. Er wordt niets geüpload of automatisch verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiza działa tylko na tym iPhonie (Apple Vision). Wyniki to sugestie – decydujesz Ty w przeglądzie. Nic nie jest wysyłane ani usuwane automatycznie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A análise é feita apenas neste iPhone (Apple Vision). Os resultados são sugestões – é você quem decide no feed. Nada é carregado nem apagado automaticamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiza rulează doar pe acest iPhone (Apple Vision). Rezultatele sunt sugestii – tu decizi în flux. Nimic nu este încărcat sau șters automat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Анализ выполняется только на этом iPhone (Apple Vision). Результаты — это подсказки, решаете вы в ленте. Ничего не загружается и не удаляется автоматически."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiz yalnızca bu iPhone’da yapılır (Apple Vision). Sonuçlar öneridir – kararı akışta sen verirsin. Hiçbir şey yüklenmez veya otomatik silinmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Аналіз виконується лише на цьому iPhone (Apple Vision). Результати — це пропозиції, рішення ухвалюєте ви у стрічці. Нічого не завантажується й не видаляється автоматично."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分析仅在此 iPhone 上进行（Apple Vision）。结果只是建议——由你在浏览中决定。不会上传，也不会自动删除任何内容。"
          }
        }
      }
    },
