        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotocamera: colonna %1$lld, riga %2$lld. Foto: colonna %3$lld, riga %4$lld."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラ：%1$lld列、%2$lld行。写真：%3$lld列、%4$lld行。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라: %1$lld열, %2$lld행. 사진: %3$lld열, %4$lld행."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera: kolonne %1$lld, rad %2$lld. Bilde: kolonne %3$lld, rad %4$lld."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera: kolom %1$lld, rij %2$lld. Foto: kolom %3$lld, rij %4$lld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparat: kolumna %1$lld, wiersz %2$lld. Zdjęcie: kolumna %3$lld, wiersz %4$lld."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Câmera: coluna %1$lld, linha %2$lld. Foto: coluna %3$lld, linha %4$lld."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Câmara: coluna %1$lld, linha %2$lld. Foto: coluna %3$lld, linha %4$lld."
