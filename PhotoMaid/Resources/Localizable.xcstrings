    "archive_step_originals": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى ملفاتك الأصلية كما هي."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার মূল ফাইল যেমন আছে তেমনই থাকে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els originals es queden tal com són."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše originály zůstanou beze změny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine originaler forbliver, som de er."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Originale bleiben, wie sie sind."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα πρωτότυπά σου μένουν όπως είναι."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your originals stay as they are."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus originales se quedan como están."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Alkuperäiset pysyvät ennallaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos originaux restent tels quels."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારાં મૂળ જેમ છે તેમ જ રહેશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המקוריים שלך נשארים כמו שהם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके मूल जैसे हैं वैसे ही रहेंगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoji originali ostaju kakvi jesu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az eredetik változatlanok maradnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aslimu tetap seperti semula."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi originali restano come sono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元のファイルはそのまま残ります。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಮೂಲಗಳು ಹಾಗೆಯೇ ಉಳಿಯುತ್ತವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본은 그대로 남아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ഒറിജിനലുകൾ അതുപോലെ തുടരും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमची मूळ जशीच्या तशी राहतील."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Fail asal anda kekal seperti sedia ada."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Originalene dine forblir som de er."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je originelen blijven zoals ze zijn."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ ମୂଳ ଫାଇଲ୍ ଯେମିତି ଅଛି ସେମିତି ରହେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੇ ਮੂਲ ਜਿਵੇਂ ਹਨ ਉਵੇਂ ਹੀ ਰਹਿਣਗੇ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje oryginały pozostają bez zmian."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus originais continuam como estão."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os seus originais ficam como estão."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Originalele tale rămân neschimbate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши оригиналы остаются без изменений."
          }
        },
        "sk": {
