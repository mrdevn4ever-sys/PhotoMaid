        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua anche se passi a un’altra app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのアプリに切り替えても続行します。"
