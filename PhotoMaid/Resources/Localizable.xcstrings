    "movie_kenburns_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقترب الصور ببطء حتى لا تبدو جامدة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos zoomer langsomt ind, så de ikke virker statiske."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos zoomen langsam heran, damit sie nicht starr wirken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos zoom in slowly so they don’t look static."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos se acercan despacio para que no parezcan estáticas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos zooment lentement pour ne pas paraître figées."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto perlahan diperbesar agar tidak terlihat diam."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le foto si avvicinano lentamente per non sembrare statiche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真がゆっくりズームし、止まって見えないようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진이 천천히 확대되어 정지된 느낌이 덜해요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildene zoomer sakte inn så de ikke virker statiske."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto’s zoomen langzaam in, zodat ze niet statisch ogen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdjęcia powoli się przybliżają, żeby nie wyglądały statycznie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As fotos se aproximam devagar para não parecerem paradas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As fotografias aproximam-se lentamente para não parecerem estáticas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografiile se apropie lent, ca să nu pară statice."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото медленно приближаются и не выглядят застывшими."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilderna zoomar in långsamt så att de inte ser stillastående ut."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปจะซูมเข้าช้าๆ ไม่ให้ดูนิ่ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraflar durağan görünmesin diye yavaşça yakınlaşır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото повільно наближаються й не виглядають застиглими."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh từ từ phóng to để không trông tĩnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片缓慢放大，看起来不呆板。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "照片會慢慢放大，看起來不會太靜態。"
          }
        }
      }
    },
