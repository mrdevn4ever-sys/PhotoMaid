    "vault2_operation_failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يكتمل الإجراء. تحقّق من المساحة والأذونات ثم أعد المحاولة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Handlingen blev ikke gennemført. Tjek lagerplads og adgang, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aktion wurde nicht erfolgreich abgeschlossen. Prüfe Speicherplatz und Zugriff und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The action did not complete successfully. Check storage space and access, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La acción no se completó. Comprueba el espacio y los permisos y reinténtalo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’action n’a pas abouti. Vérifiez l’espace disponible et les autorisations, puis réessayez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tindakan tidak berhasil diselesaikan. Periksa ruang penyimpanan dan akses, lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’azione non è riuscita. Controlla spazio e autorizzazioni, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "処理が完了しませんでした。空き容量とアクセス権を確認して再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업을 완료하지 못했습니다. 저장 공간과 접근 권한을 확인한 뒤 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Handlingen ble ikke fullført. Sjekk lagringsplass og tilgang, og prøv igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De actie is niet voltooid. Controleer opslagruimte en toegang en probeer opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ukończono operacji. Sprawdź wolne miejsce i dostęp, a potem spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A ação não foi concluída. Verifique o espaço de armazenamento e o acesso e tente de novo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A ação não foi concluída. Verifica o espaço e as permissões e tenta novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acțiunea nu s-a finalizat. Verifică spațiul și accesul, apoi încearcă din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Действие не завершено. Проверьте свободное место и доступ, затем повторите."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Åtgärden slutfördes inte. Kontrollera lagringsutrymme och åtkomst och försök igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การดำเนินการไม่สำเร็จ ตรวจสอบพื้นที่จัดเก็บและการเข้าถึง แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşlem tamamlanamadı. Depolama alanını ve erişimi kontrol edip tekrar dene."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дію не завершено. Перевірте вільне місце й доступ, потім повторіть."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác chưa hoàn tất. Hãy kiểm tra dung lượng và quyền truy cập rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作未完成。请检查存储空间和访问权限后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "動作未成功完成。請檢查儲存空間和取用權限，然後再試一次。"
          }
        }
      }
    },
