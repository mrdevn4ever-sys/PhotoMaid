    "basket_confirm_delete_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ثم أكِّد لدى Android. لن تذهب هذه الصور والفيديوهات إلى سلة مهملات Android ولا يمكن استعادتها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Then confirm with Android. These photos and videos will not go to the Android trash and cannot be restored."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Then confirm with Android. These photos and videos will not go to the Android trash and cannot be restored."
          }
