    "vault_backup_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الخزنة مشفّرة ومضمّنة في نسخة iPhone الاحتياطية. إذا حذفت GaleriQ، تُحذف الخزنة أيضًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভল্টটি এনক্রিপ্ট করা এবং আপনার iPhone ব্যাকআপে অন্তর্ভুক্ত। GaleriQ মুছে ফেললে ভল্টও মুছে যায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La caixa forta està xifrada i s’inclou a la còpia de seguretat de l’iPhone. Si esborres GaleriQ, també s’esborra la caixa forta."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Trezor je šifrovaný a je součástí zálohy iPhonu. Pokud GaleriQ smažete, smaže se i trezor."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Boksen er krypteret og indgår i din iPhone-sikkerhedskopi. Hvis du sletter GaleriQ, slettes boksen også."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Tresor ist verschlüsselt und in deinem iPhone-Backup enthalten. Löschst du GaleriQ, ist auch der Tresor weg."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το θησαυροφυλάκιο είναι κρυπτογραφημένο και περιλαμβάνεται στο αντίγραφο ασφαλείας του iPhone. Αν διαγράψεις το GaleriQ, διαγράφεται και το θησαυροφυλάκιο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The vault is encrypted and included in your iPhone backup. If you delete GaleriQ, the vault is deleted too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La caja fuerte está cifrada y se incluye en la copia de seguridad de tu iPhone. Si eliminas GaleriQ, la caja fuerte también se elimina."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Holvi on salattu ja sisältyy iPhonesi varmuuskopioon. Jos poistat GaleriQ:n, myös holvi poistetaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le coffre-fort est chiffré et inclus dans la sauvegarde de ton iPhone. Si tu supprimes GaleriQ, le coffre-fort est supprimé aussi."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "વૉલ્ટ એન્ક્રિપ્ટેડ છે અને તમારા iPhone બૅકઅપમાં સામેલ છે. તમે GaleriQ ડિલીટ કરો તો વૉલ્ટ પણ ડિલીટ થાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הכספת מוצפנת ונכללת בגיבוי של ה-iPhone. מחיקת GaleriQ מוחקת גם את הכספת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तिजोरी एन्क्रिप्टेड है और आपके iPhone बैकअप में शामिल है। अगर आप GaleriQ डिलीट करते हैं, तो तिजोरी भी डिलीट हो जाती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trezor je šifriran i uključen u sigurnosnu kopiju iPhonea. Ako izbrišeš GaleriQ, briše se i trezor."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A széf titkosított, és része az iPhone biztonsági mentésének. Ha törlöd a GaleriQ-t, a széf is törlődik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Brankas terenkripsi dan termasuk dalam cadangan iPhone-mu. Jika kamu menghapus GaleriQ, brankas juga terhapus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cassaforte è crittografata e inclusa nel backup del tuo iPhone. Se elimini GaleriQ, viene eliminata anche la cassaforte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保管庫は暗号化され、iPhoneのバックアップに含まれます。GaleriQを削除すると、保管庫も削除されます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ವಾಲ್ಟ್ ಎನ್‌ಕ್ರಿಪ್ಟ್ ಆಗಿದೆ ಮತ್ತು ನಿಮ್ಮ iPhone ಬ್ಯಾಕಪ್‌ನಲ್ಲಿ ಸೇರಿದೆ. ನೀವು GaleriQ ಅಳಿಸಿದರೆ ವಾಲ್ಟ್ ಕೂಡ ಅಳಿಸಲಾಗುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "금고는 암호화되어 iPhone 백업에 포함됩니다. GaleriQ를 삭제하면 금고도 삭제됩니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വോൾട്ട് എൻക്രിപ്റ്റ് ചെയ്തതും നിങ്ങളുടെ iPhone ബാക്കപ്പിൽ ഉൾപ്പെടുന്നതുമാണ്. നിങ്ങൾ GaleriQ ഇല്ലാതാക്കിയാൽ വോൾട്ടും ഇല്ലാതാകും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "व्हॉल्ट एन्क्रिप्ट केलेला आहे आणि तुमच्या iPhone बॅकअपमध्ये समाविष्ट आहे. तुम्ही GaleriQ डिलीट केल्यास व्हॉल्टही डिलीट होतो."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Peti besi disulitkan dan termasuk dalam sandaran iPhone anda. Jika anda memadam GaleriQ, peti besi turut dipadam."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Safen er kryptert og inngår i iPhone-sikkerhetskopien din. Hvis du sletter GaleriQ, slettes også safen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De kluis is versleuteld en zit in je iPhone-reservekopie. Als je GaleriQ verwijdert, wordt de kluis ook verwijderd."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଭଲ୍ଟ ଏନକ୍ରିପ୍ଟେଡ୍ ଏବଂ ଆପଣଙ୍କ iPhone ବ୍ୟାକଅପ୍‌ରେ ଅନ୍ତର୍ଭୁକ୍ତ। ଆପଣ GaleriQ ଡିଲିଟ୍ କଲେ ଭଲ୍ଟ ମଧ୍ୟ ଡିଲିଟ୍ ହୁଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਵੌਲਟ ਇਨਕ੍ਰਿਪਟਡ ਹੈ ਅਤੇ ਤੁਹਾਡੇ iPhone ਬੈਕਅੱਪ ਵਿੱਚ ਸ਼ਾਮਲ ਹੈ। ਜੇ ਤੁਸੀਂ GaleriQ ਮਿਟਾਉਂਦੇ ਹੋ, ਤਾਂ ਵੌਲਟ ਵੀ ਮਿਟ ਜਾਂਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sejf jest zaszyfrowany i znajduje się w kopii zapasowej Twojego iPhone’a. Jeśli usuniesz GaleriQ, sejf też zostanie usunięty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cofre é criptografado e incluído no backup do seu iPhone. Se você apagar o GaleriQ, o cofre também será apagado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O cofre está encriptado e incluído na cópia de segurança do teu iPhone. Se apagares o GaleriQ, o cofre também é apagado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Seiful este criptat și inclus în backupul iPhone-ului tău. Dacă ștergi GaleriQ, se șterge și seiful."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейф зашифрован и входит в резервную копию iPhone. Если удалишь GaleriQ, сейф тоже удалится."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Trezor je šifrovaný a je súčasťou zálohy iPhonu. Ak GaleriQ vymažete, vymaže sa aj trezor."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sef je šifriran in vključen v varnostno kopijo iPhona. Če izbrišeš GaleriQ, se izbriše tudi sef."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Valvet är krypterat och ingår i din iPhone-säkerhetskopia. Om du raderar GaleriQ raderas även valvet."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "லாக்கர் குறியாக்கப்பட்டது, உங்கள் iPhone காப்புப்பிரதியில் அடங்கும். GaleriQ-ஐ நீக்கினால் லாக்கரும் நீக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వాల్ట్ ఎన్‌క్రిప్ట్ అయింది, మీ iPhone బ్యాకప్‌లో చేరి ఉంది. మీరు GaleriQను తొలగిస్తే వాల్ట్ కూడా తొలగించబడుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตู้เซฟถูกเข้ารหัสและรวมอยู่ในข้อมูลสำรอง iPhone ของคุณ หากคุณลบ GaleriQ ตู้เซฟจะถูกลบด้วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasa şifrelidir ve iPhone yedeğine dahildir. GaleriQ’i silersen kasa da silinir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейф зашифровано, і він входить до резервної копії iPhone. Якщо видалиш GaleriQ, сейф теж буде видалено."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "والٹ خفیہ ہے اور آپ کے iPhone بیک اپ میں شامل ہے۔ اگر آپ GaleriQ حذف کرتے ہیں تو والٹ بھی حذف ہو جاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Két sắt được mã hóa và có trong bản sao lưu iPhone. Nếu bạn xóa GaleriQ, két sắt cũng bị xóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保险箱已加密，并包含在你的 iPhone 备份中。如果删除 GaleriQ，保险箱也会被删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保險箱已加密，並包含在你的 iPhone 備份中。如果刪除 GaleriQ，保險箱也會被刪除。"
          }
        }
      }
    },
