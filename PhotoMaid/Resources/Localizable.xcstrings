    "dup_none_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم نجد نسخًا متطابقة في الأقسام المتاحة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der blev ikke fundet identiske kopier i de tilgængelige områder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In den zugänglichen Bereichen wurden keine identischen Kopien gefunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No identical copies were found in the accessible areas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han encontrado copias idénticas en las zonas accesibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune copie identique n’a été trouvée dans les zones accessibles."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ditemukan salinan identik di area yang dapat diakses."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non sono state trovate copie identiche nelle aree accessibili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセスできる範囲に、内容が完全に同じコピーはありませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "접근할 수 있는 영역에서 내용이 완전히 같은 사본을 찾지 못했어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fant ingen identiske kopier i de tilgjengelige områdene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn geen identieke kopieën gevonden in de toegankelijke gedeelten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono identycznych kopii w dostępnych obszarach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma cópia idêntica foi encontrada nas áreas acessíveis."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foram encontradas cópias idênticas nas áreas acessíveis."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu s-au găsit copii identice în zonele accesibile."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В доступных разделах одинаковые копии не найдены."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga identiska kopior hittades i de tillgängliga områdena."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่พบสำเนาที่เหมือนกันในพื้นที่ที่เข้าถึงได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişilebilen alanlarda birebir aynı kopya bulunamadı."
