          "stringUnit": {
            "state": "translated",
            "value": "Upravená fotka. Podržením zobrazíte originál."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Redigeret foto. Hold fingeren på for at se originalen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bearbeitetes Foto. Halten zeigt das Original."
          }
        },
