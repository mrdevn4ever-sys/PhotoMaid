      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن يظهر «%1$@» أثناء الترتيب بعد الآن"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পরিষ্কার করার সময় “%1$@” আর দেখা যাবে না"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» ja no apareixerà en endreçar"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ se při úklidu už nebude zobrazovat"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” vises ikke længere, når du rydder op"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ wird beim Aufräumen nicht mehr gezeigt"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το «%1$@» δεν θα εμφανίζεται πια στο τακτοποίημα"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” will no longer show up while cleaning up"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» ya no aparecerá al ordenar"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "”%1$@” ei enää näy siivotessa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %1$@ » n’apparaîtra plus pendant le tri"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” હવે સાફસફાઈ દરમિયાન દેખાશે નહીં"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@” לא יופיע יותר בזמן הסידור"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” अब सफ़ाई के दौरान नहीं दिखेगा"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@” se više neće prikazivati pri raščišćavanju"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) „%1$@” nem jelenik meg többé rendrakáskor"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” tidak akan muncul lagi saat merapikan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» non comparirà più durante il riordino"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」は整理時に表示されなくなりました"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ವಚ್ಛಗೊಳಿಸುವಾಗ “%1$@” ಇನ್ನು ಕಾಣಿಸುವುದಿಲ್ಲ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%1$@’은(는) 이제 정리할 때 나타나지 않아요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വൃത്തിയാക്കുമ്പോൾ “%1$@” ഇനി ദൃശ്യമാകില്ല"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” आता साफसफाई करताना दिसणार नाही"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” tidak akan dipaparkan lagi semasa mengemas"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» vises ikke lenger når du rydder"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%1$@’ verschijnt niet meer tijdens het opruimen"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସଫା କରିବା ସମୟରେ “%1$@” ଆଉ ଦେଖାଯିବ ନାହିଁ"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” ਸਫ਼ਾਈ ਕਰਦੇ ਸਮੇਂ ਹੁਣ ਨਹੀਂ ਦਿਸੇਗੀ"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@” nie będzie już pokazywany podczas porządkowania"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” não aparecerá mais durante a limpeza"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” deixa de aparecer ao arrumar"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@” nu mai apare la ordonare"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» больше не будет показываться при наведении порядка"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ sa pri upratovaní už nebude zobrazovať"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "»%1$@« se pri čiščenju ne bo več prikazoval"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”%1$@” visas inte längre när du rensar"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சுத்தம் செய்யும்போது “%1$@” இனி தோன்றாது"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "శుభ్రం చేసేటప్పుడు “%1$@” ఇక కనిపించదు"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” จะไม่ปรากฏขณะจัดระเบียบอีก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” artık düzenlerken gösterilmeyecek"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» більше не показуватиметься під час упорядкування"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "”%1$@“ اب صفائی کے دوران نہیں دکھے گا"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” sẽ không còn xuất hiện khi dọn dẹp"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "整理时将不再显示“%1$@”"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "整理時將不再顯示「%1$@」"
          }
        }
      }
    },
