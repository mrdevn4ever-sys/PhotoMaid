    "vault2_restore_explanation": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُضاف النسخة المُتحقّق منها إلى الخزنة المفتوحة دون استبدال المحتوى. تكرار الاستيراد ينشئ نسخًا إضافية."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den kontrollerede sikkerhedskopi tilføjes som en ekstra kopi i den åbne boks. Eksisterende indhold overskrives ikke. Gentagne importer opretter flere kopier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das geprüfte Backup wird als zusätzliche Kopie in den geöffneten Tresor eingefügt. Vorhandene Inhalte werden nicht überschrieben. Wiederholtes Importieren erzeugt weitere Kopien."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The verified backup is added as an extra copy to the open vault. Existing content is not overwritten. Repeated imports create additional copies."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia verificada se añade a la caja fuerte abierta. No se sobrescribe nada. Repetir la importación crea más copias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sauvegarde vérifiée est ajoutée au coffre ouvert. Rien n’est écrasé. Chaque nouvel import crée des copies supplémentaires."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cadangan yang sudah diperiksa ditambahkan sebagai salinan tambahan ke brankas yang terbuka. Konten yang ada tidak ditimpa. Impor berulang membuat salinan tambahan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il backup verificato viene aggiunto alla cassaforte aperta. Nulla viene sovrascritto. Importazioni ripetute creano altre copie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検証済みバックアップを開いている保管庫へ追加します。既存の内容は上書きしません。繰り返し読み込むとコピーが増えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검증된 백업을 열린 보관함에 추가합니다. 기존 내용은 덮어쓰지 않습니다. 반복해서 가져오면 사본이 추가됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den kontrollerte sikkerhetskopien legges til som en ekstra kopi i den åpne safen. Eksisterende innhold overskrives ikke. Gjentatte importer lager flere kopier."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De gecontroleerde back-up wordt als extra kopie toegevoegd. Bestaande inhoud wordt niet overschreven. Opnieuw importeren maakt extra kopieën."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdzona kopia zostanie dodana do otwartego sejfu. Nic nie zostanie nadpisane. Ponowny import tworzy kolejne kopie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O backup verificado é adicionado como cópia extra ao cofre aberto. O conteúdo existente não é substituído. Importações repetidas criam cópias adicionais."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A cópia verificada é adicionada ao cofre aberto. Nada é substituído. Importações repetidas criam mais cópias."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia verificată este adăugată în seiful deschis. Nimic nu este suprascris. Importurile repetate creează copii suplimentare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверенная копия добавляется в открытый сейф без перезаписи. Повторный импорт создаёт дополнительные копии."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den kontrollerade säkerhetskopian läggs till som en extra kopia i det öppna valvet. Befintligt innehåll skrivs inte över. Upprepade importer skapar fler kopior."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูลสำรองที่ตรวจสอบแล้วจะถูกเพิ่มเป็นสำเนาเพิ่มเติมในตู้เซฟที่เปิดอยู่ เนื้อหาที่มีอยู่จะไม่ถูกเขียนทับ การนำเข้าซ้ำจะสร้างสำเนาเพิ่ม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doğrulanmış yedek açık kasaya ek kopya olarak eklenir. Mevcut içerik üzerine yazılmaz. Tekrar içe aktarmak ek kopyalar oluşturur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевірена копія додається до відкритого сховища без перезапису. Повторний імпорт створює додаткові копії."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản sao lưu đã kiểm tra được thêm vào két sắt đang mở như một bản sao bổ sung. Nội dung hiện có không bị ghi đè. Nhập nhiều lần sẽ tạo thêm bản sao."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "验证后的备份将作为额外副本添加到已打开的保险库，不覆盖现有内容。重复导入会产生更多副本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "驗證過的備份會作為額外副本加入已打開的保險箱。現有內容不會被覆蓋。重複匯入會產生更多副本。"
          }
        }
      }
    },
