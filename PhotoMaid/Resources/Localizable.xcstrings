    "today_reconciliation": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقطع شيء ما عند آخر إفراغ لسلة المهملات. للأمان لن يُحذف أي شيء مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শেষবার ট্র্যাশ খালি করার সময় কিছু বাধাপ্রাপ্ত হয়েছিল। নিরাপত্তার জন্য কিছুই আবার মুছে ফেলা হয় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’última vegada que es va buidar la paperera s’hi va interrompre alguna cosa. Per seguretat, no es torna a esborrar res."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při posledním vyprazdňování koše se něco přerušilo. Pro jistotu se nic znovu nemaže."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Noget blev afbrudt, sidst papirkurven blev tømt. For en sikkerheds skyld slettes intet igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim letzten Leeren des Papierkorbs wurde etwas unterbrochen. Zur Sicherheit wird nichts noch einmal gelöscht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάτι διακόπηκε την τελευταία φορά που άδειασε ο κάδος. Για ασφάλεια, τίποτα δεν διαγράφεται ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something was interrupted the last time the trash was emptied. To be safe, nothing is deleted again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo se interrumpió la última vez que se vació la papelera. Por seguridad, no se vuelve a borrar nada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokin keskeytyi, kun roskakori viimeksi tyhjennettiin. Varmuuden vuoksi mitään ei poisteta uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelque chose a été interrompu lors du dernier vidage de la corbeille. Par sécurité, rien n’est supprimé à nouveau."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "છેલ્લે ટ્રેશ ખાલી કરતી વખતે કંઈક અટક્યું હતું. સુરક્ષા માટે કંઈ ફરી ડિલીટ થતું નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משהו נקטע בפעם האחרונה שהפח רוקן. ליתר ביטחון, שום דבר לא נמחק שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिछली बार ट्रैश खाली करते समय कुछ रुक गया था। सुरक्षा के लिए कुछ भी दोबारा डिलीट नहीं होता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pri posljednjem pražnjenju smeća nešto je prekinuto. Radi sigurnosti ništa se ne briše ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kuka legutóbbi ürítésekor valami megszakadt. A biztonság kedvéért semmi sem törlődik újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ada yang terputus saat terakhir sampah dikosongkan. Demi keamanan, tidak ada yang dihapus lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualcosa si è interrotto l’ultima volta che è stato svuotato il cestino. Per sicurezza non viene eliminato nulla di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回ゴミ箱を空にしたときに何かが中断されました。念のため、もう一度削除することはありません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕಳೆದ ಬಾರಿ ಕಸದ ಬುಟ್ಟಿ ಖಾಲಿ ಮಾಡುವಾಗ ಏನೋ ಅಡಚಣೆಯಾಯಿತು. ಸುರಕ್ಷತೆಗಾಗಿ ಏನನ್ನೂ ಮತ್ತೆ ಅಳಿಸಲಾಗುವುದಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지난번 휴지통을 비울 때 무언가 중단됐어요. 안전을 위해 아무것도 다시 지우지 않아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കഴിഞ്ഞ തവണ ട്രാഷ് ശൂന്യമാക്കുമ്പോൾ എന്തോ തടസ്സപ്പെട്ടു. സുരക്ഷയ്ക്കായി ഒന്നും വീണ്ടും ഇല്ലാതാക്കില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मागच्या वेळी ट्रॅश रिकामा करताना काहीतरी अडले होते. सुरक्षिततेसाठी काहीही पुन्हा डिलीट होत नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesuatu telah terganggu kali terakhir sampah dikosongkan. Demi keselamatan, tiada apa dipadam semula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Noe ble avbrutt sist papirkurven ble tømt. For sikkerhets skyld slettes ingenting på nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij het laatste legen van de prullenbak is iets onderbroken. Voor de zekerheid wordt niets opnieuw verwijderd."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଶେଷ ଥର ଟ୍ରାସ ଖାଲି କରିବା ସମୟରେ କିଛି ବାଧାପ୍ରାପ୍ତ ହୋଇଥିଲା। ସୁରକ୍ଷା ପାଇଁ କିଛି ପୁଣି ଡିଲିଟ୍ ହୁଏ ନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪਿਛਲੀ ਵਾਰ ਰੱਦੀ ਖਾਲੀ ਕਰਦੇ ਸਮੇਂ ਕੁਝ ਰੁਕ ਗਿਆ ਸੀ। ਸੁਰੱਖਿਆ ਲਈ ਕੁਝ ਵੀ ਦੁਬਾਰਾ ਨਹੀਂ ਮਿਟਾਇਆ ਜਾਂਦਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podczas ostatniego opróżniania kosza coś zostało przerwane. Dla bezpieczeństwa nic nie zostanie usunięte ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo foi interrompido da última vez que a lixeira foi esvaziada. Por segurança, nada é apagado de novo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo foi interrompido da última vez que o lixo foi esvaziado. Por segurança, nada é eliminado de novo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceva s-a întrerupt ultima dată când a fost golit coșul. Din siguranță, nu se mai șterge nimic din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В прошлый раз при очистке корзины что-то прервалось. Для надёжности ничего не будет удалено повторно."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pri poslednom vyprázdňovaní koša sa niečo prerušilo. Pre istotu sa nič znova nemaže."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ob zadnjem praznjenju koša je bilo nekaj prekinjeno. Zaradi varnosti se nič ne izbriše znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Något avbröts förra gången papperskorgen tömdes. För säkerhets skull raderas inget igen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கடந்த முறை குப்பையைக் காலி செய்யும்போது ஏதோ இடைமறிக்கப்பட்டது. பாதுகாப்பிற்காக எதுவும் மீண்டும் நீக்கப்படாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చివరిసారి ట్రాష్ ఖాళీ చేసేటప్పుడు ఏదో అంతరాయం కలిగింది. భద్రత కోసం ఏదీ మళ్లీ తొలగించబడదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีการขัดจังหวะในการล้างถังขยะครั้งล่าสุด เพื่อความปลอดภัย จะไม่ลบอะไรซ้ำ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çöp kutusu son boşaltılırken bir şey yarıda kaldı. Güvenlik için hiçbir şey yeniden silinmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Минулого разу під час очищення кошика щось перервалося. Для надійності нічого не буде видалено повторно."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پچھلی بار ردی خالی کرتے وقت کچھ رک گیا تھا۔ احتیاطاً کچھ بھی دوبارہ حذف نہیں ہوتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lần dọn thùng rác trước đã bị gián đoạn. Để an toàn, sẽ không xóa gì lại."
          }
        },
        "zh-Hans": {
