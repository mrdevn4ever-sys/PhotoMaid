        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방법은 이게 전부예요. 이제 내 사진을 정리해요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slik fungerer det. Nå til bildene dine."
