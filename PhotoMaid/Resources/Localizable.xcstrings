    "memory_selection": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر من صورتين إلى 18 صورة. تبقى معاينات صغيرة في الذاكرة فقط أثناء فتح GaleriQ. صور الخزنة مستبعدة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Choose 2–18 photos. Only small previews stay in memory while GaleriQ is open. Vault photos are excluded."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle 2–18 Fotos. Nur kleine Vorschauen bleiben im Speicher, solange GaleriQ geöffnet ist. Tresorfotos sind ausgeschlossen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose 2–18 photos. Only small previews stay in memory while GaleriQ is open. Vault photos are excluded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige de 2 a 18 fotos. Solo se guardan pequeñas vistas previas en memoria mientras GaleriQ está abierto. Se excluyen las fotos de la caja fuerte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez 2 à 18 photos. Seuls de petits aperçus restent en mémoire tant que GaleriQ est ouvert. Les photos du coffre sont exclues."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Choose 2–18 photos. Only small previews stay in memory while GaleriQ is open. Vault photos are excluded."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli da 2 a 18 foto. Solo piccole anteprime rimangono in memoria mentre GaleriQ è aperto. Le foto della cassaforte sono escluse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真を2〜18枚選びます。GaleriQを開いている間、小さなプレビューのみをメモリに保持します。金庫の写真は対象外です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 2~18장을 선택하세요. GaleriQ가 열려 있는 동안 작은 미리보기만 메모리에 유지됩니다. 금고 사진은 제외됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Choose 2–18 photos. Only small previews stay in memory while GaleriQ is open. Vault photos are excluded."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies 2–18 foto's. Alleen kleine voorvertoningen blijven in het geheugen zolang GaleriQ open is. Kluisfoto's zijn uitgesloten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz 2–18 zdjęć. Tylko małe podglądy pozostają w pamięci, gdy GaleriQ jest otwarty. Zdjęcia z sejfu są wykluczone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Choose 2–18 photos. Only small previews stay in memory while GaleriQ is open. Vault photos are excluded."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha 2–18 fotos. Apenas pequenas pré-visualizações ficam na memória enquanto o GaleriQ está aberto. As fotos do cofre são excluídas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege 2–18 poze. Doar previzualizări mici rămân în memorie cât timp GaleriQ este deschis. Pozele din seif sunt excluse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите 2–18 фото. Пока GaleriQ открыт, в памяти остаются только небольшие превью. Фото из сейфа исключены."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Choose 2–18 photos. Only small previews stay in memory while GaleriQ is open. Vault photos are excluded."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Choose 2–18 photos. Only small previews stay in memory while GaleriQ is open. Vault photos are excluded."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "2–18 fotoğraf seç. GaleriQ açıkken yalnızca küçük önizlemeler bellekte tutulur. Kasa fotoğrafları hariçtir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибери 2–18 фото. Поки GaleriQ відкрито, у пам’яті зберігаються лише невеликі прев’ю. Фото із сейфа виключено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Choose 2–18 photos. Only small previews stay in memory while GaleriQ is open. Vault photos are excluded."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择 2–18 张照片。GaleriQ 打开期间仅在内存中保留小尺寸预览，不使用保险箱中的照片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Choose 2–18 photos. Only small previews stay in memory while GaleriQ is open. Vault photos are excluded."
          }
        }
      }
