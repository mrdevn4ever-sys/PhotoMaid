    "game_records_save_failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نتائجك الجديدة متاحة في هذه الجلسة لكن تعذّر حفظها. حاول مجددًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার নতুন রেকর্ড এই সেশনে পাওয়া যাচ্ছে কিন্তু সংরক্ষণ করা যায়নি। আবার চেষ্টা করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els teus nous rècords estan disponibles en aquesta sessió, però no s’han pogut desar. Torna-ho a provar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše nové rekordy jsou k dispozici v této relaci, ale nepodařilo se je uložit. Zkuste to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine nye rekorder gælder i denne session, men kunne ikke gemmes. Prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine neuen Bestwerte sind für diese Sitzung verfügbar, konnten aber noch nicht gespeichert werden. Versuche es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα νέα σου ρεκόρ είναι διαθέσιμα σε αυτή τη συνεδρία, αλλά δεν αποθηκεύτηκαν. Δοκίμασε ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your new records are available for this session but could not be saved. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus nuevos récords están disponibles en esta sesión, pero no se pudieron guardar. Inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Uudet ennätyksesi ovat käytettävissä tällä kerralla, mutta niitä ei voitu tallentaa. Yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos nouveaux records sont disponibles pour cette session mais n’ont pas pu être enregistrés. Réessayez."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારા નવા રેકોર્ડ આ સત્રમાં ઉપલબ્ધ છે, પણ સાચવી શકાયા નથી. ફરી પ્રયાસ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השיאים החדשים שלך זמינים בסשן הזה, אבל לא ניתן היה לשמור אותם. כדאי לנסות שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके नए रिकॉर्ड इस सत्र में उपलब्ध हैं, लेकिन सहेजे नहीं जा सके। फिर कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoji novi rekordi dostupni su u ovoj sesiji, ali ih nije bilo moguće spremiti. Pokušaj ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az új rekordjaid ebben a munkamenetben elérhetők, de nem sikerült menteni őket. Próbáld újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekor barumu berlaku di sesi ini tapi tidak dapat disimpan. Coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I nuovi record sono disponibili per questa sessione ma non sono stati salvati. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新記録は今回のセッションで表示できますが、保存できませんでした。もう一度お試しください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಹೊಸ ದಾಖಲೆಗಳು ಈ ಸೆಷನ್‌ಗೆ ಲಭ್ಯವಿವೆ ಆದರೆ ಉಳಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ. ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 기록은 이번 세션에서 볼 수 있지만 저장되지 않았어요. 다시 시도하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ പുതിയ റെക്കോർഡുകൾ ഈ സെഷനിൽ ലഭ്യമാണ്, പക്ഷേ സംരക്ഷിക്കാനായില്ല. വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचे नवे विक्रम या सत्रात उपलब्ध आहेत, पण जतन करता आले नाहीत. पुन्हा प्रयत्न करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekod baharu anda tersedia untuk sesi ini tetapi tidak dapat disimpan. Cuba lagi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "De nye rekordene dine gjelder for denne økten, men kunne ikke lagres. Prøv igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je nieuwe records zijn deze sessie beschikbaar, maar konden niet worden opgeslagen. Probeer opnieuw."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ ନୂଆ ରେକର୍ଡ ଏହି ସେସନ୍ ପାଇଁ ଉପଲବ୍ଧ କିନ୍ତୁ ସେଭ୍ ହୋଇପାରିଲା ନାହିଁ। ପୁଣି ଚେଷ୍ଟା କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੇ ਨਵੇਂ ਰਿਕਾਰਡ ਇਸ ਸੈਸ਼ਨ ਲਈ ਉਪਲਬਧ ਹਨ ਪਰ ਸੰਭਾਲੇ ਨਹੀਂ ਜਾ ਸਕੇ। ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nowe rekordy są dostępne w tej sesji, ale nie udało się ich zapisać. Spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus novos recordes valem nesta sessão, mas não puderam ser salvos. Tente novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os novos recordes estão disponíveis nesta sessão, mas não foi possível guardá-los. Tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Noile recorduri sunt disponibile în această sesiune, dar nu au putut fi salvate. Încearcă din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новые рекорды доступны в этом сеансе, но сохранить их не удалось. Попробуйте снова."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše nové rekordy sú dostupné v tejto relácii, ale nepodarilo sa ich uložiť. Skúste to znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoji novi rekordi so na voljo v tej seji, vendar jih ni bilo mogoče shraniti. Poskusi znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina nya rekord gäller för den här sessionen men kunde inte sparas. Försök igen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் புதிய சாதனைகள் இந்த அமர்வுக்குக் கிடைக்கின்றன, ஆனால் சேமிக்க முடியவில்லை. மீண்டும் முயலுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ కొత్త రికార్డ్‌లు ఈ సెషన్‌కి అందుబాటులో ఉన్నాయి కానీ సేవ్ చేయడం సాధ్యం కాలేదు. మళ్లీ ప్రయత్నించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สถิติใหม่ของคุณใช้ได้ในรอบนี้แต่บันทึกไม่ได้ ลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni rekorların bu oturumda kullanılabilir ancak kaydedilemedi. Tekrar dene."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нові рекорди доступні в цьому сеансі, але їх не вдалося зберегти. Спробуй ще раз."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے نئے ریکارڈ اس سیشن میں دستیاب ہیں، لیکن محفوظ نہیں ہو سکے۔ دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kỷ lục mới của bạn có hiệu lực trong phiên này nhưng không thể lưu. Hãy thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新纪录在本次使用期间可见，但尚未保存。请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的新紀錄在本次使用中有效，但無法儲存。請再試一次。"
          }
        }
      }
