    "vault_folder_invalid": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُرجى اختيار اسم غير فارغ وغير موجود بالفعل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অনুগ্রহ করে এমন নাম বেছে নিন যা খালি নয় এবং আগে থেকে নেই।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tria un nom que no sigui buit i que encara no existeixi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvolte název, který není prázdný a ještě neexistuje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg et navn, der ikke er tomt og ikke findes i forvejen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte wähle einen Namen, der nicht leer ist und noch nicht existiert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διάλεξε όνομα που δεν είναι κενό και δεν υπάρχει ήδη."
