          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その間にこのメディアが変更・移動・削除されました。何も保存されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그사이에 이 항목이 변경·이동·삭제되었어요. 아무것도 저장되지 않았어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette elementet er endret, flyttet eller slettet i mellomtiden. Ingenting ble lagret."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit item is intussen gewijzigd, verplaatst of verwijderd. Er is niets opgeslagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W międzyczasie element został zmieniony, przeniesiony lub usunięty. Nic nie zapisano."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este item foi alterado, movido ou apagado enquanto isso. Nada foi salvo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Entretanto, este item foi alterado, movido ou eliminado. Nada foi guardado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Între timp, elementul a fost modificat, mutat sau șters. Nu s-a salvat nimic."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тем временем файл изменили, переместили или удалили. Ничего не сохранено."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Objektet har ändrats, flyttats eller raderats under tiden. Inget sparades."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการนี้ถูกเปลี่ยน ย้าย หรือลบไปในระหว่างนั้น ไม่มีอะไรถูกบันทึก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu öğe bu arada değiştirildi, taşındı veya silindi. Hiçbir şey kaydedilmedi."
