        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 동영상을 보여 주고 빈 공간은 검은 띠가 돼요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser hele videoen; tom plass blir svarte felt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont de hele video; vrije ruimte wordt zwarte balken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuje cały film; wolne miejsce staje się czarnymi pasami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra o vídeo inteiro; o espaço livre vira faixas pretas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra o vídeo inteiro; o espaço livre fica em barras pretas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Arată tot videoclipul; spațiul liber devine benzi negre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает всё видео; свободное место — чёрные полосы."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visar hela videon; tomt utrymme blir svarta fält."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงวิดีโอทั้งหมด พื้นที่ว่างจะเป็นแถบสีดำ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Videonun tamamını gösterir; boş alan siyah şerit olur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показує все відео; вільне місце стає чорними смугами."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện toàn bộ video; khoảng trống thành dải đen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
