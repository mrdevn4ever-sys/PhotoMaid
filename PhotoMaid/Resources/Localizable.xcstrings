    "vault_progress_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُرجى إبقاء GaleriQ مفتوحًا. مغادرة التطبيق توقف العملية، ولا يُحذف أي شيء."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold GaleriQ åben. Hvis du forlader appen, stopper processen; intet slettes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte GaleriQ geöffnet lassen. Beim Verlassen wird abgebrochen; dabei wird nichts gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please keep GaleriQ open. Leaving the app stops the process; nothing is deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén GaleriQ abierto. Si sales de la app, el proceso se detiene; no se elimina nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde GaleriQ ouvert. Quitter l’app interrompt l’opération ; rien n’est supprimé."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Biarkan GaleriQ tetap terbuka. Keluar dari app menghentikan proses; tidak ada yang dihapus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni aperto GaleriQ. Uscire dall’app interrompe l’operazione; non viene eliminato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQを開いたままにしてください。アプリを離れると処理が中止されますが、何も削除されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ를 열어 두세요. 앱을 나가면 작업이 중단되며, 아무것도 삭제되지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold GaleriQ åpen. Hvis du forlater appen, stoppes prosessen; ingenting slettes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd GaleriQ open. Als je de app verlaat, stopt het proces; er wordt niets verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie zamykaj GaleriQ. Opuszczenie aplikacji przerywa proces; nic nie zostanie usunięte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha o GaleriQ aberto. Sair do app interrompe o processo; nada é apagado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém o GaleriQ aberto. Sair da app interrompe o processo; nada é apagado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ține GaleriQ deschis. Dacă ieși din aplicație, procesul se oprește; nu se șterge nimic."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не закрывай GaleriQ. При выходе из приложения процесс прервётся; ничего не удалится."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll GaleriQ öppet. Om du lämnar appen stoppas processen; inget raderas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรดเปิด GaleriQ ไว้ การออกจากแอพจะหยุดกระบวนการ ไม่มีอะไรถูกลบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lütfen GaleriQ’i açık tut. Uygulamadan çıkarsan işlem durur; hiçbir şey silinmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не закривай GaleriQ. Якщо вийти з програми, процес зупиниться; нічого не буде видалено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vui lòng giữ GaleriQ mở. Rời ứng dụng sẽ dừng quá trình; không có gì bị xóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请保持 GaleriQ 打开。离开 App 会中止此过程，但不会删除任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請保持 GaleriQ 開啟。離開 App 會停止處理；不會刪除任何內容。"
          }
        }
      }
    },
