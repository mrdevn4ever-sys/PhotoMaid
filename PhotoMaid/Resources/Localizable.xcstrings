    "set_language_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم GaleriQ لغة iPhone. اضغط لاختيار لغة أخرى لـ GaleriQ فقط من «اللغة» في إعدادات iOS."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ bruger din iPhones sprog. Tryk for at vælge et andet sprog kun til GaleriQ under “Sprog” i iOS-indstillingerne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ nutzt die Sprache deines iPhones. Tippe hier, um in den iOS-Einstellungen unter „Sprache“ eine andere Sprache nur für GaleriQ zu wählen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ uses your iPhone’s language. Tap to choose a different language just for GaleriQ under “Language” in iOS Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ usa el idioma de tu iPhone. Toca para elegir otro idioma solo para GaleriQ en «Idioma» de los Ajustes de iOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ utilise la langue de ton iPhone. Touche ici pour choisir une autre langue rien que pour GaleriQ sous « Langue » dans les réglages iOS."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ memakai bahasa iPhone-mu. Ketuk untuk memilih bahasa lain khusus untuk GaleriQ di “Bahasa” pada Pengaturan iOS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ usa la lingua del tuo iPhone. Tocca per scegliere un’altra lingua solo per GaleriQ in «Lingua» nelle Impostazioni di iOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQはiPhoneの言語を使います。タップすると、iOSの設定の「言語」でGaleriQだけ別の言語を選べます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ는 iPhone의 언어를 사용해요. 탭하면 iOS 설정의 ‘언어’에서 GaleriQ에만 다른 언어를 선택할 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ bruker språket på iPhonen din. Trykk for å velge et annet språk bare for GaleriQ under «Språk» i iOS-innstillingene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ gebruikt de taal van je iPhone. Tik om bij ‘Taal’ in iOS-instellingen een andere taal alleen voor GaleriQ te kiezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ używa języka iPhone’a. Stuknij, aby w ustawieniach iOS w sekcji „Język” wybrać inny język tylko dla GaleriQ."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O GaleriQ usa o idioma do seu iPhone. Toque para escolher outro idioma só para o GaleriQ em “Idioma” nos Ajustes do iOS."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O GaleriQ usa o idioma do teu iPhone. Toca para escolher outro idioma só para o GaleriQ em “Idioma” nas Definições do iOS."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ folosește limba iPhone-ului. Atinge pentru a alege altă limbă doar pentru GaleriQ la „Limbă” în configurările iOS."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ использует язык iPhone. Нажми, чтобы выбрать другой язык только для GaleriQ в разделе «Язык» в настройках iOS."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ använder din iPhones språk. Tryck för att välja ett annat språk bara för GaleriQ under ”Språk” i iOS-inställningarna."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ใช้ภาษาของ iPhone แตะเพื่อเลือกภาษาอื่นสำหรับ GaleriQ เท่านั้นได้ที่ “ภาษา” ในการตั้งค่า iOS"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ iPhone’unun dilini kullanır. Yalnızca GaleriQ için başka bir dil seçmek üzere iOS Ayarları’nda “Dil”e gitmek için dokun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ використовує мову iPhone. Торкнись, щоб у параметрах iOS у розділі «Мова» вибрати іншу мову лише для GaleriQ."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ dùng ngôn ngữ của iPhone. Chạm để chọn ngôn ngữ khác chỉ cho GaleriQ trong “Ngôn ngữ” ở Cài đặt iOS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ 使用 iPhone 的语言。轻点后可在 iOS 设置的“语言”中只为 GaleriQ 选择其他语言。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ 使用 iPhone 的語言。點一下即可在 iOS「設定」的「語言」中，只為 GaleriQ 選擇其他語言。"
          }
        }
      }
    },
