    "tools_copies_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى الأصول دون تغيير – يحفظ GaleriQ نسخًا جديدة في مكتبتك."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine originaler forbliver uændrede – GaleriQ gemmer nye kopier i dit bibliotek."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Originale bleiben unverändert – GaleriQ speichert neue Kopien in deiner Mediathek."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your originals stay unchanged – GaleriQ saves new copies in your library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus originales no cambian: GaleriQ guarda copias nuevas en tu fototeca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos originaux restent inchangés – GaleriQ enregistre de nouvelles copies dans votre photothèque."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aslimu tidak berubah – GaleriQ menyimpan salinan baru di pustakamu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi originali restano invariati: GaleriQ salva nuove copie nella tua libreria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元の写真は変更されません。GaleriQは新しいコピーをライブラリに保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본은 바뀌지 않아요. GaleriQ가 새 사본을 보관함에 저장해요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Originalene dine forblir uendret – GaleriQ lagrer nye kopier i biblioteket ditt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je originelen blijven ongewijzigd – GaleriQ bewaart nieuwe kopieën in je bibliotheek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje oryginały pozostają bez zmian – GaleriQ zapisuje nowe kopie w bibliotece."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus originais não são alterados – o GaleriQ salva novas cópias na sua biblioteca."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os seus originais ficam inalterados – o GaleriQ guarda novas cópias na sua fototeca."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Originalele tale rămân neschimbate – GaleriQ salvează copii noi în fototecă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши оригиналы не меняются – GaleriQ сохраняет новые копии в медиатеке."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina original förblir oförändrade – GaleriQ sparar nya kopior i ditt bibliotek."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้นฉบับของคุณไม่เปลี่ยนแปลง – GaleriQ บันทึกสำเนาใหม่ในคลังของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Orijinallerin değişmez; GaleriQ yeni kopyaları arşivine kaydeder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші оригінали не змінюються – GaleriQ зберігає нові копії в медіатеці."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản gốc không thay đổi – GaleriQ lưu bản sao mới trong thư viện."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原件保持不变——GaleriQ 会将新副本存储到你的图库中。"
