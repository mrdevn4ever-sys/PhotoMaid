    "tools_copies_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى الأصول دون تغيير – يحفظ PhotoMaid نسخًا جديدة في مكتبتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Originale bleiben unverändert – PhotoMaid speichert neue Kopien in deiner Mediathek."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your originals stay unchanged – PhotoMaid saves new copies in your library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus originales no cambian: PhotoMaid guarda copias nuevas en tu fototeca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos originaux restent inchangés – PhotoMaid enregistre de nouvelles copies dans votre photothèque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi originali restano invariati: PhotoMaid salva nuove copie nella tua libreria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元の写真は変更されません。PhotoMaidは新しいコピーをライブラリに保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본은 바뀌지 않아요. PhotoMaid가 새 사본을 보관함에 저장해요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je originelen blijven ongewijzigd – PhotoMaid bewaart nieuwe kopieën in je bibliotheek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje oryginały pozostają bez zmian – PhotoMaid zapisuje nowe kopie w bibliotece."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os seus originais ficam inalterados – o PhotoMaid guarda novas cópias na sua fototeca."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Originalele tale rămân neschimbate – PhotoMaid salvează copii noi în fototecă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши оригиналы не меняются – PhotoMaid сохраняет новые копии в медиатеке."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Orijinallerin değişmez; PhotoMaid yeni kopyaları arşivine kaydeder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші оригінали не змінюються – PhotoMaid зберігає нові копії в медіатеці."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原件保持不变——PhotoMaid 会将新副本存储到你的图库中。"
          }
        }
      }
    },
