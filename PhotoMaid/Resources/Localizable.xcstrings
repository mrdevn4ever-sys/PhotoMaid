    "privacy_media_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لعرض الصور والفيديوهات وترتيبها وإزالتها بعد تأكيدك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার নিশ্চিতকরণের পরে ফটো ও ভিডিও দেখা, গোছানো ও সরানোর জন্য।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per veure, organitzar i eliminar fotos i vídeos després de la teva confirmació."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "K prohlížení, třídění a odstraňování fotek a videí po vašem potvrzení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For at vise, organisere og fjerne fotos og videoer efter din bekræftelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit du Fotos und Videos ansehen, sortieren und nach deiner Bestätigung entfernen kannst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για προβολή, οργάνωση και αφαίρεση φωτογραφιών και βίντεο μετά την επιβεβαίωσή σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To view, organize and remove photos and videos after your confirmation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ver, organizar y quitar fotos y vídeos tras tu confirmación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvien ja videoiden katsomiseen, järjestämiseen ja poistamiseen vahvistuksesi jälkeen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour voir, organiser et retirer des photos et vidéos après ta confirmation."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારી પુષ્ટિ પછી ફોટા અને વીડિયો જોવા, ગોઠવવા અને દૂર કરવા માટે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי להציג, לארגן ולהסיר תמונות וסרטונים אחרי אישור שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी पुष्टि के बाद फ़ोटो और वीडियो देखने, व्यवस्थित करने और हटाने के लिए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za pregled, organiziranje i uklanjanje fotografija i videozapisa nakon tvoje potvrde."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fotók és videók megtekintéséhez, rendszerezéséhez és – megerősítésed után – eltávolításához."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk melihat, merapikan, dan menghapus foto dan video setelah kamu konfirmasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per vedere, organizzare e rimuovere foto e video dopo la tua conferma."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真や動画の表示、整理、確認後の削除に使います。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ದೃಢೀಕರಣದ ನಂತರ ಫೋಟೋಗಳು ಮತ್ತು ವೀಡಿಯೊಗಳನ್ನು ವೀಕ್ಷಿಸಲು, ವ್ಯವಸ್ಥಿತಗೊಳಿಸಲು ಮತ್ತು ತೆಗೆದುಹಾಕಲು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진과 동영상을 보고 정리하고, 확인 후 삭제하는 데 사용해요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ സ്ഥിരീകരണത്തിന് ശേഷം ഫോട്ടോകളും വീഡിയോകളും കാണാനും ക്രമീകരിക്കാനും നീക്കം ചെയ്യാനും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या पुष्टीनंतर फोटो आणि व्हिडिओ पाहण्यासाठी, व्यवस्थित करण्यासाठी आणि काढण्यासाठी."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk melihat, menyusun dan membuang foto dan video selepas pengesahan anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For å vise, organisere og fjerne bilder og videoer etter at du har bekreftet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om foto’s en video’s te bekijken, te ordenen en na je bevestiging te verwijderen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ ନିଶ୍ଚିତକରଣ ପରେ ଫଟୋ ଓ ଭିଡିଓ ଦେଖିବା, ସଜାଇବା ଓ ହଟାଇବା ପାଇଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੀ ਪੁਸ਼ਟੀ ਤੋਂ ਬਾਅਦ ਫ਼ੋਟੋਆਂ ਅਤੇ ਵੀਡੀਓ ਦੇਖਣ, ਵਿਵਸਥਿਤ ਕਰਨ ਅਤੇ ਹਟਾਉਣ ਲਈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby przeglądać, porządkować i usuwać zdjęcia oraz filmy po Twoim potwierdzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ver, organizar e remover fotos e vídeos após a sua confirmação."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ver, organizar e remover fotos e vídeos após a tua confirmação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a vedea, organiza și elimina fotografii și videoclipuri după confirmarea ta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы просматривать, упорядочивать и удалять фото и видео после твоего подтверждения."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na prezeranie, triedenie a odstraňovanie fotiek a videí po vašom potvrdení."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za ogled, urejanje in odstranjevanje fotografij in videoposnetkov po tvoji potrditvi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För att visa, sortera och ta bort bilder och videor efter din bekräftelse."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் உறுதிப்படுத்தலுக்குப் பிறகு புகைப்படங்களையும் வீடியோக்களையும் பார்க்க, ஒழுங்குபடுத்த, அகற்ற."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ నిర్ధారణ తర్వాత ఫోటోలు, వీడియోలను చూడడానికి, సర్దడానికి, తీసివేయడానికి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพื่อดู จัดระเบียบ และนำรูปภาพและวิดีโอออกหลังจากคุณยืนยัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraf ve videoları görüntülemek, düzenlemek ve onayından sonra kaldırmak için."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб переглядати, впорядковувати й видаляти фото та відео після твого підтвердження."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی تصدیق کے بعد تصاویر اور ویڈیوز دیکھنے، ترتیب دینے اور ہٹانے کے لیے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để xem, sắp xếp và xóa ảnh, video sau khi bạn xác nhận."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于查看、整理照片和视频，并在你确认后移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在你確認後檢視、整理和移除照片和影片。"
          }
        }
      }
    },
