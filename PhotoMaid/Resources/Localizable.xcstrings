    "fc_footer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يُحذف شيء هنا: «سلة المهملات» هي سلة PhotoMaid. التراجع يلغي كل إجراء، بما في ذلك «وضع في ألبوم»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelöscht wird hier nie: „Papierkorb“ ist der PhotoMaid-Papierkorb. Rückgängig nimmt jede Aktion zurück, auch „In Album legen“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is deleted here: “Trash” is the PhotoMaid trash. Undo reverses every action, including “Put in album”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí no se borra nada: «Papelera» es la papelera de PhotoMaid. Deshacer revierte cada acción, también «Poner en álbum»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’est supprimé ici : « Corbeille » est la corbeille de PhotoMaid. Annuler revient sur chaque action, y compris « Mettre dans un album »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui non si elimina nulla: «Cestino» è il cestino di PhotoMaid. Annulla ripristina ogni azione, anche «Metti in album»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここでは何も削除されません。「ゴミ箱」はPhotoMaidのゴミ箱です。「取り消す」で「アルバムに入れる」を含むすべての操作を元に戻せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기서는 아무것도 삭제되지 않아요. ‘휴지통’은 PhotoMaid 휴지통이에요. 실행 취소로 ‘앨범에 넣기’를 포함한 모든 동작을 되돌려요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier wordt niets verwijderd: ‘Prullenbak’ is de PhotoMaid-prullenbak. Ongedaan maken draait elke actie terug, ook ‘In album zetten’."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie jest tu usuwane: „Kosz” to kosz PhotoMaid. Cofnij odwraca każdą akcję, także „Dodaj do albumu”."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Aqui nada é apagado: «Lixo» é o lixo do PhotoMaid. Anular reverte cada ação, incluindo «Pôr no álbum»."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aici nu se șterge nimic: „Coș” este coșul PhotoMaid. Anulează inversează orice acțiune, inclusiv „Pune în album”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь ничего не удаляется: «Корзина» — это корзина PhotoMaid. «Отменить» отменяет любое действие, включая «В альбом»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Burada hiçbir şey silinmez: “Çöp kutusu” PhotoMaid’in çöp kutusudur. Geri al, “Albüme koy” dahil her işlemi geri alır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут нічого не видаляється: «Кошик» — це кошик PhotoMaid. «Скасувати» скасовує будь-яку дію, зокрема «В альбом»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里不会删除任何内容：“回收站”是 PhotoMaid 的回收站。撤销可撤回每个操作，包括“放入相簿”。"
          }
        }
      }
    },
