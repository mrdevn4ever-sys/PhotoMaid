    "vault_settings_row_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مكان مخفي ومحمي برمز للصور ومقاطع الفيديو. تختفي من تطبيق الصور."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjult, kodebeskyttet sted til fotos og videoer. De forsvinder fra appen Fotos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versteckter, mit Code geschützter Ort für Fotos und Videos. Sie verschwinden aus der Fotos-App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidden, code-protected place for photos and videos. They disappear from the Photos app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lugar oculto y protegido con código para fotos y vídeos. Desaparecen de la app Fotos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Endroit caché et protégé par code pour les photos et vidéos. Elles disparaissent de l’app Photos."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempat tersembunyi yang dilindungi kode untuk foto dan video. Semuanya hilang dari app Foto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spazio nascosto e protetto da codice per foto e video. Spariscono dall’app Foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真とビデオのための、コードで保護された隠し場所です。写真アプリからは消えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진과 비디오를 위한, 암호로 보호된 숨겨진 공간입니다. 사진 앱에서는 사라집니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjult, kodebeskyttet sted for bilder og videoer. De forsvinner fra Bilder-appen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verborgen, met een code beveiligde plek voor foto’s en video’s. Ze verdwijnen uit de Foto’s-app."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukryte, chronione kodem miejsce na zdjęcia i filmy. Znikają z aplikacji Zdjęcia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lugar oculto e protegido por código para fotos e vídeos. Eles somem do app Fotos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Local oculto e protegido por código para fotografias e vídeos. Desaparecem da app Fotografias."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Loc ascuns, protejat cu cod, pentru poze și videoclipuri. Dispar din aplicația Poze."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрытое, защищённое кодом место для фото и видео. Они исчезают из «Фото»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dold, kodskyddad plats för bilder och videor. De försvinner från appen Bilder."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ที่ซ่อนซึ่งปกป้องด้วยรหัสสำหรับรูปภาพและวิดีโอ รายการจะหายไปจากแอพรูปภาพ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraflar ve videolar için gizli, kodla korunan bir yer. Fotoğraflar uygulamasından kaybolurlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Приховане, захищене кодом місце для фото й відео. Вони зникають із «Фото»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nơi ẩn, được bảo vệ bằng mã cho ảnh và video. Chúng biến mất khỏi ứng dụng Ảnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于存放照片和视频的隐藏空间，受密码保护。它们会从“照片”App 中消失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隱藏且受密碼保護的照片和影片存放處。它們會從「照片」App 中消失。"
          }
        }
      }
    },
