    "set_buttons_detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض أزرارًا للسلة والاحتفاظ ولاحقًا أسفل كل عنصر. السحب يظل متاحًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Shows buttons for trash, keep and later below each item. Swiping still works."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt unter dem Foto oder Video Tasten für Papierkorb, Behalten und Später. Wischen funktioniert weiterhin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows buttons for trash, keep and later below each item. Swiping still works."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra botones de papelera, conservar y después debajo de cada elemento. Deslizar sigue funcionando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche des boutons Corbeille, Garder et Plus tard sous chaque élément. Le balayage fonctionne toujours."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Shows buttons for trash, keep and later below each item. Swiping still works."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra sotto ogni elemento i pulsanti Cestino, Conserva e Più tardi. Lo scorrimento funziona ancora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各アイテムの下に「ゴミ箱」「残す」「あとで」のボタンを表示します。スワイプも引き続き使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 항목 아래에 휴지통, 보관, 나중에 버튼을 표시해요. 스와이프도 계속 쓸 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Shows buttons for trash, keep and later below each item. Swiping still works."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont onder elk item knoppen voor prullenbak, bewaren en later. Vegen blijft werken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuje pod elementem przyciski Kosz, Zachowaj i Później. Przesuwanie nadal działa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Shows buttons for trash, keep and later below each item. Swiping still works."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra botões de lixo, manter e mais tarde por baixo de cada item. Deslizar continua a funcionar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Afișează sub fiecare element butoane pentru coș, păstrare și mai târziu. Glisarea funcționează în continuare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает под элементом кнопки «Корзина», «Оставить» и «Позже». Свайпы по-прежнему работают."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Shows buttons for trash, keep and later below each item. Swiping still works."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Shows buttons for trash, keep and later below each item. Swiping still works."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her öğenin altında çöp kutusu, saklama ve sonra düğmeleri gösterir. Kaydırma çalışmaya devam eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показує під елементом кнопки «Кошик», «Залишити» та «Пізніше». Свайпи й далі працюють."
          }
        },
        "vi": {
