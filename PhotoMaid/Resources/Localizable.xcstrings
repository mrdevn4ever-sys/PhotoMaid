            "state": "translated",
            "value": "ツアーとヒントをもう一度表示"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "둘러보기와 팁 다시 보기"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rondleiding en tips opnieuw tonen"
          }
        },
