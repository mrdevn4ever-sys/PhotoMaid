    "tools_gif_intro": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحوّل عدة صور إلى رسوم متحركة قصيرة تتكرر بلا نهاية – بترتيب التقاطها."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gør flere fotos til en kort animation, der gentages i det uendelige – i den rækkefølge, de blev taget."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Macht aus mehreren Fotos eine kurze Animation, die sich endlos wiederholt – in der Reihenfolge der Aufnahme."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turns several photos into a short animation that repeats endlessly – in the order they were taken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Convierte varias fotos en una animación corta que se repite sin fin, en el orden en que se hicieron."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transforme plusieurs photos en une courte animation qui se répète sans fin, dans l’ordre de prise."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengubah beberapa foto menjadi animasi pendek yang berulang terus – sesuai urutan pengambilan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trasforma più foto in una breve animazione che si ripete all’infinito, nell’ordine in cui sono state scattate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複数の写真を、撮影順に繰り返し再生される短いアニメーションにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여러 사진을 촬영 순서대로 끝없이 반복되는 짧은 애니메이션으로 만들어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjør flere bilder om til en kort animasjon som gjentas i det uendelige – i den rekkefølgen de ble tatt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maakt van meerdere foto’s een korte animatie die eindeloos herhaalt – in de volgorde waarin ze zijn gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tworzy z kilku zdjęć krótką animację powtarzaną bez końca – w kolejności wykonania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transforma várias fotos numa animação curta que se repete sem fim – na ordem em que foram tiradas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Transforma várias fotografias numa animação curta que se repete sem fim, pela ordem em que foram tiradas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Transformă mai multe fotografii într-o animație scurtă care se repetă la nesfârșit, în ordinea în care au fost făcute."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Превращает несколько фото в короткую бесконечно повторяющуюся анимацию в порядке съёмки."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gör flera bilder till en kort animation som upprepas i oändlighet – i den ordning de togs."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปลี่ยนหลายรูปเป็นภาพเคลื่อนไหวสั้นๆ ที่เล่นวนไม่สิ้นสุด – ตามลำดับที่ถ่าย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birkaç fotoğrafı, çekilme sırasına göre sonsuz tekrar eden kısa bir animasyona dönüştürür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетворює кілька фото на коротку анімацію, що повторюється безкінечно, у порядку зйомки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Biến nhiều ảnh thành một hoạt ảnh ngắn lặp lại mãi – theo thứ tự chụp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将多张照片按拍摄顺序制作成无限循环的短动画。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將多張照片做成無限重複播放的短動畫 – 依拍攝順序排列。"
          }
        }
      }
    },
    "tools_gif_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتوي ملفات GIF على 256 لونًا كحد أقصى ولا صوت – قد تبدو الصور محببة قليلًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF'er har højst 256 farver og ingen lyd – fotos kan se lidt kornede ud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GIFs haben höchstens 256 Farben und keinen Ton – Fotos können etwas körnig wirken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GIFs have at most 256 colours and no sound – photos can look a little grainy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los GIF tienen como máximo 256 colores y no tienen sonido: las fotos pueden verse algo granuladas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les GIF ont au plus 256 couleurs et pas de son : les photos peuvent paraître un peu granuleuses."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF punya maksimal 256 warna dan tanpa suara – foto bisa terlihat sedikit berbintik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le GIF hanno al massimo 256 colori e niente audio: le foto possono sembrare un po’ sgranate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GIFは最大256色で音声はありません。写真は少し粗く見えることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF는 최대 256색이며 소리가 없습니다. 사진이 약간 거칠어 보일 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF-er har maks 256 farger og ingen lyd – bildene kan se litt kornete ut."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF’s hebben hoogstens 256 kleuren en geen geluid – foto’s kunnen wat korrelig ogen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF-y mają najwyżej 256 kolorów i brak dźwięku – zdjęcia mogą wyglądać nieco ziarniście."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "GIFs têm no máximo 256 cores e não têm som – as fotos podem parecer um pouco granuladas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os GIF têm no máximo 256 cores e não têm som – as fotos podem parecer um pouco granuladas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF-urile au cel mult 256 de culori și nu au sunet – fotografiile pot părea puțin granulate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В GIF не более 256 цветов и нет звука – фото могут выглядеть немного зернистыми."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF:ar har högst 256 färger och inget ljud – bilderna kan se lite korniga ut."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF มีสีได้สูงสุด 256 สีและไม่มีเสียง – รูปอาจดูมีเกรนเล็กน้อย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF’lerde en çok 256 renk vardır ve ses yoktur; fotoğraflar biraz grenli görünebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У GIF щонайбільше 256 кольорів і немає звуку – фото можуть виглядати трохи зернистими."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF có tối đa 256 màu và không có âm thanh – ảnh có thể hơi sạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF 最多 256 色且没有声音，照片可能略显颗粒感。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF 最多只有 256 種顏色且沒有聲音 – 照片看起來可能略有顆粒感。"
          }
        }
      }
    },
