    "pro_f2d": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أزل ما تشاء، دون الحد اليومي البالغ %1$lld."
          }
        },
        "da": {
