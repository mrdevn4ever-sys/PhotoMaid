          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este álbum está vazio. Em «Fotos», seleciona conteúdos e toca em ⋯ › Adicionar a um álbum."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Albumul este gol. În „Fotografii”, selectează conținut și atinge ⋯ › Adaugă la album."
