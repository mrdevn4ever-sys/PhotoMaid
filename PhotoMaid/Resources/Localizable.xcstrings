    "privacy_notifications_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختياري: تذكير عندما يحين وقت مراجعة شيء في «لاحقًا». لن تظهر أسماء الملفات على شاشة القفل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional: Wir erinnern dich, wenn etwas aus „Später“ wieder dran ist. Dateinamen erscheinen nicht auf dem Sperrbildschirm."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional: get a reminder when something in “Later” is ready to review. Filenames won’t appear on your lock screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional: recibe un aviso cuando toque revisar algo de «Después». Los nombres de archivo no aparecen en la pantalla de bloqueo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif : reçois un rappel quand un élément de « Plus tard » est à revoir. Les noms de fichiers n’apparaissent pas sur l’écran verrouillé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Facoltativo: ricevi un promemoria quando è il momento di rivedere qualcosa in «Più tardi». I nomi dei file non appaiono sulla schermata di blocco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意：「あとで」にあるものを確認する日に通知します。ロック画面にファイル名は表示しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 사항: ‘나중에’에서 다시 볼 때가 되면 알려 드려요. 잠금 화면에는 파일 이름을 표시하지 않아요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Optioneel: krijg een herinnering als iets uit ‘Later’ weer aan de beurt is. Bestandsnamen verschijnen niet op je vergrendelscherm."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcjonalnie: otrzymasz przypomnienie, gdy przyjdzie czas na coś z „Później”. Nazwy plików nie pojawią się na ekranie blokady."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional: recebe um lembrete quando for altura de rever algo de «Mais tarde». Os nomes dos ficheiros não aparecem no ecrã bloqueado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Opțional: primești un memento când este timpul să revezi ceva din „Mai târziu”. Numele fișierelor nu apar pe ecranul blocat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По желанию: напоминание, когда пора посмотреть что-то из «Позже». Имена файлов не показываются на экране блокировки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İsteğe bağlı: “Sonra” bölümündeki bir öğeyi inceleme zamanı gelince hatırlatma al. Kilit ekranında dosya adları görünmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За бажанням: нагадування, коли час переглянути щось із «Пізніше». Назви файлів не показуються на екрані блокування."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选：当“稍后”中的内容可以再次查看时提醒你。锁屏通知不会显示文件名。"
          }
        }
      }
    },
