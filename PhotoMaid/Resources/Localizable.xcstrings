    "studio_err_memory": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تتوفر ذاكرة كافية لهذا الحجم. جرّب „قياسي“ أو صورًا أقل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht genug Arbeitsspeicher für diese Größe. Versuche „Standard“ oder weniger Fotos."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough memory for this size. Try “Standard” or fewer photos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay memoria suficiente para este tamaño. Prueba «Estándar» o menos fotos."
