    "storage_b_footer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقطات الشاشة محسوبة ضمن الصور. لا تُحسب الملفات الكبيرة والنسخ المكررة مرة أخرى. تُستثنى الأحجام غير المعروفة من الإجمالي، ويُشار إليه حينها بعبارة «على الأقل»."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skærmbilleder er allerede med i fotos. Store filer og dubletter tælles ikke igen. Ukendte størrelser udelades af summen, som så markeres med “Mindst”."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Screenshots sind bereits bei den Fotos enthalten. Große Dateien und Duplikate werden nicht zusätzlich gezählt. Unbekannte Größen fehlen in der Summe; dann steht dort „mind.“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screenshots are already included in photos. Large files and duplicates aren’t counted again. Unknown sizes are left out of the total, which is then marked “At least”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las capturas de pantalla ya se incluyen en las fotos. Los archivos grandes y duplicados no se cuentan de nuevo. Los tamaños desconocidos se excluyen del total, que entonces indica «Al menos»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les captures d’écran sont déjà comptées parmi les photos. Les gros fichiers et doublons ne sont pas comptés une deuxième fois. Les tailles inconnues sont exclues du total, qui porte alors la mention « Au moins »."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tangkapan layar sudah termasuk dalam foto. File besar dan duplikat tidak dihitung lagi. Ukuran yang tidak diketahui tidak masuk total, yang kemudian ditandai “Setidaknya”."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli screenshot sono già inclusi nelle foto. I file grandi e i duplicati non vengono contati di nuovo. Le dimensioni sconosciute sono escluse dal totale, che in quel caso indica «Almeno»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクリーンショットは写真に含まれます。大きなファイルや重複ファイルは二重に数えません。サイズ不明のものは合計から除き、その場合は「少なくとも」と表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크린샷은 사진에 이미 포함돼요. 큰 파일과 중복 파일을 다시 합산하지 않아요. 크기를 알 수 없는 항목은 합계에서 제외하고 ‘최소’로 표시해요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjermbilder er allerede med i bilder. Store filer og duplikater telles ikke igjen. Ukjente størrelser utelates fra summen, som da merkes med «Minst»."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schermafbeeldingen zijn al meegeteld bij foto’s. Grote bestanden en duplicaten worden niet opnieuw geteld. Onbekende groottes ontbreken in het totaal; dan staat er ‘Minstens’."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zrzuty ekranu są już uwzględnione w zdjęciach. Duże pliki i duplikaty nie są liczone ponownie. Nieznane rozmiary są pomijane w sumie, która wtedy ma oznaczenie „Co najmniej”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As capturas de tela já estão incluídas nas fotos. Arquivos grandes e duplicatas não são contados de novo. Tamanhos desconhecidos ficam fora do total, que então é marcado como “Pelo menos”."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As capturas de ecrã já estão incluídas nas fotos. Os ficheiros grandes e duplicados não são contados novamente. Os tamanhos desconhecidos ficam fora do total, que passa a indicar «Pelo menos»."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Capturile de ecran sunt deja incluse în fotografii. Fișierele mari și duplicatele nu sunt numărate din nou. Dimensiunile necunoscute sunt omise din total, care atunci este marcat „Cel puțin”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скриншоты уже учтены в фотографиях. Большие файлы и дубликаты не считаются повторно. Неизвестные размеры не включаются в сумму — тогда рядом указано «Не менее»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skärmavbilder ingår redan i bilder. Stora filer och dubbletter räknas inte igen. Okända storlekar utelämnas ur summan, som då markeras med ”Minst”."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ภาพหน้าจอรวมอยู่ในรูปภาพแล้ว ไฟล์ขนาดใหญ่และรายการซ้ำจะไม่นับซ้ำ ขนาดที่ไม่ทราบจะไม่รวมในยอดรวม ซึ่งจะถูกระบุว่า “อย่างน้อย”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran görüntüleri zaten fotoğraflara dâhildir. Büyük dosyalar ve kopyalar yeniden sayılmaz. Bilinmeyen boyutlar toplama katılmaz; bu durumda “En az” gösterilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Знімки екрана вже враховано серед фото. Великі файли й дублікати не рахуються повторно. Невідомі розміри не входять у суму — тоді біля неї стоїть «Щонайменше»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh chụp màn hình đã được tính trong ảnh. Tệp lớn và mục trùng lặp không được tính lại. Kích thước không rõ không được tính vào tổng, khi đó tổng được ghi là “Ít nhất”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "截图已计入照片。大文件和重复文件不会重复累计。大小未知的内容不计入总大小，此时会标注“至少”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "截圖已包含在照片中。大型檔案和重複項目不會重複計算。大小未知的項目不計入總數，總數會標示為「至少」。"
          }
        }
      }
    },
