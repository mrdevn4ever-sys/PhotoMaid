    "tour_feed_basket_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُظهر العدد ما اخترت إزالته. اضغط عليه لمراجعة اختيارك وإفراغ سلة المهملات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সংখ্যাটি দেখায় আপনি কতটা আলাদা রেখেছেন। আপনার নির্বাচন পর্যালোচনা ও ট্র্যাশ খালি করতে এতে ট্যাপ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El número mostra quant n’has apartat. Toca’l per revisar la selecció i buidar la paperera."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Číslo ukazuje, kolik jste odložili. Klepnutím na něj zkontrolujete výběr a vyprázdníte koš."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallet viser, hvor meget du har lagt til side. Tryk på det for at gennemgå dit valg og tømme papirkurven."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zahl zeigt, wie viel du aussortiert hast. Tippe darauf, um die Auswahl anzusehen und den Papierkorb zu leeren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο αριθμός δείχνει πόσα έβαλες στην άκρη. Πάτησέ τον για να ελέγξεις την επιλογή και να αδειάσεις τον κάδο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The number shows how much you’ve set aside. Tap it to review your selection and empty the trash."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El número indica cuántos elementos has apartado. Tócalo para revisar la selección y vaciar la papelera."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luku näyttää, kuinka paljon olet siirtänyt syrjään. Napauta sitä tarkistaaksesi valintasi ja tyhjentääksesi roskakorin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nombre indique combien d’éléments tu as mis de côté. Touche-le pour revoir ta sélection et vider la corbeille."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સંખ્યા બતાવે છે કે તમે કેટલું બાજુએ રાખ્યું છે. પસંદગી જોવા અને ટ્રેશ ખાલી કરવા તેના પર ટૅપ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המספר מראה כמה הועבר הצידה. הקשה עליו מאפשרת לסקור את הבחירה ולרוקן את הפח."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संख्या बताती है कि आपने कितना अलग रखा है। चयन देखने और ट्रैश खाली करने के लिए उस पर टैप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Broj pokazuje koliko si odvojio. Dodirni ga da pregledaš odabir i isprazniš smeće."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szám mutatja, mennyit tettél félre. Koppints rá a kijelölésed átnézéséhez és a kuka ürítéséhez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Angka ini menunjukkan berapa yang sudah kamu sisihkan. Ketuk untuk meninjau pilihanmu dan mengosongkan sampah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il numero indica quanti elementi hai scelto di rimuovere. Toccalo per controllare la selezione e svuotare il cestino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "数字は削除用に選んだ件数です。タップして内容を確認し、ゴミ箱を空にできます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಎಷ್ಟು ಪಕ್ಕಕ್ಕಿಟ್ಟಿದ್ದೀರಿ ಎಂದು ಸಂಖ್ಯೆ ತೋರಿಸುತ್ತದೆ. ನಿಮ್ಮ ಆಯ್ಕೆ ಪರಿಶೀಲಿಸಲು ಮತ್ತು ಕಸದ ಬುಟ್ಟಿ ಖಾಲಿ ಮಾಡಲು ಇದನ್ನು ಟ್ಯಾಪ್ ಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "숫자는 삭제하려고 고른 항목 수예요. 누르면 선택 내용을 확인하고 휴지통을 비울 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ എത്രത്തോളം മാറ്റിവച്ചുവെന്ന് സംഖ്യ കാണിക്കുന്നു. നിങ്ങളുടെ തിരഞ്ഞെടുപ്പ് പരിശോധിക്കാനും ട്രാഷ് ശൂന്യമാക്കാനും ഇത് ടാപ്പ് ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "संख्या दाखवते की तुम्ही किती बाजूला ठेवले आहे. निवड तपासण्यासाठी आणि ट्रॅश रिकामा करण्यासाठी त्यावर टॅप करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombor menunjukkan berapa banyak yang anda ketepikan. Ketik untuk menyemak pilihan anda dan mengosongkan sampah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallet viser hvor mye du har lagt til side. Trykk på det for å gå gjennom utvalget og tømme papirkurven."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het getal toont hoeveel je hebt geselecteerd. Tik erop om je selectie te bekijken en de prullenbak te legen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସଂଖ୍ୟାଟି ଦେଖାଏ ଆପଣ କେତେ ଅଲଗା ରଖିଛନ୍ତି। ଆପଣଙ୍କ ଚୟନ ସମୀକ୍ଷା କରିବାକୁ ଓ ଟ୍ରାସ ଖାଲି କରିବାକୁ ଏଥିରେ ଟାପ୍ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਗਿਣਤੀ ਦੱਸਦੀ ਹੈ ਕਿ ਤੁਸੀਂ ਕਿੰਨਾ ਵੱਖ ਰੱਖਿਆ ਹੈ। ਆਪਣੀ ਚੋਣ ਦੀ ਸਮੀਖਿਆ ਕਰਨ ਅਤੇ ਰੱਦੀ ਖਾਲੀ ਕਰਨ ਲਈ ਇਸ ਉੱਤੇ ਟੈਪ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Liczba pokazuje, ile elementów zostało wybranych. Dotknij jej, aby przejrzeć wybór i opróżnić kosz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O número mostra quanto você separou. Toque nele para revisar sua seleção e esvaziar a lixeira."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O número mostra quantos itens separaste. Toca nele para rever a seleção e esvaziar o lixo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Numărul arată câte elemente ai selectat. Atinge-l pentru a verifica selecția și a goli coșul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Число показывает, сколько элементов выбрано. Нажми на него, чтобы проверить выбор и очистить корзину."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Číslo ukazuje, koľko ste odložili. Klepnutím naň skontrolujete výber a vyprázdnite kôš."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Številka kaže, koliko si odložil. Tapni jo, da pregledaš izbor in izprazniš koš."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Siffran visar hur mycket du har lagt undan. Tryck på den för att gå igenom ditt urval och tömma papperskorgen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் எவ்வளவு ஒதுக்கியுள்ளீர்கள் என்பதை எண் காட்டுகிறது. உங்கள் தேர்வைப் பார்வையிடவும் குப்பையைக் காலி செய்யவும் அதைத் தட்டுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఎంత పక్కన పెట్టారో సంఖ్య చూపిస్తుంది. మీ ఎంపికను సమీక్షించడానికి, ట్రాష్ ఖాళీ చేయడానికి దాన్ని ట్యాప్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวเลขแสดงจำนวนที่คุณแยกไว้ แตะเพื่อตรวจดูการเลือกและล้างถังขยะ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayı, kaç öğe ayırdığını gösterir. Seçimini incelemek ve çöp kutusunu boşaltmak için dokun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Число показує кількість вибраних елементів. Натисни на нього, щоб переглянути вибір і очистити кошик."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "عدد بتاتا ہے کہ آپ نے کتنا الگ رکھا ہے۔ انتخاب دیکھنے اور ردی خالی کرنے کے لیے اس پر ٹیپ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Con số cho biết bạn đã để riêng bao nhiêu. Chạm vào để xem lại lựa chọn và dọn thùng rác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数字表示你选出的待移除数量。点击可查看所选内容并清空回收站。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "數字顯示你擱置了多少項目。點一下即可檢查你的選擇並清空垃圾桶。"
          }
        }
      }
    },
