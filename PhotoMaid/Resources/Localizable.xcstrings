    "tour_settings_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضبط PhotoMaid كما تحب واعثر على الإجابات هنا. يمكنك إعادة هذه الجولة في أي وقت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier stellst du PhotoMaid nach deinem Geschmack ein und findest Antworten. Diesen Rundgang kannst du dort jederzeit wiederholen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make PhotoMaid your own and find answers here. You can take this tour again at any time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura PhotoMaid a tu gusto y encuentra respuestas. Puedes repetir este recorrido cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglez PhotoMaid à votre goût et trouvez des réponses. Vous pouvez refaire cette visite à tout moment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta PhotoMaid come preferisci e trova risposte. Puoi ripetere questa guida in qualsiasi momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid を好みに合わせて設定し、答えを探せます。このツアーはいつでももう一度見られます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid를 원하는 대로 설정하고 답을 찾아보세요. 이 둘러보기는 언제든 다시 볼 수 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel PhotoMaid naar wens in en vind antwoorden. Deze rondleiding kun je altijd opnieuw bekijken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostosuj PhotoMaid do siebie i znajdź odpowiedzi. Ten przewodnik możesz obejrzeć ponownie w każdej chwili."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste o PhotoMaid ao seu gosto e encontre respostas. Pode repetir esta visita a qualquer momento."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Setează PhotoMaid după gustul tău și găsește răspunsuri. Poți relua oricând acest tur."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройте PhotoMaid под себя и найдите ответы. Этот обзор можно повторить в любое время."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid’i zevkine göre ayarla ve yanıtları bul. Bu turu istediğin zaman tekrarlayabilirsin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Налаштуйте PhotoMaid під себе й знайдіть відповіді. Цей огляд можна повторити будь-коли."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按你的喜好设置 PhotoMaid，并找到答案。你可以随时重新查看这个导览。"
          }
        }
      }
    },
