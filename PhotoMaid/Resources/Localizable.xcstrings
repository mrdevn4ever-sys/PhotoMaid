    "movie_photo_duration_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينطبق على كل صورة في هذا الفيديو. تُعرض مقاطع الفيديو دائمًا بطولها الكامل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ভিডিওর প্রতিটি ফটোতে প্রযোজ্য। ভিডিও সবসময় পূর্ণ দৈর্ঘ্যে চলে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "S’aplica a cada foto d’aquest vídeo. Els vídeos sempre es reprodueixen sencers."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Platí pro každou fotku v tomto videu. Videa se přehrávají vždy celá."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gælder for alle fotos i denne video. Videoer afspilles altid i fuld længde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt für jedes Foto in diesem Video. Videos laufen immer in voller Länge."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ισχύει για κάθε φωτογραφία σε αυτό το βίντεο. Τα βίντεο παίζουν πάντα ολόκληρα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies to every photo in this video. Videos always play in full length."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica a todas las fotos de este vídeo. Los vídeos se reproducen siempre completos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Koskee jokaista tämän videon kuvaa. Videot toistetaan aina kokonaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’applique à chaque photo de cette vidéo. Les vidéos sont toujours lues en entier."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ વીડિયોના દરેક ફોટા પર લાગુ. વીડિયો હંમેશાં પૂરા વાગે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חל על כל תמונה בסרטון הזה. סרטונים תמיד מתנגנים באורכם המלא."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस वीडियो की हर फ़ोटो पर लागू। वीडियो हमेशा पूरे चलते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrijedi za svaku fotografiju u ovom videozapisu. Videozapisi se uvijek reproduciraju u punoj duljini."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A videó minden fotójára érvényes. A videók mindig teljes hosszban játszódnak le."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berlaku untuk setiap foto di video ini. Video selalu diputar penuh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vale per ogni foto di questo video. I video vengono sempre riprodotti per intero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この動画のすべての写真に適用されます。ビデオは常に最後まで再生されます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ವೀಡಿಯೊದ ಪ್ರತಿ ಫೋಟೋಗೆ ಅನ್ವಯಿಸುತ್ತದೆ. ವೀಡಿಯೊಗಳು ಯಾವಾಗಲೂ ಪೂರ್ಣ ಉದ್ದದಲ್ಲಿ ಪ್ಲೇ ಆಗುತ್ತವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 동영상의 모든 사진에 적용돼요. 동영상 클립은 항상 전체 길이로 재생돼요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ വീഡിയോയിലെ ഓരോ ഫോട്ടോയ്ക്കും ബാധകം. വീഡിയോകൾ എപ്പോഴും പൂർണ്ണ ദൈർഘ്യത്തിൽ പ്ലേ ചെയ്യും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या व्हिडिओतील प्रत्येक फोटोला लागू. व्हिडिओ नेहमी पूर्ण वाजतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terpakai untuk setiap foto dalam video ini. Video sentiasa dimainkan sepenuhnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjelder alle bildene i denne videoen. Videoer spilles alltid i full lengde."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geldt voor elke foto in deze video. Video’s worden altijd volledig afgespeeld."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହି ଭିଡିଓର ପ୍ରତ୍ୟେକ ଫଟୋରେ ଲାଗୁ ହୁଏ। ଭିଡିଓ ସବୁବେଳେ ସମ୍ପୂର୍ଣ୍ଣ ଦୈର୍ଘ୍ୟରେ ଚାଲେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਵੀਡੀਓ ਦੀ ਹਰ ਫ਼ੋਟੋ ਉੱਤੇ ਲਾਗੂ ਹੁੰਦਾ ਹੈ। ਵੀਡੀਓ ਹਮੇਸ਼ਾ ਪੂਰੀ ਲੰਬਾਈ ਵਿੱਚ ਚੱਲਦੀਆਂ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotyczy każdego zdjęcia w tym filmie. Filmy są zawsze odtwarzane w całości."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vale para todas as fotos deste vídeo. Vídeos sempre tocam na duração completa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica-se a todas as fotografias deste vídeo. Os vídeos são sempre reproduzidos na íntegra."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplică fiecărei fotografii din acest video. Videoclipurile rulează mereu în întregime."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Относится ко всем фото в этом видео. Видеоклипы всегда воспроизводятся целиком."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Platí pre každú fotku v tomto videu. Videá sa prehrávajú vždy celé."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Velja za vsako fotografijo v tem videu. Videoposnetki se vedno predvajajo v celoti."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gäller varje bild i den här videon. Videor spelas alltid i full längd."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த வீடியோவின் ஒவ்வொரு புகைப்படத்திற்கும் பொருந்தும். வீடியோக்கள் எப்போதும் முழு நீளத்தில் இயங்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ వీడియోలోని ప్రతి ఫోటోకు వర్తిస్తుంది. వీడియోలు ఎప్పుడూ పూర్తి నిడివిలో ప్లే అవుతాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้กับทุกรูปในวิดีโอนี้ วิดีโอจะเล่นเต็มความยาวเสมอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu videodaki her fotoğraf için geçerlidir. Videolar her zaman tam uzunlukta oynatılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Стосується кожного фото в цьому відео. Відеокліпи завжди відтворюються повністю."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس ویڈیو کی ہر تصویر پر لاگو۔ ویڈیوز ہمیشہ پوری چلتی ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Áp dụng cho mọi ảnh trong video này. Video luôn phát đủ thời lượng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适用于此视频中的每张照片。视频片段始终完整播放。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "套用到這部影片中的每張照片。影片永遠完整播放。"
          }
        }
      }
    },
