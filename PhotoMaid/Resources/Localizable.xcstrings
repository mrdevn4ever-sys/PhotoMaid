            "state": "translated",
            "value": "es. Annuncio → Annuncio_001 (vuoto = nome originale)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "例: 出品 → 出品_001（空欄 = 元の名前）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예: 판매글 → 판매글_001(비우면 원래 이름)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "bijv. Advertentie → Advertentie_001 (leeg = originele naam)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "np. Ogłoszenie → Ogłoszenie_001 (puste = oryginalna nazwa)"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "ex.: Anúncio → Anúncio_001 (vazio = nome original)"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "ex. Anunț → Anunț_001 (gol = numele original)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "напр. Объявление → Объявление_001 (пусто = исходное имя)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "örn. İlan → İlan_001 (boş = orijinal ad)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "напр. Оголошення → Оголошення_001 (порожньо = вихідне ім’я)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
