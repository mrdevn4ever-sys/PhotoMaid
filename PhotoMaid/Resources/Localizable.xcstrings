        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ತಿಳಿದ ಗಾತ್ರದ ಯಾವುದೇ ಪ್ರವೇಶಿಸಬಹುದಾದ ಫೈಲ್ %1$lld MB ಗಿಂತ ದೊಡ್ಡದಲ್ಲ."
