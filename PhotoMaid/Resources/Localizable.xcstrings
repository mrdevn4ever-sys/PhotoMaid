    "today_limited_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض PhotoMaid فقط الصور والفيديوهات التي سمحت له بالوصول إليها. يمكنك ترتيبها كالمعتاد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid zeigt nur freigegebene Fotos und Videos. Diese kannst du wie gewohnt aufräumen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid only shows the photos and videos you’ve allowed. You can clean these up as usual."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid solo muestra las fotos y los vídeos que has autorizado. Puedes revisarlos como siempre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid affiche uniquement les photos et vidéos que tu as autorisées. Tu peux les trier normalement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid mostra solo le foto e i video che hai autorizzato. Puoi riordinarli normalmente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaidには、許可した写真と動画だけが表示されます。表示されたものは通常どおり整理できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid에는 접근을 허용한 사진과 동영상만 표시돼요. 표시된 항목은 평소처럼 정리할 수 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid toont alleen foto’s en video’s waarvoor je toegang hebt gegeven. Je kunt deze gewoon opruimen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid pokazuje tylko zdjęcia i filmy, na które zezwolisz. Możesz je porządkować jak zwykle."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O PhotoMaid só mostra as fotos e os vídeos que autorizaste. Podes organizá-los como habitualmente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid arată doar fotografiile și videoclipurile pentru care ai permis accesul. Le poți organiza ca de obicei."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid показывает только фото и видео, к которым ты разрешаешь доступ. Их можно разбирать как обычно."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid yalnızca izin verdiğin fotoğraf ve videoları gösterir. Bunları her zamanki gibi düzenleyebilirsin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid показує лише фото й відео, до яких ти надаєш доступ. Їх можна впорядковувати як завжди."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid 只会显示你允许访问的照片和视频。这些内容可以正常清理。"
          }
        }
      }
    },
