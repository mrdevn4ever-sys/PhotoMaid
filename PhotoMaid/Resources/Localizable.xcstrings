    "vid_remove_audio_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يُكتب مسار الصوت في الملف إطلاقًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সাউন্ড ট্র্যাক ফাইলে একেবারেই লেখা হয় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La pista de so no s’escriu al fitxer."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvuková stopa se do souboru vůbec nezapíše."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lydsporet skrives slet ikke ind i filen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tonspur wird gar nicht in die Datei geschrieben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το κανάλι ήχου δεν γράφεται καθόλου στο αρχείο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sound track is not written into the file at all."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pista de sonido no se escribe en el archivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ääniraitaa ei kirjoiteta tiedostoon lainkaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La piste son n’est pas du tout écrite dans le fichier."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સાઉન્ડ ટ્રૅક ફાઇલમાં બિલકુલ લખાતો નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פס הקול לא נכתב לקובץ בכלל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साउंड ट्रैक फ़ाइल में बिल्कुल नहीं लिखा जाता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvučni zapis uopće se ne upisuje u datoteku."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hangsáv egyáltalán nem kerül a fájlba."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Trek suara sama sekali tidak ditulis ke file."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La traccia audio non viene scritta nel file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声トラックはファイルに書き込まれません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಧ್ವನಿ ಟ್ರ್ಯಾಕ್ ಅನ್ನು ಫೈಲ್‌ಗೆ ಬರೆಯಲಾಗುವುದೇ ಇಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소리 트랙이 파일에 아예 기록되지 않아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ശബ്ദ ട്രാക്ക് ഫയലിൽ ഒട്ടും എഴുതില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "साउंड ट्रॅक फाइलमध्ये अजिबात लिहिला जात नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Trek bunyi tidak ditulis ke dalam fail langsung."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lydsporet skrives ikke inn i filen i det hele tatt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het geluidsspoor wordt helemaal niet in het bestand geschreven."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଧ୍ୱନି ଟ୍ରାକ୍ ଫାଇଲ୍‌ରେ ଆଦୌ ଲେଖାଯାଏ ନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਆਵਾਜ਼ ਦਾ ਟ੍ਰੈਕ ਫ਼ਾਈਲ ਵਿੱਚ ਬਿਲਕੁਲ ਨਹੀਂ ਲਿਖਿਆ ਜਾਂਦਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ścieżka dźwiękowa w ogóle nie trafia do pliku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A faixa de som nem é gravada no arquivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A faixa de som não é escrita no ficheiro."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pista audio nu este scrisă deloc în fișier."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звуковая дорожка вообще не записывается в файл."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvuková stopa sa do súboru vôbec nezapíše."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvočni posnetek se sploh ne zapiše v datoteko."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ljudspåret skrivs inte alls in i filen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒலித் தடம் கோப்பில் எழுதப்படவே இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సౌండ్ ట్రాక్ ఫైల్‌లో అస్సలు రాయబడదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แทร็กเสียงจะไม่ถูกเขียนลงไฟล์เลย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses kanalı dosyaya hiç yazılmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Звукова доріжка взагалі не записується у файл."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ساؤنڈ ٹریک فائل میں بالکل نہیں لکھا جاتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rãnh âm thanh hoàn toàn không được ghi vào tệp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音轨完全不会写入文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "聲音軌完全不會寫入檔案。"
