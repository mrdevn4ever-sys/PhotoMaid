    "movie_fit_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تُشوَّه المقاطع أبدًا: إما تظهر الصورة كاملة (بحواف سوداء) أو تملأ الإطار وتُقص الحواف."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Klip strækkes aldrig: enten vises hele billedet (med sorte kanter), eller det udfylder rammen, og kanterne skæres af."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Clips werden nie verzerrt: Entweder das ganze Bild ist zu sehen (mit schwarzen Rändern) oder es füllt den Rahmen und die Ränder werden abgeschnitten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clips are never stretched: either the whole picture is shown (with black edges) or it fills the frame and the edges are cut off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los clips nunca se deforman: o se ve la imagen entera (con bordes negros) o llena el encuadre y se recortan los bordes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les clips ne sont jamais déformés : soit l’image entière est visible (bords noirs), soit elle remplit le cadre et les bords sont coupés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Klip tidak pernah diregangkan: gambar ditampilkan utuh (dengan tepi hitam) atau mengisi bingkai dan tepinya terpotong."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le clip non vengono mai deformate: o si vede l’immagine intera (con bordi neri) o riempie il riquadro e i bordi vengono tagliati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップが引き伸ばされることはありません。全体を表示（黒い余白あり）するか、枠いっぱいにして端を切り取ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립은 절대 늘어나지 않습니다. 전체를 보여 주거나(검은 여백) 화면을 채우고 가장자리를 자릅니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Klipp strekkes aldri: enten vises hele bildet (med svarte kanter), eller det fyller rammen og kantene beskjæres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Clips worden nooit vervormd: of het hele beeld is te zien (met zwarte randen) of het vult het kader en de randen vallen weg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klipy nigdy nie są zniekształcane: albo widać cały obraz (z czarnymi krawędziami), albo wypełnia kadr, a krawędzie są przycinane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os clipes nunca são esticados: ou a imagem inteira é mostrada (com bordas pretas), ou ela preenche o quadro e as bordas são cortadas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os clipes nunca são deformados: ou se vê a imagem inteira (com margens pretas) ou preenche o enquadramento e as margens são cortadas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Clipurile nu sunt deformate niciodată: fie se vede imaginea întreagă (cu margini negre), fie umple cadrul și marginile se taie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клипы никогда не растягиваются: либо видно всё изображение (с чёрными полями), либо оно заполняет кадр, а края обрезаются."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klipp sträcks aldrig ut: antingen visas hela bilden (med svarta kanter) eller så fyller den bildrutan och kanterna beskärs."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คลิปจะไม่ถูกยืด: แสดงภาพทั้งหมด (มีขอบดำ) หรือเต็มเฟรมโดยตัดขอบออก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klipler asla esnetilmez: ya görüntünün tamamı görünür (siyah kenarlarla) ya da kareyi doldurur ve kenarlar kırpılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кліпи ніколи не розтягуються: або видно все зображення (з чорними полями), або воно заповнює кадр, а краї обрізаються."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các đoạn không bao giờ bị kéo giãn: hoặc hiện toàn bộ hình (có viền đen), hoặc lấp đầy khung và cắt bớt phần viền."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "片段绝不会被拉伸：要么完整显示（带黑边），要么填满画面并裁掉边缘。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "片段永遠不會被拉伸：要嘛顯示完整畫面（加上黑邊），要嘛填滿畫面並裁掉邊緣。"
          }
        }
      }
    },
