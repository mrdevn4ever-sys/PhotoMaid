            "state": "translated",
            "value": "So geht’s. Jetzt sind deine Fotos dran."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That’s how it works. Now for your photos."
          }
        },
        "es": {
