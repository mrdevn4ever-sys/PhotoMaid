    "vault2_local_only": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا حساب ولا خادم PhotoMaid. لا تغادر الصادرات والنسخ الاحتياطية التطبيق إلا بإجراء صريح منك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Konto und kein PhotoMaid-Server. Exporte und Backups verlassen die App nur durch deine ausdrückliche Aktion."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No account and no PhotoMaid server. Exports and backups leave the app only through your explicit action."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin cuenta ni servidor PhotoMaid. Las exportaciones y copias solo salen de la app por una acción explícita tuya."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun compte ni serveur PhotoMaid. Les exports et sauvegardes quittent l’app uniquement sur votre action explicite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun account o server PhotoMaid. Esportazioni e backup escono dall’app solo con una tua azione esplicita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントもPhotoMaidサーバーも使いません。書き出しやバックアップは明示的に操作したときだけアプリの外に出ます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정이나 PhotoMaid 서버가 없습니다. 명시적인 작업을 수행해야 내보내기와 백업이 앱 밖으로 나갑니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen account of PhotoMaid-server. Exports en back-ups verlaten de app alleen op jouw uitdrukkelijke verzoek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez konta i serwera PhotoMaid. Eksporty i kopie opuszczają aplikację tylko po Twoim wyraźnym działaniu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem conta nem servidor PhotoMaid. Exportações e cópias só saem da app por uma ação tua explícita."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fără cont și fără server PhotoMaid. Exporturile și copiile părăsesc aplicația doar prin acțiunea ta explicită."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без аккаунта и сервера PhotoMaid. Экспорт и резервные копии покидают приложение только по вашему явному действию."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap ve PhotoMaid sunucusu yoktur. Dışa aktarımlar ve yedekler yalnızca açık işleminle uygulamadan çıkar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Без облікового запису та сервера PhotoMaid. Експорт і копії залишають програму лише після вашої явної дії."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需账户，不使用PhotoMaid服务器。只有在你明确操作后，导出文件和备份才会离开应用。"
          }
        }
      }
    },
