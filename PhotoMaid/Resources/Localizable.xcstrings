    "tour_studio_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عدّل الصور، واصنع صورًا مجمّعة وأفلامًا قصيرة وملفات PDF، واستخدم أدوات مفيدة. تحصل دائمًا على ملفات جديدة – وتبقى الأصول كما هي."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Rediger fotos, lav collager, kortfilm og PDF'er, og brug praktiske værktøjer. Du får altid nye filer – dine originaler forbliver, som de er."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos bearbeiten, Collagen, kleine Filme, PDFs und praktische Werkzeuge. Dabei entstehen immer neue Dateien – deine Originale bleiben, wie sie sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit photos, make collages, short films and PDFs, and use handy tools. You always get new files – your originals stay as they are."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Edita fotos, crea collages, películas cortas y PDF, y usa herramientas prácticas. Siempre se crean archivos nuevos: tus originales no cambian."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retouchez vos photos, créez des collages, de petits films et des PDF, et utilisez des outils pratiques. De nouveaux fichiers sont toujours créés – vos originaux restent intacts."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit foto, buat kolase, film pendek, dan PDF, dan pakai alat praktis. Kamu selalu mendapat file baru – aslimu tetap seperti semula."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifica le foto, crea collage, brevi filmati e PDF e usa strumenti pratici. Nascono sempre nuovi file: gli originali restano come sono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真の編集、コラージュ、短いムービー、PDF、便利なツール。いつも新しいファイルが作られ、元の写真はそのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 편집, 콜라주, 짧은 영상, PDF, 편리한 도구까지. 항상 새 파일이 만들어지고 원본은 그대로예요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rediger bilder, lag collager, kortfilmer og PDF-er, og bruk nyttige verktøy. Du får alltid nye filer – originalene dine forblir som de er."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto’s bewerken, collages, korte films, pdf’s en handige hulpmiddelen. Er komen altijd nieuwe bestanden bij – je originelen blijven zoals ze zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Edytuj zdjęcia, twórz kolaże, krótkie filmy i pliki PDF, korzystaj z przydatnych narzędzi. Zawsze powstają nowe pliki – oryginały zostają bez zmian."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Edite fotos, faça colagens, filmes curtos e PDFs e use ferramentas práticas. Você sempre recebe arquivos novos – seus originais ficam como estão."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Edite fotos, crie colagens, pequenos filmes e PDF e use ferramentas práticas. São sempre criados ficheiros novos – os originais ficam como estão."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Editează fotografii, fă colaje, filmulețe și PDF-uri și folosește unelte practice. Se creează mereu fișiere noi – originalele rămân neschimbate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Редактируйте фото, делайте коллажи, короткие фильмы и PDF, пользуйтесь удобными инструментами. Всегда создаются новые файлы – оригиналы остаются как есть."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Redigera bilder, gör collage, kortfilmer och PDF:er och använd smarta verktyg. Du får alltid nya filer – dina original förblir som de är."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แก้ไขรูป ทำภาพตัดปะ หนังสั้น และ PDF พร้อมเครื่องมือที่มีประโยชน์ คุณจะได้ไฟล์ใหม่เสมอ – ต้นฉบับยังคงเหมือนเดิม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğrafları düzenle, kolaj, kısa film ve PDF yap, pratik araçları kullan. Her zaman yeni dosyalar oluşur – orijinallerin olduğu gibi kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Редагуйте фото, створюйте колажі, короткі фільми й PDF, користуйтеся зручними інструментами. Завжди створюються нові файли – оригінали лишаються як є."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sửa ảnh, làm ảnh ghép, phim ngắn và PDF, cùng các công cụ tiện dụng. Bạn luôn nhận được tệp mới – bản gốc giữ nguyên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑照片，制作拼图、小影片和 PDF，并使用实用工具。始终生成新文件——原始照片保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "編輯照片，製作拼貼、短片和 PDF，還有實用的工具。你永遠會得到新檔案 – 原始檔保持原樣。"
          }
        }
      }
    },
