    "pdf_files_failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر فتح الملفات. اختر ملفات PDF غير مقفلة أو صورًا قابلة للقراءة وحاول مجددًا. لم تتغير صفحاتك الحالية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফাইলগুলো খোলা যায়নি। পড়া যায় এমন, আনলক করা PDF বা ছবি বেছে নিয়ে আবার চেষ্টা করুন। আপনার বর্তমান পৃষ্ঠাগুলো অপরিবর্তিত।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s’han pogut obrir els fitxers. Tria PDF o imatges llegibles i sense bloqueig i torna-ho a provar. Les pàgines actuals no canvien."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Soubory se nepodařilo otevřít. Vyberte čitelná, nezamčená PDF nebo obrázky a zkuste to znovu. Vaše aktuální stránky zůstanou beze změny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Filerne kunne ikke åbnes. Vælg læsbare, ulåste PDF'er eller billeder, og prøv igen. Dine nuværende sider er uændrede."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Dateien konnten nicht geöffnet werden. Wähle lesbare, ungesperrte PDFs oder Bilder und versuche es erneut. Deine bisherigen Seiten bleiben erhalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατό το άνοιγμα των αρχείων. Επίλεξε αναγνώσιμα, ξεκλείδωτα PDF ή εικόνες και δοκίμασε ξανά. Οι τρέχουσες σελίδες σου δεν άλλαξαν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The files could not be opened. Choose readable, unlocked PDFs or images and try again. Your current pages are unchanged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron abrir los archivos. Elige PDF sin bloqueo o imágenes legibles e inténtalo de nuevo. Tus páginas se conservan."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiedostoja ei voitu avata. Valitse luettavia, lukitsemattomia PDF:iä tai kuvia ja yritä uudelleen. Nykyiset sivusi pysyvät ennallaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’ouvrir les fichiers. Choisissez des PDF non verrouillés ou des images lisibles et réessayez. Vos pages sont conservées."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફાઇલો ખોલી શકાઈ નથી. વાંચી શકાય તેવી, લૉક વિનાની PDF કે છબીઓ પસંદ કરો અને ફરી પ્રયાસ કરો. તમારાં વર્તમાન પાનાં બદલાયાં નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה לפתוח את הקבצים. יש לבחור קובצי PDF או תמונות קריאים ולא נעולים ולנסות שוב. העמודים הנוכחיים לא השתנו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ाइलें खोली नहीं जा सकीं। पढ़े जा सकने वाले, बिना लॉक वाले PDF या इमेज चुनें और फिर कोशिश करें। आपके मौजूदा पेज नहीं बदले।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Datoteke nije bilo moguće otvoriti. Odaberi čitljive, otključane PDF-ove ili slike i pokušaj ponovno. Tvoje trenutačne stranice ostaju nepromijenjene."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fájlok nem nyithatók meg. Válassz olvasható, nem zárolt PDF-eket vagy képeket, és próbáld újra. A jelenlegi oldalaid változatlanok."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File tidak dapat dibuka. Pilih PDF atau gambar yang dapat dibaca dan tidak terkunci, lalu coba lagi. Halamanmu saat ini tidak berubah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile aprire i file. Scegli PDF non bloccati o immagini leggibili e riprova. Le pagine attuali restano invariate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルを開けませんでした。ロックされていないPDFや読み取り可能な画像で再試行してください。現在のページは保持されます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಫೈಲ್‌ಗಳನ್ನು ತೆರೆಯಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ. ಓದಬಹುದಾದ, ಅನ್‌ಲಾಕ್ ಮಾಡಿದ PDF ಗಳು ಅಥವಾ ಚಿತ್ರಗಳನ್ನು ಆಯ್ಕೆಮಾಡಿ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ. ನಿಮ್ಮ ಪ್ರಸ್ತುತ ಪುಟಗಳು ಬದಲಾಗಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일을 열 수 없습니다. 잠기지 않은 PDF나 읽을 수 있는 이미지를 선택하고 다시 시도하세요. 현재 페이지는 유지됩니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഫയലുകൾ തുറക്കാനായില്ല. വായിക്കാവുന്ന, അൺലോക്ക് ചെയ്ത PDF-കളോ ചിത്രങ്ങളോ തിരഞ്ഞെടുത്ത് വീണ്ടും ശ്രമിക്കുക. നിങ്ങളുടെ നിലവിലെ പേജുകൾക്ക് മാറ്റമില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फाइल्स उघडता आल्या नाहीत. वाचता येणाऱ्या, लॉक नसलेल्या PDF किंवा प्रतिमा निवडा आणि पुन्हा प्रयत्न करा. तुमची सध्याची पाने बदललेली नाहीत."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Fail tidak dapat dibuka. Pilih PDF atau imej yang boleh dibaca dan tidak berkunci, kemudian cuba lagi. Halaman semasa anda tidak berubah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Filene kunne ikke åpnes. Velg lesbare, ulåste PDF-er eller bilder og prøv igjen. De nåværende sidene dine er uendret."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bestanden konden niet worden geopend. Kies leesbare, ontgrendelde pdf’s of afbeeldingen en probeer opnieuw. Je pagina’s blijven behouden."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଫାଇଲ୍ ଖୋଲାଯାଇପାରିଲା ନାହିଁ। ପଢ଼ିହେଉଥିବା, ଅନଲକ୍ ହୋଇଥିବା PDF କିମ୍ବା ଛବି ବାଛି ପୁଣି ଚେଷ୍ଟା କରନ୍ତୁ। ଆପଣଙ୍କ ବର୍ତ୍ତମାନର ପୃଷ୍ଠା ଅପରିବର୍ତ୍ତିତ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਫ਼ਾਈਲਾਂ ਖੋਲ੍ਹੀਆਂ ਨਹੀਂ ਜਾ ਸਕੀਆਂ। ਪੜ੍ਹਨਯੋਗ, ਅਨਲੌਕ ਕੀਤੀਆਂ PDF ਜਾਂ ਤਸਵੀਰਾਂ ਚੁਣੋ ਅਤੇ ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰੋ। ਤੁਹਾਡੇ ਮੌਜੂਦਾ ਪੰਨੇ ਬਿਨਾਂ ਬਦਲੇ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można otworzyć plików. Wybierz niezablokowane pliki PDF lub czytelne obrazy i spróbuj ponownie. Obecne strony pozostają bez zmian."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível abrir os arquivos. Escolha PDFs ou imagens legíveis e desbloqueados e tente de novo. Suas páginas atuais não foram alteradas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível abrir os ficheiros. Escolha PDF desbloqueados ou imagens legíveis e tente novamente. As páginas atuais mantêm-se."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fișierele nu au putut fi deschise. Alege PDF-uri deblocate sau imagini lizibile și încearcă din nou. Paginile actuale rămân neschimbate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось открыть файлы. Выберите доступные PDF без блокировки или изображения и повторите попытку. Текущие страницы сохранены."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Súbory sa nepodarilo otvoriť. Vyberte čitateľné, nezamknuté PDF alebo obrázky a skúste to znova. Vaše aktuálne strany zostanú bez zmeny."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Datotek ni bilo mogoče odpreti. Izberi berljive, odklenjene PDF-je ali slike in poskusi znova. Tvoje trenutne strani so nespremenjene."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Filerna kunde inte öppnas. Välj läsbara, olåsta PDF:er eller bilder och försök igen. Dina nuvarande sidor är oförändrade."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கோப்புகளைத் திறக்க முடியவில்லை. படிக்கக்கூடிய, பூட்டப்படாத PDF-களையோ படங்களையோ தேர்ந்தெடுத்து மீண்டும் முயலுங்கள். உங்கள் தற்போதைய பக்கங்கள் மாறவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫైళ్లను తెరవడం సాధ్యం కాలేదు. చదవగలిగే, అన్‌లాక్ చేసిన PDFలు లేదా చిత్రాలను ఎంచుకుని మళ్లీ ప్రయత్నించండి. మీ ప్రస్తుత పేజీలు మారలేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถเปิดไฟล์ได้ เลือก PDF หรือรูปภาพที่อ่านได้และไม่ถูกล็อก แล้วลองอีกครั้ง หน้าปัจจุบันของคุณไม่เปลี่ยนแปลง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyalar açılamadı. Okunabilir, kilitsiz PDF veya görsel seçip tekrar dene. Mevcut sayfaların değişmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося відкрити файли. Виберіть доступні незаблоковані PDF або зображення й повторіть спробу. Поточні сторінки збережено."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فائلیں کھولی نہیں جا سکیں۔ قابل مطالعہ، غیر مقفل PDF یا تصاویر منتخب کریں اور دوبارہ کوشش کریں۔ آپ کے موجودہ صفحات تبدیل نہیں ہوئے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể mở các tệp. Hãy chọn PDF hoặc hình ảnh đọc được, không bị khóa, rồi thử lại. Các trang hiện tại của bạn không thay đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开文件。请选择可读取且未锁定的 PDF 或图片后重试。当前页面保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法打開檔案。請選擇可讀取、未鎖定的 PDF 或圖片，然後再試一次。你目前的頁面沒有更改。"
          }
        }
      }
    },
    "pdf_files_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر ملفات PDF أو صورًا من تطبيق الملفات. ادمج الصفحات ورتّبها ودوّرها مع معاينة مباشرة، ثم احفظ ملف PDF جديدًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফাইলস থেকে PDF বা ছবি বেছে নিন। লাইভ প্রিভিউসহ পৃষ্ঠা জুড়ুন, ক্রম বদলান ও ঘোরান, তারপর নতুন PDF সংরক্ষণ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tria PDF o imatges de Fitxers. Combina, reordena i gira pàgines amb previsualització en directe i després desa un PDF nou."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte PDF nebo obrázky ze Souborů. Spojujte, řaďte a otáčejte stránky s živým náhledem a pak uložte nové PDF."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg PDF'er eller billeder fra Arkiver. Kombinér, omarranger og roter sider med direkte eksempel, og gem derefter en ny PDF."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle PDFs oder Bilder aus der Dateien-App. Füge Seiten zusammen, sortiere und drehe sie mit sichtbarer Vorschau. Speichere das Ergebnis als neues PDF."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επίλεξε PDF ή εικόνες από τα Αρχεία. Συνένωσε, αναδιάταξε και περίστρεψε σελίδες με ζωντανή προεπισκόπηση και μετά αποθήκευσε ένα νέο PDF."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose PDFs or images from Files. Combine, reorder and rotate pages with a live preview, then save a new PDF."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige PDF o imágenes de Archivos. Combina, ordena y gira páginas con una vista previa y guarda un PDF nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse PDF:iä tai kuvia Tiedostoista. Yhdistä, järjestä ja kierrä sivuja reaaliaikaisella esikatselulla ja tallenna sitten uusi PDF."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez des PDF ou images dans Fichiers. Assemblez, réorganisez et pivotez les pages avec un aperçu, puis enregistrez un nouveau PDF."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફાઇલ્સમાંથી PDF કે છબીઓ પસંદ કરો. લાઇવ પ્રીવ્યૂ સાથે પાનાં જોડો, ક્રમ બદલો અને ફેરવો, પછી નવી PDF સાચવો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לבחור קובצי PDF או תמונות מ״קבצים״. אפשר לאחד, לסדר ולסובב עמודים עם תצוגה מקדימה חיה, ואז לשמור PDF חדש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ाइल्स से PDF या इमेज चुनें। लाइव प्रीव्यू के साथ पेज जोड़ें, क्रम बदलें और घुमाएँ, फिर नया PDF सहेजें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberi PDF-ove ili slike iz Datoteka. Spajaj, mijenjaj redoslijed i okreći stranice uz pregled uživo, a zatim spremi novi PDF."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válassz PDF-eket vagy képeket a Fájlokból. Fűzd össze, rendezd és forgasd az oldalakat élő előnézettel, majd ments el egy új PDF-et."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih PDF atau gambar dari File. Gabungkan, atur urutan, dan putar halaman dengan pratinjau langsung, lalu simpan PDF baru."
