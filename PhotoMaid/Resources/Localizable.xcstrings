    "lib_group_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المجموعة تعرض المجلدات معًا فقط. لا يُنقل شيء ولا يُنسخ، وحذف المجموعة لا يحذف أي صور."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Gruppe zeigt nur Ordner zusammen. Nichts wird verschoben oder kopiert; die Gruppe zu löschen löscht keine Fotos."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A group only shows folders together. Nothing is moved or copied, and deleting the group deletes no photos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un grupo solo muestra carpetas juntas. No se mueve ni copia nada, y eliminar el grupo no elimina fotos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un groupe affiche seulement des dossiers ensemble. Rien n’est déplacé ni copié, et supprimer le groupe ne supprime aucune photo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un gruppo mostra solo cartelle insieme. Nulla viene spostato o copiato ed eliminare il gruppo non elimina foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループはフォルダをまとめて表示するだけです。移動もコピーもされず、グループを削除しても写真は削除されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그룹은 폴더를 함께 보여 줄 뿐입니다. 아무것도 옮기거나 복사하지 않으며, 그룹을 삭제해도 사진은 삭제되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een groep toont alleen mappen samen. Er wordt niets verplaatst of gekopieerd; de groep verwijderen verwijdert geen foto’s."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Grupa tylko pokazuje foldery razem. Nic nie jest przenoszone ani kopiowane, a usunięcie grupy nie usuwa zdjęć."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um grupo apenas mostra pastas em conjunto. Nada é movido nem copiado, e eliminar o grupo não elimina fotos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un grup doar afișează dosare împreună. Nimic nu se mută sau copiază, iar ștergerea grupului nu șterge fotografii."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Группа просто показывает папки вместе. Ничего не перемещается и не копируется, а удаление группы не удаляет фото."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Grup yalnızca klasörleri birlikte gösterir. Hiçbir şey taşınmaz veya kopyalanmaz; grubu silmek fotoğraf silmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Група лише показує папки разом. Нічого не переміщується й не копіюється, а видалення групи не видаляє фото."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分组只是把文件夹放在一起显示。不会移动或复制任何内容，删除分组也不会删除照片。"
          }
        }
      }
    },
