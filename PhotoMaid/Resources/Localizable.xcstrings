    "tools_location_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبدو النسخ مثل الأصل تمامًا – يُزال فقط مكان التقاط الصورة. تُتخطّى الصور التي لا تحتوي على موقع."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কপিগুলো হুবহু মূলের মতো দেখায় – শুধু ফটোটি কোথায় তোলা হয়েছিল তা সরানো হয়। লোকেশন ছাড়া ফটো বাদ যায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les còpies són exactament iguals que l’original: només s’elimina el lloc on es va fer la foto. Les fotos sense ubicació s’ometen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopie vypadají přesně jako originál – odstraní se jen místo pořízení. Fotky bez polohy se přeskočí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopierne ser præcis ud som originalen – kun stedet, hvor fotoet blev taget, fjernes. Fotos uden lokalitet springes over."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kopien sehen genauso aus wie das Original – nur der Aufnahmeort wird entfernt. Fotos ohne Ort werden übersprungen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα αντίγραφα μοιάζουν ακριβώς με το πρωτότυπο – αφαιρείται μόνο το σημείο λήψης. Φωτογραφίες χωρίς τοποθεσία παραλείπονται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The copies look exactly like the original – only the place where the photo was taken is removed. Photos without a location are skipped."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las copias son idénticas al original: solo se quita el lugar donde se hizo la foto. Las fotos sin ubicación se omiten."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiot näyttävät täsmälleen alkuperäiseltä – vain kuvauspaikka poistetaan. Kuvat, joissa ei ole sijaintia, ohitetaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les copies sont identiques à l’original – seul le lieu de prise de vue est retiré. Les photos sans lieu sont ignorées."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "નકલો બરાબર મૂળ જેવી દેખાય છે – ફક્ત ફોટો જ્યાં લેવાયો તે જગ્યા દૂર થાય છે. સ્થાન વિનાના ફોટા છોડી દેવાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העותקים נראים בדיוק כמו המקור – רק המקום שבו צולמה התמונה מוסר. תמונות בלי מיקום מדולגות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कॉपी बिल्कुल मूल जैसी दिखती हैं – सिर्फ़ वह जगह हटती है जहाँ फ़ोटो ली गई। बिना लोकेशन वाली फ़ोटो छोड़ दी जाती हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopije izgledaju točno kao original – uklanja se samo mjesto snimanja. Fotografije bez lokacije preskaču se."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A másolatok pontosan úgy néznek ki, mint az eredeti – csak a készítés helye törlődik. A hely nélküli fotók kimaradnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Salinannya terlihat persis seperti aslinya – hanya tempat foto diambil yang dihapus. Foto tanpa lokasi dilewati."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le copie sono identiche all’originale: viene tolto solo il luogo dello scatto. Le foto senza posizione vengono saltate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピーは元の写真とまったく同じ見た目で、撮影場所だけが削除されます。場所のない写真はスキップします。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪ್ರತಿಗಳು ಮೂಲದಂತೆಯೇ ನಿಖರವಾಗಿ ಕಾಣುತ್ತವೆ – ಫೋಟೋ ತೆಗೆದ ಸ್ಥಳವನ್ನು ಮಾತ್ರ ತೆಗೆದುಹಾಕಲಾಗುತ್ತದೆ. ಸ್ಥಳವಿಲ್ಲದ ಫೋಟೋಗಳನ್ನು ಬಿಡಲಾಗುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복사본은 원본과 똑같아 보여요. 촬영 장소만 지워져요. 장소 정보가 없는 사진은 건너뛰어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പകർപ്പുകൾ ഒറിജിനൽ പോലെ തന്നെ കാണപ്പെടും – ഫോട്ടോ എടുത്ത സ്ഥലം മാത്രം നീക്കം ചെയ്യും. ലൊക്കേഷനില്ലാത്ത ഫോട്ടോകൾ ഒഴിവാക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रती अगदी मूळसारख्या दिसतात – फक्त फोटो जिथे काढला ते ठिकाण काढले जाते. स्थान नसलेले फोटो वगळले जातात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Salinan kelihatan sama seperti yang asal – hanya tempat foto diambil dibuang. Foto tanpa lokasi dilangkau."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiene ser nøyaktig ut som originalen – bare stedet der bildet ble tatt, fjernes. Bilder uten sted hoppes over."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De kopieën zien er precies zo uit als het origineel – alleen de opnameplek wordt verwijderd. Foto’s zonder locatie worden overgeslagen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "କପିଗୁଡ଼ିକ ଠିକ୍ ମୂଳ ଭଳି ଦେଖାଯାଏ – କେବଳ ଫଟୋଟି କେଉଁଠି ଉଠାଯାଇଥିଲା ତାହା ହଟାଯାଏ। ଲୋକେସନ୍ ନଥିବା ଫଟୋ ବାଦ ଦିଆଯାଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕਾਪੀਆਂ ਬਿਲਕੁਲ ਮੂਲ ਵਰਗੀਆਂ ਦਿਸਦੀਆਂ ਹਨ – ਸਿਰਫ਼ ਉਹ ਥਾਂ ਹਟਾਈ ਜਾਂਦੀ ਹੈ ਜਿੱਥੇ ਫ਼ੋਟੋ ਖਿੱਚੀ ਗਈ ਸੀ। ਬਿਨਾਂ ਟਿਕਾਣੇ ਵਾਲੀਆਂ ਫ਼ੋਟੋਆਂ ਛੱਡ ਦਿੱਤੀਆਂ ਜਾਂਦੀਆਂ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopie wyglądają dokładnie jak oryginał – usuwane jest tylko miejsce zrobienia zdjęcia. Zdjęcia bez lokalizacji są pomijane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As cópias ficam idênticas ao original – só o lugar onde a foto foi tirada é removido. Fotos sem localização são puladas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As cópias ficam iguais ao original – só é removido o local onde a foto foi tirada. As fotos sem localização são ignoradas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiile arată exact ca originalul – se elimină doar locul în care a fost făcută fotografia. Fotografiile fără locație sunt omise."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копии выглядят точно как оригинал – удаляется только место съёмки. Фото без места пропускаются."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kópie vyzerajú presne ako originál – odstráni sa len miesto nasnímania. Fotky bez polohy sa preskočia."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopije so videti natanko kot izvirnik – odstrani se le kraj posnetka. Fotografije brez lokacije se preskočijo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiorna ser exakt ut som originalet – bara platsen där bilden togs tas bort. Bilder utan plats hoppas över."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நகல்கள் அசலைப் போலவே தோன்றும் – புகைப்படம் எடுக்கப்பட்ட இடம் மட்டுமே அகற்றப்படும். இருப்பிடம் இல்லாத புகைப்படங்கள் தவிர்க்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కాపీలు ఒరిజినల్‌లాగే కనిపిస్తాయి – ఫోటో తీసిన ప్రదేశం మాత్రమే తీసివేయబడుతుంది. లొకేషన్ లేని ఫోటోలను వదిలేస్తారు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สำเนาดูเหมือนต้นฉบับทุกประการ – ลบเฉพาะสถานที่ถ่ายรูป รูปที่ไม่มีตำแหน่งจะถูกข้าม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopyalar orijinalle tamamen aynı görünür – yalnızca çekim yeri kaldırılır. Konumu olmayan fotoğraflar atlanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Копії виглядають точно як оригінал – видаляється лише місце зйомки. Фото без місця пропускаються."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کاپیاں بالکل اصل جیسی لگتی ہیں – صرف وہ جگہ ہٹتی ہے جہاں تصویر لی گئی۔ بغیر مقام والی تصاویر چھوڑ دی جاتی ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản sao trông giống hệt bản gốc – chỉ nơi chụp ảnh bị xóa. Ảnh không có vị trí sẽ bị bỏ qua."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "副本与原照片看起来完全相同，只会去掉拍摄地点。没有位置信息的照片会被跳过。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "副本看起來與原始檔完全相同 – 只會移除照片的拍攝地點。沒有位置的照片會略過。"
          }
        }
      }
    },
