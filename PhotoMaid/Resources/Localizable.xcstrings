            "state": "translated",
            "value": "Restaurar les compres"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obnovit nákupy"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gendan køb"
          }
        },
        "de": {
