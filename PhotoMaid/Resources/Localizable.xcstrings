    "snake_shuffle_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُطبق الخلط على اللعبة الجديدة التالية. تغيير الصور يوقف اللعبة الحالية مؤقتًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanding gælder for det næste nye spil. Skift af fotos sætter det aktuelle spil på pause."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mischen gilt für die nächste neue Runde. Fotoänderungen pausieren das laufende Spiel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shuffle applies to the next new game. Changing photos pauses the current game."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mezcla se aplica a la siguiente partida nueva. Cambiar fotos pausa la partida actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mélange s’applique à la prochaine nouvelle partie. Modifier les photos met la partie actuelle en pause."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Acak berlaku untuk game baru berikutnya. Mengganti foto menjeda game saat ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La riproduzione casuale si applica alla prossima nuova partita. Cambiare foto mette in pausa la partita attuale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シャッフルは次の新しいゲームに適用されます。写真を変更すると現在のゲームが一時停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "섞기는 다음 새 게임에 적용됩니다. 사진을 바꾸면 현재 게임이 일시 정지됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Blandingen gjelder neste nye spill. Å bytte bilder setter det pågående spillet på pause."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengen geldt voor het volgende nieuwe spel. Foto's wijzigen pauzeert het huidige spel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasowanie dotyczy następnej nowej gry. Zmiana zdjęć wstrzymuje bieżącą grę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Embaralhar vale para o próximo jogo novo. Trocar fotos pausa o jogo atual."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A mistura aplica-se ao próximo jogo novo. Alterar fotos pausa o jogo atual."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Amestecarea se aplică următorului joc nou. Modificarea fotografiilor pune jocul curent pe pauză."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перемешивание применяется к следующей новой игре. Изменение фото ставит текущую игру на паузу."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Blandningen gäller nästa nya spel. Att byta bilder pausar det pågående spelet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การสลับจะมีผลกับเกมใหม่ครั้งถัดไป การเปลี่ยนรูปจะหยุดเกมปัจจุบันชั่วคราว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karıştırma sonraki yeni oyun için geçerlidir. Fotoğrafları değiştirmek mevcut oyunu duraklatır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перемішування діє для наступної нової гри. Зміна фото призупиняє поточну гру."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xáo trộn áp dụng cho ván mới tiếp theo. Đổi ảnh sẽ tạm dừng ván hiện tại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打乱仅用于下一局新游戏。更改照片会暂停当前游戏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隨機排列會套用到下一場新遊戲。更換照片會暫停目前的遊戲。"
          }
        }
      }
    },
