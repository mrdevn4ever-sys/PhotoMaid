            "state": "translated",
            "value": "Geschützte Inhalte öffnen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άνοιξε το προστατευμένο περιεχόμενό σου"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open your protected content"
          }
        },
        "es": {
          "stringUnit": {
