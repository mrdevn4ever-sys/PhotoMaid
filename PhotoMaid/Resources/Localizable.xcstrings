            "value": "Continuă și dacă schimbi aplicația."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжается, даже если переключиться на другое приложение."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokračuje, aj keď prepnete aplikáciu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Teče naprej, tudi če preklopiš aplikacijo."
