    "basket_confirm_files_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن التراجع عن ذلك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি পূর্বাবস্থায় ফেরানো যায় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No es pot desfer."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuto akci nelze vrátit."
          }
