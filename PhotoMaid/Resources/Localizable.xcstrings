    "export_expired": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنهى iOS التصدير في الخلفية. لم يُحفظ شيء – ابدأه من جديد وأبقِ PhotoMaid مفتوحًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS hat den Export im Hintergrund beendet. Es wurde nichts gespeichert – starte ihn erneut und lass PhotoMaid geöffnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ended the export in the background. Nothing was saved – start it again and keep PhotoMaid open."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ha detenido la exportación en segundo plano. No se ha guardado nada: vuelve a empezar y deja PhotoMaid abierta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS a arrêté l’export en arrière-plan. Rien n’a été enregistré – relancez-le et laissez PhotoMaid ouverte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ha interrotto l’esportazione in background. Non è stato salvato nulla: riavviala e lascia PhotoMaid aperta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOSがバックグラウンドで書き出しを終了しました。何も保存されていません。もう一度開始し、PhotoMaidを開いたままにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS가 백그라운드에서 내보내기를 종료했습니다. 아무것도 저장되지 않았습니다. 다시 시작하고 PhotoMaid를 열어 두세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS heeft de export op de achtergrond beëindigd. Er is niets bewaard – start opnieuw en houd PhotoMaid open."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS zakończył eksport w tle. Nic nie zapisano – uruchom go ponownie i nie zamykaj PhotoMaid."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O iOS terminou a exportação em segundo plano. Nada foi guardado – comece de novo e mantenha o PhotoMaid aberto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS a oprit exportul în fundal. Nu s-a salvat nimic – pornește-l din nou și lasă PhotoMaid deschisă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS прервал экспорт в фоне. Ничего не сохранено – запустите заново и не закрывайте PhotoMaid."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS dışa aktarmayı arka planda sonlandırdı. Hiçbir şey kaydedilmedi; yeniden başlat ve PhotoMaid’i açık tut."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS перервав експорт у фоні. Нічого не збережено – запустіть знову й не закривайте PhotoMaid."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 在后台结束了导出。未存储任何内容 – 请重新开始并保持 PhotoMaid 打开。"
          }
        }
      }
    },
    "export_keep_open": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك الانتقال إلى تطبيق آخر لفترة قصيرة. إذا أنهى iOS الوقت، يتوقف PhotoMaid بشكل سليم ولا يُحفظ شيء غير مكتمل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst kurz in eine andere App wechseln. Beendet iOS die Zeit, bricht PhotoMaid sauber ab – es wird nichts Halbes gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can briefly switch to another app. If iOS ends the time, PhotoMaid stops cleanly – nothing half-finished is saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes cambiar un momento a otra app. Si iOS agota el tiempo, PhotoMaid se detiene sin problemas y no se guarda nada a medias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez passer brièvement à une autre app. Si iOS met fin au délai, PhotoMaid s’arrête proprement – rien d’inachevé n’est enregistré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi passare per poco a un’altra app. Se iOS esaurisce il tempo, PhotoMaid si ferma in modo pulito e non salva nulla a metà."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "少しの間ならほかのアプリに切り替えられます。iOSが時間を打ち切った場合、PhotoMaidは安全に中止し、途中までのものは保存しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠시 다른 앱으로 전환해도 됩니다. iOS가 시간을 종료하면 PhotoMaid는 깔끔하게 중단하며 반쯤 된 결과는 저장하지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt even naar een andere app gaan. Beëindigt iOS de tijd, dan stopt PhotoMaid netjes – er wordt niets half bewaard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz na chwilę przejść do innej aplikacji. Jeśli iOS zakończy czas, PhotoMaid przerwie bezpiecznie – nic niedokończonego nie zostanie zapisane."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode mudar por pouco tempo para outra app. Se o iOS terminar o tempo, o PhotoMaid para em segurança – nada incompleto é guardado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Poți trece scurt în altă aplicație. Dacă iOS încheie timpul, PhotoMaid se oprește curat – nu se salvează nimic pe jumătate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно ненадолго переключиться на другое приложение. Если iOS прервёт время, PhotoMaid аккуратно остановится – ничего недоделанного не сохранится."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kısa süreliğine başka bir uygulamaya geçebilirsin. iOS süreyi sonlandırırsa PhotoMaid düzgünce durur, yarım kalan hiçbir şey kaydedilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Можна ненадовго перейти до іншої програми. Якщо iOS завершить час, PhotoMaid акуратно зупиниться – нічого незавершеного не збережеться."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以短暂切换到其他 App。如果 iOS 结束了时间，PhotoMaid 会干净地停止，不会存储未完成的内容。"
          }
        }
      }
    },
