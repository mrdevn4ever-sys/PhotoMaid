    "onb_offer_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب ورتّب بلا حدود، مع إعلانات من حين لآخر. إزالة العناصر لها حد يومي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wische und sortiere unbegrenzt, mit gelegentlicher Werbung. Für das Entfernen gilt ein Tageslimit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe and organize without limits, with occasional ads. Removing items has a daily limit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza y organiza sin límite, con anuncios ocasionales. Quitar elementos tiene un límite diario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais défiler et organise sans limite, avec quelques publicités. Le retrait d’éléments est limité par jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri e organizza senza limiti, con pubblicità occasionali. La rimozione ha un limite giornaliero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スワイプと整理は無制限で、ときどき広告が表示されます。削除には1日の上限があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가끔 광고가 표시되며, 스와이프와 정리는 무제한이에요. 항목 삭제에는 하루 한도가 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Veeg en orden onbeperkt, met af en toe een advertentie. Voor verwijderen geldt een daglimiet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeglądaj i porządkuj bez limitu, z reklamami od czasu do czasu. Usuwanie ma limit dzienny."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza e organiza sem limites, com anúncios ocasionais. A remoção de itens tem um limite diário."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Glisează și organizează fără limită, cu reclame ocazionale. Eliminarea are o limită zilnică."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Листай и упорядочивай без ограничений, с рекламой время от времени. Для удаления действует дневной лимит."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ara sıra reklamlarla sınırsız kaydır ve düzenle. Kaldırma işlemi için günlük sınır vardır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гортай і впорядковуй без обмежень, із рекламою час від часу. Для видалення діє денний ліміт."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "滑动和整理不限次数，偶尔会显示广告。移除内容有每日上限。"
          }
        }
      }
    },
