    "vault_new_code_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فتحت الخزنة باستخدام مفتاح الاسترداد. اختر رمزًا جديدًا الآن."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি রিকভারি কী দিয়ে ভল্ট খুলেছেন। এখনই একটি নতুন কোড বেছে নিন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Has obert la caixa forta amb la clau de recuperació. Tria ara un codi nou."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevřeli jste trezor klíčem pro obnovení. Teď zvolte nový kód."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du åbnede boksen med gendannelsesnøglen. Vælg en ny kode nu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast den Tresor mit dem Notfallschlüssel geöffnet. Lege jetzt einen neuen Code fest."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άνοιξες το θησαυροφυλάκιο με το κλειδί ανάκτησης. Διάλεξε τώρα νέο κωδικό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You opened the vault with the recovery key. Choose a new code now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has abierto la caja fuerte con la clave de recuperación. Elige ahora un código nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avasit holvin palautusavaimella. Valitse nyt uusi koodi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as ouvert le coffre-fort avec la clé de secours. Choisis maintenant un nouveau code."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે પુનઃપ્રાપ્તિ ચાવીથી વૉલ્ટ ખોલ્યું છે. હવે નવો કોડ પસંદ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתחת את הכספת עם מפתח השחזור. עכשיו יש לבחור קוד חדש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने रिकवरी कुंजी से तिजोरी खोली है। अब नया कोड चुनें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorio si trezor ključem za oporavak. Sad odaberi novi kôd."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A széfet a helyreállítási kulccsal nyitottad meg. Most válassz új kódot."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu membuka brankas dengan kunci pemulihan. Pilih kode baru sekarang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai aperto la cassaforte con la chiave di recupero. Scegli ora un nuovo codice."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復旧キーで保管庫を開きました。新しいコードを設定してください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಮರುಪಡೆಯುವಿಕೆ ಕೀಲಿಯಿಂದ ವಾಲ್ಟ್ ತೆರೆದಿದ್ದೀರಿ. ಈಗ ಹೊಸ ಕೋಡ್ ಆಯ್ಕೆಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복구 키로 금고를 열었습니다. 이제 새 암호를 설정하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ റിക്കവറി കീ ഉപയോഗിച്ച് വോൾട്ട് തുറന്നു. ഇപ്പോൾ ഒരു പുതിയ കോഡ് തിരഞ്ഞെടുക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही पुनर्प्राप्ती किल्लीने व्हॉल्ट उघडला आहे. आता नवीन कोड निवडा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda membuka peti besi dengan kunci pemulihan. Pilih kod baharu sekarang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du åpnet safen med gjenopprettingsnøkkelen. Velg en ny kode nå."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt de kluis met de herstelsleutel geopend. Kies nu een nieuwe code."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣ ରିକଭରି କି ସହ ଭଲ୍ଟ ଖୋଲିଛନ୍ତି। ଏବେ ଏକ ନୂଆ କୋଡ୍ ବାଛନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਸੀਂ ਰਿਕਵਰੀ ਕੁੰਜੀ ਨਾਲ ਵੌਲਟ ਖੋਲ੍ਹਿਆ। ਹੁਣ ਨਵਾਂ ਕੋਡ ਚੁਣੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sejf otwarto kluczem odzyskiwania. Ustaw teraz nowy kod."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você abriu o cofre com a chave de recuperação. Escolha um novo código agora."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abriste o cofre com a chave de recuperação. Escolhe agora um novo código."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai deschis seiful cu cheia de recuperare. Alege acum un cod nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейф открыт с помощью ключа восстановления. Задай новый код."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorili ste trezor kľúčom na obnovenie. Teraz zvoľte nový kód."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sef si odprl z obnovitvenim ključem. Zdaj izberi novo kodo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du öppnade valvet med återställningsnyckeln. Välj en ny kod nu."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மீட்புச் சாவியுடன் லாக்கரைத் திறந்துள்ளீர்கள். இப்போது புதிய குறியீட்டைத் தேர்ந்தெடுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు రికవరీ కీతో వాల్ట్ తెరిచారు. ఇప్పుడు కొత్త కోడ్ ఎంచుకోండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณเปิดตู้เซฟด้วยกุญแจกู้คืน เลือกรหัสใหม่ตอนนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasayı kurtarma anahtarıyla açtın. Şimdi yeni bir kod belirle."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейф відкрито за допомогою ключа відновлення. Задай новий код."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ نے ریکوری کلید سے والٹ کھولا ہے۔ اب نیا کوڈ منتخب کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã mở két sắt bằng khóa khôi phục. Hãy chọn mã mới ngay bây giờ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已使用恢复密钥打开保险箱。请立即设置新密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你用復原金鑰打開了保險箱。請現在選擇新密碼。"
          }
        }
      }
    },
    "vault_new_code_title": {
      "extractionState": "manual",
