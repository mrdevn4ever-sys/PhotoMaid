    "archive_intro": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينسخ GaleriQ الصور والفيديوهات إلى مجلد تختاره – مثلًا على ذاكرة USB أو قرص خارجي أو في تطبيق الملفات. ثم تُقارن كل نسخة بالأصل بايتًا بايتًا. تبقى أصولك في تطبيق الصور، ولا يُحذف أي شيء."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ফটো ও ভিডিও আপনার বেছে নেওয়া ফোল্ডারে কপি করে – যেমন USB স্টিক, এক্সটার্নাল ড্রাইভ বা ফাইলস অ্যাপে। তারপর প্রতিটি কপি মূলটির সাথে বাইট-বাই-বাইট তুলনা করা হয়। আপনার মূল ফাইল ফটোতেই থাকে, এবং কিছুই মুছে ফেলা হয় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ copia fotos i vídeos a una carpeta que tries, per exemple en un llapis USB, un disc extern o a l’app Fitxers. Després, cada còpia es compara byte a byte amb l’original. Els originals es queden a Fotos i no s’esborra res."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ zkopíruje fotky a videa do složky, kterou vyberete – například na USB disk, externí disk nebo do aplikace Soubory. Každá kopie se pak porovná s originálem bajt po bajtu. Originály zůstávají ve Fotkách a nic se nemaže."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ kopierer fotos og videoer til en mappe, du vælger – f.eks. på en USB-nøgle, et eksternt drev eller i appen Arkiver. Hver kopi sammenlignes derefter byte for byte med originalen. Dine originaler bliver i Fotos, og intet slettes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ kopiert Fotos und Videos in einen Ordner deiner Wahl – zum Beispiel auf einen USB-Stick, eine externe Festplatte oder in die Dateien-App. Danach wird jede Kopie Byte für Byte mit dem Original verglichen. Deine Originale bleiben in Fotos, gelöscht wird nichts."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το GaleriQ αντιγράφει φωτογραφίες και βίντεο σε φάκελο της επιλογής σου – π.χ. σε στικάκι USB, εξωτερικό δίσκο ή στην εφαρμογή Αρχεία. Κάθε αντίγραφο συγκρίνεται έπειτα με το πρωτότυπο byte προς byte. Τα πρωτότυπα μένουν στις Φωτογραφίες και τίποτα δεν διαγράφεται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ copies photos and videos into a folder you choose – for example on a USB stick, an external drive or in the Files app. Each copy is then compared byte for byte with the original. Your originals stay in Photos, and nothing is deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ copia fotos y vídeos en una carpeta que elijas, por ejemplo en una memoria USB, un disco externo o en la app Archivos. Después compara cada copia byte a byte con el original. Tus originales se quedan en Fotos y no se borra nada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ kopioi kuvat ja videot valitsemaasi kansioon – esimerkiksi USB-tikulle, ulkoiselle levylle tai Tiedostot-appiin. Jokaista kopiota verrataan sen jälkeen alkuperäiseen tavu tavulta. Alkuperäiset pysyvät Kuvissa, eikä mitään poisteta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ copie des photos et vidéos dans un dossier de votre choix – par exemple sur une clé USB, un disque externe ou dans l’app Fichiers. Chaque copie est ensuite comparée octet par octet à l’original. Vos originaux restent dans Photos et rien n’est supprimé."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ફોટા અને વીડિયોને તમે પસંદ કરેલા ફોલ્ડરમાં કૉપિ કરે છે – દા.ત. USB સ્ટિક, બાહ્ય ડ્રાઇવ અથવા ફાઇલ્સ ઍપમાં. પછી દરેક નકલની મૂળ સાથે બાઇટ-દર-બાઇટ સરખામણી થાય છે. મૂળ ફોટોમાં જ રહે છે, અને કંઈ ડિલીટ થતું નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ מעתיקה תמונות וסרטונים לתיקייה שבחרת – למשל בדיסק און קי, בכונן חיצוני או ביישום ״קבצים״. אחר כך כל עותק מושווה למקור בייט אחר בייט. המקוריים נשארים ב״תמונות״, ושום דבר לא נמחק."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ फ़ोटो और वीडियो को आपके चुने फ़ोल्डर में कॉपी करता है – जैसे USB स्टिक, एक्सटर्नल ड्राइव या फ़ाइल्स ऐप में। फिर हर कॉपी की तुलना मूल से बाइट-दर-बाइट होती है। आपके मूल तस्वीरें में ही रहते हैं, और कुछ भी डिलीट नहीं होता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ kopira fotografije i videozapise u mapu koju odabereš – npr. na USB stick, vanjski disk ili u aplikaciju Datoteke. Svaka se kopija zatim uspoređuje s originalom bajt po bajt. Originali ostaju u Fotografijama i ništa se ne briše."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A GaleriQ a fotókat és videókat egy általad választott mappába másolja – például pendrive-ra, külső meghajtóra vagy a Fájlok appba. Ezután minden másolatot bájtról bájtra összevet az eredetivel. Az eredetik a Fotókban maradnak, és semmi sem törlődik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ menyalin foto dan video ke folder pilihanmu – misalnya di flashdisk USB, drive eksternal, atau app File. Setiap salinan lalu dibandingkan byte demi byte dengan aslinya. Aslinya tetap di Foto, dan tidak ada yang dihapus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ copia foto e video in una cartella a tua scelta, ad esempio su una chiavetta USB, un disco esterno o nell’app File. Poi confronta ogni copia byte per byte con l’originale. I tuoi originali restano in Foto e non viene eliminato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQは写真やビデオを、選んだフォルダ（USBメモリ、外付けドライブ、「ファイル」アプリなど）にコピーします。その後、各コピーを元のファイルと1バイトずつ照合します。元の写真は「写真」に残り、何も削除されません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ಫೋಟೋಗಳು ಮತ್ತು ವೀಡಿಯೊಗಳನ್ನು ನೀವು ಆಯ್ಕೆಮಾಡಿದ ಫೋಲ್ಡರ್‌ಗೆ ನಕಲಿಸುತ್ತದೆ – ಉದಾಹರಣೆಗೆ USB ಸ್ಟಿಕ್, ಬಾಹ್ಯ ಡ್ರೈವ್ ಅಥವಾ ಫೈಲ್‌ಗಳು ಆ್ಯಪ್‌ನಲ್ಲಿ. ನಂತರ ಪ್ರತಿ ಪ್ರತಿಯನ್ನು ಮೂಲದೊಂದಿಗೆ ಬೈಟ್-ಬೈಟ್ ಹೋಲಿಸಲಾಗುತ್ತದೆ. ನಿಮ್ಮ ಮೂಲಗಳು ಫೋಟೋಗಳಲ್ಲೇ ಉಳಿಯುತ್ತವೆ, ಮತ್ತು ಏನನ್ನೂ ಅಳಿಸಲಾಗುವುದಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ가 사진과 동영상을 선택한 폴더(예: USB 메모리, 외장 드라이브, 파일 앱)에 복사해요. 그런 다음 각 사본을 원본과 바이트 단위로 비교해요. 원본은 사진 앱에 그대로 있고 아무것도 삭제되지 않아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ഫോട്ടോകളും വീഡിയോകളും നിങ്ങൾ തിരഞ്ഞെടുക്കുന്ന ഫോൾഡറിലേക്ക് പകർത്തുന്നു – ഉദാഹരണത്തിന് USB സ്റ്റിക്ക്, എക്സ്റ്റേണൽ ഡ്രൈവ് അല്ലെങ്കിൽ ഫയൽസ് ആപ്പിൽ. തുടർന്ന് ഓരോ പകർപ്പും ഒറിജിനലുമായി ബൈറ്റ്-ബൈ-ബൈറ്റ് താരതമ്യം ചെയ്യുന്നു. നിങ്ങളുടെ ഒറിജിനലുകൾ ഫോട്ടോസിൽ തന്നെ തുടരും, ഒന്നും ഇല്ലാതാക്കില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ फोटो आणि व्हिडिओ तुम्ही निवडलेल्या फोल्डरमध्ये कॉपी करते – उदा. USB स्टिक, बाह्य ड्राइव्ह किंवा फाइल्स अ‍ॅपमध्ये. मग प्रत्येक प्रतीची मूळशी बाइट-दर-बाइट तुलना होते. तुमची मूळ फोटोमध्येच राहतात आणि काहीही डिलीट होत नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ menyalin foto dan video ke folder pilihan anda – contohnya pada pemacu USB, cakera luaran atau dalam app Fail. Setiap salinan kemudian dibandingkan bait demi bait dengan yang asal. Yang asal kekal dalam Foto dan tiada apa dipadam."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ kopierer bilder og videoer til en mappe du velger – for eksempel på en minnepinne, en ekstern disk eller i Filer-appen. Hver kopi sammenlignes deretter byte for byte med originalen. Originalene dine blir i Bilder, og ingenting slettes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ kopieert foto’s en video’s naar een map naar keuze – bijvoorbeeld op een usb-stick, een externe schijf of in de Bestanden-app. Daarna wordt elke kopie byte voor byte met het origineel vergeleken. Je originelen blijven in Foto’s en er wordt niets verwijderd."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ଫଟୋ ଓ ଭିଡିଓକୁ ଆପଣ ବାଛିଥିବା ଫୋଲ୍ଡରକୁ କପି କରେ – ଯେପରି USB ଷ୍ଟିକ୍, ବାହ୍ୟ ଡ୍ରାଇଭ୍ କିମ୍ବା ଫାଇଲ୍ସ ଆପ୍‌ରେ। ତାପରେ ପ୍ରତ୍ୟେକ କପିକୁ ମୂଳ ସହ ବାଇଟ୍-ବାଇ-ବାଇଟ୍ ତୁଳନା କରାଯାଏ। ଆପଣଙ୍କ ମୂଳ ଫାଇଲ୍ ଫଟୋରେ ହିଁ ରହେ, ଏବଂ କିଛି ଡିଲିଟ୍ ହୁଏ ନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ਫ਼ੋਟੋਆਂ ਅਤੇ ਵੀਡੀਓ ਤੁਹਾਡੇ ਚੁਣੇ ਫ਼ੋਲਡਰ ਵਿੱਚ ਕਾਪੀ ਕਰਦਾ ਹੈ – ਜਿਵੇਂ USB ਸਟਿੱਕ, ਬਾਹਰੀ ਡਰਾਈਵ ਜਾਂ ਫ਼ਾਈਲਾਂ ਐਪ ਵਿੱਚ। ਫਿਰ ਹਰ ਕਾਪੀ ਦੀ ਮੂਲ ਨਾਲ ਬਾਈਟ-ਦਰ-ਬਾਈਟ ਤੁਲਨਾ ਹੁੰਦੀ ਹੈ। ਮੂਲ ਫ਼ੋਟੋਆਂ ਵਿੱਚ ਹੀ ਰਹਿੰਦੇ ਹਨ, ਅਤੇ ਕੁਝ ਵੀ ਮਿਟਾਇਆ ਨਹੀਂ ਜਾਂਦਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ kopiuje zdjęcia i filmy do wybranego folderu – na przykład na pendrive, dysk zewnętrzny lub do aplikacji Pliki. Następnie każda kopia jest porównywana bajt po bajcie z oryginałem. Oryginały zostają w Zdjęciach i nic nie jest usuwane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O GaleriQ copia fotos e vídeos para uma pasta que você escolher – por exemplo, num pendrive, num disco externo ou no app Arquivos. Cada cópia é depois comparada byte a byte com o original. Seus originais ficam no Fotos e nada é apagado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O GaleriQ copia fotografias e vídeos para uma pasta à sua escolha – por exemplo, uma pen USB, um disco externo ou a app Ficheiros. Depois, cada cópia é comparada byte a byte com o original. Os originais ficam nas Fotografias e nada é apagado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ copiază fotografii și videoclipuri într-un dosar ales de tine – de exemplu pe un stick USB, un hard disk extern sau în aplicația Fișiere. Apoi fiecare copie este comparată octet cu octet cu originalul. Originalele rămân în Poze și nimic nu este șters."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ копирует фото и видео в выбранную вами папку – например, на USB-флешку, внешний диск или в приложение «Файлы». Затем каждая копия побайтно сверяется с оригиналом. Оригиналы остаются в «Фото», ничего не удаляется."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ skopíruje fotky a videá do priečinka, ktorý vyberiete – napríklad na USB kľúč, externý disk alebo do aplikácie Súbory. Každá kópia sa potom porovná s originálom bajt po bajte. Originály zostávajú vo Fotkách a nič sa nemaže."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ kopira fotografije in videoposnetke v mapo, ki jo izbereš – na primer na ključek USB, zunanji disk ali v aplikacijo Datoteke. Vsaka kopija se nato primerja z izvirnikom bajt za bajtom. Izvirniki ostanejo v Fotografijah in nič se ne izbriše."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ kopierar bilder och videor till en mapp du väljer – till exempel på ett USB-minne, en extern disk eller i appen Filer. Varje kopia jämförs sedan byte för byte med originalet. Dina original stannar i Bilder och inget raderas."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ புகைப்படங்களையும் வீடியோக்களையும் நீங்கள் தேர்ந்தெடுக்கும் கோப்புறைக்கு நகலெடுக்கிறது – எ.கா. USB ஸ்டிக், வெளிப்புற டிரைவ் அல்லது Files ஆப்பில். பின்னர் ஒவ்வொரு நகலும் அசலுடன் பைட்-பைட்டாக ஒப்பிடப்படுகிறது. உங்கள் அசல்கள் Photos-இலேயே இருக்கும், எதுவும் நீக்கப்படாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ఫోటోలు, వీడియోలను మీరు ఎంచుకున్న ఫోల్డర్‌కి కాపీ చేస్తుంది – ఉదాహరణకు USB స్టిక్, ఎక్స్‌టర్నల్ డ్రైవ్ లేదా Files యాప్‌లో. ఆ తర్వాత ప్రతి కాపీని ఒరిజినల్‌తో బైట్-బై-బైట్ పోలుస్తుంది. మీ ఒరిజినల్‌లు Photosలోనే ఉంటాయి, ఏదీ తొలగించబడదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ คัดลอกรูปภาพและวิดีโอไปยังโฟลเดอร์ที่คุณเลือก – เช่น แฟลชไดรฟ์ USB ฮาร์ดดิสก์ภายนอก หรือในแอพไฟล์ จากนั้นแต่ละสำเนาจะถูกเปรียบเทียบกับต้นฉบับทีละไบต์ ต้นฉบับของคุณยังอยู่ในรูปภาพ และไม่มีอะไรถูกลบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ fotoğraf ve videoları seçtiğin bir klasöre kopyalar; örneğin bir USB belleğe, harici diske veya Dosyalar uygulamasına. Ardından her kopya orijinalle bayt bayt karşılaştırılır. Orijinallerin Fotoğraflar’da kalır, hiçbir şey silinmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ копіює фото й відео до вибраної вами папки – наприклад, на USB-флешку, зовнішній диск або в програму «Файли». Потім кожну копію побайтово звіряють з оригіналом. Оригінали залишаються у «Фото», нічого не видаляється."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ تصاویر اور ویڈیوز کو آپ کے منتخب فولڈر میں کاپی کرتا ہے – مثلاً USB اسٹک، بیرونی ڈرائیو یا فائلز ایپ میں۔ پھر ہر کاپی کا اصل سے بائٹ بہ بائٹ موازنہ ہوتا ہے۔ اصل تصاویر ایپ میں رہتے ہیں اور کچھ بھی حذف نہیں ہوتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ sao chép ảnh và video vào thư mục bạn chọn – ví dụ trên USB, ổ cứng ngoài hoặc trong ứng dụng Tệp. Sau đó mỗi bản sao được so sánh từng byte với bản gốc. Bản gốc của bạn vẫn ở trong Ảnh và không có gì bị xóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ 会将照片和视频复制到你选择的文件夹，例如 U 盘、外置硬盘或“文件”App。随后逐字节将每份副本与原件比对。原件仍保留在“照片”中，不会删除任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ 會把照片和影片複製到你選擇的檔案夾 – 例如 USB 隨身碟、外接硬碟或「檔案」App 中。每份副本都會與原始檔逐位元組比對。你的原始檔仍留在「照片」中，不會刪除任何內容。"
          }
        }
      }
    },
