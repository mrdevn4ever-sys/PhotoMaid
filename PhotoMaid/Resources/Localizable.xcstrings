    "notif_due_body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حان اليوم وقت مراجعة شيء في «لاحقًا»."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "“পরে”-তে কিছু আজ পর্যালোচনার জন্য প্রস্তুত।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi ha alguna cosa a «Més tard» llesta per revisar avui."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Něco v „Později“ je dnes připraveno k procházení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Noget i “Senere” er klar til gennemgang i dag."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heute ist etwas aus „Später“ wieder dran."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάτι στο «Αργότερα» είναι έτοιμο για έλεγχο σήμερα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something in “Later” is ready to review today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy toca revisar algo de «Después»."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokin kohteessa ”Myöhemmin” on tänään valmiina läpikäyntiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un élément de « Plus tard » est à revoir aujourd’hui."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "“પછી” માંનું કંઈક આજે જોવા માટે તૈયાર છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משהו ב„מאוחר יותר” מוכן לסקירה היום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“बाद में” में कुछ आज देखने के लिए तैयार है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nešto u „Kasnije” danas je spremno za pregled."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A „Később” egyik eleme ma átnézésre kész."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ada sesuatu di “Nanti” yang siap ditinjau hari ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oggi è il momento di rivedere qualcosa in «Più tardi»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「あとで」にあるものを、今日はもう一度確認しましょう。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "“ನಂತರ” ದಲ್ಲಿರುವ ಏನೋ ಇಂದು ಪರಿಶೀಲನೆಗೆ ಸಿದ್ಧವಾಗಿದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 ‘나중에’에 있는 항목을 다시 볼 차례예요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "“പിന്നീട്” എന്നതിലെ ചിലത് ഇന്ന് പരിശോധനയ്ക്ക് തയ്യാറാണ്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "“नंतर” मधील काहीतरी आज पाहण्यासाठी तयार आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesuatu dalam “Nanti” sedia untuk disemak hari ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Noe i «Senere» er klart til gjennomgang i dag."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is vandaag iets uit ‘Later’ weer aan de beurt."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "“ପରେ”ରେ କିଛି ଆଜି ସମୀକ୍ଷା ପାଇଁ ପ୍ରସ୍ତୁତ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "“ਬਾਅਦ ਵਿੱਚ” ਵਿੱਚ ਕੁਝ ਅੱਜ ਸਮੀਖਿਆ ਲਈ ਤਿਆਰ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dziś czas wrócić do czegoś z „Później”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo em “Depois” está pronto para revisar hoje."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoje é altura de rever algo de «Mais tarde»."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Azi este timpul să revezi ceva din „Mai târziu”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сегодня пора посмотреть что-то из «Позже»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Niečo v „Neskôr“ je dnes pripravené na prezretie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nekaj v »Pozneje« je danes pripravljeno za pregled."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Något i ”Senare” är redo att gå igenom i dag."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "“பிறகு”-இல் உள்ள ஒன்று இன்று பார்வையிடத் தயாராக உள்ளது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "“తర్వాత”లోని ఏదో ఈరోజు సమీక్షకు సిద్ధంగా ఉంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีรายการใน “ไว้ทีหลัง” ที่พร้อมตรวจดูวันนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün “Sonra” bölümündeki bir şeyi inceleme zamanı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сьогодні час переглянути щось із «Пізніше»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "”بعد میں“ میں کچھ آج جائزے کے لیے تیار ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có mục trong “Để sau” sẵn sàng xem lại hôm nay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天可以再次查看“稍后”中的内容了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「稍後」中有項目今天可以整理。"
          }
        }
      }
    },
