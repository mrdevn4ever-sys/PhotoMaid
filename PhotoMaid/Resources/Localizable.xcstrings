    "blocks_safe_selection": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُستخدم الصور المسموح بها فقط. تُستبدل الصور غير المتاحة بخلفية محايدة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু অনুমোদিত ফটো ব্যবহার হয়। অনুপলব্ধ ছবির জায়গায় একটি নিরপেক্ষ পটভূমি বসে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Només es fan servir fotos permeses. Les imatges no disponibles se substitueixen per un fons neutre."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Používají se jen povolené fotky. Nedostupné obrázky se nahradí neutrálním pozadím."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun tilladte fotos bruges. Utilgængelige billeder erstattes af en neutral baggrund."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur erlaubte Fotos werden übernommen. Nicht verfügbare Bilder werden durch einen neutralen Hintergrund ersetzt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρησιμοποιούνται μόνο επιτρεπόμενες φωτογραφίες. Οι μη διαθέσιμες εικόνες αντικαθίστανται από ουδέτερο φόντο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only allowed photos are used. Unavailable images are replaced with a neutral background."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se usan fotos permitidas. Las no disponibles se sustituyen por un fondo neutro."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain sallittuja kuvia käytetään. Puuttuvat kuvat korvataan neutraalilla taustalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les photos autorisées sont utilisées. Les images indisponibles sont remplacées par un fond neutre."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફક્ત મંજૂર ફોટા વપરાય છે. ઉપલબ્ધ ન હોય તેવી છબીઓની જગ્યાએ સાદી પૃષ્ઠભૂમિ આવે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נעשה שימוש רק בתמונות מותרות. תמונות לא זמינות מוחלפות ברקע ניטרלי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिर्फ़ अनुमत फ़ोटो इस्तेमाल होती हैं। उपलब्ध न होने वाली तस्वीरों की जगह सादा बैकग्राउंड आता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koriste se samo dopuštene fotografije. Nedostupne slike zamjenjuju se neutralnom pozadinom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak engedélyezett fotók használhatók. Az elérhetetlen képeket semleges háttér váltja fel."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya foto yang diizinkan yang dipakai. Gambar yang tidak tersedia diganti dengan latar netral."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si usano solo foto consentite. Le immagini non disponibili sono sostituite da uno sfondo neutro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可された写真のみ使用します。利用できない写真は無地の背景に置き換わります。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅನುಮತಿಸಿದ ಫೋಟೋಗಳನ್ನು ಮಾತ್ರ ಬಳಸಲಾಗುತ್ತದೆ. ಲಭ್ಯವಿಲ್ಲದ ಚಿತ್ರಗಳ ಬದಲು ತಟಸ್ಥ ಹಿನ್ನೆಲೆ ಬರುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허용된 사진만 사용합니다. 사용할 수 없는 이미지는 기본 배경으로 대체됩니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അനുവദിച്ച ഫോട്ടോകൾ മാത്രമേ ഉപയോഗിക്കൂ. ലഭ്യമല്ലാത്ത ചിത്രങ്ങൾക്ക് പകരം ഒരു നിഷ്പക്ഷ പശ്ചാത്തലം വരും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फक्त परवानगी असलेले फोटो वापरले जातात. उपलब्ध नसलेल्या प्रतिमांच्या जागी साधी पार्श्वभूमी येते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya foto yang dibenarkan digunakan. Imej yang tidak tersedia diganti dengan latar belakang neutral."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare tillatte bilder brukes. Utilgjengelige bilder erstattes av en nøytral bakgrunn."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen toegestane foto’s worden gebruikt. Niet-beschikbare beelden krijgen een neutrale achtergrond."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "କେବଳ ଅନୁମୋଦିତ ଫଟୋ ବ୍ୟବହାର ହୁଏ। ଉପଲବ୍ଧ ନଥିବା ଛବି ବଦଳରେ ଏକ ନିରପେକ୍ଷ ପୃଷ୍ଠଭୂମି ଆସେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਿਰਫ਼ ਮਨਜ਼ੂਰ ਫ਼ੋਟੋਆਂ ਵਰਤੀਆਂ ਜਾਂਦੀਆਂ ਹਨ। ਉਪਲਬਧ ਨਾ ਹੋਣ ਵਾਲੀਆਂ ਤਸਵੀਰਾਂ ਦੀ ਥਾਂ ਸਾਦਾ ਬੈਕਗ੍ਰਾਊਂਡ ਆਉਂਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Używane są tylko dozwolone zdjęcia. Niedostępne obrazy zastępuje neutralne tło."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só fotos permitidas são usadas. Imagens indisponíveis são substituídas por um fundo neutro."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Só são usadas fotografias permitidas. As indisponíveis são substituídas por um fundo neutro."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se folosesc doar fotografii permise. Imaginile indisponibile sunt înlocuite cu fundal neutru."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используются только разрешённые фото. Недоступные заменяются нейтральным фоном."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Používajú sa len povolené fotky. Nedostupné obrázky sa nahradia neutrálnym pozadím."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uporabljajo se le dovoljene fotografije. Nedostopne slike nadomesti nevtralno ozadje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara tillåtna bilder används. Bilder som inte är tillgängliga ersätts med en neutral bakgrund."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அனுமதித்த புகைப்படங்கள் மட்டுமே பயன்படுத்தப்படும். கிடைக்காத படங்களுக்குப் பதிலாக நடுநிலைப் பின்னணி வரும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అనుమతించిన ఫోటోలు మాత్రమే వాడబడతాయి. అందుబాటులో లేని చిత్రాల స్థానంలో తటస్థ నేపథ్యం వస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้เฉพาะรูปภาพที่อนุญาต รูปที่ไม่พร้อมใช้งานจะถูกแทนด้วยพื้นหลังสีกลาง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca izin verilen fotoğraflar kullanılır. Erişilemeyenlerin yerine nötr arka plan gösterilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовуються лише дозволені фото. Недоступні замінюються нейтральним тлом."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف اجازت یافتہ تصاویر استعمال ہوتی ہیں۔ دستیاب نہ ہونے والی تصویروں کی جگہ سادہ پس منظر آتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ dùng ảnh được phép. Ảnh không có sẵn được thay bằng nền trung tính."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅使用已获授权的照片。不可用的图片将以中性背景替代。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只會使用允許的照片。無法取得的圖片會以中性背景取代。"
          }
        }
      }
    },
