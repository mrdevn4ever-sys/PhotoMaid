    "backup_too_new": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه النسخة الاحتياطية من إصدار أحدث من PhotoMaid. حدّث PhotoMaid أولًا."
