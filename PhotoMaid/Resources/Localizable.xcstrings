    "fav_failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تغيير حالة المفضلة. بقيت كما كانت."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
