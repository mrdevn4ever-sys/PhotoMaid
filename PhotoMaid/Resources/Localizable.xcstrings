    "tools_fmt_png_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بلا فقدان في الجودة، لكن الملفات أكبر بكثير"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Qualitätsverlust, aber deutlich größere Dateien"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No quality loss, but much bigger files"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin pérdida de calidad, pero archivos mucho más grandes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans perte de qualité, mais fichiers bien plus lourds"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna perdita di qualità, ma file molto più grandi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画質は落ちませんが、ファイルがかなり大きくなります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화질 손실은 없지만 파일이 훨씬 커져요"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen kwaliteitsverlies, maar veel grotere bestanden"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez utraty jakości, ale znacznie większe pliki"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem perda de qualidade, mas ficheiros muito maiores"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fără pierderi de calitate, dar fișiere mult mai mari"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без потери качества, но файлы гораздо больше"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalite kaybı yok, ancak dosyalar çok daha büyük"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Без втрати якості, але файли значно більші"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无画质损失，但文件大得多"
          }
        }
      }
    },
    "tools_free_limit": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المجاني: حتى %1$lld ملفات في كل مرة – ستُعالَج أول %1$lld فقط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Free: bis %1$lld Dateien je Durchgang – nur die ersten %1$lld werden bearbeitet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free: up to %1$lld files per run – only the first %1$lld will be processed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Free: hasta %1$lld archivos por vez; solo se procesarán los %1$lld primeros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Free : jusqu’à %1$lld fichiers par passage – seuls les %1$lld premiers seront traités."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Free: fino a %1$lld file per volta – verranno elaborati solo i primi %1$lld."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Free：1回につき%1$lldファイルまで。最初の%1$lld件だけ処理されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Free: 한 번에 %1$lld개까지 – 처음 %1$lld개만 처리됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Free: tot %1$lld bestanden per keer – alleen de eerste %1$lld worden verwerkt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Free: do %1$lld plików naraz – zostanie przetworzonych tylko pierwszych %1$lld."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Free: até %1$lld ficheiros de cada vez – só os primeiros %1$lld serão processados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Free: până la %1$lld fișiere pe rulare – se procesează doar primele %1$lld."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Free: до %1$lld файлов за раз – будут обработаны только первые %1$lld."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Free: tek seferde en çok %1$lld dosya – yalnızca ilk %1$lld dosya işlenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Free: до %1$lld файлів за раз – буде оброблено лише перші %1$lld."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Free：每次最多 %1$lld 个文件，只处理前 %1$lld 个。"
          }
        }
      }
    },
    "tools_freed_later": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في سلة مهملات Android، ولم تتحرر بعد: عندما يفرغها Android ستشغل الملفات مساحة أقل بمقدار %1$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Android-Papierkorb, noch nicht frei: Sobald Android ihn leert, belegen die Dateien %1$@ weniger."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the Android trash, not freed yet: once Android empties it, these files take up %1$@ less."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la papelera de Android, aún no liberado: cuando Android la vacíe, los archivos ocuparán %1$@ menos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans la corbeille Android, pas encore libéré : quand Android la videra, les fichiers occuperont %1$@ de moins."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nel cestino di Android, non ancora liberato: quando Android lo svuota, i file occuperanno %1$@ in meno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Androidのゴミ箱にあり、まだ空いていません。Androidがゴミ箱を空にすると、ファイルの使用量が%1$@減ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 휴지통에 있으며 아직 확보되지 않았어요. Android가 휴지통을 비우면 파일이 %1$@ 덜 차지해요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In de Android-prullenbak, nog niet vrij: zodra Android die leegt, nemen de bestanden %1$@ minder in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W koszu Androida, jeszcze nie zwolnione: gdy Android opróżni kosz, pliki zajmą o %1$@ mniej."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "No lixo do Android, ainda não libertado: quando o Android o esvaziar, os ficheiros ocupam menos %1$@."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În coșul Android, încă neeliberat: când Android îl golește, fișierele vor ocupa cu %1$@ mai puțin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В корзине Android, ещё не освобождено: когда Android очистит её, файлы займут на %1$@ меньше."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android çöp kutusunda, henüz boşalmadı: Android çöp kutusunu boşalttığında dosyalar %1$@ daha az yer kaplar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У кошику Android, ще не звільнено: коли Android його очистить, файли займатимуть на %1$@ менше."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Android 回收站中，尚未释放：Android 清空回收站后，这些文件将少占用 %1$@。"
          }
        }
      }
    },
