    "tour_editor_save_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احفظ كنسخة – يبقى الأصل دون تغيير. إن أردت، ينتقل الأصل إلى «المحذوفة مؤخرًا»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als Kopie speichern – das Original bleibt unverändert. Auf Wunsch kommt das Original in „Zuletzt gelöscht“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save as a copy – the original stays unchanged. If you choose, the original goes to “Recently Deleted”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda como copia: el original no cambia. Si quieres, el original pasa a «Eliminado»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez une copie – l’original reste inchangé. Si vous le souhaitez, l’original va dans « Suppressions récentes »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva come copia: l’originale resta invariato. Se vuoi, l’originale finisce in «Eliminati di recente»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピーとして保存 – オリジナルはそのままです。選べばオリジナルは「最近削除した項目」に移動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사본으로 저장 – 원본은 그대로입니다. 원하면 원본이 '최근 삭제된 항목'으로 이동합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaar als kopie – het origineel blijft ongewijzigd. Als je wilt, gaat het origineel naar ‘Recent verwijderd’."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz jako kopię – oryginał pozostaje bez zmian. Na życzenie oryginał trafi do „Ostatnio usunięte”."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarde como cópia – o original fica inalterado. Se quiser, o original passa para «Apagados recentemente»."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvează ca copie – originalul rămâne neschimbat. Dacă vrei, originalul ajunge în „Șterse recent”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраните копию – оригинал не изменится. По желанию оригинал попадёт в «Недавно удаленные»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopya olarak kaydet – orijinal değişmez. İstersen orijinal \"Son Silinenler\"e taşınır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збережіть копію – оригінал не зміниться. За бажанням оригінал потрапить до «Нещодавно видалених»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存储为副本 – 原件保持不变。如果你愿意，原件会移到“最近删除”中。"
          }
        }
      }
    },
    "tour_editor_save_title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقرر عند الحفظ"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Speichern entscheidest du"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You decide when saving"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Decides al guardar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu décides à l’enregistrement"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Decidi al salvataggio"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存時に選べます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장할 때 선택해요"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij opslaan beslis jij"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Decydujesz przy zapisie"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Decides ao guardar"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Decizi la salvare"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбор при сохранении"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydederken sen karar verirsin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибір під час збереження"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存时由你决定"
          }
        }
      }
    },
    "tour_editor_tools_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "القص والضبط والفلاتر والحجم. لا يُكتب شيء حتى تضغط على حفظ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuschneiden, Anpassen, Filter und Größe. Geschrieben wird erst, wenn du auf Speichern tippst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Crop, adjust, filters and size. Nothing is written until you tap Save."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recortar, ajustar, filtros y tamaño. No se escribe nada hasta que tocas Guardar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recadrage, réglages, filtres et taille. Rien n’est écrit avant que tu touches Enregistrer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ritaglio, regolazioni, filtri e dimensioni. Nulla viene scritto finché non tocchi Salva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "切り抜き、調整、フィルタ、サイズ。保存をタップするまで何も書き込まれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자르기, 조정, 필터, 크기. 저장을 누르기 전에는 아무것도 바뀌지 않아요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bijsnijden, aanpassen, filters en formaat. Er wordt pas iets geschreven als je op Opslaan tikt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kadrowanie, ustawienia, filtry i rozmiar. Nic nie jest zapisywane, dopóki nie dotkniesz Zapisz."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Recortar, ajustar, filtros e tamanho. Nada é escrito até tocares em Guardar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Decupare, ajustări, filtre și mărime. Nimic nu se scrie până nu atingi Salvează."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обрезка, настройки, фильтры и размер. Ничего не записывается, пока не нажмёшь «Сохранить»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kırpma, ayarlar, filtreler ve boyut. Kaydet'e dokunana kadar hiçbir şey yazılmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обрізання, налаштування, фільтри й розмір. Нічого не записується, доки не торкнешся «Зберегти»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "裁剪、调整、滤镜和尺寸。在你点按“保存”之前不会写入任何内容。"
          }
        }
      }
    },
    "tour_editor_tools_title": {
