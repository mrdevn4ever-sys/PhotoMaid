    "org_basket_clear_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُفرَغ السلة فقط. تبقى الصور ومقاطع الفيديو دون تغيير."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun kurven tømmes. Fotos og videoer forbliver uændrede."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur die Zusammenstellung wird geleert. Die Fotos und Videos bleiben unverändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the basket is emptied. The photos and videos stay unchanged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se vacía la cesta. Las fotos y los vídeos no cambian."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul le panier est vidé. Les photos et vidéos restent inchangées."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya keranjang yang dikosongkan. Foto dan video tidak berubah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si svuota solo il cestino. Foto e video restano invariati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空になるのはかごだけです。写真と動画は変わりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바구니만 비워져요. 사진과 동영상은 그대로예요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare kurven tømmes. Bildene og videoene forblir uendret."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen de mand wordt geleegd. De foto’s en video’s blijven ongewijzigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opróżniany jest tylko koszyk. Zdjęcia i filmy pozostają bez zmian."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só a cesta é esvaziada. As fotos e vídeos não são alterados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Só o cesto é esvaziado. As fotos e os vídeos ficam inalterados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se golește doar coșul. Fotografiile și videoclipurile rămân neschimbate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очищается только корзина. Фото и видео не изменятся."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara korgen töms. Bilderna och videorna förblir oförändrade."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ล้างเฉพาะตะกร้า รูปภาพและวิดีโอไม่เปลี่ยนแปลง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca sepet boşaltılır. Fotoğraflar ve videolar değişmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Очищається лише кошик. Фото й відео не зміняться."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ giỏ được làm trống. Ảnh và video không thay đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只清空选择篮。照片和视频保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只會清空選擇籃。照片和影片保持不變。"
          }
        }
      }
    },
