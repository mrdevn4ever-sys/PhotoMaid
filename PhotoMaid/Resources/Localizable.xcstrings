    "edit_stage_gestures": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عدّل بإصبع واحد، واستخدم إصبعين للتكبير والتحريك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এক আঙুলে সম্পাদনা করুন; জুম ও সরাতে দুই আঙুল ব্যবহার করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Edita amb un dit; amb dos dits fas zoom i desplaces."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Upravujte jedním prstem; dvěma prsty přibližujete a posouváte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Rediger med én finger; brug to fingre til at zoome og panorere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit einem Finger bearbeiten, mit zwei Fingern zoomen und verschieben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επεξεργασία με ένα δάχτυλο· με δύο κάνεις ζουμ και μετακίνηση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit with one finger; use two fingers to zoom and pan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Edita con un dedo; usa dos dedos para ampliar y desplazar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muokkaa yhdellä sormella; kahdella zoomaat ja siirrät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifiez avec un doigt ; utilisez deux doigts pour zoomer et déplacer."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "એક આંગળીથી ફેરફાર કરો; બે આંગળીથી ઝૂમ કરો અને ખસેડો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עריכה באצבע אחת; בשתי אצבעות מגדילים ומזיזים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक उँगली से एडिट करें; दो उँगलियों से ज़ूम और खिसकाएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uređuj jednim prstom; dvama prstima zumiraj i pomiči."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy ujjal szerkesztesz; két ujjal nagyítasz és mozgatsz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit dengan satu jari; pakai dua jari untuk zoom dan menggeser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifica con un dito; usa due dita per ingrandire e spostare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1本指で編集し、2本指でズームと移動ができます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಒಂದು ಬೆರಳಿನಿಂದ ಎಡಿಟ್ ಮಾಡಿ; ಜೂಮ್ ಮತ್ತು ಸರಿಸಲು ಎರಡು ಬೆರಳು ಬಳಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 손가락으로 편집하고, 두 손가락으로 확대하거나 이동하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരു വിരൽ കൊണ്ട് എഡിറ്റ് ചെയ്യുക; സൂം ചെയ്യാനും നീക്കാനും രണ്ട് വിരലുകൾ ഉപയോഗിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "एका बोटाने संपादित करा; दोन बोटांनी झूम करा आणि सरकवा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit dengan satu jari; gunakan dua jari untuk zum dan anjak."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rediger med én finger; bruk to fingre for å zoome og panorere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewerk met één vinger; zoom en verplaats met twee vingers."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଗୋଟିଏ ଆଙ୍ଗୁଠିରେ ଏଡିଟ୍ କରନ୍ତୁ; ଜୁମ୍ ଓ ଘୁଞ୍ଚାଇବାକୁ ଦୁଇ ଆଙ୍ଗୁଠି ବ୍ୟବହାର କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇੱਕ ਉਂਗਲ ਨਾਲ ਸੋਧੋ; ਜ਼ੂਮ ਕਰਨ ਅਤੇ ਖਿਸਕਾਉਣ ਲਈ ਦੋ ਉਂਗਲਾਂ ਵਰਤੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Edytuj jednym palcem, a dwoma powiększaj i przesuwaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Edite com um dedo; use dois dedos para ampliar e mover."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Edite com um dedo; use dois dedos para ampliar e deslocar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Editează cu un deget; folosește două degete pentru zoom și deplasare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Редактируйте одним пальцем, увеличивайте и перемещайте двумя."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Upravujte jedným prstom; dvoma prstami približujete a posúvate."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Urejaj z enim prstom; z dvema prstoma povečuješ in premikaš."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Redigera med ett finger; använd två fingrar för att zooma och panorera."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு விரலால் திருத்துங்கள்; பெரிதாக்கவும் நகர்த்தவும் இரண்டு விரல்களைப் பயன்படுத்துங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఒక వేలితో ఎడిట్ చేయండి; జూమ్ చేయడానికి, కదపడానికి రెండు వేళ్లు వాడండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แก้ไขด้วยนิ้วเดียว ใช้สองนิ้วเพื่อซูมและเลื่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek parmakla düzenleyin; iki parmakla yakınlaştırın ve kaydırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Редагуйте одним пальцем, масштабуйте й переміщуйте двома."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک انگلی سے ترمیم کریں؛ دو انگلیوں سے زوم اور سرکائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sửa bằng một ngón; dùng hai ngón để thu phóng và di chuyển."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单指编辑，双指缩放和移动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用一指編輯；用兩指縮放和平移。"
          }
        }
      }
    },
