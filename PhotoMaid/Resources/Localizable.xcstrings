    "edit_err_too_large": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه الصورة كبيرة جدًا لتعديلها بالكامل على هذا الجهاز. جرّب قصًا أصغر أو حجمًا أقل."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "This photo is too large for this device to edit in full. Try a smaller crop or reduce the size."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Foto ist für dieses Gerät zu groß, um es vollständig zu bearbeiten. Versuche einen kleineren Ausschnitt oder eine geringere Größe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This photo is too large for this device to edit in full. Try a smaller crop or reduce the size."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta foto es demasiado grande para editarla completa en este dispositivo. Prueba un recorte o un tamaño menor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette photo est trop grande pour être modifiée entièrement sur cet appareil. Essaie un recadrage plus petit ou une taille réduite."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "This photo is too large for this device to edit in full. Try a smaller crop or reduce the size."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa foto è troppo grande per essere modificata per intero su questo dispositivo. Prova un ritaglio più piccolo o dimensioni ridotte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この写真は大きすぎて、この端末では全体を編集できません。切り抜きを小さくするか、サイズを縮小してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사진은 너무 커서 이 기기에서 전체를 편집할 수 없어요. 더 작게 자르거나 크기를 줄여 보세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "This photo is too large for this device to edit in full. Try a smaller crop or reduce the size."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze foto is te groot om volledig op dit apparaat te bewerken. Probeer een kleinere uitsnede of een kleiner formaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To zdjęcie jest zbyt duże, by edytować je w całości na tym urządzeniu. Spróbuj mniejszego kadru lub rozmiaru."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "This photo is too large for this device to edit in full. Try a smaller crop or reduce the size."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta foto é demasiado grande para ser editada por inteiro neste dispositivo. Experimenta um recorte ou tamanho menor."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografia este prea mare pentru a fi editată integral pe acest dispozitiv. Încearcă un decupaj sau o mărime mai mică."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото слишком большое, чтобы целиком изменить его на этом устройстве. Попробуй обрезать сильнее или уменьшить размер."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "This photo is too large for this device to edit in full. Try a smaller crop or reduce the size."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "This photo is too large for this device to edit in full. Try a smaller crop or reduce the size."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu fotoğraf bu cihazda tamamen düzenlenemeyecek kadar büyük. Daha küçük bir kırpma veya boyut dene."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото завелике, щоб повністю змінити його на цьому пристрої. Спробуй обрізати сильніше або зменшити розмір."
