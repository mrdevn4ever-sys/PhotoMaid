    "export_busy": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هناك تصدير آخر قيد التشغيل. انتظر حتى ينتهي."
          }
        },
        "de": {
