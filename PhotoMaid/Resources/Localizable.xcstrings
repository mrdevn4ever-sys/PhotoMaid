    "offer_ads_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بطاقات إعلانية قابلة للتخطي بين العناصر، ولا تغطي فيديوهاتك أبدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überspringbare Werbekarten zwischen den Inhalten, nicht über deinen Videos."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skippable ad cards between items, never over your videos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarjetas publicitarias que puedes saltar entre contenidos, nunca encima de tus vídeos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des cartes publicitaires que tu peux passer, entre les éléments et jamais sur tes vidéos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Schede pubblicitarie saltabili tra i contenuti, mai sopra i tuoi video."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真や動画の間に、スキップできる広告カードを表示します。動画に重ねて表示することはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목 사이에 건너뛸 수 있는 광고 카드가 표시돼요. 동영상 위를 가리지 않아요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Advertentiekaarten die je kunt overslaan, tussen de items en nooit over je video’s heen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Karty reklamowe, które można pominąć, między treściami, nigdy na filmach."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cartões publicitários que podes saltar entre os conteúdos, nunca por cima dos teus vídeos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Carduri publicitare pe care le poți omite, între elemente, niciodată peste videoclipuri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рекламные карточки можно пропускать. Они появляются между элементами, а не поверх видео."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçeriklerin arasında atlanabilir reklam kartları; videolarının üzerinde asla görünmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рекламні картки можна пропускати. Вони з’являються між елементами, не поверх відео."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内容之间会出现可跳过的广告卡片，不会覆盖你的视频。"
          }
        }
      }
    },
    "offer_ads_title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعلان من حين لآخر"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ab und zu eine Anzeige"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An occasional ad"
          }
