    "vault2_recording_explanation": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يبدأ التسجيل إلا عند الضغط. يُحفظ مشفّرًا ويتوقف عند قفل الخزنة أو مغادرتها."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Optagelsen starter først, når du trykker. Den gemmes krypteret og stopper, når du låser eller forlader boksen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufnahme beginnt erst nach deinem Tippen. Sie wird verschlüsselt gespeichert und beim Sperren oder Verlassen beendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording starts only when you tap. It is stored encrypted and stops when you lock or leave the vault."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabación empieza solo al tocar. Se guarda cifrada y se detiene al bloquear o salir de la caja fuerte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’enregistrement commence uniquement à votre demande. Il est stocké chiffré et s’arrête au verrouillage ou à la sortie du coffre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perekaman baru dimulai saat kamu mengetuk. Rekaman disimpan terenkripsi dan berhenti saat kamu mengunci atau keluar dari brankas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La registrazione inizia solo al tuo tocco. È salvata crittografata e si ferma quando blocchi o lasci la cassaforte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップしたときだけ録音を開始します。暗号化して保存し、ロックまたは保管庫を閉じると停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭해야 녹음이 시작됩니다. 암호화하여 저장되며 보관함을 잠그거나 나가면 중지됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opptaket starter først når du trykker. Det lagres kryptert og stopper når du låser eller forlater safen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opname begint pas na je tik. Ze wordt versleuteld opgeslagen en stopt bij vergrendelen of verlaten van de kluis."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagrywanie zaczyna się dopiero po stuknięciu. Jest zapisywane w postaci zaszyfrowanej i kończy się przy blokadzie lub opuszczeniu sejfu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravação só começa quando você toca. Ela é guardada criptografada e para quando você bloqueia ou sai do cofre."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravação só começa ao tocares. É guardada cifrada e para ao bloqueares ou saíres do cofre."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înregistrarea începe doar la atingere. Este stocată criptat și se oprește când blochezi sau părăsești seiful."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись начинается только по нажатию. Она хранится зашифрованной и останавливается при блокировке или выходе из сейфа."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspelningen startar först när du trycker. Den lagras krypterad och stoppas när du låser eller lämnar valvet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การบันทึกจะเริ่มเมื่อคุณแตะเท่านั้น จะถูกเก็บแบบเข้ารหัสและหยุดเมื่อคุณล็อกหรือออกจากตู้เซฟ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt yalnızca dokunduğunda başlar. Şifreli saklanır ve kasa kilitlendiğinde veya kasadan çıkıldığında durur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запис починається лише після натискання. Він зберігається зашифрованим і зупиняється під час блокування або виходу зі сховища."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ bắt đầu ghi khi bạn chạm. Bản ghi được lưu mã hóa và dừng khi bạn khóa hoặc rời két sắt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在你点击后开始录音。录音加密存储，锁定或离开保险库时停止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有在你點一下時才會開始錄音。錄音會加密儲存，並在你鎖定或離開保險箱時停止。"
          }
        }
      }
    },
