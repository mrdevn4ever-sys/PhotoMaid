        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আগে বেছে নিন কী কপি হবে এবং একটি গন্তব্য ফোল্ডার।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Primer tria què vols copiar i una carpeta de destinació."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejdřív vyberte, co kopírovat, a cílovou složku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg først, hvad der skal kopieres, og en destinationsmappe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle zuerst aus, was kopiert werden soll, und einen Zielordner."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πρώτα επίλεξε τι θα αντιγραφεί και έναν φάκελο προορισμού."
