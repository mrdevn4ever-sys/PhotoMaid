        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al massimo %1$lld foto per PDF: sono incluse le prime %1$lld."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF 1 件あたり最大 %1$lld 枚 – 最初の %1$lld 枚を使用します。"
          }
        },
        "ko": {
          "stringUnit": {
