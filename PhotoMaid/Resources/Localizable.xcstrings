    "vault_delete_all_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم حذف العناصر نهائيًا: %1$lld. أعِدها أولًا إلى تطبيق الصور إذا أردت الاحتفاظ بها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lldটি আইটেম স্থায়ীভাবে মুছে ফেলা হবে। রাখতে চাইলে আগে সেগুলো ফটো অ্যাপে ফিরিয়ে রাখুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "S’esborraran definitivament %1$lld elements. Si els vols conservar, primer torna’ls a l’app Fotos."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Trvale se smaže %1$lld položek. Pokud si je chcete ponechat, nejdřív je vraťte do aplikace Fotky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld emner slettes permanent. Læg dem først tilbage i appen Fotos, hvis du vil beholde dem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld Inhalte werden unwiderruflich gelöscht. Lege Medien vorher zurück in die Fotos-App, wenn du sie behalten willst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld στοιχεία θα διαγραφούν οριστικά. Αν θέλεις να τα κρατήσεις, επέστρεψέ τα πρώτα στην εφαρμογή Φωτογραφίες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld items will be deleted permanently. Put them back into the Photos app first if you want to keep them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán %1$lld elementos de forma permanente. Si quieres conservarlos, devuélvelos antes a la app Fotos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld kohdetta poistetaan pysyvästi. Jos haluat säilyttää ne, palauta ne ensin Kuvat-appiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld éléments seront supprimés définitivement. Remets-les d’abord dans l’app Photos si tu veux les garder."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld આઇટમ કાયમ માટે ડિલીટ થશે. તેમને રાખવી હોય તો પહેલાં ફોટો ઍપમાં પાછી મૂકો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld פריטים יימחקו לצמיתות. כדי לשמור אותם, יש להחזיר אותם קודם ליישום ״תמונות״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld आइटम स्थायी रूप से डिलीट होंगे। अगर उन्हें रखना है, तो पहले उन्हें तस्वीरें ऐप में वापस रखें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld stavki bit će trajno izbrisano. Ako ih želiš zadržati, najprije ih vrati u aplikaciju Fotografije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld elem véglegesen törlődik. Ha meg szeretnéd tartani őket, előbb tedd vissza őket a Fotók appba."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld item akan dihapus permanen. Kembalikan dulu ke app Foto jika ingin menyimpannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld elementi verranno eliminati definitivamente. Se vuoi conservarli, rimettili prima nell’app Foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld項目が完全に削除されます。残したい場合は、先に写真アプリに戻してください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld ಐಟಂಗಳನ್ನು ಶಾಶ್ವತವಾಗಿ ಅಳಿಸಲಾಗುತ್ತದೆ. ಇರಿಸಿಕೊಳ್ಳಬೇಕಿದ್ದರೆ ಮೊದಲು ಅವುಗಳನ್ನು ಫೋಟೋಗಳು ಆ್ಯಪ್‌ಗೆ ಹಿಂತಿರುಗಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목 %1$lld개가 영구적으로 삭제됩니다. 보관하려면 먼저 사진 앱으로 되돌리세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld ഇനങ്ങൾ ശാശ്വതമായി ഇല്ലാതാക്കും. സൂക്ഷിക്കണമെങ്കിൽ ആദ്യം അവ ഫോട്ടോസ് ആപ്പിലേക്ക് തിരികെ വയ്ക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld आयटम कायमचे डिलीट होतील. ते ठेवायचे असल्यास आधी फोटो अ‍ॅपमध्ये परत ठेवा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld item akan dipadam secara kekal. Kembalikannya ke app Foto dahulu jika anda mahu menyimpannya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld elementer slettes permanent. Legg dem tilbake i Bilder-appen først hvis du vil beholde dem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld onderdelen worden definitief verwijderd. Zet ze eerst terug in de Foto’s-app als je ze wilt houden."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lldଟି ଆଇଟମ୍ ସ୍ଥାୟୀ ଭାବେ ଡିଲିଟ୍ ହେବ। ରଖିବାକୁ ଚାହିଁଲେ ପ୍ରଥମେ ସେଗୁଡ଼ିକୁ ଫଟୋ ଆପ୍‌କୁ ଫେରାଇ ରଖନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld ਆਈਟਮਾਂ ਪੱਕੇ ਤੌਰ ’ਤੇ ਮਿਟਾ ਦਿੱਤੀਆਂ ਜਾਣਗੀਆਂ। ਜੇ ਤੁਸੀਂ ਇਨ੍ਹਾਂ ਨੂੰ ਰੱਖਣਾ ਚਾਹੁੰਦੇ ਹੋ, ਤਾਂ ਪਹਿਲਾਂ ਫ਼ੋਟੋਆਂ ਐਪ ਵਿੱਚ ਵਾਪਸ ਰੱਖੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elementy do trwałego usunięcia: %1$lld. Jeśli chcesz je zachować, najpierw przenieś je z powrotem do aplikacji Zdjęcia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld itens serão apagados permanentemente. Devolva-os primeiro ao app Fotos se quiser mantê-los."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld itens serão apagados definitivamente. Se os quiseres manter, devolve-os primeiro à app Fotografias."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Elemente care vor fi șterse definitiv: %1$lld. Mută-le mai întâi înapoi în aplicația Poze dacă vrei să le păstrezi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Объекты будут удалены безвозвратно: %1$lld. Если хочешь их сохранить, сначала верни их в «Фото»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Natrvalo sa vymaže %1$lld položiek. Ak si ich chcete ponechať, najprv ich vráťte do aplikácie Fotky."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trajno bo izbrisanih %1$lld elementov. Če jih želiš obdržati, jih najprej vrni v aplikacijo Fotografije."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld objekt raderas permanent. Lägg tillbaka dem i appen Bilder först om du vill behålla dem."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld உருப்படிகள் நிரந்தரமாக நீக்கப்படும். வைத்திருக்க விரும்பினால் முதலில் அவற்றை Photos ஆப்பிற்குத் திரும்ப வையுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld అంశాలు శాశ్వతంగా తొలగించబడతాయి. ఉంచుకోవాలనుకుంటే ముందుగా వాటిని Photos యాప్‌లోకి తిరిగి పెట్టండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld รายการจะถูกลบถาวร ใส่กลับไปที่แอพรูปภาพก่อนหากต้องการเก็บไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld öğe kalıcı olarak silinecek. Saklamak istiyorsan önce Fotoğraflar uygulamasına geri taşı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Об’єкти буде видалено безповоротно: %1$lld. Якщо хочеш їх зберегти, спочатку поверни їх у «Фото»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld آئٹمز مستقل طور پر حذف ہوں گے۔ اگر انہیں رکھنا ہے تو پہلے تصاویر ایپ میں واپس رکھیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld mục sẽ bị xóa vĩnh viễn. Hãy đưa chúng về ứng dụng Ảnh trước nếu muốn giữ lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 项将被永久删除。如果想保留，请先将它们放回“照片”App。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 個項目將被永久刪除。若要保留，請先將它們放回「照片」App。"
          }
        }
      }
    },
    "vault_delete_all_title": {
