        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆಯ್ಕೆಮಾಡಿದ ಫೋಲ್ಡರ್‌ಗೆ ನಕಲಿಸಿ ಮತ್ತು ಪ್ರತಿ ಪ್ರತಿಯನ್ನು ಪರಿಶೀಲಿಸಿ"
          }
        },
        "ko": {
