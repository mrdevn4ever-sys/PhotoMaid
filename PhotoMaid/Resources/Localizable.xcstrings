    "today_continue_sub": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تابع من حيث توقفت."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যেখানে থেমেছিলেন সেখান থেকে শুরু করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua on ho vas deixar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokračujte tam, kde jste skončili."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsæt, hvor du slap."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es geht dort weiter, wo du aufgehört hast."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνέχισε από εκεί που σταμάτησες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick up where you left off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Continúa donde lo dejaste."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jatka siitä, mihin jäit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reprends là où tu t’étais arrêté."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જ્યાં છોડ્યું હતું ત્યાંથી આગળ વધો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "להמשיך מאיפה שעצרת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जहाँ छोड़ा था, वहीं से शुरू करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavi gdje si stao."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Folytasd ott, ahol abbahagytad."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lanjutkan dari tempat terakhir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riprendi da dove avevi lasciato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回の続きから始められます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ನಿಲ್ಲಿಸಿದಲ್ಲಿಂದ ಮುಂದುವರಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지난번에 멈춘 곳부터 이어서 해요."
