    "pro_msg_nofill": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يتوفر إعلان الآن. حاول لاحقًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerade ist keine Werbung verfügbar. Versuche es später erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No ad is available right now. Try again later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora no hay anuncios disponibles. Inténtalo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune publicité n’est disponible pour le moment. Réessaie plus tard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al momento non ci sono pubblicità disponibili. Riprova più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今は広告を表示できません。あとでお試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 볼 수 있는 광고가 없어요. 나중에 다시 시도해 주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is nu geen advertentie beschikbaar. Probeer het later opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Teraz nie ma dostępnej reklamy. Spróbuj później."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "De momento não há anúncios disponíveis. Tenta mais tarde."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu este disponibilă nicio reclamă acum. Încearcă mai târziu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас нет доступной рекламы. Попробуй позже."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu anda kullanılabilir reklam yok. Daha sonra tekrar dene."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зараз немає доступної реклами. Спробуй пізніше."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时没有可用广告，请稍后重试。"
          }
        }
      }
    },
    "pro_msg_nothing": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم نجد عملية شراء سابقة لهذا الحساب."
          }
        },
        "de": {
