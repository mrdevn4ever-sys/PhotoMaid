    "share_no_access": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن لـ GaleriQ الوصول إلى صورك بعد. اسمح بالوصول في الإعدادات ثم أرسل مرة أخرى."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "GaleriQ can’t access your photos yet. Allow access in Settings, then send again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ hat noch keinen Zugriff auf deine Fotos. Erlaube den Zugriff in den Einstellungen und sende erneut."
          }
        },
