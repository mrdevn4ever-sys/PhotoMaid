    "storage_c_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستطيع PhotoMaid فحص التطبيقات الأخرى أو ملفات النظام أو المحتوى السحابي أو المجلدات التي لم تسمح له بها. لذلك لا يعرض حجمًا لها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere Apps, Systemdateien, Cloud-Inhalte und nicht freigegebene Ordner kann PhotoMaid nicht prüfen. Dafür wird keine Größe angezeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid can’t check other apps, system files, cloud content or folders you haven’t allowed. No size is shown for these."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid no puede revisar otras apps, archivos del sistema, contenido en la nube ni carpetas no autorizadas. No se muestra su tamaño."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid ne peut pas vérifier les autres applications, les fichiers système, le contenu cloud ni les dossiers non autorisés. Aucune taille n’est affichée pour eux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid non può controllare altre app, file di sistema, contenuti cloud e cartelle non autorizzate. Per questi non viene mostrata una dimensione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaidでは他のアプリ、システムファイル、クラウド上のデータ、許可していないフォルダは確認できません。そのため、これらのサイズは表示しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 앱, 시스템 파일, 클라우드 콘텐츠, 허용하지 않은 폴더는 PhotoMaid가 확인할 수 없어요. 이 항목들의 크기는 표시하지 않아요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid kan andere apps, systeembestanden, cloudinhoud en niet-toegestane mappen niet controleren. Daarvoor wordt geen grootte getoond."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid nie może sprawdzać innych aplikacji, plików systemowych, chmury ani folderów bez dostępu. Nie pokazuje dla nich rozmiaru."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O PhotoMaid não pode verificar outras apps, ficheiros do sistema, conteúdo na nuvem ou pastas não autorizadas. Não é mostrado um tamanho para estes dados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid nu poate verifica alte aplicații, fișiere de sistem, conținut cloud sau dosare fără acces. Pentru acestea nu afișează o dimensiune."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid не может проверять другие приложения, системные файлы, облачные данные и папки без доступа. Их размер не показывается."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid diğer uygulamaları, sistem dosyalarını, bulut içeriğini ve izin verilmeyen klasörleri inceleyemez. Bunlar için boyut gösterilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid не може перевіряти інші застосунки, системні файли, хмарні дані й папки без доступу. Їхній розмір не показується."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid 无法检查其他应用、系统文件、云端内容或未授权的文件夹，因此不显示这些内容的大小。"
          }
        }
      }
    },
