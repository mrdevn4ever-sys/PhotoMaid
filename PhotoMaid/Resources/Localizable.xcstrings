    "pro_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المشتريات غير متاحة في هذا الإصدار بعد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই সংস্করণে এখনো কেনাকাটা উপলব্ধ নয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les compres encara no estan disponibles en aquesta versió."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nákupy v této verzi zatím nejsou k dispozici."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Køb er endnu ikke tilgængelige i denne version."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Käufe sind in dieser Version noch nicht verfügbar."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι αγορές δεν είναι ακόμη διαθέσιμες σε αυτή την έκδοση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Purchases aren’t available in this version yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las compras aún no están disponibles en esta versión."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostot eivät ole vielä käytettävissä tässä versiossa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les achats ne sont pas encore disponibles dans cette version."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ વર્ઝનમાં હજી ખરીદી ઉપલબ્ધ નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רכישות עדיין לא זמינות בגרסה הזו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस वर्शन में अभी खरीदारी उपलब्ध नहीं है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kupnje u ovoj verziji još nisu dostupne."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A vásárlások ebben a verzióban még nem érhetők el."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembelian belum tersedia di versi ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli acquisti non sono ancora disponibili in questa versione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバージョンでは、まだ購入できません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಆವೃತ್ತಿಯಲ್ಲಿ ಇನ್ನೂ ಖರೀದಿಗಳು ಲಭ್ಯವಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 버전에서는 아직 구매할 수 없어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ പതിപ്പിൽ ഇതുവരെ വാങ്ങലുകൾ ലഭ്യമല്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या आवृत्तीत अजून खरेदी उपलब्ध नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembelian belum tersedia dalam versi ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjøp er ikke tilgjengelig i denne versjonen ennå."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aankopen zijn nog niet beschikbaar in deze versie."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହି ସଂସ୍କରଣରେ ଏପର୍ଯ୍ୟନ୍ତ କିଣାକିଣି ଉପଲବ୍ଧ ନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਵਰਜ਼ਨ ਵਿੱਚ ਹਾਲੇ ਖ਼ਰੀਦਦਾਰੀ ਉਪਲਬਧ ਨਹੀਂ।"
