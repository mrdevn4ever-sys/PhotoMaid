    "summary_basket_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن يُحذف شيء حتى تفرغ سلة المهملات وتؤكد ذلك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি ট্র্যাশ খালি করে নিশ্চিত না করা পর্যন্ত কিছুই মুছে ফেলা হয় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s’esborra res fins que buides la paperera i ho confirmes."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic se nesmaže, dokud nevyprázdníte koš a nepotvrdíte to."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet slettes, før du tømmer papirkurven og bekræfter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelöscht wird erst, wenn du den Papierkorb leerst und bestätigst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τίποτα δεν διαγράφεται μέχρι να αδειάσεις τον κάδο και να επιβεβαιώσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is deleted until you empty the trash and confirm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se borra nada hasta que vacíes la papelera y confirmes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitään ei poisteta, ennen kuin tyhjennät roskakorin ja vahvistat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’est supprimé avant que tu vides la corbeille et confirmes."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે ટ્રેશ ખાલી કરીને પુષ્ટિ ન કરો ત્યાં સુધી કંઈ ડિલીટ થતું નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שום דבר לא נמחק עד שמרוקנים את הפח ומאשרים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब तक आप ट्रैश खाली करके पुष्टि न करें, कुछ भी डिलीट नहीं होता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ništa se ne briše dok ne isprazniš smeće i potvrdiš."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Semmi sem törlődik, amíg ki nem üríted a kukát és meg nem erősíted."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada yang dihapus sampai kamu mengosongkan sampah dan konfirmasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nulla viene eliminato finché non svuoti il cestino e confermi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴミ箱を空にして確認するまで、何も削除されません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಕಸದ ಬುಟ್ಟಿ ಖಾಲಿ ಮಾಡಿ ದೃಢೀಕರಿಸುವವರೆಗೆ ಏನನ್ನೂ ಅಳಿಸಲಾಗುವುದಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통을 비우고 확인하기 전에는 아무것도 삭제되지 않아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ ട്രാഷ് ശൂന്യമാക്കി സ്ഥിരീകരിക്കുന്നതുവരെ ഒന്നും ഇല്ലാതാക്കില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही ट्रॅश रिकामा करून पुष्टी करेपर्यंत काहीही डिलीट होत नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada apa dipadam sehingga anda mengosongkan sampah dan mengesahkannya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting slettes før du tømmer papirkurven og bekrefter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wordt pas iets verwijderd als je de prullenbak leegt en bevestigt."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣ ଟ୍ରାସ ଖାଲି କରି ନିଶ୍ଚିତ ନକରିବା ପର୍ଯ୍ୟନ୍ତ କିଛି ଡିଲିଟ୍ ହୁଏ ନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਦੋਂ ਤੱਕ ਤੁਸੀਂ ਰੱਦੀ ਖਾਲੀ ਕਰਕੇ ਪੁਸ਼ਟੀ ਨਹੀਂ ਕਰਦੇ, ਕੁਝ ਨਹੀਂ ਮਿਟਦਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie zostanie usunięte, dopóki nie opróżnisz kosza i nie potwierdzisz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
