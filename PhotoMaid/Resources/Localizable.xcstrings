          "stringUnit": {
            "state": "translated",
            "value": "கொலாஜைச் சேமிக்க முடியவில்லை. உங்கள் புகைப்படங்கள் மாறவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కొలాజ్‌ను సేవ్ చేయడం సాధ్యం కాలేదు. మీ ఫోటోలు మారలేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถบันทึกภาพตัดปะได้ รูปภาพของคุณไม่เปลี่ยนแปลง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolaj kaydedilemedi. Fotoğrafların değişmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося зберегти колаж. Ваші фото не змінено."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کولاج محفوظ نہیں ہو سکا۔ آپ کی تصاویر تبدیل نہیں ہوئیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể lưu ảnh ghép. Ảnh của bạn không thay đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法存储拼图。你的照片未被更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存拼貼。你的照片沒有更改。"
          }
        }
      }
    },
