        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ಪೂರ್ವವೀಕ್ಷಣೆಗಳನ್ನು ಲೋಡ್ ಮಾಡಲು Wi-Fi ಗಾಗಿ ಕಾಯಲಾಗುತ್ತಿದೆ."
