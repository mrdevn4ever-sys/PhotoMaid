    "collage_res_strip_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في الشريط يخص الرقم العرض (عموديًا) أو الارتفاع (أفقيًا). تُصغَّر الشرائط الطويلة جدًا ليمكن حفظها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্ট্রিপের ক্ষেত্রে সংখ্যাটি প্রস্থ (উপর থেকে নিচে) বা উচ্চতা (পাশাপাশি)। খুব লম্বা স্ট্রিপ ছোট করা হয় যাতে সংরক্ষণ করা যায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "En les tires, el número és l’amplada (de dalt a baix) o l’alçada (una al costat de l’altra). Les tires molt llargues es redueixen perquè es puguin desar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "U pásů je číslo šířka (shora dolů) nebo výška (vedle sebe). Velmi dlouhé pásy se zmenší, aby je šlo uložit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For striber er tallet bredden (oppefra og ned) eller højden (side om side). Meget lange striber formindskes, så de kan gemmes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Streifen gilt die Zahl für die Breite (untereinander) bzw. die Höhe (nebeneinander). Sehr lange Streifen werden verkleinert, damit sie sich speichern lassen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στις λωρίδες ο αριθμός είναι το πλάτος (από πάνω προς τα κάτω) ή το ύψος (δίπλα-δίπλα). Πολύ μεγάλες λωρίδες μικραίνουν για να αποθηκευτούν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For strips, the number is the width (top to bottom) or the height (side by side). Very long strips are reduced so they can be saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En las tiras, el número es el ancho (de arriba abajo) o el alto (lado a lado). Las tiras muy largas se reducen para poder guardarlas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nauhoissa luku on leveys (ylhäältä alas) tai korkeus (rinnakkain). Hyvin pitkiä nauhoja pienennetään, jotta ne voidaan tallentaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour les bandes, le nombre correspond à la largeur (de haut en bas) ou à la hauteur (côte à côte). Les bandes très longues sont réduites pour pouvoir être enregistrées."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પટ્ટીઓમાં સંખ્યા એટલે પહોળાઈ (ઉપરથી નીચે) કે ઊંચાઈ (બાજુ-બાજુમાં). ખૂબ લાંબી પટ્ટીઓ સાચવી શકાય તે માટે નાની કરાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ברצועות, המספר הוא הרוחב (מלמעלה למטה) או הגובה (זו לצד זו). רצועות ארוכות מאוד מוקטנות כדי שאפשר יהיה לשמור אותן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पट्टियों में संख्या चौड़ाई (ऊपर से नीचे) या ऊँचाई (साथ-साथ) होती है। बहुत लंबी पट्टियाँ छोटी कर दी जाती हैं ताकि सहेजी जा सकें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod traka broj je širina (odozgo prema dolje) ili visina (jedna uz drugu). Vrlo duge trake smanjuju se kako bi se mogle spremiti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csíkoknál a szám a szélesség (fentről lefelé) vagy a magasság (egymás mellett). A nagyon hosszú csíkok kicsinyítve lesznek, hogy menthetők legyenek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk strip, angkanya adalah lebar (atas ke bawah) atau tinggi (berdampingan). Strip yang sangat panjang diperkecil agar bisa disimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per le strisce il numero indica la larghezza (dall’alto in basso) o l’altezza (affiancate). Le strisce molto lunghe vengono ridotte per poterle salvare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストリップでは、縦並びは幅、横並びは高さの値です。とても長いストリップは保存できるように縮小されます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪಟ್ಟಿಗಳಿಗೆ, ಸಂಖ್ಯೆಯು ಅಗಲ (ಮೇಲಿನಿಂದ ಕೆಳಗೆ) ಅಥವಾ ಎತ್ತರ (ಅಕ್ಕಪಕ್ಕ). ತುಂಬಾ ಉದ್ದದ ಪಟ್ಟಿಗಳನ್ನು ಉಳಿಸಲು ಸಾಧ್ಯವಾಗುವಂತೆ ಚಿಕ್ಕದಾಗಿಸಲಾಗುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스트립에서는 숫자가 너비(세로 배치) 또는 높이(가로 배치)를 뜻합니다. 아주 긴 스트립은 저장할 수 있도록 축소됩니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്ട്രിപ്പുകൾക്ക്, സംഖ്യ വീതിയാണ് (മുകളിൽ നിന്ന് താഴേക്ക്) അല്ലെങ്കിൽ ഉയരം (അടുത്തടുത്ത്). വളരെ നീളമുള്ള സ്ട്രിപ്പുകൾ സംരക്ഷിക്കാൻ കഴിയുന്ന വിധം ചെറുതാക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पट्ट्यांमध्ये संख्या म्हणजे रुंदी (वरून खाली) किंवा उंची (शेजारी शेजारी). खूप लांब पट्ट्या जतन करता याव्यात म्हणून लहान केल्या जातात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk jalur, nombor ialah lebar (atas ke bawah) atau tinggi (bersebelahan). Jalur yang sangat panjang dikecilkan supaya boleh disimpan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For striper er tallet bredden (ovenfra og ned) eller høyden (side om side). Svært lange striper forminskes slik at de kan lagres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij stroken is het getal de breedte (onder elkaar) of de hoogte (naast elkaar). Heel lange stroken worden verkleind zodat ze kunnen worden bewaard."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଷ୍ଟ୍ରିପ୍ ପାଇଁ ସଂଖ୍ୟାଟି ପ୍ରସ୍ଥ (ଉପରୁ ତଳକୁ) କିମ୍ବା ଉଚ୍ଚତା (ପାଖାପାଖି)। ବହୁତ ଲମ୍ବା ଷ୍ଟ୍ରିପ୍ ଛୋଟ କରାଯାଏ ଯାହାଦ୍ୱାରା ସେଭ୍ ହୋଇପାରିବ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪੱਟੀਆਂ ਵਿੱਚ ਅੰਕ ਚੌੜਾਈ (ਉੱਪਰ ਤੋਂ ਹੇਠਾਂ) ਜਾਂ ਉਚਾਈ (ਨਾਲ-ਨਾਲ) ਹੁੰਦਾ ਹੈ। ਬਹੁਤ ਲੰਬੀਆਂ ਪੱਟੀਆਂ ਛੋਟੀਆਂ ਕੀਤੀਆਂ ਜਾਂਦੀਆਂ ਹਨ ਤਾਂ ਜੋ ਸੰਭਾਲੀਆਂ ਜਾ ਸਕਣ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W pasku liczba oznacza szerokość (jeden pod drugim) lub wysokość (obok siebie). Bardzo długie paski są zmniejszane, aby dało się je zapisać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em faixas, o número é a largura (de cima para baixo) ou a altura (lado a lado). Faixas muito longas são reduzidas para poderem ser salvas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nas tiras, o número é a largura (de cima para baixo) ou a altura (lado a lado). Tiras muito longas são reduzidas para poderem ser guardadas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "La benzi, numărul este lățimea (una sub alta) sau înălțimea (una lângă alta). Benzile foarte lungi sunt micșorate ca să poată fi salvate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для ленты число — ширина (сверху вниз) или высота (в ряд). Очень длинные ленты уменьшаются, чтобы их можно было сохранить."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pri pásoch je číslo šírka (zhora nadol) alebo výška (vedľa seba). Veľmi dlhé pásy sa zmenšia, aby sa dali uložiť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pri trakovih je število širina (od zgoraj navzdol) ali višina (druga ob drugi). Zelo dolgi trakovi se zmanjšajo, da jih je mogoče shraniti."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För remsor är talet bredden (uppifrån och ned) eller höjden (sida vid sida). Mycket långa remsor förminskas så att de kan sparas."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பட்டைகளுக்கு, எண் அகலம் (மேலிருந்து கீழாக) அல்லது உயரம் (அருகருகே). மிக நீளமான பட்டைகள் சேமிக்க முடியும்படி சிறிதாக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పట్టీలకు, సంఖ్య వెడల్పు (పై నుండి కిందికి) లేదా ఎత్తు (పక్కపక్కనే). చాలా పొడవైన పట్టీలను సేవ్ చేయగలిగేలా చిన్నవి చేస్తారు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สำหรับแถบ ตัวเลขคือความกว้าง (บนลงล่าง) หรือความสูง (เคียงข้างกัน) แถบที่ยาวมากจะถูกย่อเพื่อให้บันทึกได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şeritlerde sayı genişliği (alt alta) veya yüksekliği (yan yana) belirtir. Çok uzun şeritler kaydedilebilmeleri için küçültülür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для стрічки число — ширина (згори вниз) або висота (в ряд). Дуже довгі стрічки зменшуються, щоб їх можна було зберегти."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پٹیوں میں عدد چوڑائی (اوپر سے نیچے) یا اونچائی (ساتھ ساتھ) ہوتا ہے۔ بہت لمبی پٹیاں چھوٹی کر دی جاتی ہیں تاکہ محفوظ ہو سکیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Với dải, con số là chiều rộng (trên xuống dưới) hoặc chiều cao (cạnh nhau). Dải quá dài sẽ được thu nhỏ để có thể lưu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长条拼图中，数字指宽度（上下排列）或高度（左右排列）。过长的长条会缩小以便保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "長條拼貼的數字代表寬度（上下排列）或高度（左右並排）。過長的長條會縮小以便儲存。"
          }
        }
      }
    },
