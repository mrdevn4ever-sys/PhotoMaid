    "sources_footer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قطع اتصال المجلد لا يحذف أي ملفات. أنت تختار المجلدات التي يصل إليها PhotoMaid في عرض الملفات هذا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Ordner zu trennen löscht keine Dateien. Für diese Dateiansicht wählst du selbst, welche Ordner PhotoMaid sehen darf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnecting a folder doesn’t delete any files. You choose which folders PhotoMaid can access in this file view."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconectar una carpeta no borra sus archivos. Tú eliges a qué carpetas puede acceder PhotoMaid en esta vista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déconnecter un dossier ne supprime aucun fichier. Tu choisis les dossiers auxquels PhotoMaid peut accéder dans cette vue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scollegare una cartella non elimina i file. Decidi tu quali cartelle rendere accessibili a PhotoMaid in questa vista."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続を解除しても、ファイルは削除されません。このファイル画面でPhotoMaidがアクセスするフォルダは自分で選べます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결을 해제해도 파일은 삭제되지 않아요. 이 파일 화면에서 PhotoMaid가 접근할 폴더를 직접 선택할 수 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een map ontkoppelen verwijdert geen bestanden. Je kiest zelf welke mappen PhotoMaid in deze bestandsweergave mag zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odłączenie folderu nie usuwa plików. W tym widoku samodzielnie wybierasz foldery dostępne dla PhotoMaid."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Desligar uma pasta não elimina ficheiros. Escolhes as pastas a que o PhotoMaid pode aceder nesta vista."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deconectarea unui dosar nu șterge fișiere. Tu alegi dosarele pe care PhotoMaid le poate accesa în această vedere."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отключение папки не удаляет файлы. В этом разделе ты сам выбираешь папки, доступные PhotoMaid."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klasör bağlantısını kesmek dosyaları silmez. Bu görünümde PhotoMaid uygulamasının hangi klasörlere erişeceğini sen seçersin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відключення папки не видаляє файли. У цьому розділі ти самостійно вибираєш папки, доступні для PhotoMaid."
