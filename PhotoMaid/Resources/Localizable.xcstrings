    "vid_hdr_hint_ios": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتوي هذا الفيديو على ألوان ساطعة بشكل خاص (HDR). عند إعادة حسابه يُحفظ بألوان عادية. إذا قصصته فقط، يبقى HDR."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ভিডিওতে বিশেষভাবে উজ্জ্বল রং (HDR) আছে। নতুন করে গণনা করলে এটি সাধারণ রঙে সংরক্ষিত হয়। শুধু ছাঁটলে HDR থেকে যায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquest vídeo té colors especialment brillants (HDR). Quan es recalcula, es desa amb colors normals. Si només el retalles, es manté l’HDR."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto video má zvlášť jasné barvy (HDR). Při přepočtu se uloží s normálními barvami. Pokud ho jen zkrátíte, HDR zůstane."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne video har særligt kraftige farver (HDR). Når den beregnes igen, gemmes den med normale farver. Hvis du kun klipper den, bevares HDR."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Video hat besonders leuchtende Farben (HDR). Beim Neuberechnen wird es mit normalen Farben gespeichert. Nur gekürzt bleibt HDR erhalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το βίντεο έχει ιδιαίτερα φωτεινά χρώματα (HDR). Όταν επαναϋπολογίζεται, αποθηκεύεται με κανονικά χρώματα. Αν απλώς το κόψεις, το HDR διατηρείται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This video has especially bright colours (HDR). When it’s recalculated, it’s saved with normal colours. If you only trim it, HDR is kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este vídeo tiene colores especialmente intensos (HDR). Al recalcularlo se guarda con colores normales. Si solo lo recortas, se mantiene el HDR."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tässä videossa on erityisen kirkkaat värit (HDR). Kun se lasketaan uudelleen, se tallennetaan tavallisilla väreillä. Jos vain trimmaat sen, HDR säilyy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette vidéo a des couleurs particulièrement lumineuses (HDR). Recalculée, elle est enregistrée avec des couleurs normales. Si vous la raccourcissez seulement, le HDR est conservé."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ વીડિયોમાં ખાસ ચમકદાર રંગો (HDR) છે. ફરી ગણતરી થાય ત્યારે તે સામાન્ય રંગોમાં સચવાય છે. તમે ફક્ત ટ્રિમ કરો તો HDR રહે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לסרטון הזה צבעים בהירים במיוחד (HDR). כשהוא מחושב מחדש, הוא נשמר בצבעים רגילים. אם רק מקצרים אותו, ה-HDR נשמר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस वीडियो में खास तौर पर चमकीले रंग (HDR) हैं। दोबारा गणना होने पर यह सामान्य रंगों में सहेजा जाता है। अगर आप सिर्फ़ ट्रिम करते हैं, तो HDR बना रहता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj videozapis ima posebno svijetle boje (HDR). Kad se ponovno izračuna, sprema se s normalnim bojama. Ako ga samo skratiš, HDR se zadržava."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ennek a videónak különösen világos színei vannak (HDR). Újraszámoláskor normál színekkel mentődik. Ha csak vágod, a HDR megmarad."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Video ini punya warna yang sangat terang (HDR). Saat dihitung ulang, video disimpan dengan warna normal. Jika kamu hanya memangkasnya, HDR tetap dipertahankan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo video ha colori particolarmente luminosi (HDR). Quando viene ricalcolato, si salva con colori normali. Se lo accorci soltanto, l’HDR resta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このビデオは特に明るい色（HDR）です。再計算すると通常の色で保存されます。トリミングだけならHDRのままです。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ವೀಡಿಯೊದಲ್ಲಿ ವಿಶೇಷವಾಗಿ ಪ್ರಕಾಶಮಾನ ಬಣ್ಣಗಳಿವೆ (HDR). ಮರುಲೆಕ್ಕಾಚಾರ ಮಾಡಿದಾಗ ಅದು ಸಾಮಾನ್ಯ ಬಣ್ಣಗಳೊಂದಿಗೆ ಉಳಿಯುತ್ತದೆ. ನೀವು ಟ್ರಿಮ್ ಮಾತ್ರ ಮಾಡಿದರೆ HDR ಉಳಿಯುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 비디오는 특히 밝은 색상(HDR)입니다. 다시 계산하면 일반 색상으로 저장됩니다. 다듬기만 하면 HDR이 유지됩니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ വീഡിയോയ്ക്ക് പ്രത്യേകിച്ച് തിളക്കമുള്ള നിറങ്ങളുണ്ട് (HDR). വീണ്ടും കണക്കാക്കുമ്പോൾ ഇത് സാധാരണ നിറങ്ങളോടെ സംരക്ഷിക്കപ്പെടും. ട്രിം മാത്രം ചെയ്താൽ HDR നിലനിൽക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या व्हिडिओमध्ये विशेष उजळ रंग (HDR) आहेत. पुन्हा गणना केल्यावर तो सामान्य रंगांत जतन होतो. तुम्ही फक्त ट्रिम केल्यास HDR राहते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Video ini mempunyai warna yang sangat terang (HDR). Apabila ia dikira semula, ia disimpan dengan warna biasa. Jika anda hanya memangkasnya, HDR dikekalkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne videoen har spesielt sterke farger (HDR). Når den beregnes på nytt, lagres den med vanlige farger. Hvis du bare klipper den, beholdes HDR."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze video heeft extra heldere kleuren (HDR). Bij opnieuw berekenen wordt hij met normale kleuren bewaard. Alleen inkorten houdt HDR."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହି ଭିଡିଓରେ ବିଶେଷ ଉଜ୍ଜ୍ୱଳ ରଙ୍ଗ (HDR) ଅଛି। ପୁଣି ଗଣନା ହେଲେ ଏହା ସାଧାରଣ ରଙ୍ଗ ସହ ସେଭ୍ ହୁଏ। କେବଳ ଟ୍ରିମ୍ କଲେ HDR ରହେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਵੀਡੀਓ ਵਿੱਚ ਖ਼ਾਸ ਤੌਰ ’ਤੇ ਚਮਕਦਾਰ ਰੰਗ (HDR) ਹਨ। ਦੁਬਾਰਾ ਗਣਨਾ ਹੋਣ ’ਤੇ ਇਹ ਆਮ ਰੰਗਾਂ ਨਾਲ ਸੰਭਾਲੀ ਜਾਂਦੀ ਹੈ। ਜੇ ਤੁਸੀਂ ਇਸ ਨੂੰ ਸਿਰਫ਼ ਟ੍ਰਿਮ ਕਰਦੇ ਹੋ, ਤਾਂ HDR ਰਹਿੰਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten film ma wyjątkowo jaskrawe kolory (HDR). Po ponownym przeliczeniu zostanie zapisany w zwykłych kolorach. Samo przycięcie zachowuje HDR."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este vídeo tem cores especialmente brilhantes (HDR). Quando é recalculado, é salvo com cores normais. Se você só cortá-lo, o HDR é mantido."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este vídeo tem cores especialmente vivas (HDR). Ao ser recalculado, é guardado com cores normais. Se apenas o cortar, o HDR mantém-se."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest videoclip are culori deosebit de luminoase (HDR). La recalculare se salvează cu culori normale. Dacă doar îl scurtezi, HDR rămâne."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У этого видео особенно яркие цвета (HDR). При пересчёте оно сохранится с обычными цветами. Если только обрезать, HDR сохранится."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto video má mimoriadne jasné farby (HDR). Pri prepočte sa uloží s normálnymi farbami. Ak ho len skrátite, HDR zostane."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta video ima posebej svetle barve (HDR). Ko se preračuna, se shrani z običajnimi barvami. Če ga samo skrajšaš, HDR ostane."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här videon har särskilt ljusstarka färger (HDR). När den beräknas om sparas den med normala färger. Om du bara klipper den behålls HDR."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த வீடியோவில் மிகப் பிரகாசமான நிறங்கள் (HDR) உள்ளன. மீண்டும் கணக்கிடும்போது அது சாதாரண நிறங்களுடன் சேமிக்கப்படும். வெட்டுவது மட்டும் செய்தால் HDR இருக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ వీడియోలో ప్రత్యేకంగా ప్రకాశవంతమైన రంగులు (HDR) ఉన్నాయి. మళ్లీ లెక్కించినప్పుడు అది సాధారణ రంగులతో సేవ్ అవుతుంది. ట్రిమ్ మాత్రమే చేస్తే HDR ఉంటుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วิดีโอนี้มีสีที่สว่างเป็นพิเศษ (HDR) เมื่อคำนวณใหม่จะบันทึกด้วยสีปกติ หากคุณแค่ตัด HDR จะยังคงอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu videonun renkleri özellikle parlak (HDR). Yeniden hesaplanınca normal renklerle kaydedilir. Yalnızca kırparsan HDR korunur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це відео має особливо яскраві кольори (HDR). Після перерахунку воно збережеться зі звичайними кольорами. Якщо лише обрізати, HDR залишиться."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس ویڈیو میں خاص طور پر روشن رنگ (HDR) ہیں۔ دوبارہ حساب ہونے پر یہ عام رنگوں میں محفوظ ہوتی ہے۔ اگر آپ صرف ٹرم کریں تو HDR برقرار رہتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Video này có màu đặc biệt sáng (HDR). Khi được tính lại, video được lưu với màu thường. Nếu bạn chỉ cắt, HDR vẫn được giữ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此视频的色彩特别明亮（HDR）。重新计算后将以普通色彩存储。只修剪则保留 HDR。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這段影片的顏色特別明亮（HDR）。重新計算時會以一般顏色儲存。如果只剪輯，會保留 HDR。"
          }
        }
      }
    },
