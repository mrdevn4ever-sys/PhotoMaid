    "error_undo_busy": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن التراجع أثناء إفراغ سلة المهملات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Während der Papierkorb geleert wird, kannst du keine Aktion rückgängig machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wait until the trash has finished emptying before using Undo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espera a que termine de vaciarse la papelera para deshacer una acción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attends que la corbeille soit vidée avant d’annuler une action."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attendi che il cestino sia stato svuotato prima di annullare un’azione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴミ箱を空にしている間は、操作を取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통을 비우는 동안에는 실행을 취소할 수 없어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wacht tot de prullenbak leeg is voordat je een actie ongedaan maakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poczekaj na zakończenie opróżniania kosza, zanim cofniesz działanie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Espera que o lixo termine de esvaziar antes de anular uma ação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Așteaptă să se golească coșul înainte să anulezi o acțiune."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дождись завершения очистки корзины, прежде чем отменять действие."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir işlemi geri almadan önce çöp kutusunun boşaltılmasını bekle."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дочекайся завершення очищення кошика, перш ніж скасовувати дію."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清空回收站时无法撤销操作。"
          }
        }
      }
    },
    "error_undo_conflict": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن التراجع عن ذلك الآن لأنك غيّرته في هذه الأثناء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das lässt sich nicht mehr rückgängig machen, weil du es inzwischen geändert hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This can’t be undone any more because you changed it in the meantime."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya no se puede deshacer porque lo has cambiado mientras tanto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’annuler, car vous l’avez modifié entre-temps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non si può più annullare perché nel frattempo l’hai modificato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その後に変更したため、もう元に戻せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그사이 바꿨기 때문에 더 이상 되돌릴 수 없어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit kan niet meer ongedaan worden gemaakt, omdat je het intussen hebt gewijzigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można już tego cofnąć, bo w międzyczasie to zmieniono."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Já não é possível anular, porque entretanto alterou isto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu mai poate fi anulat, pentru că l-ai modificat între timp."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это уже нельзя отменить – вы успели это изменить."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu artık geri alınamaz çünkü bu arada değiştirdin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це вже не можна скасувати – ви встигли це змінити."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法再撤销，因为你在此期间已更改。"
          }
        }
      }
    },
