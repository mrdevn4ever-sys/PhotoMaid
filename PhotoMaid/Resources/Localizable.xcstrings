    "archive_no_cleanup_device": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النسخ موجودة على نفس مساحة التخزين التي تحتوي على صورك، لذلك لا يعرض GaleriQ هنا إزالة الأصول."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "The copies are on the same storage as your photos, so GaleriQ doesn’t offer to remove originals here."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kopien liegen auf demselben Speicher wie deine Fotos. Deshalb bietet GaleriQ hier nicht an, Originale zu entfernen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The copies are on the same storage as your photos, so GaleriQ doesn’t offer to remove originals here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las copias están en el mismo almacenamiento que tus fotos, así que GaleriQ no ofrece aquí quitar los originales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les copies sont sur le même stockage que vos photos ; GaleriQ ne propose donc pas ici de retirer les originaux."
