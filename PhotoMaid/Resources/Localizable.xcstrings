    "series_footer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يُحذف أي شيء. السلة تابعة لـ PhotoMaid ولا تُفرغ إلا بعد تأكيدك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts wird gelöscht. Der Papierkorb gehört zu PhotoMaid und wird erst geleert, wenn du es bestätigst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is deleted. The trash belongs to PhotoMaid and is only emptied when you confirm it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se elimina nada. La papelera es de PhotoMaid y solo se vacía cuando lo confirmas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’est supprimé. La corbeille appartient à PhotoMaid et n’est vidée que lorsque tu le confirmes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nulla viene eliminato. Il cestino è di PhotoMaid e si svuota solo quando lo confermi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何も削除されません。ゴミ箱はPhotoMaid内のもので、確認したときだけ空になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아무것도 삭제되지 않아요. 휴지통은 PhotoMaid 안에 있고 확인할 때만 비워져요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wordt niets verwijderd. De prullenbak is van PhotoMaid en wordt pas geleegd als je dat bevestigt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie zostanie usunięte. Kosz należy do PhotoMaid i opróżnia się dopiero po potwierdzeniu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada é eliminado. O lixo pertence ao PhotoMaid e só é esvaziado quando confirmas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimic nu se șterge. Coșul aparține PhotoMaid și se golește doar când confirmi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего не удаляется. Корзина находится в PhotoMaid и очищается только после твоего подтверждения."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir şey silinmez. Çöp kutusu PhotoMaid’e aittir ve yalnızca onayladığında boşalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нічого не видаляється. Кошик належить PhotoMaid і очищується лише після твого підтвердження."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不会删除任何内容。回收站属于 PhotoMaid，只有在你确认后才会清空。"
          }
        }
      }
    },
    "series_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر على صورة لمقارنتها بالأسفل. علامة الاختيار تحدد ما يبقى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf ein Bild, um es unten zu vergleichen. Der Haken entscheidet, was bleibt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a photo to compare it below. The check mark decides what stays."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca una foto para compararla abajo. La marca decide qué se queda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche une photo pour la comparer en bas. La coche décide de ce qui reste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca una foto per confrontarla sotto. La spunta decide cosa resta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真をタップすると下で比較できます。チェックで残すものを決めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진을 탭하면 아래에서 비교해요. 체크 표시로 남길 사진을 정해요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op een foto om hem onderaan te vergelijken. Het vinkje bepaalt wat blijft."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotknij zdjęcia, aby porównać je poniżej. Znacznik decyduje, co zostaje."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca numa foto para a comparar em baixo. O visto decide o que fica."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge o fotografie ca s-o compari jos. Bifa decide ce rămâne."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажми на фото, чтобы сравнить его ниже. Галочка решает, что останется."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aşağıda karşılaştırmak için bir fotoğrafa dokun. Onay işareti neyin kalacağını belirler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкнись фото, щоб порівняти його нижче. Позначка вирішує, що залишиться."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按照片可在下方比较。勾选决定保留哪些。"
          }
        }
      }
    },
