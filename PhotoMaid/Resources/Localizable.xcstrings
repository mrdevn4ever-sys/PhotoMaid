    "edit_size_small": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه الصورة صغيرة بالفعل. لا يكبّر GaleriQ الصور أبدًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ফটোটি আগে থেকেই ছোট। GaleriQ কখনো ফটো বড় করে না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquesta foto ja és petita. GaleriQ mai no amplia les fotos."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato fotka už je malá. GaleriQ fotky nikdy nezvětšuje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette foto er allerede lille. GaleriQ forstørrer aldrig fotos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Foto ist schon klein. GaleriQ vergrößert nie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η φωτογραφία είναι ήδη μικρή. Το GaleriQ δεν μεγεθύνει ποτέ φωτογραφίες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This photo is already small. GaleriQ never enlarges photos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta foto ya es pequeña. GaleriQ nunca amplía."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä kuva on jo pieni. GaleriQ ei koskaan suurenna kuvia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette photo est déjà petite. GaleriQ n’agrandit jamais."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ ફોટો પહેલેથી નાનો છે. GaleriQ ક્યારેય ફોટા મોટા કરતું નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התמונה הזו כבר קטנה. GaleriQ אף פעם לא מגדילה תמונות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह फ़ोटो पहले से छोटी है। GaleriQ कभी फ़ोटो बड़ी नहीं करता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ova je fotografija već mala. GaleriQ nikad ne povećava fotografije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a fotó már kicsi. A GaleriQ sosem nagyít fel fotókat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto ini sudah kecil. GaleriQ tidak pernah memperbesar foto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa foto è già piccola. GaleriQ non ingrandisce mai."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この写真はすでに小さいサイズです。GaleriQが拡大することはありません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಫೋಟೋ ಈಗಾಗಲೇ ಚಿಕ್ಕದಾಗಿದೆ. GaleriQ ಎಂದಿಗೂ ಫೋಟೋಗಳನ್ನು ದೊಡ್ಡದಾಗಿಸುವುದಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 작은 사진이에요. GaleriQ는 확대하지 않아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ഫോട്ടോ ഇതിനകം ചെറുതാണ്. GaleriQ ഒരിക്കലും ഫോട്ടോകൾ വലുതാക്കില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हा फोटो आधीच लहान आहे. GaleriQ कधीही फोटो मोठे करत नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto ini sudah kecil. GaleriQ tidak pernah membesarkan foto."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette bildet er allerede lite. GaleriQ forstørrer aldri bilder."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze foto is al klein. GaleriQ vergroot nooit."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହି ଫଟୋ ପୂର୍ବରୁ ଛୋଟ। GaleriQ କେବେ ଫଟୋ ବଡ଼ କରେ ନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਫ਼ੋਟੋ ਪਹਿਲਾਂ ਹੀ ਛੋਟੀ ਹੈ। GaleriQ ਕਦੇ ਵੀ ਫ਼ੋਟੋਆਂ ਵੱਡੀਆਂ ਨਹੀਂ ਕਰਦਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To zdjęcie jest już małe. GaleriQ nigdy nie powiększa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta foto já é pequena. O GaleriQ nunca amplia fotos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta foto já é pequena. O GaleriQ nunca amplia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografia este deja mică. GaleriQ nu mărește niciodată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это фото уже маленькое. GaleriQ никогда не увеличивает."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Táto fotka je už malá. GaleriQ fotky nikdy nezväčšuje."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta fotografija je že majhna. GaleriQ fotografij nikoli ne povečuje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här bilden är redan liten. GaleriQ förstorar aldrig bilder."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தப் புகைப்படம் ஏற்கனவே சிறியது. GaleriQ ஒருபோதும் புகைப்படங்களைப் பெரிதாக்காது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ ఫోటో ఇప్పటికే చిన్నది. GaleriQ ఎప్పుడూ ఫోటోలను పెద్దవి చేయదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปนี้เล็กอยู่แล้ว GaleriQ ไม่เคยขยายรูปภาพ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu fotoğraf zaten küçük. GaleriQ asla büyütmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це фото вже маленьке. GaleriQ ніколи не збільшує."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ تصویر پہلے سے چھوٹی ہے۔ GaleriQ کبھی تصاویر بڑی نہیں کرتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh này đã nhỏ. GaleriQ không bao giờ phóng to ảnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这张照片已经很小。GaleriQ 从不放大照片。"
          }
        },
        "zh-Hant": {
