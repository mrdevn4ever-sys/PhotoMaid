    "wf_video_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحفظ الفيديوهات من جديد لتناسب الحجم المطلوب. لا تصغر الصورة إلا عند الحاجة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Videos are saved again to fit the target size. The picture only gets smaller if needed."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Videos are saved again to fit the target size. The picture only gets smaller if needed."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Videos are saved again to fit the target size. The picture only gets smaller if needed."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Videos are saved again to fit the target size. The picture only gets smaller if needed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Videos werden passend zur Zielgröße neu gespeichert. Das Bild wird nur kleiner, wenn es nötig ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Videos are saved again to fit the target size. The picture only gets smaller if needed."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Videos are saved again to fit the target size. The picture only gets smaller if needed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los vídeos se vuelven a guardar para ajustarse al tamaño objetivo. La imagen solo se reduce si hace falta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Videos are saved again to fit the target size. The picture only gets smaller if needed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les vidéos sont réenregistrées pour respecter la taille visée. L’image ne rétrécit que si c’est nécessaire."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Videos are saved again to fit the target size. The picture only gets smaller if needed."
          }
        },
        "he": {
          "stringUnit": {
