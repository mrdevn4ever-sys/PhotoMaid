    "vault_recovery_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دوّن هذا المفتاح على ورقة واحفظه في مكان آمن. فهو يفتح الخزنة إذا نسيت رمزك، حتى على iPhone جديد. لا يمكن لـ PhotoMaid عرضه مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreib den Schlüssel auf Papier und bewahre ihn sicher auf. Er öffnet den Tresor, wenn du den Code vergisst – auch auf einem neuen iPhone. PhotoMaid kann ihn nicht erneut anzeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write this key down on paper and keep it safe. It opens the vault if you forget your code, also on a new iPhone. PhotoMaid can’t show it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apunta esta clave en papel y guárdala en un lugar seguro. Abre la caja fuerte si olvidas tu código, también en un iPhone nuevo. PhotoMaid no puede volver a mostrarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Note cette clé sur papier et conserve-la en lieu sûr. Elle ouvre le coffre-fort si tu oublies ton code, même sur un nouvel iPhone. PhotoMaid ne peut pas l’afficher à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi questa chiave su carta e conservala al sicuro. Apre la cassaforte se dimentichi il codice, anche su un nuovo iPhone. PhotoMaid non può mostrarla di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このキーを紙に書き留めて、安全な場所に保管してください。コードを忘れたときに保管庫を開けます（新しいiPhoneでも可能）。PhotoMaidではもう一度表示できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 키를 종이에 적어 안전한 곳에 보관하세요. 암호를 잊었을 때 새 iPhone에서도 금고를 열 수 있습니다. PhotoMaid는 이 키를 다시 표시할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schrijf deze sleutel op papier en bewaar hem veilig. Hij opent de kluis als je je code vergeet, ook op een nieuwe iPhone. PhotoMaid kan hem niet opnieuw tonen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz ten klucz na papierze i przechowuj go w bezpiecznym miejscu. Otwiera sejf, jeśli zapomnisz kodu – także na nowym iPhonie. PhotoMaid nie może pokazać go ponownie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Anota esta chave em papel e guarda-a num local seguro. Abre o cofre se te esqueceres do código, também num iPhone novo. O PhotoMaid não a pode mostrar outra vez."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Notează această cheie pe hârtie și păstreaz-o în siguranță. Deschide seiful dacă uiți codul, inclusiv pe un iPhone nou. PhotoMaid nu o poate afișa din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запиши этот ключ на бумаге и храни его в надёжном месте. Он открывает сейф, если ты забудешь код, в том числе на новом iPhone. PhotoMaid не сможет показать его снова."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu anahtarı kâğıda yaz ve güvenli bir yerde sakla. Kodunu unutursan kasayı açar, yeni bir iPhone’da da. PhotoMaid onu tekrar gösteremez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запиши цей ключ на папері й зберігай у надійному місці. Він відкриває сейф, якщо ти забудеш код, зокрема на новому iPhone. PhotoMaid не зможе показати його знову."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请将此密钥抄写在纸上并妥善保管。忘记密码时可用它打开保险箱，在新 iPhone 上也可以。PhotoMaid 无法再次显示它。"
          }
        }
      }
    },
