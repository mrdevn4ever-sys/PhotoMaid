    "backup_missing_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه الصور والفيديوهات غير موجودة على هذا الجهاز (أو لا يمكن مطابقتها بوضوح). لن يُستعاد لها شيء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Fotos und Videos gibt es auf diesem Gerät nicht (oder nicht eindeutig). Für sie wird nichts übernommen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These photos and videos aren’t on this device (or can’t be matched clearly). Nothing is brought in for them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas fotos y vídeos no están en este dispositivo (o no se pueden identificar con claridad). No se recupera nada para ellos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces photos et vidéos ne sont pas sur cet appareil (ou ne peuvent pas être identifiées avec certitude). Rien n’est repris pour elles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Queste foto e video non sono su questo dispositivo (o non si possono abbinare con certezza). Per loro non viene ripreso nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの写真と動画はこの端末にありません（または確実に一致させられません）。これらについては何も取り込みません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사진과 동영상은 이 기기에 없거나 정확히 찾을 수 없어요. 이 항목들은 가져오지 않아요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze foto’s en video’s staan niet op dit apparaat (of zijn niet eenduidig te vinden). Voor deze wordt niets overgenomen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tych zdjęć i filmów nie ma na tym urządzeniu (lub nie da się ich jednoznacznie dopasować). Dla nich nic nie zostanie przywrócone."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas fotos e vídeos não estão neste dispositivo (ou não é possível identificá-los com certeza). Nada é recuperado para eles."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceste fotografii și videoclipuri nu sunt pe acest dispozitiv (sau nu pot fi potrivite clar). Pentru ele nu se preia nimic."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этих фото и видео нет на устройстве (или их нельзя однозначно сопоставить). Для них ничего не переносится."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu fotoğraf ve videolar bu cihazda yok (ya da açıkça eşleştirilemiyor). Onlar için hiçbir şey aktarılmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цих фото й відео немає на пристрої (або їх не можна однозначно зіставити). Для них нічого не переноситься."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些照片和视频不在此设备上（或无法明确匹配）。不会为它们导入任何内容。"
          }
        }
      }
    },
