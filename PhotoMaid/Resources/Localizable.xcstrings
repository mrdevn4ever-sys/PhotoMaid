    "pdf_files_failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر فتح الملفات. اختر ملفات PDF غير مقفلة أو صورًا قابلة للقراءة وحاول مجددًا. لم تتغير صفحاتك الحالية."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Filerne kunne ikke åbnes. Vælg læsbare, ulåste PDF'er eller billeder, og prøv igen. Dine nuværende sider er uændrede."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Dateien konnten nicht geöffnet werden. Wähle lesbare, ungesperrte PDFs oder Bilder und versuche es erneut. Deine bisherigen Seiten bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The files could not be opened. Choose readable, unlocked PDFs or images and try again. Your current pages are unchanged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron abrir los archivos. Elige PDF sin bloqueo o imágenes legibles e inténtalo de nuevo. Tus páginas se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’ouvrir les fichiers. Choisissez des PDF non verrouillés ou des images lisibles et réessayez. Vos pages sont conservées."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File tidak dapat dibuka. Pilih PDF atau gambar yang dapat dibaca dan tidak terkunci, lalu coba lagi. Halamanmu saat ini tidak berubah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile aprire i file. Scegli PDF non bloccati o immagini leggibili e riprova. Le pagine attuali restano invariate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルを開けませんでした。ロックされていないPDFや読み取り可能な画像で再試行してください。現在のページは保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일을 열 수 없습니다. 잠기지 않은 PDF나 읽을 수 있는 이미지를 선택하고 다시 시도하세요. 현재 페이지는 유지됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Filene kunne ikke åpnes. Velg lesbare, ulåste PDF-er eller bilder og prøv igjen. De nåværende sidene dine er uendret."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bestanden konden niet worden geopend. Kies leesbare, ontgrendelde pdf’s of afbeeldingen en probeer opnieuw. Je pagina’s blijven behouden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można otworzyć plików. Wybierz niezablokowane pliki PDF lub czytelne obrazy i spróbuj ponownie. Obecne strony pozostają bez zmian."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível abrir os arquivos. Escolha PDFs ou imagens legíveis e desbloqueados e tente de novo. Suas páginas atuais não foram alteradas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível abrir os ficheiros. Escolha PDF desbloqueados ou imagens legíveis e tente novamente. As páginas atuais mantêm-se."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fișierele nu au putut fi deschise. Alege PDF-uri deblocate sau imagini lizibile și încearcă din nou. Paginile actuale rămân neschimbate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось открыть файлы. Выберите доступные PDF без блокировки или изображения и повторите попытку. Текущие страницы сохранены."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Filerna kunde inte öppnas. Välj läsbara, olåsta PDF:er eller bilder och försök igen. Dina nuvarande sidor är oförändrade."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถเปิดไฟล์ได้ เลือก PDF หรือรูปภาพที่อ่านได้และไม่ถูกล็อก แล้วลองอีกครั้ง หน้าปัจจุบันของคุณไม่เปลี่ยนแปลง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyalar açılamadı. Okunabilir, kilitsiz PDF veya görsel seçip tekrar dene. Mevcut sayfaların değişmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося відкрити файли. Виберіть доступні незаблоковані PDF або зображення й повторіть спробу. Поточні сторінки збережено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể mở các tệp. Hãy chọn PDF hoặc hình ảnh đọc được, không bị khóa, rồi thử lại. Các trang hiện tại của bạn không thay đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开文件。请选择可读取且未锁定的 PDF 或图片后重试。当前页面保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法打開檔案。請選擇可讀取、未鎖定的 PDF 或圖片，然後再試一次。你目前的頁面沒有更改。"
          }
        }
      }
    },
    "pdf_files_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر ملفات PDF أو صورًا من تطبيق الملفات. ادمج الصفحات ورتّبها ودوّرها مع معاينة مباشرة، ثم احفظ ملف PDF جديدًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg PDF'er eller billeder fra Arkiver. Kombinér, omarranger og roter sider med direkte eksempel, og gem derefter en ny PDF."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle PDFs oder Bilder aus der Dateien-App. Füge Seiten zusammen, sortiere und drehe sie mit sichtbarer Vorschau. Speichere das Ergebnis als neues PDF."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose PDFs or images from Files. Combine, reorder and rotate pages with a live preview, then save a new PDF."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige PDF o imágenes de Archivos. Combina, ordena y gira páginas con una vista previa y guarda un PDF nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez des PDF ou images dans Fichiers. Assemblez, réorganisez et pivotez les pages avec un aperçu, puis enregistrez un nouveau PDF."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih PDF atau gambar dari File. Gabungkan, atur urutan, dan putar halaman dengan pratinjau langsung, lalu simpan PDF baru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli PDF o immagini da File. Unisci, riordina e ruota le pagine con anteprima, poi salva un nuovo PDF."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルアプリからPDFや画像を選びます。プレビューを見ながらページを結合・並べ替え・回転し、新しいPDFとして保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 앱에서 PDF나 이미지를 선택하세요. 미리 보며 페이지를 합치고 순서를 바꾸거나 회전한 다음 새 PDF로 저장하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg PDF-er eller bilder fra Filer. Kombiner, endre rekkefølge og roter sider med direkte forhåndsvisning, og lagre deretter en ny PDF."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies pdf’s of afbeeldingen uit Bestanden. Voeg pagina’s samen, wijzig de volgorde en draai ze met een voorbeeld. Bewaar als nieuwe PDF."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz pliki PDF lub obrazy z aplikacji Pliki. Łącz, porządkuj i obracaj strony z podglądem, a potem zapisz nowy PDF."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha PDFs ou imagens em Arquivos. Junte, reordene e gire páginas com prévia ao vivo e salve um novo PDF."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha PDF ou imagens em Ficheiros. Combine, ordene e rode páginas com pré-visualização e guarde um novo PDF."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege PDF-uri sau imagini din Fișiere. Combină, reordonează și rotește paginile cu previzualizare, apoi salvează un PDF nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите PDF или изображения в приложении «Файлы». Объединяйте, перемещайте и поворачивайте страницы с предпросмотром, затем сохраните новый PDF."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj PDF:er eller bilder från Filer. Kombinera, ändra ordning och rotera sidor med direkt förhandsvisning och spara sedan en ny PDF."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือก PDF หรือรูปภาพจากไฟล์ รวม เรียงลำดับ และหมุนหน้าพร้อมดูตัวอย่างสด แล้วบันทึกเป็น PDF ใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyalar’dan PDF veya görsel seç. Önizlemede sayfaları birleştir, sırala ve döndür, ardından yeni PDF olarak kaydet."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть PDF або зображення у Файлах. Об’єднуйте, упорядковуйте й повертайте сторінки з переглядом, а потім збережіть новий PDF."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn PDF hoặc hình ảnh từ Tệp. Ghép, sắp xếp lại và xoay trang với bản xem trước trực tiếp, rồi lưu thành PDF mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从“文件”选择 PDF 或图片。预览时合并、排序和旋转页面，然后另存为新的 PDF。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從「檔案」選擇 PDF 或圖片。透過即時預覽合併、重新排序和旋轉頁面，然後儲存為新的 PDF。"
          }
        }
      }
    },
    "pdf_files_large": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر ملفات أقل أو أصغر (حتى 100 م.ب للملف، و256 م.ب للاختيار، و500 صفحة)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg færre eller mindre filer (op til 100 MB pr. fil, 256 MB pr. valg og 500 sider)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle weniger oder kleinere Dateien (bis 100 MB pro Datei, 256 MB pro Auswahl und 500 Seiten)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose fewer or smaller files (up to 100 MB per file, 256 MB per selection and 500 pages)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige menos archivos o más pequeños (hasta 100 MB por archivo, 256 MB por selección y 500 páginas)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez moins de fichiers ou des fichiers plus petits (100 Mo par fichier, 256 Mo par sélection et 500 pages maximum)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih file yang lebih sedikit atau lebih kecil (hingga 100 MB per file, 256 MB per pilihan, dan 500 halaman)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli meno file o file più piccoli (massimo 100 MB per file, 256 MB per selezione e 500 pagine)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイル数やサイズを減らしてください（1ファイル100 MB、1回の選択256 MB、500ページまで）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 수나 크기를 줄이세요(파일당 100 MB, 선택당 256 MB, 최대 500페이지)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg færre eller mindre filer (opptil 100 MB per fil, 256 MB per utvalg og 500 sider)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies minder of kleinere bestanden (maximaal 100 MB per bestand, 256 MB per selectie en 500 pagina’s)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz mniej lub mniejsze pliki (do 100 MB na plik, 256 MB na wybór i 500 stron)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha menos arquivos ou arquivos menores (até 100 MB por arquivo, 256 MB por seleção e 500 páginas)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha menos ficheiros ou mais pequenos (até 100 MB por ficheiro, 256 MB por seleção e 500 páginas)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege mai puține fișiere sau fișiere mai mici (maximum 100 MB per fișier, 256 MB per selecție și 500 de pagini)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите меньше файлов или файлы меньшего размера (до 100 МБ на файл, 256 МБ на выборку и 500 страниц)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj färre eller mindre filer (upp till 100 MB per fil, 256 MB per urval och 500 sidor)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกไฟล์ให้น้อยลงหรือเล็กลง (สูงสุด 100 MB ต่อไฟล์ 256 MB ต่อการเลือก และ 500 หน้า)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha az veya küçük dosya seç (dosya başına 100 MB, seçim başına 256 MB ve 500 sayfaya kadar)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть менше файлів або менші файли (до 100 МБ на файл, 256 МБ на вибірку й 500 сторінок)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy chọn ít tệp hơn hoặc tệp nhỏ hơn (tối đa 100 MB mỗi tệp, 256 MB mỗi lựa chọn và 500 trang)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择更少或更小的文件（每个文件最多 100 MB，每次选择最多 256 MB，最多 500 页）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請選擇較少或較小的檔案（每個檔案最多 100 MB，每次選擇最多 256 MB 和 500 頁）。"
          }
        }
      }
    },
