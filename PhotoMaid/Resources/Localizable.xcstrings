    "vault_restore_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحفظ كعناصر جديدة بتاريخها وموقعها الأصليين. أما العناصر التي لا تزال في تطبيق الصور فتصبح ظاهرة مجددًا فقط عند إعادة نقلها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এগুলো তাদের মূল তারিখ ও লোকেশনসহ নতুন আইটেম হিসেবে সংরক্ষিত হয়। যে আইটেম এখনো ফটো অ্যাপে আছে, ফিরিয়ে আনলে সেগুলো শুধু আবার দৃশ্যমান হয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Es desen com a elements nous amb la data i la ubicació originals. Els elements que encara són a l’app Fotos simplement tornen a ser visibles quan els hi tornes."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uloží se jako nové položky s původním datem a polohou. Položky, které jsou stále v aplikaci Fotky, se po přesunutí zpět jednoduše znovu zobrazí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De gemmes som nye emner med deres oprindelige dato og lokalitet. Emner, der stadig ligger i appen Fotos, bliver blot synlige igen, når du flytter dem tilbage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie werden als neue Medien mit ursprünglichem Datum und Ort gespeichert. Liegt ein Medium noch in der Fotos-App, wird es beim Zurückverschieben nur wieder sichtbar."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αποθηκεύονται ως νέα στοιχεία με την αρχική ημερομηνία και τοποθεσία. Στοιχεία που υπάρχουν ακόμη στις Φωτογραφίες απλώς γίνονται ξανά ορατά όταν τα επιστρέψεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They are saved as new items with their original date and location. Items that are still in the Photos app simply become visible again when you move them back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guardan como elementos nuevos con su fecha y ubicación originales. Los elementos que siguen en la app Fotos simplemente vuelven a verse al moverlos de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne tallennetaan uusina kohteina alkuperäisellä päivällä ja sijainnilla. Kohteet, jotka ovat yhä Kuvat-apissa, tulevat yksinkertaisesti taas näkyviin, kun siirrät ne takaisin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils sont enregistrés comme nouveaux éléments avec leur date et leur lieu d’origine. Les éléments encore présents dans l’app Photos redeviennent simplement visibles quand tu les redéplaces."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તે તેમની મૂળ તારીખ અને સ્થાન સાથે નવી આઇટમ તરીકે સચવાય છે. જે આઇટમ હજી ફોટો ઍપમાં છે તે પાછી ખસેડતાં ફક્ત ફરી દેખાવા લાગે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הם נשמרים כפריטים חדשים עם התאריך והמיקום המקוריים. פריטים שעדיין נמצאים ביישום ״תמונות״ פשוט נעשים גלויים שוב כשמחזירים אותם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ये अपनी मूल तारीख और लोकेशन के साथ नए आइटम के रूप में सहेजे जाते हैं। जो आइटम अभी भी तस्वीरें ऐप में हैं, वे वापस ले जाने पर बस फिर से दिखने लगते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spremaju se kao nove stavke s izvornim datumom i lokacijom. Stavke koje su još u aplikaciji Fotografije jednostavno ponovno postaju vidljive kad ih vratiš."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Új elemekként mentődnek az eredeti dátummal és hellyel. A Fotók appban még meglévő elemek egyszerűen újra láthatóvá válnak, amikor visszahelyezed őket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Item disimpan sebagai item baru dengan tanggal dan lokasi aslinya. Item yang masih ada di app Foto hanya akan terlihat lagi saat kamu memindahkannya kembali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vengono salvati come nuovi elementi con data e luogo originali. Gli elementi ancora presenti nell’app Foto tornano semplicemente visibili quando li sposti indietro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元の日付と場所を保持したまま、新しい項目として保存されます。写真アプリにまだある項目は、戻すと再び表示されるだけです。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅವುಗಳನ್ನು ಮೂಲ ದಿನಾಂಕ ಮತ್ತು ಸ್ಥಳದೊಂದಿಗೆ ಹೊಸ ಐಟಂಗಳಾಗಿ ಉಳಿಸಲಾಗುತ್ತದೆ. ಇನ್ನೂ ಫೋಟೋಗಳು ಆ್ಯಪ್‌ನಲ್ಲಿರುವ ಐಟಂಗಳು ಮತ್ತೆ ಸರಿಸಿದಾಗ ಸುಮ್ಮನೆ ಮತ್ತೆ ಕಾಣಿಸುತ್ತವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원래 날짜와 위치를 유지한 채 새 항목으로 저장됩니다. 사진 앱에 아직 있는 항목은 다시 이동하면 다시 보이기만 합니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അവ യഥാർത്ഥ തീയതിയും ലൊക്കേഷനും സഹിതം പുതിയ ഇനങ്ങളായി സംരക്ഷിക്കുന്നു. ഇപ്പോഴും ഫോട്ടോസ് ആപ്പിലുള്ള ഇനങ്ങൾ തിരികെ നീക്കുമ്പോൾ വീണ്ടും ദൃശ്യമാകുക മാത്രം ചെയ്യും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ते त्यांच्या मूळ तारीख आणि स्थानासह नवीन आयटम म्हणून जतन होतात. जे आयटम अजून फोटो अ‍ॅपमध्ये आहेत ते परत हलवल्यावर फक्त पुन्हा दिसू लागतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ia disimpan sebagai item baharu dengan tarikh dan lokasi asal. Item yang masih dalam app Foto hanya kelihatan semula apabila anda mengalihkannya kembali."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "De lagres som nye elementer med opprinnelig dato og sted. Elementer som fortsatt ligger i Bilder-appen, blir ganske enkelt synlige igjen når du flytter dem tilbake."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ze worden bewaard als nieuwe onderdelen met hun oorspronkelijke datum en locatie. Onderdelen die nog in de Foto’s-app staan, worden bij het terugzetten gewoon weer zichtbaar."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସେଗୁଡ଼ିକ ମୂଳ ତାରିଖ ଓ ଲୋକେସନ୍ ସହ ନୂଆ ଆଇଟମ୍ ଭାବେ ସେଭ୍ ହୁଏ। ଯେଉଁ ଆଇଟମ୍ ଏବେ ବି ଫଟୋ ଆପ୍‌ରେ ଅଛି, ଫେରାଇଲେ ସେଗୁଡ଼ିକ କେବଳ ପୁଣି ଦେଖାଯାଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਆਪਣੀ ਮੂਲ ਤਾਰੀਖ਼ ਅਤੇ ਟਿਕਾਣੇ ਨਾਲ ਨਵੀਆਂ ਆਈਟਮਾਂ ਵਜੋਂ ਸੰਭਾਲੀਆਂ ਜਾਂਦੀਆਂ ਹਨ। ਜੋ ਆਈਟਮਾਂ ਹਾਲੇ ਵੀ ਫ਼ੋਟੋਆਂ ਐਪ ਵਿੱਚ ਹਨ, ਉਹ ਵਾਪਸ ਭੇਜਣ ’ਤੇ ਬੱਸ ਦੁਬਾਰਾ ਦਿਸਣ ਲੱਗਦੀਆਂ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostaną zapisane jako nowe elementy z oryginalną datą i lokalizacją. Elementy, które nadal są w aplikacji Zdjęcia, po przeniesieniu z powrotem po prostu znów będą widoczne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Eles são salvos como novos itens com a data e o local originais. Itens que ainda estão no app Fotos simplesmente voltam a aparecer quando você os devolve."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "São guardados como novos itens com a data e a localização originais. Os itens que ainda estão na app Fotografias voltam simplesmente a ficar visíveis quando os moves de volta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunt salvate ca elemente noi, cu data și locația originale. Elementele aflate încă în aplicația Poze redevin pur și simplu vizibile când le muți înapoi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Они сохраняются как новые объекты с исходными датой и местом. Объекты, которые ещё есть в «Фото», при перемещении обратно просто снова становятся видны."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Uložia sa ako nové položky s pôvodným dátumom a polohou. Položky, ktoré sú stále v aplikácii Fotky, sa po presunutí späť jednoducho znova zobrazia."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Shranijo se kot novi elementi z izvirnim datumom in lokacijo. Elementi, ki so še v aplikaciji Fotografije, ob vrnitvi preprosto spet postanejo vidni."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De sparas som nya objekt med originaldatum och originalplats. Objekt som fortfarande finns i appen Bilder blir helt enkelt synliga igen när du flyttar tillbaka dem."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அவை அசல் தேதி, இருப்பிடத்துடன் புதிய உருப்படிகளாகச் சேமிக்கப்படும். இன்னும் Photos ஆப்பில் உள்ள உருப்படிகள் திரும்ப நகர்த்தும்போது மீண்டும் தெரியும் அவ்வளவே."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అవి ఒరిజినల్ తేదీ, లొకేషన్‌తో కొత్త అంశాలుగా సేవ్ అవుతాయి. ఇంకా Photos యాప్‌లో ఉన్న అంశాలు తిరిగి తరలించినప్పుడు మళ్లీ కనిపిస్తాయి అంతే."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการจะถูกบันทึกเป็นรายการใหม่พร้อมวันที่และตำแหน่งเดิม รายการที่ยังอยู่ในแอพรูปภาพจะแค่มองเห็นได้อีกครั้งเมื่อคุณย้ายกลับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Orijinal tarih ve konumlarıyla yeni öğeler olarak kaydedilirler. Hâlâ Fotoğraflar uygulamasında olan öğeler geri taşındığında yalnızca yeniden görünür olur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Їх буде збережено як нові об’єкти з початковими датою та місцем. Об’єкти, які ще є у «Фото», під час переміщення назад просто знову стануть видимими."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ اپنی اصل تاریخ اور مقام کے ساتھ نئے آئٹمز کے طور پر محفوظ ہوتے ہیں۔ جو آئٹمز ابھی تصاویر ایپ میں ہیں، وہ واپس بھیجنے پر بس دوبارہ نظر آنے لگتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng được lưu thành mục mới với ngày và vị trí gốc. Các mục vẫn còn trong ứng dụng Ảnh chỉ đơn giản hiện lại khi bạn chuyển về."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它们将作为新项目存储，并保留原始日期和位置。仍在“照片”App 中的项目在移回时只会重新显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它們會以原始日期和位置儲存為新項目。仍在「照片」App 中的項目，移回時只會重新顯示。"
          }
        }
      }
    },
