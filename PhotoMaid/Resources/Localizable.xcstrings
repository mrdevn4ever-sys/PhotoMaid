    "edit_discard_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن يُحفظ تعديلك. يبقى الأصل كما هو."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার সম্পাদনা সংরক্ষিত হবে না। মূলটি যেমন আছে তেমনই থাকে।"
