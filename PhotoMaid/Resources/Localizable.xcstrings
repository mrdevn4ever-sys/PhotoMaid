    "ana2_waiting_after": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في الانتظار – يبدأ تلقائيًا بمجرد انتهاء «%1$@»."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অপেক্ষায় – “%1$@” শেষ হলেই নিজে থেকে শুরু হবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "En espera: començarà sola quan acabi «%1$@»."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Čeká – spustí se sama, jakmile skončí „%1$@“."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Venter – starter af sig selv, så snart “%1$@” er færdig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wartet – startet von selbst, sobald „%1$@“ fertig ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σε αναμονή – ξεκινά μόνη της μόλις ολοκληρωθεί το «%1$@»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting – starts by itself as soon as “%1$@” is done."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En espera: empieza sola en cuanto termine «%1$@»."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Odottaa – alkaa itsestään heti, kun ”%1$@” on valmis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente – démarre d’elle-même dès que « %1$@ » est terminée."
