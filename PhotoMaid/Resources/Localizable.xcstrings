    "lib_group_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المجموعة تعرض المجلدات معًا فقط. لا يُنقل شيء ولا يُنسخ، وحذف المجموعة لا يحذف أي صور."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A group only shows folders together. Nothing is moved or copied, and deleting the group deletes no photos."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A group only shows folders together. Nothing is moved or copied, and deleting the group deletes no photos."
