    "vault_import_copies_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنشأ PhotoMaid منها نسخًا أيضًا (تعديلات، مجمّعات صور، أفلام، صور GIF): %1$lld. هذه النسخ في تطبيق الصور وستبقى ظاهرة ما لم تنقلها أيضًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid hat daraus auch Kopien erstellt (Bearbeitungen, Collagen, Filme, GIFs): %1$lld. Sie liegen in der Fotos-App und bleiben sichtbar, wenn du sie nicht mit ablegst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid also made copies of them (edits, collages, movies, GIFs): %1$lld. They are in the Photos app and stay visible unless you move them too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid también creó copias a partir de ellos (ediciones, collages, películas, GIF): %1$lld. Están en la app Fotos y seguirán visibles si no las mueves también."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid en a aussi créé des copies (retouches, collages, films, GIF) : %1$lld. Elles se trouvent dans l’app Photos et restent visibles si tu ne les déplaces pas aussi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid ne ha creato anche delle copie (modifiche, collage, filmati, GIF): %1$lld. Si trovano nell’app Foto e restano visibili se non le sposti insieme."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaidはこれらからコピーも作成しています（編集、コラージュ、ムービー、GIF）：%1$lld。コピーは写真アプリにあり、一緒に移動しない限り表示されたままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid가 이 항목으로 만든 사본도 있습니다(편집, 콜라주, 동영상, GIF): %1$lld개. 사본은 사진 앱에 있으며 함께 이동하지 않으면 계속 보입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid heeft er ook kopieën van gemaakt (bewerkingen, collages, films, GIF’s): %1$lld. Die staan in de Foto’s-app en blijven zichtbaar als je ze niet mee verplaatst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid utworzył z nich także kopie (edycje, kolaże, filmy, GIF-y): %1$lld. Znajdują się w aplikacji Zdjęcia i pozostaną widoczne, jeśli ich nie przeniesiesz."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O PhotoMaid também criou cópias a partir deles (edições, colagens, filmes, GIF): %1$lld. Estão na app Fotografias e continuam visíveis se não as moveres também."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid a creat și copii din ele (editări, colaje, filme, GIF-uri): %1$lld. Se află în aplicația Poze și rămân vizibile dacă nu le muți și pe ele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid также создал из них копии (правки, коллажи, фильмы, GIF): %1$lld. Они находятся в «Фото» и останутся видны, если не переместить их тоже."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid bunlardan kopyalar da oluşturdu (düzenlemeler, kolajlar, filmler, GIF’ler): %1$lld. Kopyalar Fotoğraflar uygulamasında ve onları da taşımazsan görünür kalırlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid також створив із них копії (редагування, колажі, фільми, GIF): %1$lld. Вони є у «Фото» й залишаться видимими, якщо не перемістити їх теж."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid 还用它们创建了副本（编辑、拼贴、影片、GIF）：%1$lld。这些副本位于“照片”App 中，除非一并移动，否则仍然可见。"
          }
        }
      }
    },
    "vault_import_declined": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يحذف iOS بعضها من تطبيق الصور. لن يعرضها PhotoMaid في أي مكان آخر، لكنها لا تزال ظاهرة في تطبيق الصور. استخدم التنبيه في الأعلى للمحاولة مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige hat iOS nicht aus der Fotos-App gelöscht. PhotoMaid zeigt sie trotzdem nirgends mehr, in der Fotos-App sind sie aber noch sichtbar. Über den Hinweis oben kannst du es erneut versuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS didn’t delete some of them from the Photos app. PhotoMaid doesn’t show them anywhere else anyway, but they are still visible in the Photos app. Use the note at the top to try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS no eliminó algunos de la app Fotos. PhotoMaid ya no los muestra en ningún otro sitio, pero siguen visibles en la app Fotos. Usa el aviso de arriba para volver a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS n’en a pas supprimé certains de l’app Photos. PhotoMaid ne les affiche plus nulle part ailleurs, mais ils restent visibles dans l’app Photos. Utilise le message en haut pour réessayer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS non ne ha eliminati alcuni dall’app Foto. PhotoMaid non li mostra più da nessun’altra parte, ma sono ancora visibili nell’app Foto. Usa l’avviso in alto per riprovare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部の項目はiOSによって写真アプリから削除されませんでした。PhotoMaidでは保管庫以外に表示されませんが、写真アプリではまだ表示されます。上部のお知らせからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS가 일부 항목을 사진 앱에서 삭제하지 않았습니다. PhotoMaid에서는 금고 밖 어디에도 표시되지 않지만 사진 앱에서는 아직 보입니다. 상단의 안내에서 다시 시도할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS heeft een deel niet uit de Foto’s-app verwijderd. PhotoMaid toont ze nergens anders meer, maar in de Foto’s-app zijn ze nog zichtbaar. Gebruik de melding bovenaan om het opnieuw te proberen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS nie usunął części z nich z aplikacji Zdjęcia. PhotoMaid nie pokazuje ich już nigdzie indziej, ale w aplikacji Zdjęcia są nadal widoczne. Użyj komunikatu u góry, aby spróbować ponownie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O iOS não apagou alguns da app Fotografias. O PhotoMaid já não os mostra em mais lado nenhum, mas continuam visíveis na app Fotografias. Usa o aviso no topo para tentar novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS nu a șters unele dintre ele din aplicația Poze. PhotoMaid nu le mai afișează nicăieri altundeva, dar sunt încă vizibile în aplicația Poze. Folosește notificarea de sus pentru a încerca din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Некоторые объекты iOS не удалила из «Фото». PhotoMaid больше нигде их не показывает, но в «Фото» они всё ещё видны. Повторить можно через уведомление вверху."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS bazılarını Fotoğraflar uygulamasından silmedi. PhotoMaid onları başka hiçbir yerde göstermez ama Fotoğraflar uygulamasında hâlâ görünürler. Tekrar denemek için üstteki bildirimi kullan."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Деякі об’єкти iOS не видалила з «Фото». PhotoMaid більше ніде їх не показує, але у «Фото» вони ще видимі. Повторити можна через сповіщення вгорі."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 未从“照片”App 中删除其中部分项目。PhotoMaid 不会在其他任何地方显示它们，但它们在“照片”App 中仍然可见。可通过顶部的提示重试。"
          }
        }
      }
    },
    "vault_import_done": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في الخزنة: %1$lld. أُزيلت من تطبيق الصور: %2$lld."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Tresor: %1$lld. Aus der Fotos-App entfernt: %2$lld."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the vault: %1$lld. Removed from the Photos app: %2$lld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la caja fuerte: %1$lld. Quitados de la app Fotos: %2$lld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans le coffre-fort : %1$lld. Retirés de l’app Photos : %2$lld."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nella cassaforte: %1$lld. Rimossi dall’app Foto: %2$lld."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保管庫に追加：%1$lld。写真アプリから削除：%2$lld。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "금고에 추가: %1$lld개. 사진 앱에서 제거: %2$lld개."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In de kluis: %1$lld. Verwijderd uit de Foto’s-app: %2$lld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W sejfie: %1$lld. Usunięte z aplikacji Zdjęcia: %2$lld."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
