        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudରେ ଷ୍ଟୋର୍ ହୋଇଥିବା ଫଟୋ ଆବଶ୍ୟକ ହେଲେ ଲୋଡ୍ ହୁଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ਵਿੱਚ ਸਟੋਰ ਫ਼ੋਟੋਆਂ ਲੋੜ ਪੈਣ ’ਤੇ ਲੋਡ ਹੁੰਦੀਆਂ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdjęcia z iCloud są pobierane w razie potrzeby."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos guardadas no iCloud são carregadas quando necessário."
          }
        },
        "pt-PT": {
