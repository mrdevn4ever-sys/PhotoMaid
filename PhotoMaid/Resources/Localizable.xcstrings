    "picker_no_date_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن يعود تلقائيًا. ستجده في «لاحقًا › مؤجَّلة»."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি নিজে থেকে ফিরে আসবে না। পরে › আলাদা রাখা-তে খুঁজে পাবেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No tornarà sola. La trobaràs a Més tard › Apartats."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo se nevrátí. Najdete to v Později › Odloženo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det kommer ikke tilbage af sig selv. Du finder det under Senere › Lagt til side."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kommt nicht von selbst zurück. Du findest es unter Später › Beiseitegelegt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν θα επιστρέψει μόνο του. Θα το βρεις στο Αργότερα › Στην άκρη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It won’t come back on its own. You’ll find it under Later › Set aside."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No volverá por sí solo. Lo encontrarás en Después › Apartados."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ei palaa itsestään. Löydät sen kohdasta Myöhemmin › Syrjässä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne reviendra pas tout seul. Tu le retrouveras dans Plus tard › Mis de côté."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તે આપમેળે પાછું નહીં આવે. તે “પછી › બાજુએ રાખેલા” માં મળશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זה לא יחזור מעצמו. אפשר למצוא אותו תחת מאוחר יותר › בצד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह अपने-आप वापस नहीं आएगा। यह “बाद में › अलग रखे” में मिलेगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neće se sama vratiti. Pronaći ćeš je pod Kasnije › Odloženo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Magától nem jön vissza. A Később › Félretéve alatt találod."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Item ini tidak akan kembali sendiri. Kamu akan menemukannya di Nanti › Disisihkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non tornerà da solo. Lo trovi in Più tardi › Messi da parte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動では戻りません。「あとで › 保留中」にあります。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇದು ತಾನಾಗಿಯೇ ಹಿಂತಿರುಗುವುದಿಲ್ಲ. ನಂತರ › ಪಕ್ಕಕ್ಕಿಟ್ಟವು ಅಡಿಯಲ್ಲಿ ಸಿಗುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저절로 다시 나타나지 않아요. ‘나중에 › 따로 둠’에서 찾을 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇത് സ്വയം തിരിച്ചുവരില്ല. പിന്നീട് › മാറ്റിവച്ചവ എന്നതിൽ കണ്ടെത്താം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हे आपोआप परत येणार नाही. ते “नंतर › बाजूला ठेवलेले” मध्ये सापडेल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ia tidak akan kembali sendiri. Anda akan menemuinya di bawah Nanti › Diketepikan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det kommer ikke tilbake av seg selv. Du finner det under Senere › Lagt til side."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Komt niet vanzelf terug. Je vindt het onder Later › Opzijgelegd."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହା ନିଜେ ଫେରିବ ନାହିଁ। ଆପଣ ଏହାକୁ ପରେ › ଅଲଗା ରଖାଯାଇଥିବାରେ ପାଇବେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਆਪਣੇ-ਆਪ ਵਾਪਸ ਨਹੀਂ ਆਵੇਗੀ। ਤੁਸੀਂ ਇਸ ਨੂੰ ਬਾਅਦ ਵਿੱਚ › ਵੱਖ ਰੱਖੇ ਹੇਠ ਲੱਭੋਗੇ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie wróci samo. Znajdziesz je w Później › Odłożone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não volta sozinho. Você o encontra em Depois › Deixados de lado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não volta sozinho. Encontra-o em Mais tarde › Postos de parte."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu revine singur. Îl găsești la Mai târziu › Puse deoparte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Само не вернётся. Найдёшь в «Позже › Отложено»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo sa nevráti. Nájdete to v Neskôr › Odložené."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sama se ne bo vrnila. Najdeš jo pod Pozneje › Odloženo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den kommer inte tillbaka av sig själv. Du hittar den under Senare › Undanlagt."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இது தானாகத் திரும்பாது. பிறகு › ஒதுக்கப்பட்டவை பகுதியில் கண்டறியலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇది తనంతట తానే తిరిగి రాదు. తర్వాత › పక్కన పెట్టినవిలో కనుగొంటారు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการนี้จะไม่กลับมาเอง คุณจะพบได้ใน ไว้ทีหลัง › แยกไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendiliğinden geri gelmez. Sonra › Ayrılanlar bölümünde bulursun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Саме не повернеться. Знайдеш у «Пізніше › Відкладено»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ خود واپس نہیں آئے گا۔ یہ ”بعد میں › الگ رکھے“ میں ملے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
