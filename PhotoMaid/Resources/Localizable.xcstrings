    "feed_icloud_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوجد على هذا الـ iPhone معاينة صغيرة فقط. نزّل الأصل لعرضه كاملًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun et lille eksempel er gemt på denne iPhone. Hent originalen for at se den helt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem iPhone ist nur eine kleine Vorschau gespeichert. Lade das Original, um es groß anzusehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only a small preview is stored on this iPhone. Download the original to see it in full."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En este iPhone solo hay una vista previa pequeña. Descarga el original para verlo completo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul un petit aperçu est stocké sur cet iPhone. Téléchargez l’original pour le voir en grand."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya pratinjau kecil yang tersimpan di iPhone ini. Unduh aslinya untuk melihatnya utuh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su questo iPhone c’è solo un’anteprima piccola. Scarica l’originale per vederlo per intero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPhoneには小さなプレビューしかありません。大きく見るにはオリジナルを読み込んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone에는 작은 미리보기만 있습니다. 크게 보려면 원본을 다운로드하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare en liten forhåndsvisning er lagret på denne iPhonen. Last ned originalen for å se den i sin helhet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op deze iPhone staat alleen een kleine voorvertoning. Download het origineel om het groot te bekijken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na tym iPhonie jest tylko mały podgląd. Pobierz oryginał, aby zobaczyć go w całości."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só uma pequena prévia está guardada neste iPhone. Baixe o original para vê-lo completo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Neste iPhone existe apenas uma pré-visualização pequena. Descarregue o original para o ver por inteiro."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pe acest iPhone există doar o previzualizare mică. Descarcă originalul pentru a-l vedea mare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом iPhone хранится только маленькое превью. Загрузите оригинал, чтобы увидеть его полностью."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara en liten förhandsvisning finns på den här iPhonen. Hämta originalet för att se det helt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีเพียงภาพตัวอย่างขนาดเล็กบน iPhone เครื่องนี้ ดาวน์โหลดต้นฉบับเพื่อดูแบบเต็ม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu iPhone’da yalnızca küçük bir önizleme var. Tam görmek için orijinali indir."
          }
