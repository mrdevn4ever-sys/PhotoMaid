    "ana2_queue_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يُلغى التحليل الجاري أبدًا: «تشغيل هذا أولًا» يوقفه مؤقتًا فقط، ثم يستأنف من تلقاء نفسه."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En igangværende analyse annulleres aldrig: “Kør denne først” sætter den kun på pause, og den fortsætter derefter af sig selv."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die laufende Analyse wird nicht abgebrochen: „Jetzt zuerst“ hält sie nur an, danach läuft sie von selbst weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The running analysis is never cancelled: “Run this first” only pauses it, and it continues by itself afterwards."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El análisis en curso nunca se cancela: «Primero esta» solo lo pausa y después continúa solo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’analyse en cours n’est jamais annulée : « D’abord celle-ci » la met seulement en pause, puis elle reprend d’elle-même."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Analisis yang berjalan tidak pernah dibatalkan: “Jalankan ini dulu” hanya menjedanya, lalu analisis berlanjut sendiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’analisi in corso non viene mai annullata: «Prima questa» la mette solo in pausa, poi riprende da sola."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行中の分析は中止されません。「先にこれを実行」は一時停止するだけで、その後自動で再開します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진행 중인 분석은 취소되지 않아요. ‘이것 먼저’는 잠시 멈출 뿐이고 이후 자동으로 이어져요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En pågående analyse avbrytes aldri: «Kjør denne først» setter den bare på pause, og den fortsetter av seg selv etterpå."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De lopende analyse wordt nooit afgebroken: ‘Eerst deze’ pauzeert hem alleen, daarna gaat hij vanzelf verder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trwająca analiza nigdy nie jest przerywana: „Najpierw ta” tylko ją wstrzymuje, potem wznowi się sama."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A análise em andamento nunca é cancelada: “Executar esta primeiro” apenas a pausa, e ela continua sozinha depois."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A análise em curso nunca é cancelada: «Primeiro esta» apenas a pausa e depois continua sozinha."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiza în curs nu este anulată niciodată: „Mai întâi aceasta” doar o întrerupe, apoi continuă singură."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текущий анализ никогда не отменяется: «Сначала эту» лишь приостанавливает его, потом он продолжится сам."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En pågående analys avbryts aldrig: ”Kör den här först” pausar den bara, och den fortsätter sedan av sig själv."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การวิเคราะห์ที่กำลังทำอยู่จะไม่ถูกยกเลิก: “ทำอันนี้ก่อน” แค่หยุดไว้ชั่วคราว แล้วจะทำต่อเองภายหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalışan analiz asla iptal edilmez: “Önce bunu” onu yalnızca duraklatır, sonra kendiliğinden devam eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поточний аналіз ніколи не скасовується: «Спершу цей» лише призупиняє його, потім він продовжиться сам."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phân tích đang chạy không bao giờ bị hủy: “Chạy cái này trước” chỉ tạm dừng nó, sau đó nó tự tiếp tục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在进行的分析不会被取消：“先运行这个”只会暂停它，之后它会自动继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "進行中的分析永遠不會取消：「先執行這項」只會暫停它，之後它會自動繼續。"
          }
        }
      }
    },
