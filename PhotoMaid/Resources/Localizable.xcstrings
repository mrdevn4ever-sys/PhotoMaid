    "art_pause_intro": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خذ نفسًا. صورك تشاركك اللعب."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træk vejret. Dine fotos spiller med."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durchatmen. Deine Fotos spielen mit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take a breath. Your photos play along."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Respira. Tus fotos también juegan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Respire. Tes photos jouent avec toi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarik napas. Fotomu ikut bermain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Respira. Le tue foto giocano con te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ひと息つこう。写真も一緒に遊びます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠시 숨을 돌려요. 내 사진도 함께해요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Pust ut. Bildene dine er med."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Even ademhalen. Je foto’s spelen mee."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odetchnij. Twoje zdjęcia grają z Tobą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Respire fundo. Suas fotos entram no jogo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Respira. As tuas fotos também jogam."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Respiră. Fotografiile tale se joacă și ele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Передохни. Твои фото играют вместе с тобой."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Andas ut. Dina bilder spelar med."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หายใจลึกๆ ให้รูปภาพของคุณมาเล่นด้วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir nefes al. Fotoğrafların da oyunda."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перепочинь. Твої фото граються разом із тобою."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hít thở sâu. Ảnh của bạn cùng chơi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放松一下，你的照片也来一起玩。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "深呼吸。讓你的照片陪你玩。"
          }
        }
      }
    },
