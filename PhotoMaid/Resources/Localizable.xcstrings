    "ana2_swipe_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لأعلى للاحتفاظ، ولليسار لسلة المهملات، ولليمين للعرض لاحقًا. اضغط على صورة للبدء منها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "উপরে রাখে, বাঁয়ে ট্র্যাশে পাঠায়, ডানে পরে আবার দেখায়। যেখান থেকে শুরু করতে চান সেই ফটোতে ট্যাপ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Amunt conserva, a l’esquerra a la paperera, a la dreta torna més tard. Toca una foto per començar per ella."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahoru ponechá, doleva do koše, doprava se zobrazí později. Klepnutím na fotku začnete u ní."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Op beholder, venstre flytter til papirkurven, højre viser det igen senere. Tryk på et foto for at starte der."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoch behält, links legt in den Papierkorb, rechts zeigt es später wieder. Tipp auf ein Foto startet dort."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάνω διατήρηση, αριστερά στον κάδο, δεξιά εμφανίζεται ξανά αργότερα. Πάτησε μια φωτογραφία για να ξεκινήσεις από εκεί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Up keeps, left moves to trash, right shows it again later. Tap a photo to start there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arriba conserva, a la izquierda va a la papelera y a la derecha vuelve más tarde. Toca una foto para empezar ahí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ylös säilyttää, vasemmalle roskakoriin, oikealle näytetään myöhemmin. Napauta kuvaa aloittaaksesi siitä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Haut pour garder, gauche pour la corbeille, droite pour plus tard. Touche une photo pour commencer là."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઉપર રાખે છે, ડાબે ટ્રેશમાં, જમણે પછી ફરી બતાવે છે. ત્યાંથી શરૂ કરવા કોઈ ફોટા પર ટૅપ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "למעלה – שמירה, שמאלה – לפח, ימינה – יוצג שוב מאוחר יותר. אפשר להקיש על תמונה כדי להתחיל ממנה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऊपर रखता है, बाएँ ट्रैश में, दाएँ बाद में फिर दिखाता है। वहीं से शुरू करने के लिए किसी फ़ोटो पर टैप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gore zadržava, lijevo u smeće, desno se prikazuje kasnije. Dodirni fotografiju da kreneš od nje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Fel: megtartás, balra: kuka, jobbra: később újra. Koppints egy fotóra, hogy onnan kezdd."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ke atas menyimpan, ke kiri memindahkan ke sampah, ke kanan menampilkannya lagi nanti. Ketuk foto untuk mulai dari situ."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su per conservare, a sinistra nel cestino, a destra per più tardi. Tocca una foto per iniziare da lì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上で残す、左でゴミ箱、右であとで表示。写真をタップするとそこから始めます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮೇಲೆ ಇರಿಸುತ್ತದೆ, ಎಡಕ್ಕೆ ಕಸದ ಬುಟ್ಟಿಗೆ ಸರಿಸುತ್ತದೆ, ಬಲಕ್ಕೆ ನಂತರ ಮತ್ತೆ ತೋರಿಸುತ್ತದೆ. ಅಲ್ಲಿಂದ ಪ್ರಾರಂಭಿಸಲು ಫೋಟೋವನ್ನು ಟ್ಯಾಪ್ ಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위는 보관, 왼쪽은 휴지통, 오른쪽은 나중에 다시 보기예요. 사진을 탭하면 거기서 시작해요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മുകളിലേക്ക് സൂക്ഷിക്കുന്നു, ഇടത്തേക്ക് ട്രാഷിലേക്ക് നീക്കുന്നു, വലത്തേക്ക് പിന്നീട് വീണ്ടും കാണിക്കുന്നു. അവിടെ നിന്ന് ആരംഭിക്കാൻ ഒരു ഫോട്ടോ ടാപ്പ് ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "वर ठेवते, डावीकडे ट्रॅशमध्ये, उजवीकडे नंतर पुन्हा दाखवते. तिथून सुरू करण्यासाठी फोटोवर टॅप करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Atas simpan, kiri ke sampah, kanan tunjuk semula nanti. Ketik foto untuk bermula di situ."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opp beholder, venstre flytter til papirkurven, høyre viser det igjen senere. Trykk på et bilde for å starte der."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omhoog bewaart, links naar de prullenbak, rechts voor later. Tik op een foto om daar te beginnen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଉପରକୁ ରଖେ, ବାମକୁ ଟ୍ରାସକୁ ଘୁଞ୍ଚାଏ, ଡାହାଣକୁ ପରେ ପୁଣି ଦେଖାଏ। ସେଠାରୁ ଆରମ୍ଭ କରିବାକୁ ଏକ ଫଟୋରେ ଟାପ୍ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਉੱਪਰ ਰੱਖਦਾ ਹੈ, ਖੱਬੇ ਰੱਦੀ ਵਿੱਚ, ਸੱਜੇ ਬਾਅਦ ਵਿੱਚ ਦੁਬਾਰਾ ਦਿਖਾਉਂਦਾ ਹੈ। ਉੱਥੋਂ ਸ਼ੁਰੂ ਕਰਨ ਲਈ ਕਿਸੇ ਫ਼ੋਟੋ ਉੱਤੇ ਟੈਪ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W górę zachowuje, w lewo do kosza, w prawo na później. Stuknij zdjęcie, aby zacząć od niego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para cima mantém, para a esquerda vai para a lixeira, para a direita mostra de novo depois. Toque numa foto para começar por ela."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para cima mantém, para a esquerda vai para o lixo, para a direita volta mais tarde. Toca numa fotografia para começar aí."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În sus păstrează, la stânga în coș, la dreapta pentru mai târziu. Atinge o fotografie ca să începi de acolo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вверх — оставить, влево — в корзину, вправо — на потом. Нажми на фото, чтобы начать с него."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahor ponechá, doľava do koša, doprava sa zobrazí neskôr. Klepnutím na fotku začnete pri nej."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gor obdrži, levo v koš, desno se prikaže pozneje. Tapni fotografijo, da začneš pri njej."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Upp behåller, vänster flyttar till papperskorgen, höger visar den igen senare. Tryck på en bild för att börja där."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மேலே வைத்திருக்கும், இடப்புறம் குப்பைக்கு நகர்த்தும், வலப்புறம் பிறகு மீண்டும் காட்டும். அங்கிருந்து தொடங்க ஒரு புகைப்படத்தைத் தட்டுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పైకి ఉంచుతుంది, ఎడమకు ట్రాష్‌కి తరలిస్తుంది, కుడికి తర్వాత మళ్లీ చూపిస్తుంది. అక్కడి నుండి ప్రారంభించడానికి ఒక ఫోటోను ట్యాప్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปัดขึ้นเพื่อเก็บไว้ ปัดซ้ายเพื่อย้ายไปถังขยะ ปัดขวาเพื่อแสดงอีกครั้งภายหลัง แตะรูปเพื่อเริ่มจากตรงนั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yukarı saklar, sol çöp kutusuna atar, sağ sonra tekrar gösterir. Oradan başlamak için bir fotoğrafa dokun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вгору — залишити, ліворуч — у кошик, праворуч — на потім. Торкнися фото, щоб почати з нього."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اوپر رکھتا ہے، بائیں ردی میں، دائیں بعد میں دوبارہ دکھاتا ہے۔ وہیں سے شروع کرنے کے لیے کسی تصویر پر ٹیپ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lên để giữ, trái để chuyển vào thùng rác, phải để xem lại sau. Chạm vào một ảnh để bắt đầu từ đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向上保留，向左放入回收站，向右稍后再看。点按一张照片即可从这里开始。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上滑保留，左滑移到垃圾桶，右滑稍後再顯示。點一下照片即可從那裡開始。"
          }
        }
      }
    },
    "ana2_swipe_hint_similar": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على مجموعة لمقارنتها، أو تصفّحها كلها واحدة تلو الأخرى بالسحب."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তুলনা করতে কোনো গ্রুপে ট্যাপ করুন – অথবা একে একে সবগুলো সোয়াইপ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un grup per comparar-lo, o llisca per tots un rere l’altre."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na skupinu ji porovnáte – nebo je přejetím projděte všechny postupně."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på en gruppe for at sammenligne den – eller swipe igennem dem alle efter hinanden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipp auf eine Gruppe zum Vergleichen – oder alle nacheinander durchwischen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάτησε μια ομάδα για σύγκριση – ή σύρε μέσα από όλες τη μία μετά την άλλη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a group to compare it – or swipe through all of them one after another."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un grupo para compararlo o repásalos todos seguidos deslizando."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta ryhmää verrataksesi – tai pyyhkäise kaikki läpi yksi kerrallaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche un groupe pour le comparer – ou parcours-les tous à la suite."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સરખામણી માટે જૂથ પર ટૅપ કરો – અથવા બધા પર એક પછી એક સ્વાઇપ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר להקיש על קבוצה כדי להשוות – או להחליק על כולן אחת אחרי השנייה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तुलना के लिए किसी समूह पर टैप करें – या सब पर एक-एक करके स्वाइप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirni grupu da je usporediš – ili ih povlačenjem prođi sve redom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints egy csoportra az összehasonlításhoz – vagy húzd végig mindet egymás után."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk grup untuk membandingkannya – atau geser semuanya satu per satu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca un gruppo per confrontarlo, oppure scorrili tutti uno dopo l’altro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループをタップして比較するか、すべてを順にスワイプで確認します。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಹೋಲಿಸಲು ಗುಂಪನ್ನು ಟ್ಯಾಪ್ ಮಾಡಿ – ಅಥವಾ ಎಲ್ಲವನ್ನೂ ಒಂದರ ನಂತರ ಒಂದರಂತೆ ಸ್ವೈಪ್ ಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그룹을 탭해 비교하거나 전체를 차례로 스와이프해 정리하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "താരതമ്യം ചെയ്യാൻ ഒരു ഗ്രൂപ്പ് ടാപ്പ് ചെയ്യുക – അല്ലെങ്കിൽ എല്ലാം ഒന്നിനുപുറകെ ഒന്നായി സ്വൈപ്പ് ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुलनेसाठी गटावर टॅप करा – किंवा सर्वांवर एकामागून एक स्वाइप करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik kumpulan untuk membandingkannya – atau leret semuanya satu demi satu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på en gruppe for å sammenligne den – eller sveip gjennom alle etter hverandre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op een groep om te vergelijken – of veeg ze allemaal na elkaar door."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ତୁଳନା କରିବାକୁ ଏକ ଗ୍ରୁପ୍‌ରେ ଟାପ୍ କରନ୍ତୁ – କିମ୍ବା ସବୁକୁ ଗୋଟିଏ ପରେ ଗୋଟିଏ ସ୍ୱାଇପ୍ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਲਨਾ ਲਈ ਕਿਸੇ ਸਮੂਹ ਉੱਤੇ ਟੈਪ ਕਰੋ – ਜਾਂ ਸਾਰਿਆਂ ਉੱਤੇ ਇੱਕ-ਇੱਕ ਕਰਕੇ ਸਵਾਈਪ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij grupę, aby ją porównać – albo przejrzyj wszystkie po kolei gestami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque num grupo para compará-lo – ou deslize por todos, um após o outro."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca num grupo para o comparar – ou revê todos seguidos a deslizar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge un grup pentru comparare – sau parcurge-le pe toate, unul după altul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажми на группу, чтобы сравнить, – или пролистай все подряд."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na skupinu ju porovnáte – alebo ich potiahnutím prejdite všetky postupne."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapni skupino, da jo primerjaš – ali pa podrsaj skozi vse po vrsti."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på en grupp för att jämföra den – eller svep igenom alla i tur och ordning."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒப்பிட ஒரு குழுவைத் தட்டுங்கள் – அல்லது அனைத்தையும் ஒன்றன்பின் ஒன்றாக ஸ்வைப் செய்யுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పోల్చడానికి ఒక గ్రూప్‌ను ట్యాప్ చేయండి – లేదా అన్నింటినీ ఒకదాని తర్వాత ఒకటి స్వైప్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะกลุ่มเพื่อเปรียบเทียบ – หรือปัดดูทั้งหมดทีละกลุ่ม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karşılaştırmak için bir gruba dokun – ya da hepsini sırayla kaydırarak geç."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкнися групи, щоб порівняти, – або перегорни всі поспіль."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "موازنے کے لیے کسی گروپ پر ٹیپ کریں – یا سب پر ایک ایک کر کے سوائپ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm vào một nhóm để so sánh – hoặc vuốt qua tất cả lần lượt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按一组进行比较，或依次滑动整理全部。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下群組即可比較 – 或依序滑動瀏覽全部。"
          }
        }
      }
    },
