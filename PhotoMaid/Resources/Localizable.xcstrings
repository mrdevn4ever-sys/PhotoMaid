    "dup_footer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حجم النسخ المحددة: حتى %1$@. قد لا يساوي ذلك المساحة التي تتحرر. راجع المفضلة والألبومات والتعديلات قبل إزالة النسخ."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নির্বাচিত কপি: সর্বোচ্চ %1$@। এটি খালি হওয়া জায়গার সমান নাও হতে পারে। কপি সরানোর আগে পছন্দের, অ্যালবাম ও সম্পাদনা দেখে নিন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Còpies seleccionades: fins a %1$@. Pot no coincidir amb l’espai alliberat. Revisa els preferits, els àlbums i les edicions abans d’eliminar còpies."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vybrané kopie: až %1$@. Nemusí to odpovídat uvolněnému místu. Před odstraněním kopií zkontrolujte oblíbené, alba a úpravy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgte kopier: op til %1$@. Det svarer ikke nødvendigvis til den frigjorte plads. Tjek favoritter, albummer og redigeringer, før du fjerner kopier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgewählte Kopien: bis zu %1$@. Das ist nicht unbedingt der Speicher, der frei wird. Prüfe auch Favoriten, Alben und Bearbeitungen, bevor du Kopien entfernst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλεγμένα αντίγραφα: έως %1$@. Ίσως να μην ισούται με τον χώρο που ελευθερώνεται. Έλεγξε αγαπημένα, άλμπουμ και επεξεργασίες πριν αφαιρέσεις αντίγραφα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected copies: up to %1$@. This may not equal the space freed. Check favorites, albums and edits before removing copies."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copias seleccionadas: hasta %1$@. Puede no coincidir con el espacio que se libera. Revisa también favoritos, álbumes y ediciones antes de quitar copias."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitut kopiot: enintään %1$@. Määrä ei välttämättä vastaa vapautuvaa tilaa. Tarkista suosikit, albumit ja muokkaukset ennen kopioiden poistamista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copies sélectionnées : jusqu’à %1$@. L’espace libéré peut être différent. Vérifie aussi les favoris, albums et retouches avant de retirer des copies."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પસંદ કરેલી નકલો: %1$@ સુધી. આ ખાલી થતી જગ્યા જેટલું ન પણ હોય. નકલો દૂર કરતાં પહેલાં મનપસંદ, આલ્બમ અને ફેરફારો તપાસો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עותקים שנבחרו: עד %1$@. ייתכן שזה לא שווה למקום שיתפנה. כדאי לבדוק מועדפים, אלבומים ועריכות לפני הסרת עותקים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुनी गई कॉपी: %1$@ तक। यह खाली हुई जगह के बराबर न भी हो। कॉपी हटाने से पहले पसंदीदा, एल्बम और एडिट जाँच लें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odabrane kopije: do %1$@. To ne mora biti jednako oslobođenom prostoru. Prije uklanjanja kopija provjeri omiljene stavke, albume i izmjene."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kijelölt másolatok: legfeljebb %1$@. Ez eltérhet a felszabaduló helytől. Másolatok eltávolítása előtt ellenőrizd a kedvenceket, albumokat és szerkesztéseket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Salinan terpilih: hingga %1$@. Ini belum tentu sama dengan ruang yang dikosongkan. Periksa favorit, album, dan hasil edit sebelum menghapus salinan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie selezionate: fino a %1$@. Lo spazio liberato potrebbe essere diverso. Controlla anche preferiti, album e modifiche prima di rimuovere le copie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選んだコピー：最大%1$@。実際に空く容量とは異なる場合があります。削除する前に、お気に入り、アルバム、編集内容を確認してください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆಯ್ಕೆಮಾಡಿದ ಪ್ರತಿಗಳು: %1$@ ವರೆಗೆ. ಇದು ಮುಕ್ತವಾಗುವ ಸ್ಥಳಕ್ಕೆ ಸಮನಾಗದಿರಬಹುದು. ಪ್ರತಿಗಳನ್ನು ತೆಗೆದುಹಾಕುವ ಮೊದಲು ಮೆಚ್ಚಿನವು, ಆಲ್ಬಮ್‌ಗಳು ಮತ್ತು ಎಡಿಟ್‌ಗಳನ್ನು ಪರಿಶೀಲಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 사본: 최대 %1$@. 실제로 확보되는 공간은 다를 수 있어요. 사본을 삭제하기 전에 즐겨찾기, 앨범, 편집 내용을 확인하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "തിരഞ്ഞെടുത്ത പകർപ്പുകൾ: %1$@ വരെ. ഇത് ഒഴിവാകുന്ന സ്ഥലത്തിന് തുല്യമാകണമെന്നില്ല. പകർപ്പുകൾ നീക്കം ചെയ്യുന്നതിന് മുമ്പ് പ്രിയപ്പെട്ടവ, ആൽബങ്ങൾ, എഡിറ്റുകൾ എന്നിവ പരിശോധിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "निवडलेल्या प्रती: %1$@ पर्यंत. हे मोकळ्या झालेल्या जागेइतके नसू शकते. प्रती काढण्यापूर्वी आवडते, अल्बम आणि संपादने तपासा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Salinan dipilih: sehingga %1$@. Ini mungkin tidak sama dengan ruang yang dikosongkan. Semak kegemaran, album dan suntingan sebelum membuang salinan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgte kopier: opptil %1$@. Dette tilsvarer ikke nødvendigvis frigjort plass. Sjekk favoritter, album og redigeringer før du fjerner kopier."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geselecteerde kopieën: maximaal %1$@. De vrijgekomen ruimte kan hiervan afwijken. Controleer ook favorieten, albums en bewerkingen voordat je kopieën verwijdert."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ବଛାଯାଇଥିବା କପି: %1$@ ପର୍ଯ୍ୟନ୍ତ। ଏହା ଖାଲି ହେଉଥିବା ସ୍ଥାନ ସହ ସମାନ ନହୋଇପାରେ। କପି ହଟାଇବା ପୂର୍ବରୁ ପସନ୍ଦର, ଆଲବମ୍ ଓ ଏଡିଟ୍ ଯାଞ୍ଚ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਚੁਣੀਆਂ ਕਾਪੀਆਂ: %1$@ ਤੱਕ। ਇਹ ਖਾਲੀ ਹੋਈ ਥਾਂ ਦੇ ਬਰਾਬਰ ਨਾ ਵੀ ਹੋਵੇ। ਕਾਪੀਆਂ ਹਟਾਉਣ ਤੋਂ ਪਹਿਲਾਂ ਮਨਪਸੰਦ, ਐਲਬਮਾਂ ਅਤੇ ਸੋਧਾਂ ਜਾਂਚੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybrane kopie: do %1$@. Zwolnione miejsce może mieć inną wielkość. Przed usunięciem kopii sprawdź też ulubione, albumy i edycje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cópias selecionadas: até %1$@. Isso pode não ser igual ao espaço liberado. Confira favoritos, álbuns e edições antes de remover cópias."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cópias selecionadas: até %1$@. O espaço libertado pode ser diferente. Verifica também favoritos, álbuns e edições antes de remover cópias."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Copii selectate: până la %1$@. Spațiul eliberat poate fi diferit. Verifică și favoritele, albumele și editările înainte de a elimina copii."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбранные копии: до %1$@. Объём свободного места может увеличиться на другую величину. Перед удалением копий проверь также избранное, альбомы и правки."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vybraté kópie: až %1$@. Nemusí to zodpovedať uvoľnenému miestu. Pred odstránením kópií skontrolujte obľúbené, albumy a úpravy."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izbrane kopije: do %1$@. To ni nujno enako sproščenemu prostoru. Pred odstranjevanjem kopij preveri priljubljene, albume in urejanja."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Valda kopior: upp till %1$@. Det motsvarar inte nödvändigtvis frigjort utrymme. Kontrollera favoriter, album och redigeringar innan du tar bort kopior."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தேர்ந்தெடுத்த நகல்கள்: %1$@ வரை. இது காலியாகும் இடத்திற்குச் சமமாக இருக்காமல் போகலாம். நகல்களை அகற்றும் முன் பிடித்தவை, ஆல்பங்கள், திருத்தங்களைச் சரிபாருங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఎంచుకున్న కాపీలు: %1$@ వరకు. ఇది ఖాళీ అయ్యే స్థలానికి సమానం కాకపోవచ్చు. కాపీలను తీసివేసే ముందు ఇష్టమైనవి, ఆల్బమ్‌లు, ఎడిట్‌లను తనిఖీ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สำเนาที่เลือก: สูงสุด %1$@ อาจไม่เท่ากับพื้นที่ที่ว่างขึ้น ตรวจสอบรายการโปรด อัลบั้ม และการแก้ไขก่อนนำสำเนาออก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen kopyalar: en fazla %1$@. Açılacak alan bundan farklı olabilir. Kopyaları kaldırmadan önce favorileri, albümleri ve düzenlemeleri de kontrol et."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибрані копії: до %1$@. Звільнене місце може мати інший обсяг. Перед видаленням копій перевір також обране, альбоми й редагування."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "منتخب کاپیاں: %1$@ تک۔ یہ خالی ہونے والی جگہ کے برابر نہ بھی ہو۔ کاپیاں ہٹانے سے پہلے پسندیدہ، البمز اور ترامیم چیک کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản sao đã chọn: tối đa %1$@. Con số này có thể khác với dung lượng được giải phóng. Hãy kiểm tra mục ưa thích, album và bản chỉnh sửa trước khi xóa bản sao."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已选副本最多 %1$@，不一定等于实际释放的空间。移除副本前，请检查收藏、相册和编辑内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已選副本：最多 %1$@。這不一定等於釋放的空間。移除副本前請檢查個人收藏、相簿和編輯。"
          }
        }
      }
    },
    "dup_header": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملفات متطابقة: %1$lld · الإجمالي %2$@"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অভিন্ন ফাইল: %1$lld · মোট %2$@"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fitxers idèntics: %1$lld · %2$@ en total"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Identické soubory: %1$lld · celkem %2$@"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Identiske filer: %1$lld · %2$@ i alt"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Identische Dateien: %1$lld · insgesamt %2$@"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πανομοιότυπα αρχεία: %1$lld · συνολικά %2$@"
          }
        },
