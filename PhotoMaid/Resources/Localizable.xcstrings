    "onb_access_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض PhotoMaid صورك وفيديوهاتك على جهازك مباشرةً لتنظيفها. بلا حساب أو خادم PhotoMaid."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit du aufräumen kannst, zeigt PhotoMaid deine Fotos und Videos direkt auf deinem Gerät. Ohne PhotoMaid-Konto und ohne PhotoMaid-Server."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid shows your photos and videos directly on your device so you can clean up. No PhotoMaid account or server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid muestra tus fotos y vídeos en tu dispositivo para que puedas hacer limpieza. Sin cuenta ni servidor de PhotoMaid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid affiche tes photos et vidéos directement sur ton appareil pour que tu puisses faire le tri. Sans compte ni serveur PhotoMaid."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid mostra foto e video direttamente sul dispositivo per aiutarti a riordinare. Nessun account o server PhotoMaid."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaidは端末内の写真や動画をそのまま表示して、整理を手伝います。PhotoMaidのアカウントやサーバーはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid는 기기에 있는 사진과 동영상을 직접 보여 주고 정리를 도와요. PhotoMaid 계정이나 서버는 없어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid toont je foto’s en video’s op je apparaat, zodat je kunt opruimen. Zonder PhotoMaid-account of -server."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid pokazuje zdjęcia i filmy na urządzeniu, aby można było je uporządkować. Bez konta i serwera PhotoMaid."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O PhotoMaid mostra as fotos e os vídeos no teu dispositivo para os poderes organizar. Sem conta nem servidor PhotoMaid."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid arată fotografiile și videoclipurile direct pe dispozitiv, ca să le poți organiza. Fără cont sau server PhotoMaid."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid показывает фото и видео на устройстве, чтобы ты мог навести порядок. Без аккаунта и сервера PhotoMaid."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid, düzenleyebilmen için fotoğraf ve videolarını cihazında gösterir. PhotoMaid hesabı veya sunucusu yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid показує фото й відео на пристрої, щоб ти міг навести лад. Без облікового запису й сервера PhotoMaid."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid 直接显示设备上的照片和视频，方便你清理。无需 PhotoMaid 账号，也没有 PhotoMaid 服务器。"
          }
        }
      }
    },
