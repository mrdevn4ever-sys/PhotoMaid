          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মাস অনুযায়ী"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per mesos"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podle měsíců"
          }
