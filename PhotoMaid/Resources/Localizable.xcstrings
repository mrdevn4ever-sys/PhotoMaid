          "stringUnit": {
            "state": "translated",
            "value": "待機中 –「%1$@」が終わりしだい自動で始まります。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕಾಯುತ್ತಿದೆ – “%1$@” ಮುಗಿದ ತಕ್ಷಣ ತಾನಾಗಿಯೇ ಪ್ರಾರಂಭವಾಗುತ್ತದೆ."
