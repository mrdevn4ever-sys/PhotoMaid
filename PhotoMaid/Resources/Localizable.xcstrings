    "summary_offer_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مع GaleriQ Pro ترتّب دون حد يومي. شراء مرة واحدة، بلا اشتراك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ Pro দিয়ে দৈনিক সীমা ছাড়া পরিষ্কার করুন। একবার কিনুন, কোনো সাবস্ক্রিপশন নেই।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Endreça sense límit diari amb GaleriQ Pro. Un sol pagament, sense subscripció."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uklízejte bez denního limitu s GaleriQ Pro. Kupte jednou, bez předplatného."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ryd op uden daglig grænse med GaleriQ Pro. Køb én gang, intet abonnement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit GaleriQ Pro räumst du ohne Tageslimit auf. Einmal kaufen, kein Abo."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τακτοποίησε χωρίς ημερήσιο όριο με το GaleriQ Pro. Αγορά μία φορά, χωρίς συνδρομή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clean up without a daily limit with GaleriQ Pro. Buy once, no subscription."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con GaleriQ Pro ordenas sin límite diario. Pago único, sin suscripción."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siivoa ilman päivärajaa GaleriQ Prolla. Osta kerran, ei tilausta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec GaleriQ Pro, triez sans limite quotidienne. Achat unique, sans abonnement."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ Pro સાથે દૈનિક મર્યાદા વિના સાફસફાઈ કરો. એક વાર ખરીદો, કોઈ સબ્સ્ક્રિપ્શન નહીં."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סידור בלי מגבלה יומית עם GaleriQ Pro. קונים פעם אחת, בלי מינוי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ Pro के साथ बिना रोज़ की सीमा सफ़ाई करें। एक बार खरीदें, कोई सब्सक्रिप्शन नहीं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Raščisti bez dnevnog ograničenja uz GaleriQ Pro. Kupi jednom, bez pretplate."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendrakás napi korlát nélkül a GaleriQ Próval. Egyszeri vásárlás, nincs előfizetés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapikan tanpa batas harian dengan GaleriQ Pro. Sekali beli, tanpa langganan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con GaleriQ Pro riordini senza limite giornaliero. Acquisto unico, nessun abbonamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ Proなら1日の上限なしで整理できます。買い切りでサブスクなし。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ Pro ಮೂಲಕ ದೈನಂದಿನ ಮಿತಿಯಿಲ್ಲದೆ ಸ್ವಚ್ಛಗೊಳಿಸಿ. ಒಮ್ಮೆ ಖರೀದಿಸಿ, ಚಂದಾದಾರಿಕೆ ಇಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ Pro로 하루 한도 없이 정리하세요. 한 번 구매, 구독 없음."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ Pro ഉപയോഗിച്ച് ദൈനംദിന പരിധിയില്ലാതെ വൃത്തിയാക്കുക. ഒരിക്കൽ വാങ്ങുക, സബ്‌സ്ക്രിപ്ഷനില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ Pro सह दैनिक मर्यादेशिवाय साफसफाई करा. एकदाच खरेदी, सदस्यता नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kemas tanpa had harian dengan GaleriQ Pro. Beli sekali, tiada langganan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rydd uten daglig grense med GaleriQ Pro. Kjøp én gang, ingen abonnement."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met GaleriQ Pro ruim je op zonder daglimiet. Eenmalig kopen, geen abonnement."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ Pro ସହ ଦୈନିକ ସୀମା ବିନା ସଫା କରନ୍ତୁ। ଥରେ କିଣନ୍ତୁ, କୌଣସି ସବସ୍କ୍ରିପସନ୍ ନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ Pro ਨਾਲ ਬਿਨਾਂ ਰੋਜ਼ਾਨਾ ਸੀਮਾ ਸਫ਼ਾਈ ਕਰੋ। ਇੱਕ ਵਾਰ ਖ਼ਰੀਦੋ, ਕੋਈ ਸਬਸਕ੍ਰਿਪਸ਼ਨ ਨਹੀਂ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Z GaleriQ Pro porządkujesz bez dziennego limitu. Jednorazowy zakup, bez subskrypcji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpe sem limite diário com o GaleriQ Pro. Compre uma vez, sem assinatura."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Com o GaleriQ Pro arruma sem limite diário. Compra única, sem subscrição."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cu GaleriQ Pro ordonezi fără limită zilnică. Cumperi o dată, fără abonament."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С GaleriQ Pro можно убирать без дневного лимита. Одна покупка, без подписки."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Upratujte bez denného limitu s GaleriQ Pro. Kúpte raz, bez predplatného."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Čisti brez dnevne omejitve z GaleriQ Pro. Kupi enkrat, brez naročnine."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rensa utan daglig gräns med GaleriQ Pro. Köp en gång, ingen prenumeration."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ Pro மூலம் தினசரி வரம்பின்றிச் சுத்தம் செய்யுங்கள். ஒருமுறை வாங்குங்கள், சந்தா இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ Pro తో రోజువారీ పరిమితి లేకుండా శుభ్రం చేయండి. ఒకసారి కొనండి, సబ్‌స్క్రిప్షన్ లేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จัดระเบียบโดยไม่มีขีดจำกัดรายวันด้วย GaleriQ Pro ซื้อครั้งเดียว ไม่ต้องสมัครสมาชิก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ Pro ile günlük sınır olmadan temizle. Tek seferlik satın alma, abonelik yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "З GaleriQ Pro прибирайте без денного ліміту. Одноразова покупка, без підписки."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ Pro کے ساتھ بغیر روزانہ حد صفائی کریں۔ ایک بار خریدیں، کوئی سبسکرپشن نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dọn dẹp không giới hạn hằng ngày với GaleriQ Pro. Mua một lần, không đăng ký."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 GaleriQ Pro 整理不受每日限制。一次购买，无需订阅。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 GaleriQ Pro 整理無每日上限。一次購買，無需訂閱。"
          }
        }
      }
    },
