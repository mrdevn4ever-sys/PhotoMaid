        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਆਈਟਮਾਂ ਵੌਲਟ ਵਿੱਚ ਹੀ ਰਹਿੰਦੀਆਂ ਹਨ, ਬੱਸ ਬਿਨਾਂ ਫ਼ੋਲਡਰ ਦੇ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elementy zostają w sejfie, tylko bez folderu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os itens continuam no cofre, só que sem pasta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os itens ficam no cofre, apenas sem pasta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Elementele rămân în seif, doar fără dosar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Объекты останутся в сейфе, просто без папки."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Položky zostanú v trezore, len bez priečinka."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elementi ostanejo v sefu, le brez mape."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Objekten stannar i valvet, bara utan mapp."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உருப்படிகள் லாக்கரிலேயே இருக்கும், கோப்புறை இல்லாமல் மட்டும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అంశాలు వాల్ట్‌లోనే ఉంటాయి, ఫోల్డర్ లేకుండా మాత్రమే."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการยังอยู่ในตู้เซฟ เพียงแต่ไม่อยู่ในโฟลเดอร์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Öğeler kasada kalır, yalnızca klasörsüz olur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Об’єкти залишаться в сейфі, просто без папки."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آئٹمز والٹ میں رہتے ہیں، بس بغیر فولڈر کے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các mục vẫn ở trong két sắt, chỉ không còn thư mục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
