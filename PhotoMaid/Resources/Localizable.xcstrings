    "snake_photo_error": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تحميل بعض الصور. تحقق من اتصالك لصور iCloud وحاول مجددًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nogle fotos kunne ikke indlæses. Tjek forbindelsen for iCloud-fotos, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Fotos konnten nicht geladen werden. Prüfe bei iCloud-Fotos deine Verbindung und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some photos could not be loaded. Check your connection for iCloud photos and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han podido cargar algunas fotos. Comprueba la conexión para las fotos de iCloud y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines photos n’ont pas pu être chargées. Vérifiez la connexion pour les photos iCloud et réessayez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beberapa foto tidak dapat dimuat. Periksa koneksi untuk foto iCloud dan coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile caricare alcune foto. Controlla la connessione per le foto iCloud e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部の写真を読み込めませんでした。iCloud写真の接続を確認して再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 사진을 불러오지 못했습니다. iCloud 사진의 연결을 확인하고 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Noen bilder kunne ikke lastes inn. Sjekk forbindelsen for iCloud-bilder og prøv igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sommige foto's konden niet worden geladen. Controleer je verbinding voor iCloud-foto's en probeer opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się wczytać części zdjęć. Sprawdź połączenie dla zdjęć iCloud i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algumas fotos não puderam ser carregadas. Verifique sua conexão para fotos do iCloud e tente de novo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar algumas fotos. Verifica a ligação para as fotos iCloud e tenta novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Unele fotografii nu au putut fi încărcate. Verifică conexiunea pentru fotografiile iCloud și încearcă din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить некоторые фото. Проверьте подключение для фото iCloud и повторите попытку."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Några bilder kunde inte läsas in. Kontrollera anslutningen för iCloud-bilder och försök igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โหลดบางรูปไม่ได้ ตรวจสอบการเชื่อมต่อสำหรับรูปภาพ iCloud แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazı fotoğraflar yüklenemedi. iCloud fotoğrafları için bağlantını kontrol edip tekrar dene."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося завантажити деякі фото. Перевір з’єднання для фото iCloud і спробуй ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tải được một số ảnh. Hãy kiểm tra kết nối cho ảnh iCloud và thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分照片无法加载。请检查iCloud照片的网络连接后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
