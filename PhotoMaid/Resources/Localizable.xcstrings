    "pro_store_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تحميل Pro من App Store حاليًا. تحقّق من اتصالك بالإنترنت وحاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro lässt sich gerade nicht aus dem App Store laden. Prüfe die Internetverbindung und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro can’t be loaded from the App Store right now. Check your internet connection and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora no se puede cargar Pro desde el App Store. Comprueba tu conexión a internet e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger Pro depuis l’App Store pour le moment. Vérifie ta connexion Internet et réessaie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al momento non è possibile caricare Pro dall’App Store. Controlla la connessione a Internet e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在App StoreからProを読み込めません。インターネット接続を確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 App Store에서 Pro를 불러올 수 없어요. 인터넷 연결을 확인하고 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro kan nu niet uit de App Store worden geladen. Controleer je internetverbinding en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można teraz wczytać Pro z App Store. Sprawdź połączenie z internetem i spróbuj ponownie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível carregar o Pro da App Store neste momento. Verifica a ligação à internet e tenta novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro nu poate fi încărcat acum din App Store. Verifică conexiunea la internet și încearcă din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас не удаётся загрузить Pro из App Store. Проверь подключение к интернету и попробуй ещё раз."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro şu anda App Store’dan yüklenemiyor. İnternet bağlantını kontrol edip tekrar dene."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зараз не вдається завантажити Pro з App Store. Перевір з’єднання з інтернетом і спробуй ще раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前无法从 App Store 载入 Pro。请检查网络连接后重试。"
          }
        }
      }
    },
