    "pro_also": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اشترِ مرة واحدة ونظّف بلا إعلانات. بلا اشتراك أو حساب GaleriQ."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Buy once, clean up without ads. No subscription or GaleriQ account."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmal kaufen, ohne Werbung aufräumen. Kein Abo und kein GaleriQ-Konto."
          }
        },
        "en": {
