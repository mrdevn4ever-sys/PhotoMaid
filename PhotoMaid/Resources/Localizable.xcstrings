          "stringUnit": {
            "state": "translated",
            "value": "รูปภาพทั้งหมดของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm fotoğrafların"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі ваші фото"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tất cả ảnh của bạn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的所有照片"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你所有的照片"
          }
        }
      }
    },
    "tour_months_later_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العناصر المؤجلة لوقت لاحق تُحسب كمراجعة، لكنك ما زلت تراها هنا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Emner, der er lagt til side til senere, tæller som gennemgået – du ser dem stadig her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für später Zurückgestelltes zählt als durchgesehen – du siehst es hier trotzdem."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Items set aside for later count as reviewed – you still see them here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo dejado para después cuenta como revisado, pero lo sigues viendo aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui est remis à plus tard compte comme passé en revue – tu le vois quand même ici."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Item yang disisihkan untuk nanti dihitung sudah ditinjau – kamu tetap melihatnya di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò che è rimandato conta come rivisto, ma lo vedi comunque qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「あとで」にしたものは見直し済みとして数えますが、ここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘나중에’로 미룬 항목은 확인한 것으로 세지만 여기에서 계속 보여요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Elementer lagt til side til senere teller som gått gjennom – du ser dem fortsatt her."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat voor later is bewaard telt als bekeken – je ziet het hier toch."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odłożone na później liczą się jako przejrzane – nadal widzisz je tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Itens deixados para depois contam como revisados – você ainda os vê aqui."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O que ficou para mais tarde conta como revisto, mas continuas a vê-lo aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce ai amânat contează ca revizuit, dar îl vezi în continuare aici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отложенное на потом считается просмотренным, но ты всё равно видишь его здесь."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Objekt som lagts undan till senare räknas som genomgångna – du ser dem fortfarande här."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการที่แยกไว้ทีหลังนับว่าตรวจดูแล้ว – คุณยังเห็นได้ที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonraya bırakılanlar gözden geçirilmiş sayılır ama burada yine görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкладене на потім вважається переглянутим, але ти все одно бачиш його тут."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các mục để sau được tính là đã xem lại – bạn vẫn thấy chúng ở đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设为稍后的内容计为已查看，但仍会在这里显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "存為稍後的項目也算已整理 – 你仍會在這裡看到它們。"
          }
        }
      }
    },
    "tour_months_later_title": {
      "extractionState": "manual",
      "localizations": {
