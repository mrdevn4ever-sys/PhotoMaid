          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se elimina ni se decide nada. Solo se crea un archivo nuevo cuando guardas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’est supprimé ni décidé. Un nouveau fichier n’est créé que si vous enregistrez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nothing is deleted or decided. A new file is only saved when you choose to."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nulla viene eliminato o deciso. Un nuovo file viene creato solo quando salvi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除や判定は行われません。新しいファイルは保存したときだけ作成されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제되거나 결정되는 것은 없어요. 저장할 때만 새 파일이 만들어져요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nothing is deleted or decided. A new file is only saved when you choose to."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wordt niets verwijderd of beslist. Een nieuw bestand ontstaat pas als je opslaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie jest usuwane ani rozstrzygane. Nowy plik powstaje dopiero po zapisaniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nothing is deleted or decided. A new file is only saved when you choose to."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada é eliminado nem decidido. Só é criado um ficheiro novo quando guarda."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimic nu este șters sau decis. Un fișier nou apare doar când salvezi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего не удаляется и не решается. Новый файл появится, только когда вы сохраните."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nothing is deleted or decided. A new file is only saved when you choose to."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nothing is deleted or decided. A new file is only saved when you choose to."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir şey silinmez veya karara bağlanmaz. Yeni dosya yalnızca kaydettiğinde oluşur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нічого не видаляється і не вирішується. Новий файл з’явиться, лише коли ви збережете."
          }
        },
        "vi": {
          "stringUnit": {
