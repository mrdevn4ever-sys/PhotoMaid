    "vid_pro_needed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحرير الفيديو جزء من Pro. يمكنك تجربة كل شيء؛ وللحفظ تحتاج إلى Pro."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Videoredigering er en del af Pro. Du kan prøve alt; for at gemme skal du have Pro."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Video-Bearbeitung gehört zu Pro. Ausprobieren kannst du alles; zum Speichern brauchst du Pro."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Video editing is part of Pro. You can try everything; to save, you need Pro."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La edición de vídeo forma parte de Pro. Puedes probarlo todo; para guardar necesitas Pro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le montage vidéo fait partie de Pro. Vous pouvez tout essayer ; pour enregistrer, il faut Pro."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit video adalah bagian dari Pro. Kamu bisa mencoba semuanya; untuk menyimpan, kamu butuh Pro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La modifica video fa parte di Pro. Puoi provare tutto; per salvare ti serve Pro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビデオ編集はProの機能です。すべて試せますが、保存にはProが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비디오 편집은 Pro 기능입니다. 모두 사용해 볼 수 있지만 저장하려면 Pro가 필요합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Videoredigering er en del av Pro. Du kan prøve alt; for å lagre trenger du Pro."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Video bewerken hoort bij Pro. Je kunt alles uitproberen; om te bewaren heb je Pro nodig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Edycja filmów należy do Pro. Możesz wszystko wypróbować; do zapisania potrzebujesz Pro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A edição de vídeo faz parte do Pro. Você pode experimentar tudo; para salvar, precisa do Pro."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A edição de vídeo faz parte do Pro. Pode experimentar tudo; para guardar precisa do Pro."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Editarea video face parte din Pro. Poți încerca totul; pentru salvare ai nevoie de Pro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Редактирование видео входит в Pro. Попробовать можно всё; для сохранения нужен Pro."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Videoredigering ingår i Pro. Du kan prova allt; för att spara behöver du Pro."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแก้ไขวิดีโอเป็นส่วนหนึ่งของ Pro คุณลองทุกอย่างได้ หากต้องการบันทึกต้องใช้ Pro"
