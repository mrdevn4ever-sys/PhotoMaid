    "wf_step_target": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ كحد أقصى لكل صورة – تُعدَّل الجودة وعند الحاجة الحجم، وتُقاس النتيجة"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Højst %1$@ pr. foto – kvaliteten og om nødvendigt størrelsen justeres, og resultatet måles"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Höchstens %1$@ je Foto – Qualität und notfalls Größe werden angepasst, das Ergebnis wird gemessen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At most %1$@ per photo – quality and, if needed, size are adjusted and the result is measured"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Como máximo %1$@ por foto: se ajustan la calidad y, si hace falta, el tamaño, y se mide el resultado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ max. par photo – la qualité et si besoin la taille sont ajustées, le résultat est mesuré"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Maksimal %1$@ per foto – kualitas dan, bila perlu, ukuran disesuaikan dan hasilnya diukur"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al massimo %1$@ per foto: si regolano qualità ed eventualmente dimensioni, e il risultato viene misurato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1枚あたり最大%1$@ – 画質と必要ならサイズを調整し、結果を測定"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진당 최대 %1$@ – 화질과 필요하면 크기를 조정하고 결과를 측정"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Maks %1$@ per bilde – kvaliteten og ved behov størrelsen justeres, og resultatet måles"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoogstens %1$@ per foto – kwaliteit en zo nodig formaat worden aangepast, het resultaat wordt gemeten"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maks. %1$@ na zdjęcie – jakość i w razie potrzeby rozmiar są dopasowywane, wynik jest mierzony"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No máximo %1$@ por foto – a qualidade e, se preciso, o tamanho são ajustados e o resultado é medido"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Até %1$@ por foto – a qualidade e, se preciso, o tamanho são ajustados e o resultado é medido"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cel mult %1$@ per fotografie – se ajustează calitatea și, la nevoie, dimensiunea, iar rezultatul se măsoară"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не больше %1$@ на фото – подбираются качество и при необходимости размер, результат измеряется"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Högst %1$@ per bild – kvaliteten och vid behov storleken justeras och resultatet mäts"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่เกิน %1$@ ต่อรูป – ปรับคุณภาพและขนาดหากจำเป็น และวัดผลลัพธ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraf başına en fazla %1$@ – kalite ve gerekirse boyut ayarlanır, sonuç ölçülür"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не більше %1$@ на фото – підбираються якість і за потреби розмір, результат вимірюється"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tối đa %1$@ mỗi ảnh – chất lượng và, nếu cần, kích thước được điều chỉnh và kết quả được đo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每张照片最多 %1$@——调整质量，必要时调整尺寸，并测量结果"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每張照片最多 %1$@ – 會調整畫質，必要時調整尺寸，並測量結果"
          }
        }
      }
    },
