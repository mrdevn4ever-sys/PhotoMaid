    "backup_too_new": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه النسخة الاحتياطية من إصدار أحدث من GaleriQ. حدّث GaleriQ أولًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ব্যাকআপটি GaleriQ-এর নতুন সংস্করণ থেকে এসেছে। অনুগ্রহ করে আগে GaleriQ আপডেট করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquesta còpia és d’una versió més nova de GaleriQ. Primer actualitza GaleriQ."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato záloha pochází z novější verze GaleriQ. Nejdřív GaleriQ aktualizujte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne sikkerhedskopi stammer fra en nyere version af GaleriQ. Opdater GaleriQ først."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Sicherung stammt aus einer neueren GaleriQ-Version. Bitte aktualisiere GaleriQ zuerst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το αντίγραφο προέρχεται από νεότερη έκδοση του GaleriQ. Ενημέρωσε πρώτα το GaleriQ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This backup comes from a newer version of GaleriQ. Please update GaleriQ first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta copia de seguridad es de una versión más reciente de GaleriQ. Actualiza GaleriQ primero."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä varmuuskopio on GaleriQ:n uudemmasta versiosta. Päivitä GaleriQ ensin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette sauvegarde provient d’une version plus récente de GaleriQ. Mettez d’abord GaleriQ à jour."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ બૅકઅપ GaleriQ ના નવા વર્ઝનનો છે. કૃપા કરીને પહેલાં GaleriQ અપડેટ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגיבוי הזה מגרסה חדשה יותר של GaleriQ. יש לעדכן קודם את GaleriQ."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह बैकअप GaleriQ के नए वर्शन का है। कृपया पहले GaleriQ अपडेट करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ova sigurnosna kopija potječe iz novije verzije GaleriQ-a. Najprije ažuriraj GaleriQ."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a mentés a GaleriQ egy újabb verziójából származik. Előbb frissítsd a GaleriQ-t."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cadangan ini berasal dari versi GaleriQ yang lebih baru. Perbarui GaleriQ dulu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo backup proviene da una versione più recente di GaleriQ. Aggiorna prima GaleriQ."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバックアップは新しいバージョンのGaleriQで作られました。先にGaleriQを更新してください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಬ್ಯಾಕಪ್ GaleriQ ನ ಹೊಸ ಆವೃತ್ತಿಯಿಂದ ಬಂದಿದೆ. ದಯವಿಟ್ಟು ಮೊದಲು GaleriQ ಅನ್ನು ಅಪ್‌ಡೇಟ್ ಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 백업은 더 새로운 GaleriQ 버전에서 만들어졌어요. 먼저 GaleriQ를 업데이트하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ബാക്കപ്പ് GaleriQ-ന്റെ പുതിയ പതിപ്പിൽ നിന്നാണ്. ദയവായി ആദ്യം GaleriQ അപ്‌ഡേറ്റ് ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हा बॅकअप GaleriQ च्या नवीन आवृत्तीचा आहे. कृपया आधी GaleriQ अपडेट करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sandaran ini daripada versi GaleriQ yang lebih baharu. Sila kemas kini GaleriQ dahulu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne sikkerhetskopien kommer fra en nyere versjon av GaleriQ. Oppdater GaleriQ først."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze back-up komt uit een nieuwere versie van GaleriQ. Werk GaleriQ eerst bij."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହି ବ୍ୟାକଅପ୍ GaleriQର ନୂଆ ସଂସ୍କରଣରୁ ଆସିଛି। ଦୟାକରି ପ୍ରଥମେ GaleriQ ଅପଡେଟ୍ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਬੈਕਅੱਪ GaleriQ ਦੇ ਨਵੇਂ ਸੰਸਕਰਨ ਦਾ ਹੈ। ਕਿਰਪਾ ਕਰਕੇ ਪਹਿਲਾਂ GaleriQ ਅੱਪਡੇਟ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta kopia zapasowa pochodzi z nowszej wersji GaleriQ. Najpierw zaktualizuj GaleriQ."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este backup vem de uma versão mais nova do GaleriQ. Atualize o GaleriQ primeiro."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cópia de segurança vem de uma versão mais recente do GaleriQ. Atualize primeiro o GaleriQ."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest backup provine dintr-o versiune mai nouă de GaleriQ. Actualizează mai întâi GaleriQ."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта резервная копия создана в более новой версии GaleriQ. Сначала обновите GaleriQ."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Táto záloha pochádza z novšej verzie GaleriQ. Najprv GaleriQ aktualizujte."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta varnostna kopija je iz novejše različice GaleriQ. Najprej posodobi GaleriQ."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här säkerhetskopian kommer från en nyare version av GaleriQ. Uppdatera GaleriQ först."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தக் காப்புப்பிரதி GaleriQ-இன் புதிய பதிப்பிலிருந்து வந்தது. முதலில் GaleriQ-ஐப் புதுப்பியுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ బ్యాకప్ GaleriQ కొత్త వెర్షన్ నుండి వచ్చింది. దయచేసి ముందుగా GaleriQను అప్‌డేట్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูลสำรองนี้มาจาก GaleriQ เวอร์ชันที่ใหม่กว่า โปรดอัปเดต GaleriQ ก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yedek GaleriQ’in daha yeni bir sürümünden. Lütfen önce GaleriQ’i güncelle."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цю резервну копію створено в новішій версії GaleriQ. Спершу оновіть GaleriQ."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ بیک اپ GaleriQ کے نئے ورژن کا ہے۔ براہ کرم پہلے GaleriQ اپ ڈیٹ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản sao lưu này đến từ phiên bản GaleriQ mới hơn. Vui lòng cập nhật GaleriQ trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此备份来自更新版本的 GaleriQ。请先更新 GaleriQ。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這份備份來自較新版本的 GaleriQ。請先更新 GaleriQ。"
          }
        }
      }
    },
