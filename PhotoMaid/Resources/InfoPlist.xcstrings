    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم GaleriQ الكاميرا فقط لمسح المستندات عندما تضغط «مسح»."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ক্যামেরা শুধু তখনই নথি স্ক্যান করতে ব্যবহার করে যখন আপনি স্ক্যান-এ ট্যাপ করেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ només fa servir la càmera per escanejar documents quan toques Escanejar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ používá fotoaparát jen ke skenování dokumentů, když klepnete na Skenovat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ bruger kun kameraet til at scanne dokumenter, når du trykker på Scan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ nutzt die Kamera nur zum Scannen von Dokumenten, wenn du auf „Scannen“ tippst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το GaleriQ χρησιμοποιεί την κάμερα μόνο για σάρωση εγγράφων όταν πατάς Σάρωση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ uses the camera only to scan documents when you tap Scan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ usa la cámara solo para escanear documentos cuando tocas «Escanear»."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ käyttää kameraa vain asiakirjojen skannaamiseen, kun napautat Skannaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ utilise l’appareil photo uniquement pour numériser des documents lorsque vous touchez « Numériser »."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે સ્કૅન પર ટૅપ કરો ત્યારે જ GaleriQ દસ્તાવેજો સ્કૅન કરવા કૅમેરા વાપરે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ משתמשת במצלמה רק כדי לסרוק מסמכים כשמקישים על „סריקה”."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ कैमरे का उपयोग सिर्फ़ तब दस्तावेज़ स्कैन करने के लिए करता है जब आप स्कैन पर टैप करते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ koristi kameru samo za skeniranje dokumenata kad dodirneš Skeniraj."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A GaleriQ a kamerát csak dokumentumok beolvasására használja, amikor a Beolvasás gombra koppintasz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ memakai kamera hanya untuk memindai dokumen saat kamu mengetuk Pindai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ usa la fotocamera solo per scansionare documenti quando tocchi «Scansiona»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQは「スキャン」をタップしたときだけ、書類のスキャンにカメラを使います。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಸ್ಕ್ಯಾನ್ ಟ್ಯಾಪ್ ಮಾಡಿದಾಗ ಮಾತ್ರ GaleriQ ದಾಖಲೆಗಳನ್ನು ಸ್ಕ್ಯಾನ್ ಮಾಡಲು ಕ್ಯಾಮೆರಾ ಬಳಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ는 '스캔'을 탭할 때만 문서 스캔에 카메라를 사용합니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ സ്കാൻ ടാപ്പ് ചെയ്യുമ്പോൾ പ്രമാണങ്ങൾ സ്കാൻ ചെയ്യാൻ മാത്രമാണ് GaleriQ ക്യാമറ ഉപയോഗിക്കുന്നത്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही स्कॅन वर टॅप केल्यावरच GaleriQ दस्तऐवज स्कॅन करण्यासाठी कॅमेरा वापरते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ menggunakan kamera hanya untuk mengimbas dokumen apabila anda mengetik Imbas."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ bruker kameraet bare til å skanne dokumenter når du trykker på Skann."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ gebruikt de camera alleen om documenten te scannen als je op ‘Scan’ tikt."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣ ସ୍କାନ୍‌ରେ ଟାପ୍ କଲେ ହିଁ GaleriQ ଡକ୍ୟୁମେଣ୍ଟ ସ୍କାନ୍ କରିବାକୁ କ୍ୟାମେରା ବ୍ୟବହାର କରେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ਕੈਮਰਾ ਸਿਰਫ਼ ਉਦੋਂ ਦਸਤਾਵੇਜ਼ ਸਕੈਨ ਕਰਨ ਲਈ ਵਰਤਦਾ ਹੈ ਜਦੋਂ ਤੁਸੀਂ ਸਕੈਨ ਉੱਤੇ ਟੈਪ ਕਰਦੇ ਹੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ używa aparatu tylko do skanowania dokumentów, gdy stukniesz „Skanuj”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O GaleriQ usa a câmera só para digitalizar documentos quando você toca em Digitalizar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O GaleriQ usa a câmara apenas para digitalizar documentos quando toca em «Digitalizar»."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ folosește camera doar pentru a scana documente când atingi „Scanează”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ использует камеру только для сканирования документов, когда вы нажимаете «Сканировать»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ používa fotoaparát len na skenovanie dokumentov, keď klepnete na Skenovať."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ uporablja kamero samo za skeniranje dokumentov, ko tapneš Skeniraj."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ använder kameran bara för att skanna dokument när du trycker på Skanna."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் ஸ்கேன் என்பதைத் தட்டும்போது ஆவணங்களை ஸ்கேன் செய்ய மட்டுமே GaleriQ கேமராவைப் பயன்படுத்துகிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు స్కాన్ ట్యాప్ చేసినప్పుడు డాక్యుమెంట్‌లను స్కాన్ చేయడానికి మాత్రమే GaleriQ కెమెరాను వాడుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ใช้กล้องเพื่อสแกนเอกสารเมื่อคุณแตะ สแกน เท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ, kamerayı yalnızca \"Tara\"ya dokunduğunda belgeleri taramak için kullanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ використовує камеру лише для сканування документів, коли ви торкаєтеся «Сканувати»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ کیمرہ صرف تب دستاویزات اسکین کرنے کے لیے استعمال کرتا ہے جب آپ اسکین پر ٹیپ کرتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ chỉ dùng camera để quét tài liệu khi bạn chạm Quét."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ 仅在你轻点“扫描”时使用相机扫描文稿。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有在你點一下「掃描」時，GaleriQ 才會使用相機掃描文件。"
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم GaleriQ بصمة الوجه فقط لفتح المحتوى الذي حميته برمز."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ Face ID শুধু সেই বিষয়বস্তু খুলতে ব্যবহার করে যা আপনি কোড দিয়ে সুরক্ষিত করেছেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ només fa servir Face ID per obrir el contingut que has protegit amb un codi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ používá Face ID jen k otevření obsahu, který jste chránili kódem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ bruger kun Face ID til at åbne indhold, du har beskyttet med en kode."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ nutzt Face ID nur, um Inhalte zu öffnen, die du mit einem Code geschützt hast."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το GaleriQ χρησιμοποιεί το Face ID μόνο για να ανοίξει περιεχόμενο που προστάτεψες με κωδικό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ uses Face ID only to open content you protected with a code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ usa Face ID solo para abrir el contenido que protegiste con un código."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ käyttää Face ID:tä vain koodilla suojaamasi sisällön avaamiseen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ utilise Face ID uniquement pour ouvrir le contenu que tu as protégé par un code."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે કોડથી સુરક્ષિત કરેલી સામગ્રી ખોલવા માટે જ GaleriQ Face ID વાપરે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ משתמשת ב-Face ID רק כדי לפתוח תוכן שהגנת עליו בקוד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ Face ID का उपयोग सिर्फ़ उस सामग्री को खोलने के लिए करता है जिसे आपने कोड से सुरक्षित किया है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ koristi Face ID samo za otvaranje sadržaja koji si zaštitio kôdom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A GaleriQ a Face ID-t csak a kóddal védett tartalom megnyitására használja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ memakai Face ID hanya untuk membuka konten yang kamu lindungi dengan kode."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ usa Face ID solo per aprire i contenuti che hai protetto con un codice."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQは、コードで保護したコンテンツを開くためだけにFace IDを使用します。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಕೋಡ್‌ನಿಂದ ರಕ್ಷಿಸಿದ ವಿಷಯವನ್ನು ತೆರೆಯಲು ಮಾತ್ರ GaleriQ Face ID ಬಳಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ는 코드로 보호한 콘텐츠를 열 때만 Face ID를 사용해요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ കോഡ് ഉപയോഗിച്ച് സംരക്ഷിച്ച ഉള്ളടക്കം തുറക്കാൻ മാത്രമാണ് GaleriQ Face ID ഉപയോഗിക്കുന്നത്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही कोडने संरक्षित केलेला मजकूर उघडण्यासाठीच GaleriQ Face ID वापरते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ menggunakan Face ID hanya untuk membuka kandungan yang anda lindungi dengan kod."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ bruker Face ID bare til å åpne innhold du har beskyttet med en kode."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ gebruikt Face ID alleen om inhoud te openen die je met een code hebt beveiligd."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣ କୋଡ୍ ସହ ସୁରକ୍ଷିତ କରିଥିବା ବିଷୟବସ୍ତୁ ଖୋଲିବା ପାଇଁ ହିଁ GaleriQ Face ID ବ୍ୟବହାର କରେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ Face ID ਸਿਰਫ਼ ਉਹ ਸਮੱਗਰੀ ਖੋਲ੍ਹਣ ਲਈ ਵਰਤਦਾ ਹੈ ਜਿਸ ਨੂੰ ਤੁਸੀਂ ਕੋਡ ਨਾਲ ਸੁਰੱਖਿਅਤ ਕੀਤਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ używa Face ID tylko do otwierania treści chronionych kodem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O GaleriQ usa o Face ID só para abrir conteúdo que você protegeu com um código."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O GaleriQ usa o Face ID apenas para abrir conteúdo que protegeste com um código."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ folosește Face ID doar pentru a deschide conținutul protejat de tine cu un cod."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ использует Face ID только для открытия содержимого, защищённого кодом."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ používa Face ID len na otvorenie obsahu, ktorý ste chránili kódom."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ uporablja Face ID samo za odpiranje vsebine, ki si jo zaščitil s kodo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ använder Face ID bara för att öppna innehåll som du har skyddat med en kod."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் குறியீட்டால் பாதுகாத்த உள்ளடக்கத்தைத் திறக்க மட்டுமே GaleriQ Face ID-ஐப் பயன்படுத்துகிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు కోడ్‌తో రక్షించిన కంటెంట్‌ను తెరవడానికి మాత్రమే GaleriQ Face IDని వాడుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ใช้ Face ID เพื่อเปิดเนื้อหาที่คุณปกป้องด้วยรหัสเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ, Face ID’yi yalnızca kodla koruduğun içeriği açmak için kullanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ використовує Face ID лише для відкриття вмісту, захищеного кодом."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ Face ID صرف اس مواد کو کھولنے کے لیے استعمال کرتا ہے جسے آپ نے کوڈ سے محفوظ کیا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ chỉ dùng Face ID để mở nội dung bạn đã bảo vệ bằng mã."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ 仅使用面容 ID 打开你用密码保护的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ 只會用 Face ID 打開你用密碼保護的內容。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج GaleriQ إلى الميكروفون لملاحظة صوتية. لا يبدأ التسجيل إلا عند الضغط."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভয়েস নোটের জন্য GaleriQ-এর মাইক্রোফোন অ্যাক্সেস দরকার। আপনি ট্যাপ করলেই কেবল রেকর্ডিং শুরু হয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ necessita accés al micròfon per a una nota de veu. La gravació només comença quan toques."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ potřebuje přístup k mikrofonu kvůli hlasové poznámce. Nahrávání začne, až klepnete."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ skal have adgang til mikrofonen for at optage en talenote. Optagelsen starter først, når du trykker."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für eine Sprachnotiz braucht GaleriQ Zugriff auf das Mikrofon. Die Aufnahme beginnt nur nach deinem Tippen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το GaleriQ χρειάζεται πρόσβαση στο μικρόφωνο για φωνητική σημείωση. Η εγγραφή ξεκινά μόνο όταν πατήσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ needs microphone access for a voice note. Recording starts only when you tap."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ necesita el micrófono para una nota de voz. La grabación empieza solo al tocar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ tarvitsee mikrofonin käyttöoikeuden äänimuistiota varten. Tallennus alkaa vasta, kun napautat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ a besoin du microphone pour une note vocale. L’enregistrement commence uniquement à votre demande."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "વૉઇસ નોંધ માટે GaleriQ ને માઇક્રોફોન ઍક્સેસ જોઈએ. તમે ટૅપ કરો ત્યારે જ રેકોર્ડિંગ શરૂ થાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ צריכה גישה למיקרופון בשביל הערה קולית. ההקלטה מתחילה רק כשמקישים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वॉइस नोट के लिए GaleriQ को माइक्रोफ़ोन एक्सेस चाहिए। रिकॉर्डिंग तभी शुरू होती है जब आप टैप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ treba pristup mikrofonu za glasovnu bilješku. Snimanje počinje tek kad dodirneš."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A GaleriQ-nak mikrofon-hozzáférés kell a hangjegyzethez. A felvétel csak koppintásra indul."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ butuh akses mikrofon untuk catatan suara. Perekaman baru dimulai saat kamu mengetuk."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ richiede il microfono per una nota vocale. La registrazione inizia solo al tuo tocco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声メモにはマイクへのアクセスが必要です。タップしたときだけ録音を開始します。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಧ್ವನಿ ಟಿಪ್ಪಣಿಗಾಗಿ GaleriQ ಗೆ ಮೈಕ್ರೋಫೋನ್ ಪ್ರವೇಶ ಬೇಕು. ನೀವು ಟ್ಯಾಪ್ ಮಾಡಿದಾಗ ಮಾತ್ರ ರೆಕಾರ್ಡಿಂಗ್ ಪ್ರಾರಂಭವಾಗುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성 메모를 위해 마이크 접근이 필요합니다. 탭해야 녹음이 시작됩니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വോയ്‌സ് നോട്ടിനായി GaleriQ-ന് മൈക്രോഫോൺ ആക്‌സസ് വേണം. നിങ്ങൾ ടാപ്പ് ചെയ്യുമ്പോൾ മാത്രമേ റെക്കോർഡിംഗ് ആരംഭിക്കൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "व्हॉइस नोंदीसाठी GaleriQ ला मायक्रोफोन ॲक्सेस हवा. तुम्ही टॅप केल्यावरच रेकॉर्डिंग सुरू होते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ memerlukan akses mikrofon untuk nota suara. Rakaman hanya bermula apabila anda mengetik."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ trenger tilgang til mikrofonen for et talenotat. Opptaket starter først når du trykker."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ heeft microfoontoegang nodig voor een spraaknotitie. Opname begint alleen na je tik."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଭଏସ୍ ନୋଟ୍ ପାଇଁ GaleriQକୁ ମାଇକ୍ରୋଫୋନ୍ ଆକ୍ସେସ୍ ଦରକାର। ଆପଣ ଟାପ୍ କଲେ ହିଁ ରେକର୍ଡିଂ ଆରମ୍ଭ ହୁଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਵੌਇਸ ਨੋਟ ਲਈ GaleriQ ਨੂੰ ਮਾਈਕ੍ਰੋਫ਼ੋਨ ਪਹੁੰਚ ਚਾਹੀਦੀ ਹੈ। ਰਿਕਾਰਡਿੰਗ ਸਿਰਫ਼ ਤੁਹਾਡੇ ਟੈਪ ਕਰਨ ’ਤੇ ਸ਼ੁਰੂ ਹੁੰਦੀ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ potrzebuje mikrofonu do notatki głosowej. Nagrywanie zaczyna się tylko po stuknięciu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O GaleriQ precisa de acesso ao microfone para uma nota de voz. A gravação só começa quando você toca."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O GaleriQ precisa do microfone para uma nota de voz. A gravação só começa ao tocares."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ are nevoie de microfon pentru o notiță vocală. Înregistrarea începe doar la atingere."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для голосовой заметки GaleriQ нужен микрофон. Запись начинается только по нажатию."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ potrebuje prístup k mikrofónu kvôli hlasovej poznámke. Nahrávanie sa začne, až keď klepnete."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ potrebuje dostop do mikrofona za glasovni zapisek. Snemanje se začne šele, ko tapneš."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ behöver åtkomst till mikrofonen för en röstanteckning. Inspelningen startar först när du trycker."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "குரல் குறிப்புக்கு GaleriQ-க்கு மைக்ரோஃபோன் அணுகல் தேவை. நீங்கள் தட்டும்போது மட்டுமே பதிவு தொடங்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వాయిస్ నోట్ కోసం GaleriQకి మైక్రోఫోన్ యాక్సెస్ అవసరం. మీరు ట్యాప్ చేసినప్పుడు మాత్రమే రికార్డింగ్ ప్రారంభమవుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ต้องการเข้าถึงไมโครโฟนสำหรับโน้ตเสียง การบันทึกจะเริ่มเมื่อคุณแตะเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ, sesli not için mikrofon erişimine ihtiyaç duyar. Kayıt yalnızca dokunduğunda başlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для голосової нотатки GaleriQ потрібен мікрофон. Запис починається лише після натискання."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "وائس نوٹ کے لیے GaleriQ کو مائیکروفون تک رسائی چاہیے۔ ریکارڈنگ تب ہی شروع ہوتی ہے جب آپ ٹیپ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ cần quyền truy cập micrô để ghi âm ghi chú. Chỉ bắt đầu ghi khi bạn chạm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ需要访问麦克风来录制语音备忘录。仅在你点击后开始录音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ 需要取用麥克風來錄製語音備忘錄。只有在你點一下時才會開始錄音。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحفظ GaleriQ النسخ المعدّلة والمجمّعات ومقاطع الفيديو كعناصر جديدة في مكتبتك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ সম্পাদিত কপি, কোলাজ ও ভিডিও আপনার লাইব্রেরিতে নতুন আইটেম হিসেবে সংরক্ষণ করে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ desa còpies editades, collages i vídeos com a elements nous a la fototeca."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ukládá upravené kopie, koláže a videa jako nové položky do vaší knihovny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ gemmer redigerede kopier, collager og videoer som nye emner i dit bibliotek."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ speichert bearbeitete Kopien, Collagen und Videos als neue Medien in deiner Mediathek."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το GaleriQ αποθηκεύει επεξεργασμένα αντίγραφα, κολάζ και βίντεο ως νέα στοιχεία στη βιβλιοθήκη σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ saves edited copies, collages and videos as new items in your library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ guarda copias editadas, collages y vídeos como elementos nuevos en tu fototeca."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ tallentaa muokatut kopiot, kollaasit ja videot uusina kohteina kirjastoosi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ enregistre les copies modifiées, collages et vidéos comme nouveaux éléments dans votre photothèque."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ ફેરફાર કરેલી નકલો, કોલાજ અને વીડિયો તમારી લાઇબ્રેરીમાં નવી આઇટમ તરીકે સાચવે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
