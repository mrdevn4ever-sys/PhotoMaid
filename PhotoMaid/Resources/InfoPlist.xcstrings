    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم PhotoMaid الكاميرا فقط لمسح المستندات عندما تضغط «مسح»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid nutzt die Kamera nur zum Scannen von Dokumenten, wenn du auf „Scannen“ tippst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid uses the camera only to scan documents when you tap Scan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid usa la cámara solo para escanear documentos cuando tocas «Escanear»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid utilise l’appareil photo uniquement pour numériser des documents lorsque vous touchez « Numériser »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid usa la fotocamera solo per scansionare documenti quando tocchi «Scansiona»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaidは「スキャン」をタップしたときだけ、書類のスキャンにカメラを使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid는 '스캔'을 탭할 때만 문서 스캔에 카메라를 사용합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid gebruikt de camera alleen om documenten te scannen als je op ‘Scan’ tikt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid używa aparatu tylko do skanowania dokumentów, gdy stukniesz „Skanuj”."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O PhotoMaid usa a câmara apenas para digitalizar documentos quando toca em «Digitalizar»."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid folosește camera doar pentru a scana documente când atingi „Scanează”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid использует камеру только для сканирования документов, когда вы нажимаете «Сканировать»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid, kamerayı yalnızca \"Tara\"ya dokunduğunda belgeleri taramak için kullanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid використовує камеру лише для сканування документів, коли ви торкаєтеся «Сканувати»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid 仅在你轻点“扫描”时使用相机扫描文稿。"
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم PhotoMaid بصمة الوجه فقط لفتح المحتوى الذي حميته برمز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid nutzt Face ID nur, um Inhalte zu öffnen, die du mit einem Code geschützt hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid uses Face ID only to open content you protected with a code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid usa Face ID solo para abrir el contenido que protegiste con un código."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid utilise Face ID uniquement pour ouvrir le contenu que tu as protégé par un code."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid usa Face ID solo per aprire i contenuti che hai protetto con un codice."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaidは、コードで保護したコンテンツを開くためだけにFace IDを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid는 코드로 보호한 콘텐츠를 열 때만 Face ID를 사용해요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid gebruikt Face ID alleen om inhoud te openen die je met een code hebt beveiligd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid używa Face ID tylko do otwierania treści chronionych kodem."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O PhotoMaid usa o Face ID apenas para abrir conteúdo que protegeste com um código."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid folosește Face ID doar pentru a deschide conținutul protejat de tine cu un cod."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid использует Face ID только для открытия содержимого, защищённого кодом."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid, Face ID’yi yalnızca kodla koruduğun içeriği açmak için kullanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid використовує Face ID лише для відкриття вмісту, захищеного кодом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid 仅使用面容 ID 打开你用密码保护的内容。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحفظ PhotoMaid النسخ المعدّلة والمجمّعات ومقاطع الفيديو كعناصر جديدة في مكتبتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid speichert bearbeitete Kopien, Collagen und Videos als neue Medien in deiner Mediathek."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid saves edited copies, collages, videos and PDFs as new items in your library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid guarda copias editadas, collages y vídeos como elementos nuevos en tu fototeca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid enregistre les copies modifiées, collages et vidéos comme nouveaux éléments dans votre photothèque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid salva copie modificate, collage e video come nuovi elementi nella tua libreria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaidは編集したコピー、コラージュ、ビデオを新しい項目としてライブラリに保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid는 편집한 사본, 콜라주, 비디오를 보관함에 새 항목으로 저장합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid bewaart bewerkte kopieën, collages en video’s als nieuwe items in je bibliotheek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid zapisuje edytowane kopie, kolaże i filmy jako nowe elementy w bibliotece."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O PhotoMaid guarda cópias editadas, colagens e vídeos como novos itens na sua fototeca."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid salvează copiile editate, colajele și videoclipurile ca elemente noi în biblioteca ta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid сохраняет отредактированные копии, коллажи и видео как новые объекты в медиатеке."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid, düzenlenmiş kopyaları, kolajları ve videoları arşivine yeni öğeler olarak kaydeder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid зберігає відредаговані копії, колажі й відео як нові об’єкти у вашій медіатеці."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid 会将编辑后的副本、拼贴和视频作为新项目存储到你的图库中。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض PhotoMaid صورك ومقاطع الفيديو للفرز على هذا الـ iPhone ولا يزيل إلا ما تختاره وتؤكده في نافذة النظام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid zeigt deine Fotos und Videos zum Sortieren auf diesem iPhone und entfernt nur, was du auswählst und im Systemdialog bestätigst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid shows your photos and videos for sorting on this iPhone and only removes items you choose and confirm in the system dialog."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid muestra tus fotos y vídeos para ordenarlos en este iPhone y solo elimina lo que eliges y confirmas en el cuadro del sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid affiche vos photos et vidéos pour les trier sur cet iPhone et ne supprime que ce que vous choisissez et confirmez dans la fenêtre du système."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid mostra foto e video da ordinare su questo iPhone e rimuove solo ciò che scegli e confermi nella finestra di sistema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaidはこのiPhoneで写真とビデオを整理するために表示し、あなたが選んでシステムの確認で承認したものだけを削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid는 이 iPhone에서 정리할 수 있도록 사진과 비디오를 보여 주며, 직접 선택하고 시스템 대화상자에서 확인한 항목만 제거합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid toont je foto’s en video’s om ze op deze iPhone te sorteren en verwijdert alleen wat jij kiest en in het systeemvenster bevestigt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid pokazuje Twoje zdjęcia i filmy do porządkowania na tym iPhonie i usuwa tylko to, co wybierzesz i potwierdzisz w oknie systemu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O PhotoMaid mostra as suas fotografias e vídeos para os organizar neste iPhone e só remove o que escolher e confirmar na janela do sistema."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid îți arată pozele și videoclipurile pentru sortare pe acest iPhone și elimină doar ce alegi și confirmi în dialogul sistemului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid показывает ваши фото и видео для сортировки на этом iPhone и удаляет только то, что вы выбрали и подтвердили в окне системы."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid, bu iPhone’da sıralaman için fotoğraflarını ve videolarını gösterir; yalnızca seçip sistem penceresinde onayladıklarını kaldırır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid показує ваші фото й відео для сортування на цьому iPhone і видаляє лише те, що ви виберете й підтвердите у вікні системи."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoMaid 会在此 iPhone 上显示你的照片和视频以便整理，并且只会移除你选择并在系统对话框中确认的项目。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
