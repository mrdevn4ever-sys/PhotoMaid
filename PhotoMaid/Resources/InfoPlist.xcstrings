    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم GaleriQ الكاميرا فقط لمسح المستندات عندما تضغط «مسح»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ nutzt die Kamera nur zum Scannen von Dokumenten, wenn du auf „Scannen“ tippst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ uses the camera only to scan documents when you tap Scan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ usa la cámara solo para escanear documentos cuando tocas «Escanear»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ utilise l’appareil photo uniquement pour numériser des documents lorsque vous touchez « Numériser »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ usa la fotocamera solo per scansionare documenti quando tocchi «Scansiona»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQは「スキャン」をタップしたときだけ、書類のスキャンにカメラを使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ는 '스캔'을 탭할 때만 문서 스캔에 카메라를 사용합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ gebruikt de camera alleen om documenten te scannen als je op ‘Scan’ tikt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ używa aparatu tylko do skanowania dokumentów, gdy stukniesz „Skanuj”."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O GaleriQ usa a câmara apenas para digitalizar documentos quando toca em «Digitalizar»."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ folosește camera doar pentru a scana documente când atingi „Scanează”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ использует камеру только для сканирования документов, когда вы нажимаете «Сканировать»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ, kamerayı yalnızca \"Tara\"ya dokunduğunda belgeleri taramak için kullanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ використовує камеру лише для сканування документів, коли ви торкаєтеся «Сканувати»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ 仅在你轻点“扫描”时使用相机扫描文稿。"
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم GaleriQ بصمة الوجه فقط لفتح المحتوى الذي حميته برمز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ nutzt Face ID nur, um Inhalte zu öffnen, die du mit einem Code geschützt hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ uses Face ID only to open content you protected with a code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ usa Face ID solo para abrir el contenido que protegiste con un código."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ utilise Face ID uniquement pour ouvrir le contenu que tu as protégé par un code."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ usa Face ID solo per aprire i contenuti che hai protetto con un codice."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQは、コードで保護したコンテンツを開くためだけにFace IDを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ는 코드로 보호한 콘텐츠를 열 때만 Face ID를 사용해요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ gebruikt Face ID alleen om inhoud te openen die je met een code hebt beveiligd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ używa Face ID tylko do otwierania treści chronionych kodem."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O GaleriQ usa o Face ID apenas para abrir conteúdo que protegeste com um código."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ folosește Face ID doar pentru a deschide conținutul protejat de tine cu un cod."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ использует Face ID только для открытия содержимого, защищённого кодом."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ, Face ID’yi yalnızca kodla koruduğun içeriği açmak için kullanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ використовує Face ID лише для відкриття вмісту, захищеного кодом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ 仅使用面容 ID 打开你用密码保护的内容。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج GaleriQ إلى الميكروفون لملاحظة صوتية. لا يبدأ التسجيل إلا عند الضغط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für eine Sprachnotiz braucht GaleriQ Zugriff auf das Mikrofon. Die Aufnahme beginnt nur nach deinem Tippen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ needs microphone access for a voice note. Recording starts only when you tap."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ necesita el micrófono para una nota de voz. La grabación empieza solo al tocar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ a besoin du microphone pour une note vocale. L’enregistrement commence uniquement à votre demande."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ richiede il microfono per una nota vocale. La registrazione inizia solo al tuo tocco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声メモにはマイクへのアクセスが必要です。タップしたときだけ録音を開始します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성 메모를 위해 마이크 접근이 필요합니다. 탭해야 녹음이 시작됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ heeft microfoontoegang nodig voor een spraaknotitie. Opname begint alleen na je tik."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ potrzebuje mikrofonu do notatki głosowej. Nagrywanie zaczyna się tylko po stuknięciu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O GaleriQ precisa do microfone para uma nota de voz. A gravação só começa ao tocares."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ are nevoie de microfon pentru o notiță vocală. Înregistrarea începe doar la atingere."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для голосовой заметки GaleriQ нужен микрофон. Запись начинается только по нажатию."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ, sesli not için mikrofon erişimine ihtiyaç duyar. Kayıt yalnızca dokunduğunda başlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для голосової нотатки GaleriQ потрібен мікрофон. Запис починається лише після натискання."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ需要访问麦克风来录制语音备忘录。仅在你点击后开始录音。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحفظ GaleriQ النسخ المعدّلة والمجمّعات ومقاطع الفيديو كعناصر جديدة في مكتبتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ speichert bearbeitete Kopien, Collagen und Videos als neue Medien in deiner Mediathek."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ saves edited copies, collages, videos and PDFs as new items in your library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ guarda copias editadas, collages y vídeos como elementos nuevos en tu fototeca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ enregistre les copies modifiées, collages et vidéos comme nouveaux éléments dans votre photothèque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ salva copie modificate, collage e video come nuovi elementi nella tua libreria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQは編集したコピー、コラージュ、ビデオを新しい項目としてライブラリに保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ는 편집한 사본, 콜라주, 비디오를 보관함에 새 항목으로 저장합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ bewaart bewerkte kopieën, collages en video’s als nieuwe items in je bibliotheek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ zapisuje edytowane kopie, kolaże i filmy jako nowe elementy w bibliotece."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O GaleriQ guarda cópias editadas, colagens e vídeos como novos itens na sua fototeca."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ salvează copiile editate, colajele și videoclipurile ca elemente noi în biblioteca ta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ сохраняет отредактированные копии, коллажи и видео как новые объекты в медиатеке."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ, düzenlenmiş kopyaları, kolajları ve videoları arşivine yeni öğeler olarak kaydeder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ зберігає відредаговані копії, колажі й відео як нові об’єкти у вашій медіатеці."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ 会将编辑后的副本、拼贴和视频作为新项目存储到你的图库中。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض GaleriQ صورك ومقاطع الفيديو للفرز على هذا الـ iPhone ولا يزيل إلا ما تختاره وتؤكده في نافذة النظام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ zeigt deine Fotos und Videos zum Sortieren auf diesem iPhone und entfernt nur, was du auswählst und im Systemdialog bestätigst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ shows your photos and videos for sorting on this iPhone and only removes items you choose and confirm in the system dialog."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ muestra tus fotos y vídeos para ordenarlos en este iPhone y solo elimina lo que eliges y confirmas en el cuadro del sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ affiche vos photos et vidéos pour les trier sur cet iPhone et ne supprime que ce que vous choisissez et confirmez dans la fenêtre du système."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ mostra foto e video da ordinare su questo iPhone e rimuove solo ciò che scegli e confermi nella finestra di sistema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQはこのiPhoneで写真とビデオを整理するために表示し、あなたが選んでシステムの確認で承認したものだけを削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ는 이 iPhone에서 정리할 수 있도록 사진과 비디오를 보여 주며, 직접 선택하고 시스템 대화상자에서 확인한 항목만 제거합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ toont je foto’s en video’s om ze op deze iPhone te sorteren en verwijdert alleen wat jij kiest en in het systeemvenster bevestigt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ pokazuje Twoje zdjęcia i filmy do porządkowania na tym iPhonie i usuwa tylko to, co wybierzesz i potwierdzisz w oknie systemu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O GaleriQ mostra as suas fotografias e vídeos para os organizar neste iPhone e só remove o que escolher e confirmar na janela do sistema."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ îți arată pozele și videoclipurile pentru sortare pe acest iPhone și elimină doar ce alegi și confirmi în dialogul sistemului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ показывает ваши фото и видео для сортировки на этом iPhone и удаляет только то, что вы выбрали и подтвердили в окне системы."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ, bu iPhone’da sıralaman için fotoğraflarını ve videolarını gösterir; yalnızca seçip sistem penceresinde onayladıklarını kaldırır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ показує ваші фото й відео для сортування на цьому iPhone і видаляє лише те, що ви виберете й підтвердите у вікні системи."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ 会在此 iPhone 上显示你的照片和视频以便整理，并且只会移除你选择并在系统对话框中确认的项目。"
          }
        }
      }
    },
    "NSUserTrackingUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعرض النسخة المجانية من GaleriQ إعلانات من Google. بإذنك يمكن أن تكون أكثر ملاءمة لك. لا تُرسل صورك وملفاتك أبدًا إلى المعلنين."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Gratis-Version von GaleriQ zeigt Werbung von Google. Mit deiner Erlaubnis kann sie besser zu dir passen. Deine Fotos und Dateien gehen nie an Werbeanbieter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The free version of GaleriQ shows ads from Google. With your permission they can be more relevant to you. Your photos and files never go to advertisers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La versión gratuita de GaleriQ muestra anuncios de Google. Con tu permiso pueden ser más relevantes para ti. Tus fotos y archivos nunca van a los anunciantes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La version gratuite de GaleriQ affiche des publicités de Google. Avec ton autorisation, elles peuvent mieux te correspondre. Tes photos et fichiers ne sont jamais transmis aux annonceurs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La versione gratuita di GaleriQ mostra pubblicità di Google. Con il tuo permesso può essere più adatta a te. Foto e file non vanno mai agli inserzionisti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQの無料版にはGoogleの広告が表示されます。許可すると、より関心に合った広告になります。写真やファイルが広告主に送られることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ 무료 버전에는 Google 광고가 표시돼요. 허용하면 더 관련성 높은 광고를 볼 수 있어요. 사진과 파일은 광고주에게 절대 전달되지 않아요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De gratis versie van GaleriQ toont advertenties van Google. Met je toestemming passen ze beter bij je. Je foto’s en bestanden gaan nooit naar adverteerders."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezpłatna wersja GaleriQ wyświetla reklamy Google. Za Twoją zgodą mogą być lepiej dopasowane. Twoje zdjęcia i pliki nigdy nie trafiają do reklamodawców."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A versão gratuita do GaleriQ mostra anúncios da Google. Com a tua permissão podem ser mais adequados a ti. As tuas fotografias e ficheiros nunca vão para anunciantes."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Versiunea gratuită GaleriQ afișează reclame de la Google. Cu permisiunea ta, ele pot fi mai potrivite pentru tine. Pozele și fișierele tale nu ajung niciodată la agenții de publicitate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бесплатная версия GaleriQ показывает рекламу Google. С твоего разрешения она может лучше тебе подходить. Твои фото и файлы никогда не передаются рекламодателям."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ’in ücretsiz sürümü Google reklamları gösterir. İzin verirsen sana daha uygun olabilir. Fotoğrafların ve dosyaların asla reklamverenlere gitmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Безкоштовна версія GaleriQ показує рекламу Google. З твого дозволу вона може краще тобі пасувати. Твої фото й файли ніколи не передаються рекламодавцям."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GaleriQ 免费版会显示 Google 的广告。经你允许，广告可以更贴合你。你的照片和文件绝不会发送给广告商。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
